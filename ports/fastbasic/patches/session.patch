--- a/src/actions.asm
+++ b/src/actions.asm
@@ -331,6 +331,39 @@
 .endproc
 
 ; Creates a new variable, with no type (the type will be set by parser next)
+        .bss
+        .export parser_persistent
+parser_persistent: .res 1
+dim_existing: .res 1
+dim_type: .res 1
+        .code
+; A persistent DIM reuses a binding of exactly the same type. Other variable
+; creation and all compiler/one-shot parsing retain their existing semantics.
+.proc E_DIM_CREATE
+        lda #0
+        sta dim_existing
+        lda parser_persistent
+        beq fresh
+        jsr var_search
+        bcs fresh
+        sta dim_type
+        inc dim_existing
+        jmp emit_varn
+fresh:  jmp E_VAR_CREATE
+.endproc
+.proc E_DIM_SET_TYPE
+        lda dim_existing
+        beq fresh
+        jsr get_last_tok
+        cmp dim_type
+        bne wrong
+        clc
+        rts
+wrong:  sec
+        rts
+fresh:  jmp E_VAR_SET_TYPE
+.endproc
+
 .proc   E_VAR_CREATE
         ; Check if we have a valid name - this exits on error!
         ; Search existing var
