+/* Expand tabs from document column zero. Copy only [first, limit), or
+ * count columns up to limit when measuring the document width. */
+static WORD expand_line(unsigned char *text, long len, WORD tabsize,
+                        unsigned char *buf, WORD first, WORD limit)
+{
+    unsigned char *end = text + len;
+    WORD column = 0;
+    WORD count = 0;
+
+    while (text < end && column < limit)
+        {
+        unsigned char ch = *text++;
+        if (ch == '\t' && tabsize)
+            {
+            WORD stop = column + tabsize - column % tabsize;
+            if (stop > limit)
+                stop = limit;
+            if (buf)
+                {
+                WORD start = column > first ? column : first;
+                for (; start < stop; ++start)
+                    buf[count++] = ' ';
+                }
+            column = stop;
+            }
+        else
+            {
+            if (buf && column >= first)
+                buf[count++] = ch ? ch : ' ';
+            ++column;
+            }
+        }
+    return buf ? count : column;
 }
 
 
