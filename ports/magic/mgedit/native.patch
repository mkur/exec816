+void close_window(WINDOW *w)
+{
+    WINDOW **pw=find_slot_window(w);
+    edit_close(&w->tree,EDITFELD);
+    edit_delete(w->xedit);
+    FreeMem(w->buf,(ULONG)w->bufsize);
+    wind_close(w->handle);
+    wind_delete(w->handle);
+    Mfree(w);
+    *pw=NULL;
+}
+
+WINDOW *open_new_window(const char *path)
+{
+    WINDOW **pw=new_window();
+    WINDOW *w;
+    LONG ret,got,closed,length,capacity;
+    char *buffer;
+    WORD file=-1,shown=0,offset;
+    XATTR xa;
+
+    if (!pw || strlen(path)>=sizeof(w->path)) return NULL;
+    w=Malloc(sizeof(*w));
+    if (!w) return NULL;
+    memset(w,0,sizeof(*w));
+    offset=(WORD)(pw-windows)*8;
+    w->out=scrg;
+    w->out.g_x+=offset;
+    w->out.g_y+=offset;
+    w->out.g_w-=offset;
+    w->out.g_h-=offset+16;
+    w->handle=wind_create_grect(EDITOR_W_KIND,&scrg);
+    if (w->handle<=0) goto failure;
+
+    strcpy(w->path,path);
+    ret=Fopen(path,0);
+    if (ret<0) goto failure;
+    file=(WORD)ret;
+    if (Fcntl(file,(LONG)&xa,FSTAT) || xa.size<0 || xa.size>0x7fffffffL-EDIT_RESERVE)
+        goto failure;
+    w->bufsize=xa.size+EDIT_RESERVE;
+    w->buf=AllocMem((ULONG)w->bufsize,MEMF_PUBLIC|MEMF_LINEAR);
+    if (!w->buf) goto failure;
+    got=Fread(file,xa.size,w->buf);
+    closed=Fclose(file);
+    file=-1;
+    if (got!=xa.size || closed) goto failure;
+    w->buf[xa.size]=0;
+
+    w->xedit=edit_create();
+    if (!w->xedit) goto failure;
+    w->tree.ob_next=w->tree.ob_head=w->tree.ob_tail=-1;
+    w->tree.ob_flags=LASTOB;
+    w->tree.ob_type=G_EDIT;
+    w->tree.ob_spec=(ULONG)w->xedit;
+    edit_set_buf(&w->tree,EDITFELD,w->buf,w->bufsize);
+    document_title(w);
+    if (!wind_open_grect(w->handle,&w->out)) goto failure;
+    shown=1;
+    if (!wind_get_grect(w->handle,WF_WORKXYWH,&w->in)) goto failure;
+    w->tree.ob_x=w->in.g_x;
+    w->tree.ob_y=w->in.g_y;
+    w->tree.ob_width=w->in.g_w;
+    w->tree.ob_height=w->in.g_h;
+    if (!edit_open(&w->tree,EDITFELD) ||
+        !edit_get_buf(&w->tree,EDITFELD,&buffer,&capacity,&length) ||
+        length!=xa.size) goto failure;
+    w->nlines=w->yscroll=w->xscroll=w->ncols=-1;
+    *pw=w;
+    if (wind_update(BEG_UPDATE)) {
+        window_set_slider(w);
+        objc_draw(&w->tree,EDITFELD,0,w->in.g_x,w->in.g_y,w->in.g_w,w->in.g_h);
+        wind_update(END_UPDATE);
+    }
+    return w;
+failure:
+    if (file>=0) Fclose(file);
+    if (w->xedit) edit_delete(w->xedit);
+    if (w->buf) FreeMem(w->buf,(ULONG)w->bufsize);
+    if (shown) wind_close(w->handle);
+    if (w->handle>0) wind_delete(w->handle);
+    Mfree(w);
+    return NULL;
+}
+
+/* Preserve the donor's width/height update before layout and scrollbar repair. */
+static void change_g(WINDOW *w,const GRECT *g,WORD resized)
+{
+    WORD oldHeight,newHeight;
+    GRECT requested=*g;
+    if (resized) {
+        if (requested.g_w<248) requested.g_w=248;
+        if (requested.g_h<104) requested.g_h=104;
+    }
+    if (!wind_set_grect(w->handle,WF_CURRXYWH,&requested) ||
+        !wind_get_grect(w->handle,WF_CURRXYWH,&w->out) ||
+        !wind_get_grect(w->handle,WF_WORKXYWH,&w->in)) return;
+    w->tree.ob_x=w->in.g_x;
+    w->tree.ob_y=w->in.g_y;
+    w->tree.ob_width=w->in.g_w;
+    w->tree.ob_height=w->in.g_h;
+    if (resized && edit_resized(&w->tree,EDITFELD,&oldHeight,&newHeight))
+        window_set_slider(w);
+}
 
