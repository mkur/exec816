+    /* Selecting the work view also identifies it to objc_draw. */
+    if (!wind_get_grect(w->handle,WF_WORKXYWH,&w->in)) return;
+    switch (field) {
+    case WM_REDRAW:
+        if (rc_intersect(&w->in,&area))
+            objc_draw(&w->tree,EDITFELD,0,area.g_x,area.g_y,area.g_w,area.g_h);
+        break;
+    case WM_TOPPED:
+        wind_set(w->handle,WF_TOP,0,0,0,0);
+        break;
+    case WM_MOVED:
+    case WM_SIZED:
+        change_g(w,&area,field==WM_SIZED);
+        break;
+    case WM_FULLED:
+        fulled(w);
+        break;
+    case WM_ARROWED:
+        switch (message[4]) {
+        case WA_LFLINE: position=w->xscroll-8L; break;
+        case WA_RTLINE: position=w->xscroll+8L; break;
+        case WA_LFPAGE: position=w->xscroll-(LONG)w->xvis; break;
+        case WA_RTPAGE: position=w->xscroll+(LONG)w->xvis; break;
+        case WA_UPLINE: position=w->yscroll-1; goto vertical;
+        case WA_DNLINE: position=w->yscroll+1; goto vertical;
+        case WA_UPPAGE: position=w->yscroll-w->yvis; goto vertical;
+        case WA_DNPAGE: position=w->yscroll+w->yvis; goto vertical;
+        default: return;
+        }
+        goto horizontal;
+    case WM_HSLID:
+        limit=(LONG)w->ncols-w->xvis+1;
+        position=limit>0 ? message[4]*limit/1000:0;
+horizontal:
+        limit=(LONG)w->ncols-w->xvis+1;
+        if (position>limit) position=limit;
+        if (position<0) position=0;
+        if (edit_scroll(&w->tree,EDITFELD,w->handle,-1,(WORD)position))
+            window_set_slider(w);
+        break;
+    case WM_VSLID:
+        limit=w->nlines-w->yvis;
+        position=limit>0 ? (ULONG)message[4]*(ULONG)limit/1000:0;
+vertical:
+        if (edit_scroll(&w->tree,EDITFELD,w->handle,position<0 ? 0:position,-1))
+            window_set_slider(w);
+        break;
+    }
