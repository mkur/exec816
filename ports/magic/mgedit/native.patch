+    for (index=1;index<argc;++index) {
+        if (!open_new_window(argv[index])) {
+            form_alert(1,"[3][Cannot open this document.][OK]");
+            status=20;
+        }
+    }
+    for (;;) {
+        EVNT event;
+        WINDOW *keyboard,*pointer,*target;
+        for (index=0;index<NWINDOWS && !windows[index];++index) {}
+        if (index==NWINDOWS) break;
+        event.mwhich=evnt_multi_moblk(MU_KEYBD|MU_BUTTON|MU_MESAG,2,1,1,
+            NULL,NULL,event.msg,0,0,&event.mx,&event.my,&event.mbutton,
+            &event.kstate,&event.key,&event.mclicks);
+        if (!event.mwhich) {
+            if (ExecAESDiagnostic()==AES_INPUT_LOST) continue;
+            status=20;
+            break;
+        }
+        keyboard=event.mwhich&MU_KEYBD ? whdl2window(ExecAESInputWindow(MU_KEYBD)):NULL;
+        if (do_key(&event,keyboard)) {
+            event.mwhich&=~MU_KEYBD;
+            keyboard=NULL;
+        }
+        pointer=event.mwhich&MU_BUTTON ? whdl2window(ExecAESInputWindow(MU_BUTTON)):NULL;
+        target=event.mwhich&MU_MESAG ? whdl2window(event.msg[3]):NULL;
+        if (keyboard || pointer || (target && event.msg[0]!=WM_CLOSED)) {
+            if (!wind_update(BEG_UPDATE)) { status=20; break; }
+            if (keyboard && keyboard==pointer) edit_event(keyboard,&event);
+            else {
+                WORD flags=event.mwhich;
+                if (keyboard) {
+                    event.mwhich=MU_KEYBD;
+                    edit_event(keyboard,&event);
+                }
+                if (pointer) {
+                    event.mwhich=MU_BUTTON;
+                    edit_event(pointer,&event);
+                }
+                event.mwhich=flags;
+            }
+            if (target && event.msg[0]!=WM_CLOSED) window_message(target,event.msg);
+            wind_update(END_UPDATE);
+        }
+        if (target && event.msg[0]==WM_CLOSED) close_file(target);
+    }
+    for (index=0;index<NWINDOWS;++index)
+        if (windows[index]) close_window(windows[index]);
+    v_clsvwk(vdi_handle);
+    appl_exit();
+    return status;
