+static void operation_error(int result, WORD alert_string)
+{
+    const struct ARC_RECOVERY *retained = arc_recovery();
+    const char *copy = retained->original_moved && retained->backup[0] ?
+        retained->backup : retained->temp;
+    if (app_quit) {
+        if (result != ARC_E_CANCEL && result != ARC_OK) app_result = 20;
+        return;
+    }
+    if (result == ARC_E_CANCEL) return;
+    alert(alert_string==ST_BAD ? ST_OPERATION:alert_string,0);
+    if (*copy) {
+        fill(msg,sizeof msg,ST_RECOVERY,0,copy);
+        form_alert(1,msg);
+    }
 }
 
