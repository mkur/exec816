+/* Names are exclusive and remain in the target's own directory. */
+static struct ARC_RECOVERY recovery;
+static uint32_t serial;
+static char source_path[256];
+
+const struct ARC_RECOVERY *arc_recovery(void) { return &recovery; }
+
+static void begin_operation(void)
+{
+    memset(&recovery, 0, sizeof recovery);
+    ofail = 0;
+    pf_reset();
+}
+
+static int close_result(int h, int result)
+{
+    int closed = pf_close(h);
+    return (result == ARC_OK || result == ARC_E_CANCEL) && closed < 0 ? ARC_E_CLOSE : result;
+}
+
+static int temporary(const char FAR *target, const char *suffix, char *path)
+{
+    static const char hex[] = "0123456789ABCDEF";
+    uint16_t cut = 0, i, attempt;
+    int handle;
+    for (i = 0; target[i]; ++i) {
+        if (i >= 255) return -1;
+        if (target[i] == '/' || target[i] == '\\' || target[i] == ':') cut = i+1;
+    }
+    if (cut > 243) return -1;
+    memcpy(path, target, cut);
+    for (attempt = 0; attempt < 4096; ++attempt) {
+        ++serial;
+        path[cut] = 'G';
+        for (i = 0; i < 7; ++i) path[cut+1+i] = hex[(serial >> (4*(6-i))) & 15];
+        path[cut+8] = '.';
+        memcpy(path+cut+9, suffix, 4);
+        handle = pf_create(path);
+        if (handle >= 0) return handle;
+        if (!pf_collision()) return -1;
+        pf_reset();
+    }
+    return -1;
+}
+
+/* An uncertain terminal Close retains the possible temporary. */
+static int finish_temporary(int handle, int result)
+{
+    if (pf_close(handle) < 0) {
+        recovery.uncertain_close = 1;
+        if (result == ARC_OK || result == ARC_E_CANCEL) result = ARC_E_CLOSE;
+    } else if (result != ARC_OK) {
+        if (!pf_delete(recovery.temp)) recovery.temp[0] = 0;
+    }
+    return result;
+}
+
+/* Confirmed logical moves only. A failed publication retains both copies;
+ * this deliberately makes no atomic-replace or transport-durability claim. */
+static int publish(const char FAR *target)
+{
+    int exists = pf_exists(target), handle;
+    if (exists < 0) return ARC_E_CREATE;
+    if (exists) {
+        handle = temporary(target, "OLD", recovery.backup);
+        if (handle < 0) return ARC_E_CREATE;
+        if (pf_close(handle) < 0) { recovery.uncertain_close = 1; return ARC_E_CLOSE; }
+        if (pf_delete(recovery.backup) < 0) return ARC_E_CLEANUP;
+        if (pf_rename(target, recovery.backup) < 0) return ARC_E_RENAME;
+        recovery.original_moved = 1;
+    }
+    if (pf_rename(recovery.temp, target) < 0) return ARC_E_RENAME;
+    recovery.published = 1;
+    recovery.temp[0] = 0;
+    if (exists && pf_delete(recovery.backup) < 0) return ARC_E_CLEANUP;
+    recovery.backup[0] = 0;
+    return ARC_OK;
+}
