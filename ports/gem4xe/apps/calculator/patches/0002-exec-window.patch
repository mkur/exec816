+/* Windowed Exec adaptation: the arithmetic and resource remain the donor's. */
+static WORD paint(WORD object,const WORD *damage)
+{
+    WORD okay,x,y,clip[4],mark[4];
+    if (!wind_update(BEG_UPDATE)) return FALSE;
+    okay=wind_get(Calculator.window,WF_WXYWH,&Calculator.work[0],&Calculator.work[1],
+                  &Calculator.work[2],&Calculator.work[3]);
+    tree[ROOT].ob_x=Calculator.work[0];tree[ROOT].ob_y=Calculator.work[1];
+    if (okay) okay=objc_draw(tree,object,object ? 0:MAX_DEPTH,
+                           damage[0],damage[1],damage[2],damage[3]);
+    if (okay && (object==ROOT || object==Calculator.focus)) {
+        objc_offset(tree,Calculator.focus,&x,&y);
+        clip[0]=damage[0];clip[1]=damage[1];
+        clip[2]=damage[0]+damage[2]-1;clip[3]=damage[1]+damage[3]-1;
+        vs_clip(Calculator.vdi,1,clip);
+        vsf_color(Calculator.vdi,tree[Calculator.focus].ob_state&SELECTED ? 0:1);
+        mark[0]=x+3;mark[1]=y+tree[Calculator.focus].ob_height-3;
+        mark[2]=x+tree[Calculator.focus].ob_width-4;mark[3]=mark[1];
+        v_bar(Calculator.vdi,mark);
+    }
+    if (!wind_update(END_UPDATE)) okay=FALSE;
+    return okay;
+}
+
+static WORD repaint(WORD object)
+{
+    WORD x,y,damage[4],border=object==CDISP ? 1:2+!!(tree[object].ob_flags&DEFAULT);
+    objc_offset(tree,object,&x,&y);
+    damage[0]=x-border;damage[1]=y-border;
+    damage[2]=tree[object].ob_width+2*border;
+    damage[3]=tree[object].ob_height+2*border;
+    return paint(object,damage);
+}
+
+static WORD cancel(void)
+{
+    WORD obj=Calculator.armed;
+    if (obj<0) return TRUE;
+    tree[obj].ob_state=Calculator.saved;Calculator.armed=-1;
+    return repaint(obj);
+}
+
+/* Every accepted key reaches this donor operation switch exactly once. */
+static WORD action(WORD obj)
+{
+    LONG before=shown;
+    ++Calculator.actions;
+    switch (obj) {
+    case CQUIT: return TRUE;
+    case CCLR: clear(); break;
+    case CSIGN: show(-shown);fresh=FALSE;break;
+    case CADD:
+    case CSUB:
+    case CMUL:
+    case CDIV:
+        apply();pending=obj;fresh=TRUE;break;
+    case CEQ:
+        apply();pending=0;fresh=TRUE;break;
+    default: digit(key_digit(obj));break;
+    }
+    if (shown!=before && !repaint(CDISP)) Calculator.result=2;
+    return FALSE;
+}
+
+static WORD shortcut(WORD key)
+{
+    static const WORD digits[10]={C0,C1,C2,C3,C4,C5,C6,C7,C8,C9};
+    key&=255;
+    if (key>='0' && key<='9') return digits[key-'0'];
+    switch (key) {
+    case '+': return CADD;
+    case '-': return CSUB;
+    case '*': return CMUL;
+    case '/': return CDIV;
+    case '=': return CEQ;
+    case 'c': case 'C': return CCLR;
+    default: return NIL;
+    }
+}
+
+WORD calc_panel(void)
+{
+    WORD x,y,w,h,events,mx,my,mb,ks,kr,br,hit,next,unused,previous,quit=FALSE;
+    Calculator.window=-1;Calculator.focus=C7;Calculator.armed=-1;
+    Calculator.result=1;
