+
+/* A clipped multi-row redraw clears its paper once. Text runs can then omit
+ * trailing spaces, avoiding padded glyph work while retaining row edit paints. */
+void lines_out(WINDOWP w,TEXTP t,short first,short last)
+{
+    short row;
+    if(first>last)return;
+    if(first==last){line_out(w,t,first);return;}
+    fill_area(w->work.g_x,w->work.g_y+first*font_hcell,w->work.g_w,
+        (last-first+1)*font_hcell,bg_color);
+    for(row=first;row<=last;row++)output_line(w,t,row,TRUE);
+}
