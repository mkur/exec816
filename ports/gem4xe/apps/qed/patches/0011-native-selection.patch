+}
+static bool pointer_clock_read(void)
+{
+    if(!pointer_clock){
+        pointer_port=CreateMsgPort();
+        if(!pointer_port)return FALSE;
+        pointer_clock=(struct TimerClockRequest *)CreateIORequest(pointer_port,sizeof(*pointer_clock));
+        if(!pointer_clock){pointer_clock_close();return FALSE;}
+        if(OpenDevice("timer.device",UNIT_VBLANK,&pointer_clock->tc_Request,0)){
+            pointer_clock_close();return FALSE;
+        }
+        pointer_open=TRUE;
+    }
+    pointer_clock->tc_Request.io_Command=TD_READCLOCK;
+    if(DoIO(&pointer_clock->tc_Request))return FALSE;
+    return pointer_clock->ticks_per_second==50 || pointer_clock->ticks_per_second==60;
