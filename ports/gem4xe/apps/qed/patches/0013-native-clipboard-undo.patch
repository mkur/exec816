+void qed_ring_empty(RINGP r)
+{
+    memset(r,0,sizeof(*r));r->head.info=HEAD;r->tail.info=TAIL;
+    FIRST(r)=&r->tail;LAST(r)=&r->head;
+    r->ending=lns_unix;r->max_line_len=MAX_LINE_LEN;
+}
+void qed_ring_take(RINGP destination,RINGP source)
+{
+    *destination=*source;
+    if(source->lines){FIRST(destination)->prev=&destination->head;LAST(destination)->next=&destination->tail;}
+    else{FIRST(destination)=&destination->tail;LAST(destination)=&destination->head;}
+    qed_ring_empty(source);
+}
+static void save_view(TEXTP t,UNDO_VIEW *v)
+{
+    v->row=t->ypos;v->x=t->xpos;v->block=t->block;v->backward=t->block_dir;
+    v->first=t->z1;v->last=t->z2;v->start=t->x1;v->end=t->x2;
+}
+static void restore_view(TEXTP t,UNDO_VIEW *v)
+{
+    t->ypos=v->row;t->xpos=v->x;t->cursor_line=get_line(&t->text,t->ypos);
+    t->block=v->block;t->block_dir=v->backward;t->cursor=!v->block;
+    t->z1=v->first;t->z2=v->last;t->x1=v->start;t->x2=v->end;
+    t->p1=v->block?get_line(&t->text,v->first):NULL;
+    t->p2=v->block?get_line(&t->text,v->last):NULL;
+}
+static void exchange_span(TEXTP t,long row,long count,RINGP replacement)
+{
+    LINEP first=get_line(&t->text,row),last=first,before,after;
+    RING removed;
+    long i;
+    for(i=1;i<count;i++)last=last->next;
+    before=first->prev;after=last->next;
+    qed_ring_empty(&removed);removed.lines=count;
+    FIRST(&removed)=first;LAST(&removed)=last;
+    before->next=FIRST(replacement);FIRST(replacement)->prev=before;
+    after->prev=LAST(replacement);LAST(replacement)->next=after;
+    t->text.lines+=replacement->lines-count;
+    first->prev=&removed.head;last->next=&removed.tail;
+    qed_ring_take(replacement,&removed);
+}
+static bool append_parts(RINGP out,const char *a,short na,const char *b,short nb,
+                         const char *c,short nc)
+{
+    LINEP line;short size=na+nb+nc;
+    if(size>MAX_LINE_LEN)return FALSE;
+    if(na)memcpy(replace_bytes,a,na);
+    if(nb)memcpy(replace_bytes+na,b,nb);
+    if(nc)memcpy(replace_bytes+na+nb,c,nc);
+    line=new_col(replace_bytes,size);
+    if(!line)return FALSE;
+    col_append(out,line);return TRUE;
+}
