+bool block_copy(TEXTP t,RINGP out)
+{
+    LINEP line=t->p1,copy;long row;
+    qed_ring_empty(out);
+    for(row=t->z1;row<=t->z2;row++){
+        short start=row==t->z1?t->x1:0,end=row==t->z2?t->x2:line->len;
+        copy=new_col(TEXT(line)+start,end-start);
+        if(!copy){kill_textring(out);return qed_edit_error();}
+        col_append(out,copy);line=line->next;
+    }
+    out->ending=t->text.ending;return TRUE;
+}
 
