+
+short out_s(short x,short y,short w,char *s)
+{
+    short width=min((short)strlen(s)*font_wcell,w);
+    vst_color(vdi_handle,fg_color);
+    v_gtext(vdi_handle,x,y+EXEC_VDI_FONT_TOP,s);
+    return width;
+}
+short out_sb(short x,short y,short w,char *s)
+{
+    short width=min((short)strlen(s)*font_wcell,w);
+    fill_area(x,y,width,font_hcell,bg_block_color);
+    vst_color(vdi_handle,fg_block_color);
+    v_gtext(vdi_handle,x,y+EXEC_VDI_FONT_TOP,s);
+    return width;
+}
