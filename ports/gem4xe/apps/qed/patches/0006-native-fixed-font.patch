+        if(!t->blink && x>=w->work.g_x && x<w->work.g_x+w->work.g_w)
+            fill_area(x,area.g_y,overwrite?font_wcell:2,font_hcell,fg_color);
+    }while(rc_next(w->handle,&clip));
     wind_update(END_UPDATE);
