+void fill_area(short x,short y,short w,short h,short color)
+{
+    WORD xy[4];
+    if(w<=0 || h<=0)return;
+    xy[0]=x;xy[1]=y;xy[2]=x+w-1;xy[3]=y+h-1;
+    vsf_color(vdi_handle,color);v_bar(vdi_handle,xy);
