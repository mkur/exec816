+static LINEP visible_line(TEXTP t,long y)
+{
+    LINEP line=t->cursor_line;
+    long at=t->ypos;
+    if(y<0 || y>=t->text.lines)return NULL;
+    while(at>y){PREV(line);--at;}
+    while(at<y){NEXT(line);++at;}
+    return line;
+}
+
+/* Bounded visible cells belong to this private image, never bank zero. */
+static char cells[81];
+void line_out(WINDOWP w,TEXTP t,short row)
+{
+    LINEP line=visible_line(t,w->doc.y+row);
+    const char *source;
+    short index=0,repeat=0,count=0,limit=(w->work.g_w+7)/8;
+    long column=0;
+    short y=w->work.g_y+row*font_hcell;
+    fill_area(w->work.g_x,y,w->work.g_w,font_hcell,bg_color);
+    if(!line)return;
+    if(limit>80)limit=80;
+    source=TEXT(line);
+    while(index<line->len && count<limit){
+        char ch=source[index++];
+        repeat=ch=='\t' && t->loc_opt->tab ? t->loc_opt->tabsize-column%t->loc_opt->tabsize:1;
+        if(ch=='\t')ch=' ';
+        while(repeat-- && count<limit){
+            if(column>=w->doc.x)cells[count++]=ch;
+            ++column;
+        }
+    }
+    cells[count]=0;
+    vst_color(vdi_handle,fg_color);
+    if(count)v_gtext(vdi_handle,w->work.g_x,y+EXEC_VDI_FONT_TOP,cells);
+}
+
+void bild_out(WINDOWP w,TEXTP t)
+{
+    short row,rows=(w->work.g_h+font_hcell-1)/font_hcell;
+    head_out(w,t);
+    for(row=0;row<rows;row++)line_out(w,t,row);
+}
+void bild_blkout(WINDOWP w,TEXTP t,long first,long last)
+{
+    short row;
+    if(first>last){long swap=first;first=last;last=swap;}
+    for(row=0;row<w->w_height;row++)
+        if(w->doc.y+row>=first && w->doc.y+row<=last)line_out(w,t,row);
+}
+
+/* Redraw the cursor row before painting its current visible state. The event
