+void char_cr(TEXTP t)
+{
+    LINEP old=t->cursor_line,a,b;
+    if(t->text.lines==0x7fffffffL){edit_error();return;}
+    a=new_col(TEXT(old),t->xpos);
+    if(!a){edit_error();return;}
+    b=new_col(TEXT(old)+t->xpos,old->len-t->xpos);
+    if(!b){free_col(&t->text,a);edit_error();return;}
+    a->next=b;b->prev=a;
+    clr_undo();changed_line(t,old,a,b,1);t->ypos++;t->xpos=0;
