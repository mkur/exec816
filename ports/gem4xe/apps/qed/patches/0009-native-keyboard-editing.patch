+bool edit_key(TEXTP t,WINDOWP w,short qualifiers,short key)
+{
+    unsigned char scan=(unsigned short)key>>8,ch=key;
+    /* Atari cursor chords carry Control; special scans take precedence. */
+    cursor_visible(w,t);
+    switch(scan){
+    case 0x48:line_up(t);return TRUE;
+    case 0x50:line_down(t);return TRUE;
+    case 0x4b:char_left(t);t->up_down=FALSE;return TRUE;
+    case 0x4d:char_right(t);t->up_down=FALSE;return TRUE;
+    case 0x47:if(qualifiers&K_CTRL)text_start(t);else line_start(t);return TRUE;
+    case 0x4f:if(qualifiers&K_CTRL){text_end(t);line_end(t);}else line_end(t);return TRUE;
+    case 0x49:page_up(t);return TRUE;
+    case 0x51:page_down(t);return TRUE;
+    case 0x53:char_delete(t);return TRUE;
+    }
+    if(qualifiers&K_CTRL)return FALSE;
+    if(ch==27){blk_demark(t);return TRUE;}
+    if(ch==8){char_bs(t);return TRUE;}
+    if(ch==13){char_cr(t);return TRUE;}
+    if(ch==9 || ch>=32){char_insert(t,ch);return TRUE;}
+    return FALSE;
+}
