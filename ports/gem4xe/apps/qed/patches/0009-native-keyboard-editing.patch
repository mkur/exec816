+static char edit_bytes[MAX_LINE_LEN+1];
+static void changed_line(TEXTP t,LINEP old,LINEP first,LINEP last,long delta)
+{
+    first->prev=old->prev;old->prev->next=first;
+    last->next=old->next;old->next->prev=last;
+    free_col(&t->text,old);
+    t->cursor_line=last;t->text.lines+=delta;t->max_line=NULL;
