+/* The hosted device's narrow glyph callback also links in the extraction-only
+ * context probe. That probe binds recording callbacks and never executes this
+ * donor hardware provider; production images supply the checked Exec queue. */
+void blit_glyph(uint32_t source,uint16_t stride,uint32_t dest,uint16_t bytes,uint8_t ink)
+{
+    blit_mask(source,stride,dest,320,bytes,8,ink,0,BLT_MODE_HR);
+}
