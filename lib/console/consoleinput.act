; Input Task delivers copied routes; the console backend owns stream reads.
MODULE CONSOLEINPUT
USE EXEC
USE CONSOLEUI
USE INPUT
USE CONSOLETYPES
USE CONSOLECAPTURE
USE CONSOLEFOREGROUND
USE CONSOLEWINDOWS
USE CONSOLEINGRESS
USE HEAPCORE

; Device callback copies ingress only. The stop check and enqueue share the
; same Task guard as RequestStop, closing the last-input/shutdown race.
PUBLIC PROC Deliver(LONGCARD context INPUT.Event POINTER event)
  CONSOLETYPES.Window POINTER entry

  LET service=CONSOLETYPES.Service POINTER(ADDRESS(context))
  EXEC.Forbid()
  IF service.stop=0 THEN
    IF CONSOLEUI.Key(event)<>0 THEN
      EXEC.Permit()
      RETURN
    FI
    entry=CONSOLEFOREGROUND.Resolve(event.route)
    IF entry<>NULL THEN
      CONSOLEINGRESS.Capture(entry.unit,event)
    FI
  FI
  EXEC.Permit()

RETURN

ENDMODULE
