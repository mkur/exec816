; Worker-owned presentation for pinned GRAPHICS 0 or the shared VBXE library.
; All copies run in task context with interrupts and preemption enabled.
MODULE CONSOLEDISPLAY
USE A816MEMORY
USE CONSOLETYPES
USE CONSOLECORE
USE CONSOLEBATCH
USE CONSOLEWINDOWS
USE CONSOLEBITMAP
USE DISPLAY
USE HEAPCORE
INCLUDE "console-storage-action.inc"
BYTE dindex=$57,crsinh=$2f0,attract=$4d,drkmsk=$4e,colrsh=$4f
BYTE sdmctl=$22f,chbas=$2f4,chact=$2f3,gprior=$26f
BYTE oldchr=$5d
CARD savmsc=$58,sdlst=$230,oldadr=$5e
DISPLAY.Lease lease
LONGCARD bitmapUnit,bitmapGeneration,bitmapModel
BYTE bitmapReady

CONST ROW_BUDGET=4, CELL_BUDGET=160

; Physical text capabilities; the common model can retain larger geometry.
PUBLIC CARD FUNC Width()

  IF CONSOLEBITMAP.Enabled()<>0 THEN
    RETURN(80)
  FI

RETURN(40)

PUBLIC CARD FUNC Height()

  IF CONSOLEBITMAP.Enabled()<>0 THEN
    RETURN(30)
  FI

RETURN(24)

; Platform leaf: exact source/destination extents, ordinary task DP scratch.
PUBLIC EXTERNAL PROC Span(BYTE POINTER destination,source CARD length)

; Translate a supported terminal byte to the pinned screen character set.
PUBLIC BYTE FUNC Glyph(BYTE value)
  BYTE POINTER glyphs

  glyphs=BYTE POINTER(ADDRESS(CS_GLYPHS))
  IF value>=128 THEN
    RETURN(31)
  FI

RETURN(glyphs(value))

; Require the exact GRAPHICS 0 display-list layout before borrowing its RAM.
BYTE FUNC ListValid(CARD listBase,screen)
  BYTE POINTER bytes
  CARD index

  IF listBase<$9000 OR listBase>$bfe0 THEN
    RETURN(0)
  FI

  IF listBase<screen+960 AND listBase+32>screen THEN
    RETURN(0)
  FI

  bytes=BYTE POINTER(ADDRESS(listBase))
  IF bytes(0)<>$70 OR bytes(1)<>$70 OR bytes(2)<>$70 OR bytes(3)<>$42 THEN
    RETURN(0)
  FI

  IF CARD(bytes(4))+(CARD(bytes(5)) LSH 8)<>screen THEN
    RETURN(0)
  FI

  FOR index=6 TO 28 DO
    IF bytes(index)<>2 THEN
      RETURN(0)
    FI
  OD

  IF bytes(29)<>$41 OR CARD(bytes(30))+(CARD(bytes(31)) LSH 8)<>listBase THEN
    RETURN(0)
  FI

RETURN(1)

; Reject an incompatible OS display instead of guessing its memory layout.
PUBLIC BYTE FUNC Validate()
  ; Both extents must be RAM inside the existing OS-high reservation, below
  ; ROM/hardware, without overlap. The ROM/font itself is pinned by packaging.
  IF dindex<>0 OR sdmctl<>$22 OR chbas<>$e0 OR chact<>2 OR gprior<>0 THEN
    RETURN(0)
  FI

  IF attract>=128 OR drkmsk<>$fe OR colrsh<>0 THEN
    RETURN(0)
  FI

  IF savmsc<$9000 OR savmsc>$bc40 THEN
    RETURN(0)
  FI

  IF oldadr<savmsc OR oldadr>=savmsc+960 THEN
    RETURN(0)
  FI

RETURN(ListValid(sdlst,savmsc))

; Keep the visible rectangle inside both the screen and retained terminal.
PUBLIC BYTE FUNC Geometry(CONSOLETYPES.Presentation POINTER view
    CONSOLETYPES.Instance POINTER instance)

  IF view.width=0 OR view.height=0 OR view.left>=Width() OR view.top>=Height() THEN
    RETURN(0)
  FI

  IF view.width>Width()-view.left OR view.height>Height()-view.top THEN
    RETURN(0)
  FI

  IF view.width>instance.width OR view.height>instance.height THEN
    RETURN(0)
  FI

RETURN(1)

; Save the OS display and cursor before granting the terminal ownership.
PUBLIC BYTE FUNC Claim(CONSOLETYPES.Presentation POINTER view
    CONSOLETYPES.Instance POINTER instance BYTE POINTER snapshot)
  BYTE POINTER screen

  IF CONSOLEBITMAP.Enabled()<>0 THEN
    IF view.claimed<>0 OR CONSOLEBITMAP.Open()=0 THEN
      RETURN(0)
    FI

    view.instance=BYTE POINTER(instance)
    view.left=0
    view.top=0
    view.width=80
    view.height=30
    view.claimed=1
    view.scrollState=0
    view.visible=1
    view.focused=1
    view.index=$ffff
    view.previousCursor=$ffff
    view.generation==+1
    view.presentedGeneration=0
    CONSOLECORE.Dirty(instance,0,instance.count)
    RETURN(1)
  FI

  IF view.claimed<>0 OR Validate()=0 THEN
    RETURN(0)
  FI

  IF snapshot=BYTE POINTER(0) OR ADDRESS(snapshot)<$10000 THEN
    RETURN(0)
  FI

  screen=BYTE POINTER(ADDRESS(savmsc))
  view.instance=BYTE POINTER(instance)
  view.screen=screen
  view.snapshot=snapshot
  view.left=0
  view.top=0
  view.width=40
  view.height=24
  IF Geometry(view,instance)=0 THEN
    RETURN(0)
  FI

  IF DISPLAY.Acquire(@lease,DISPLAY.TEXT)<>DISPLAY.OK THEN
    RETURN(0)
  FI

  ; Preserve the visible old cursor as part of the exact screen snapshot.
  A816MEMORY.Move(snapshot,screen,SIZE(960))
  view.savedCursor=crsinh
  view.savedAttract=attract
  crsinh=1
  view.claimed=1
  attract=0
  screen(oldadr-savmsc)=oldchr
  view.previousCursor=$ffff
  view.index=$ffff
  view.cursorOn=0
  view.visible=1
  view.focused=1
  view.generation==+1
  view.presentedGeneration=0
  CONSOLECORE.Dirty(instance,0,instance.count)
  IF DISPLAY.Activate(@lease)<>DISPLAY.OK THEN
    HEAPCORE.Abort(4)
  FI

RETURN(1)

; Restore the saved OS screen and cursor state after the final presentation.
PUBLIC PROC Release(CONSOLETYPES.Presentation POINTER view)

  IF view.claimed=0 THEN
    RETURN
  FI

  IF CONSOLEBITMAP.Enabled()<>0 THEN
    CONSOLEBITMAP.Close()
    CONSOLEBATCH.Reset()
    view.claimed=0
    view.scrollState=0
    view.visible=0
    view.cursorOn=0
    view.generation==+1
    view.presentedGeneration=0
    RETURN
  FI

  IF DISPLAY.BeginRelease(@lease)<>DISPLAY.OK THEN
    HEAPCORE.Abort(4)
  FI

  view.visible=0
  view.generation==+1
  view.presentedGeneration=0
  A816MEMORY.Move(view.screen,view.snapshot,SIZE(960))
  crsinh=view.savedCursor
  view.claimed=0
  attract=view.savedAttract
  view.cursorOn=0
  view.previousCursor=$ffff
  IF DISPLAY.Release(@lease)<>DISPLAY.OK THEN
    HEAPCORE.Abort(4)
  FI

RETURN

CARD FUNC Position(CARD row,column)

RETURN((row LSH 5)+(row LSH 3)+column)

CARD FUNC CursorPosition(CONSOLETYPES.Presentation POINTER view
    CONSOLETYPES.Instance POINTER instance)

  IF CONSOLEBITMAP.Enabled()<>0 THEN
    RETURN(instance.lineStart+instance.column)
  FI

RETURN(Position(view.top+instance.row,view.left+instance.column))

; Overlay a cursor only for a focused, settled cell inside the visible
; rectangle.
PROC Cursor(CONSOLETYPES.Presentation POINTER view CONSOLETYPES.Instance
    POINTER instance)
  CARD index
  BYTE okay

  view.index=instance.lineStart+instance.column
  IF view.focused=0 THEN
    RETURN
  FI

  IF instance.operation<>CONSOLETYPES.OP_IDLE OR instance.row>=view.height
      OR instance.column>=view.width THEN
    RETURN
  FI

  IF CONSOLEBITMAP.Enabled()<>0 THEN
    IF instance.dirtyRows<>0 OR view.scrollState<>0 THEN
      RETURN
    FI

    okay=CONSOLEBITMAP.Fill((view.left+instance.column) LSH 3,
        ((view.top+instance.row) LSH 3)+7,8,1,1)
    IF okay<>0 THEN
      view.previousCursor=view.index
      view.cursorOn=1
    FI

    RETURN
  FI

  index=Position(view.top+instance.row,view.left+instance.column)
  view.cursorCell=Glyph(instance.cells(CONSOLECORE.CellOffset(instance,view.index)))
  view.previousCursor=index
  view.cursorOn=1
  view.screen(index)=BYTE(view.cursorCell) XOR $80

RETURN

; Refresh a bounded dirty span so screen work leaves time for input and other
; tasks.
; Return whether the final bitmap span also drew the new caret.
BYTE FUNC Cells(CONSOLETYPES.Presentation POINTER view CONSOLETYPES.Instance
    POINTER instance)
  CARD row,base,first,last,stop,rows,remaining
  BYTE okay,caret
  BYTE POINTER source
  LONGCARD generation

  IF instance.dirtyRows=0 THEN
    RETURN(0)
  FI

  caret=0
  row=0
  base=0
  rows=0
  remaining=CELL_BUDGET
  WHILE row<instance.height AND rows<ROW_BUDGET AND remaining<>0 DO
    first=instance.damageFirst(row)
    last=instance.damageEnd(row)
    IF first<last THEN
      IF last-first>remaining THEN
        last=first+remaining
      FI

      generation=instance.generation
      IF first<view.width AND row<view.height THEN
        stop=last
        IF stop>view.width THEN
          stop=view.width
        FI

        source=instance.cells+SIZE(CONSOLECORE.CellOffset(instance,base+first))
        IF CONSOLEBITMAP.Enabled()<>0 THEN
          ; Only a complete last span can share the settled caret. The old
          ; caret must already be absent or erased by this opaque text.
          caret=instance.dirtyRows=1 AND last=instance.damageEnd(row)
              AND view.focused<>0 AND instance.operation=CONSOLETYPES.OP_IDLE
              AND instance.row<view.height AND instance.column<view.width
              AND (view.cursorOn=0 OR (view.previousCursor>=base+first
              AND view.previousCursor<base+stop))
          IF caret<>0 THEN
            okay=CONSOLEBITMAP.TextCaret((view.left+first) LSH 3,
                (view.top+row) LSH 3,source,stop-first,
                (view.left+instance.column) LSH 3,
                ((view.top+instance.row) LSH 3)+7)
          ELSE
            okay=CONSOLEBITMAP.Text((view.left+first) LSH 3,
                (view.top+row) LSH 3,source,stop-first)
          FI

          IF okay=0 THEN
            CONSOLECORE.Clean(instance)
            view.index=instance.lineStart+instance.column
            RETURN(0)
          FI

          ; Only the span actually drawn can erase the old bitmap caret.
          ; Budgets and clipping may leave other dirty cells for later turns.
          IF view.cursorOn<>0 AND view.previousCursor>=base+first
              AND view.previousCursor<base+stop THEN
            view.cursorOn=0
          FI
        ELSE
          Span(view.screen+SIZE(Position(view.top+row,view.left+first)),
              source,stop-first)
        FI
      FI

      CONSOLECORE.Presented(instance,row,last,generation)
      remaining==-(last-first)
      rows==+1
    FI

    base==+instance.width
    row==+1
  OD

  IF instance.dirtyRows=0 THEN
    view.presentedGeneration=instance.generation
  FI

  IF caret<>0 THEN
    view.index=instance.lineStart+instance.column
    view.previousCursor=view.index
    view.cursorOn=1
  FI

RETURN(caret)

; Restore the underlying glyph before moving or hiding the cursor.
PUBLIC PROC RemoveCursor(CONSOLETYPES.Presentation POINTER view)
  CARD row,column
  BYTE okay

  IF CONSOLEBITMAP.Pending()<>0 THEN
    RETURN
  FI

  IF view.cursorOn<>0 AND CONSOLEBITMAP.Enabled()<>0 THEN
    BEGIN
      LET instance=CONSOLETYPES.Instance POINTER(view.instance)
      row=view.previousCursor/instance.width
      column=view.previousCursor MOD instance.width
      okay=CONSOLEBITMAP.Text((view.left+column) LSH 3,
          (view.top+row) LSH 3,instance.cells+
          SIZE(CONSOLECORE.CellOffset(instance,view.previousCursor)),1)
      view.cursorOn=0
      RETURN
    END
  FI

  IF view.cursorOn<>0 THEN
    view.screen(view.previousCursor)=BYTE(view.cursorCell)
    view.cursorOn=0
  FI

RETURN

; Presentation admission prevents worker borrows while this bounded erase runs.
PUBLIC PROC Erase(CONSOLETYPES.Presentation POINTER view)
  CARD row
  BYTE okay

  IF CONSOLEBITMAP.Pending()<>0 THEN
    RETURN
  FI

  IF view.claimed=0 OR view.visible=0 THEN
    RETURN
  FI

  RemoveCursor(view)
  IF CONSOLEBITMAP.Enabled()<>0 THEN
    view.scrollState=0
    view.presentedGeneration=0
    FOR row=0 TO view.height-1 DO
      okay=CONSOLEBITMAP.Fill(view.left LSH 3,(view.top+row) LSH 3,
          view.width LSH 3,8,0)
      IF okay=0 THEN
        RETURN
      FI
    OD

    RETURN
  FI

  FOR row=0 TO view.height-1 DO
    A816MEMORY.Clear(view.screen+SIZE(Position(view.top+row,view.left)),
        SIZE(view.width))
  OD

RETURN

INCLUDE "console-batch-display.inc"
INCLUDE "console-bitmap-display.inc"

; Complete retained and physical editing under the worker's existing borrow.
; Only a complete, synchronized view can reuse its translated screen bytes.
PUBLIC PROC Edit(CONSOLETYPES.Presentation POINTER view CONSOLETYPES.Instance
    POINTER instance)
  BYTE synchronized,ignored
  CARD row

  IF CONSOLEBITMAP.Enabled()<>0 THEN
    BitmapEdit(view,instance)
    RETURN
  FI

  LET operation=instance.operation
  synchronized=0
  IF view.claimed<>0 AND view.visible<>0 AND view.width=instance.width
      AND view.height=instance.height THEN
    RemoveCursor(view)
    IF operation=CONSOLETYPES.OP_CLEAR THEN
      synchronized=1
    ELSE
      IF instance.dirtyRows<>0 THEN
        IF instance.dirtyRows<=ROW_BUDGET THEN
          ignored=Cells(view,instance)
        FI
      FI

      synchronized=instance.dirtyRows=0
    FI
  FI

  CONSOLECORE.EditQuantum(instance)
  IF synchronized=0 THEN
    RETURN
  FI

  IF operation=CONSOLETYPES.OP_CLEAR THEN
    Erase(view)
  ELSEIF operation=CONSOLETYPES.OP_SCROLL THEN
    BEGIN
      LET destination=view.screen+SIZE(Position(view.top,view.left))
      IF view.width=40 THEN
        A816MEMORY.Move(destination,destination+SIZE(40),
            SIZE(instance.count-instance.width))
      ELSEIF view.height>1 THEN
        FOR row=0 TO view.height-2 DO
          A816MEMORY.Move(destination+SIZE(Position(row,0)),
              destination+SIZE(Position(row+1,0)),SIZE(view.width))
        OD
      FI

      A816MEMORY.Clear(destination+SIZE(Position(view.height-1,0)),
          SIZE(view.width))
    END
  FI

  CONSOLECORE.Clean(instance)
  view.presentedGeneration=instance.generation

RETURN

; Worker borrows only presentations admitted by Claim/Show. Direct users keep
; the checked Quantum entry below for clipped or independently built views.
PUBLIC PROC Present(CONSOLETYPES.Presentation POINTER view CONSOLETYPES.Instance
    POINTER instance)
  BYTE ignored

  IF CONSOLEBITMAP.Pending()<>0 OR view.claimed=0 OR view.visible=0
      OR view.scrollState<>0 THEN
    RETURN
  FI

  LET batch=CONSOLEBATCH.Get()
  IF batch.phase<>CONSOLETYPES.BATCH_IDLE THEN
    PresentBatch(view,instance)
    RETURN
  FI

  IF CONSOLEBITMAP.Enabled()<>0 THEN
    IF CONSOLEBITMAP.Failed()<>0 THEN
      CONSOLECORE.Clean(instance)
      view.index=instance.lineStart+instance.column
      RETURN
    FI
  FI

  ; A clean, settled cursor needs no screen stores. Focus changes invalidate
  ; view.index at the presentation transaction boundary.
  IF instance.dirtyRows=0 AND view.index=instance.lineStart+instance.column THEN
    IF instance.operation=CONSOLETYPES.OP_IDLE THEN
      IF (view.focused=0 AND view.cursorOn=0) OR
          (view.focused<>0 AND view.cursorOn<>0 AND
          view.previousCursor=CursorPosition(view,instance)) THEN
        RETURN
      FI
    FI
  FI

  IF CONSOLEBITMAP.Enabled()<>0 THEN
    ; Opaque text may already erase the old caret. Restore it only if it
    ; survived this batch, before drawing the new caret.
    IF Cells(view,instance)<>0 THEN
      RETURN
    FI

    RemoveCursor(view)
  ELSE
    RemoveCursor(view)
    ignored=Cells(view,instance)
  FI

  Cursor(view,instance)

RETURN

; Validate a caller-built view before presenting its next bounded update.
PUBLIC PROC Quantum(CONSOLETYPES.Presentation POINTER view CONSOLETYPES.Instance
    POINTER instance)

  IF Geometry(view,instance)<>0 THEN
    Present(view,instance)
  FI

RETURN

ENDMODULE
