; Selected display frontend. Text mode has no AES/desktop dependency.
MODULE CONSOLESYSTEM
USE EXEC
USE CONSOLEUI
USE CONSOLEBATCH
USE CONSOLETYPES
USE CONSOLEDISPLAY
USE CONSOLEBITMAP
USE CONSOLEFRONT
USE CONSOLECONTROL

CONST REQUEST_MASK=$80000000, STOP_MASK=$20000000
BYTE FUNC POINTER consoleStopping()
BYTE FUNC POINTER consoleStop()

; Driver lifecycle remains driver policy in both frontend modes.
PUBLIC PROC BindLifecycle(ADDRESS stopping,stop)

  LET stoppingEntry=ADDRESS POINTER(@consoleStopping)
  LET stopEntry=ADDRESS POINTER(@consoleStop)
  stoppingEntry^=stopping
  stopEntry^=stop

RETURN

PUBLIC BYTE FUNC Stopping()

RETURN(consoleStopping())

PUBLIC BYTE FUNC RequestStop()

RETURN(consoleStop())

PUBLIC BYTE FUNC Start()

RETURN(CONSOLEUI.Start())

PUBLIC PROC Stop()

  CONSOLEUI.Stop()

RETURN

; Source/model/physical work each keeps its own durable wake. No scene gate or
; display-independent GUI turn is needed to render the standard text console.
PUBLIC PROC Run()
  LONGCARD bits
  BYTE again,accepted,stopping

  IF CONSOLEUI.Enabled()<>0 THEN
    CONSOLEUI.Run()
    RETURN
  FI
  LET displayMask=CONSOLEBITMAP.Mask()
  LET batch=CONSOLEBATCH.Get()
  bits=0
  stopping=0
  DO
    CONSOLEDISPLAY.Poll((bits & displayMask)<>0)
    IF (bits & STOP_MASK)<>0 THEN
      stopping=1
    FI
    IF stopping<>0 AND CONSOLEBITMAP.Pending()=0 THEN
      accepted=consoleStop()
    FI
    IF consoleStopping()<>0 AND CONSOLEBITMAP.Pending()=0
        AND batch.phase=CONSOLETYPES.BATCH_IDLE THEN
      EXIT
    FI
    CONSOLECONTROL.Process()
    again=0
    accepted=CONSOLEFRONT.Turn(@again)
    IF again<>0 OR CONSOLEDISPLAY.CompletionReady()<>0
        OR CONSOLEFRONT.Runnable()<>0 THEN
      EXEC.Yield()
      bits=0
    ELSE
      bits=EXEC.Wait(REQUEST_MASK OR STOP_MASK
          OR displayMask)
    FI
  OD

RETURN
ENDMODULE
