; One presentation transaction pauses worker borrows, with IRQs enabled.
MODULE CONSOLETILING
USE EXEC
USE HEAPCORE
USE CONSOLETYPES
USE CONSOLEWINDOWS
USE CONSOLEDRIVER
USE CONSOLECONTROL
USE CONSOLECAPTURE
USE CONSOLECORE
USE DISPLAYADAPTER

; One presentation lock serializes use of this upper-RAM row buffer.
BYTE ARRAY resizeRow(CONSOLETYPES.MAX_WIDTH)

; Pause new worker borrows and wait for existing ones before changing
; presentation.
PUBLIC BYTE FUNC Lock()
  CONSOLETYPES.Windows POINTER windows
  CONSOLETYPES.Service POINTER service
  BYTE POINTER owner
  BYTE index

  IF CONSOLEDRIVER.State()<>2 THEN
    RETURN(0)
  FI

  windows=CONSOLEWINDOWS.Registry()
  service=CONSOLEDRIVER.GetService()
  owner=BYTE POINTER(EXEC.FindTask(BYTE POINTER(0)))
  ; Worker completion requires scheduling; reject an outer caller Forbid.
  LET caller=EXEC.Task POINTER(owner)
  IF caller.tc_TDNestCnt<>255 THEN
    RETURN(0)
  FI

  EXEC.Forbid()
  IF windows.presenting<>0 OR service.state<>2 OR service.stop<>0
      OR owner=service.worker THEN
    EXEC.Permit()
    RETURN(0)
  FI

  IF EXEC.RetainTask(EXEC.Task POINTER(owner),@windows.presenter)=0 THEN
    EXEC.Permit()
    RETURN(0)
  FI

  windows.presenting=1
  FOR index=0 TO CONSOLETYPES.WINDOW_SLOTS-1 DO
    IF windows.items(index).state=CONSOLETYPES.WIN_LIVE THEN
      windows.items(index).state=CONSOLETYPES.WIN_PRESENTING
    FI
  OD

  EXEC.Permit()
  FOR index=0 TO CONSOLETYPES.WINDOW_SLOTS-1 DO
    WHILE windows.items(index).busy<>0 DO
      EXEC.Yield()
    OD
  OD

RETURN(1)

; Publish the new presentation and wake the worker after releasing its owner
; lease.
PUBLIC PROC Unlock()
  CONSOLETYPES.Windows POINTER windows
  CONSOLETYPES.Service POINTER service
  BYTE index

  windows=CONSOLEWINDOWS.Registry()
  service=CONSOLEDRIVER.GetService()
  EXEC.Forbid()
  IF windows.control.state<>CONSOLETYPES.CTL_IDLE THEN
    HEAPCORE.Abort(4)
  FI

  FOR index=0 TO CONSOLETYPES.WINDOW_SLOTS-1 DO
    IF windows.items(index).state=CONSOLETYPES.WIN_PRESENTING THEN
      windows.items(index).state=CONSOLETYPES.WIN_LIVE
    FI
  OD

  IF EXEC.ReleaseTask(@windows.presenter)=0 THEN
    HEAPCORE.Abort(4)
  FI

  windows.presenting=0
  EXEC.Signal(@service.task,$80000000)
  EXEC.Permit()

RETURN

; Permit presentation changes only for the base console or the owning Task.
PUBLIC BYTE FUNC Owned(CONSOLETYPES.Window POINTER entry)

  IF entry=CONSOLETYPES.Window POINTER(0) THEN
    RETURN(0)
  FI

RETURN(entry.unit=0 OR entry.owner=BYTE POINTER(EXEC.FindTask(BYTE POINTER(0))))

; Preflight geometry and active addressed output before erasing a visible view.
PUBLIC BYTE FUNC CanResize(CONSOLETYPES.Window POINTER entry CARD height)

  LET instance=CONSOLETYPES.Instance POINTER(entry.instance)
  LET view=CONSOLETYPES.Presentation POINTER(entry.view)
  LET screenHeight=CONSOLEDRIVER.ScreenHeight()
  IF CONSOLECORE.CanResize(instance,height)=0
      OR view.top>=screenHeight OR height>screenHeight-view.top THEN
    RETURN(0)
  FI

  IF instance.write<>NULL THEN
    BEGIN
      LET request=EXEC.IOStdReq POINTER(instance.write)
      IF request.io_Command=CONSOLETYPES.CONCMD_WRITE_AT THEN
        RETURN(0)
      FI
    END
  FI

RETURN(1)

; Caller holds the presentation lock and has preflighted the geometry.
PUBLIC PROC ResizeLocked(CONSOLETYPES.Window POINTER entry CARD height)

  LET instance=CONSOLETYPES.Instance POINTER(entry.instance)
  LET view=CONSOLETYPES.Presentation POINTER(entry.view)
  IF CONSOLECONTROL.Submit(CONSOLETYPES.CTL_ERASE,view)=0 THEN
    HEAPCORE.Abort(4)
  FI

  IF CONSOLECORE.Resize(instance,height,resizeRow)=0 THEN
    HEAPCORE.Abort(4)
  FI

  view.height=height
  view.scrollState=0
  view.index=$ffff
  view.previousCursor=$ffff
  view.generation==+1
  view.presentedGeneration=0

RETURN

; Resize an owned tile without changing its identity, input route or width.
PUBLIC BYTE FUNC ResizeHeight(LONGCARD unit CARD height)
  BYTE index

  IF Lock()=0 THEN
    RETURN(0)
  FI

  LET windows=CONSOLEWINDOWS.Registry()
  LET entry=CONSOLEWINDOWS.Find(unit)
  IF Owned(entry)=0 OR windows.pane<>0 THEN
    Unlock()
    RETURN(0)
  FI

  IF CanResize(entry,height)=0 THEN
    Unlock()
    RETURN(0)
  FI

  LET view=CONSOLETYPES.Presentation POINTER(entry.view)
  FOR index=0 TO CONSOLETYPES.WINDOW_SLOTS-1 DO
    BEGIN
      LET other=@windows.items(index)
      IF other<>entry AND CONSOLEWINDOWS.Live(other)<>0 THEN
        BEGIN
          LET otherView=CONSOLETYPES.Presentation POINTER(other.view)
          IF view.visible<>0 AND otherView.visible<>0
              AND view.left<otherView.left+otherView.width
              AND view.left+view.width>otherView.left
              AND view.top<otherView.top+otherView.height
              AND view.top+height>otherView.top THEN
            Unlock()
            RETURN(0)
          FI
        END
      FI
    END
  OD

  IF view.height<>height THEN
    ResizeLocked(entry,height)
  FI

  Unlock()

RETURN(1)

; Dock one fully prepared, hidden instance under the permanent default console.
PUBLIC BYTE FUNC Dock(LONGCARD unit)

  IF Lock()=0 THEN
    RETURN(0)
  FI

  LET windows=CONSOLEWINDOWS.Registry()
  LET child=CONSOLEWINDOWS.Find(unit)
  LET parent=CONSOLEWINDOWS.Find(0)
  IF unit=0 OR Owned(child)=0 OR parent=NULL OR windows.pane<>0 THEN
    Unlock()
    RETURN(0)
  FI

  LET pane=CONSOLETYPES.Instance POINTER(child.instance)
  LET instance=CONSOLETYPES.Instance POINTER(parent.instance)
  LET view=CONSOLETYPES.Presentation POINTER(parent.view)
  LET childView=CONSOLETYPES.Presentation POINTER(child.view)
  IF view.visible=0 OR view.left<>0 OR view.top<>0
      OR instance.width<>CONSOLEDRIVER.ScreenWidth()
      OR instance.height<>CONSOLEDRIVER.ScreenHeight()
      OR childView.visible<>0 OR pane.width<>instance.width
      OR pane.height>=instance.height OR windows.focusSlot<>0 THEN
    Unlock()
    RETURN(0)
  FI

  LET height=instance.height-pane.height
  IF CanResize(parent,height)=0 THEN
    Unlock()
    RETURN(0)
  FI

  ResizeLocked(parent,height)
  childView.left=0
  childView.top=height
  childView.screen=view.screen
  childView.claimed=1
  childView.visible=1
  childView.focused=0
  childView.index=$ffff
  childView.previousCursor=$ffff
  childView.generation==+1
  childView.presentedGeneration=0
  CONSOLECORE.Dirty(pane,0,pane.count)
  windows.pane=unit
  Unlock()

RETURN(1)

; Caller owns the presentation transaction and has drained worker borrows.
PUBLIC PROC Select(CONSOLETYPES.Window POINTER entry)
  CONSOLETYPES.Windows POINTER windows
  CONSOLETYPES.Presentation POINTER view

  windows=CONSOLEWINDOWS.Registry()
  IF windows.focusSlot<CONSOLETYPES.WINDOW_SLOTS THEN
    view=CONSOLETYPES.Presentation POINTER(windows.items(windows.focusSlot).view)
    IF CONSOLECONTROL.Submit(CONSOLETYPES.CTL_CURSOR,view)=0 THEN
      HEAPCORE.Abort(4)
    FI

    view.focused=0
    view.index=$ffff
  FI

  EXEC.Forbid()
  windows.focusSlot=255
  IF entry=CONSOLETYPES.Window POINTER(0) THEN
    CONSOLECAPTURE.Publish(0)
  ELSE
    view=CONSOLETYPES.Presentation POINTER(entry.view)
    view.focused=1
    view.index=$ffff
    windows.focusSlot=BYTE(entry.unit & 3)
    CONSOLECAPTURE.Publish(entry.route)
  FI

  EXEC.Permit()

RETURN

; Erase a window and choose replacement focus within a presentation
; transaction.
PUBLIC PROC HideLocked(CONSOLETYPES.Window POINTER entry)
  CONSOLETYPES.Windows POINTER windows
  CONSOLETYPES.Presentation POINTER view
  CONSOLETYPES.Window POINTER next
  BYTE index

  view=CONSOLETYPES.Presentation POINTER(entry.view)
  IF view.visible=0 THEN
    RETURN
  FI

  IF CONSOLECONTROL.Submit(CONSOLETYPES.CTL_ERASE,view)=0 THEN
    HEAPCORE.Abort(4)
  FI

  view.visible=0
  view.generation==+1
  view.presentedGeneration=0
  windows=CONSOLEWINDOWS.Registry()
  IF windows.focusSlot<>BYTE(entry.unit & 3) THEN
    RETURN
  FI

  next=CONSOLETYPES.Window POINTER(0)
  FOR index=0 TO CONSOLETYPES.WINDOW_SLOTS-1 DO
    IF CONSOLEWINDOWS.Live(@windows.items(index))<>0 THEN
      view=CONSOLETYPES.Presentation POINTER(windows.items(index).view)
      IF view.visible<>0 THEN
        next=@windows.items(index)
        EXIT
      FI
    FI
  OD

  Select(next)

RETURN

; Admit a non-overlapping screen rectangle before exposing a retained
; terminal.
PUBLIC BYTE FUNC Show(LONGCARD unit CARD left,top)
  CONSOLETYPES.Windows POINTER windows
  CONSOLETYPES.Window POINTER entry
  CONSOLETYPES.Presentation POINTER view,other,base
  CONSOLETYPES.Instance POINTER instance
  BYTE index,okay

  IF Lock()=0 THEN
    RETURN(0)
  FI

  entry=CONSOLEWINDOWS.Find(unit)
  IF Owned(entry)=0 THEN
    Unlock()
    RETURN(0)
  FI

  windows=CONSOLEWINDOWS.Registry()
  IF windows.pane<>0 THEN
    Unlock()
    RETURN(0)
  FI

  view=CONSOLETYPES.Presentation POINTER(entry.view)
  instance=CONSOLETYPES.Instance POINTER(entry.instance)
  LET width=CONSOLEDRIVER.ScreenWidth()
  LET height=CONSOLEDRIVER.ScreenHeight()
  IF left>=width OR top>=height THEN
    Unlock()
    RETURN(0)
  FI

  IF instance.width>width-left OR instance.height>height-top THEN
    Unlock()
    RETURN(0)
  FI

  IF view.visible<>0 THEN
    okay=view.left=left AND view.top=top
    Unlock()
    RETURN(okay)
  FI

  FOR index=0 TO CONSOLETYPES.WINDOW_SLOTS-1 DO
    IF CONSOLEWINDOWS.Live(@windows.items(index))<>0 THEN
      other=CONSOLETYPES.Presentation POINTER(windows.items(index).view)
      IF other.visible<>0 THEN
        IF left<other.left+other.width AND left+instance.width>other.left THEN
          IF top<other.top+other.height AND top+instance.height>other.top THEN
            Unlock()
            RETURN(0)
          FI
        FI
      FI
    FI
  OD

  base=CONSOLETYPES.Presentation POINTER(windows.items(0).view)
  view.left=left
  view.top=top
  view.screen=base.screen
  view.claimed=1
  view.visible=1
  view.index=$ffff
  view.cursorOn=0
  view.focused=0
  view.generation==+1
  view.presentedGeneration=0
  instance.changeTick=DISPLAYADAPTER.Ticks()
  CONSOLECORE.Dirty(instance,0,instance.count)
  IF windows.focusSlot=255 THEN
    Select(entry)
  FI

  Unlock()

RETURN(1)

; Hide an owned terminal while serializing against worker presentation.
PUBLIC BYTE FUNC Hide(LONGCARD unit)
  CONSOLETYPES.Window POINTER entry

  IF Lock()=0 THEN
    RETURN(0)
  FI

  LET windows=CONSOLEWINDOWS.Registry()
  IF windows.pane<>0 THEN
    Unlock()
    RETURN(0)
  FI

  entry=CONSOLEWINDOWS.Find(unit)
  IF Owned(entry)=0 THEN
    Unlock()
    RETURN(0)
  FI

  HideLocked(entry)
  Unlock()

RETURN(1)

; Route keyboard input only to a visible terminal the caller may control.
PUBLIC BYTE FUNC Focus(LONGCARD unit)
  CONSOLETYPES.Window POINTER entry
  CONSOLETYPES.Presentation POINTER view

  IF Lock()=0 THEN
    RETURN(0)
  FI

  LET windows=CONSOLEWINDOWS.Registry()
  IF windows.pane<>0 THEN
    Unlock()
    RETURN(unit=0 AND windows.focusSlot=0)
  FI

  entry=CONSOLEWINDOWS.Find(unit)
  IF Owned(entry)=0 THEN
    Unlock()
    RETURN(0)
  FI

  view=CONSOLETYPES.Presentation POINTER(entry.view)
  IF view.visible=0 THEN
    Unlock()
    RETURN(0)
  FI

  Select(entry)
  Unlock()

RETURN(1)

ENDMODULE
