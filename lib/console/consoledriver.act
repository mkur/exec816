; One resident console worker; public calls use the unchanged Exec IOStdReq.
MODULE CONSOLEDRIVER
USE EXEC
USE CONSOLEHOST
USE CONSOLESCENE
USE CONSOLELOCKS
USE TASKSTACKS
USE A816MEMORY
USE EXECLISTS
USE EXECMEMORY
USE TASKMEMORY
USE HEAPCORE
USE SYS
USE ASCII
USE CONSOLETYPES
USE CONSOLECORE
USE CONSOLEBATCH
USE CONSOLEWINDOWS
USE CONSOLEFOREGROUND
USE CONSOLECAPTURE
USE CONSOLEINPUT
USE CONSOLEDISPLAY
USE CONSOLEBITMAP
USE CONSOLECONTROL
USE DISPLAY
USE DISPLAYADAPTER
INCLUDE "console-storage-action.inc"
CONST DELETE=127

PUBLIC CONSOLETYPES.Service POINTER FUNC GetService()

RETURN(CONSOLETYPES.Service POINTER(ADDRESS(CS_BASE)))

PUBLIC CONSOLETYPES.Instance POINTER FUNC GetInstance()

RETURN(CONSOLETYPES.Instance POINTER(ADDRESS(CS_INSTANCE)))

; Publish capabilities only while the worker is ready and accepting work.
PUBLIC CARD FUNC ScreenWidth()
  CARD width

  LET service=GetService()
  EXEC.Forbid()
  width=0
  IF service.state=2 AND service.stop=0 AND CONSOLEBITMAP.Failed()=0 THEN
    width=CONSOLEDISPLAY.Width()
  FI

  EXEC.Permit()

RETURN(width)

PUBLIC CARD FUNC ScreenHeight()
  CARD height

  LET service=GetService()
  EXEC.Forbid()
  height=0
  IF service.state=2 AND service.stop=0 AND CONSOLEBITMAP.Failed()=0 THEN
    height=CONSOLEDISPLAY.Height()
  FI

  EXEC.Permit()

RETURN(height)

; Require a complete writable extent before the worker borrows caller storage.
BYTE FUNC Mapped(BYTE POINTER buffer LONGCARD bytes)
  EXECMEMORY.BankRecord info
  CARD first,last,index

  IF buffer=BYTE POINTER(0)
      OR bytes>LONGCARD($1000000)-LONGCARD(ADDRESS(buffer)) THEN
    RETURN(0)
  FI

  first=CARD(ADDRESS(buffer) RSH 16)
  last=CARD((LONGCARD(ADDRESS(buffer))+bytes-1) RSH 16)
  ; Task images and AllocMem payloads use upper RAM in this initial profile.
  ; Bank-zero spans are checked by protected admission against writable images.
  IF first=0 THEN
    RETURN(0)
  FI

  FOR index=first TO last DO
    IF EXECMEMORY.Query(index,@info)<>0 THEN
      RETURN(0)
    FI

    IF info.state=0 THEN
      RETURN(0)
    FI
  OD

RETURN(1)

; Check retained terminal geometry and storage before admitting it to service.
BYTE FUNC Validate(EXEC.IOStdReq POINTER request)

  IF request.io_Offset<>0
      AND request.io_Command<>CONSOLETYPES.CONCMD_WRITE_AT THEN
    RETURN(BYTE(EXEC.IOERR_BADADDRESS))
  FI

  IF request.io_Command=EXEC.CMD_WRITE
      AND request.io_Length=LONGCARD($ffffffff) THEN
    RETURN(BYTE(EXEC.IOERR_BADLENGTH))
  FI

  IF request.io_Length<>0 THEN
    IF request.io_Data=BYTE POINTER(0)
        OR request.io_Length>LONGCARD($1000000)-LONGCARD(ADDRESS(
        request.io_Data)) THEN
      RETURN(BYTE(EXEC.IOERR_BADADDRESS))
    FI

    IF (ADDRESS(request.io_Data) RSH 16)=0 THEN
      IF TASKMEMORY.Writable(ADDRESS(request.io_Data),
          SIZE(request.io_Length))=0 THEN
        RETURN(BYTE(EXEC.IOERR_BADADDRESS))
      FI

      RETURN(0)
    FI

    IF Mapped(request.io_Data,request.io_Length)=0 THEN
      RETURN(BYTE(EXEC.IOERR_BADADDRESS))
    FI
  FI

RETURN(0)

INCLUDE "console-requests.inc"
INCLUDE "console-lifetime.inc"

; Check the whole positioned span before committing its first byte. Geometry
; is stable while the worker owns this borrow; a later resize drains it first.
BYTE FUNC PositionValid(CONSOLETYPES.Instance POINTER instance
    EXEC.IOStdReq POINTER request)
  CARD index

  LET column=CARD(request.io_Offset)
  LET row=CARD(request.io_Offset RSH CONSOLETYPES.POSITION_ROW_SHIFT)
  IF row>=instance.height OR column>=instance.width THEN
    RETURN(BYTE(EXEC.IOERR_BADADDRESS))
  FI

  IF request.io_Length>LONGCARD(instance.width-column) THEN
    RETURN(BYTE(EXEC.IOERR_BADLENGTH))
  FI

  FOR index=0 TO CARD(request.io_Length)-1 DO
    IF request.io_Data(index)<ASCII.SPACE OR request.io_Data(index)>=127 THEN
      RETURN(BYTE(EXEC.IOERR_BADLENGTH))
    FI
  OD

RETURN(0)

; Use the same FIFO, cancellation identity and short-write presentation as
; stream output, without scrolling or moving the cursor.
BYTE FUNC PositionedWrite(CONSOLETYPES.Instance POINTER instance
    EXEC.IOStdReq POINTER request)
  CARD count

  IF instance.writeCancel<>0 OR request.io_Actual=request.io_Length THEN
    FinishWrite(instance,request)
    RETURN(0)
  FI

  count=CARD(request.io_Length-request.io_Actual)
  IF count>CONSOLETYPES.SOURCE_QUANTUM THEN
    count=CONSOLETYPES.SOURCE_QUANTUM
  FI

  CONSOLECORE.WriteAt(instance,CARD(request.io_Offset)+CARD(request.io_Actual),
      CARD(request.io_Offset RSH CONSOLETYPES.POSITION_ROW_SHIFT),
      request.io_Data+SIZE(request.io_Actual),count)
  request.io_Actual==+LONGCARD(count)

RETURN(request.io_Actual=request.io_Length)

; Commit one bounded prefix, then publish a pointer-free display continuation
; before replying. Cancellation never consumes another source byte.
PROC BatchWrite(CONSOLETYPES.Instance POINTER instance
    CONSOLETYPES.Presentation POINTER view EXEC.IOStdReq POINTER request)
  CARD limit,consumed
  BYTE reason

  IF instance.writeCancel=0 AND request.io_Actual<request.io_Length
      AND CONSOLEBATCH.Due(instance.changeTick)=0 THEN
    BEGIN
      LET remaining=request.io_Length-request.io_Actual
      limit=CONSOLETYPES.SOURCE_QUANTUM
      IF remaining<LONGCARD(limit) THEN
        limit=CARD(remaining)
      FI

      consumed=CONSOLEBATCH.Feed(instance,
          BYTE POINTER(ADDRESS(request.io_Data)+SIZE(request.io_Actual)),limit)
      request.io_Actual==+LONGCARD(consumed)
    END
  FI

  IF instance.writeCancel<>0 OR request.io_Actual=request.io_Length
      OR CONSOLEBATCH.Due(instance.changeTick)<>0 THEN
    reason=CONSOLETYPES.BATCH_FLUSH_END
    IF instance.writeCancel<>0 THEN
      reason=CONSOLETYPES.BATCH_FLUSH_CANCEL
    FI

    CONSOLEDISPLAY.FlushBatch(view,instance,reason)
    IF instance.writeCancel<>0 OR request.io_Actual=request.io_Length THEN
      FinishWrite(instance,request)
    FI
  FI

RETURN

; Advance one write by a bounded amount. Return 1 to complete a short write
; after this turn's presentation, before yielding or taking another instance.
BYTE FUNC WriteQuantum(CONSOLETYPES.Instance POINTER instance
    CONSOLETYPES.Presentation POINTER view LONGCARD unit)
  EXEC.IOStdReq POINTER request
  LONGCARD remaining
  CARD consumed,limit
  BYTE error,value

  LET batch=CONSOLEBATCH.Get()
  IF batch.phase<>CONSOLETYPES.BATCH_IDLE THEN
    IF batch.unit<>unit OR batch.phase<>CONSOLETYPES.BATCH_GATHER THEN
      RETURN(0)
    FI

    IF batch.viewGeneration<>view.generation
        OR batch.modelGeneration<>instance.generation
        OR view.visible=0 OR view.claimed=0 OR instance.write=NULL THEN
      CONSOLEDISPLAY.DiscardBatch()
    FI
  FI

  request=EXEC.IOStdReq POINTER(instance.write)
  IF request=NULL THEN
    request=ClaimWrite(instance)
    IF request=NULL THEN
      RETURN(0)
    FI

    error=Validate(request)
    IF error=0 AND request.io_Command=CONSOLETYPES.CONCMD_WRITE_AT THEN
      error=PositionValid(instance,request)
    FI
    IF error<>0 THEN
      request.io_Error=error
      FinishWrite(instance,request)
      RETURN(0)
    FI
  FI

  IF CONSOLEBITMAP.Failed()<>0 THEN
    CONSOLEDISPLAY.DiscardBatch()
    IF instance.operation<>CONSOLETYPES.OP_IDLE THEN
      CONSOLECORE.EditQuantum(instance)
    FI

    request.io_Error=BYTE(EXEC.IOERR_SELFTEST)
    FinishWrite(instance,request)
    RETURN(0)
  FI

  IF batch.phase=CONSOLETYPES.BATCH_GATHER THEN
    BatchWrite(instance,view,request)
    RETURN(0)
  FI

  IF instance.operation<>CONSOLETYPES.OP_IDLE THEN
    CONSOLEDISPLAY.Edit(view,instance)
    IF instance.operation=CONSOLETYPES.OP_IDLE THEN
      IF instance.writeCancel<>0 OR request.io_Actual=request.io_Length THEN
        FinishWrite(instance,request)
      FI
    FI

    RETURN(0)
  FI

  IF request.io_Command=CONSOLETYPES.CONCMD_WRITE_AT THEN
    RETURN(PositionedWrite(instance,request))
  FI

  IF instance.writeCancel<>0 OR request.io_Actual=request.io_Length THEN
    FinishWrite(instance,request)
    RETURN(0)
  FI

  ; An obscured scroll repaints the retained rows in bounded passes. Let that
  ; repaint reach the bottom before another write can invalidate its prefix.
  ; Input, cancellation and desktop controls still run on every worker turn.
  IF CONSOLEBITMAP.Enabled()<>0 AND view.claimed<>0 AND view.visible<>0
      AND instance.dirtyRows<>0 AND CONSOLESCENE.CopyReady()=0 THEN
    RETURN(0)
  FI

  remaining=request.io_Length-request.io_Actual
  limit=CONSOLETYPES.SOURCE_QUANTUM
  IF remaining<LONGCARD(limit) THEN
    limit=CARD(remaining)
  FI

  IF request.io_Length>LONGCARD(CONSOLETYPES.SOURCE_QUANTUM)
      AND CONSOLEBITMAP.Enabled()<>0 THEN
    BEGIN
      LET source=BYTE POINTER(ADDRESS(request.io_Data)+SIZE(request.io_Actual))
      value=source^
      IF value=ASCII.LF OR (value>=ASCII.SPACE AND value<>DELETE) THEN
        IF CONSOLEDISPLAY.BeginBatch(view,instance,unit)<>0 THEN
          BatchWrite(instance,view,request)
          RETURN(0)
        FI
      FI
    END
  FI

  consumed=CONSOLECORE.Feed(instance,
      BYTE POINTER(ADDRESS(request.io_Data)+SIZE(request.io_Actual)),limit)
  request.io_Actual==+LONGCARD(consumed)
  ; A short, settled write can present before its reply wakes the client.
  ; Keep ownership until that one bounded pass; never await a full redraw.
  IF request.io_Actual=request.io_Length
      AND instance.operation=CONSOLETYPES.OP_IDLE THEN
    IF request.io_Length<=LONGCARD(CONSOLETYPES.SOURCE_QUANTUM) THEN
      RETURN(1)
    FI

    FinishWrite(instance,request)
  FI

RETURN(0)

; Complete available input or cancellation without blocking the console
; worker.
PROC ReadQuantum(CONSOLETYPES.Service POINTER service CONSOLETYPES.Instance
    POINTER instance)
  EXEC.IOStdReq POINTER request
  CARD count,limit
  LONGCARD ignored

  request=EXEC.IOStdReq POINTER(instance.read)
  IF request=EXEC.IOStdReq POINTER(0) OR instance.readReady=0 THEN
    RETURN
  FI

  IF instance.readReady=1 THEN
    request.io_Error=Validate(request)
    instance.readReady=2
  FI

  IF instance.readCancel<>0 THEN
    request.io_Error=BYTE(EXEC.IOERR_ABORTED)
  FI

  IF CONSOLEBITMAP.Failed()<>0 THEN
    request.io_Error=BYTE(EXEC.IOERR_SELFTEST)
  FI

  IF request.io_Error=0 THEN
    IF instance.inputCount=0 AND instance.inputLost=0 THEN
      RETURN
    FI

    limit=64
    IF request.io_Length<64 THEN
      limit=CARD(request.io_Length)
    FI

    count=CONSOLEINPUT.Read(instance,request.io_Data,limit)
    IF count=$ffff THEN
      request.io_Error=CONSOLETYPES.CONERR_INPUTOVERFLOW
    ELSE
      request.io_Actual=LONGCARD(count)
    FI
  FI

  FinishRead(instance,request)

RETURN

; Acquire console storage and the OS display before publishing readiness.
BYTE FUNC Initialize(CONSOLETYPES.Service POINTER service CONSOLETYPES.Instance
    POINTER instance)
  BYTE POINTER cells,fifo
  CONSOLETYPES.Presentation POINTER view
  CONSOLETYPES.Windows POINTER windows
  CONSOLETYPES.Window POINTER entry
  BYTE registered

  windows=CONSOLEWINDOWS.Registry()
  CONSOLEBATCH.Reset()
  entry=@windows.items(0)
  entry.unit=0
  entry.owner=BYTE POINTER(0)
  entry.instance=BYTE POINTER(instance)
  entry.view=BYTE POINTER(ADDRESS(CS_PRESENTATION))
  entry.state=CONSOLETYPES.WIN_CREATING
  LET width=CONSOLEDISPLAY.Width()
  LET height=CONSOLEDISPLAY.Height()
  IF width=0 OR width>CONSOLETYPES.MAX_WIDTH
      OR height=0 OR height>CONSOLETYPES.MAX_HEIGHT THEN
    RETURN(0)
  FI

  instance.count=width*height
  instance.capacity=instance.count
  cells=EXEC.AllocMem(LONGCARD(instance.count),EXEC.MEMF_PUBLIC)
  fifo=EXEC.AllocMem(128,EXEC.MEMF_PUBLIC)
  instance.cells=cells
  instance.fifo=fifo
  IF cells=BYTE POINTER(0) OR fifo=BYTE POINTER(0) THEN
    RETURN(0)
  FI

  IF CONSOLECORE.Init(instance,cells,width,height,LONGCARD(instance.count))=0 THEN
    RETURN(0)
  FI

  WHILE instance.operation<>CONSOLETYPES.OP_IDLE DO
    CONSOLECORE.EditQuantum(instance)
    EXEC.Yield()
  OD

  CONSOLEINPUT.Init(instance,fifo)
  view=CONSOLETYPES.Presentation POINTER(ADDRESS(CS_PRESENTATION))
  service.presentation=BYTE POINTER(view)
  service.snapshot=EXEC.AllocMem(960,EXEC.MEMF_PUBLIC)
  IF service.snapshot=BYTE POINTER(0) THEN
    RETURN(0)
  FI

  IF CONSOLEDISPLAY.Claim(view,instance,service.snapshot)=0 THEN
    RETURN(0)
  FI

  IF CONSOLECAPTURE.Acquire()=0 THEN
    RETURN(0)
  FI

  EXEC.Forbid()
  registered=CONSOLEFOREGROUND.Register(entry)
  IF registered<>0 THEN
    entry.state=CONSOLETYPES.WIN_LIVE
    windows.liveCount=1
    windows.focusSlot=0
    CONSOLECAPTURE.Publish(entry.route)
  FI

  EXEC.Permit()
  IF registered=0 THEN
    CONSOLECAPTURE.Release()
    RETURN(0)
  FI


RETURN(1)

; Release driver allocations after requests and display ownership have
; retired.
PROC FreeStorage(CONSOLETYPES.Service POINTER service CONSOLETYPES.Instance
    POINTER instance)
  CONSOLETYPES.Presentation POINTER view
  CONSOLETYPES.Windows POINTER windows
  CONSOLETYPES.Window POINTER entry

  windows=CONSOLEWINDOWS.Registry()
  entry=@windows.items(0)
  EXEC.Forbid()
  windows.liveCount=0
  entry.state=CONSOLETYPES.WIN_RETIRING
  CONSOLEFOREGROUND.Unregister(entry)
  EXEC.Permit()
  view=CONSOLETYPES.Presentation POINTER(ADDRESS(CS_PRESENTATION))
  CONSOLEDISPLAY.Release(view)
  IF service.snapshot<>BYTE POINTER(0) THEN
    EXEC.FreeMem(service.snapshot,960)
    service.snapshot=BYTE POINTER(0)
    view.snapshot=BYTE POINTER(0)
  FI

  IF instance.cells<>BYTE POINTER(0) THEN
    EXEC.FreeMem(instance.cells,LONGCARD(instance.capacity))
    instance.cells=BYTE POINTER(0)
  FI

  IF instance.fifo<>BYTE POINTER(0) THEN
    EXEC.FreeMem(instance.fifo,128)
    instance.fifo=BYTE POINTER(0)
  FI

  EXEC.Forbid()
  CONSOLEWINDOWS.Retired(entry)
  EXEC.Permit()

RETURN

; Acknowledge input/stop once per turn, preserving Wait's already-consumed bits.
; Request and unrelated signals stay pending until their ordinary consumer.
LONGCARD FUNC Collect(LONGCARD bits,displayMask)

RETURN(bits OR EXEC.SetSignal(0,STOP_MASK OR CONSOLECAPTURE.WAKE_MASK OR displayMask))

; One bounded turn per borrowed instance. No request or instance pointer remains
; borrowed across Yield/Wait, and replies publish ownership exactly once.
PUBLIC PROC Worker()
  LONGCARD bits,displayMask
  BYTE again,writing,registered,stopping,accepted,inputPending,completeWrite
  BYTE handoff,deferOutput
  CONSOLETYPES.Instance POINTER instance
  CONSOLETYPES.Window POINTER entry

  EXEC.Forbid()
  LET service=GetService()
  LET defaultInstance=GetInstance()
  LET batch=CONSOLEBATCH.Get()
  LET self=EXEC.FindTask(NULL)
  IF service.worker<>BYTE POINTER(self) OR service.state<>1
      OR service.lease.task<>self THEN
    EXEC.Permit()
    RETURN
  FI

  EXEC.Permit()

  ; Reserve request, input and resident-stop bits before Open allocates
  ; the display completion signal. Every failure releases the acquired prefix.
  registered=0
  IF EXEC.AllocSignal(31)=31 THEN
    IF EXEC.AllocSignal(30)=30 THEN
      IF EXEC.AllocSignal(29)=29 THEN
        registered=EXEC.RegisterResident(STOP_MASK)
        IF registered=0 THEN
          EXEC.FreeSignal(29)
        FI
      FI

      IF registered=0 THEN
        EXEC.FreeSignal(30)
      FI
    FI

    IF registered=0 THEN
      EXEC.FreeSignal(31)
    FI
  FI

  IF registered=0 THEN
    service.error=CARD(EXEC.IOERR_OPENFAIL)
    EXEC.Forbid()
    RetireWorker(service)
    RETURN
  FI

  registered=Initialize(service,defaultInstance)
  IF registered<>0 AND CONSOLEHOST.Start()=0 THEN
    CONSOLECAPTURE.Release()
    registered=0
  FI

  IF registered=0 THEN
    FreeStorage(service,defaultInstance)
    registered=EXEC.UnregisterResident()
    EXEC.FreeSignal(29)
    EXEC.FreeSignal(30)
    EXEC.FreeSignal(31)
    service.error=CARD(EXEC.IOERR_OPENFAIL)
    EXEC.Forbid()
    RetireWorker(service)
    RETURN
  FI

  displayMask=CONSOLEBITMAP.Mask()
  LET desktopMask=CONSOLEHOST.Mask()
  EXEC.Forbid()
  IF service.stop=0 THEN
    service.state=2
  ELSE
    service.state=3
  FI

  Notify(service)
  EXEC.Permit()

  bits=0
  stopping=0
  inputPending=1
  handoff=0
  ; Stop may be requested after the final write reply but before DMA retires.
  WHILE service.stop=0 OR CONSOLEBITMAP.Pending()<>0
      OR batch.phase<>CONSOLETYPES.BATCH_IDLE DO
    bits=Collect(bits,displayMask OR desktopMask)
    IF (bits & STOP_MASK)<>0 THEN
      stopping=1
    FI

    CONSOLEDISPLAY.Poll((bits & displayMask)<>0)
    IF stopping<>0 AND CONSOLEBITMAP.Pending()=0 THEN
      EXEC.Forbid()
      accepted=RequestStop(service)
      EXEC.Permit()
      IF service.stop<>0 THEN
        CONSOLEDISPLAY.DiscardBatch()
        EXIT
      FI
    FI

    IF (bits & CONSOLEHOST.InputMask())<>0 THEN
      CONSOLEHOST.InputService(bits)
      CONSOLEHOST.InputPresent()
    FI

    CONSOLEHOST.Controls()
    IF CONSOLEHOST.Ready()<>0 THEN
      CONSOLECONTROL.Process()
    FI
    CONSOLEHOST.InputService(bits)
    CONSOLEHOST.InputAdvance()
    inputPending=CONSOLEINPUT.Service(defaultInstance,bits,inputPending)
    ; Present newly consumed motion before spending another quantum on output.
    ; Intersecting draws erase it safely and the final pass restores it.
    CONSOLEHOST.InputPresent()
    bits=0

    ; Commit visible GUI feedback before starting another console-output
    ; quantum. An existing scene/DMA owner still gates both paths; painting
    ; retains its one-quantum budget for this turn.
    deferOutput=0
    IF CONSOLEHOST.PaintPump()<>0 THEN
      CONSOLEHOST.InputService(CONSOLEHOST.InputMask())
      IF handoff=0 AND CONSOLEHOST.ControlPending()<>0 THEN
        ; One handoff at most before the next eligible output quantum. This
        ; lets queued status patches run without starving console writers.
        handoff=1
        deferOutput=1
      FI
    FI
    CONSOLEHOST.InputPresent()

    CONSOLEHOST.AfterPaint()
    Arrival(service)
    entry=CONSOLEWINDOWS.Take()
    again=0
    writing=0
    IF entry<>NULL THEN
      instance=CONSOLETYPES.Instance POINTER(entry.instance)
      instance.changeTick=DISPLAYADAPTER.Ticks()
      ReadQuantum(service,instance)
      BEGIN
        LET view=CONSOLETYPES.Presentation POINTER(entry.view)
        IF deferOutput=0 AND CONSOLEBITMAP.Pending()=0
            AND CONSOLEHOST.PaintReady()<>0 AND
            (batch.phase=CONSOLETYPES.BATCH_IDLE OR batch.unit=entry.unit) THEN
          handoff=0
          completeWrite=0
          IF view.scrollState<>0
              AND view.scrollState<>CONSOLETYPES.SCROLL_GATHER THEN
            CONSOLEDISPLAY.Advance(view,instance,entry.unit)
          ELSE
            completeWrite=WriteQuantum(instance,view,entry.unit)
          FI

          CONSOLEDISPLAY.Present(view,instance)
          IF completeWrite<>0 THEN
            BEGIN
              LET request=EXEC.IOStdReq POINTER(instance.write)
              IF CONSOLEBITMAP.Failed()<>0 THEN
                request.io_Error=BYTE(EXEC.IOERR_SELFTEST)
              FI

              FinishWrite(instance,request)
            END
          FI
        FI

        ; Cancellation may finish a retained model edit while pixels are held.
        IF CONSOLELOCKS.PaintBlocked()<>0 AND CONSOLEBITMAP.Pending()=0
            AND instance.write<>NULL AND instance.writeCancel<>0 THEN
          CONSOLECORE.EditQuantum(instance)
          IF instance.operation=CONSOLETYPES.OP_IDLE THEN
            FinishWrite(instance,EXEC.IOStdReq POINTER(instance.write))
          FI
        FI

        writing=instance.write<>NULL AND (CONSOLELOCKS.PaintBlocked()=0
            OR instance.writeCancel<>0)
        again=(writing<>0 AND instance.writeCancel<>0)
            OR (view.scrollState<>0 AND CONSOLELOCKS.PaintBlocked()=0)
        IF batch.phase=CONSOLETYPES.BATCH_GATHER THEN
          again=0
        FI
      END
      entry.busy=0
    FI

    CONSOLEHOST.InputPresent()
    CONSOLEHOST.Events()
    CONSOLEHOST.Settle()
    IF stopping=0 AND writing=0 AND again=0
        AND Runnable(service,inputPending)=0 AND CONSOLEHOST.Runnable()=0 THEN
      CONSOLEHOST.Cache()
    FI

    IF CONSOLEBITMAP.Pending()<>0 THEN
      IF Runnable(service,inputPending)<>0 OR CONSOLEHOST.Runnable()<>0 THEN
        EXEC.Yield()
      ELSE
        bits=EXEC.Wait($e0000000 OR displayMask OR desktopMask)
      FI
    ELSEIF again=0 AND CONSOLEHOST.PaintPending()=0 THEN
      ; Ready paint continues within the existing preemptive Task quantum.
      ; Do not add a voluntary round-robin pass between its bounded stripes.
      ; Blocked paint still follows the normal signal wait below.
      IF writing<>0 THEN
        EXEC.Yield()
      ELSEIF Runnable(service,inputPending)=0 AND CONSOLEHOST.Runnable()=0 THEN
        ; Never clear the request/input signals between this hint and Wait.
        bits=EXEC.Wait($e0000000 OR displayMask OR desktopMask)
      ELSE
        EXEC.Yield()
      FI
    FI
  OD

  CONSOLEHOST.Stop()
  registered=EXEC.UnregisterResident()
  EXEC.FreeSignal(29)
  CONSOLECAPTURE.Release()
  EXEC.FreeSignal(30)
  EXEC.FreeSignal(31)
  FreeStorage(service,defaultInstance)
  EXEC.Forbid()
  RetireWorker(service)

RETURN

ENDMODULE
