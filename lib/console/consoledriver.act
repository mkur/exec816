; One resident console worker; public calls use the unchanged Exec IOStdReq.
MODULE CONSOLEDRIVER
USE EXEC
USE AESSYSTEM
USE AESLOCKS
USE TASKSTACKS
USE A816MEMORY
USE EXECLISTS
USE EXECMEMORY
USE TASKMEMORY
USE HEAPCORE
USE SYS
USE ASCII
USE BOOTDIAG
USE CONSOLETYPES
USE CONSOLECORE
USE CONSOLEBATCH
USE CONSOLEBACKEND
USE CONSOLEINGRESS
USE CONSOLEFRONT
USE CONSOLEMIRROR
USE CONSOLEVIEWCORE
USE CONSOLEWINDOWS
USE CONSOLEFOREGROUND
USE CONSOLECAPTURE
USE CONSOLEINPUT
USE CONSOLECOOKED
USE CONSOLEDISPLAY
USE CONSOLEBITMAP
USE CONSOLECONTROL
USE DISPLAY
USE DISPLAYADAPTER
USE DESKHOST
USE DESKINPUT
USE DESKMENUCACHE
USE DESKSTATE
INCLUDE "console-storage-action.inc"
CONST DELETE=127

PUBLIC CONSOLETYPES.Service POINTER FUNC GetService()

RETURN(CONSOLETYPES.Service POINTER(ADDRESS(CS_BASE)))

PUBLIC CONSOLETYPES.Instance POINTER FUNC GetInstance()

RETURN(CONSOLETYPES.Instance POINTER(ADDRESS(CS_INSTANCE)))

; Publish capabilities only while the worker is ready and accepting work.
PUBLIC CARD FUNC ScreenWidth()
  CARD width

  LET service=GetService()
  EXEC.Forbid()
  width=0
  IF service.state=2 AND service.stop=0 AND CONSOLEBITMAP.Failed()=0 THEN
    width=CONSOLEDISPLAY.Width()
  FI

  EXEC.Permit()

RETURN(width)

PUBLIC CARD FUNC ScreenHeight()
  CARD height

  LET service=GetService()
  EXEC.Forbid()
  height=0
  IF service.state=2 AND service.stop=0 AND CONSOLEBITMAP.Failed()=0 THEN
    height=CONSOLEDISPLAY.Height()
  FI

  EXEC.Permit()

RETURN(height)

; Require a complete writable extent before the worker borrows caller storage.
BYTE FUNC Mapped(BYTE POINTER buffer LONGCARD bytes)
  EXECMEMORY.BankRecord info
  CARD first,last,index

  IF buffer=BYTE POINTER(0)
      OR bytes>LONGCARD($1000000)-LONGCARD(ADDRESS(buffer)) THEN
    RETURN(0)
  FI

  first=CARD(ADDRESS(buffer) RSH 16)
  last=CARD((LONGCARD(ADDRESS(buffer))+bytes-1) RSH 16)
  ; Task images and AllocMem payloads use upper RAM in this initial profile.
  ; Bank-zero spans are checked by protected admission against writable images.
  IF first=0 THEN
    RETURN(0)
  FI

  FOR index=first TO last DO
    IF EXECMEMORY.Query(index,@info)<>0 THEN
      RETURN(0)
    FI

    IF info.state=0 THEN
      RETURN(0)
    FI
  OD

RETURN(1)

; Check retained terminal geometry and storage before admitting it to service.
BYTE FUNC Validate(EXEC.IOStdReq POINTER request)

  IF request.io_Offset<>0
      AND request.io_Command<>CONSOLETYPES.CONCMD_WRITE_AT
      AND request.io_Command<>CONSOLETYPES.CONCMD_WRITE_CELLS THEN
    RETURN(BYTE(EXEC.IOERR_BADADDRESS))
  FI

  IF request.io_Command=EXEC.CMD_WRITE
      AND request.io_Length=LONGCARD($ffffffff) THEN
    RETURN(BYTE(EXEC.IOERR_BADLENGTH))
  FI

  IF request.io_Length<>0 THEN
    IF request.io_Data=BYTE POINTER(0)
        OR request.io_Length>LONGCARD($1000000)-LONGCARD(ADDRESS(
        request.io_Data)) THEN
      RETURN(BYTE(EXEC.IOERR_BADADDRESS))
    FI

    IF (ADDRESS(request.io_Data) RSH 16)=0 THEN
      IF TASKMEMORY.Writable(ADDRESS(request.io_Data),
          SIZE(request.io_Length))=0 THEN
        RETURN(BYTE(EXEC.IOERR_BADADDRESS))
      FI

      RETURN(0)
    FI

    IF Mapped(request.io_Data,request.io_Length)=0 THEN
      RETURN(BYTE(EXEC.IOERR_BADADDRESS))
    FI
  FI

RETURN(0)

INCLUDE "console-requests.inc"
INCLUDE "console-lifetime.inc"
INCLUDE "console-spans.inc"

; Check the whole positioned span before committing its first byte. Geometry
; is stable while the worker owns this borrow; a later resize drains it first.
BYTE FUNC PositionValid(CONSOLETYPES.Instance POINTER instance
    EXEC.IOStdReq POINTER request)
  CARD index

  LET column=CARD(request.io_Offset)
  LET row=CARD(request.io_Offset RSH CONSOLETYPES.POSITION_ROW_SHIFT)
  IF row>=instance.height OR column>=instance.width THEN
    RETURN(BYTE(EXEC.IOERR_BADADDRESS))
  FI

  IF request.io_Length>LONGCARD(instance.width-column) THEN
    RETURN(BYTE(EXEC.IOERR_BADLENGTH))
  FI

  FOR index=0 TO CARD(request.io_Length)-1 DO
    IF request.io_Command=CONSOLETYPES.CONCMD_WRITE_AT AND
        (request.io_Data(index)<ASCII.SPACE OR request.io_Data(index)>=127) THEN
      RETURN(BYTE(EXEC.IOERR_BADLENGTH))
    FI
  OD

RETURN(0)

; Use the same FIFO, cancellation identity and short-write presentation as
; stream output, without scrolling or moving the cursor.
BYTE FUNC PositionedWrite(CONSOLETYPES.Instance POINTER instance
    EXEC.IOStdReq POINTER request)
  CARD count

  IF instance.writeCancel<>0 OR request.io_Actual=request.io_Length THEN
    FinishWrite(instance,request)
    RETURN(0)
  FI

  count=CARD(request.io_Length-request.io_Actual)
  IF count>CONSOLETYPES.SOURCE_QUANTUM THEN
    count=CONSOLETYPES.SOURCE_QUANTUM
  FI

  CONSOLECORE.WriteAt(instance,CARD(request.io_Offset)+CARD(request.io_Actual),
      CARD(request.io_Offset RSH CONSOLETYPES.POSITION_ROW_SHIFT),
      request.io_Data+SIZE(request.io_Actual),count)
  request.io_Actual==+LONGCARD(count)

RETURN(request.io_Actual=request.io_Length)

; Advance model ownership without depending on physical drawing or UPDATE.
PROC WriteQuantum(CONSOLETYPES.Instance POINTER instance)
  EXEC.IOStdReq POINTER request
  CARD limit,error

  request=EXEC.IOStdReq POINTER(instance.write)
  IF request=NULL THEN
    request=ClaimWrite(instance)
    IF request=NULL THEN
      RETURN
    FI
    error=Validate(request)
    IF error=0 AND (request.io_Command=CONSOLETYPES.CONCMD_WRITE_AT OR
        request.io_Command=CONSOLETYPES.CONCMD_WRITE_CELLS) THEN
      error=PositionValid(instance,request)
    FI
    IF error=0 AND request.io_Command=CONSOLETYPES.CONCMD_WRITE_CELL_SPANS THEN
      error=SpansValid(instance,request)
    FI
    IF error<>0 THEN
      request.io_Error=BYTE(error)
      FinishWrite(instance,request)
      RETURN
    FI
  FI
  IF instance.operation<>CONSOLETYPES.OP_IDLE THEN
    CONSOLECORE.EditQuantum(instance)
    IF instance.operation<>CONSOLETYPES.OP_IDLE THEN
      RETURN
    FI
  FI
  IF instance.writeCancel<>0 THEN
    FinishWrite(instance,request)
    RETURN
  FI
  IF request.io_Command=CONSOLETYPES.CONCMD_MODE THEN
    IF request.io_Length<>1 OR (request.io_Data(0) & $1f)<>0 THEN
      request.io_Error=BYTE(EXEC.IOERR_BADLENGTH)
    ELSE
      CONSOLECOOKED.Clear(instance)
      instance.caps=(instance.caps & 1) OR request.io_Data(0)
      CONSOLECORE.Dirty(instance,0,instance.count)
      request.io_Actual=1
    FI
  ELSEIF request.io_Command=CONSOLETYPES.CONCMD_WRITE_AT OR
      request.io_Command=CONSOLETYPES.CONCMD_WRITE_CELLS THEN
    error=PositionedWrite(instance,request)
    IF instance.write=NULL THEN
      RETURN
    FI
  ELSEIF request.io_Command=CONSOLETYPES.CONCMD_WRITE_CELL_SPANS THEN
    error=SpansWrite(instance,request)
    IF instance.write=NULL THEN
      RETURN
    FI
  ELSEIF request.io_Actual<request.io_Length THEN
    BEGIN
      LET remaining=request.io_Length-request.io_Actual
      limit=CONSOLETYPES.SOURCE_QUANTUM
      IF remaining<LONGCARD(limit) THEN
        limit=CARD(remaining)
      FI
      request.io_Actual==+LONGCARD(CONSOLECORE.Feed(instance,
          request.io_Data+SIZE(request.io_Actual),limit))
    END
  FI
  IF request.io_Actual=request.io_Length AND instance.operation=CONSOLETYPES.OP_IDLE THEN
    FinishWrite(instance,request)
  FI

RETURN

; Complete available input or cancellation without blocking the console
; worker.
PROC ReadQuantum(CONSOLETYPES.Service POINTER service CONSOLETYPES.Instance
    POINTER instance)
  EXEC.IOStdReq POINTER request
  CARD count,limit
  LONGCARD ignored

  request=EXEC.IOStdReq POINTER(instance.read)
  IF request=EXEC.IOStdReq POINTER(0) OR instance.readReady=0 THEN
    RETURN
  FI

  IF instance.readReady=1 THEN
    request.io_Error=Validate(request)
    instance.readReady=2
  FI

  IF instance.readCancel<>0 THEN
    request.io_Error=BYTE(EXEC.IOERR_ABORTED)
  FI

  IF CONSOLEBITMAP.Failed()<>0 THEN
    request.io_Error=BYTE(EXEC.IOERR_SELFTEST)
  FI

  IF request.io_Error=0 THEN
    IF instance.inputCount=0 AND instance.inputLost=0 THEN
      RETURN
    FI

    limit=64
    IF request.io_Length<64 THEN
      limit=CARD(request.io_Length)
    FI

    count=CONSOLECOOKED.Read(instance,request.io_Data,limit)
    IF count=$ffff THEN
      request.io_Error=CONSOLETYPES.CONERR_INPUTOVERFLOW
    ELSE
      request.io_Actual=LONGCARD(count)
    FI
  FI

  FinishRead(instance,request)

RETURN

; Acquire console storage and the OS display before publishing readiness.
BYTE FUNC Initialize(CONSOLETYPES.Service POINTER service CONSOLETYPES.Instance
    POINTER instance)
  BYTE POINTER cells,fifo
  CONSOLETYPES.Presentation POINTER view
  CONSOLETYPES.Windows POINTER windows
  CONSOLETYPES.Window POINTER entry
  BYTE registered

  windows=CONSOLEWINDOWS.Registry()
  CONSOLEBATCH.Reset()
  entry=@windows.items(0)
  entry.unit=0
  entry.owner=BYTE POINTER(0)
  entry.instance=BYTE POINTER(instance)
  entry.view=BYTE POINTER(ADDRESS(CS_PRESENTATION))
  entry.state=CONSOLETYPES.WIN_CREATING
  LET width=CONSOLEDISPLAY.Width()
  LET height=CONSOLEDISPLAY.Height()
  IF width=0 OR width>CONSOLETYPES.MAX_WIDTH
      OR height=0 OR height>CONSOLETYPES.MAX_HEIGHT THEN
    RETURN(0)
  FI

  instance.count=width*height
  instance.capacity=instance.count
  cells=EXEC.AllocMem(LONGCARD(instance.count),EXEC.MEMF_PUBLIC)
  fifo=EXEC.AllocMem(128,EXEC.MEMF_PUBLIC)
  instance.cells=cells
  instance.fifo=fifo
  IF cells=BYTE POINTER(0) OR fifo=BYTE POINTER(0) THEN
    RETURN(0)
  FI

  IF CONSOLECORE.Init(instance,cells,width,height,LONGCARD(instance.count))=0 THEN
    RETURN(0)
  FI

  WHILE instance.operation<>CONSOLETYPES.OP_IDLE DO
    CONSOLECORE.EditQuantum(instance)
    EXEC.Yield()
  OD

  CONSOLECOOKED.Init(instance,fifo)
  view=CONSOLETYPES.Presentation POINTER(ADDRESS(CS_PRESENTATION))
  service.presentation=BYTE POINTER(view)
  service.snapshot=EXEC.AllocMem(960,EXEC.MEMF_PUBLIC)
  IF service.snapshot=BYTE POINTER(0) THEN
    RETURN(0)
  FI

  IF CONSOLEDISPLAY.Claim(view,instance,service.snapshot)=0 THEN
    RETURN(0)
  FI

  CONSOLEDISPLAY.Adopt(view,instance)
  IF CONSOLEMIRROR.Create(view,instance)=0 THEN
    RETURN(0)
  FI
  IF CONSOLECAPTURE.Acquire()=0 THEN
    RETURN(0)
  FI

  EXEC.Forbid()
  registered=CONSOLEFOREGROUND.Register(entry)
  IF registered<>0 THEN
    entry.state=CONSOLETYPES.WIN_LIVE
    windows.liveCount=1
    windows.focusSlot=0
    CONSOLECAPTURE.Publish(entry.route)
  FI

  EXEC.Permit()
  IF registered=0 THEN
    CONSOLECAPTURE.Release()
    RETURN(0)
  FI


RETURN(1)

; Release driver allocations after requests and display ownership have
; retired.
PROC FreeStorage(CONSOLETYPES.Service POINTER service CONSOLETYPES.Instance
    POINTER instance)
  CONSOLETYPES.Presentation POINTER view
  CONSOLETYPES.Windows POINTER windows
  CONSOLETYPES.Window POINTER entry

  windows=CONSOLEWINDOWS.Registry()
  entry=@windows.items(0)
  EXEC.Forbid()
  windows.liveCount=0
  entry.state=CONSOLETYPES.WIN_RETIRING
  CONSOLEFOREGROUND.Unregister(entry)
  CONSOLEVIEWCORE.Retire(instance)
  EXEC.Permit()
  view=CONSOLETYPES.Presentation POINTER(ADDRESS(CS_PRESENTATION))
  CONSOLEDISPLAY.Release(view)
  ; Failed startup may still have the original source binding.
  IF view.instance<>BYTE POINTER(instance) THEN
    CONSOLEMIRROR.Free(view)
  FI
  IF service.snapshot<>BYTE POINTER(0) THEN
    EXEC.FreeMem(service.snapshot,960)
    service.snapshot=BYTE POINTER(0)
    view.snapshot=BYTE POINTER(0)
  FI

  IF instance.cells<>BYTE POINTER(0) THEN
    EXEC.FreeMem(instance.cells,LONGCARD(instance.capacity))
    instance.cells=BYTE POINTER(0)
  FI

  IF instance.fifo<>BYTE POINTER(0) THEN
    EXEC.FreeMem(instance.fifo,128)
    instance.fifo=BYTE POINTER(0)
  FI

  EXEC.Forbid()
  CONSOLEWINDOWS.Retired(entry)
  EXEC.Permit()

RETURN

; Console backend operations used by the graphical system Task. Each turn
; releases every borrowed instance before returning to input/event dispatch.
PROC SystemControls()

  CONSOLECONTROL.Process()

RETURN

BYTE FUNC SystemInput(LONGCARD bits BYTE pending)

RETURN(CONSOLEINPUT.Service(GetInstance(),bits,pending))

BYTE FUNC SystemRunnable(BYTE pending)

RETURN((pending<>0 AND DESKINPUT.KeyReady()<>0)
    OR CONSOLEDISPLAY.CompletionReady()<>0 OR CONSOLEFRONT.Runnable())

BYTE FUNC SystemStopping()

  LET service=GetService()

RETURN(service.stop<>0)

BYTE FUNC SystemStop()
  BYTE accepted

  EXEC.Forbid()
  accepted=RequestStop(GetService())
  EXEC.Permit()

RETURN(accepted)

BYTE FUNC BackendTurn()
  BYTE index
  CONSOLETYPES.Window POINTER entry

  LET service=GetService()
  IF service.state<>2 THEN
    RETURN(0)
  FI
  Arrival(service)
  CONSOLEINGRESS.Pump()
  LET windows=CONSOLEWINDOWS.Registry()
  FOR index=0 TO CONSOLETYPES.WINDOW_SLOTS-1 DO
    entry=@windows.items(index)
    IF entry.state=CONSOLETYPES.WIN_LIVE THEN
      BEGIN
        LET source=CONSOLETYPES.Instance POINTER(entry.instance)
        ReadQuantum(service,source)
        WriteQuantum(source)
        CONSOLEVIEWCORE.Publish(source)
      END
    FI
  OD

RETURN(Runnable(service,0) OR CONSOLEINGRESS.Pending())

BYTE FUNC SystemTurn(BYTE deferred BYTE POINTER again,writing,handoff)

  writing^=0
  handoff^=0
  again^=0
  IF deferred<>0 THEN
    RETURN(0)
  FI

RETURN(CONSOLEFRONT.Turn(again))

; One bounded turn per borrowed instance. No request or instance pointer remains
; borrowed across Yield/Wait, and replies publish ownership exactly once.
PUBLIC PROC Worker()
  BYTE registered

  EXEC.Forbid()
  LET service=GetService()
  LET defaultInstance=GetInstance()
  LET self=EXEC.FindTask(NULL)
  IF service.worker<>BYTE POINTER(self) OR service.state<>1
      OR service.lease.task<>self THEN
    EXEC.Permit()
    RETURN
  FI

  EXEC.Permit()

  ; Reserve request, input and resident-stop bits before Open allocates
  ; the display completion signal. Every failure releases the acquired prefix.
  registered=0
  IF EXEC.AllocSignal(31)=31 THEN
    IF EXEC.AllocSignal(30)=30 THEN
      IF EXEC.AllocSignal(29)=29 THEN
        registered=EXEC.RegisterResident(STOP_MASK)
        IF registered=0 THEN
          EXEC.FreeSignal(29)
        FI
      FI

      IF registered=0 THEN
        EXEC.FreeSignal(30)
      FI
    FI

    IF registered=0 THEN
      EXEC.FreeSignal(31)
    FI
  FI

  IF registered=0 THEN
    service.error=CARD(EXEC.IOERR_OPENFAIL)
    EXEC.Forbid()
    RetireWorker(service)
    RETURN
  FI

  IF BOOTDIAG.Active()<>0 THEN
    BOOTDIAG.Report(BOOTDIAG.WORKER,0)
  FI

  AESSYSTEM.BindConsole(ADDRESS(@SystemInput),ADDRESS(@SystemRunnable),
      ADDRESS(@SystemStopping),ADDRESS(@SystemStop),ADDRESS(@SystemTurn),
      ADDRESS(@SystemControls))
  registered=Initialize(service,defaultInstance)
  IF registered<>0 AND AESSYSTEM.Start()=0 THEN
    CONSOLECAPTURE.Release()
    registered=0
  FI

  IF registered<>0 AND CONSOLEBACKEND.Start(ADDRESS(@BackendTurn))=0 THEN
    AESSYSTEM.Stop()
    CONSOLECAPTURE.Release()
    registered=0
  FI

  IF registered<>0 AND CONSOLEFRONT.Start()=0 THEN
    CONSOLEBACKEND.Stop()
    AESSYSTEM.Stop()
    CONSOLECAPTURE.Release()
    registered=0
  FI

  IF registered=0 THEN
    FreeStorage(service,defaultInstance)
    registered=EXEC.UnregisterResident()
    EXEC.FreeSignal(29)
    EXEC.FreeSignal(30)
    EXEC.FreeSignal(31)
    service.error=CARD(EXEC.IOERR_OPENFAIL)
    EXEC.Forbid()
    RetireWorker(service)
    RETURN
  FI

  EXEC.Forbid()
  IF service.stop=0 THEN
    service.state=2
  ELSE
    service.state=3
  FI

  service.port.mp_SigTask=CONSOLEBACKEND.Task()
  Notify(service)
  CONSOLEBACKEND.Wake()
  EXEC.Permit()

  AESSYSTEM.Run()

  CONSOLEFRONT.Stop()
  AESSYSTEM.Stop()
  CONSOLEBACKEND.Stop()
  registered=EXEC.UnregisterResident()
  EXEC.FreeSignal(29)
  CONSOLECAPTURE.Release()
  EXEC.FreeSignal(30)
  EXEC.FreeSignal(31)
  FreeStorage(service,defaultInstance)
  EXEC.Forbid()
  RetireWorker(service)

RETURN

ENDMODULE
