; Optional GUI frontend binding. Default console operation has no AES imports.
; Install/Remove run with the frontend stopped; each callable has a fixed slot.
MODULE CONSOLEUI
USE INPUT
USE CONSOLEVIEWTYPES AS VIEW

PUBLIC TYPE Hooks=[
  ADDRESS bindEntry,startEntry,runEntry,stopEntry,idleEntry,paintEntry
  ADDRESS beginEntry,endEntry,blockedEntry,suspendEntry,resumeEntry
  ADDRESS keyEntry,keyReadyEntry,advanceEntry,ownedEntry,windowEntry
]
BYTE configured
PROC POINTER bindFn(ADDRESS input,runnable,stopping,stop,turn,controls)
BYTE FUNC POINTER startFn()
PROC POINTER runFn()
PROC POINTER stopFn()
BYTE FUNC POINTER idleFn()
BYTE FUNC POINTER paintFn()
BYTE FUNC POINTER beginFn()
PROC POINTER endFn()
BYTE FUNC POINTER blockedFn()
BYTE FUNC POINTER suspendFn()
PROC POINTER resumeFn(BYTE held)
BYTE FUNC POINTER keyFn(INPUT.Event POINTER event)
BYTE FUNC POINTER keyReadyFn()
PROC POINTER advanceFn()
BYTE FUNC POINTER ownedFn()
CARD FUNC POINTER windowFn(LONGCARD handle INT window BYTE bound)

PROC BindEntry(ADDRESS location,entry)

  LET destination=ADDRESS POINTER(location)
  destination^=entry

RETURN

PUBLIC PROC Install(Hooks POINTER table)

  BindEntry(ADDRESS(@bindFn),table.bindEntry)
  BindEntry(ADDRESS(@startFn),table.startEntry)
  BindEntry(ADDRESS(@runFn),table.runEntry)
  BindEntry(ADDRESS(@stopFn),table.stopEntry)
  BindEntry(ADDRESS(@idleFn),table.idleEntry)
  BindEntry(ADDRESS(@paintFn),table.paintEntry)
  BindEntry(ADDRESS(@beginFn),table.beginEntry)
  BindEntry(ADDRESS(@endFn),table.endEntry)
  BindEntry(ADDRESS(@blockedFn),table.blockedEntry)
  BindEntry(ADDRESS(@suspendFn),table.suspendEntry)
  BindEntry(ADDRESS(@resumeFn),table.resumeEntry)
  BindEntry(ADDRESS(@keyFn),table.keyEntry)
  BindEntry(ADDRESS(@keyReadyFn),table.keyReadyEntry)
  BindEntry(ADDRESS(@advanceFn),table.advanceEntry)
  BindEntry(ADDRESS(@ownedFn),table.ownedEntry)
  BindEntry(ADDRESS(@windowFn),table.windowEntry)
  configured=1

RETURN

PUBLIC PROC Remove()

  configured=0

RETURN

PUBLIC BYTE FUNC Enabled()

RETURN(configured)

PUBLIC PROC BindConsole(ADDRESS input,runnable,stopping,stop,turn,controls)

  IF configured<>0 THEN
    bindFn(input,runnable,stopping,stop,turn,controls)
  FI

RETURN

PUBLIC BYTE FUNC Start()

  IF configured<>0 THEN
    RETURN(startFn())
  FI

RETURN(1)

PUBLIC PROC Run()

  IF configured<>0 THEN
    runFn()
  FI

RETURN

PUBLIC PROC Stop()

  IF configured<>0 THEN
    stopFn()
  FI

RETURN

PUBLIC BYTE FUNC Idle()

  IF configured<>0 THEN
    RETURN(idleFn())
  FI

RETURN(1)

PUBLIC BYTE FUNC PaintReady()

  IF configured<>0 THEN
    RETURN(paintFn())
  FI

RETURN(1)

PUBLIC BYTE FUNC SystemBegin()

  IF configured<>0 THEN
    RETURN(beginFn())
  FI

RETURN(1)

PUBLIC PROC SystemEnd()

  IF configured<>0 THEN
    endFn()
  FI

RETURN

PUBLIC BYTE FUNC PaintBlocked()

  IF configured<>0 THEN
    RETURN(blockedFn())
  FI

RETURN(0)

PUBLIC BYTE FUNC Suspend()

  IF configured<>0 THEN
    RETURN(suspendFn())
  FI

RETURN(0)

PUBLIC PROC Resume(BYTE held)

  IF configured<>0 THEN
    resumeFn(held)
  FI

RETURN

PUBLIC BYTE FUNC Key(INPUT.Event POINTER event)

  IF configured<>0 THEN
    RETURN(keyFn(event))
  FI

RETURN(0)

PUBLIC BYTE FUNC KeyReady()

  IF configured<>0 THEN
    RETURN(keyReadyFn())
  FI

RETURN(1)

PUBLIC PROC Advance()

  IF configured<>0 THEN
    advanceFn()
  FI

RETURN

PUBLIC BYTE FUNC SystemOwned()

  IF configured<>0 THEN
    RETURN(ownedFn())
  FI

RETURN(0)

PUBLIC CARD FUNC InputWindow(LONGCARD handle INT window BYTE bound)

  IF configured<>0 THEN
    RETURN(windowFn(handle,window,bound))
  FI

RETURN(VIEW.UNSUPPORTED)

ENDMODULE
