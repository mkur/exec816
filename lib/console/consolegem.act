; Optional GEM policy and manager binding, installed before console startup.
MODULE CONSOLEGEM
USE EXEC
USE CONSOLEUI
USE CONSOLEVIEWTYPES AS VIEW
USE CONSOLEVIEWCORE AS VIEWS
USE SCRENMGR
USE AESLOCKS
USE AESSTATE
USE AESTYPES
USE AESWINDOWSTATE
USE DESKSTATE
USE DESKTYPES
USE DESKCORE
USE DESKHOST
USE DESKINPUT
USE DESKMENU

PUBLIC PROC Install()
  CONSOLEUI.Hooks table

  table.startEntry=ADDRESS(@SCRENMGR.Start)
  table.runEntry=ADDRESS(@SCRENMGR.Run)
  table.stopEntry=ADDRESS(@SCRENMGR.Stop)
  table.idleEntry=ADDRESS(@DESKHOST.Idle)
  table.keyEntry=ADDRESS(@DESKINPUT.CaptureKey)
  table.windowEntry=ADDRESS(@InputWindow)
  CONSOLEUI.Install(@table)

RETURN

PUBLIC CARD FUNC InputWindow(LONGCARD handle INT window BYTE bound)
  CARD status
  BYTE slot
  AESSTATE.Client POINTER client
  DESKTYPES.Window POINTER item

  LET service=AESSTATE.Get()
  IF service=NULL THEN
    RETURN(VIEW.UNSUPPORTED)
  FI
  LET self=EXEC.FindTask(NULL)
  AESLOCKS.ObtainUI()
  client=NULL
  FOR slot=0 TO AESTYPES.CLIENTS-1 DO
    IF service.clients(slot).id<>0 AND service.clients(slot).lease.task=self THEN
      client=@service.clients(slot)
    FI
  OD
  status=VIEW.NOT_OWNER
  item=NULL
  IF client<>NULL THEN
    item=AESWINDOWSTATE.Handle(client,window)
  FI
  IF item<>NULL THEN
    status=VIEW.OK
    IF bound<>0 AND VIEWS.Closed(handle)<>0 THEN
      status=VIEW.CLOSED
    ELSE
      item.inputBound=bound
      IF bound<>0 THEN
        item.inputUnit=VIEWS.Unit(handle)
      ELSE
        item.inputUnit=0
      FI
      DESKCORE.PublishInput(DESKSTATE.Get())
    FI
  FI
  AESLOCKS.ReleaseUI()

RETURN(status)

ENDMODULE
