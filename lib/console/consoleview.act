; Public console service facade; no renderer or mutable cells cross this API.
MODULE CONSOLEVIEW
USE EXEC
USE DESKTYPES
USE AESSTATE
USE AESTYPES
USE AESWINDOWSTATE
USE AESGATE
USE DESKCORE
USE DESKSTATE
USE CONSOLETYPES
USE CONSOLEWINDOWS
USE CONSOLEVIEWCORE AS VIEWS
USE CONSOLEVIEWTYPES AS VIEW
USE CONSOLEINGRESS
INCLUDE "console-storage-action.inc"
LONGCARD requestedUnit,activationSerial

PUBLIC LONGCARD FUNC Subscribe(LONGCARD unit,mask)
  LONGCARD handle

  EXEC.Forbid()
  LET service=CONSOLETYPES.Service POINTER(ADDRESS(CS_BASE))
  LET entry=CONSOLEWINDOWS.Find(unit)
  IF entry=NULL OR service.stop<>0 OR
      (service.state<>2 AND (service.state<>1
        OR service.worker<>BYTE POINTER(EXEC.FindTask(NULL)))) THEN
    EXEC.Permit()
    RETURN(0)
  FI
  handle=VIEWS.Subscribe(CONSOLETYPES.Instance POINTER(entry.instance),unit,mask)
  IF handle<>0 THEN
    VIEWS.Route(CONSOLETYPES.Instance POINTER(entry.instance),entry.route)
  FI
  EXEC.Permit()

RETURN(handle)

PUBLIC CARD FUNC Input(LONGCARD handle VIEW.Input POINTER packet)
  CARD status

  IF packet.kind>VIEW.INPUT_CANCEL OR
      (packet.kind=VIEW.INPUT_BYTES AND (packet.count=0 OR packet.count>VIEW.CELLS)) THEN
    RETURN(VIEW.BAD_LAYOUT)
  FI
  EXEC.Forbid()
  IF VIEWS.Closed(handle)<>0 THEN
    EXEC.Permit()
    RETURN(VIEW.CLOSED)
  FI
  LET entry=CONSOLEWINDOWS.Find(VIEWS.Unit(handle))
  IF entry=NULL THEN
    EXEC.Permit()
    RETURN(VIEW.CLOSED)
  FI
  IF packet.route<>entry.route THEN
    EXEC.Permit()
    RETURN(VIEW.STALE)
  FI
  status=CONSOLEINGRESS.Post(entry.unit,packet.route,packet.event,
      packet.kind,packet.count,packet.bytes)
  EXEC.Permit()

RETURN(status)

; Bind capture routing to an ordinary owned GEM window. The window keeps its
; external-paint kind and receives normal AES messages. A unit is a scalar;
; source retirement is independent of this optional focus association.
PUBLIC CARD FUNC InputWindow(LONGCARD handle INT window BYTE bound)
  CARD status
  BYTE slot
  AESSTATE.Client POINTER client
  DESKTYPES.Window POINTER item

  LET service=AESSTATE.Get()
  IF service=NULL THEN
    RETURN(VIEW.UNSUPPORTED)
  FI
  LET self=EXEC.FindTask(NULL)
  LET bit=EXEC.AllocSignal(-1)
  IF bit=$ff THEN
    RETURN(VIEW.RESOURCE)
  FI
  AESGATE.EnterTask(self,LONGCARD(1) LSH bit)
  client=NULL
  FOR slot=0 TO AESTYPES.CLIENTS-1 DO
    IF service.clients(slot).id<>0 AND service.clients(slot).lease.task=self THEN
      client=@service.clients(slot)
    FI
  OD
  status=VIEW.NOT_OWNER
  item=NULL
  IF client<>NULL THEN
    item=AESWINDOWSTATE.Handle(client,window)
  FI
  IF item<>NULL THEN
    status=VIEW.OK
    IF bound<>0 AND VIEWS.Closed(handle)<>0 THEN
      status=VIEW.CLOSED
    ELSE
      item.inputBound=bound
      IF bound<>0 THEN
        item.inputUnit=VIEWS.Unit(handle)
      ELSE
        item.inputUnit=0
      FI
      DESKCORE.PublishInput(DESKSTATE.Get())
    FI
  FI
  AESGATE.Release(0)
  EXEC.FreeSignal(bit)

RETURN(status)

; Directory snapshots contain scalar identities and geometry only. Activation
; is a coalesced frontend request; it transfers no source or window ownership.
PUBLIC CARD FUNC Directory(VIEW.Directory POINTER target)
  BYTE slot

  EXEC.Forbid()
  LET windows=CONSOLEWINDOWS.Registry()
  target.live=0
  FOR slot=0 TO VIEW.SLOTS-1 DO
    BEGIN
      LET entry=@windows.items(slot)
      target.units(slot)=0
      target.widths(slot)=0
      target.heights(slot)=0
      IF CONSOLEWINDOWS.Live(entry)<>0 THEN
        BEGIN
          LET source=CONSOLETYPES.Instance POINTER(entry.instance)
          target.units(slot)=entry.unit
          target.widths(slot)=source.width
          target.heights(slot)=source.height
          target.live=target.live OR (CARD(1) LSH slot)
        END
      FI
    END
  OD
  target.activation=requestedUnit
  target.serial=activationSerial
  EXEC.Permit()

RETURN(VIEW.OK)

PUBLIC CARD FUNC Activate(LONGCARD unit)
  CARD status

  EXEC.Forbid()
  status=VIEW.UNSUPPORTED
  IF DESKSTATE.terminal<>0 THEN
    status=VIEW.CLOSED
    IF CONSOLEWINDOWS.Find(unit)<>NULL THEN
      status=VIEW.OVERFLOW
      IF activationSerial<>$ffffffff THEN
        requestedUnit=unit
        activationSerial==+1
        status=VIEW.OK
      FI
    FI
  FI
  EXEC.Permit()

RETURN(status)

; Three full-width arguments use the existing console library C bridge.
PUBLIC LONGCARD FUNC Call(LONGCARD operation,first,second)

  CASE operation OF
  WHEN VIEW.OP_SUBSCRIBE THEN
    RETURN(Subscribe(first,second))
  WHEN VIEW.OP_UNSUBSCRIBE THEN
    RETURN(LONGCARD(VIEWS.Unsubscribe(first)))
  WHEN VIEW.OP_SNAPSHOT THEN
    RETURN(LONGCARD(VIEWS.Snapshot(first,VIEW.Snapshot POINTER(ADDRESS(second)))))
  WHEN VIEW.OP_ACKNOWLEDGE THEN
    RETURN(LONGCARD(VIEWS.Acknowledge(first,second)))
  WHEN VIEW.OP_INPUT THEN
    RETURN(LONGCARD(Input(first,VIEW.Input POINTER(ADDRESS(second)))))
  WHEN VIEW.OP_PENDING THEN
    RETURN(LONGCARD(VIEWS.Pending(first)))
  WHEN VIEW.OP_BIND_WINDOW THEN
    RETURN(LONGCARD(InputWindow(first,INT(second),1)))
  WHEN VIEW.OP_UNBIND_WINDOW THEN
    RETURN(LONGCARD(InputWindow(0,INT(second),0)))
  WHEN VIEW.OP_DIRECTORY THEN
    RETURN(LONGCARD(Directory(VIEW.Directory POINTER(ADDRESS(first)))))
  WHEN VIEW.OP_ACTIVATE THEN
    RETURN(LONGCARD(Activate(first)))
  ESAC

RETURN(LONGCARD(VIEW.BAD_LAYOUT))

ENDMODULE
