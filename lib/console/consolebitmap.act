; Private binding and packet producer for the shared ordinary-call C library.
MODULE CONSOLEBITMAP
USE EXEC
USE CONSOLEBACKEND
USE DISPLAY
USE CONSOLETYPES
USE HEAPCORE
USE LAYERTYPES
USE REGIONS
USE CALYPSIMETA
USE CALYPSICALL
INCLUDE "console-storage-action.inc"
INCLUDE "console-bitmap-types.inc"
BYTE drawingPending,drawingChanged
BYTE physicalCompleted
CARD encoding
LONGCARD completionMask
ADDRESS callerEntry

PUBLIC EXTERNAL PROC Call(ADDRESS entry)

PUBLIC Binding POINTER FUNC GetBinding()

RETURN(Binding POINTER(ADDRESS(CS_BITMAP)))

PUBLIC BYTE FUNC Enabled()

  LET state=GetBinding()

RETURN(state.enabled)

PUBLIC BYTE FUNC Failed()

  LET state=GetBinding()

RETURN(state.failed)

; Foreign-image validation reserves these exact C code/data banks. Runtime
; checks prevent truncation, an odd packet or rebinding a live service.
PUBLIC BYTE FUNC Bind(LONGCARD entry,packet)

  LET state=GetBinding()
  LET service=CONSOLETYPES.Service POINTER(ADDRESS(CS_BASE))
  IF service.state<>0 OR state.enabled<>0 OR CALYPSIMETA.Code(entry)=0
      OR packet<$d0000 OR packet>LONGCARD($e0000)-PACKET_BYTES OR (packet & 1)<>0 THEN
    RETURN(0)
  FI

  state.entry=ADDRESS(entry)
  state.packet=BYTE POINTER(ADDRESS(packet))
  state.failed=0
  state.enabled=1

RETURN(1)

PUBLIC Packet POINTER FUNC GetPacket()

  LET state=GetBinding()

RETURN(Packet POINTER(state.packet))

; Presenter-only entry: service startup establishes the worker's ownership.
; Callers must not submit this shared packet from another Task. The packet never
; retains source buffers after return. SCROLL/POLL explicitly separate launch
; from completion; COPY_START shares that completion path. Other drawing
; operations remain synchronous.
PUBLIC BYTE FUNC Run(CARD operation)
  BYTE result
  CARD status

  LET state=GetBinding()
  IF state.enabled=0 THEN
    HEAPCORE.Abort(4)
  FI

  IF state.failed<>0 AND operation<>OP_CLOSE THEN
    RETURN(0)
  FI

  LET packet=GetPacket()
  packet.operation=operation
  packet.status=DISPLAY.BAD_ARGUMENT
  Call(state.entry)
  status=packet.status
  IF operation=OP_FILL OR operation=OP_TEXT OR operation=OP_TEXT_FILL
      OR operation=OP_TEXT_CLIP OR operation=OP_FRAME
      OR operation=OP_MENU_ROW OR operation=OP_DESKTOP
      OR operation=OP_SCROLL OR operation=OP_COPY_START THEN
    drawingChanged=1
  FI
  result=1
  IF status=DISPLAY.BUSY AND
      (operation=OP_SCROLL OR operation=OP_COPY_START OR operation=OP_POLL) THEN
    result=1
  ELSEIF status=DISPLAY.BUSY THEN
    result=0
  ELSEIF status<>DISPLAY.OK THEN
    state.failed=1
    CONSOLEBACKEND.Wake()
    result=0
  FI
  IF operation=OP_SCROLL OR operation=OP_COPY_START THEN
    drawingPending=(status=DISPLAY.OK AND packet.token<>0)
  ELSEIF operation=OP_POLL THEN
    drawingPending=(status=DISPLAY.BUSY)
    IF drawingPending=0 THEN
      physicalCompleted=1
    FI
  FI

RETURN(result)

; Another trusted renderer used this same owner and command arena.
PUBLIC BYTE FUNC Drawn(CARD status)

  drawingChanged=1
  IF status<>DISPLAY.OK THEN
    BEGIN
      LET state=GetBinding()
      state.failed=1
      CONSOLEBACKEND.Wake()
    END
    RETURN(0)
  FI

RETURN(1)

; Caller packets remain local through physical admission and the fence.
PUBLIC PROC ConfigureCaller(ADDRESS entry)

  callerEntry=entry

RETURN

PUBLIC PROC Apply(Packet POINTER packet)

  LET ignored=CALYPSICALL.Invoke(callerEntry,LONGCARD(ADDRESS(packet)))

RETURN

PUBLIC Packet POINTER FUNC Select(Packet POINTER output)

  IF output=NULL THEN
    RETURN(GetPacket())
  FI

RETURN(output)

PUBLIC BYTE FUNC Submit(Packet POINTER output CARD operation)

  IF output=NULL THEN
    BEGIN
      BYTE okay

      LET packet=GetPacket()
      DO
        okay=Run(operation)
        IF Failed()<>0 THEN
          RETURN(0)
        FI
        IF packet.status<>DISPLAY.BUSY THEN
          RETURN(okay)
        FI
        EXEC.Wait(completionMask)
      OD
    END
  FI
  output.operation=operation
  Apply(output)

RETURN(Drawn(output.status))

PUBLIC BYTE FUNC Open()
  BYTE ignored

  LET state=GetBinding()
  state.failed=0

  IF Run(OP_OPEN)=0 THEN
    RETURN(0)
  FI

  drawingPending=0
  LET packet=GetPacket()
  completionMask=packet.completionMask
  IF completionMask=0 THEN
    ignored=Run(OP_CLOSE)
    state.failed=1
    CONSOLEBACKEND.Wake()
    RETURN(0)
  FI

RETURN(1)

PUBLIC PROC Close()
  BYTE ignored

  LET packet=GetPacket()
  DO
    ignored=Run(OP_CLOSE)
    IF packet.status<>DISPLAY.BUSY THEN
      EXIT
    FI
    ; Idle grants retain the session. Their close publishes the existing
    ; owner wake; keep device storage and its signal until admission closes.
    EXEC.Wait(completionMask)
  OD
  drawingPending=0
  completionMask=0

RETURN

; Cached only for the owning worker's scheduling; no drawing authority.
PUBLIC LONGCARD FUNC Mask()

RETURN(completionMask)

PUBLIC BYTE FUNC RawFill(Packet POINTER output CARD left,top,width,height,pen)

  LET packet=Select(output)
  packet.x=left
  packet.y=top
  packet.width=width
  packet.height=height
  packet.background=pen

RETURN(Submit(output,OP_FILL))


; The sole worker selects the instance encoding for each presentation turn.
PUBLIC PROC SetEncoding(BYTE enabled)

  encoding=IF enabled<>0 THEN CARD(FOREGROUND_ATASCII) ELSE CARD(0) FI

RETURN



PUBLIC BYTE FUNC Background(Packet POINTER output LAYERTYPES.Rect POINTER clip)

  LET packet=Select(output)
  packet.clipLeft=CARD(clip.left)
  packet.clipTop=CARD(clip.top)
  packet.clipRight=CARD(clip.right)
  packet.clipBottom=CARD(clip.bottom)

RETURN(Submit(output,OP_DESKTOP))

PUBLIC BYTE FUNC Frame(Packet POINTER output LAYERTYPES.Rect POINTER bounds,clip
    BYTE POINTER title BYTE focused,closer
    CARD kind INT sliderTop,sliderHeight,sliderLeft,sliderWidth
    CARD POINTER progress)

  LET packet=Select(output)
  packet.x=CARD(bounds.left)
  packet.y=CARD(bounds.top)
  packet.width=CARD(bounds.right-bounds.left)
  packet.height=CARD(bounds.bottom-bounds.top)
  packet.text=LONGCARD(ADDRESS(title))
  packet.foreground=CARD(focused)
  packet.background=CARD(closer)
  packet.clipLeft=CARD(clip.left)
  packet.clipTop=CARD(clip.top)
  packet.clipRight=CARD(clip.right)
  packet.clipBottom=CARD(clip.bottom)
  packet.fillX=progress^
  packet.fillY=kind
  packet.fillWidth=CARD(sliderTop)
  packet.fillHeight=CARD(sliderHeight)
  packet.frameHorizontalLeft=CARD(sliderLeft)
  packet.frameHorizontalWidth=CARD(sliderWidth)
  IF Submit(output,OP_FRAME)=0 THEN
    RETURN(0)
  FI

  progress^=packet.fillX

RETURN(IF progress^=0 THEN 1 ELSE 2 FI)

PUBLIC BYTE FUNC MenuRow(Packet POINTER output LAYERTYPES.Rect POINTER bounds,clip
    BYTE POINTER title CARD rowTop BYTE enabled,selected CARD POINTER progress)

  LET packet=Select(output)
  packet.x=CARD(bounds.left)
  packet.y=CARD(bounds.top)
  packet.width=CARD(bounds.right-bounds.left)
  packet.height=CARD(bounds.bottom-bounds.top)
  packet.text=LONGCARD(ADDRESS(title))
  packet.foreground=CARD(enabled)
  packet.background=CARD(selected)
  packet.clipLeft=CARD(clip.left)
  packet.clipTop=CARD(clip.top)
  packet.clipRight=CARD(clip.right)
  packet.clipBottom=CARD(clip.bottom)
  packet.fillY=rowTop
  packet.fillX=progress^
  IF Submit(output,OP_MENU_ROW)=0 THEN
    RETURN(0)
  FI

  progress^=packet.fillX

RETURN(IF progress^=0 THEN 1 ELSE 2 FI)

; Scene clients select their own encoding; a prior console turn owns no flag
; in this explicit foreground value.
PUBLIC BYTE FUNC ClippedText(Packet POINTER output CARD x,y BYTE POINTER text CARD count,foreground,background
    LAYERTYPES.Rect POINTER clip)

  LET packet=Select(output)
  packet.x=x
  packet.y=y
  packet.text=LONGCARD(ADDRESS(text))
  packet.width=count
  packet.foreground=foreground
  packet.background=background
  packet.clipLeft=CARD(clip.left)
  packet.clipTop=CARD(clip.top)
  packet.clipRight=CARD(clip.right)
  packet.clipBottom=CARD(clip.bottom)

RETURN(Submit(output,OP_TEXT_CLIP))


PUBLIC BYTE FUNC Fill(CARD left,top,width,height,pen)

RETURN(RawFill(NULL,left,top,width,height,pen))

PUBLIC BYTE FUNC Text(CARD x,y BYTE POINTER text CARD count)
  LAYERTYPES.Rect bounds

  LET packet=GetPacket()
  packet.x=x
  packet.y=y
  packet.text=LONGCARD(ADDRESS(text))
  packet.width=count
  packet.foreground=1 OR encoding
  packet.background=0

RETURN(Run(OP_TEXT))

; The final text span and underline share one admitted drawing operation.
PUBLIC BYTE FUNC TextCaret(CARD x,y BYTE POINTER characters CARD count,caretX,caretY)

  LET packet=GetPacket()
  packet.x=x
  packet.y=y
  packet.text=LONGCARD(ADDRESS(characters))
  packet.width=count
  packet.foreground=1 OR encoding
  packet.background=0
  packet.fillX=caretX
  packet.fillY=caretY
  packet.fillWidth=8
  packet.fillHeight=1
  packet.fillPen=1

RETURN(Run(OP_TEXT_FILL))

; One complete upward copy and exposed-strip fill, retained by the C driver.
PUBLIC BYTE FUNC Scroll(CARD left,top,width,height,rows)
  LAYERTYPES.Rect source,target
  LONGCARD token
  BYTE status

  IF rows=0 OR rows>height THEN
    RETURN(0)
  FI

  LET packet=GetPacket()
  packet.copy.source.offset=0
  packet.copy.source.pitch=320
  packet.copy.source.width=640
  packet.copy.source.height=240
  packet.copy.destination.offset=0
  packet.copy.destination.pitch=320
  packet.copy.destination.width=640
  packet.copy.destination.height=240
  packet.copy.sourceX=left LSH 3
  packet.copy.destinationX=left LSH 3
  packet.copy.sourceY=(top+rows) LSH 3
  packet.copy.destinationY=top LSH 3
  packet.copy.width=width LSH 3
  packet.copy.height=(height-rows) LSH 3
  packet.background=0
  IF Run(OP_SCROLL)=0 OR packet.status<>DISPLAY.OK THEN
    RETURN(0)
  FI

RETURN(1)

; The presenter prepares the shared typed descriptor before this call. Its
; own Layers token remains separate from the console-scroll model transaction.
PUBLIC BYTE FUNC CopyStart(Packet POINTER output)

  IF output<>NULL THEN
    RETURN(Submit(output,OP_COPY_START))
  FI

  IF drawingPending<>0 THEN
    RETURN(0)
  FI

  ; A BUSY owner attempt reserves a FIFO position. Complete that admission
  ; here so no abandoned reservation needs a later manager turn to retire.
  IF Submit(NULL,OP_COPY_START)=0 THEN
    RETURN(0)
  FI

  LET packet=GetPacket()
  IF packet.status<>DISPLAY.OK THEN
    RETURN(0)
  FI

RETURN(1)

; Consume the old draw hint before releasing the scene. A new draw during
; the physical call or Resume stays pending; failed admission needs a retry.
PUBLIC BYTE FUNC Mouse(BYTE POINTER state)

  LET packet=GetPacket()
  packet.text=LONGCARD(ADDRESS(state))
  drawingChanged=0
  LET result=Run(OP_MOUSE)
  IF result=0 THEN
    drawingChanged=1
  FI

RETURN(result)

PUBLIC BYTE FUNC Pending()

RETURN(drawingPending)

PUBLIC PROC PollPhysical()

  IF drawingPending=0 THEN
    RETURN
  FI

  IF Run(OP_POLL)=0 THEN
    drawingPending=0
  ELSE
    BEGIN
      LET packet=GetPacket()
      IF packet.status=DISPLAY.OK THEN
        drawingPending=0
      FI
    END
  FI

RETURN

; Retiring a frozen Layers transaction is scene work, after physical polling.
PUBLIC PROC Poll()

  PollPhysical()
  physicalCompleted=0

RETURN

; Finish a launched owner operation before its logical scope returns. IRQ or
; watchdog publication uses the existing completion bit; no frontend callback
; is required while this Task waits. Other Tasks and input remain preemptible.
PUBLIC PROC Finish()

  WHILE drawingPending<>0 DO
    Poll()
    IF drawingPending<>0 THEN
      EXEC.Wait(completionMask)
    FI
  OD

RETURN

PUBLIC BYTE FUNC Completed()

RETURN(physicalCompleted)

PUBLIC BYTE FUNC Changed()

RETURN(drawingChanged)

PUBLIC BYTE FUNC Outline(CARD x,y,width,height BYTE visible)

  LET packet=GetPacket()
  packet.x=x
  packet.y=y
  packet.width=width
  packet.height=height
  packet.foreground=CARD(visible)
  drawingChanged=1

RETURN(Run(OP_OUTLINE))

; The non-AES overlay follows the same consume-before-call hint protocol.
PUBLIC BYTE FUNC Cursor(CARD x,y BYTE visible)

  LET packet=GetPacket()
  packet.x=x
  packet.y=y
  packet.width=CARD(visible)
  drawingChanged=0
  LET result=Run(OP_POINTER)
  IF result=0 THEN
    drawingChanged=1
  FI

RETURN(result)

ENDMODULE
