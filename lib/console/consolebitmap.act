; Private binding and packet producer for the shared ordinary-call C library.
MODULE CONSOLEBITMAP
USE EXEC
USE DISPLAY
USE CONSOLETYPES
USE HEAPCORE
USE DESKSTATE
USE LAYERTYPES
USE LAYERS
USE REGIONS
INCLUDE "console-storage-action.inc"
INCLUDE "console-bitmap-types.inc"
BYTE drawingPending,drawingChanged
LONGCARD completionMask

PUBLIC EXTERNAL PROC Call(ADDRESS entry)

PUBLIC Binding POINTER FUNC GetBinding()

RETURN(Binding POINTER(ADDRESS(CS_BITMAP)))

PUBLIC BYTE FUNC Enabled()

  LET state=GetBinding()

RETURN(state.enabled)

PUBLIC BYTE FUNC Failed()

  LET state=GetBinding()

RETURN(state.failed)

; Foreign-image validation reserves these exact C code/data banks. Runtime
; checks prevent truncation, an odd packet or rebinding a live service.
PUBLIC BYTE FUNC Bind(LONGCARD entry,packet)

  LET state=GetBinding()
  LET service=CONSOLETYPES.Service POINTER(ADDRESS(CS_BASE))
  IF service.state<>0 OR state.enabled<>0 OR entry<$c0000 OR entry>$cffff
      OR packet<$d0000 OR packet>LONGCARD($e0000)-PACKET_BYTES OR (packet & 1)<>0 THEN
    RETURN(0)
  FI

  state.entry=ADDRESS(entry)
  state.packet=BYTE POINTER(ADDRESS(packet))
  state.failed=0
  state.enabled=1

RETURN(1)

PUBLIC Packet POINTER FUNC GetPacket()

  LET state=GetBinding()

RETURN(Packet POINTER(state.packet))

; All production calls originate in the resident worker. The packet never
; retains source buffers after return. SCROLL/POLL explicitly separate launch
; from completion; all other drawing operations remain synchronous.
PUBLIC BYTE FUNC Run(CARD operation)

  LET state=GetBinding()
  LET service=CONSOLETYPES.Service POINTER(ADDRESS(CS_BASE))
  IF state.enabled=0 OR service.worker<>BYTE POINTER(EXEC.FindTask(NULL)) THEN
    HEAPCORE.Abort(4)
  FI

  IF state.failed<>0 AND operation<>OP_CLOSE THEN
    RETURN(0)
  FI

  LET packet=GetPacket()
  packet.operation=operation
  packet.status=DISPLAY.BAD_ARGUMENT
  Call(state.entry)
  IF operation=OP_FILL OR operation=OP_TEXT OR operation=OP_TEXT_FILL
      OR operation=OP_TEXT_CLIP OR operation=OP_SCROLL THEN
    drawingChanged=1
  FI
  IF packet.status=DISPLAY.BUSY AND
      (operation=OP_SCROLL OR operation=OP_POLL) THEN
    RETURN(1)
  FI

  IF packet.status<>DISPLAY.OK THEN
    state.failed=1
    RETURN(0)
  FI

RETURN(1)

PUBLIC BYTE FUNC Open()
  BYTE ignored

  LET state=GetBinding()
  state.failed=0

  IF Run(OP_OPEN)=0 THEN
    RETURN(0)
  FI

  drawingPending=0
  LET packet=GetPacket()
  completionMask=packet.completionMask
  IF completionMask=0 THEN
    ignored=Run(OP_CLOSE)
    state.failed=1
    RETURN(0)
  FI

RETURN(1)

PUBLIC PROC Close()
  BYTE ignored

  ignored=Run(OP_CLOSE)
  drawingPending=0
  completionMask=0

RETURN

; Cached only for the owning worker's scheduling; no drawing authority.
PUBLIC LONGCARD FUNC Mask()

RETURN(completionMask)

PUBLIC BYTE FUNC RawFill(CARD left,top,width,height,pen)

  LET packet=GetPacket()
  packet.x=left
  packet.y=top
  packet.width=width
  packet.height=height
  packet.background=pen

RETURN(Run(OP_FILL))

PUBLIC BYTE FUNC ClippedText(CARD x,y BYTE POINTER text CARD count,foreground,background
    LAYERTYPES.Rect POINTER clip)

  LET packet=GetPacket()
  packet.x=x
  packet.y=y
  packet.text=LONGCARD(ADDRESS(text))
  packet.width=count
  packet.foreground=foreground
  packet.background=background
  packet.clipLeft=CARD(clip.left)
  packet.clipTop=CARD(clip.top)
  packet.clipRight=CARD(clip.right)
  packet.clipBottom=CARD(clip.bottom)

RETURN(Run(OP_TEXT_CLIP))

INCLUDE "console-desktop-drawing.inc"

PUBLIC BYTE FUNC Fill(CARD left,top,width,height,pen)
  LAYERTYPES.Rect bounds

  IF DESKSTATE.Enabled()=0 THEN
    RETURN(RawFill(left,top,width,height,pen))
  FI

  REGIONS.Assign(@bounds,INT(left),INT(top),INT(left+width),INT(top+height))

RETURN(DesktopDraw(@bounds,0,NULL,0,0,pen))

PUBLIC BYTE FUNC Text(CARD x,y BYTE POINTER text CARD count)
  LAYERTYPES.Rect bounds

  IF DESKSTATE.Enabled()<>0 THEN
    REGIONS.Assign(@bounds,INT(x),INT(y),INT(x+(count LSH 3)),INT(y+8))
    RETURN(DesktopDraw(@bounds,1,text,count,1,0))
  FI

  LET packet=GetPacket()
  packet.x=x
  packet.y=y
  packet.text=LONGCARD(ADDRESS(text))
  packet.width=count
  packet.foreground=1
  packet.background=0

RETURN(Run(OP_TEXT))

; The final text span and underline share one admitted drawing operation.
PUBLIC BYTE FUNC TextCaret(CARD x,y BYTE POINTER characters CARD count,caretX,caretY)

  IF DESKSTATE.Enabled()<>0 THEN
    IF Text(x,y,characters,count)=0 THEN
      RETURN(0)
    FI

    RETURN(Fill(caretX,caretY,8,1,1))
  FI

  LET packet=GetPacket()
  packet.x=x
  packet.y=y
  packet.text=LONGCARD(ADDRESS(characters))
  packet.width=count
  packet.foreground=1
  packet.background=0
  packet.fillX=caretX
  packet.fillY=caretY
  packet.fillWidth=8
  packet.fillHeight=1
  packet.fillPen=1

RETURN(Run(OP_TEXT_FILL))

; One complete upward copy and exposed-strip fill, retained by the C driver.
PUBLIC BYTE FUNC Scroll(CARD left,top,width,height,rows)
  LAYERTYPES.Rect source,target
  LONGCARD token
  BYTE status

  IF rows=0 OR rows>height THEN
    RETURN(0)
  FI

  LET packet=GetPacket()
  packet.copy.source.offset=0
  packet.copy.source.pitch=320
  packet.copy.source.width=640
  packet.copy.source.height=240
  packet.copy.destination.offset=0
  packet.copy.destination.pitch=320
  packet.copy.destination.width=640
  packet.copy.destination.height=240
  packet.copy.sourceX=left LSH 3
  packet.copy.destinationX=left LSH 3
  packet.copy.sourceY=(top+rows) LSH 3
  packet.copy.destinationY=top LSH 3
  packet.copy.width=width LSH 3
  packet.copy.height=(height-rows) LSH 3
  packet.background=0
  LET desktop=DESKSTATE.Get()
  IF desktop<>NULL THEN
    REGIONS.Assign(@source,INT(left LSH 3),INT(top LSH 3),
        INT((left+width) LSH 3),INT((top+height) LSH 3))
    REGIONS.Copy(@source,@target)
    status=LAYERS.BeginCopy(@desktop.scene,DESKSTATE.Selected(),@source,@target,@token)
    IF status<>LAYERTYPES.OK THEN
      RETURN(0)
    FI

    DESKSTATE.SetScrollToken(token)
  FI

  IF Run(OP_SCROLL)=0 OR packet.status<>DISPLAY.OK THEN
    IF desktop<>NULL THEN
      status=LAYERS.Finish(@desktop.scene,token,0)
      DESKSTATE.SetScrollToken(0)
    FI

    RETURN(0)
  FI

  drawingPending=1

RETURN(1)

; Local owner state is sufficient for scheduling; public Poll admits again.
PUBLIC BYTE FUNC Pending()

RETURN(drawingPending)

PUBLIC PROC Poll()
  BYTE status

  IF drawingPending=0 THEN
    RETURN
  FI

  IF Run(OP_POLL)=0 THEN
    drawingPending=0
  ELSE
    BEGIN
      LET packet=GetPacket()
      IF packet.status=DISPLAY.OK THEN
        drawingPending=0
      FI
    END
  FI

  IF drawingPending=0 AND DESKSTATE.PendingToken()<>0 THEN
    BEGIN
      LET desktop=DESKSTATE.Get()
      status=LAYERS.Finish(@desktop.scene,DESKSTATE.PendingToken(),Failed()=0)
      DESKSTATE.SetScrollToken(0)
    END
  FI

RETURN

PUBLIC BYTE FUNC Changed()

RETURN(drawingChanged)

PUBLIC BYTE FUNC Outline(CARD x,y,width,height BYTE visible)

  LET packet=GetPacket()
  packet.x=x
  packet.y=y
  packet.width=width
  packet.height=height
  packet.foreground=CARD(visible)
  drawingChanged=1

RETURN(Run(OP_OUTLINE))

PUBLIC BYTE FUNC Cursor(CARD x,y BYTE visible)
  BYTE result

  LET packet=GetPacket()
  packet.x=x
  packet.y=y
  packet.width=CARD(visible)
  result=Run(OP_POINTER)
  drawingChanged=0

RETURN(result)

ENDMODULE
