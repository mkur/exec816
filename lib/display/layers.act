; Single-owner opaque layers. No hardware, kernel calls or global state.
MODULE LAYERS
USE LAYERTYPES
USE REGIONS
USE LAYERCACHE
USE A816MEMORY

; A transaction retains geometry until its caller has finished drawing.
BYTE FUNC Admit(LAYERTYPES.Scene POINTER scene)

  IF scene=NULL THEN
    RETURN(LAYERTYPES.BAD_ARGUMENT)
  FI

  IF scene.busy<>0 THEN
    RETURN(LAYERTYPES.BUSY)
  FI

RETURN(LAYERTYPES.OK)

BYTE FUNC FindSlot(LAYERTYPES.Scene POINTER scene LONGCARD id)
  BYTE index

  IF id=0 THEN
    RETURN(LAYERTYPES.BACKGROUND_SLOT)
  FI

  FOR index=0 TO LAYERTYPES.MAX_LAYERS-1 DO
    IF scene.items(index).id=id THEN
      RETURN(index)
    FI
  OD

RETURN(255)

PUBLIC LAYERTYPES.Layer POINTER FUNC Find(LAYERTYPES.Scene POINTER scene
    LONGCARD id)

  LET slot=FindSlot(scene,id)
  IF slot=255 THEN
    RETURN(NULL)
  FI

RETURN(@scene.items(slot))

; Read the summary maintained at mutation boundaries; do not rescan geometry
; when the presenter is only choosing which layer to paint.
PUBLIC LAYERTYPES.Layer POINTER FUNC FindDamaged(LAYERTYPES.Scene POINTER scene
    LONGCARD id)

  LET slot=FindSlot(scene,id)
  IF slot=255 THEN
    RETURN(NULL)
  FI
  IF (scene.visibleDamage & (CARD(1) LSH slot))=0 THEN
    RETURN(NULL)
  FI

RETURN(@scene.items(slot))

; Manager damage is runnable only where this layer owns visible screen pixels.
; External pending repaint has its own lifetime and is deliberately separate.
PUBLIC BYTE FUNC Damaged(LAYERTYPES.Layer POINTER layer)
  CARD index
  BYTE damage

  IF layer.dirty=0 THEN
    RETURN(0)
  FI

  FOR damage=0 TO layer.damage.count-1 DO
    index=0
    WHILE index<layer.visible.count DO
      BEGIN
        LET rect=@layer.visible.rects(index)
        LET changed=@layer.damage.rects(damage)
        IF rect.left<changed.right AND rect.right>changed.left
            AND rect.top<changed.bottom AND rect.bottom>changed.top THEN
          RETURN(1)
        FI
      END
      index==+1
    OD
  OD

RETURN(0)

PROC UpdateDamage(LAYERTYPES.Scene POINTER scene BYTE slot)

  LET bit=CARD(1) LSH slot
  IF Damaged(@scene.items(slot))<>0 THEN
    scene.visibleDamage=scene.visibleDamage OR bit
  ELSE
    scene.visibleDamage=scene.visibleDamage & ($ffff XOR bit)
  FI

RETURN

; Expand a bound without arithmetic that could overflow signed coordinates.
PROC Bound(LAYERTYPES.Rect POINTER target,rect)

  IF rect.left<target.left THEN
    target.left=rect.left
  FI

  IF rect.top<target.top THEN
    target.top=rect.top
  FI

  IF rect.right>target.right THEN
    target.right=rect.right
  FI

  IF rect.bottom>target.bottom THEN
    target.bottom=rect.bottom
  FI

RETURN

; Merge only when the union is a rectangle. Partial overlaps can be painted
; twice; they must never force unrelated pixels into the common sparse case.
BYTE FUNC Mergeable(LAYERTYPES.Rect POINTER a,b)

  IF REGIONS.Contains(a,b)<>0 OR REGIONS.Contains(b,a)<>0 THEN
    RETURN(1)
  FI

  IF a.top=b.top AND a.bottom=b.bottom THEN
    RETURN(a.left<=b.right AND b.left<=a.right)
  FI

  IF a.left=b.left AND a.right=b.right THEN
    RETURN(a.top<=b.bottom AND b.top<=a.bottom)
  FI

RETURN(0)

; Overflow conservatively collapses every entry, including the new rectangle.
PROC AddDamage(LAYERTYPES.Damage POINTER damage LAYERTYPES.Rect POINTER area)
  LAYERTYPES.Rect clipped
  BYTE index

  REGIONS.Copy(area,@clipped)
  IF REGIONS.Empty(@clipped)<>0 THEN
    RETURN
  FI

  index=0
  WHILE index<damage.count DO
    IF Mergeable(@clipped,@damage.rects(index))<>0 THEN
      Bound(@clipped,@damage.rects(index))
      damage.count==-1
      REGIONS.Copy(@damage.rects(damage.count),@damage.rects(index))
      index=0
    ELSE
      index==+1
    FI
  OD

  IF damage.count=LAYERTYPES.MAX_DAMAGE THEN
    FOR index=0 TO LAYERTYPES.MAX_DAMAGE-1 DO
      Bound(@clipped,@damage.rects(index))
    OD
    damage.count=0
  FI

  REGIONS.Copy(@clipped,@damage.rects(damage.count))
  damage.count==+1

RETURN

PROC Mark(LAYERTYPES.Scene POINTER scene BYTE slot
    LAYERTYPES.Rect POINTER rect)
  LAYERTYPES.Rect clipped

  LET layer=@scene.items(slot)
  REGIONS.Intersect(@layer.bounds,rect,@clipped)
  IF REGIONS.Empty(@clipped)<>0 THEN
    RETURN
  FI
  IF layer.dirty=0 THEN
    layer.damage.count=0
  FI
  AddDamage(@layer.damage,@clipped)
  layer.dirty=1
  ; Adding damage cannot clear an already runnable layer.
  IF (scene.visibleDamage & (CARD(1) LSH slot))=0 THEN
    UpdateDamage(scene,slot)
  FI

RETURN

PROC DamageAll(LAYERTYPES.Scene POINTER scene LAYERTYPES.Rect POINTER rect)
  BYTE index

  FOR index=0 TO LAYERTYPES.SLOT_COUNT-1 DO
    IF scene.items(index).id<>0 OR index=LAYERTYPES.BACKGROUND_SLOT THEN
      Mark(scene,index,rect)
    FI
  OD

RETURN

; Rebuild only for actual layout changes, never for drawing or hit testing.
; Subtract nearer occluders first: a covering window can eliminate a layer
; before frontmost overlays fragment it. Rectangle order is not a contract.
BYTE FUNC Rebuild(LAYERTYPES.Scene POINTER scene)
  LAYERTYPES.Layer POINTER layer,above
  BYTE index,rank,status,clear

  scene.visibleDamage=0
  FOR index=0 TO LAYERTYPES.SLOT_COUNT-1 DO
    layer=@scene.items(index)
    layer.visible.count=0
    IF layer.shown<>0 THEN
      status=REGIONS.FromRect(@layer.visible,@layer.bounds)
      rank=0
      WHILE rank<scene.count DO
        IF scene.order(rank)=index THEN
          EXIT
        FI
        rank==+1
      OD

      WHILE rank>0 AND layer.visible.count<>0 DO
        rank==-1
        above=@scene.items(scene.order(rank))
        IF above.shown<>0 AND above.bounds.left<layer.bounds.right
            AND above.bounds.right>layer.bounds.left
            AND above.bounds.top<layer.bounds.bottom
            AND above.bounds.bottom>layer.bounds.top THEN
          status=REGIONS.Subtract(@layer.visible,@above.bounds,@scene.work)
          IF status<>LAYERTYPES.OK THEN
            ; Impossible for a valid scene. Fail closed if storage was damaged;
            ; an incomplete visibility list must not authorize drawing.
            FOR clear=0 TO LAYERTYPES.SLOT_COUNT-1 DO
              scene.items(clear).visible.count=0
            OD

            scene.visibleDamage=0
            RETURN(status)
          FI

          A816MEMORY.Move(BYTE POINTER(@layer.visible),
              BYTE POINTER(@scene.work),SIZE(LAYERTYPES.REGION_RECTS
                  +scene.work.count*LAYERTYPES.RECT_SIZE))
        FI

      OD
    FI
    UpdateDamage(scene,index)
  OD

  scene.rebuilds==+1

RETURN(LAYERTYPES.OK)

; Initialize unpublished caller-owned storage once per scene lifetime.
PUBLIC BYTE FUNC Init(LAYERTYPES.Scene POINTER scene INT width,height)

  IF scene=NULL OR width<=0 OR height<=0 THEN
    RETURN(LAYERTYPES.BAD_ARGUMENT)
  FI

  A816MEMORY.Clear(BYTE POINTER(scene),LAYERTYPES.SCENE_SIZE)
  REGIONS.Assign(@scene.screen,0,0,width,height)
  scene.nextId=1
  scene.nextToken=1
  LET background=@scene.items(LAYERTYPES.BACKGROUND_SLOT)
  REGIONS.Copy(@scene.screen,@background.bounds)
  background.shown=1
  background.contentRevision=1
  background.paintEpoch=1
  Mark(scene,LAYERTYPES.BACKGROUND_SLOT,@scene.screen)

RETURN(Rebuild(scene))

; Create a hidden layer at the front of the order without altering visibility.
PUBLIC BYTE FUNC Create(LAYERTYPES.Scene POINTER scene
    LAYERTYPES.Rect POINTER bounds LONGCARD POINTER id)
  BYTE slot,rank,status
  LAYERTYPES.Layer POINTER layer

  status=Admit(scene)
  IF status<>LAYERTYPES.OK THEN
    RETURN(status)
  FI

  IF id=NULL OR REGIONS.Valid(bounds)=0 THEN
    RETURN(LAYERTYPES.BAD_ARGUMENT)
  FI

  IF REGIONS.Empty(bounds)<>0 OR REGIONS.Contains(@scene.screen,bounds)=0 THEN
    RETURN(LAYERTYPES.BAD_ARGUMENT)
  FI

  IF scene.count=LAYERTYPES.MAX_LAYERS THEN
    RETURN(LAYERTYPES.FULL)
  FI

  IF scene.nextId=0 THEN
    RETURN(LAYERTYPES.EXHAUSTED)
  FI

  slot=0
  WHILE scene.items(slot).id<>0 DO
    slot==+1
  OD

  layer=@scene.items(slot)
  A816MEMORY.Clear(BYTE POINTER(layer),LAYERTYPES.LAYER_SIZE)
  layer.paintEpoch=1
  layer.contentRevision=1
  layer.id=scene.nextId
  scene.nextId==+1
  REGIONS.Copy(bounds,@layer.bounds)
  Mark(scene,slot,bounds)
  rank=scene.count
  WHILE rank>0 DO
    scene.order(rank)=scene.order(rank-1)
    rank==-1
  OD

  scene.order(0)=slot
  scene.count==+1
  id^=layer.id

RETURN(LAYERTYPES.OK)

INCLUDE "layers-repaint.inc"

; Select the content contract while hidden, before publishing a window.
PUBLIC BYTE FUNC SetExternal(LAYERTYPES.Scene POINTER scene LONGCARD id)
  BYTE status

  status=Admit(scene)
  IF status<>LAYERTYPES.OK THEN
    RETURN(status)
  FI

  LET layer=Find(scene,id)
  IF id=0 OR layer=NULL THEN
    RETURN(LAYERTYPES.BAD_ID)
  FI

  IF layer.shown<>0 THEN
    RETURN(LAYERTYPES.BUSY)
  FI

  layer.externalPaint=1
  RequirePaint(scene,id,@layer.bounds)

RETURN(LAYERTYPES.OK)

; Transfer a hidden external window to a retained content provider. Admission
; precedes publication; no external pixel obligation survives the transfer.
PUBLIC BYTE FUNC SetRetained(LAYERTYPES.Scene POINTER scene LONGCARD id)
  BYTE status

  status=Admit(scene)
  IF status<>LAYERTYPES.OK THEN
    RETURN(status)
  FI

  LET layer=Find(scene,id)
  IF id=0 OR layer=NULL THEN
    RETURN(LAYERTYPES.BAD_ID)
  FI
  IF layer.shown<>0 THEN
    RETURN(LAYERTYPES.BUSY)
  FI

  layer.externalPaint=0
  layer.pending.count=0

RETURN(LAYERTYPES.OK)

PUBLIC BYTE FUNC Show(LAYERTYPES.Scene POINTER scene LONGCARD id BYTE shown)
  BYTE status
  LAYERTYPES.Layer POINTER layer

  status=Admit(scene)
  IF status<>LAYERTYPES.OK THEN
    RETURN(status)
  FI

  layer=Find(scene,id)
  IF layer=NULL OR id=0 THEN
    RETURN(LAYERTYPES.BAD_ID)
  FI

  IF shown>1 THEN
    RETURN(LAYERTYPES.BAD_ARGUMENT)
  FI

  IF shown=layer.shown THEN
    RETURN(LAYERTYPES.OK)
  FI

  layer.shown=shown
  LAYERCACHE.Changed(@scene.under,id,@layer.bounds)
  DamageAll(scene,@layer.bounds)

RETURN(Rebuild(scene))

; Change one admitted layer rectangle and repair both old and new exposure.
PUBLIC BYTE FUNC Bounds(LAYERTYPES.Scene POINTER scene LONGCARD id
    INT left,top,width,height)
  BYTE status,slot
  LAYERTYPES.Layer POINTER layer

  status=Admit(scene)
  IF status<>LAYERTYPES.OK THEN
    RETURN(status)
  FI

  slot=FindSlot(scene,id)
  IF slot=255 OR id=0 THEN
    RETURN(LAYERTYPES.BAD_ID)
  FI

  layer=@scene.items(slot)
  IF width<=0 OR height<=0 OR left<0 OR top<0
      OR left>scene.screen.right-width
      OR top>scene.screen.bottom-height THEN
    RETURN(LAYERTYPES.BAD_ARGUMENT)
  FI

  IF left=layer.bounds.left AND top=layer.bounds.top
      AND width=layer.bounds.right-layer.bounds.left
      AND height=layer.bounds.bottom-layer.bounds.top THEN
    RETURN(LAYERTYPES.OK)
  FI

  IF layer.shown<>0 THEN
    LAYERCACHE.Changed(@scene.under,id,@layer.bounds)
    DamageAll(scene,@layer.bounds)
  FI

  REGIONS.Assign(@layer.bounds,left,top,left+width,top+height)
  LAYERCACHE.Changed(@scene.under,id,@layer.bounds)
  layer.dirty=0
  Mark(scene,slot,@layer.bounds)
  IF layer.shown=0 THEN
    RETURN(LAYERTYPES.OK)
  FI

  DamageAll(scene,@layer.bounds)

RETURN(Rebuild(scene))

; Preserve dimensions for existing callers. Bounds owns the mutation.
PUBLIC BYTE FUNC Move(LAYERTYPES.Scene POINTER scene LONGCARD id INT left,top)

  LET layer=Find(scene,id)
  IF layer=NULL THEN
    RETURN(LAYERTYPES.BAD_ID)
  FI

RETURN(Bounds(scene,id,left,top,layer.bounds.right-layer.bounds.left,
    layer.bounds.bottom-layer.bounds.top))

; Reorder an admitted layer by final rank. Hidden placement changes no pixels.
BYTE FUNC Reorder(LAYERTYPES.Scene POINTER scene
    LAYERTYPES.Layer POINTER layer BYTE target)
  BYTE rank,slot

  rank=0
  WHILE scene.items(scene.order(rank)).id<>layer.id DO
    rank==+1
  OD
  IF rank=target THEN
    RETURN(LAYERTYPES.OK)
  FI

  slot=scene.order(rank)
  WHILE rank>target DO
    scene.order(rank)=scene.order(rank-1)
    rank==-1
  OD
  WHILE rank<target DO
    scene.order(rank)=scene.order(rank+1)
    rank==+1
  OD
  scene.order(rank)=slot
  IF layer.shown=0 THEN
    RETURN(LAYERTYPES.OK)
  FI

  LAYERCACHE.Changed(@scene.under,layer.id,@layer.bounds)
  DamageAll(scene,@layer.bounds)

RETURN(Rebuild(scene))

; Move one layer to the front (1) or back (0), including hidden entries.
PUBLIC BYTE FUNC Order(LAYERTYPES.Scene POINTER scene LONGCARD id BYTE front)

  LET status=Admit(scene)
  IF status<>LAYERTYPES.OK THEN
    RETURN(status)
  FI

  LET layer=Find(scene,id)
  IF layer=NULL OR id=0 THEN
    RETURN(LAYERTYPES.BAD_ID)
  FI
  IF front>1 THEN
    RETURN(LAYERTYPES.BAD_ARGUMENT)
  FI

RETURN(Reorder(scene,layer,IF front<>0 THEN 0 ELSE scene.count-1 FI))

; Place immediately below another live nonbackground layer. Prepare hidden
; windows in their final position before Show publishes one visibility change.
PUBLIC BYTE FUNC OrderBelow(LAYERTYPES.Scene POINTER scene LONGCARD id,anchor)
  BYTE target,before

  LET status=Admit(scene)
  IF status<>LAYERTYPES.OK THEN
    RETURN(status)
  FI
  LET layer=Find(scene,id)
  IF layer=NULL OR id=0 OR anchor=0 OR Find(scene,anchor)=NULL THEN
    RETURN(LAYERTYPES.BAD_ID)
  FI
  IF id=anchor THEN
    RETURN(LAYERTYPES.OK)
  FI

  target=0
  before=0
  WHILE scene.items(scene.order(target)).id<>anchor DO
    IF scene.items(scene.order(target)).id=id THEN
      before=1
    FI
    target==+1
  OD
  ; Removing an entry above the anchor shifts the anchor up by one rank.
  IF before=0 THEN
    target==+1
  FI

RETURN(Reorder(scene,layer,target))

PUBLIC BYTE FUNC Delete(LAYERTYPES.Scene POINTER scene LONGCARD id)
  BYTE status,rank,shown,slot
  LAYERTYPES.Layer POINTER layer

  status=Admit(scene)
  IF status<>LAYERTYPES.OK THEN
    RETURN(status)
  FI

  layer=Find(scene,id)
  IF layer=NULL OR id=0 THEN
    RETURN(LAYERTYPES.BAD_ID)
  FI

  rank=0
  WHILE scene.items(scene.order(rank)).id<>id DO
    rank==+1
  OD

  slot=scene.order(rank)
  WHILE rank<scene.count-1 DO
    scene.order(rank)=scene.order(rank+1)
    rank==+1
  OD

  scene.count==-1
  shown=layer.shown
  LAYERCACHE.Changed(@scene.under,id,@layer.bounds)
  IF shown<>0 THEN
    DamageAll(scene,@layer.bounds)
  FI

  layer.id=0
  layer.shown=0
  layer.dirty=0
  layer.visible.count=0
  scene.visibleDamage=scene.visibleDamage & ($ffff XOR (CARD(1) LSH slot))
  IF shown=0 THEN
    RETURN(LAYERTYPES.OK)
  FI

RETURN(Rebuild(scene))

; Background and offscreen points return zero. Hit testing does no rebuilding.
PUBLIC LONGCARD FUNC Hit(LAYERTYPES.Scene POINTER scene INT x,y)
  BYTE rank
  LAYERTYPES.Layer POINTER layer

  rank=0
  WHILE rank<scene.count DO
    layer=@scene.items(scene.order(rank))
    IF layer.shown<>0 AND x>=layer.bounds.left AND x<layer.bounds.right
        AND y>=layer.bounds.top AND y<layer.bounds.bottom THEN
      RETURN(layer.id)
    FI

    rank==+1
  OD

RETURN(0)

INCLUDE "layers-update.inc"
INCLUDE "layers-save.inc"

ENDMODULE
