; Fixed caller-owned slots. Pixel transfers and scheduling belong to the owner.
MODULE LAYERCACHE
USE LAYERTYPES
USE REGIONS

PUBLIC CONST NO_SLOT=255
PUBLIC LONGCARD discards

PUBLIC PROC Discard(LAYERTYPES.CacheSlot POINTER slot)

  IF slot.revision<>0 THEN
    discards==+1
  FI
  slot.valid=0
  slot.revision=0

RETURN

PUBLIC PROC Invalidate(LAYERTYPES.CachePair POINTER cache LONGCARD identity)
  BYTE index

  FOR index=0 TO 1 DO
    IF cache.slots(index).identity=identity THEN
      Discard(@cache.slots(index))
    FI
  OD

RETURN

PUBLIC BYTE FUNC Lookup(LAYERTYPES.CachePair POINTER cache LONGCARD identity,
    revision CARD width,height)
  BYTE index

  IF revision=0 THEN
    RETURN(NO_SLOT)
  FI
  FOR index=0 TO 1 DO
    BEGIN
      LET slot=@cache.slots(index)
      IF slot.valid<>0 AND slot.pinned=0 AND slot.identity=identity
          AND slot.revision=revision AND slot.width=width AND slot.height=height THEN
        RETURN(index)
      FI
    END
  OD

RETURN(NO_SLOT)

PUBLIC BYTE FUNC Choose(LAYERTYPES.CachePair POINTER cache)
  BYTE index

  FOR index=0 TO 1 DO
    IF cache.slots(index).pinned=0 AND cache.slots(index).valid=0 THEN
      RETURN(index)
    FI
  OD
  index=cache.recent XOR 1
  IF cache.slots(index).pinned=0 THEN
    RETURN(index)
  FI
  index=cache.recent
  IF cache.slots(index).pinned=0 THEN
    RETURN(index)
  FI

RETURN(NO_SLOT)

PUBLIC PROC Prepare(LAYERTYPES.CacheSlot POINTER slot LONGCARD identity,
    revision CARD width,height)

  slot.valid=0
  slot.pinned=1
  slot.identity=identity
  slot.revision=revision
  slot.width=width
  slot.height=height

RETURN

; Invalidation cannot release storage before DMA is quiescent.
PUBLIC PROC Captured(LAYERTYPES.CacheSlot POINTER slot BYTE okay)

  slot.valid=(okay<>0 AND slot.revision<>0)
  slot.pinned=0

RETURN

PUBLIC PROC Released(LAYERTYPES.CacheSlot POINTER slot BYTE okay)

  IF okay=0 THEN
    Discard(slot)
  FI
  slot.pinned=0

RETURN

; UPDATE temporarily withholds an existing base. A queued local repair can
; absorb another fully reported change, but an ambiguous boundary drops it.
PUBLIC PROC BeginChange(LAYERTYPES.CacheSlot POINTER slot
    LAYERTYPES.CacheRepair POINTER repair LONGCARD oldRevision,newRevision)

  IF slot.pinned=0 AND slot.revision=oldRevision AND newRevision<>0
      AND (slot.valid<>0 OR repair.state=LAYERTYPES.CACHE_CHANGE_READY) THEN
    IF slot.valid<>0 THEN
      REGIONS.Assign(@repair.bounds,0,0,0,0)
    FI
    slot.valid=0
    slot.revision=newRevision
    repair.state=LAYERTYPES.CACHE_CHANGE_HELD
  ELSE
    Discard(slot)
    repair.state=0
  FI

RETURN

PUBLIC PROC EndChange(LAYERTYPES.CacheSlot POINTER slot
    LAYERTYPES.CacheRepair POINTER repair LAYERTYPES.Rect POINTER changed
    BYTE complete)

  IF repair.state<>LAYERTYPES.CACHE_CHANGE_HELD THEN
    RETURN
  FI
  IF complete=0 OR slot.revision=0 THEN
    Discard(slot)
    repair.state=0
    RETURN
  FI
  IF REGIONS.Empty(changed)<>0 THEN
    IF REGIONS.Empty(@repair.bounds)<>0 THEN
      slot.valid=1
      repair.state=0
    ELSE
      repair.state=LAYERTYPES.CACHE_CHANGE_READY
    FI
    RETURN
  FI
  IF REGIONS.Empty(@repair.bounds)<>0 THEN
    REGIONS.Copy(changed,@repair.bounds)
  ELSE
    IF changed.left<repair.bounds.left THEN
      repair.bounds.left=changed.left
    FI
    IF changed.top<repair.bounds.top THEN
      repair.bounds.top=changed.top
    FI
    IF changed.right>repair.bounds.right THEN
      repair.bounds.right=changed.right
    FI
    IF changed.bottom>repair.bounds.bottom THEN
      repair.bounds.bottom=changed.bottom
    FI
  FI
  repair.state=LAYERTYPES.CACHE_CHANGE_READY

RETURN

; The overlay's own geometry/paint is excluded from its saved background.
PUBLIC PROC Changed(LAYERTYPES.SavedArea POINTER save LONGCARD identity
    LAYERTYPES.Rect POINTER area)

  IF save.slot.revision<>0 AND identity<>save.slot.identity
      AND area.left<save.bounds.right AND area.right>save.bounds.left
      AND area.top<save.bounds.bottom AND area.bottom>save.bounds.top THEN
    Discard(@save.slot)
  FI

RETURN

ENDMODULE
