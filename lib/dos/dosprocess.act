MODULE DOSPROCESS
USE EXEC
USE DOSCORE
USE DOSCLIENT
USE DOSOBJECTS
USE DOSINHERIT
USE DOSCALLS
USE DOSBREAK
USE DOSGROUP
USE DOSBREAKTYPES
USE FSOPERATION
USE CONSOLEFOREGROUND
USE PROCESSSTATE
USE PROCESSLAUNCH
USE HEAPCORE
INCLUDE "dos-types.inc"

CONST PREPARED=1,TRANSFERRED=2,RESTORED=3

; Release a prepared child DOS context that will not be adopted.
PUBLIC BYTE FUNC Discard(PROCESSSTATE.Entry POINTER process)

  IF process.console=process.input OR process.console=process.output THEN
    process.console=BYTE POINTER(0)
  FI

  IF DOSINHERIT.Discard(process.console)=0 THEN
    RETURN(0)
  FI

  process.console=BYTE POINTER(0)
  IF DOSINHERIT.Discard(process.directory)=0 THEN
    RETURN(0)
  FI

  process.directory=BYTE POINTER(0)
  IF process.output=process.input THEN
    process.output=BYTE POINTER(0)
  FI

  IF DOSINHERIT.Discard(process.output)=0 THEN
    RETURN(0)
  FI

  process.output=BYTE POINTER(0)
  IF DOSINHERIT.Discard(process.input)=0 THEN
    RETURN(0)
  FI

  process.input=BYTE POINTER(0)

RETURN(1)

; Retain the parent's selections before preparing the child's context.
BYTE FUNC Snapshot(PROCESSSTATE.Entry POINTER process DOSCORE.DosSlot
    POINTER owner BYTE POINTER input,output,directory,console)

  process.input=DOSINHERIT.Clone(owner,input,DOSOBJECTS.KIND_FILE)
  IF input<>NULL AND process.input=NULL THEN
    RETURN(0)
  FI

  IF output=input THEN
    process.output=process.input
  ELSE
    process.output=DOSINHERIT.Clone(owner,output,DOSOBJECTS.KIND_FILE)
  FI

  IF output<>NULL AND process.output=NULL THEN
    RETURN(0)
  FI

  process.directory=DOSINHERIT.Clone(owner,directory,DOSOBJECTS.KIND_LOCK)
  IF directory<>NULL AND process.directory=NULL THEN
    RETURN(0)
  FI

  IF console<>NULL THEN
    IF console=input THEN
      process.console=process.input
    ELSEIF console=output THEN
      process.console=process.output
    ELSE
      process.console=DOSINHERIT.Clone(owner,console,DOSOBJECTS.KIND_FILE)
    FI

    IF process.console=BYTE POINTER(0) THEN
      RETURN(0)
    FI
  FI

RETURN(1)

; Prepare inherited DOS ownership before the child Task is launched.
PUBLIC BYTE FUNC Prepare(PROCESSSTATE.Entry POINTER process BYTE foreground)
  DOSCORE.DosSlot POINTER owner
  DOSCLIENT.ClientContext POINTER client
  DOSBREAKTYPES.Scope POINTER scope
  BYTE okay
  BYTE POINTER console
  LONGINT error

  owner=DOSCORE.Current()
  client=DOSCLIENT.ClientContext POINTER(owner.context)
  scope=DOSBREAKTYPES.Scope POINTER(0)
  IF client=DOSCLIENT.ClientContext POINTER(0) THEN
    IF foreground=0 THEN
      RETURN(1)
    FI

    DOSCLIENT.SetError(ERROR_OBJECT_WRONG_TYPE)
    RETURN(0)
  FI

  IF owner.active<>0 OR client.busy<>0 OR client.suspended<>0 THEN
    DOSCLIENT.SetError(ERROR_OBJECT_IN_USE)
    RETURN(0)
  FI

  IF foreground<>0 THEN
    scope=DOSBREAKTYPES.Scope POINTER(client.foreground)
    IF scope=DOSBREAKTYPES.Scope POINTER(0) THEN
      DOSCLIENT.SetError(ERROR_OBJECT_WRONG_TYPE)
      RETURN(0)
    FI

    IF scope.active=0 OR scope.groupActive<>0 OR (scope.opState<>0
        AND scope.opState<>FSOPERATION.COLLECTED) THEN
      DOSCLIENT.SetError(ERROR_OBJECT_IN_USE)
      RETURN(0)
    FI
  FI

  client.busy=1
  console=NULL
  IF scope<>NULL THEN
    console=scope.handle
  FI

  okay=Snapshot(process,owner,client.input,client.output,client.directory,console)
  error=DOSCLIENT.IoErr()
  IF okay=0 THEN
    IF Discard(process)=0 THEN
      HEAPCORE.Abort($ff94)
    FI

    client.busy=0
    DOSCLIENT.SetError(error)
    RETURN(0)
  FI

  IF foreground<>0 THEN
    process.parentClient=BYTE POINTER(client)
    process.parentScope=BYTE POINTER(scope)
    process.foreground=PREPARED
    client.suspended=1
  FI

  client.busy=0

RETURN(1)

; Clone explicitly selected resources without changing or suspending the parent.
PUBLIC BYTE FUNC PrepareWith(PROCESSSTATE.Entry POINTER process
    PROCESSLAUNCH.StartSpec POINTER specification)
  BYTE POINTER directory
  BYTE okay
  LONGINT error

  LET client=DOSCLIENT.Ensure()
  IF client=NULL THEN
    RETURN(0)
  FI

  LET owner=DOSCORE.Current()
  IF owner.active<>0 OR client.busy<>0 OR client.suspended<>0 THEN
    DOSCLIENT.SetError(ERROR_OBJECT_IN_USE)
    RETURN(0)
  FI

  directory=specification.directory
  IF directory=NULL THEN
    directory=client.directory
  FI

  client.busy=1
  okay=Snapshot(process,owner,specification.input,specification.output,
      directory,specification.console)
  error=DOSCLIENT.IoErr()
  client.busy=0
  DOSCLIENT.SetError(error)

RETURN(okay)

; Prepare a child context attached to the parent's foreground command group.
PUBLIC BYTE FUNC PrepareGroup(PROCESSSTATE.Entry POINTER process BYTE
    POINTER identity)
  DOSCORE.DosSlot POINTER owner
  DOSCLIENT.ClientContext POINTER client
  DOSBREAKTYPES.Scope POINTER scope
  BYTE okay
  LONGINT error

  scope=DOSBREAKTYPES.Scope POINTER(identity)
  IF DOSGROUP.Valid(scope)=0 THEN
    DOSCLIENT.SetError(ERROR_OBJECT_IN_USE)
    RETURN(0)
  FI

  IF scope.groupRefs>=2 THEN
    DOSCLIENT.SetError(ERROR_OBJECT_IN_USE)
    RETURN(0)
  FI

  client=DOSCLIENT.Ensure()
  IF client=DOSCLIENT.ClientContext POINTER(0) THEN
    RETURN(0)
  FI

  owner=DOSCORE.Current()
  client.busy=1
  okay=Snapshot(process,owner,client.input,client.output,client.directory,scope.handle)
  error=DOSCLIENT.IoErr()
  IF okay=0 THEN
    IF Discard(process)=0 THEN
      HEAPCORE.Abort($ff94)
    FI
  ELSE
    EXEC.Forbid()
    scope.groupRefs==+1
    process.groupScope=identity
    EXEC.Permit()
  FI

  client.busy=0
  DOSCLIENT.SetError(error)

RETURN(okay)

; Hand console interruption routing to the admitted child context.
BYTE FUNC EnterForeground(PROCESSSTATE.Entry POINTER process
    DOSCLIENT.ClientContext POINTER client BYTE POINTER console)
  DOSBREAKTYPES.Scope POINTER previous,scope
  BYTE okay
  LONGCARD ignored

  previous=DOSBREAKTYPES.Scope POINTER(process.parentScope)
  scope=DOSBREAK.Allocate(client,console)
  IF scope=DOSBREAKTYPES.Scope POINTER(0) THEN
    RETURN(0)
  FI

  scope.unit=previous.unit
  ignored=EXEC.SetSignal(0,scope.mask)
  EXEC.Forbid()
  okay=CONSOLEFOREGROUND.Handoff(previous,scope,1)
  IF okay<>0 THEN
    client.foreground=BYTE POINTER(scope)
    client.foregroundLoan=1
    process.foreground=TRANSFERRED
  FI

  EXEC.Permit()
  IF okay=0 THEN
    DOSBREAK.Free(scope)
    DOSCLIENT.SetError(ERROR_OBJECT_IN_USE)
    RETURN(0)
  FI

RETURN(1)

; Publish after adoption, delivering any stop requested before the child ran.
PROC PublishBreak(PROCESSSTATE.Entry POINTER process
    DOSCLIENT.ClientContext POINTER client)

  LET scope=DOSBREAKTYPES.Scope POINTER(client.foreground)
  EXEC.Forbid()
  process.breakScope=BYTE POINTER(scope)
  IF (process.breakFlags & PROCESSSTATE.BREAK_PENDING)<>0 THEN
    scope.pending=1
    EXEC.Signal(EXEC.Task POINTER(scope.owner),scope.mask)
  FI

  EXEC.Permit()

RETURN

; Establish a private cancellation scope, optionally routing its owned console.
BYTE FUNC EnterBackground(DOSCLIENT.ClientContext POINTER client BYTE
    POINTER console)
  DOSBREAKTYPES.Scope POINTER scope

  IF console<>NULL THEN
    IF DOSBREAK.Begin(console)=0 THEN
      RETURN(0)
    FI
  ELSE
    scope=DOSBREAK.Allocate(client,NULL)
    IF scope=NULL THEN
      RETURN(0)
    FI

    scope.active=1
    client.foreground=BYTE POINTER(scope)
  FI

  client.foregroundLoan=DOSCLIENT.FOREGROUND_PROCESS

RETURN(1)

; Attach prepared DOS ownership when the child begins execution.
PUBLIC BYTE FUNC Adopt(PROCESSSTATE.Entry POINTER process
    DOSCLIENT.ClientContext POINTER client)
  DOSCORE.DosSlot POINTER owner
  BYTE POINTER console
  BYTE okay

  owner=DOSCORE.Current()
  console=process.console
  EXEC.Forbid()
  DOSINHERIT.Adopt(owner,process.input)
  IF process.output<>process.input THEN
    DOSINHERIT.Adopt(owner,process.output)
  FI

  IF console<>process.input AND console<>process.output THEN
    DOSINHERIT.Adopt(owner,console)
  FI

  DOSINHERIT.Adopt(owner,process.directory)
  client.input=process.input
  client.output=process.output
  client.directory=process.directory
  process.input=BYTE POINTER(0)
  process.output=BYTE POINTER(0)
  process.directory=BYTE POINTER(0)
  process.console=BYTE POINTER(0)
  EXEC.Permit()
  okay=1
  IF process.groupScope<>NULL THEN
    okay=DOSGROUP.Join(DOSBREAKTYPES.Scope POINTER(process.groupScope),client,console)
  ELSEIF process.foreground=PREPARED THEN
    okay=EnterForeground(process,client,console)
  ELSEIF (process.breakFlags & PROCESSSTATE.BREAK_BACKGROUND)<>0 THEN
    okay=EnterBackground(client,console)
  FI

  IF okay<>0 AND client.foreground<>NULL THEN
    PublishBreak(process,client)
  FI

RETURN(okay)

; Return console routing to the retained parent after child completion.
BYTE FUNC RestoreForeground(PROCESSSTATE.Entry POINTER process
    DOSCLIENT.ClientContext POINTER client)
  DOSBREAKTYPES.Scope POINTER scope,parent
  BYTE okay

  scope=DOSBREAKTYPES.Scope POINTER(client.foreground)
  parent=DOSBREAKTYPES.Scope POINTER(process.parentScope)
  IF scope=DOSBREAKTYPES.Scope POINTER(0) OR client.foregroundLoan=0 THEN
    RETURN(0)
  FI

  IF scope.opState<>0 AND scope.opState<>FSOPERATION.COLLECTED THEN
    RETURN(0)
  FI

  EXEC.Forbid()
  okay=CONSOLEFOREGROUND.Handoff(scope,parent,0)
  IF okay<>0 THEN
    client.foreground=BYTE POINTER(0)
    client.foregroundLoan=0
    process.foreground=RESTORED
  FI

  EXEC.Permit()
  IF okay=0 THEN
    RETURN(0)
  FI

  DOSBREAK.Free(scope)

RETURN(1)

; Retire child DOS resources before process storage becomes collectible.
PUBLIC BYTE FUNC Cleanup(PROCESSSTATE.Entry POINTER process)
  LONGINT firstError
  DOSCORE.DosSlot POINTER owner
  DOSCLIENT.ClientContext POINTER client
  DOSOBJECTS.Header POINTER item
  BYTE POINTER identity

  owner=DOSCORE.Current()
  client=DOSCLIENT.ClientContext POINTER(owner.context)
  IF client=DOSCLIENT.ClientContext POINTER(0) THEN
    RETURN(Discard(process))
  FI

  ; Public DOS operations return only after their exact I/O/packet reply is
  ; collected, including cooperative cancellation. A retained busy operation
  ; is a teardown failure, never permission to free its buffers or scope.
  IF owner.active<>0 OR client.busy<>0 OR client.suspended<>0 THEN
    RETURN(0)
  FI

  EXEC.Forbid()
  process.breakScope=NULL
  EXEC.Permit()
  IF process.groupScope<>BYTE POINTER(0) THEN
    IF DOSGROUP.Leave(DOSBREAKTYPES.Scope POINTER(process.groupScope),client)=0 THEN
      RETURN(0)
    FI
  ELSEIF process.foreground=TRANSFERRED THEN
    IF RestoreForeground(process,client)=0 THEN
      RETURN(0)
    FI
  ELSEIF (process.breakFlags & PROCESSSTATE.BREAK_BACKGROUND)<>0 THEN
    BEGIN
      LET scope=DOSBREAKTYPES.Scope POINTER(client.foreground)
      IF scope<>NULL THEN
        IF scope.opState<>0 AND scope.opState<>FSOPERATION.COLLECTED THEN
          RETURN(0)
        FI

        IF scope.handle<>NULL THEN
          client.foregroundLoan=0
          IF DOSBREAK.End()=0 THEN
            client.foregroundLoan=DOSCLIENT.FOREGROUND_PROCESS
            RETURN(0)
          FI
        ELSE
          EXEC.Forbid()
          client.foreground=NULL
          client.foregroundLoan=0
          scope.active=0
          EXEC.Permit()
          DOSBREAK.Free(scope)
        FI
      FI
    END
  ELSE
    IF DOSBREAK.End()=0 THEN
      RETURN(0)
    FI
  FI

  firstError=0
  client.input=BYTE POINTER(0)
  client.output=BYTE POINTER(0)
  client.directory=BYTE POINTER(0)
  WHILE owner.objects<>BYTE POINTER(0) DO
    identity=owner.objects
    item=DOSOBJECTS.Header POINTER(identity)
    IF item.owner<>owner THEN
      RETURN(0)
    FI

    CASE item.kind OF
    WHEN DOSOBJECTS.KIND_FILE THEN
      IF DOSCALLS.Close(identity)=0 AND firstError=0 THEN
        firstError=DOSCLIENT.IoErr()
      FI
    WHEN DOSOBJECTS.KIND_LOCK THEN
      DOSCALLS.UnLock(identity)
      IF DOSOBJECTS.Find(owner,identity,
          DOSOBJECTS.KIND_LOCK)<>DOSOBJECTS.Header POINTER(0) THEN
        RETURN(0)
      FI
    ELSE
      RETURN(0)
    ESAC

    IF owner.objects=identity THEN
      RETURN(0)
    FI
  OD

  IF firstError<>0 AND process.primary<10 THEN
    process.primary=20
    process.secondary=firstError
  FI

  IF DOSCLIENT.ReleaseContext()=0 THEN
    RETURN(0)
  FI

RETURN(Discard(process))

; Only the parent calls this after kernel-acknowledged retirement, or while
; rolling back an unpublished start. Its context could not be released while
; suspended, and no inherited wrapper still depends on the parent's handles.
PUBLIC PROC ReleaseParent(PROCESSSTATE.Entry POINTER process)
  DOSCLIENT.ClientContext POINTER client
  DOSBREAKTYPES.Scope POINTER scope

  client=DOSCLIENT.ClientContext POINTER(process.parentClient)
  IF client<>DOSCLIENT.ClientContext POINTER(0) THEN
    scope=DOSBREAKTYPES.Scope POINTER(process.parentScope)
    IF client.foreground<>BYTE POINTER(scope) OR scope.active=0
        OR process.foreground=TRANSFERRED THEN
      HEAPCORE.Abort($ff94)
    FI

    client.suspended=0
  FI

  process.parentClient=BYTE POINTER(0)
  process.parentScope=BYTE POINTER(0)
  process.foreground=0
  IF process.groupScope<>BYTE POINTER(0) THEN
    scope=DOSBREAKTYPES.Scope POINTER(process.groupScope)
    EXEC.Forbid()
    IF scope.groupRefs=0 THEN
      HEAPCORE.Abort($ff94)
    FI

    scope.groupRefs==-1
    process.groupScope=BYTE POINTER(0)
    EXEC.Permit()
  FI

RETURN

ENDMODULE
