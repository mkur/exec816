MODULE DOSCOOKED
USE EXEC
USE DOSCORE
USE DOSCLIENT
USE DOSOBJECTS
USE DOSSTREAMS
USE DOSRAW
USE COOKEDLINE
USE DOSBREAKTYPES
USE DOSCANCEL
USE CONSOLETYPES
USE CONSOLECORE
USE HEAPCORE
USE A816MEMORY
USE ASCII
INCLUDE "dos-types.inc"

PUBLIC TYPE Handle=[
  DOSSTREAMS.Handle stream
  COOKEDLINE.Session POINTER state
]

; Pair a raw console endpoint with shared editable-line state.
PUBLIC BYTE POINTER FUNC Open(DOSCLIENT.ClientContext POINTER client LONGCARD unit)
  Handle POINTER item
  COOKEDLINE.Session POINTER state
  BYTE ignored

  client.busy=1
  state=COOKEDLINE.Create()
  IF state=COOKEDLINE.Session POINTER(0) THEN
    client.busy=0
    DOSCLIENT.SetError(ERROR_NO_FREE_STORE)
    RETURN(BYTE POINTER(0))
  FI

  item=Handle POINTER(DOSRAW.OpenSized(client,DOSOBJECTS.BACKEND_CON,
      SIZEOF(Handle),unit))
  IF item=Handle POINTER(0) THEN
    ignored=COOKEDLINE.Destroy(state)
    RETURN(BYTE POINTER(0))
  FI

  item.state=state

RETURN(BYTE POINTER(item))

; Release the line-session reference only after the underlying endpoint
; closes.
PUBLIC LONGINT FUNC Close(DOSCLIENT.ClientContext POINTER client Handle
    POINTER item)
  COOKEDLINE.Session POINTER state
  LONGINT result
  BYTE ignored

  state=item.state
  IF state.editOwner=BYTE POINTER(item)
      OR (state.references=1 AND state.busy<>0) THEN
    DOSCLIENT.SetError(ERROR_OBJECT_IN_USE)
    RETURN(0)
  FI

  result=DOSRAW.CloseSized(client,@item.stream,SIZEOF(Handle))
  ; A successful close consumes the wrapper; rejection leaves it owned.
  IF result<>0 THEN
    ignored=COOKEDLINE.Release(state)
  FI

RETURN(result)

; The outer Read retains the endpoint's input lease and active reference across
; all transfers. Every call collects its reply before reusing this one request.
LONGINT FUNC Wire(DOSCLIENT.ClientContext POINTER client BYTE POINTER buffer
    CARD length BYTE reading,cancellable)
  EXEC.IOStdReq POINTER request
  INT error
  LONGINT secondary
  DOSBREAKTYPES.Scope POINTER scope

  request=client.request
  request.io_Data=buffer
  request.io_Length=LONGCARD(length)
  request.io_Actual=0
  request.io_Offset=0
  request.io_Flags=0
  IF reading<>0 THEN
    request.io_Command=EXEC.CMD_READ
  ELSE
    request.io_Command=EXEC.CMD_WRITE
  FI

  scope=DOSBREAKTYPES.Scope POINTER(0)
  IF cancellable<>0 THEN
    scope=DOSBREAKTYPES.Scope POINTER(client.foreground)
  FI

  error=DOSCANCEL.Transfer(EXEC.IORequest POINTER(request),scope,client)
  secondary=LONGINT(error)
  IF error=EXEC.CONERR_INPUTOVERFLOW THEN
    secondary=ERROR_BUFFER_OVERFLOW
  FI

  IF error=EXEC.IOERR_UNITBUSY THEN
    secondary=ERROR_OBJECT_IN_USE
  FI

  IF secondary=0 THEN
    IF request.io_Actual>LONGCARD(length) OR (reading<>0
        AND request.io_Actual=0) OR (reading=0
        AND request.io_Actual<>LONGCARD(length)) THEN
      secondary=LONGINT(EXEC.IOERR_BADLENGTH)
    FI
  FI

  DOSCLIENT.SetError(secondary)
  IF secondary<>0 THEN
    RETURN(-1)
  FI

RETURN(LONGINT(request.io_Actual))

; Prepare one cooked input operation against its retained line session.
BYTE FUNC Begin(DOSCLIENT.ClientContext POINTER client COOKEDLINE.Session
    POINTER state)
  CONSOLETYPES.Instance POINTER instance
  CARD available,width,row,index

  instance=CONSOLETYPES.Instance POINTER(client.request.io_Unit)
  EXEC.Forbid()
  width=instance.width
  available=width-instance.column
  state.echo(COOKEDLINE.PROMPT_OFFSET)=0
  IF available>=3 AND instance.column<>0
      AND instance.column<=COOKEDLINE.PROMPT_BYTES THEN
    ; Retained cells change in Task context. Snapshot the short prefix while
    ; switching is forbidden; keyboard and other interrupts remain enabled.
    state.echo(COOKEDLINE.PROMPT_OFFSET)=BYTE(instance.column)
    row=CONSOLECORE.CellOffset(instance,instance.lineStart)
    FOR index=0 TO instance.column-1 DO
      state.echo(COOKEDLINE.PROMPT_OFFSET+1+index)=instance.cells(row+index)
    OD
  FI

  EXEC.Permit()
  IF width<3 THEN
    DOSCLIENT.SetError(ERROR_OBJECT_WRONG_TYPE)
    RETURN(0)
  FI

  state.drawn=0
  state.screenCursor=0
  state.appendEcho=0
  state.width=COOKEDLINE.TAIL_COLUMNS
  IF available<3 THEN
    state.echo(0)=10
    IF Wire(client,state.echo,1,0,1)<0 THEN
      RETURN(0)
    FI

    available=width
  FI

  IF available<COOKEDLINE.TAIL_COLUMNS+2 THEN
    state.width=BYTE(available-2)
  FI

RETURN(1)

; Cancellation retires a valid line and queued typeahead before the caller
; can begin a new command. A corrupt line keeps its discard-through-Return
; state. CLEAR and the final newline are cleanup and ignore the sticky break.
LONGINT FUNC CancelLine(DOSCLIENT.ClientContext POINTER client
    COOKEDLINE.Session POINTER state)
  EXEC.IOStdReq POINTER request
  CONSOLETYPES.Instance POINTER instance
  INT error
  BYTE ignored
  LONGINT written

  ; Loss can arrive while the native caller is discovering candidates. Preserve
  ; quarantine even if CANCEL/BREAK wins before the next physical Read.
  instance=CONSOLETYPES.Instance POINTER(client.request.io_Unit)
  EXEC.Forbid()
  IF instance.inputLost<>0 THEN
    COOKEDLINE.Lose(state,ERROR_BUFFER_OVERFLOW)
  FI

  EXEC.Permit()
  IF state.discard<>0 THEN
    DOSCLIENT.SetError(ERROR_BREAK)
    RETURN(-1)
  FI

  state.length=0
  state.position=0
  state.ready=0
  state.eof=0
  state.error=0
  ignored=COOKEDLINE.Feed(state,3)
  request=client.request
  request.io_Command=EXEC.CMD_CLEAR
  request.io_Data=BYTE POINTER(0)
  request.io_Length=0
  request.io_Actual=0
  request.io_Offset=0
  request.io_Flags=0
  error=DOSCANCEL.Transfer(EXEC.IORequest POINTER(request),
      DOSBREAKTYPES.Scope POINTER(0),client)
  ; A canceled Write finishes its logical scroll before collection. At
  ; column zero the next prompt already starts a fresh line; a second LF
  ; would scroll a whole screen again during command retirement.
  IF instance.column<>0 THEN
    state.echo(0)=10
    written=Wire(client,state.echo,1,0,0)
  FI

  state.drawn=0
  DOSCLIENT.SetError(ERROR_BREAK)

RETURN(0)

; Serialize readers that share the same editable line state.
LONGINT FUNC AcquireLine(DOSCLIENT.ClientContext POINTER client
    COOKEDLINE.Session POINTER state BYTE starting)
  BYTE action
  CARD count
  LONGINT error

  IF starting<>0 THEN
    IF Begin(client,state)=0 THEN
      IF DOSCLIENT.IoErr()=ERROR_BREAK THEN
        RETURN(CancelLine(client,state))
      FI

      RETURN(-1)
    FI
  FI

  WHILE state.ready=0 DO
    IF Wire(client,@state.key,1,1,1)<0 THEN
      error=DOSCLIENT.IoErr()
      IF error=ERROR_BREAK THEN
        RETURN(CancelLine(client,state))
      FI

      COOKEDLINE.Lose(state,error)
      IF error<>ERROR_BUFFER_OVERFLOW THEN
        RETURN(-1)
      FI

      count=COOKEDLINE.Render(state)
      IF Wire(client,state.echo,count,0,1)<0 THEN
        IF DOSCLIENT.IoErr()=ERROR_BREAK THEN
          RETURN(CancelLine(client,state))
        FI

        RETURN(-1)
      FI
    ELSE
      action=COOKEDLINE.Feed(state,state.key)
      IF action=1 THEN
        count=COOKEDLINE.Render(state)
        IF Wire(client,state.echo,count,0,1)<0 THEN
          error=DOSCLIENT.IoErr()
          IF error=ERROR_BREAK THEN
            RETURN(CancelLine(client,state))
          FI

          COOKEDLINE.Lose(state,error)
          RETURN(-1)
        FI
      ELSEIF action=2 THEN
        state.echo(0)=10
        IF Wire(client,state.echo,1,0,1)<0 THEN
          error=DOSCLIENT.IoErr()
          IF error=ERROR_BREAK THEN
            RETURN(CancelLine(client,state))
          FI

          COOKEDLINE.Lose(state,error)
          RETURN(-1)
        FI

        state.drawn=0
      FI

      IF action=3 THEN
        RETURN(1)
      FI
    FI
  OD

RETURN(0)

; Edit and deliver a line while retaining exclusive session ownership.
LONGINT FUNC ReadLocked(DOSCLIENT.ClientContext POINTER client Handle
    POINTER item BYTE POINTER buffer LONGINT length)
  COOKEDLINE.Session POINTER state
  EXEC.IOStdReq POINTER request
  CARD limit
  LONGINT result,error

  client.busy=1
  state=item.state
  IF DOSRAW.Live(@item.stream)=0 THEN
    client.busy=0
    DOSCLIENT.SetError(ERROR_BAD_STREAM_NAME)
    RETURN(-1)
  FI

  IF DOSRAW.ValidExtent(buffer,length)=0 THEN
    client.busy=0
    RETURN(-1)
  FI

  IF length=0 THEN
    client.busy=0
    DOSCLIENT.SetError(0)
    RETURN(0)
  FI

  limit=256
  IF length<256 THEN
    limit=CARD(length)
  FI

  result=COOKEDLINE.Drain(state,buffer,limit)
  IF result=COOKEDLINE.PENDING THEN
    request=DOSRAW.Prepare(client,@item.stream,@state.key,1,1)
    IF request=EXEC.IOStdReq POINTER(0) THEN
      RETURN(-1)
    FI

    result=AcquireLine(client,state,1)
    error=DOSCLIENT.IoErr()
    DOSRAW.Finish(client,@item.stream,1)
    IF result<0 THEN
      DOSCLIENT.SetError(error)
      RETURN(-1)
    FI

    result=COOKEDLINE.Drain(state,buffer,limit)
  FI

  error=0
  IF result<0 THEN
    error=state.error
    state.error=0
  FI

  client.busy=0
  DOSCLIENT.SetError(error)

RETURN(result)

; Copy a sealed line or its one-shot EOF using ordinary cooked drain semantics.
; The LF occupies the 256th byte only until it is replaced by the terminator.
LONGINT FUNC EditDrain(COOKEDLINE.Session POINTER state
    ConsoleEditState POINTER edit)

  LET count=COOKEDLINE.Drain(state,edit.buffer,CONEDIT_BUFFER_BYTES)
  IF count=COOKEDLINE.PENDING THEN
    RETURN(count)
  FI

  IF count<0 THEN
    DOSCLIENT.SetError(state.error)
    state.error=0
    RETURN(-1)
  FI

  edit.length=CARD(count)
  edit.newline=0
  IF count<>0 THEN
    IF edit.buffer(edit.length-1)=ASCII.LF THEN
      edit.length==-1
      edit.newline=1
    FI
  FI

  edit.buffer(edit.length)=ASCII.NUL
  edit.cursor=edit.length
  DOSCLIENT.SetError(0)

RETURN(IF count=0 THEN LONGINT(CONEDIT_EOF) ELSE LONGINT(CONEDIT_LINE) FI)

; Release one continuation only after its request has settled. The shared
; session survives through its handle references, including a quarantined line.
PROC EndEdit(DOSCLIENT.ClientContext POINTER client Handle POINTER item)

  DOSRAW.Finish(client,@item.stream,1)
  item.state.editOwner=NULL
  COOKEDLINE.Leave(item.state)

RETURN

; A pause retains input ownership but frees the DOS request/context for normal
; filesystem operations. No caller buffer or callback survives a call.
PUBLIC LONGINT FUNC Edit(DOSCLIENT.ClientContext POINTER client Handle
    POINTER item ConsoleEditState POINTER edit)
  LONGINT result,error
  CARD count
  BYTE starting,ignored

  LET state=item.state
  IF edit.action>CONEDIT_CANCEL THEN
    DOSCLIENT.SetError(ERROR_BAD_ARGUMENTS)
    RETURN(-1)
  FI

  IF edit.action<>CONEDIT_CANCEL THEN
    IF edit.capacity<CONEDIT_BUFFER_BYTES OR (edit.action=CONEDIT_RESUME
        AND edit.replace<>0 AND (edit.length>=CONEDIT_BUFFER_BYTES
        OR edit.cursor>edit.length)) THEN
      DOSCLIENT.SetError(ERROR_BAD_NUMBER)
      RETURN(-1)
    FI

    IF DOSRAW.ValidExtent(edit.buffer,CONEDIT_BUFFER_BYTES)=0 THEN
      RETURN(-1)
    FI
  FI

  starting=edit.action=CONEDIT_START
  IF starting<>0 THEN
    IF COOKEDLINE.Enter(state)=0 THEN
      DOSCLIENT.SetError(ERROR_OBJECT_IN_USE)
      RETURN(-1)
    FI

    result=EditDrain(state,edit)
    IF result<>COOKEDLINE.PENDING THEN
      COOKEDLINE.Leave(state)
      RETURN(result)
    FI

    IF DOSRAW.Prepare(client,@item.stream,@state.key,1,1)=NULL THEN
      COOKEDLINE.Leave(state)
      RETURN(-1)
    FI

    state.editOwner=BYTE POINTER(item)
  ELSE
    IF state.editOwner<>BYTE POINTER(item) THEN
      DOSCLIENT.SetError(ERROR_OBJECT_IN_USE)
      RETURN(-1)
    FI

    DOSRAW.Reattach(client,@item.stream)
    IF edit.action=CONEDIT_CANCEL THEN
      result=CancelLine(client,state)
      IF state.discard=0 THEN
        ; A deliberate cancellation has no pending Read to report its BREAK.
        state.ready=0
        state.error=0
      FI

      EndEdit(client,item)
      DOSCLIENT.SetError(0)
      RETURN(CONEDIT_CANCELLED)
    FI

    IF edit.replace<>0 THEN
      ignored=COOKEDLINE.Replace(state,edit.buffer,edit.length,edit.cursor)
      count=COOKEDLINE.Render(state)
      IF Wire(client,state.echo,count,0,1)<0 THEN
        error=DOSCLIENT.IoErr()
        IF error=ERROR_BREAK THEN
          result=CancelLine(client,state)
          state.ready=0
          state.error=0
        ELSE
          COOKEDLINE.Lose(state,error)
        FI

        EndEdit(client,item)
        DOSCLIENT.SetError(error)
        RETURN(-1)
      FI
    FI
  FI

  result=AcquireLine(client,state,starting)
  error=DOSCLIENT.IoErr()
  IF result=1 THEN
    edit.length=state.length
    edit.cursor=state.cursor
    edit.newline=0
    edit.replace=0
    A816MEMORY.Move(edit.buffer,state.line,SIZE(state.length))
    edit.buffer(state.length)=ASCII.NUL
    DOSRAW.Detach(client)
    client.busy=0
    DOSCLIENT.SetError(0)
    RETURN(CONEDIT_COMPLETE)
  FI

  EndEdit(client,item)
  IF result<0 THEN
    DOSCLIENT.SetError(error)
    RETURN(-1)
  FI

RETURN(EditDrain(state,edit))

; Acquire the cooked session and release it on every terminal read outcome.
PUBLIC LONGINT FUNC Read(DOSCLIENT.ClientContext POINTER client Handle
    POINTER item BYTE POINTER buffer LONGINT length)
  LONGINT result

  IF COOKEDLINE.Enter(item.state)=0 THEN
    DOSCLIENT.SetError(ERROR_OBJECT_IN_USE)
    RETURN(-1)
  FI

  result=ReadLocked(client,item,buffer,length)
  COOKEDLINE.Leave(item.state)

RETURN(result)

ENDMODULE
