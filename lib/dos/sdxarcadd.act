PUBLIC BYTE FUNC Select(LONGCARD bytes,crc)

  IF bytes=4645 AND crc=$03a08a5a THEN
    RETURN(PROFILE)
  FI

RETURN(0)

PUBLIC CARD FUNC Entry(SDXFILE.Layout POINTER plan)

RETURN(0)

PUBLIC BYTE FUNC DirectPage(CARD site BYTE overlay)

  IF overlay=3 THEN
    IF site=SDXABI.GUEST_START+$1d84 OR site=SDXABI.GUEST_START+$1bce OR site=SDXABI.GUEST_START+$1bd0 OR site=SDXABI.GUEST_START+$1be3 OR site=SDXABI.GUEST_START+$1c19 OR site=SDXABI.GUEST_START+$1c1b OR site=SDXABI.GUEST_START+$1c9d OR site=SDXABI.GUEST_START+$1cb6 THEN
      RETURN(1)
    FI
  FI
  IF overlay=4 THEN
    IF site=SDXABI.GUEST_START+$1ac3 OR site=SDXABI.GUEST_START+$1c5d THEN
      RETURN(1)
    FI
  FI
  IF overlay=5 THEN
    IF site=SDXABI.GUEST_START+$1bd0 OR site=SDXABI.GUEST_START+$1bfd THEN
      RETURN(1)
    FI
  FI

RETURN(site=SDXABI.GUEST_START+$2d1)

PUBLIC CARD FUNC Patch(SDXFILE.Layout POINTER plan)
  SDXPATCH.Patch ARRAY patches(2)
  SDXFILE.Block POINTER block,target
  BYTE ARRAY before0=[$99 $ab $00]
  BYTE ARRAY after0=[$bb $95 $ab]
  BYTE ARRAY before1=[$20 $02 $00]
  BYTE ARRAY after1=[$20 $80 $f5]

  block=SDXFILE.Find(plan,1)
  IF block=NULL THEN
    RETURN(1)
  FI
  patches(0).offset=block.placed+240
  patches(0).length=3
  patches(0).expected=@before0
  patches(0).replacement=@after0
  block=SDXFILE.Find(plan,1)
  IF block=NULL THEN
    RETURN(1)
  FI
  SDXSTATE.Word(@before1,1,SDXSTATE.ReadWord(@before1,1)+$f480)
  patches(1).offset=block.placed+3413
  patches(1).length=3
  patches(1).expected=@before1
  patches(1).replacement=@after1

RETURN(SDXPATCH.Apply(plan.bank,@patches,2))

ENDMODULE
