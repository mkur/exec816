MODULE PROGRAMAPI
USE EXEC
USE DOSCALLS
USE DOSCLIENT
USE DOSBREAK
USE PROCESS
USE DOSARGS
USE DOSUTILITY
USE DOSFAULT
USE DOSCOMMAND
USE DOSPANE
USE DOSDELAY

; Explicit task-only providers. Opaque handles keep the external contract free
; of resident implementation records. Dispatch directly to their shared
; implementation, retaining each checked entry and its command signature.
PUBLIC LONGINT FUNC AssignPath(BYTE POINTER name,target)

RETURN(DOSCALLS.AssignPath(name,target))

PUBLIC LONGINT FUNC GetAssign(CARD index BYTE POINTER info)

RETURN(DOSCALLS.GetAssign(index,DOSCALLS.AssignInfo POINTER(info)))

PUBLIC BYTE POINTER FUNC Open(BYTE POINTER name LONGINT mode)

RETURN(DOSCALLS.Open(name,mode))

PUBLIC LONGINT FUNC Read(BYTE POINTER handle,buffer LONGINT length)

RETURN(DOSCALLS.Read(handle,buffer,length))

PUBLIC LONGINT FUNC Write(BYTE POINTER handle,buffer LONGINT length)

RETURN(DOSCALLS.Write(handle,buffer,length))

PUBLIC LONGINT FUNC WriteAt(BYTE POINTER handle CARD column,row
    BYTE POINTER buffer LONGINT length)

RETURN(DOSCALLS.WriteAt(handle,column,row,buffer,length))

PUBLIC BYTE POINTER FUNC OpenPane(CARD rows)

RETURN(DOSPANE.Open(rows))

PUBLIC LONGINT FUNC Seek(BYTE POINTER handle LONGINT offset,mode)

RETURN(DOSCALLS.Seek(handle,offset,mode))

PUBLIC LONGINT FUNC Close(BYTE POINTER handle)

RETURN(DOSCALLS.Close(handle))

PUBLIC LONGINT FUNC Flush(BYTE POINTER handle)

RETURN(DOSCALLS.Flush(handle))

PUBLIC BYTE POINTER FUNC CreateDir(BYTE POINTER name)

RETURN(DOSCALLS.CreateDir(name))

PUBLIC LONGINT FUNC DeleteFile(BYTE POINTER name)

RETURN(DOSCALLS.DeleteFile(name))

PUBLIC LONGINT FUNC Rename(BYTE POINTER oldName,newName)

RETURN(DOSCALLS.Rename(oldName,newName))

PUBLIC BYTE POINTER FUNC Input()

RETURN(DOSCALLS.Selected(0))

PUBLIC BYTE POINTER FUNC Output()

RETURN(DOSCALLS.Selected(1))

PUBLIC LONGINT FUNC IoErr()

RETURN(DOSCLIENT.IoErr())

PUBLIC CSTRING FUNC GetArgStr()

RETURN(PROCESS.GetArgStr())

; Decode this command's argument string using caller-supplied result storage.
PUBLIC LONGINT FUNC ReadArgs(CSTRING template ADDRESS POINTER values
    CARD valueCapacity
                            BYTE POINTER storage CARD storageCapacity)

  LET error=DOSARGS.Parse(PROCESS.GetArgStr(),template,values,valueCapacity,
      storage,storageCapacity)
  DOSCLIENT.SetIoErr(error)
  IF error=0 THEN
    RETURN(-1)
  FI

RETURN(0)

PUBLIC LONGINT FUNC SetIoErr(LONGINT error)

RETURN(DOSCLIENT.SetIoErr(error))

PUBLIC LONGINT FUNC BreakPending()

RETURN(DOSBREAK.Pending())

; Give other Tasks a scheduling opportunity through the command ABI.
PUBLIC PROC Yield()

  EXEC.Yield()

RETURN

; Shared helpers retain the same caller-owned buffers as the command API.
PUBLIC LONGINT FUNC WriteAll(BYTE POINTER handle,buffer LONGINT length)

RETURN(DOSUTILITY.WriteAll(handle,buffer,length))

PUBLIC PROC ReaderInit(BYTE POINTER reader,handle)

  DOSUTILITY.ReaderInit(reader,handle)

RETURN

PUBLIC INT FUNC ReadByte(BYTE POINTER reader)

RETURN(DOSUTILITY.ReadByte(reader))

PUBLIC LONGINT FUNC ReadLine(BYTE POINTER reader,buffer CARD capacity)

RETURN(DOSUTILITY.ReadLine(reader,buffer,capacity))

; Directory records follow the generated public DOS FileInfoBlock layout.
PUBLIC BYTE POINTER FUNC Lock(BYTE POINTER name LONGINT mode)

RETURN(DOSCALLS.Lock(name,mode))

PUBLIC PROC UnLock(BYTE POINTER lock)

  DOSCALLS.UnLock(lock)

RETURN

PUBLIC LONGINT FUNC Examine(BYTE POINTER lock,info)

RETURN(DOSCALLS.Information(lock,info,23))

PUBLIC LONGINT FUNC ExNext(BYTE POINTER lock,info)

RETURN(DOSCALLS.Information(lock,info,24))

PUBLIC LONGINT FUNC IsInteractive(BYTE POINTER handle)

RETURN(DOSCALLS.IsInteractive(handle))

PUBLIC BYTE POINTER FUNC OpenConsole()

RETURN(DOSCALLS.OpenConsole())

PUBLIC LONGINT FUNC ConsoleInfo(BYTE POINTER handle,size)

RETURN(DOSCALLS.ConsoleInfo(handle,size))

PUBLIC LONGINT FUNC Fault(LONGINT code CSTRING header BYTE POINTER buffer
                          CARD capacity)

RETURN(DOSFAULT.Fault(code,header,buffer,capacity))

PUBLIC LONGINT FUNC PrintFault(BYTE POINTER handle LONGINT code CSTRING header
                               BYTE POINTER buffer CARD capacity)

RETURN(DOSFAULT.PrintFault(handle,code,header,buffer,capacity))

PUBLIC LONGINT FUNC ReadArgsOrHelp(CSTRING template ADDRESS POINTER values
    CARD valueCapacity BYTE POINTER storage CARD storageCapacity)

RETURN(DOSCOMMAND.ReadArgsOrHelp(PROCESS.GetArgStr(),template,values,
    valueCapacity,storage,storageCapacity))

PUBLIC LONGINT FUNC Delay(LONGCARD ticks)

RETURN(DOSDELAY.Delay(ticks))

ENDMODULE
