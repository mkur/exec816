MODULE PROCESS
USE EXEC
USE DOS
USE DOSCORE
USE DOSCLIENT
USE DOSPROCESS
USE DOSGROUP
USE DOSBREAKTYPES
USE DOSBREAK
USE PROCESSSTATE
USE PROCESSLAUNCH
USE HEAPCORE
USE PROGRAMIMAGE
USE CPROGRAMBIND
USE SDXBIND
USE FBBIND
INCLUDE "process-types.inc"
INCLUDE "command-results.inc"

TYPE Admission=[
  LONGINT FUNC POINTER entry()
  PROC POINTER trampoline(),finalizer()
  CARD minimumStack
]

PROCESSSTATE.Entry POINTER FUNC Control(BYTE operation BYTE POINTER argument)

RETURN(PROCESSSTATE.Entry POINTER(DOSCORE.Control(operation,argument)))

PROCESSSTATE.Entry POINTER FUNC Current()

RETURN(Control(PROCESSSTATE.OP_CURRENT,BYTE POINTER(0)))

; Expose the current process's retained argument text to its command entry.
PUBLIC CSTRING FUNC GetArgStr()
  PROCESSSTATE.Entry POINTER process

  process=Current()
  IF process=PROCESSSTATE.Entry POINTER(0) THEN
    RETURN(CSTRING(0))
  FI

RETURN(CSTRING(process.arguments))

; A setup hint shares the parent's completion signal. The immutable Process
; state remains the authority for collection; no IRQ/NMI follows this pointer.
PROC PublishSetup(PROCESSSTATE.Entry POINTER process BYTE okay)

  IF (process.breakFlags & PROCESSSTATE.BREAK_SETUP)<>0 THEN
    EXEC.Forbid()
    IF okay<>0 THEN
      process.breakFlags=process.breakFlags OR PROCESSSTATE.BREAK_READY
    ELSE
      process.breakFlags=process.breakFlags OR PROCESSSTATE.BREAK_FAILED
    FI

    EXEC.Signal(EXEC.Task POINTER(process.owner),process.mask)
    EXEC.Permit()
  FI

RETURN

; The kernel admits this resident entry. The dynamic target remains private to
; a retained Image; ordinary AddTask never gains arbitrary loaded entry points.
PUBLIC LONGINT FUNC ExecuteImage()
  PROCESSSTATE.Entry POINTER process
  PROGRAMIMAGE.Image POINTER image

  process=Current()
  IF process=PROCESSSTATE.Entry POINTER(0) THEN
    HEAPCORE.Abort($ff96)
  FI

  image=PROGRAMIMAGE.Image POINTER(process.image)
  IF image=PROGRAMIMAGE.Image POINTER(0) THEN
    HEAPCORE.Abort($ff96)
  FI

  IF image.magic<>PROGRAMIMAGE.MAGIC OR image.running<>1 THEN
    HEAPCORE.Abort($ff96)
  FI

  IF image.kind=PROGRAMIMAGE.KIND_SDX THEN
    RETURN(SDXBIND.Run(image,process.arguments))
  FI

  IF image.kind=PROGRAMIMAGE.KIND_FASTBASIC THEN
    RETURN(FBBIND.Run(image,process.arguments))
  FI

  IF image.kind=PROGRAMIMAGE.KIND_C THEN
    BEGIN
      LET entry=ADDRESS POINTER(@image.entry)
      RETURN(CPROGRAMBIND.Run(entry^,@process.breakFlags))
    END
  FI

RETURN(image.entry())

; Registered resident entry/finalizer. Completion is published by the kernel
; only after this Task has stopped using its stack and direct-page domain.
PUBLIC PROC Run()
  PROCESSSTATE.Entry POINTER process
  DOSCLIENT.ClientContext POINTER client

  process=Current()
  IF process=PROCESSSTATE.Entry POINTER(0) THEN
    HEAPCORE.Abort($ff94)
  FI

  client=DOSCLIENT.Ensure()
  IF client=DOSCLIENT.ClientContext POINTER(0) THEN
    process.primary=RETURN_FAIL
    process.secondary=DOSCLIENT.IoErr()
    PublishSetup(process,0)
    RETURN
  FI

  IF DOSPROCESS.Adopt(process,client)=0 THEN
    process.primary=RETURN_FAIL
    process.secondary=DOSCLIENT.IoErr()
    PublishSetup(process,0)
    RETURN
  FI

  PublishSetup(process,1)
  DOSCLIENT.SetError(0)
  process.primary=process.entry()
  process.secondary=DOSCLIENT.IoErr()

RETURN

; Publish the command result after retiring its process-owned DOS state.
PUBLIC PROC Finish()
  PROCESSSTATE.Entry POINTER process,accepted

  process=Current()
  IF process=PROCESSSTATE.Entry POINTER(0) THEN
    HEAPCORE.Abort($ff94)
  FI

  accepted=Control(PROCESSSTATE.OP_QUIESCE,BYTE POINTER(process))
  IF accepted<>process THEN
    HEAPCORE.Abort($ff94)
  FI

  IF DOSPROCESS.Cleanup(process)=0 THEN
    HEAPCORE.Abort($ff94)
  FI

  accepted=Control(PROCESSSTATE.OP_RETIRE_READY,BYTE POINTER(process))
  IF accepted<>process THEN
    HEAPCORE.Abort($ff94)
  FI

  EXEC.RemTask(EXEC.Task POINTER(0))

RETURN

; Free arguments and process allocations after execution ownership has ended.
PROC ReleaseStorage(PROCESSSTATE.Entry POINTER process)
  LONGCARD ignored

  IF DOSPROCESS.Discard(process)=0 THEN
    HEAPCORE.Abort($ff94)
  FI

  DOSPROCESS.ReleaseParent(process)
  IF process.arguments<>BYTE POINTER(0) THEN
    EXEC.FreeMem(process.arguments,SIZE(process.length)+1)
    process.arguments=BYTE POINTER(0)
  FI

  IF process.mask<>0 THEN
    ignored=EXEC.SetSignal(0,process.mask)
    EXEC.FreeSignal(process.signalBit)
    process.mask=0
  FI

  IF process.image<>BYTE POINTER(0) THEN
    PROGRAMIMAGE.Detach(PROGRAMIMAGE.Image POINTER(process.image))
    process.image=BYTE POINTER(0)
  FI

RETURN

; Collect a finished child's result before releasing retained process
; ownership.
PUBLIC LONGINT FUNC Collect(LONGCARD identity Result POINTER outcome)
  PROCESSSTATE.Entry POINTER process,accepted

  IF outcome=Result POINTER(0) THEN
    DOSCLIENT.SetError(ERROR_BAD_NUMBER)
    RETURN(0)
  FI

  process=Control(PROCESSSTATE.OP_CLAIM,BYTE POINTER(@identity))
  IF process=PROCESSSTATE.Entry POINTER(0) THEN
    RETURN(0)
  FI

  outcome.primary=process.primary
  outcome.secondary=process.secondary
  ReleaseStorage(process)
  accepted=Control(PROCESSSTATE.OP_RELEASE,BYTE POINTER(process))
  IF accepted<>process THEN
    HEAPCORE.Abort($ff94)
  FI

RETURN(-1)

; Borrow the owned child's durable completion signal until collection.
PUBLIC LONGCARD FUNC CompletionMask(LONGCARD identity)

  LET process=Control(PROCESSSTATE.OP_FIND,BYTE POINTER(@identity))
  IF process=NULL THEN
    RETURN(0)
  FI

RETURN(process.mask)

; Wait for a child to finish and return its collected command result.
PUBLIC LONGINT FUNC Wait(LONGCARD identity Result POINTER outcome)
  PROCESSSTATE.Entry POINTER process
  LONGCARD received

  IF outcome=Result POINTER(0) THEN
    DOSCLIENT.SetError(ERROR_BAD_NUMBER)
    RETURN(0)
  FI

  DO
    process=Control(PROCESSSTATE.OP_FIND,BYTE POINTER(@identity))
    IF process=PROCESSSTATE.Entry POINTER(0) THEN
      RETURN(0)
    FI

    IF process.state=PROCESSSTATE.STATE_RETIRED THEN
      RETURN(Collect(identity,outcome))
    FI

    received=EXEC.Wait(process.mask)
  OD

RETURN(0)


; Return an identity only after independent resource and console setup. Failed
; setup is collected through the same retirement path as an ordinary command.
LONGCARD FUNC Admitted(PROCESSSTATE.Entry POINTER process)
  LONGCARD ignored,identity
  LONGINT error
  Result outcome

  identity=process.identity
  IF (process.breakFlags & PROCESSSTATE.BREAK_SETUP)=0 THEN
    RETURN(identity)
  FI

  WHILE (process.breakFlags & (PROCESSSTATE.BREAK_READY
      OR PROCESSSTATE.BREAK_FAILED))=0 DO
    ignored=EXEC.Wait(process.mask)
  OD

  IF (process.breakFlags & PROCESSSTATE.BREAK_FAILED)<>0 THEN
    error=process.secondary
    IF Wait(identity,@outcome)=0 THEN
      HEAPCORE.Abort($ff94)
    FI

    DOSCLIENT.SetError(error)
    RETURN(0)
  FI

  EXEC.Forbid()
  process.breakFlags=process.breakFlags & BYTE($ff-PROCESSSTATE.BREAK_SETUP
      -PROCESSSTATE.BREAK_READY)
  IF process.state<PROCESSSTATE.STATE_RETIRED THEN
    ignored=EXEC.SetSignal(0,process.mask)
  FI

  EXEC.Permit()
  DOSCLIENT.SetError(0)

RETURN(identity)

; Prepare process resources before making its Task runnable.
LONGCARD FUNC StartInternal(LONGINT FUNC POINTER entry() BYTE POINTER arguments
    CARD length BYTE foreground PROGRAMIMAGE.Image POINTER image BYTE POINTER
    group BYTE background PROCESSLAUNCH.StartSpec POINTER specification)
  Admission admission
  PROCESSSTATE.Entry POINTER process,accepted
  CARD index
  LONGCARD identity
  LONGINT error

  IF length>ARGUMENT_LIMIT OR (length<>0 AND arguments=BYTE POINTER(0)) THEN
    DOSCLIENT.SetError(ERROR_BAD_NUMBER)
    RETURN(0)
  FI

  admission.minimumStack=0
  IF specification<>NULL THEN
    admission.minimumStack=specification.minimumStack
  FI

  IF image<>PROGRAMIMAGE.Image POINTER(0) THEN
    IF admission.minimumStack<image.minimumStack THEN
      admission.minimumStack=image.minimumStack
    FI

    IF PROGRAMIMAGE.Attach(image)=0 THEN
      DOSCLIENT.SetError(ERROR_OBJECT_IN_USE)
      RETURN(0)
    FI
  FI

  admission.entry=entry
  admission.trampoline=@Run
  admission.finalizer=@Finish
  process=Control(PROCESSSTATE.OP_RESERVE,BYTE POINTER(@admission))
  IF process=PROCESSSTATE.Entry POINTER(0) THEN
    IF image<>PROGRAMIMAGE.Image POINTER(0) THEN
      PROGRAMIMAGE.Detach(image)
    FI

    RETURN(0)
  FI

  process.breakFlags=background
  process.image=BYTE POINTER(image)
  ; Publish a stable borrowed name with the Task. The Image reference keeps its
  ; copied filename alive even when the loader's owner unloads before Wait.
  LET task=EXEC.Task POINTER(@process.task(0))
  task.tc_Node.ln_Name=BYTE POINTER(c"process")
  IF image<>NULL THEN
    task.tc_Node.ln_Name=BYTE POINTER(c"program")
    IF image.name(0)<>0 THEN
      task.tc_Node.ln_Name=@image.name(0)
    FI
  FI

  identity=process.identity
  process.length=length
  process.arguments=EXEC.AllocMem(SIZE(length)+1,EXEC.MEMF_UPPER)
  IF process.arguments<>BYTE POINTER(0) THEN
    IF length<>0 THEN
      FOR index=0 TO length-1 DO
        process.arguments(index)=arguments(index)
        IF process.arguments(index)=0 THEN
          ; Reject embedded NUL before publishing the command or borrowing I/O.
          ReleaseStorage(process)
          accepted=Control(PROCESSSTATE.OP_ROLLBACK,BYTE POINTER(process))
          DOSCLIENT.SetError(ERROR_BAD_NUMBER)
          RETURN(0)
        FI
      OD
    FI

    process.arguments(length)=0
    process.signalBit=EXEC.AllocSignal($ff)
    IF process.signalBit<>$ff THEN
      process.mask=LONGCARD(1) LSH process.signalBit
      IF group<>BYTE POINTER(0) THEN
        IF DOSPROCESS.PrepareGroup(process,group)<>0 THEN
          RETURN(identity)
        FI
      ELSEIF specification<>NULL THEN
        IF DOSPROCESS.PrepareWith(process,specification)<>0 THEN
          accepted=Control(PROCESSSTATE.OP_LAUNCH,BYTE POINTER(process))
          IF accepted=process THEN
            RETURN(Admitted(process))
          FI
        FI
      ELSEIF DOSPROCESS.Prepare(process,foreground)<>0 THEN
        accepted=Control(PROCESSSTATE.OP_LAUNCH,BYTE POINTER(process))
        IF accepted=process THEN
          RETURN(identity)
        FI
      FI

      error=DOSCLIENT.IoErr()
    ELSE
      error=ERROR_NO_FREE_STORE
    FI
  ELSE
    error=ERROR_NO_FREE_STORE
  FI

  ReleaseStorage(process)
  accepted=Control(PROCESSSTATE.OP_ROLLBACK,BYTE POINTER(process))
  IF accepted<>process THEN
    HEAPCORE.Abort($ff94)
  FI

  DOSCLIENT.SetError(error)

RETURN(0)

PUBLIC LONGCARD FUNC Start(LONGINT FUNC POINTER entry() BYTE POINTER arguments
    CARD length)

RETURN(StartInternal(entry,arguments,length,0,PROGRAMIMAGE.Image POINTER(0),
    BYTE POINTER(0),0,NULL))

PUBLIC LONGCARD FUNC StartForeground(LONGINT FUNC POINTER entry() BYTE
    POINTER arguments CARD length)

RETURN(StartInternal(entry,arguments,length,1,PROGRAMIMAGE.Image POINTER(0),
    BYTE POINTER(0),0,NULL))

; Start a process from an already loaded image with inherited DOS state.
PUBLIC LONGCARD FUNC StartLoaded(BYTE POINTER image,arguments CARD length
    BYTE foreground)

  IF image=BYTE POINTER(0) THEN
    DOSCLIENT.SetError(ERROR_BAD_NUMBER)
    RETURN(0)
  FI

RETURN(StartInternal(@ExecuteImage,arguments,length,foreground,
    PROGRAMIMAGE.Image POINTER(image),BYTE POINTER(0),0,NULL))

; Start a resident entry with a private cancellation scope and no keyboard loan.
PUBLIC LONGCARD FUNC StartBackground(LONGINT FUNC POINTER entry() BYTE
    POINTER arguments CARD length)

RETURN(StartInternal(entry,arguments,length,0,NULL,NULL,
    PROCESSSTATE.BREAK_BACKGROUND,NULL))

; Loaded images retain execution ownership until ordinary Process collection.
PUBLIC LONGCARD FUNC StartBackgroundLoaded(BYTE POINTER image,arguments CARD length)

  IF image=NULL THEN
    DOSCLIENT.SetError(ERROR_BAD_NUMBER)
    RETURN(0)
  FI

RETURN(StartInternal(@ExecuteImage,arguments,length,0,
    PROGRAMIMAGE.Image POINTER(image),NULL,PROCESSSTATE.BREAK_BACKGROUND,NULL))

; The descriptor is borrowed only during Start. Child wrappers own independent
; references; default temporary handles never replace the parent's selections.
PUBLIC LONGCARD FUNC StartConfigured(BYTE POINTER image,descriptor)
  PROCESSLAUNCH.StartSpec specification
  BYTE ownInput,ownOutput
  LONGCARD identity
  LONGINT error

  IF image=NULL THEN
    DOSCLIENT.SetError(ERROR_BAD_NUMBER)
    RETURN(0)
  FI

  specification.arguments=NULL
  specification.input=NULL
  specification.output=NULL
  specification.directory=NULL
  specification.console=NULL
  specification.length=0
  specification.minimumStack=0
  IF descriptor<>NULL THEN
    BEGIN
      LET source=PROCESSLAUNCH.StartSpec POINTER(descriptor)
      specification.arguments=source.arguments
      specification.input=source.input
      specification.output=source.output
      specification.directory=source.directory
      specification.console=source.console
      specification.length=source.length
      specification.minimumStack=source.minimumStack
    END
  FI

  ownInput=BYTE(specification.input=NULL)
  ownOutput=BYTE(specification.output=NULL)
  identity=0
  IF ownInput<>0 THEN
    specification.input=BYTE POINTER(DOS.Open(BYTE POINTER(c"NIL:"),DOS.MODE_OLDFILE))
    IF specification.input=NULL THEN
      RETURN(0)
    FI
  FI

  IF ownOutput<>0 THEN
    specification.output=BYTE POINTER(DOS.Open(BYTE POINTER(c"RAW:"),DOS.MODE_NEWFILE))
  FI

  IF specification.output<>NULL THEN
    identity=StartInternal(@ExecuteImage,specification.arguments,
        specification.length,0,PROGRAMIMAGE.Image POINTER(image),NULL,
        PROCESSSTATE.BREAK_BACKGROUND OR PROCESSSTATE.BREAK_SETUP,@specification)
  FI

  error=DOSCLIENT.IoErr()
  IF ownInput<>0 THEN
    DOS.Close(DOS.FileHandle POINTER(specification.input))
  FI

  IF ownOutput<>0 AND specification.output<>NULL THEN
    DOS.Close(DOS.FileHandle POINTER(specification.output))
  FI

  DOSCLIENT.SetError(error)

RETURN(identity)

; Task-side publication excludes switching. IRQ/NMI never follow these pointers.
; The kernel resolves the parent's identity before any scope is touched.
PUBLIC BYTE FUNC RequestBreak(LONGCARD identity)

  EXEC.Forbid()
  LET process=Control(PROCESSSTATE.OP_FIND,BYTE POINTER(@identity))
  IF process=NULL THEN
    EXEC.Permit()
    RETURN(0)
  FI

  IF process.state>=PROCESSSTATE.STATE_QUIESCING THEN
    EXEC.Permit()
    DOSCLIENT.SetError(0)
    RETURN(1)
  FI

  IF (process.breakFlags & PROCESSSTATE.BREAK_BACKGROUND)=0
      AND process.foreground=0 AND process.groupScope=NULL THEN
    EXEC.Permit()
    DOSCLIENT.SetError(ERROR_OBJECT_WRONG_TYPE)
    RETURN(0)
  FI

  process.breakFlags=process.breakFlags OR PROCESSSTATE.BREAK_PENDING
  LET scope=DOSBREAKTYPES.Scope POINTER(process.breakScope)
  IF scope<>NULL THEN
    scope.pending=1
    EXEC.Signal(EXEC.Task POINTER(scope.owner),scope.mask)
  FI

  EXEC.Permit()
  DOSCLIENT.SetError(0)

RETURN(1)

; Native commands use BREAK. C/GEM children receive a durable cooperative close;
; no Task or image is forcibly removed. OP_FIND enforces parent ownership.
PUBLIC BYTE FUNC RequestStop(LONGCARD identity)

  EXEC.Forbid()
  LET process=Control(PROCESSSTATE.OP_FIND,BYTE POINTER(@identity))
  IF process=NULL THEN
    EXEC.Permit()
    RETURN(0)
  FI

  LET image=PROGRAMIMAGE.Image POINTER(process.image)
  IF image=NULL OR image.kind<>PROGRAMIMAGE.KIND_C THEN
    EXEC.Permit()
    RETURN(RequestBreak(identity))
  FI

  IF process.state<PROCESSSTATE.STATE_QUIESCING THEN
    process.breakFlags=process.breakFlags OR PROCESSSTATE.BREAK_PENDING
    CPROGRAMBIND.Stop(EXEC.Task POINTER(@process.task))
  FI

  EXEC.Permit()
  DOSCLIENT.SetError(0)

RETURN(1)

; Reserve a loaded command for a later coordinated launch.
PUBLIC LONGCARD FUNC PrepareLoaded(BYTE POINTER image,arguments CARD length BYTE
    POINTER group)

  IF image=BYTE POINTER(0) OR group=BYTE POINTER(0) THEN
    DOSCLIENT.SetError(ERROR_BAD_NUMBER)
    RETURN(0)
  FI

RETURN(StartInternal(@ExecuteImage,arguments,length,0,
    PROGRAMIMAGE.Image POINTER(image),group,0,NULL))

; Launch a prepared process only after its admission checks still hold.
PUBLIC BYTE FUNC StartPrepared(LONGCARD identity)
  PROCESSSTATE.Entry POINTER process,accepted

  process=Control(PROCESSSTATE.OP_PREPARED,BYTE POINTER(@identity))
  IF process=PROCESSSTATE.Entry POINTER(0) THEN
    RETURN(0)
  FI

  IF DOSGROUP.Ready(DOSBREAKTYPES.Scope POINTER(process.groupScope))=0 THEN
    DOSCLIENT.SetError(ERROR_OBJECT_IN_USE)
    RETURN(0)
  FI

  accepted=Control(PROCESSSTATE.OP_LAUNCH,BYTE POINTER(process))

RETURN(accepted=process)

; Undo a prepared process that never became runnable.
PUBLIC BYTE FUNC DiscardPrepared(LONGCARD identity)
  PROCESSSTATE.Entry POINTER process,accepted

  process=Control(PROCESSSTATE.OP_PREPARED,BYTE POINTER(@identity))
  IF process=PROCESSSTATE.Entry POINTER(0) THEN
    RETURN(0)
  FI

  ReleaseStorage(process)
  accepted=Control(PROCESSSTATE.OP_ROLLBACK,BYTE POINTER(process))
  IF accepted<>process THEN
    HEAPCORE.Abort($ff94)
  FI

RETURN(1)


ENDMODULE
