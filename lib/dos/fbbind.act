; Guest-enabled builds replace these optional provider bindings.
MODULE FBBIND
USE PROGRAMIMAGE
USE DOSCLIENT
USE O65TYPES

PUBLIC PROGRAMIMAGE.Image POINTER FUNC Load(BYTE POINTER bytes LONGCARD length)

  DOSCLIENT.SetError(LONGINT(O65TYPES.ERROR_UNSUPPORTED))

RETURN(NULL)

PUBLIC LONGINT FUNC Run(PROGRAMIMAGE.Image POINTER image BYTE POINTER arguments)

  DOSCLIENT.SetError(LONGINT(O65TYPES.ERROR_UNSUPPORTED))

RETURN(20)

PUBLIC LONGINT FUNC Attach(PROGRAMIMAGE.Image POINTER image BYTE POINTER source)

  DOSCLIENT.SetError(LONGINT(O65TYPES.ERROR_UNSUPPORTED))

RETURN(0)

PUBLIC PROC Collected(PROGRAMIMAGE.Image POINTER image)

RETURN

ENDMODULE
