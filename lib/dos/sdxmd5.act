; Generated by tools/generate_sdx.py; exact pinned MD5 admission.
MODULE SDXMD5
USE SDXFILE
USE SDXPATCH
USE SDXSTATE
USE SDXABI
PUBLIC CONST PROFILE=16

PUBLIC BYTE FUNC Select(LONGCARD bytes,crc)

  IF bytes=3488 AND crc=$083eb436 THEN
    RETURN(PROFILE)
  FI

RETURN(0)

PUBLIC CARD FUNC Entry(SDXFILE.Layout POINTER plan)

RETURN(SDXFILE.Symbol(plan,BYTE POINTER("@MD5    ")+1))

PUBLIC BYTE FUNC DirectPage(CARD site)

RETURN(site=SDXABI.GUEST_START+$1f8 OR site=SDXABI.GUEST_START+$2f2)

PUBLIC CARD FUNC Patch(SDXFILE.Layout POINTER plan)
  SDXPATCH.Patch ARRAY patches(1)
  SDXFILE.Block POINTER block,target
  BYTE ARRAY before0=[$78]
  BYTE ARRAY after0=[$ea]

  block=SDXFILE.Find(plan,1)
  IF block=NULL THEN
    RETURN(1)
  FI
  patches(0).offset=block.placed+1050
  patches(0).length=1
  patches(0).expected=@before0
  patches(0).replacement=@after0

RETURN(SDXPATCH.Apply(plan.bank,@patches,1))

ENDMODULE
