; RAWCON translates an application-owned cell buffer through public console I/O.
MODULE SDXSCREEN
USE EXEC
USE DOS
USE DOSCLIENT
USE SDXABI
USE SDXSTATE
USE SDXFILES
USE SDXCOMMAND
USE CONSOLETYPES
USE A816MEMORY
USE SDXRUNTIME
USE DOSBREAK
USE DOSBREAKTYPES

; Build an unpublished binding in the existing upper bridge bank. The caller
; owns the guest lease and keeps these buffers alive until Unbind.
PROC StorePointer(BYTE POINTER binding CARD at BYTE POINTER value)
  LONGCARD location

  location=LONGCARD(ADDRESS(value))
  SDXSTATE.Word(binding,at,CARD(location))
  binding(at+2)=BYTE(location RSH 16)
  binding(at+3)=0

RETURN

PUBLIC BYTE FUNC Bind(SDXSTATE.Session POINTER state)
  CARD row
  BYTE POINTER binding
  DOSBREAKTYPES.Scope POINTER scope

  SDXRUNTIME.Unbind(CARD(state.slot))
  binding=BYTE POINTER(ADDRESS(SDXABI.BINDING_BASE))
  SDXSTATE.Word(binding,SDXABI.BINDING_WIDTH,state.screenWidth)
  SDXSTATE.Word(binding,SDXABI.BINDING_HEIGHT,state.screenHeight)
  StorePointer(binding,SDXABI.BINDING_SCREEN,state.screen)
  StorePointer(binding,SDXABI.BINDING_FIRST,@state.screenFirst)
  StorePointer(binding,SDXABI.BINDING_END,@state.screenEnd)
  scope=DOSBREAK.Current()
  IF scope=NULL THEN
    StorePointer(binding,SDXABI.BINDING_PENDING,NULL)
  ELSE
    StorePointer(binding,SDXABI.BINDING_PENDING,@scope.pending)
  FI
  FOR row=0 TO SDXABI.BINDING_ROW_COUNT-1 DO
    SDXSTATE.Word(binding,SDXABI.BINDING_ROWS+row*2,row*state.screenWidth)
  OD

RETURN(BYTE(SDXRUNTIME.Bind(CARD(state.slot))))

; Native operations never expose the console worker's retained model.
; Borrow the stream binding, including bounded mode restoration after BREAK.
BYTE FUNC SetMode(DOS.FileHandle POINTER file BYTE flags)
  BYTE value

  value=flags

RETURN(DOS.ConsoleIO(file,CONSOLETYPES.CONCMD_MODE,0,@value,1)=1)

; Lend all current damage through one public request. The guest cannot run or
; mutate these cells until collection; only acknowledged whole spans retire.
PUBLIC BYTE FUNC Flush(SDXSTATE.Session POINTER state)
  CARD row,first,count,offset,accepted
  LONGINT sent,cause
  CONSOLETYPES.CellSpan POINTER span

  IF state.screenOpen=0 THEN
    RETURN(0)
  FI
  offset=0
  FOR row=0 TO state.screenHeight-1 DO
    first=state.screenFirst(row)
    IF first<CARD(state.screenEnd(row)) THEN
      span=CONSOLETYPES.CellSpan POINTER(state.screenSpans+SIZE(offset))
      span.column=first
      span.row=row
      span.data=state.screen+SIZE(row*state.screenWidth+first)
      span.length=CARD(state.screenEnd(row))-first
      offset==+CONSOLETYPES.CELLSPAN_SIZE
    FI
  OD
  IF offset=0 THEN
    RETURN(0)
  FI
  sent=DOS.ConsoleIO(state.outputHandle,CONSOLETYPES.CONCMD_WRITE_CELL_SPANS,
      0,state.screenSpans,LONGINT(offset))
  cause=DOS.IoErr()
  accepted=0
  IF sent>=0 AND sent<=LONGINT(offset) AND
      (sent MOD LONGINT(CONSOLETYPES.CELLSPAN_SIZE))=0 THEN
    accepted=CARD(sent)
  FI
  count=0
  WHILE count<accepted DO
    span=CONSOLETYPES.CellSpan POINTER(state.screenSpans+SIZE(count))
    state.screenFirst(span.row)=BYTE(state.screenWidth)
    state.screenEnd(span.row)=0
    count==+CONSOLETYPES.CELLSPAN_SIZE
  OD
  IF cause<>0 OR sent<>LONGINT(offset) THEN
    IF cause=0 THEN
      cause=DOS.ERROR_BAD_NUMBER
    FI
    DOS.SetIoErr(cause)
    RETURN(SDXFILES.MapError(state))
  FI

RETURN(0)

; Release the cell buffer after restoring both standard console streams.
PUBLIC PROC Retire(SDXSTATE.Session POINTER state)
  BYTE clear
  LONGINT ignored,cause

  SDXRUNTIME.Unbind(CARD(state.slot))
  IF state.screen=NULL THEN
    RETURN
  FI
  cause=DOS.IoErr()
  clear=12
  ignored=DOS.Write(state.outputHandle,@clear,1)
  ignored=LONGINT(SetMode(DOS.Input(),0))
  ignored=LONGINT(SetMode(state.outputHandle,0))
  state.screenOpen=0
  EXEC.FreeMem(state.screen,SIZE(state.screenWidth*state.screenHeight))
  state.screen=NULL
  IF state.screenSpans<>NULL THEN
    EXEC.FreeMem(state.screenSpans,300)
    state.screenSpans=NULL
  FI
  DOS.SetIoErr(cause)

RETURN

; Admit one fixed interactive geometry before allocating its retained cells.
BYTE FUNC Open(SDXSTATE.Session POINTER state)
  CARD ARRAY geometry(2)
  BYTE mode

  IF state.screen<>NULL THEN
    Retire(state)
  FI

  IF DOS.IsInteractive(DOS.Input())=0 OR
      DOS.IsInteractive(state.outputHandle)=0 THEN
    RETURN(156)
  FI
  IF DOS.ConsoleInfo(state.outputHandle,BYTE POINTER(@geometry))=0 THEN
    RETURN(SDXFILES.MapError(state))
  FI
  state.screenWidth=geometry(0)
  state.screenHeight=geometry(1)
  IF geometry(0)<32 OR geometry(0)>80 OR geometry(1)<2 OR geometry(1)>30 THEN
    RETURN(156)
  FI
  state.screen=EXEC.AllocMem(SIZE(geometry(0)*geometry(1)),EXEC.MEMF_UPPER)
  IF state.screen=NULL THEN
    RETURN(158)
  FI
  state.screenSpans=EXEC.AllocMem(300,EXEC.MEMF_UPPER)
  IF state.screenSpans=NULL THEN
    EXEC.FreeMem(state.screen,SIZE(geometry(0)*geometry(1)))
    state.screen=NULL
    state.nativeError=DOS.ERROR_NO_FREE_STORE
    RETURN(158)
  FI
  mode=CONSOLETYPES.MODE_RAW_KEYS OR CONSOLETYPES.MODE_ATASCII
      OR CONSOLETYPES.MODE_NO_CARET
  IF SetMode(DOS.Input(),mode)=0 OR SetMode(state.outputHandle,mode)=0 THEN
    Retire(state)
    RETURN(SDXFILES.MapError(state))
  FI
  state.screenOpen=1
  state.dp($2c)=BYTE(geometry(0))
  state.dp($2e)=BYTE(geometry(1))
  state.bank($2bf)=BYTE(geometry(1))
  IF Bind(state)=0 THEN
    Retire(state)
    RETURN(156)
  FI

RETURN(0)

; Clearing belongs to the application model; presentation follows at input.
PROC Clear(SDXSTATE.Session POINTER state)
  CARD row

  A816MEMORY.Fill(state.screen,32,SIZE(state.screenWidth*state.screenHeight))
  FOR row=0 TO state.screenHeight-1 DO
    state.screenFirst(row)=0
    state.screenEnd(row)=BYTE(state.screenWidth)
  OD

RETURN

; All four scrolls operate on the client's own bounded cell rectangle.
BYTE FUNC Scroll(SDXSTATE.Session POINTER state)
  CARD row,column,last,first,width
  BYTE operation,fill

  operation=state.dp($22)
  first=state.dp($2b)
  last=state.bank($2bf)
  width=state.screenWidth
  IF first>=state.screenHeight THEN
    RETURN(156)
  FI
  IF (operation=97 OR operation=98) AND
      (last>state.screenHeight OR first>=last) THEN
    RETURN(156)
  FI
  fill=32
  IF operation=97 THEN
    FOR row=first TO last-1 DO
      IF row+1<last THEN
        A816MEMORY.Move(state.screen+SIZE(row*width),
            state.screen+SIZE((row+1)*width),SIZE(width))
      ELSE
        A816MEMORY.Fill(state.screen+SIZE(row*width),fill,SIZE(width))
      FI
      state.screenFirst(row)=0
      state.screenEnd(row)=BYTE(state.screenWidth)
    OD
  ELSEIF operation=98 THEN
    row=last
    WHILE row>first DO
      row==-1
      IF row>first THEN
        A816MEMORY.Move(state.screen+SIZE(row*width),
            state.screen+SIZE((row-1)*width),SIZE(width))
      ELSE
        A816MEMORY.Fill(state.screen+SIZE(row*width),fill,SIZE(width))
      FI
      state.screenFirst(row)=0
      state.screenEnd(row)=BYTE(state.screenWidth)
    OD
  ELSEIF operation=117 OR operation=118 THEN
    ; Column scrolls name one row in ICAX2Z, independently of BOTSCR.
    row=first
    IF operation=117 THEN
      FOR column=0 TO width-2 DO
        state.screen(row*width+column)=state.screen(row*width+column+1)
      OD
      state.screen(row*width+width-1)=fill
    ELSE
      column=width-1
      WHILE column<>0 DO
        state.screen(row*width+column)=state.screen(row*width+column-1)
        column==-1
      OD
      state.screen(row*width)=fill
    FI
    state.screenFirst(row)=0
    state.screenEnd(row)=BYTE(state.screenWidth)
  ELSE
    RETURN(156)
  FI

RETURN(0)

; Dispatch the remaining table entries without exposing native model pointers.
PUBLIC BYTE FUNC Call(SDXSTATE.Session POINTER state BYTE POINTER frame
    CARD operation)
  BYTE error

  IF operation=0 THEN
    error=Open(state)
    IF error=0 THEN
      Clear(state)
    FI
    RETURN(error)
  FI
  IF operation=1 THEN
    Retire(state)
    RETURN(0)
  FI
  IF state.screenOpen=0 THEN
    RETURN(156)
  FI
  IF operation=2 THEN
    Clear(state)
    RETURN(0)
  FI
  IF operation=5 THEN
    RETURN(Scroll(state))
  FI

RETURN(156)

; The guest supplies bounded storage for the retained native failure cause.
PUBLIC BYTE FUNC ErrorText(SDXSTATE.Session POINTER state BYTE POINTER frame)
  CARD at,index
  LONGINT cause,length

  at=CARD(frame(SDXABI.FRAME_A)) OR (CARD(frame(SDXABI.FRAME_X)) LSH 8)
  IF at>=SDXABI.GUEST_LIMIT-64 THEN
    RETURN(156)
  FI
  cause=state.nativeError
  IF cause=0 THEN
    CASE frame(SDXABI.FRAME_Y) OF
    WHEN 170 THEN
      cause=205
    WHEN 158 THEN
      cause=103
    WHEN 167 THEN
      cause=214
    WHEN 128 THEN
      cause=304
    ELSE
      cause=115
    ESAC
  FI
  length=DOS.Fault(cause,NULL,state.bank+at,64)
  IF length<0 THEN
    length=0
  FI
  index=0
  WHILE index<63 AND state.bank(at+index)<>0 DO
    index==+1
  OD
  state.bank(at+index)=$9b

RETURN(0)

; Preserve the scan's qualifiers until the original SDX key dispatcher sees it.
PUBLIC BYTE FUNC Key(SDXSTATE.Session POINTER state BYTE POINTER frame)
  BYTE scan,index,value,mods,error
  BYTE POINTER table
  LONGINT got
  BYTE ARRAY normal=[
    $6c $6a $3b $00 $00 $6b $2b $2a $6f $00 $70 $75
    $0a $69 $2d $3d $76 $00 $63 $00 $00 $62 $78 $7a
    $34 $00 $33 $36 $1b $35 $32 $31 $2c $20 $2e $6e
    $00 $6d $2f $00 $72 $00 $65 $79 $09 $74 $77 $71
    $39 $00 $30 $37 $08 $38 $3c $3e $66 $68 $64 $00
    $00 $67 $73 $61
  ]
  BYTE ARRAY shifted=[
    $4c $4a $3a $00 $00 $4b $5c $5e $4f $00 $50 $55
    $0a $49 $5f $7c $56 $00 $43 $00 $00 $42 $58 $5a
    $24 $00 $23 $26 $1b $25 $22 $21 $5b $20 $5d $4e
    $00 $4d $3f $00 $52 $00 $45 $59 $09 $54 $57 $51
    $28 $00 $29 $27 $08 $40 $3c $3e $46 $48 $44 $00
    $00 $47 $53 $41
  ]

  error=Flush(state)
  IF error<>0 THEN
    RETURN(error)
  FI
  DO
    got=DOS.ConsoleIO(DOS.Input(),CONSOLETYPES.CONCMD_READ_KEYS,0,@scan,1)
    IF got<>1 THEN
      RETURN(SDXFILES.MapError(state))
    FI
    index=scan & 63
    mods=scan & $c0
    IF index=60 THEN
      IF (mods & $80)<>0 THEN
        state.editorCaps=2
      ELSEIF (mods & $40)<>0 THEN
        state.editorCaps=1
      ELSE
        state.editorCaps=IF state.editorCaps=1 THEN BYTE(0) ELSE BYTE(1) FI
      FI
    ELSEIF index=39 THEN
      state.bank($2b6)=state.bank($2b6) XOR $80
    ELSE
      table=@normal
      IF (mods & $40)<>0 THEN
        table=@shifted
      FI
      value=table(index)
      IF value<>0 THEN
        IF index=12 THEN
          value=$9b
        ELSEIF index=52 THEN
          value=IF mods=$80 THEN BYTE($fe) ELSE
              IF mods=$40 THEN BYTE($9c) ELSE BYTE($7e) FI FI
        ELSEIF index=54 AND mods=$40 THEN
          value=$7d
        ELSEIF index=55 AND mods=$40 THEN
          value=$9d
        ELSEIF index=55 AND mods=$80 THEN
          value=$ff
        ELSEIF mods=$80 AND index=6 THEN
          value=$1e
        ELSEIF mods=$80 AND index=7 THEN
          value=$1f
        ELSEIF mods=$80 AND index=14 THEN
          value=$1c
        ELSEIF mods=$80 AND index=15 THEN
          value=$1d
        ELSEIF index=26 AND mods=$80 THEN
          RETURN(136)
        ELSEIF index=33 AND mods=$80 THEN
          value=0
        ELSEIF value>='A AND value<='Z OR value>='a AND value<='z THEN
          value=SDXCOMMAND.Upper(value)
          IF mods=$80 THEN
            value=value & 31
          ELSEIF mods=0 AND state.editorCaps=0 THEN
            value==+32
          FI
        FI
        IF mods=0 AND state.editorCaps=2 AND value>=32 AND value<=125 THEN
          value=(value & 31) XOR state.bank($2b6)
        ELSEIF (mods & $80)=0 AND value>=32 AND value<=125 THEN
          value=value XOR state.bank($2b6)
        FI
        frame(SDXABI.FRAME_X)=mods
        frame(SDXABI.FRAME_A)=value
        frame(SDXABI.FRAME_P)=frame(SDXABI.FRAME_P) & $7d
        RETURN(0)
      FI
    FI
  OD

RETURN(0)

ENDMODULE
