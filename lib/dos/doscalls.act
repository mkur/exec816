MODULE DOSCALLS
USE EXEC
USE DOSCORE
USE DOSCLIENT
USE FSTYPES
USE DOSOBJECTS
USE DOSSTREAMS
USE DOSPIPE
USE DOSRAW
USE DOSPANE
USE DOSCOOKED
USE COOKEDLINE
USE DOSBREAK
USE DOSBREAKTYPES
USE DOSCANCEL
USE FSBOOT
USE FSREGISTRY
USE FSNAMES
USE FSSYSTEM
USE FS83
USE FSLOCKS
USE CONSOLEWINDOWS
USE CONSOLETYPES
INCLUDE "dos-types.inc"

TYPE ResultCell=[BYTE POINTER handle]
TYPE DestinationInfo=[
  LONGCARD unit
  FSTYPES.Object POINTER base
]

PUBLIC CONST ASSIGN_SLOTS=4

; The caller holds Forbid while comparing or copying an immutable entry.
BYTE FUNC AssignIndex(DOSCORE.DosRegistry POINTER registry BYTE POINTER name
    CARD length)
  BYTE slot,index,same
  AssignInfo POINTER item

  FOR slot=0 TO ASSIGN_SLOTS-1 DO
    item=AssignInfo POINTER(registry.assigns(slot))
    IF item<>NULL THEN
      same=1
      FOR index=0 TO length-1 DO
        IF FS83.Fold(name(index))<>item.name(index) THEN
          same=0
          EXIT
        FI
      OD

      IF same<>0 AND item.name(length)=0 THEN
        RETURN(slot)
      FI
    FI
  OD

RETURN(ASSIGN_SLOTS)

; Expand only registered explicit prefixes. A caller-owned upper buffer lives
; until the synchronous packet completes; no registry pointer escapes Forbid.
BYTE POINTER FUNC Expand(DOSCORE.DosSlot POINTER slot BYTE POINTER name
    CARD colon BYTE second)
  DOSCORE.DosRegistry POINTER registry
  DOSCLIENT.ClientContext POINTER client
  AssignInfo POINTER item
  BYTE POINTER result,suffix
  CARD used,part,offset
  BYTE index,found,separator

  IF colon=FSNAMES.INVALID OR colon=FSNAMES.RELATIVE OR colon=0 THEN
    RETURN(name)
  FI

  registry=DOSCORE.GetRegistry()
  EXEC.Forbid()
  found=BYTE(AssignIndex(registry,name,colon)<>ASSIGN_SLOTS)
  EXEC.Permit()
  IF found=0 THEN
    RETURN(name)
  FI

  client=DOSCLIENT.EnsureSlot(slot)
  IF client=NULL THEN
    RETURN(NULL)
  FI

  IF second=0 THEN
    result=client.assignPath
  ELSE
    result=client.assignOther
  FI
  IF result=NULL THEN
    slot.active=1
    result=EXEC.AllocMem(256,EXEC.MEMF_UPPER OR EXEC.MEMF_CLEAR)
    IF result<>NULL THEN
      IF second=0 THEN
        client.assignPath=result
      ELSE
        client.assignOther=result
      FI
    FI

    slot.active=0
    IF result=NULL THEN
      slot.error=ERROR_NO_FREE_STORE
      RETURN(NULL)
    FI
  FI

  found=0
  EXEC.Forbid()
  index=AssignIndex(registry,name,colon)
  IF index<>ASSIGN_SLOTS THEN
    item=AssignInfo POINTER(registry.assigns(index))
    used=0
    WHILE item.target(used)<>0 DO
      result(used)=item.target(used)
      used==+1
    OD

    found=1
  FI

  EXEC.Permit()
  IF found=0 THEN
    RETURN(name)
  FI

  suffix=BYTE POINTER(ADDRESS(name)+SIZE(colon+1))
  IF suffix^=0 THEN
    result(used)=0
    RETURN(result)
  FI

  separator=BYTE(result(used-1)<>': AND result(used-1)<>'/
      AND suffix^<>'/)
  part=0
  WHILE suffix(part)<>0 DO
    part==+1
  OD

  IF used+CARD(separator)+part>255 THEN
    slot.error=ERROR_LINE_TOO_LONG
    RETURN(NULL)
  FI

  IF separator<>0 THEN
    result(used)='/
    used==+1
  FI

  FOR offset=0 TO part DO
    result(used+offset)=suffix(offset)
  OD

RETURN(result)

; Validate the caller's name and classify its volume or stream prefix.
PROC Arguments(DOSCLIENT.ClientContext POINTER client DOSCORE.DosSlot POINTER slot)

  client.packet.sp_Pkt.dp_Arg1=0
  client.packet.sp_Pkt.dp_Arg2=0
  client.packet.sp_Pkt.dp_Arg3=0
  client.packet.sp_Pkt.dp_Arg4=0
  client.packet.sp_Pkt.dp_Arg5=0
  client.packet.sp_Pkt.dp_Arg6=0
  client.packet.sp_Pkt.dp_Arg7=LONGINT(ADDRESS(slot))

RETURN

; Validate a bounded name before starting a name-based DOS operation.
PROC NameArguments(DOSCLIENT.ClientContext POINTER client BYTE POINTER relative,
    result LONGINT action)

  IF action=8 THEN
    client.packet.sp_Pkt.dp_Arg1=0
    client.packet.sp_Pkt.dp_Arg2=LONGINT(ADDRESS(relative))
    client.packet.sp_Pkt.dp_Arg3=SHARED_LOCK
  ELSE
    client.packet.sp_Pkt.dp_Arg1=LONGINT(ADDRESS(result))
    client.packet.sp_Pkt.dp_Arg3=LONGINT(ADDRESS(relative))
  FI

RETURN

; Admit the current Task's client context for one synchronous DOS call.
BYTE POINTER FUNC Acquire(DOSCORE.DosSlot POINTER slot BYTE POINTER name
                          CARD colon FSTYPES.Object POINTER base LONGINT action)
  DOSCLIENT.ClientContext POINTER client
  DOSCORE.DosRegistry POINTER registry
  FSTYPES.Mount POINTER mount
  BYTE POINTER relative
  ResultCell result
  LONGINT success,error

  result.handle=NULL
  relative=name
  client=DOSCLIENT.EnsureSlot(slot)
  IF client=DOSCLIENT.ClientContext POINTER(0) THEN
    RETURN(result.handle)
  FI

  IF colon=FSNAMES.RELATIVE OR colon=0 THEN
    mount=base.mount
    error=FSREGISTRY.RetainBase(mount)
    IF error<>0 THEN
      slot.error=error
      RETURN(result.handle)
    FI
  ELSE
    IF FSBOOT.Ensure()=0 THEN
      registry=DOSCORE.GetRegistry()
      slot.error=registry.error
      RETURN(result.handle)
    FI

    mount=FSREGISTRY.Lookup(name,colon)
    IF mount=FSTYPES.Mount POINTER(0) THEN
      slot.error=ERROR_DEVICE_NOT_MOUNTED
      RETURN(result.handle)
    FI

    relative=BYTE POINTER(ADDRESS(name)+SIZE(colon+1))
  FI

  Arguments(client,slot)
  NameArguments(client,relative,BYTE POINTER(@result),action)
  IF base<>FSTYPES.Object POINTER(0) THEN
    IF action=8 THEN
      client.packet.sp_Pkt.dp_Arg1=LONGINT(ADDRESS(base))
    ELSE
      client.packet.sp_Pkt.dp_Arg2=LONGINT(ADDRESS(base))
    FI
  FI

  success=DOSCLIENT.Call(slot,client,mount.port,action)
  IF success=0 THEN
    FSREGISTRY.Release(mount)
  FI

  IF action=8 OR action=22 THEN
    result.handle=BYTE POINTER(ADDRESS(success))
  FI

RETURN(result.handle)

; Ensure the filesystem service is available before resolving a mount.
BYTE FUNC Configured(BYTE POINTER name CARD colon)
  DOSCORE.DosRegistry POINTER registry
  FSTYPES.Spec POINTER specs
  BYTE index

  registry=DOSCORE.GetRegistry()
  IF registry.count=0 THEN
    RETURN(0)
  FI

  specs=FSTYPES.Spec POINTER(registry.config)
  FOR index=0 TO registry.count-1 DO
    IF FSSYSTEM.Matches(@specs(index),index,name,colon)<>0 THEN
      RETURN(1)
    FI
  OD

RETURN(0)

; Resolve an explicit volume or retained current-directory base.
BYTE FUNC Destination(DOSCORE.DosSlot POINTER slot BYTE POINTER name CARD colon
                      DestinationInfo POINTER resolved)
  BYTE backend

  resolved.base=NULL
  IF colon=FSNAMES.INVALID THEN
    DOSCLIENT.SetError(ERROR_INVALID_COMPONENT_NAME)
    RETURN(0)
  FI

  IF colon=FSNAMES.RELATIVE OR colon=0 THEN
    resolved.base=Directory(slot)
    IF resolved.base=NULL THEN
      RETURN(0)
    FI

    RETURN(DOSOBJECTS.BACKEND_FILE)
  FI

  backend=FSNAMES.Stream(name,colon)
  IF backend<>0 THEN
    IF backend=DOSOBJECTS.BACKEND_RAW OR backend=DOSOBJECTS.BACKEND_CON THEN
      IF DOSRAW.Unit(name+SIZE(colon+1),@resolved.unit)=0 THEN
        DOSCLIENT.SetError(ERROR_INVALID_COMPONENT_NAME)
        RETURN(0)
      FI
    ELSEIF name(colon+1)<>0 THEN
      DOSCLIENT.SetError(ERROR_INVALID_COMPONENT_NAME)
      RETURN(0)
    FI

    RETURN(backend)
  FI

  IF Configured(name,colon)=0 THEN
    DOSCLIENT.SetError(ERROR_DEVICE_NOT_MOUNTED)
    RETURN(0)
  FI

RETURN(DOSOBJECTS.BACKEND_FILE)

PUBLIC LONGINT FUNC Pipe(BYTE POINTER pair)

RETURN(DOSPIPE.Create(DOSPIPE.Pair POINTER(pair)))

; Select the stream or filesystem backend and return a caller-owned file
; wrapper.
PUBLIC BYTE POINTER FUNC Open(BYTE POINTER name LONGINT mode)
  DestinationInfo resolved
  DOSCLIENT.ClientContext POINTER client
  DOSCORE.DosSlot POINTER slot
  CARD colon
  BYTE backend

  slot=DOSCORE.Current()
  colon=FSNAMES.Path(name)
  name=Expand(slot,name,colon,0)
  IF name=NULL THEN
    RETURN(NULL)
  FI

  colon=FSNAMES.Path(name)
  backend=Destination(slot,name,colon,@resolved)
  IF backend=0 THEN
    RETURN(BYTE POINTER(0))
  FI

  IF backend=DOSOBJECTS.BACKEND_CON AND colon<>3 THEN
    DOSCLIENT.SetError(ERROR_ACTION_NOT_KNOWN)
    RETURN(BYTE POINTER(0))
  FI

  IF backend=DOSOBJECTS.BACKEND_FILE THEN
    IF mode<>MODE_OLDFILE AND mode<>MODE_READWRITE AND mode<>MODE_NEWFILE THEN
      DOSCLIENT.SetError(ERROR_BAD_NUMBER)
      RETURN(BYTE POINTER(0))
    FI

    RETURN(Acquire(slot,name,colon,resolved.base,mode))
  FI

  IF DOSSTREAMS.ValidMode(mode)=0 THEN
    DOSCLIENT.SetError(ERROR_BAD_NUMBER)
    RETURN(BYTE POINTER(0))
  FI

  client=DOSCLIENT.EnsureSlot(slot)
  IF client=DOSCLIENT.ClientContext POINTER(0) THEN
    RETURN(BYTE POINTER(0))
  FI

  IF backend=DOSOBJECTS.BACKEND_RAW OR backend=DOSOBJECTS.BACKEND_CON THEN
    IF backend=DOSOBJECTS.BACKEND_RAW THEN
      RETURN(DOSRAW.Open(client,resolved.unit))
    FI

    RETURN(DOSCOOKED.Open(client,resolved.unit))
  FI

RETURN(DOSSTREAMS.OpenNIL(client))

; Resolve a filesystem path into a caller-owned lock with a retained mount.
PUBLIC BYTE POINTER FUNC Lock(BYTE POINTER name LONGINT mode)
  DestinationInfo resolved
  DOSCORE.DosSlot POINTER slot
  CARD colon
  BYTE backend

  slot=DOSCORE.Current()
  colon=FSNAMES.Path(name)
  name=Expand(slot,name,colon,0)
  IF name=NULL THEN
    RETURN(NULL)
  FI

  colon=FSNAMES.Path(name)
  backend=Destination(slot,name,colon,@resolved)
  IF backend=0 THEN
    RETURN(BYTE POINTER(0))
  FI

  IF backend<>DOSOBJECTS.BACKEND_FILE THEN
    DOSCLIENT.SetError(ERROR_OBJECT_WRONG_TYPE)
    RETURN(BYTE POINTER(0))
  FI

  IF mode<>SHARED_LOCK THEN
    DOSCLIENT.SetError(ERROR_DISK_WRITE_PROTECTED)
    RETURN(BYTE POINTER(0))
  FI

RETURN(Acquire(slot,name,colon,resolved.base,8))

; Report a rejected handle using the error expected by its public operation.
PROC BadObject(DOSCORE.DosSlot POINTER owner BYTE kind)

  IF kind=DOSOBJECTS.KIND_LOCK THEN
    owner.error=ERROR_INVALID_LOCK
  ELSE
    owner.error=ERROR_BAD_STREAM_NAME
  FI

RETURN

; Require a live object of the requested kind in the caller's ownership list.
DOSOBJECTS.Header POINTER FUNC Object(DOSCORE.DosSlot POINTER owner BYTE
    POINTER identity BYTE kind)
  DOSOBJECTS.Header POINTER header

  header=DOSOBJECTS.Find(owner,identity,kind)
  IF header<>DOSOBJECTS.Header POINTER(0) THEN
    IF header.backend=DOSOBJECTS.BACKEND_FILE
        OR header.backend=DOSOBJECTS.BACKEND_NIL
        OR header.backend=DOSOBJECTS.BACKEND_RAW
        OR header.backend=DOSOBJECTS.BACKEND_CON
        OR header.backend=DOSOBJECTS.BACKEND_PANE
        OR header.backend=DOSOBJECTS.BACKEND_PIPE THEN
      RETURN(header)
    FI
  FI

  BadObject(owner,kind)

RETURN(DOSOBJECTS.Header POINTER(0))

; Admit a caller-owned file before dispatching its backend operation.
FSTYPES.Object POINTER FUNC File(DOSCLIENT.ClientContext POINTER client
    DOSOBJECTS.Header POINTER header)
  FSTYPES.Object POINTER item

  item=FSREGISTRY.FromHeader(header)
  IF item=FSTYPES.Object POINTER(0) THEN
    BadObject(header.owner,header.kind)
    RETURN(item)
  FI

  IF FSREGISTRY.Retain(item.mount)=0 THEN
    DOSCLIENT.SetError(ERROR_OBJECT_IN_USE)
    RETURN(FSTYPES.Object POINTER(0))
  FI

  Arguments(client,header.owner)
  client.packet.sp_Pkt.dp_Arg1=LONGINT(ADDRESS(item))

RETURN(item)

; Read through the selected backend while preserving partial-transfer
; semantics.
PUBLIC LONGINT FUNC Read(BYTE POINTER identity,buffer LONGINT length)
  DOSCORE.DosSlot POINTER slot
  DOSCLIENT.ClientContext POINTER client
  DOSOBJECTS.Header POINTER header
  EXEC.IOStdReq POINTER request
  INT error
  FSTYPES.Object POINTER item
  FSTYPES.Mount POINTER mount
  LONGINT result

  slot=DOSCORE.Current()
  client=DOSCLIENT.EnsureSlot(slot)
  IF client=DOSCLIENT.ClientContext POINTER(0) THEN
    RETURN(-1)
  FI

  header=Object(slot,identity,DOSOBJECTS.KIND_FILE)
  IF header=DOSOBJECTS.Header POINTER(0) THEN
    RETURN(-1)
  FI

  IF header.backend=DOSOBJECTS.BACKEND_PIPE THEN
    RETURN(DOSPIPE.Transfer(client,DOSPIPE.Handle POINTER(header),buffer,length,0))
  FI

  IF header.backend=DOSOBJECTS.BACKEND_NIL THEN
    RETURN(DOSSTREAMS.TransferNIL(client,buffer,length,0))
  FI

  IF header.backend=DOSOBJECTS.BACKEND_CON THEN
    RETURN(DOSCOOKED.Read(client,DOSCOOKED.Handle POINTER(header),buffer,length))
  FI

  IF header.backend=DOSOBJECTS.BACKEND_PANE THEN
    DOSCLIENT.SetError(ERROR_OBJECT_WRONG_TYPE)
    RETURN(-1)
  FI

  IF header.backend=DOSOBJECTS.BACKEND_RAW THEN
    request=DOSRAW.Prepare(client,DOSSTREAMS.Handle POINTER(header),buffer,length,1)
    IF request=EXEC.IOStdReq POINTER(0) THEN
      IF length=0 AND DOSCLIENT.IoErr()=0 THEN
        RETURN(0)
      FI

      RETURN(-1)
    FI

    error=DOSCANCEL.Transfer(EXEC.IORequest POINTER(request),
        DOSBREAKTYPES.Scope POINTER(client.foreground))
    RETURN(DOSRAW.Complete(client,DOSSTREAMS.Handle POINTER(header),error))
  FI

  item=File(client,header)
  IF item=FSTYPES.Object POINTER(0) THEN
    RETURN(-1)
  FI

  mount=item.mount
  client.packet.sp_Pkt.dp_Arg2=LONGINT(ADDRESS(buffer))
  client.packet.sp_Pkt.dp_Arg3=length
  result=DOSCLIENT.Call(slot,client,mount.port,82)
  FSREGISTRY.Release(mount)

RETURN(result)

; Write through the selected backend while preserving its detailed error.
PUBLIC LONGINT FUNC Write(BYTE POINTER identity,buffer LONGINT length)
  DOSCORE.DosSlot POINTER slot
  DOSCLIENT.ClientContext POINTER client
  DOSOBJECTS.Header POINTER header
  EXEC.IOStdReq POINTER request
  INT error

  slot=DOSCORE.Current()
  client=DOSCLIENT.EnsureSlot(slot)
  IF client=DOSCLIENT.ClientContext POINTER(0) THEN
    RETURN(-1)
  FI

  header=Object(slot,identity,DOSOBJECTS.KIND_FILE)
  IF header=DOSOBJECTS.Header POINTER(0) THEN
    RETURN(-1)
  FI

  IF header.backend=DOSOBJECTS.BACKEND_PIPE THEN
    RETURN(DOSPIPE.Transfer(client,DOSPIPE.Handle POINTER(header),buffer,length,1))
  FI

  IF header.backend=DOSOBJECTS.BACKEND_NIL THEN
    RETURN(DOSSTREAMS.TransferNIL(client,buffer,length,1))
  FI

  IF header.backend=DOSOBJECTS.BACKEND_RAW
      OR header.backend=DOSOBJECTS.BACKEND_CON
      OR header.backend=DOSOBJECTS.BACKEND_PANE THEN
    request=DOSRAW.Prepare(client,DOSSTREAMS.Handle POINTER(header),buffer,length,0)
    IF request=EXEC.IOStdReq POINTER(0) THEN
      IF length=0 AND DOSCLIENT.IoErr()=0 THEN
        RETURN(0)
      FI

      RETURN(-1)
    FI

    error=DOSCANCEL.Transfer(EXEC.IORequest POINTER(request),
        DOSBREAKTYPES.Scope POINTER(client.foreground))
    RETURN(DOSRAW.Complete(client,DOSSTREAMS.Handle POINTER(header),error))
  FI

  IF FSREGISTRY.FromHeader(header)=FSTYPES.Object POINTER(0) THEN
    BadObject(slot,DOSOBJECTS.KIND_FILE)
    RETURN(-1)
  FI

  IF DOSSTREAMS.ValidBuffer(buffer,length)=0 THEN
    RETURN(-1)
  FI

  IF length=0 THEN
    DOSCLIENT.SetError(0)
    RETURN(0)
  FI

  LET item=File(client,header)
  IF item=NULL THEN
    RETURN(-1)
  FI

  LET mount=item.mount
  client.packet.sp_Pkt.dp_Arg2=LONGINT(ADDRESS(buffer))
  client.packet.sp_Pkt.dp_Arg3=length
  LET result=DOSCLIENT.Call(slot,client,mount.port,87)
  FSREGISTRY.Release(mount)

RETURN(result)

; Console-only positioned output shares raw I/O ownership and cancellation.
PUBLIC LONGINT FUNC WriteAt(BYTE POINTER identity CARD column,row
    BYTE POINTER buffer LONGINT length)
  INT error

  LET slot=DOSCORE.Current()
  LET client=DOSCLIENT.EnsureSlot(slot)
  IF client=NULL THEN
    RETURN(-1)
  FI

  LET header=Object(slot,identity,DOSOBJECTS.KIND_FILE)
  IF header=NULL THEN
    RETURN(-1)
  FI

  IF header.backend<>DOSOBJECTS.BACKEND_RAW
      AND header.backend<>DOSOBJECTS.BACKEND_CON
      AND header.backend<>DOSOBJECTS.BACKEND_PANE THEN
    DOSCLIENT.SetError(ERROR_OBJECT_WRONG_TYPE)
    RETURN(-1)
  FI

  LET handle=DOSSTREAMS.Handle POINTER(header)
  LET request=DOSRAW.Prepare(client,handle,buffer,length,0)
  IF request=NULL THEN
    RETURN(IF length=0 AND DOSCLIENT.IoErr()=0 THEN LONGINT(0)
        ELSE LONGINT(-1) FI)
  FI

  request.io_Command=CONSOLETYPES.CONCMD_WRITE_AT
  request.io_Offset=LONGCARD(column)
      OR (LONGCARD(row) LSH CONSOLETYPES.POSITION_ROW_SHIFT)
  error=DOSCANCEL.Transfer(EXEC.IORequest POINTER(request),
      DOSBREAKTYPES.Scope POINTER(client.foreground))

RETURN(DOSRAW.Complete(client,handle,error))

; Apply a position change only to a valid caller-owned file.
PUBLIC LONGINT FUNC Seek(BYTE POINTER identity LONGINT offset,mode)
  DOSCORE.DosSlot POINTER slot
  DOSCLIENT.ClientContext POINTER client
  DOSOBJECTS.Header POINTER header
  FSTYPES.Object POINTER item
  FSTYPES.Mount POINTER mount
  LONGINT result

  slot=DOSCORE.Current()
  client=DOSCLIENT.EnsureSlot(slot)
  IF client=DOSCLIENT.ClientContext POINTER(0) THEN
    RETURN(-1)
  FI

  header=Object(slot,identity,DOSOBJECTS.KIND_FILE)
  IF header=DOSOBJECTS.Header POINTER(0) THEN
    RETURN(-1)
  FI

  IF header.backend=DOSOBJECTS.BACKEND_RAW
      OR header.backend=DOSOBJECTS.BACKEND_CON
      OR header.backend=DOSOBJECTS.BACKEND_PANE THEN
    IF DOSRAW.Live(DOSSTREAMS.Handle POINTER(header))=0 THEN
      DOSCLIENT.SetError(ERROR_BAD_STREAM_NAME)
      RETURN(-1)
    FI
  FI

  IF header.backend<>DOSOBJECTS.BACKEND_FILE THEN
    DOSCLIENT.SetError(ERROR_SEEK_ERROR)
    RETURN(-1)
  FI

  item=File(client,header)
  IF item=FSTYPES.Object POINTER(0) THEN
    RETURN(-1)
  FI

  mount=item.mount
  client.packet.sp_Pkt.dp_Arg2=offset
  client.packet.sp_Pkt.dp_Arg3=mode
  result=DOSCLIENT.Call(slot,client,mount.port,1008)
  FSREGISTRY.Release(mount)

RETURN(result)

; Close an owned file through its backend before relinquishing its identity.
PUBLIC LONGINT FUNC Close(BYTE POINTER identity)
  LONGINT previousError
  DOSCORE.DosSlot POINTER slot
  DOSCLIENT.ClientContext POINTER client
  DOSOBJECTS.Header POINTER header
  FSTYPES.Object POINTER item
  FSTYPES.Mount POINTER mount
  LONGINT result

  slot=DOSCORE.Current()
  client=DOSCLIENT.EnsureSlot(slot)
  IF client=DOSCLIENT.ClientContext POINTER(0) THEN
    RETURN(0)
  FI

  header=Object(slot,identity,DOSOBJECTS.KIND_FILE)
  IF header=DOSOBJECTS.Header POINTER(0) THEN
    RETURN(0)
  FI

  IF header.backend=DOSOBJECTS.BACKEND_PIPE THEN
    RETURN(DOSPIPE.Close(client,DOSPIPE.Handle POINTER(header)))
  FI

  IF header.backend=DOSOBJECTS.BACKEND_NIL THEN
    RETURN(DOSSTREAMS.CloseNIL(client,header))
  FI

  IF header.backend=DOSOBJECTS.BACKEND_CON THEN
    RETURN(DOSCOOKED.Close(client,DOSCOOKED.Handle POINTER(header)))
  FI

  IF header.backend=DOSOBJECTS.BACKEND_RAW THEN
    RETURN(DOSRAW.Close(client,DOSSTREAMS.Handle POINTER(header)))
  FI

  IF header.backend=DOSOBJECTS.BACKEND_PANE THEN
    RETURN(DOSPANE.Close(client,DOSSTREAMS.Handle POINTER(header)))
  FI

  item=File(client,header)
  IF item=FSTYPES.Object POINTER(0) THEN
    RETURN(0)
  FI

  mount=item.mount
  DOSCLIENT.ClearSelections(client,identity)
  previousError=slot.error
  result=DOSCLIENT.Call(slot,client,mount.port,1007)
  FSREGISTRY.Release(mount)
  IF result<>0 THEN
    slot.error=previousError
  FI

RETURN(result)

; Release an owned directory lock through its filesystem handler.
PUBLIC PROC UnLock(BYTE POINTER identity)
  DOSCORE.DosSlot POINTER slot
  DOSCLIENT.ClientContext POINTER client
  DOSOBJECTS.Header POINTER header
  FSTYPES.Object POINTER item
  FSTYPES.Mount POINTER mount
  LONGINT result

  IF identity=BYTE POINTER(0) THEN
    RETURN
  FI

  slot=DOSCORE.Current()
  client=DOSCLIENT.EnsureSlot(slot)
  IF client=DOSCLIENT.ClientContext POINTER(0) THEN
    RETURN
  FI

  header=Object(slot,identity,DOSOBJECTS.KIND_LOCK)
  IF header=DOSOBJECTS.Header POINTER(0) THEN
    RETURN
  FI

  IF client.directory=identity THEN
    DOSCLIENT.SetError(ERROR_OBJECT_IN_USE)
    RETURN
  FI

  item=File(client,header)
  IF item=FSTYPES.Object POINTER(0) THEN
    RETURN
  FI

  mount=item.mount
  result=DOSCLIENT.Call(slot,client,mount.port,15)
  FSREGISTRY.Release(mount)

RETURN

; Validate lock and output storage before requesting directory metadata.
PUBLIC LONGINT FUNC Information(BYTE POINTER identity,info LONGINT action)
  DOSCORE.DosSlot POINTER slot
  DOSCLIENT.ClientContext POINTER client
  DOSOBJECTS.Header POINTER header
  FSTYPES.Object POINTER item
  FSTYPES.Mount POINTER mount
  LONGINT result

  slot=DOSCORE.Current()
  client=DOSCLIENT.EnsureSlot(slot)
  IF client=DOSCLIENT.ClientContext POINTER(0) THEN
    RETURN(0)
  FI

  header=Object(slot,identity,DOSOBJECTS.KIND_LOCK)
  IF header=DOSOBJECTS.Header POINTER(0) THEN
    RETURN(0)
  FI

  item=File(client,header)
  IF item=FSTYPES.Object POINTER(0) THEN
    RETURN(0)
  FI

  mount=item.mount
  client.packet.sp_Pkt.dp_Arg2=LONGINT(ADDRESS(info))
  result=DOSCLIENT.Call(slot,client,mount.port,action)
  FSREGISTRY.Release(mount)

RETURN(result)

; These getters deliberately avoid Ensure: reading an unset default must not
; allocate a context or change the caller's secondary result.
PUBLIC BYTE POINTER FUNC Selected(BYTE output)
  DOSCORE.DosSlot POINTER owner
  DOSCLIENT.ClientContext POINTER client

  owner=DOSCORE.Current()
  client=DOSCLIENT.ClientContext POINTER(owner.context)
  IF client=DOSCLIENT.ClientContext POINTER(0) THEN
    RETURN(BYTE POINTER(0))
  FI

  IF output<>0 THEN
    RETURN(client.output)
  FI

RETURN(client.input)

; Require an idle client before changing borrowed stream selections.
BYTE FUNC SelectionReady(DOSCORE.DosSlot POINTER owner)
  DOSCLIENT.ClientContext POINTER client

  IF owner.active<>0 THEN
    owner.error=ERROR_OBJECT_IN_USE
    RETURN(0)
  FI

  client=DOSCLIENT.ClientContext POINTER(owner.context)
  IF client<>DOSCLIENT.ClientContext POINTER(0) THEN
    IF client.busy<>0 OR client.suspended<>0 THEN
      owner.error=ERROR_OBJECT_IN_USE
      RETURN(0)
    FI
  FI

RETURN(1)

; Reject a selected stream whose identity is no longer live for this caller.
BYTE FUNC LiveSelection(DOSCORE.DosSlot POINTER owner BYTE POINTER identity)
  DOSOBJECTS.Header POINTER header

  header=Object(owner,identity,DOSOBJECTS.KIND_FILE)
  IF header=DOSOBJECTS.Header POINTER(0) THEN
    RETURN(0)
  FI

  IF header.backend=DOSOBJECTS.BACKEND_RAW
      OR header.backend=DOSOBJECTS.BACKEND_CON
      OR header.backend=DOSOBJECTS.BACKEND_PANE THEN
    IF DOSRAW.Live(DOSSTREAMS.Handle POINTER(header))=0 THEN
      BadObject(owner,DOSOBJECTS.KIND_FILE)
      RETURN(0)
    FI
  FI

  IF header.backend=DOSOBJECTS.BACKEND_FILE THEN
    IF FSREGISTRY.FromHeader(header)=FSTYPES.Object POINTER(0) THEN
      BadObject(owner,DOSOBJECTS.KIND_FILE)
      RETURN(0)
    FI
  FI

RETURN(1)

; Replace a borrowed standard stream and return the previous selection.
PUBLIC BYTE POINTER FUNC Select(BYTE POINTER identity BYTE output)
  DOSCORE.DosSlot POINTER owner
  DOSCLIENT.ClientContext POINTER client
  BYTE POINTER previous

  owner=DOSCORE.Current()
  IF SelectionReady(owner)=0 THEN
    RETURN(BYTE POINTER(0))
  FI

  IF identity<>BYTE POINTER(0) THEN
    IF LiveSelection(owner,identity)=0 THEN
      RETURN(BYTE POINTER(0))
    FI
  FI

  previous=BYTE POINTER(0)
  client=DOSCLIENT.ClientContext POINTER(owner.context)
  IF client<>DOSCLIENT.ClientContext POINTER(0) THEN
    IF output<>0 THEN
      previous=client.output
      client.output=identity
    ELSE
      previous=client.input
      client.input=identity
    FI
  FI

  owner.error=0

RETURN(previous)

; Validate a directory selection without transferring ownership of its lock.
FSTYPES.Object POINTER FUNC Directory(DOSCORE.DosSlot POINTER owner)
  DOSCLIENT.ClientContext POINTER client
  FSTYPES.LockObject POINTER item

  IF SelectionReady(owner)=0 THEN
    RETURN(FSTYPES.Object POINTER(0))
  FI

  client=DOSCLIENT.ClientContext POINTER(owner.context)
  IF client=DOSCLIENT.ClientContext POINTER(0) THEN
    owner.error=ERROR_NO_DEFAULT_DIR
    RETURN(FSTYPES.Object POINTER(0))
  FI

  IF client.directory=BYTE POINTER(0) THEN
    owner.error=ERROR_NO_DEFAULT_DIR
    RETURN(FSTYPES.Object POINTER(0))
  FI

  item=FSTYPES.LockObject POINTER(FSREGISTRY.FindObject(owner,
      client.directory,DOSOBJECTS.KIND_LOCK))
  IF item=NULL THEN
    owner.error=ERROR_INVALID_LOCK
    RETURN(FSTYPES.Object POINTER(item))
  FI

  IF (item.state.entry.flags & $10)=0 THEN
    owner.error=ERROR_OBJECT_WRONG_TYPE
    RETURN(FSTYPES.Object POINTER(0))
  FI

RETURN(FSTYPES.Object POINTER(item))

; Replace the caller's borrowed current-directory lock.
PUBLIC BYTE POINTER FUNC CurrentDir(BYTE POINTER identity)
  DOSCORE.DosSlot POINTER owner
  DOSCLIENT.ClientContext POINTER client
  DOSOBJECTS.Header POINTER header
  FSTYPES.LockObject POINTER item
  BYTE POINTER previous

  owner=DOSCORE.Current()
  IF SelectionReady(owner)=0 THEN
    RETURN(BYTE POINTER(0))
  FI

  IF identity<>BYTE POINTER(0) THEN
    header=Object(owner,identity,DOSOBJECTS.KIND_LOCK)
    IF header=DOSOBJECTS.Header POINTER(0) THEN
      RETURN(BYTE POINTER(0))
    FI

    item=FSTYPES.LockObject POINTER(FSREGISTRY.FromHeader(header))
    IF item=NULL THEN
      BadObject(owner,DOSOBJECTS.KIND_LOCK)
      RETURN(BYTE POINTER(0))
    FI

    IF (item.state.entry.flags & $10)=0 THEN
      owner.error=ERROR_OBJECT_WRONG_TYPE
      RETURN(BYTE POINTER(0))
    FI
  FI

  previous=BYTE POINTER(0)
  client=DOSCLIENT.ClientContext POINTER(owner.context)
  IF client<>DOSCLIENT.ClientContext POINTER(0) THEN
    previous=client.directory
    client.directory=identity
  FI

  owner.error=0

RETURN(previous)

; Copy a lock's canonical path only when the caller supplies enough space.
PUBLIC LONGINT FUNC NameFromLock(BYTE POINTER identity,buffer LONGINT length)
  DOSCORE.DosSlot POINTER owner
  DOSOBJECTS.Header POINTER header
  FSTYPES.LockObject POINTER item
  FSLOCKS.Name POINTER name
  BYTE POINTER text
  CARD index

  owner=DOSCORE.Current()
  IF SelectionReady(owner)=0 THEN
    RETURN(0)
  FI

  header=Object(owner,identity,DOSOBJECTS.KIND_LOCK)
  IF header=DOSOBJECTS.Header POINTER(0) THEN
    RETURN(0)
  FI

  item=FSTYPES.LockObject POINTER(FSREGISTRY.FromHeader(header))
  IF item=NULL THEN
    BadObject(owner,DOSOBJECTS.KIND_LOCK)
    RETURN(0)
  FI

  IF length<=0 THEN
    owner.error=ERROR_BAD_NUMBER
    RETURN(0)
  FI

  IF FSNAMES.Mapped(buffer,LONGCARD(length))=0 THEN
    owner.error=ERROR_BAD_NUMBER
    RETURN(0)
  FI

  name=FSLOCKS.Trailer(item)
  text=FSLOCKS.Text(item)
  IF LONGINT(name.length)>=length THEN
    owner.error=ERROR_LINE_TOO_LONG
    RETURN(0)
  FI

  FOR index=0 TO name.length DO
    buffer(index)=text(index)
  OD

  owner.error=0

RETURN(-1)

; Report terminal behavior only for a valid live file backend.
PUBLIC LONGINT FUNC IsInteractive(BYTE POINTER identity)
  DOSCORE.DosSlot POINTER owner
  DOSOBJECTS.Header POINTER header

  owner=DOSCORE.Current()
  IF SelectionReady(owner)=0 THEN
    RETURN(0)
  FI

  IF LiveSelection(owner,identity)=0 THEN
    RETURN(0)
  FI

  owner.error=0
  header=DOSOBJECTS.Header POINTER(identity)
  IF header.backend=DOSOBJECTS.BACKEND_RAW
      OR header.backend=DOSOBJECTS.BACKEND_CON
      OR header.backend=DOSOBJECTS.BACKEND_PANE THEN
    RETURN(-1)
  FI

RETURN(0)

; The scope retains the actual console instance even when selected streams are
; redirected. Return a fresh caller-owned RAW wrapper, never the private handle.
PUBLIC BYTE POINTER FUNC OpenConsole()

  LET client=DOSCLIENT.Ensure()
  IF client=NULL THEN
    RETURN(NULL)
  FI

  LET scope=DOSBREAK.Current()
  IF scope=NULL THEN
    DOSCLIENT.SetError(ERROR_OBJECT_WRONG_TYPE)
    RETURN(NULL)
  FI

  IF scope.active=0 THEN
    DOSCLIENT.SetError(ERROR_OBJECT_WRONG_TYPE)
    RETURN(NULL)
  FI

RETURN(DOSRAW.Open(client,scope.unit))

; Configure only a live caller-owned cooked session. The cooked lease excludes
; readers sharing an inherited session while allocation/configuration runs.
PUBLIC LONGINT FUNC SetConsoleHistory(BYTE POINTER identity BYTE enabled)

  LET owner=DOSCORE.Current()
  IF SelectionReady(owner)=0 THEN
    RETURN(0)
  FI

  IF LiveSelection(owner,identity)=0 THEN
    RETURN(0)
  FI

  LET header=DOSOBJECTS.Header POINTER(identity)
  IF header.backend<>DOSOBJECTS.BACKEND_CON THEN
    owner.error=ERROR_OBJECT_WRONG_TYPE
    RETURN(0)
  FI

  LET item=DOSCOOKED.Handle POINTER(header)
  owner.error=COOKEDLINE.SetHistory(item.state,enabled)

RETURN(IF owner.error=0 THEN LONGINT(-1) ELSE LONGINT(0) FI)

; Query the dimensions of an owned live console, with identity and storage
; validation. The handle's endpoint reference prevents instance destruction.
PUBLIC LONGINT FUNC ConsoleInfo(BYTE POINTER identity,buffer)
  LONGINT result

  IF DOSRAW.ValidExtent(buffer,4)=0 THEN
    RETURN(0)
  FI

  IF IsInteractive(identity)=0 THEN
    IF DOSCLIENT.IoErr()=0 THEN
      DOSCLIENT.SetError(ERROR_OBJECT_WRONG_TYPE)
    FI

    RETURN(0)
  FI

  LET handle=DOSSTREAMS.Handle POINTER(identity)
  LET endpoint=DOSRAW.RawEndpoint POINTER(handle.endpoint)
  LET size=CARD POINTER(buffer)
  result=0
  EXEC.Forbid()
  BEGIN
    LET window=CONSOLEWINDOWS.Find(endpoint.unit)
    IF window<>NULL THEN
      BEGIN
        LET instance=CONSOLETYPES.Instance POINTER(window.instance)
        size(0)=instance.width
        size(1)=instance.height
        result=-1
      END
    FI
  END

  EXEC.Permit()
  DOSCLIENT.SetError(IF result<>0 THEN LONGINT(0) ELSE LONGINT(ERROR_BAD_STREAM_NAME) FI)

RETURN(result)

PUBLIC LONGINT FUNC BeginForeground(BYTE POINTER console)

RETURN(DOSBREAK.Begin(console))

PUBLIC LONGINT FUNC EndForeground()

RETURN(DOSBREAK.End())

PUBLIC LONGINT FUNC BreakPending()

RETURN(DOSBREAK.Pending())

; Acknowledge the current foreground break scope without consuming stream
; input.
PUBLIC PROC ClearBreak()

  DOSBREAK.Clear()

RETURN

; Unbuffered streams have no pending output. Disk synchronization checks the
; same owned wrapper and mount lifetime as Read/Write.
PUBLIC LONGINT FUNC Flush(BYTE POINTER identity)

  LET slot=DOSCORE.Current()
  LET client=DOSCLIENT.EnsureSlot(slot)
  IF client=NULL THEN
    RETURN(0)
  FI

  LET header=Object(slot,identity,DOSOBJECTS.KIND_FILE)
  IF header=NULL THEN
    RETURN(0)
  FI

  IF header.backend<>DOSOBJECTS.BACKEND_FILE THEN
    IF header.backend=DOSOBJECTS.BACKEND_RAW OR header.backend=DOSOBJECTS.BACKEND_CON
      OR header.backend=DOSOBJECTS.BACKEND_PANE THEN
      IF DOSRAW.Live(DOSSTREAMS.Handle POINTER(header))=0 THEN
        slot.error=ERROR_BAD_STREAM_NAME
        RETURN(0)
      FI
    FI

    slot.error=0
    RETURN(-1)
  FI

  LET item=File(client,header)
  IF item=NULL THEN
    RETURN(0)
  FI

  LET mount=item.mount
  LET result=DOSCLIENT.Call(slot,client,mount.port,27)
  FSREGISTRY.Release(mount)

RETURN(result)

PUBLIC BYTE POINTER FUNC CreateDir(BYTE POINTER name)
  DestinationInfo resolved
  CARD colon
  BYTE backend

  LET slot=DOSCORE.Current()
  colon=FSNAMES.Path(name)
  name=Expand(slot,name,colon,0)
  IF name=NULL THEN
    RETURN(NULL)
  FI

  colon=FSNAMES.Path(name)
  backend=Destination(slot,name,colon,@resolved)
  IF backend=0 THEN
    RETURN(NULL)
  FI

  IF backend<>DOSOBJECTS.BACKEND_FILE THEN
    slot.error=ERROR_OBJECT_WRONG_TYPE
    RETURN(NULL)
  FI

RETURN(Acquire(slot,name,colon,resolved.base,22))

FSTYPES.Mount POINTER FUNC PathMount(DOSCORE.DosSlot POINTER slot
    BYTE POINTER name CARD colon FSTYPES.Object POINTER base)
  LONGINT error

  IF colon=FSNAMES.RELATIVE OR colon=0 THEN
    error=FSREGISTRY.RetainBase(base.mount)
    IF error<>0 THEN
      slot.error=error
      RETURN(NULL)
    FI

    RETURN(base.mount)
  FI

  IF FSBOOT.Ensure()=0 THEN
    BEGIN
      LET registry=DOSCORE.GetRegistry()
      slot.error=registry.error
    END
    RETURN(NULL)
  FI

  LET mount=FSREGISTRY.Lookup(name,colon)
  IF mount=NULL THEN
    slot.error=ERROR_DEVICE_NOT_MOUNTED
  FI

RETURN(mount)

; Hold both resolved mount identities until rename replies; aliases compare
; by identity rather than spelling. No target ownership escapes this call.
LONGINT FUNC Namespace(BYTE POINTER name,newName LONGINT action)
  DestinationInfo oldTarget,newTarget
  CARD colon,newColon
  FSTYPES.Mount POINTER second
  LONGINT result

  LET slot=DOSCORE.Current()
  LET client=DOSCLIENT.EnsureSlot(slot)
  IF client=NULL THEN
    RETURN(0)
  FI

  colon=FSNAMES.Path(name)
  name=Expand(slot,name,colon,0)
  IF name=NULL THEN
    RETURN(0)
  FI

  colon=FSNAMES.Path(name)
  IF Destination(slot,name,colon,@oldTarget)<>DOSOBJECTS.BACKEND_FILE THEN
    IF slot.error=0 THEN
      slot.error=ERROR_OBJECT_WRONG_TYPE
    FI

    RETURN(0)
  FI

  LET mount=PathMount(slot,name,colon,oldTarget.base)
  IF mount=NULL THEN
    RETURN(0)
  FI

  second=NULL
  IF colon<>FSNAMES.RELATIVE AND colon<>0 THEN
    name==+SIZE(colon+1)
  FI

  Arguments(client,slot)
  client.packet.sp_Pkt.dp_Arg2=LONGINT(ADDRESS(oldTarget.base))
  client.packet.sp_Pkt.dp_Arg3=LONGINT(ADDRESS(name))
  IF action=17 THEN
    newColon=FSNAMES.Path(newName)
    newName=Expand(slot,newName,newColon,1)
    IF newName=NULL THEN
      FSREGISTRY.Release(mount)
      RETURN(0)
    FI

    newColon=FSNAMES.Path(newName)
    IF Destination(slot,newName,newColon,@newTarget)<>DOSOBJECTS.BACKEND_FILE THEN
      IF slot.error=0 THEN
        slot.error=ERROR_OBJECT_WRONG_TYPE
      FI

      FSREGISTRY.Release(mount)
      RETURN(0)
    FI

    second=PathMount(slot,newName,newColon,newTarget.base)
    IF second=NULL THEN
      FSREGISTRY.Release(mount)
      RETURN(0)
    FI

    IF second<>mount THEN
      FSREGISTRY.Release(second)
      FSREGISTRY.Release(mount)
      slot.error=ERROR_RENAME_ACROSS_DEVICES
      RETURN(0)
    FI

    IF newColon<>FSNAMES.RELATIVE AND newColon<>0 THEN
      newName==+SIZE(newColon+1)
    FI

    client.packet.sp_Pkt.dp_Arg4=LONGINT(ADDRESS(newName))
    client.packet.sp_Pkt.dp_Arg5=LONGINT(ADDRESS(newTarget.base))
  FI

  result=DOSCLIENT.Call(slot,client,mount.port,action)
  IF second<>NULL THEN
    FSREGISTRY.Release(second)
  FI

  FSREGISTRY.Release(mount)

RETURN(result)

PUBLIC LONGINT FUNC DeleteFile(BYTE POINTER name)

RETURN(Namespace(name,NULL,16))

PUBLIC LONGINT FUNC Rename(BYTE POINTER oldName,newName)

RETURN(Namespace(oldName,newName,17))

; A bounded, system-wide directory assign stores only a canonical physical
; path. Publication swaps immutable upper-RAM records under Task exclusion.
PUBLIC LONGINT FUNC AssignPath(BYTE POINTER name,target)
  DOSCORE.DosRegistry POINTER registry
  DOSCORE.DosSlot POINTER owner
  FSTYPES.Spec POINTER specs
  AssignInfo POINTER item,old
  FileInfoBlock POINTER info
  BYTE POINTER targetLock
  CARD length,index
  BYTE chosen,slot
  LONGINT cause

  owner=DOSCORE.Current()
  IF name=NULL OR FSNAMES.Path(name)<>FSNAMES.RELATIVE
      OR FSNAMES.ValidAlias(name)=0 THEN
    owner.error=ERROR_INVALID_COMPONENT_NAME
    RETURN(0)
  FI

  length=0
  WHILE name(length)<>0 DO
    length==+1
  OD

  registry=DOSCORE.GetRegistry()
  specs=FSTYPES.Spec POINTER(registry.config)
  FOR slot=0 TO registry.count-1 DO
    IF FSSYSTEM.Matches(@specs(slot),slot,name,length)<>0 THEN
      owner.error=ERROR_OBJECT_EXISTS
      RETURN(0)
    FI
  OD

  IF target=NULL THEN
    old=NULL
    EXEC.Forbid()
    chosen=AssignIndex(registry,name,length)
    IF chosen<>ASSIGN_SLOTS THEN
      old=AssignInfo POINTER(registry.assigns(chosen))
      registry.assigns(chosen)=ADDRESS(0)
    FI

    EXEC.Permit()
    IF old<>NULL THEN
      EXEC.FreeMem(BYTE POINTER(old),ASSIGNINFO_SIZE)
    FI

    owner.error=0
    RETURN(-1)
  FI

  item=AssignInfo POINTER(EXEC.AllocMem(ASSIGNINFO_SIZE,
      EXEC.MEMF_UPPER OR EXEC.MEMF_CLEAR))
  IF item=NULL THEN
    owner.error=ERROR_NO_FREE_STORE
    RETURN(0)
  FI

  targetLock=Lock(target,SHARED_LOCK)
  cause=owner.error
  IF targetLock<>NULL THEN
    info=FileInfoBlock POINTER(item)
    IF Information(targetLock,BYTE POINTER(info),23)=0 THEN
      cause=owner.error
    ELSEIF info.fib_DirEntryType<=0 THEN
      cause=ERROR_OBJECT_WRONG_TYPE
    ELSEIF NameFromLock(targetLock,@item.target(0),256)=0 THEN
      cause=owner.error
    ELSE
      cause=0
    FI

    owner.error=0
    UnLock(targetLock)
    IF cause=0 THEN
      cause=owner.error
    FI
  FI

  IF cause<>0 THEN
    EXEC.FreeMem(BYTE POINTER(item),ASSIGNINFO_SIZE)
    owner.error=cause
    RETURN(0)
  FI

  IF FSNAMES.Path(@item.target(0))=FSNAMES.INVALID THEN
    EXEC.FreeMem(BYTE POINTER(item),ASSIGNINFO_SIZE)
    owner.error=ERROR_INVALID_COMPONENT_NAME
    RETURN(0)
  FI

  FOR index=0 TO length-1 DO
    item.name(index)=FS83.Fold(name(index))
  OD

  item.name(length)=0
  old=NULL
  chosen=ASSIGN_SLOTS
  EXEC.Forbid()
  chosen=AssignIndex(registry,name,length)
  IF chosen=ASSIGN_SLOTS THEN
    FOR slot=0 TO ASSIGN_SLOTS-1 DO
      IF registry.assigns(slot)=ADDRESS(0) THEN
        chosen=slot
        EXIT
      FI
    OD
  FI

  IF chosen<>ASSIGN_SLOTS THEN
    old=AssignInfo POINTER(registry.assigns(chosen))
    registry.assigns(chosen)=ADDRESS(item)
  FI

  EXEC.Permit()
  IF old<>NULL THEN
    EXEC.FreeMem(BYTE POINTER(old),ASSIGNINFO_SIZE)
  FI

  IF chosen=ASSIGN_SLOTS THEN
    EXEC.FreeMem(BYTE POINTER(item),ASSIGNINFO_SIZE)
    owner.error=ERROR_NO_FREE_STORE
    RETURN(0)
  FI

  owner.error=0

RETURN(-1)

; Copy a whole record while its immutable source remains published.
PUBLIC LONGINT FUNC GetAssign(CARD index AssignInfo POINTER info)
  DOSCORE.DosRegistry POINTER registry
  DOSCORE.DosSlot POINTER owner
  AssignInfo POINTER item
  BYTE POINTER source,destination
  CARD offset
  BYTE occupied

  owner=DOSCORE.Current()
  IF index>=ASSIGN_SLOTS OR FSNAMES.Mapped(BYTE POINTER(info),
      ASSIGNINFO_SIZE)=0 THEN
    owner.error=ERROR_BAD_NUMBER
    RETURN(0)
  FI

  registry=DOSCORE.GetRegistry()
  destination=BYTE POINTER(info)
  occupied=0
  EXEC.Forbid()
  item=AssignInfo POINTER(registry.assigns(index))
  IF item<>NULL THEN
    occupied=1
    source=BYTE POINTER(item)
    FOR offset=0 TO ASSIGNINFO_SIZE-1 DO
      destination(offset)=source(offset)
    OD
  FI

  EXEC.Permit()
  IF occupied=0 THEN
    FOR offset=0 TO ASSIGNINFO_SIZE-1 DO
      destination(offset)=0
    OD
  FI

  owner.error=0

  IF occupied<>0 THEN
    RETURN(-1)
  FI

RETURN(0)

ENDMODULE
