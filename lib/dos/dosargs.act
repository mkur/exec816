; Allocation-free command templates. All mutable state belongs to the caller.
MODULE DOSARGS

USE ASCII
USE SYS
INCLUDE "command-errors.inc"
INCLUDE "command-args.inc"

CONST REQUIRED=1,KEYWORD=2,SWITCH=4,NUMBER=8,MULTI=16
TYPE Field=[CARD start,length BYTE flags]
TYPE Scanner=[CARD at,used BYTE quoted]

; Clear tentative results after every failed parse.
PROC Clear(ADDRESS POINTER values CARD capacity)
  CARD index

  IF capacity<>0 THEN
    FOR index=0 TO capacity-1 DO
      values(index)=0
    OD
  FI

RETURN

CARD FUNC BoundedLength(CSTRING text CARD limit)
  CARD index

  index=0
  WHILE index<=limit DO
    IF text(index)=ASCII.NUL THEN
      RETURN(index)
    FI

    index==+1
  OD

RETURN(index)

BYTE FUNC Upper(BYTE value)

RETURN(IF value>='a AND value<='z THEN value-32 ELSE value FI)

BYTE FUNC Letter(BYTE value)

RETURN((value>='A AND value<='Z) OR (value>='a AND value<='z) OR value='_)

; Compare one bounded label without changing either immutable input.
BYTE FUNC Same(CSTRING left CARD start,length CSTRING right CARD rightStart)
  CARD index

  FOR index=0 TO length-1 DO
    IF Upper(left(start+index))<>Upper(right(rightStart+index)) THEN
      RETURN(0)
    FI
  OD

RETURN(1)

; Validate modifiers and duplicate labels before inspecting argument text.
INT FUNC Describe(CSTRING text Field POINTER fields)
  CARD index,length,start,other
  BYTE count,flags,flag,multiSeen

  index=0
  count=0
  multiSeen=0
  length=BoundedLength(text,ARGS_MAX_TEMPLATE)
  IF length>ARGS_MAX_TEMPLATE THEN
    RETURN(-1)
  FI

  WHILE index<length DO
    IF count=ARGS_MAX_FIELDS OR Letter(text(index))=0 THEN
      RETURN(-1)
    FI

    start=index
    index==+1
    WHILE index<length DO
      IF Letter(text(index))=0 AND (text(index)<'0 OR text(index)>'9) THEN
        EXIT
      FI

      index==+1
    OD

    fields(count).start=start
    fields(count).length=index-start
    other=0
    WHILE other<count DO
      IF fields(other).length=index-start THEN
        IF Same(text,start,index-start,text,fields(other).start)<>0 THEN
          RETURN(-1)
        FI
      FI

      other==+1
    OD

    flags=0
    WHILE text(index)='/ DO
      index==+1
      CASE Upper(text(index)) OF
      WHEN 'A THEN
        flag=REQUIRED
      WHEN 'K THEN
        flag=KEYWORD
      WHEN 'S THEN
        flag=SWITCH
      WHEN 'N THEN
        flag=NUMBER
      WHEN 'M THEN
        flag=MULTI
      ELSE
        RETURN(-1)
      ESAC

      IF (flags & flag)<>0 THEN
        RETURN(-1)
      FI

      flags=flags OR flag
      index==+1
    OD

    IF (flags & SWITCH)<>0 AND flags<>SWITCH THEN
      RETURN(-1)
    FI

    IF (flags & MULTI)<>0 THEN
      IF flags<>MULTI AND flags<>(MULTI OR REQUIRED) THEN
        RETURN(-1)
      FI

      IF multiSeen<>0 THEN
        RETURN(-1)
      FI

      multiSeen=1
    ELSEIF multiSeen<>0 AND (flags & (KEYWORD OR SWITCH))=0 THEN
      RETURN(-1)
    FI

    fields(count).flags=flags
    count==+1
    IF index=length THEN
      EXIT
    FI

    IF text(index)<>', THEN
      RETURN(-1)
    FI

    index==+1
    IF index=length THEN
      RETURN(-1)
    FI
  OD

RETURN(INT(count))

; Decode one word, retaining whether it was quoted for keyword disambiguation.
CARD FUNC Word(CSTRING text Scanner POINTER scan BYTE POINTER storage
               CARD capacity)
  BYTE value

  scan.quoted=0
  IF text(scan.at)=ASCII.DOUBLE_QUOTE THEN
    scan.quoted=1
    scan.at==+1
  FI

  DO
    value=text(scan.at)
    IF scan.quoted<>0 THEN
      IF value=ASCII.NUL THEN
        RETURN(ERROR_UNMATCHED_QUOTES)
      FI

      IF value=ASCII.DOUBLE_QUOTE THEN
        scan.at==+1
        value=text(scan.at)
        IF value<>ASCII.NUL AND value<>ASCII.SPACE AND value<>ASCII.TAB THEN
          RETURN(ERROR_BAD_ARGUMENTS)
        FI

        EXIT
      FI

      IF value=ASCII.ASTERISK THEN
        scan.at==+1
        value=text(scan.at)
        IF value=ASCII.NUL THEN
          RETURN(ERROR_UNMATCHED_QUOTES)
        FI

        IF value<>ASCII.ASTERISK AND value<>ASCII.DOUBLE_QUOTE THEN
          RETURN(ERROR_BAD_ARGUMENTS)
        FI
      FI
    ELSE
      IF value=ASCII.NUL OR value=ASCII.SPACE OR value=ASCII.TAB THEN
        EXIT
      FI

      IF value=ASCII.DOUBLE_QUOTE THEN
        RETURN(ERROR_BAD_ARGUMENTS)
      FI
    FI

    IF scan.used=capacity THEN
      RETURN(ERROR_BUFFER_OVERFLOW)
    FI

    storage(scan.used)=value
    scan.used==+1
    scan.at==+1
  OD

  IF scan.used=capacity THEN
    RETURN(ERROR_BUFFER_OVERFLOW)
  FI

  storage(scan.used)=ASCII.NUL
  scan.used==+1

RETURN(0)

; /N is unsigned decimal, represented by four bytes in the caller's storage.
CARD FUNC Numeric(BYTE POINTER storage CARD start Scanner POINTER scan
                  CARD capacity ADDRESS POINTER result)
  LONGCARD number
  CARD index
  BYTE digit

  index=start
  number=0
  IF storage(index)=ASCII.NUL THEN
    RETURN(ERROR_BAD_NUMBER)
  FI

  WHILE storage(index)<>ASCII.NUL DO
    digit=storage(index)
    IF digit<'0 OR digit>'9 THEN
      RETURN(ERROR_BAD_NUMBER)
    FI

    digit==- '0
    IF number>LONGCARD(429496729) THEN
      RETURN(ERROR_BAD_NUMBER)
    FI

    IF number=LONGCARD(429496729) AND digit>5 THEN
      RETURN(ERROR_BAD_NUMBER)
    FI

    number=number*10+LONGCARD(digit)
    index==+1
  OD

  IF capacity-scan.used<4 THEN
    RETURN(ERROR_BUFFER_OVERFLOW)
  FI

  result^=ADDRESS(storage+SIZE(scan.used))
  LET target=LONGCARD POINTER(storage+SIZE(scan.used))
  target^=number
  scan.used==+4

RETURN(0)

; Assign keywords separately from left-to-right positional fields.
CARD FUNC Decode(CSTRING text,template Field POINTER fields CARD count
                 ADDRESS POINTER values BYTE POINTER storage CARD capacity)
  Scanner scan
  CARD start,field,index,label,error,valueStart,positional,multiCount,tableStart
  BYTE named
  ADDRESS POINTER items

  IF BoundedLength(text,ARGS_MAX_TEXT)>ARGS_MAX_TEXT THEN
    RETURN(ERROR_LINE_TOO_LONG)
  FI

  scan.at=0
  scan.used=0
  positional=0
  multiCount=0
  items=NULL

  DO
    WHILE text(scan.at)=ASCII.SPACE OR text(scan.at)=ASCII.TAB DO
      scan.at==+1
    OD

    IF text(scan.at)=ASCII.NUL THEN
      EXIT
    FI

    ; Preserve the no-fields error even when the storage capacity is zero.
    IF count=0 THEN
      RETURN(ERROR_TOO_MANY_ARGS)
    FI

    start=scan.used
    error=Word(text,@scan,storage,capacity)
    IF error<>0 THEN
      RETURN(error)
    FI

    field=count
    label=0
    WHILE storage(start+label)<>ASCII.NUL AND storage(start+label)<>'= DO
      label==+1
    OD

    IF scan.quoted=0 AND label<>0 THEN
      index=0
      WHILE index<count DO
        IF (fields(index).flags & (KEYWORD OR SWITCH))<>0
            AND fields(index).length=label THEN
          IF Same(template,fields(index).start,label,CSTRING(storage),start)<>0 THEN
            field=index
            EXIT
          FI
        FI

        index==+1
      OD
    FI

    named=BYTE(field<count)
    valueStart=start
    IF named<>0 THEN
      IF values(field)<>0 THEN
        RETURN(ERROR_BAD_ARGUMENTS)
      FI

      IF (fields(field).flags & SWITCH)<>0 THEN
        IF storage(start+label)<>'= THEN
          values(field)=1
          scan.used=start
        ELSE
          RETURN(ERROR_BAD_ARGUMENTS)
        FI
      ELSEIF storage(start+label)='= THEN
        valueStart=start+label+1
        IF storage(valueStart)=ASCII.NUL THEN
          RETURN(ERROR_REQUIRED_ARG_MISSING)
        FI
      ELSE
        scan.used=start
        WHILE text(scan.at)=ASCII.SPACE OR text(scan.at)=ASCII.TAB DO
          scan.at==+1
        OD

        IF text(scan.at)=ASCII.NUL THEN
          RETURN(ERROR_REQUIRED_ARG_MISSING)
        FI

        error=Word(text,@scan,storage,capacity)
        IF error<>0 THEN
          RETURN(error)
        FI
      FI
    ELSE
      WHILE positional<count DO
        IF (fields(positional).flags & (KEYWORD OR SWITCH))=0 THEN
          EXIT
        FI

        positional==+1
      OD

      IF positional=count THEN
        RETURN(ERROR_TOO_MANY_ARGS)
      FI

      field=positional
      IF (fields(field).flags & MULTI)=0 THEN
        positional==+1
      FI
    FI

    IF (fields(field).flags & SWITCH)=0 THEN
      IF (fields(field).flags & MULTI)<>0 THEN
        IF multiCount=ARGS_MAX_MULTI THEN
          RETURN(ERROR_TOO_MANY_ARGS)
        FI

        IF multiCount=0 THEN
          IF capacity-scan.used<3*(ARGS_MAX_MULTI+1) THEN
            RETURN(ERROR_BUFFER_OVERFLOW)
          FI

          tableStart=scan.used
          items=ADDRESS POINTER(storage+SIZE(tableStart))
          items(0)=0
          scan.used==+3*(ARGS_MAX_MULTI+1)
          values(field)=ADDRESS(storage+SIZE(tableStart))
        FI

        items(multiCount)=ADDRESS(storage+SIZE(valueStart))
        multiCount==+1
        items(multiCount)=0
      ELSEIF (fields(field).flags & NUMBER)<>0 THEN
        error=Numeric(storage,valueStart,@scan,capacity,@values(field))
        IF error<>0 THEN
          RETURN(error)
        FI
      ELSE
        values(field)=ADDRESS(storage+SIZE(valueStart))
      FI
    FI
  OD

  index=0
  WHILE index<count DO
    IF (fields(index).flags & REQUIRED)<>0 AND values(index)=0 THEN
      RETURN(ERROR_REQUIRED_ARG_MISSING)
    FI

    index==+1
  OD

RETURN(0)

; Failure never exposes partially assigned result slots.
PUBLIC CARD FUNC Parse(CSTRING text,template ADDRESS POINTER values
                      CARD valueCapacity BYTE POINTER storage CARD storageCapacity)
  Field ARRAY fields(ARGS_MAX_FIELDS)
  INT count
  CARD error

  IF valueCapacity>ARGS_MAX_FIELDS THEN
    RETURN(ERROR_BAD_NUMBER)
  FI

  IF valueCapacity<>0 AND values=NULL THEN
    RETURN(ERROR_BAD_NUMBER)
  FI

  Clear(values,valueCapacity)
  IF storageCapacity<>0 AND storage=NULL THEN
    RETURN(ERROR_BAD_NUMBER)
  FI

  IF template=NULL THEN
    RETURN(ERROR_BAD_TEMPLATE)
  FI

  count=Describe(template,fields)
  IF count<0 THEN
    RETURN(ERROR_BAD_TEMPLATE)
  FI

  IF CARD(count)>valueCapacity THEN
    RETURN(ERROR_BUFFER_OVERFLOW)
  FI

  IF text=NULL THEN
    RETURN(ERROR_BAD_ARGUMENTS)
  FI

  error=Decode(text,template,fields,CARD(count),values,storage,storageCapacity)
  IF error<>0 THEN
    Clear(values,valueCapacity)
  FI

RETURN(error)

ENDMODULE
