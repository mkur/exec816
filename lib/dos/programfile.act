MODULE PROGRAMFILE
USE DOS
USE DOSCLIENT
USE PROGRAMLOAD
USE PROGRAMIMAGE

; The synchronous entry uses the same staging/validation path as GUI callers.
PUBLIC PROGRAMIMAGE.Image POINTER FUNC Load(BYTE POINTER path)
  INT status

  LET job=PROGRAMLOAD.Begin(path)
  IF job=NULL THEN
    RETURN(NULL)
  FI
  DO
    status=PROGRAMLOAD.Advance(job)
    IF status<>0 THEN
      EXIT
    FI
  OD
  IF status>0 THEN
    RETURN(PROGRAMLOAD.Take(job))
  FI
  PROGRAMLOAD.Cancel(job)

RETURN(NULL)
ENDMODULE
