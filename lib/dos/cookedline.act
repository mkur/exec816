; Caller-owned terminal state. No filesystem, console request or caller buffer
; is retained here. Ready bytes and a one-shot EOF drain before new acquisition.
MODULE COOKEDLINE
USE EXEC
USE A816MEMORY
USE ASCII
INCLUDE "dos-types.inc"
INCLUDE "dos-cooked-types.inc"

CONST KEY_HOME=1, KEY_LEFT=2, KEY_BREAK=3, KEY_EOF=4, KEY_END=5
CONST KEY_RIGHT=6, KEY_BACKSPACE=8, KEY_TAB=9, KEY_KILL=11
CONST KEY_NEXT=14, KEY_PREVIOUS=16, KEY_CLEAR=21, KEY_WORD=23

INCLUDE "cooked-history.inc"

; Initialize an empty editable line and its session ownership state.
PUBLIC PROC Init(Session POINTER state)

  state.references=1
  state.busy=0
  state.width=TAIL_COLUMNS
  state.length=0
  state.position=0
  state.error=0
  state.ready=0
  state.eof=0
  state.discard=0
  state.drawn=0
  state.key=0
  state.appendEcho=0
  state.cursor=0
  state.viewStart=0
  state.screenCursor=0
  state.history=NULL

RETURN

; Allocate the shared line session used by cooked console handles.
PUBLIC Session POINTER FUNC Create()
  Session POINTER state

  state=Session POINTER(EXEC.AllocMem(SESSION_SIZE,EXEC.MEMF_UPPER
      OR EXEC.MEMF_CLEAR))
  IF state<>Session POINTER(0) THEN
    Init(state)
  FI

RETURN(state)

; Release line-session storage after its last owner has retired.
PUBLIC BYTE FUNC Destroy(Session POINTER state)

  IF state=Session POINTER(0) THEN
    RETURN(1)
  FI

  IF state.references<>1 OR state.busy<>0 THEN
    RETURN(0)
  FI

  state.references=0
  FreeHistory(state)
  EXEC.FreeMem(BYTE POINTER(state),SESSION_SIZE)

RETURN(1)

; Keep the line session alive for another cooked handle.
PUBLIC BYTE FUNC Retain(Session POINTER state)

  EXEC.Forbid()
  IF state.references=0 OR state.references=$ffff THEN
    EXEC.Permit()
    RETURN(0)
  FI

  state.references==+1
  EXEC.Permit()

RETURN(1)

; Free shared line state only when no cooked handle retains it.
PUBLIC BYTE FUNC Release(Session POINTER state)
  BYTE last

  EXEC.Forbid()
  IF state.references=0 OR (state.references=1 AND state.busy<>0) THEN
    EXEC.Permit()
    RETURN(0)
  FI

  state.references==-1
  last=state.references=0
  EXEC.Permit()
  IF last<>0 THEN
    FreeHistory(state)
    EXEC.FreeMem(BYTE POINTER(state),SESSION_SIZE)
  FI

RETURN(1)

; Acquire exclusive editing ownership for one cooked reader.
PUBLIC BYTE FUNC Enter(Session POINTER state)

  EXEC.Forbid()
  IF state.busy<>0 OR state.references=0 THEN
    EXEC.Permit()
    RETURN(0)
  FI

  state.busy=1
  EXEC.Permit()

RETURN(1)

; Release editing ownership after the read has settled.
PUBLIC PROC Leave(Session POINTER state)

  EXEC.Forbid()
  state.busy=0
  EXEC.Permit()

RETURN

; Configure optional history under the same lease as readers. Return a DOS
; error code, leaving pending line/drain/EOF/discard state unchanged.
PUBLIC LONGINT FUNC SetHistory(Session POINTER state BYTE enabled)

  IF Enter(state)=0 THEN
    RETURN(ERROR_OBJECT_IN_USE)
  FI

  IF enabled<>0 AND state.history=NULL THEN
    state.history=History POINTER(EXEC.AllocMem(HISTORY_SIZE,
        EXEC.MEMF_UPPER OR EXEC.MEMF_CLEAR))
    IF state.history=NULL THEN
      Leave(state)
      RETURN(ERROR_NO_FREE_STORE)
    FI
  FI

  IF state.history<>NULL THEN
    state.history.enabled=enabled<>0
    IF enabled=0 THEN
      ResetHistory(state)
    FI
  FI

  Leave(state)

RETURN(0)

; Clear the logical edit after it has drained or been invalidated. Screen
; tracking survives until a redraw or the adapter begins a new prompt.
PROC Empty(Session POINTER state)

  state.length=0
  state.position=0
  state.cursor=0
  state.viewStart=0
  state.appendEcho=0

RETURN

; Delete a bounded interval and close the gap; callers choose the new cursor.
PROC Erase(Session POINTER state CARD first,last)
  CARD index

  index=last
  WHILE index<state.length DO
    state.line(first+index-last)=state.line(index)
    index==+1
  OD

  state.length==-(last-first)
  state.appendEcho=0

RETURN

; Discard a damaged input line so partial keystrokes cannot form a command.
PUBLIC PROC Lose(Session POINTER state LONGINT error)

  Empty(state)
  ResetHistory(state)
  state.ready=0
  state.eof=0
  state.error=error
  state.discard=1

RETURN

; Return 1 when editing changed, 2 when acquisition ends, otherwise 0.
PUBLIC BYTE FUNC Feed(Session POINTER state BYTE value)
  CARD index,target

  IF state.ready<>0 OR state.eof<>0 THEN
    RETURN(0)
  FI

  IF state.discard<>0 THEN
    IF value=ASCII.LF OR value=13 THEN
      state.discard=0
      state.ready=1
      RETURN(2)
    FI

    RETURN(0)
  FI

  IF value=KEY_BREAK THEN
    Empty(state)
    ResetHistory(state)
    state.error=ERROR_BREAK
    state.ready=1
    RETURN(2)
  FI

  IF value=KEY_EOF THEN
    ResetHistory(state)
    state.appendEcho=0
    state.eof=1
    state.ready=1
    RETURN(2)
  FI

  IF value=ASCII.LF OR value=13 THEN
    Remember(state)
    ResetHistory(state)
    state.appendEcho=0
    state.line(state.length)=ASCII.LF
    state.length==+1
    state.ready=1
    RETURN(2)
  FI

  IF value=KEY_PREVIOUS OR value=KEY_NEXT THEN
    RETURN(Recall(state,BYTE(value=KEY_PREVIOUS)))
  FI

  target=state.cursor
  IF value=KEY_HOME THEN
    target=0
  ELSEIF value=KEY_END THEN
    target=state.length
  ELSEIF value=KEY_LEFT THEN
    IF target<>0 THEN
      target==-1
    FI
  ELSEIF value=KEY_RIGHT THEN
    IF target<state.length THEN
      target==+1
    FI
  FI

  IF target<>state.cursor THEN
    state.cursor=target
    state.appendEcho=0
    RETURN(1)
  FI

  IF value=KEY_BACKSPACE OR value=KEY_WORD THEN
    IF state.cursor=0 THEN
      RETURN(0)
    FI

    target=state.cursor-1
    IF value=KEY_WORD THEN
      target=state.cursor
      WHILE target<>0 DO
        IF state.line(target-1)<>ASCII.SPACE THEN
          EXIT
        FI

        target==-1
      OD

      WHILE target<>0 DO
        IF state.line(target-1)=ASCII.SPACE THEN
          EXIT
        FI

        target==-1
      OD
    FI

    Erase(state,target,state.cursor)
    state.cursor=target
    RETURN(1)
  FI

  IF value=KEY_CLEAR THEN
    IF state.length=0 THEN
      RETURN(0)
    FI

    Empty(state)
    RETURN(1)
  FI

  IF value=KEY_KILL THEN
    IF state.cursor=state.length THEN
      RETURN(0)
    FI

    state.length=state.cursor
    state.appendEcho=0
    RETURN(1)
  FI

  IF value=KEY_TAB THEN
    value=ASCII.SPACE
  FI

  IF value<ASCII.SPACE OR value>126 THEN
    RETURN(0)
  FI

  IF state.length=LINE_BYTES-1 THEN
    Lose(state,ERROR_LINE_TOO_LONG)
    RETURN(1)
  FI

  index=state.length
  IF state.cursor<>index THEN
    state.appendEcho=0
  FI

  WHILE index>state.cursor DO
    state.line(index)=state.line(index-1)
    index==-1
  OD

  state.line(state.cursor)=value
  state.cursor==+1
  state.length==+1

RETURN(1)

; PENDING is private: the adapter must acquire more input, not return it to DOS.
; error remains readable after a failed drain until the adapter acknowledges it.
PUBLIC LONGINT FUNC Drain(Session POINTER state BYTE POINTER target CARD limit)
  CARD count

  IF limit=0 THEN
    RETURN(0)
  FI

  IF state.ready=0 AND state.eof=0 THEN
    RETURN(PENDING)
  FI

  IF state.error<>0 THEN
    state.ready=0
    RETURN(-1)
  FI

  count=state.length-state.position
  IF count>limit THEN
    count=limit
  FI

  IF count<>0 THEN
    A816MEMORY.Move(target,@state.line(state.position),SIZE(count))
    state.position==+count
    IF state.position=state.length THEN
      Empty(state)
      state.ready=0
    FI

    RETURN(LONGINT(count))
  FI

  state.ready=0
  state.eof=0
  Empty(state)

RETURN(0)

; The cursor follows a bounded viewport. Render uses only Backspace and text,
; preserving the prompt and leaving the last physical column unused.
PUBLIC CARD FUNC Render(Session POINTER state)
  CARD count,index,used,paint,target,maximum
  BYTE POINTER output

  output=state.echo
  count=state.length
  used=0
  IF state.appendEcho<>0 AND state.drawn<>0 AND state.viewStart=0
      AND state.cursor=count AND state.screenCursor=state.drawn
      AND count<=CARD(state.width) AND count>=CARD(state.drawn) THEN
    FOR index=CARD(state.drawn)-1 TO count-1 DO
      output(used)=state.line(index)
      used==+1
    OD

    state.drawn=BYTE(count+1)
    state.screenCursor=state.drawn
    RETURN(used)
  FI

  maximum=0
  IF count>CARD(state.width) THEN
    maximum=count-CARD(state.width)
  FI

  IF state.viewStart>maximum THEN
    state.viewStart=maximum
  FI

  IF state.cursor<state.viewStart THEN
    state.viewStart=state.cursor
  ELSEIF state.cursor>state.viewStart+CARD(state.width) THEN
    state.viewStart=state.cursor-CARD(state.width)
  FI

  IF state.cursor<count AND state.cursor=state.viewStart+CARD(state.width) THEN
    state.viewStart==+1
  FI

  count==-state.viewStart
  IF count>CARD(state.width) THEN
    count=CARD(state.width)
  FI

  index=state.screenCursor
  WHILE index<>0 DO
    output(used)=KEY_BACKSPACE
    used==+1
    index==-1
  OD

  output(used)=IF state.viewStart<>0 THEN 60 ELSE ASCII.SPACE FI
  used==+1
  IF count<>0 THEN
    FOR index=0 TO count-1 DO
      output(used)=state.line(state.viewStart+index)
      used==+1
    OD
  FI

  paint=count+1
  WHILE paint<CARD(state.drawn) DO
    output(used)=ASCII.SPACE
    used==+1
    paint==+1
  OD

  target=1+state.cursor-state.viewStart
  WHILE paint>target DO
    output(used)=KEY_BACKSPACE
    used==+1
    paint==-1
  OD

  state.drawn=BYTE(count+1)
  state.screenCursor=BYTE(target)
  state.appendEcho=state.viewStart=0 AND state.cursor=state.length
      AND state.ready=0 AND state.eof=0 AND state.discard=0

RETURN(used)

ENDMODULE
