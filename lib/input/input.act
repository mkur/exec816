MODULE INPUT
USE EXEC
USE TASKMEMORY
USE EXECPRODUCER
USE INPUTNATIVE
USE INPUTCAPTURE
INCLUDE "input-storage.act.inc"
INCLUDE "input-types.inc"

; Check the complete huge value before conversion or any memory access.
PUBLIC BYTE FUNC Shape(LONGCARD start CARD bytes)

  IF start<$10000 OR start>$ffffff OR (start & 1)<>0 OR bytes=0 THEN
    RETURN(0)
  FI

  IF LONGCARD(bytes)>LONGCARD($10000)-(start & $ffff) THEN
    RETURN(0)
  FI

RETURN(1)

; Lifecycle and diagnostic memory audit. Heap ownership remains the caller's
; obligation in Exec's shared address space.
PUBLIC BYTE FUNC Extent(LONGCARD start CARD bytes)

  IF Shape(start,bytes)=0 THEN
    RETURN(0)
  FI

  LET baseAddress=ADDRESS(start)
  IF TASKMEMORY.Writable(baseAddress,SIZE(bytes))<>0 THEN
    RETURN(1)
  FI

RETURN((EXEC.TypeOfMem(BYTE POINTER(baseAddress)) & EXEC.MEMF_PUBLIC)<>0
    AND (EXEC.TypeOfMem(BYTE POINTER(baseAddress+SIZE(bytes-1)))
    & EXEC.MEMF_PUBLIC)<>0)

BYTE FUNC FilterValid(BYTE value,mask)

RETURN(mask<>0 AND (value & BYTE(mask XOR $ff))=0)

; This pure record check is shared by admission and the emitted bridge probe.
PUBLIC CARD FUNC CheckConfig(Config POINTER config)

  IF Extent(LONGCARD(ADDRESS(config)),CONFIG_BYTES)=0 THEN
    RETURN(BAD_ARGUMENT)
  FI

  IF config.version<>VERSION OR config.reserved<>0 OR config.reserved2<>0
      OR config.wakeMask=0 OR config.filterCount>2
      OR (config.flags & $fe)<>0 THEN
    RETURN(BAD_ARGUMENT)
  FI

  IF config.source=SOURCE_POINTER THEN
    IF (config.filter0Value OR config.filter0Mask OR config.filter1Value
        OR config.filter1Mask OR config.filterCount OR config.flags)<>0 THEN
      RETURN(BAD_ARGUMENT)
    FI

    IF config.pointerProtocol<>POINTER_ST OR config.pointerPort<>1 THEN
      RETURN(UNSUPPORTED)
    FI

    IF config.maxX<0 OR config.maxY<0 OR config.initialX<0
        OR config.initialY<0 OR config.initialX>config.maxX
        OR config.initialY>config.maxY THEN
      RETURN(BAD_ARGUMENT)
    FI

    RETURN(OK)
  FI

  IF config.source<>SOURCE_KEYBOARD THEN
    RETURN(UNSUPPORTED)
  FI

  IF config.pointerProtocol<>0 OR config.pointerPort<>0 OR config.initialX<>0
      OR config.initialY<>0 OR config.maxX<>0 OR config.maxY<>0 THEN
    RETURN(BAD_ARGUMENT)
  FI

  IF config.filterCount=0 THEN
    IF (config.filter0Value OR config.filter0Mask)<>0 THEN
      RETURN(BAD_ARGUMENT)
    FI
  ELSEIF FilterValid(config.filter0Value,config.filter0Mask)=0 THEN
    RETURN(BAD_ARGUMENT)
  FI

  IF config.filterCount<2 THEN
    IF (config.filter1Value OR config.filter1Mask)<>0 THEN
      RETURN(BAD_ARGUMENT)
    FI
  ELSEIF FilterValid(config.filter1Value,config.filter1Mask)=0 THEN
    RETURN(BAD_ARGUMENT)
  FI

RETURN(OK)

INPUTNATIVE.State POINTER FUNC SourceState(CARD source)

  IF source=SOURCE_KEYBOARD THEN
    RETURN(INPUTNATIVE.State POINTER(ADDRESS(IN_STATE)))
  FI

RETURN(INPUTNATIVE.State POINTER(ADDRESS(IN_POINTER_STATE)))

; Existing leases are found by address in fixed descriptors, never by fields
; supplied by the caller. A copied record has no resident authority.
INPUTNATIVE.State POINTER FUNC Shared(Lease POINTER lease)
  CARD source

  ; Free descriptors contain NULL; they are not registrations.
  IF lease=NULL THEN
    RETURN(NULL)
  FI

  FOR source=SOURCE_KEYBOARD TO SOURCE_POINTER DO
    BEGIN
      LET state=SourceState(source)
      IF state.current=BYTE POINTER(lease) THEN
        RETURN(state)
      FI
    END
  OD

RETURN(NULL)

CARD FUNC SourceOf(INPUTNATIVE.State POINTER state)

RETURN(IF ADDRESS(state)=IN_STATE THEN SOURCE_KEYBOARD ELSE SOURCE_POINTER FI)

INPUTNATIVE.Capture POINTER FUNC Capture(INPUTNATIVE.State POINTER state)

  IF SourceOf(state)=SOURCE_KEYBOARD THEN
    RETURN(INPUTNATIVE.Capture POINTER(ADDRESS(IN_CAPTURE)))
  FI

  ; Both native records share the binding/route/notice prefix. Their event
  ; arrays have separate layouts and are accessed through their actual types.
RETURN(INPUTNATIVE.Capture POINTER(ADDRESS(IN_POINTER_CAPTURE)))

; Audit the already resolved registration under Forbid.
BYTE FUNC Valid(Lease POINTER lease INPUTNATIVE.State POINTER state
    INPUTNATIVE.Capture POINTER capture BYTE consumer)

  LET config=Config POINTER(@state.config)
  IF lease.state<>ACTIVE OR lease.acquisition<>state.generation
      OR lease.flags<>0 OR lease.reserved<>0
      OR lease.owner.identity<>ADDRESS(@lease.owner)
      OR lease.owner.task=NULL OR lease.owner.task<>EXEC.Task POINTER(capture.binding.task)
      OR lease.owner.incarnation<>state.ownerIncarnation
      OR lease.owner.pad<>0 OR lease.owner.pad2<>0
      OR lease.wakeMask<>config.wakeMask OR lease.route<>capture.route THEN
    RETURN(0)
  FI

  IF consumer<>0 THEN
    RETURN(lease.owner.task=EXEC.FindTask(NULL))
  FI

RETURN(1)

BYTE FUNC RouteValid(INPUTNATIVE.State POINTER state LONGCARD tag)

RETURN(tag<>0 AND state.tags(BYTE(tag & 15))=tag)

; Published tags and retained notices/records forbid slot reuse.
BYTE FUNC Referenced(INPUTNATIVE.State POINTER state
    INPUTNATIVE.Capture POINTER capture LONGCARD tag)
  CARD bit
  BYTE index,head

  IF capture.route=tag THEN
    RETURN(1)
  FI

  bit=CARD(1) LSH BYTE(tag & 15)
  IF ((capture.breakMask OR capture.lostMask) & bit)<>0 THEN
    RETURN(1)
  FI

  IF SourceOf(state)=SOURCE_POINTER THEN
    BEGIN
      LET hardware=INPUTNATIVE.PointerCapture POINTER(ADDRESS(IN_POINTER_CAPTURE))
      IF hardware.pending<>0 AND hardware.output.route=tag THEN
        RETURN(1)
      FI

      head=hardware.head
      index=hardware.tail
      WHILE index<>head DO
        IF hardware.events(index & 31).kind<>255
            AND hardware.events(index & 31).route=tag THEN
          RETURN(1)
        FI

        index==+1
      OD

      RETURN(0)
    END
  FI

  head=capture.head
  index=capture.tail
  WHILE index<>head DO
    IF capture.events(index & 63).kind<>255
        AND capture.events(index & 63).route=tag THEN
      RETURN(1)
    FI

    index==+1
  OD

RETURN(0)

PUBLIC CARD FUNC Acquire(Lease POINTER lease Config POINTER config)
  CARD status,index
  BYTE ignored
  BYTE POINTER bytes

  IF Extent(LONGCARD(ADDRESS(lease)),LEASE_BYTES)=0 THEN
    RETURN(BAD_ARGUMENT)
  FI

  status=CheckConfig(config)
  IF status<>OK THEN
    RETURN(status)
  FI

  EXEC.Forbid()
  LET state=SourceState(config.source)
  LET capture=Capture(state)
  IF state.current<>NULL OR capture.binding.context<>NULL THEN
    EXEC.Permit()
    RETURN(BUSY)
  FI

  bytes=BYTE POINTER(lease)
  FOR index=0 TO LEASE_BYTES-1 DO
    IF bytes(index)<>0 THEN
      EXEC.Permit()
      RETURN(INVALID_OWNER)
    FI
  OD

  LET self=EXEC.FindTask(NULL)
  IF (self.tc_SigAlloc & config.wakeMask)<>config.wakeMask THEN
    EXEC.Permit()
    RETURN(BAD_ARGUMENT)
  FI

  LET acquisitions=LONGCARD POINTER(ADDRESS(IN_ACQUISITIONS))
  IF acquisitions^=$ffffffff THEN
    EXEC.Permit()
    RETURN(EXHAUSTED)
  FI

  IF EXEC.RetainTask(self,@lease.owner)=0 THEN
    EXEC.Permit()
    RETURN(NO_MEMORY)
  FI

  state.ownerIncarnation=lease.owner.incarnation
  acquisitions^=acquisitions^+1
  state.generation=acquisitions^
  lease.acquisition=state.generation
  lease.wakeMask=config.wakeMask
  lease.state=ACQUIRING
  state.current=BYTE POINTER(lease)
  bytes=BYTE POINTER(config)
  FOR index=0 TO CONFIG_BYTES-1 DO
    state.config(index)=bytes(index)
  OD

  IF config.source=SOURCE_KEYBOARD THEN
    INPUTCAPTURE.Publish(0)
  FI

  IF EXECPRODUCER.Bind(config.source,self,lease.wakeMask)=0 THEN
    state.current=NULL
    ignored=EXEC.ReleaseTask(@lease.owner)
    bytes=BYTE POINTER(lease)
    FOR index=0 TO LEASE_BYTES-1 DO
      bytes(index)=0
    OD

    EXEC.Permit()
    RETURN(BUSY)
  FI

  lease.state=ACTIVE
  EXEC.Permit()

RETURN(OK)

PUBLIC CARD FUNC CreateRoute(Lease POINTER lease CARD flags
    LONGCARD POINTER tag)
  BYTE slot

  IF Extent(LONGCARD(ADDRESS(lease)),LEASE_BYTES)=0
      OR Extent(LONGCARD(ADDRESS(tag)),4)=0 OR flags<>0 THEN
    RETURN(BAD_ARGUMENT)
  FI

  EXEC.Forbid()
  LET state=Shared(lease)
  IF state=NULL THEN
    EXEC.Permit()
    RETURN(INVALID_OWNER)
  FI

  LET capture=Capture(state)
  IF Valid(lease,state,capture,0)=0 THEN
    EXEC.Permit()
    RETURN(INVALID_OWNER)
  FI

  IF state.epoch=$0fffffff THEN
    EXEC.Permit()
    RETURN(EXHAUSTED)
  FI

  FOR slot=0 TO ROUTE_SLOTS-1 DO
    IF state.tags(slot)=0 THEN
      state.epoch==+1
      state.tags(slot)=(state.epoch LSH 4) OR LONGCARD(slot)
      tag^=state.tags(slot)
      EXEC.Permit()
      RETURN(OK)
    FI
  OD

  EXEC.Permit()

RETURN(BUSY)

PUBLIC CARD FUNC PublishRoute(Lease POINTER lease LONGCARD tag)

  IF Extent(LONGCARD(ADDRESS(lease)),LEASE_BYTES)=0 THEN
    RETURN(BAD_ARGUMENT)
  FI

  EXEC.Forbid()
  LET state=Shared(lease)
  IF state=NULL THEN
    EXEC.Permit()
    RETURN(INVALID_OWNER)
  FI

  LET capture=Capture(state)
  IF Valid(lease,state,capture,0)=0 THEN
    EXEC.Permit()
    RETURN(INVALID_OWNER)
  FI

  IF tag<>0 AND RouteValid(state,tag)=0 THEN
    EXEC.Permit()
    RETURN(BAD_ARGUMENT)
  FI

  IF SourceOf(state)=SOURCE_POINTER THEN
    INPUTCAPTURE.PointerPublish(tag)
  ELSE
    INPUTCAPTURE.Publish(tag)
  FI
  lease.route=tag
  EXEC.Permit()

RETURN(OK)

PUBLIC CARD FUNC RetireRoute(Lease POINTER lease LONGCARD tag)

  IF Extent(LONGCARD(ADDRESS(lease)),LEASE_BYTES)=0 THEN
    RETURN(BAD_ARGUMENT)
  FI

  EXEC.Forbid()
  LET state=Shared(lease)
  IF state=NULL THEN
    EXEC.Permit()
    RETURN(INVALID_OWNER)
  FI

  LET capture=Capture(state)
  IF Valid(lease,state,capture,0)=0 THEN
    EXEC.Permit()
    RETURN(INVALID_OWNER)
  FI

  IF RouteValid(state,tag)=0 THEN
    EXEC.Permit()
    RETURN(BAD_ARGUMENT)
  FI

  IF Referenced(state,capture,tag)<>0 THEN
    EXEC.Permit()
    RETURN(BUSY)
  FI

  state.tags(BYTE(tag & 15))=0
  EXEC.Permit()

RETURN(OK)

PUBLIC CARD FUNC Discard(Lease POINTER lease LONGCARD tag)

  IF Extent(LONGCARD(ADDRESS(lease)),LEASE_BYTES)=0 THEN
    RETURN(BAD_ARGUMENT)
  FI

  EXEC.Forbid()
  LET state=Shared(lease)
  IF state=NULL THEN
    EXEC.Permit()
    RETURN(INVALID_OWNER)
  FI

  LET capture=Capture(state)
  IF Valid(lease,state,capture,0)=0 THEN
    EXEC.Permit()
    RETURN(INVALID_OWNER)
  FI

  IF RouteValid(state,tag)=0 THEN
    EXEC.Permit()
    RETURN(BAD_ARGUMENT)
  FI

  IF SourceOf(state)=SOURCE_POINTER THEN
    INPUTCAPTURE.PointerDiscard(tag)
  ELSE
    INPUTCAPTURE.Discard(tag)
  FI
  EXEC.Permit()

RETURN(OK)

PUBLIC CARD FUNC Pending(Lease POINTER lease CARD POINTER mask)
  CARD value

  IF Extent(LONGCARD(ADDRESS(lease)),LEASE_BYTES)=0
      OR Extent(LONGCARD(ADDRESS(mask)),2)=0 THEN
    RETURN(BAD_ARGUMENT)
  FI

  EXEC.Forbid()
  LET state=Shared(lease)
  IF state=NULL THEN
    EXEC.Permit()
    RETURN(INVALID_OWNER)
  FI

  LET capture=Capture(state)
  IF Valid(lease,state,capture,0)=0 THEN
    EXEC.Permit()
    RETURN(INVALID_OWNER)
  FI

  value=0
  IF capture.head<>capture.tail THEN
    value=value OR PENDING_DATA
  FI

  IF capture.lostMask<>0 THEN
    value=value OR PENDING_LOSS
  FI

  IF capture.breakMask<>0 THEN
    value=value OR PENDING_CANCEL
  FI

  IF SourceOf(state)=SOURCE_POINTER THEN
    BEGIN
      LET hardware=INPUTNATIVE.PointerCapture POINTER(ADDRESS(IN_POINTER_CAPTURE))
      IF hardware.pending<>0 THEN
        value=value OR PENDING_DATA
      FI
    END
  FI

  mask^=value
  EXEC.Permit()

RETURN(OK)

; Difference is unsigned after ordering signed endpoints. This avoids signed
; overflow even at opposite extremes. An unrepresentable distance is loss.
BYTE FUNC PointerDeltaValid(LONGINT current,previous)

  IF current>=previous THEN
    RETURN(LONGCARD(current)-LONGCARD(previous)<=$7fffffff)
  FI

RETURN(LONGCARD(previous)-LONGCARD(current)<=$7fffffff)

INT FUNC PointerCoordinate(INT position,maximum LONGINT current,previous)
  LONGCARD distance

  IF current>=previous THEN
    distance=LONGCARD(current)-LONGCARD(previous)
    IF distance>LONGCARD(maximum-position) THEN
      RETURN(maximum)
    FI

    RETURN(position+INT(distance))
  FI

  distance=LONGCARD(previous)-LONGCARD(current)
  IF distance>LONGCARD(position) THEN
    RETURN(0)
  FI

RETURN(position-INT(distance))

CARD FUNC PointerRead(Lease POINTER lease INPUTNATIVE.State POINTER state
    Event POINTER event)
  INPUTNATIVE.PointerSample sample
  CARD status,index,oldButtons
  BYTE baseline,moved

  LET hardware=INPUTNATIVE.PointerCapture POINTER(ADDRESS(IN_POINTER_CAPTURE))
  LET config=Config POINTER(@state.config)
  FOR index=0 TO INPUTNATIVE.POINTER_SLOTS DO
    status=INPUTCAPTURE.PointerTake(BYTE POINTER(@sample))
    IF status=0 THEN
      RETURN(EMPTY)
    FI

    IF status=3 THEN
      BEGIN
        LET destination=BYTE POINTER(event)
        LET sourceBytes=BYTE POINTER(@sample)
        FOR index=0 TO EVENT_BYTES-1 DO
          destination(index)=sourceBytes(index)
        OD
      END
      RETURN(OK)
    FI

    IF status<>4 AND sample.acquisition=lease.acquisition THEN
      EXIT
    FI
  OD

  IF status=4 OR sample.acquisition<>lease.acquisition THEN
    RETURN(EMPTY)
  FI

  event.acquisition=sample.acquisition
  event.route=sample.route
  event.tick=sample.tick
  event.kind=EVENT_POINTER
  event.flags=TICK_VALID
  event.code=0
  event.qualifiers=0
  event.reserved=0
  oldButtons=hardware.previousButtons
  baseline=(sample.flags & INPUTNATIVE.POINTER_BASELINE)<>0
      OR hardware.consumedRoute<>sample.route
  IF status<>2 AND baseline=0 THEN
    IF PointerDeltaValid(sample.xCount,hardware.consumedX)=0
        OR PointerDeltaValid(sample.yCount,hardware.consumedY)=0 THEN
      ; Establish the same native boundary used by raw overflow. No signed
      ; subtraction has occurred and no ordinary output can cross it.
      INPUTCAPTURE.PointerDiscard(sample.route)
      RETURN(PointerRead(lease,state,event))
    FI

    hardware.x=PointerCoordinate(hardware.x,config.maxX,
        sample.xCount,hardware.consumedX)
    hardware.y=PointerCoordinate(hardware.y,config.maxY,
        sample.yCount,hardware.consumedY)
  FI

  moved=sample.xCount<>hardware.consumedX OR sample.yCount<>hardware.consumedY
  IF status<>2 OR hardware.consumedRoute=sample.route THEN
    hardware.consumedX=sample.xCount
    hardware.consumedY=sample.yCount
    hardware.consumedEpoch=sample.epoch
    hardware.consumedRoute=sample.route
    hardware.previousButtons=CARD(sample.buttons)
  FI
  event.x=hardware.x
  event.y=hardware.y
  event.buttons=CARD(sample.buttons)
  IF status=2 THEN
    event.kind=EVENT_LOSS
    event.flags=0
    event.tick=0
    event.code=CARD(sample.kind)
  ELSEIF baseline=0 AND CARD(sample.buttons)<>oldButtons THEN
    event.kind=EVENT_BUTTON
    event.code=LEFT
    IF moved<>0 THEN
      BEGIN
        LET destination=BYTE POINTER(@hardware.output)
        LET sourceBytes=BYTE POINTER(event)
        FOR index=0 TO EVENT_BYTES-1 DO
          destination(index)=sourceBytes(index)
        OD
      END
      hardware.pendingEpoch=sample.epoch
      hardware.pending=1
      event.kind=EVENT_POINTER
      event.code=0
      event.buttons=oldButtons
    FI
  FI

RETURN(OK)

PUBLIC CARD FUNC Take(Lease POINTER lease Event POINTER event)
  LONGCARD raw
  CARD code,index
  BYTE kind,flags

  IF Extent(LONGCARD(ADDRESS(lease)),LEASE_BYTES)=0
      OR Extent(LONGCARD(ADDRESS(event)),EVENT_BYTES)=0 THEN
    RETURN(BAD_ARGUMENT)
  FI

  EXEC.Forbid()
  LET state=Shared(lease)
  IF state=NULL THEN
    EXEC.Permit()
    RETURN(INVALID_OWNER)
  FI

  LET capture=Capture(state)
  IF Valid(lease,state,capture,1)=0 THEN
    EXEC.Permit()
    RETURN(INVALID_OWNER)
  FI

  IF SourceOf(state)=SOURCE_POINTER THEN
    code=PointerRead(lease,state,event)
    EXEC.Permit()
    RETURN(code)
  FI

  flags=0
  raw=INPUTCAPTURE.TakeBreak()
  IF raw<>0 THEN
    kind=EVENT_CANCEL
    code=CARD(raw)
  ELSE
    index=0
    DO
      raw=INPUTCAPTURE.Take()
      IF raw=$ffffffff THEN
        EXEC.Permit()
        RETURN(EMPTY)
      FI

      index==+1
    UNTIL raw=$fffffffe OR BYTE(raw RSH 8)<>255 OR index=RAW_SLOTS
    OD

    IF raw=$fffffffe THEN
      kind=EVENT_LOSS
      code=CARD(capture.padding(0))
    ELSEIF BYTE(raw RSH 8)=255 THEN
      EXEC.Permit()
      RETURN(EMPTY)
    ELSE
      kind=EVENT_KEY
      flags=TICK_VALID
      code=CARD(BYTE(raw))
    FI
  FI

  event.acquisition=lease.acquisition
  event.route=capture.takenRoute
  event.tick=0
  event.kind=kind
  event.flags=flags
  event.code=code
  event.qualifiers=0
  event.x=0
  event.y=0
  event.buttons=0
  event.reserved=0
  IF kind=EVENT_KEY THEN
    event.tick=CARD(raw RSH 16)
    event.qualifiers=(code RSH 6) & 3
  FI

  EXEC.Permit()

RETURN(OK)

PUBLIC CARD FUNC Release(Lease POINTER lease)
  BYTE ignored,index
  BYTE POINTER bytes

  IF Extent(LONGCARD(ADDRESS(lease)),LEASE_BYTES)=0 THEN
    RETURN(BAD_ARGUMENT)
  FI

  EXEC.Forbid()
  LET state=Shared(lease)
  IF state=NULL THEN
    EXEC.Permit()
    RETURN(INVALID_OWNER)
  FI

  LET capture=Capture(state)
  IF Valid(lease,state,capture,1)=0 THEN
    EXEC.Permit()
    RETURN(INVALID_OWNER)
  FI

  lease.state=RELEASING
  LET source=SourceOf(state)
  IF source=SOURCE_KEYBOARD THEN
    INPUTCAPTURE.Publish(0)
  FI

  EXECPRODUCER.Release(source)
  EXECPRODUCER.Drain(source)
  FOR index=0 TO ROUTE_SLOTS-1 DO
    state.tags(index)=0
    state.cancelCode(index)=0
    state.lossCode(index)=0
  OD

  ignored=EXEC.ReleaseTask(@lease.owner)
  bytes=BYTE POINTER(lease)
  FOR index=0 TO LEASE_BYTES-1 DO
    bytes(index)=0
  OD

  state.current=NULL
  state.ownerIncarnation=0
  EXEC.Permit()

RETURN(OK)

ENDMODULE
