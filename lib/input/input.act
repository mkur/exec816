MODULE INPUT
USE EXEC
USE TASKMEMORY
INCLUDE "input-types.inc"

; Validate full huge values before conversion. Records cannot straddle a bank,
; enter bank zero, or address absent/read-only memory. Heap ownership remains
; the caller's obligation in Exec's shared address space.
PUBLIC BYTE FUNC Extent(LONGCARD start CARD bytes)

  IF start<$10000 OR start>$ffffff OR (start & 1)<>0 OR bytes=0 THEN
    RETURN(0)
  FI

  IF LONGCARD(bytes)>LONGCARD($10000)-(start & $ffff) THEN
    RETURN(0)
  FI

  LET baseAddress=ADDRESS(start)
  IF TASKMEMORY.Writable(baseAddress,SIZE(bytes))<>0 THEN
    RETURN(1)
  FI

RETURN((EXEC.TypeOfMem(BYTE POINTER(baseAddress)) & EXEC.MEMF_PUBLIC)<>0
    AND (EXEC.TypeOfMem(BYTE POINTER(baseAddress+SIZE(bytes-1)))
    & EXEC.MEMF_PUBLIC)<>0)

BYTE FUNC FilterValid(BYTE value,mask)

RETURN(mask<>0 AND (value & BYTE(mask XOR $ff))=0)

; This pure record check is shared by admission and the emitted bridge probe.
PUBLIC CARD FUNC CheckConfig(Config POINTER config)

  IF Extent(LONGCARD(ADDRESS(config)),CONFIG_BYTES)=0 THEN
    RETURN(BAD_ARGUMENT)
  FI

  IF config.version<>VERSION OR config.reserved<>0 OR config.wakeMask=0
      OR config.filterCount>2 OR (config.flags & $fe)<>0 THEN
    RETURN(BAD_ARGUMENT)
  FI

  IF config.source<>SOURCE_KEYBOARD THEN
    RETURN(UNSUPPORTED)
  FI

  IF config.filterCount=0 THEN
    IF (config.filter0Value OR config.filter0Mask)<>0 THEN
      RETURN(BAD_ARGUMENT)
    FI
  ELSEIF FilterValid(config.filter0Value,config.filter0Mask)=0 THEN
    RETURN(BAD_ARGUMENT)
  FI

  IF config.filterCount<2 THEN
    IF (config.filter1Value OR config.filter1Mask)<>0 THEN
      RETURN(BAD_ARGUMENT)
    FI
  ELSEIF FilterValid(config.filter1Value,config.filter1Mask)=0 THEN
    RETURN(BAD_ARGUMENT)
  FI

RETURN(OK)

; I1 establishes records and checked calling conventions only. Until I3 adds
; the capture owner, every well-formed runtime operation reports UNSUPPORTED.
PUBLIC CARD FUNC Acquire(Lease POINTER lease Config POINTER config)

  IF Extent(LONGCARD(ADDRESS(lease)),LEASE_BYTES)=0 THEN
    RETURN(BAD_ARGUMENT)
  FI

  LET status=CheckConfig(config)
  IF status<>OK THEN
    RETURN(status)
  FI

RETURN(UNSUPPORTED)

PUBLIC CARD FUNC CreateRoute(Lease POINTER lease CARD flags
    LONGCARD POINTER tag)

  IF Extent(LONGCARD(ADDRESS(lease)),LEASE_BYTES)=0
      OR Extent(LONGCARD(ADDRESS(tag)),4)=0 OR flags<>0 THEN
    RETURN(BAD_ARGUMENT)
  FI

RETURN(UNSUPPORTED)

PUBLIC CARD FUNC PublishRoute(Lease POINTER lease LONGCARD tag)

  IF Extent(LONGCARD(ADDRESS(lease)),LEASE_BYTES)=0 THEN
    RETURN(BAD_ARGUMENT)
  FI

RETURN(UNSUPPORTED)

PUBLIC CARD FUNC RetireRoute(Lease POINTER lease LONGCARD tag)

RETURN(PublishRoute(lease,tag))

PUBLIC CARD FUNC Discard(Lease POINTER lease LONGCARD tag)

RETURN(PublishRoute(lease,tag))

PUBLIC CARD FUNC Pending(Lease POINTER lease CARD POINTER mask)

  IF Extent(LONGCARD(ADDRESS(lease)),LEASE_BYTES)=0
      OR Extent(LONGCARD(ADDRESS(mask)),2)=0 THEN
    RETURN(BAD_ARGUMENT)
  FI

RETURN(UNSUPPORTED)

PUBLIC CARD FUNC Take(Lease POINTER lease Event POINTER event)

  IF Extent(LONGCARD(ADDRESS(lease)),LEASE_BYTES)=0
      OR Extent(LONGCARD(ADDRESS(event)),EVENT_BYTES)=0 THEN
    RETURN(BAD_ARGUMENT)
  FI

RETURN(UNSUPPORTED)

PUBLIC CARD FUNC Release(Lease POINTER lease)

RETURN(PublishRoute(lease,0))

ENDMODULE
