; Capture adapter is connected in IM3. The generic service can run without it.
MODULE INPUTDEVICESOURCE
USE INPUT
USE INPUTDEVICESTATE AS STATE

PUBLIC CONST CAPABILITIES=0

PUBLIC CARD FUNC Open(STATE.Source POINTER source)

RETURN(INPUT.UNSUPPORTED)

PUBLIC CARD FUNC Close(STATE.Source POINTER source)

RETURN(INPUT.OK)

PUBLIC CARD FUNC Take(STATE.Source POINTER source)

RETURN(INPUT.EMPTY)

ENDMODULE
