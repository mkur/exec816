; The input Task owns hardware acquisition, consumption and safe release.
MODULE INPUTDEVICESOURCE
USE INPUT
USE INPUTDEVICESTATE AS STATE

PUBLIC CONST CAPABILITIES=1

PUBLIC CARD FUNC Open(STATE.Source POINTER source)

  IF source.config.source<>INPUT.SOURCE_KEYBOARD THEN
    RETURN(INPUT.UNSUPPORTED)
  FI

RETURN(INPUT.Acquire(@source.lease,@source.config))

PUBLIC CARD FUNC Close(STATE.Source POINTER source)

RETURN(INPUT.Release(@source.lease))

PUBLIC CARD FUNC Take(STATE.Source POINTER source)

RETURN(INPUT.Take(@source.lease,@source.event))

ENDMODULE
