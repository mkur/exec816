; Copy published runtime mounts without starting the service or doing disk I/O.
MODULE FSINSPECT
USE EXEC
USE DOSCORE
USE FSTYPES
USE FSREGISTRY
USE BOOTCONFIG
USE A816MEMORY
PUBLIC CONST CAPACITY=9

PUBLIC TYPE Info=[
  BYTE ARRAY name(32)
  BYTE offline,format,readOnly,requestedAccess,backend,unit
  LONGINT error
]

PUBLIC TYPE Failure=[
  BYTE ARRAY name(32)
  LONGINT error
  LONGCARD sectors
  CARD bytes
  BYTE slot,stage,backend,unit
]

; The registry retains failed mount identity after the worker frees its state.
PUBLIC BYTE FUNC LastFailure(Failure POINTER info)
  BYTE present,index,value

  EXEC.Forbid()
  LET registry=DOSCORE.GetRegistry()
  A816MEMORY.Clear(BYTE POINTER(info),SIZEOF(Failure))
  info.error=registry.mountError
  info.stage=registry.mountStage
  info.slot=registry.mountSlot
  present=info.error<>0
  IF present<>0 AND info.slot<registry.count THEN
    BEGIN
      LET specs=FSTYPES.Spec POINTER(registry.config)
      LET spec=@specs(info.slot)
      index=0
      WHILE index<31 DO
        value=spec.alias(index)
        IF value=0 THEN
          EXIT
        FI

        info.name(index)=IF value<32 OR value>126 THEN 46 ELSE value FI
        index==+1
      OD

      info.sectors=spec.sectors
      info.bytes=spec.dataBytes
      info.backend=spec.backend
      info.unit=BYTE(spec.unit)
    END
  FI

  EXEC.Permit()

RETURN(present)

PUBLIC TYPE CacheInfo=[
  CARD requested,blocks
  LONGCARD hits,misses,evictions
]

; Diagnostics borrow no cache storage and never start the filesystem service.
PUBLIC BYTE FUNC CacheStatus(CacheInfo POINTER info)
  BYTE ready

  IF info=NULL THEN
    RETURN(0)
  FI

  LET registry=DOSCORE.GetRegistry()
  ready=0
  EXEC.Forbid()
  IF registry.state=FSTYPES.STATE_READY AND registry.stop=0
      AND registry.runtime<>NULL THEN
    BEGIN
      LET service=FSTYPES.Service POINTER(registry.runtime)
      IF service.adapter=NULL THEN
        EXEC.Permit()
        RETURN(0)
      FI

      LET cache=@service.adapter.cache
      info.requested=cache.requested
      info.blocks=cache.blocks
      info.hits=cache.hits
      info.misses=cache.misses
      info.evictions=cache.evictions
      ready=1
    END
  FI

  EXEC.Permit()

RETURN(ready)

; Copy mount diagnostics while protecting the registry's published identities.
PUBLIC CARD FUNC Snapshot(Info POINTER rows CARD limit)
  DOSCORE.DosRegistry POINTER registry
  FSTYPES.Service POINTER service
  FSTYPES.Mount POINTER mount
  CARD count
  BYTE slot,index,value

  IF rows=Info POINTER(0) OR limit<CAPACITY THEN
    RETURN(0)
  FI

  registry=DOSCORE.GetRegistry()
  count=0
  EXEC.Forbid()
  ; Starting/failed services have no published mounts. During shutdown their
  ; allocations may already be retiring, so never follow those pointers.
  IF registry.state=FSTYPES.STATE_READY AND registry.stop=0
      AND registry.runtime<>BYTE POINTER(0) THEN
    service=FSTYPES.Service POINTER(registry.runtime)
    IF service.count<>0 THEN
      FOR slot=0 TO service.count-1 DO
        mount=service.mounts(slot).item
        IF mount<>FSTYPES.Mount POINTER(0) THEN
          IF mount.published<>0 THEN
            index=0
            WHILE index<31 DO
              value=mount.spec.alias(index)
              IF value=0 THEN
                EXIT
              FI

              IF value<32 OR value>126 THEN
                value=46
              FI

              rows(count).name(index)=value
              index==+1
            OD

            rows(count).name(index)=0
            rows(count).offline=mount.offline
            rows(count).format=mount.spec.format
            rows(count).readOnly=mount.writable=0
            rows(count).requestedAccess=mount.spec.access
            rows(count).backend=mount.spec.backend
            rows(count).unit=BYTE(mount.spec.unit)
            rows(count).error=mount.error
            count==+1
          FI
        FI
      OD
    FI
  FI

  EXEC.Permit()

RETURN(count)

PUBLIC BYTE FUNC SystemWritable()
  BYTE writable

  writable=0
  LET registry=DOSCORE.GetRegistry()
  EXEC.Forbid()
  IF registry.state=FSTYPES.STATE_READY AND registry.runtime<>NULL
      AND BOOTCONFIG.B_SYSTEM_SLOT<>255 THEN
    BEGIN
      LET service=FSTYPES.Service POINTER(registry.runtime)
      LET mount=service.mounts(BOOTCONFIG.B_SYSTEM_SLOT).item
      IF mount<>NULL THEN
        writable=mount.writable
      FI
    END
  FI

  EXEC.Permit()

RETURN(writable)

ENDMODULE
