MODULE FSINIT
USE FSSTATUS
USE EXEC
USE A816MEMORY
USE EXECLISTS
USE DOSCORE
USE FSTYPES
USE FSPACKET
USE HEAPCORE
USE FSNAMES
USE FSREGISTRY
USE FSSYSTEM
USE BOOTCONFIG
USE FS83
USE FSPORTS
USE BLOCKIO
USE BLOCKTYPES
USE FSBACKEND
USE FSBTYPES
USE FSWTYPES
USE FSFORMATS
USE FSDISCOVER
USE FSOPERATION
USE FSACTIVE
INCLUDE "../dos/dos-types.inc"

; Reject conflicting mount descriptors before allocating or opening devices.
BYTE FUNC Config(FSTYPES.Service POINTER service)
  BYTE index,other

  LET registry=DOSCORE.GetRegistry()
  LET specs=FSTYPES.Spec POINTER(registry.config)
  IF registry.count<>9 OR registry.bootCount>9 OR
      (BOOTCONFIG.B_SYSTEM_SLOT<>255
          AND BOOTCONFIG.B_SYSTEM_SLOT>=registry.bootCount) THEN
    service.error=ERROR_DEVICE_NOT_MOUNTED
    RETURN(0)
  FI

  service.count=registry.count
  FOR index=0 TO service.count-1 DO
    IF FSREGISTRY.Enabled(index)<>0 THEN
      BEGIN
        LET spec=@specs(index)
        IF FSNAMES.ValidAlias(spec.alias)=0 THEN
          service.error=ERROR_BAD_STREAM_NAME
          RETURN(0)
        FI

        IF spec.access>1 THEN
          service.error=ERROR_BAD_NUMBER
          RETURN(0)
        FI

        IF FSSYSTEM.Selected(index)<>0 AND
            spec.backend=BLOCKTYPES.BACKEND_SIO THEN
          ; The immutable descriptor must still match the packaged physical drive.
          IF spec.unit<>48+BOOTCONFIG.B_DEFAULT_DRIVE OR
              FS83.Fold(spec.alias(0))<>'D OR
              spec.alias(1)<>'0+BOOTCONFIG.B_DEFAULT_DRIVE
                  OR spec.alias(2)<>0 THEN
            service.error=ERROR_BAD_NUMBER
            RETURN(0)
          FI
        FI

        IF FSBACKEND.Available(spec.format)=0 THEN
          service.error=ERROR_NOT_A_DOS_DISK
          RETURN(0)
        FI

        LET unit=FSSYSTEM.Unit(spec,index)
        IF spec.backend=BLOCKTYPES.BACKEND_IDEPLUS THEN
          IF spec.format<>FSFORMATS.SDFS THEN
            service.error=ERROR_NOT_A_DOS_DISK
            RETURN(0)
          FI
        FI
        IF spec.format=FSFORMATS.RAM THEN
          IF FS83.Fold(spec.alias(0))<>'R OR FS83.Fold(spec.alias(1))<>'A OR
              FS83.Fold(spec.alias(2))<>'M OR spec.alias(3)<>0 OR
              spec.unit<>0 OR spec.profile<>0 OR spec.sectors<>0 OR
              spec.dataBytes<>0 OR spec.boot<>0 OR spec.access<>1 OR spec.backend<>0 OR
              FSSYSTEM.Selected(index)<>0 THEN
            service.error=ERROR_BAD_NUMBER
            RETURN(0)
          FI
        ELSEIF spec.sectors=0 AND spec.dataBytes=0 THEN
          IF spec.backend<>BLOCKTYPES.BACKEND_SIO OR spec.boot<>1 OR
              unit<49 OR unit>56 OR (spec.profile<>EXEC.SIO_PROFILE_FASTEST125
                  AND spec.profile<>EXEC.SIO_PROFILE_STOCK810
                  AND spec.profile<>EXEC.SIO_PROFILE_GENERIC57600) THEN
            service.error=ERROR_BAD_NUMBER
            RETURN(0)
          FI
        ELSEIF BLOCKIO.Geometry(spec.backend,unit,spec.profile,
            spec.sectors,spec.dataBytes,spec.boot,1)=0 THEN
          service.error=ERROR_BAD_NUMBER
          RETURN(0)
        FI

        other=0
        WHILE other<index DO
          IF FSREGISTRY.Enabled(other)<>0 AND
              ((unit<>0 AND specs(other).backend=spec.backend AND
              FSSYSTEM.Unit(@specs(other),other)=unit) OR
              FSSYSTEM.SameName(@specs(other),spec,other,index)<>0) THEN
            service.error=ERROR_OBJECT_IN_USE
            RETURN(0)
          FI

          other==+1
        OD
      END
    FI
  OD

RETURN(1)

; Allocate the worker's shared parsing state; Cleanup owns partial failure.
BYTE FUNC Workspace(FSTYPES.Service POINTER service)
  BYTE index,writable

  service.work=FSBTYPES.Workspace POINTER(EXEC.AllocMem(SIZEOF(
      FSBTYPES.Workspace),EXEC.MEMF_UPPER OR EXEC.MEMF_CLEAR))
  IF service.work=FSBTYPES.Workspace POINTER(0) THEN
    RETURN(0)
  FI

  service.operation=FSBTYPES.Operation POINTER(EXEC.AllocMem(SIZEOF(
      FSBTYPES.Operation),EXEC.MEMF_UPPER OR EXEC.MEMF_CLEAR))
  IF service.operation=FSBTYPES.Operation POINTER(0) THEN
    RETURN(0)
  FI

  IF service.adapter<>NULL AND FSBACKEND.CreateWork(service.work)=0 THEN
    RETURN(0)
  FI

  LET registry=DOSCORE.GetRegistry()
  LET specs=FSTYPES.Spec POINTER(registry.config)
  writable=0
  FOR index=0 TO service.count-1 DO
    IF FSREGISTRY.Enabled(index)<>0 AND specs(index).format<>FSFORMATS.RAM THEN
      writable=writable OR specs(index).access
    FI
  OD

  IF writable<>0 THEN
    service.mutation=EXEC.AllocMem(SIZEOF(FSWTYPES.State),
        EXEC.MEMF_UPPER OR EXEC.MEMF_CLEAR)
    IF service.mutation=NULL THEN
      RETURN(0)
    FI
  FI

  service.operation.work=service.work

RETURN(1)

; Acquire disk resources only when this mount needs them.
PUBLIC BYTE FUNC MountResources(FSTYPES.Service POINTER service
    FSTYPES.Spec POINTER spec)

  service.newResources=0
  IF spec.format=FSFORMATS.RAM THEN
    RETURN(1)
  FI

  IF service.adapter=NULL THEN
    service.adapter=BLOCKIO.Create()
    IF service.adapter=NULL THEN
      RETURN(0)
    FI

    service.newResources=1
    IF FSBACKEND.CreateWork(service.work)=0 THEN
      RETURN(0)
    FI
  FI

  IF spec.access<>0 AND service.mutation=NULL THEN
    service.mutation=EXEC.AllocMem(SIZEOF(FSWTYPES.State),
        EXEC.MEMF_UPPER OR EXEC.MEMF_CLEAR)
    IF service.mutation=NULL THEN
      RETURN(0)
    FI

    service.newResources=service.newResources OR 2
  FI

RETURN(1)

; Failed admission releases only resources acquired for that candidate.
PUBLIC PROC RollbackResources(FSTYPES.Service POINTER service)

  IF (service.newResources & 2)<>0 THEN
    EXEC.FreeMem(service.mutation,SIZEOF(FSWTYPES.State))
    service.mutation=NULL
  FI

  IF (service.newResources & 1)<>0 THEN
    FSBACKEND.DestroyWork(service.work)
    IF BLOCKIO.Destroy(service.adapter)=0 THEN
      HEAPCORE.Abort($ff94)
    FI

    service.adapter=NULL
  FI

  service.newResources=0

RETURN

; Reserve the worker's request/cancellation signals and management port.
BYTE FUNC Arrival(FSTYPES.Service POINTER service)
  DOSCORE.DosRegistry POINTER registry

  service.arrival=EXEC.AllocSignal(-1)
  IF service.arrival=255 THEN
    RETURN(0)
  FI

  registry=DOSCORE.GetRegistry()
  registry.mask=LONGCARD(1) LSH service.arrival
  registry.cancelSignal=EXEC.AllocSignal(-1)
  IF registry.cancelSignal=255 THEN
    RETURN(0)
  FI

  registry.cancelReady=1
  registry.cancelHead=BYTE POINTER(0)
  registry.mask=registry.mask OR (LONGCARD(1) LSH registry.cancelSignal)
  service.control=FSPORTS.Create(service.arrival)

RETURN(service.control<>EXEC.MsgPort POINTER(0))

; A private candidate keeps its unresolved definition until commit.
FSTYPES.Spec POINTER FUNC Definition(FSTYPES.Service POINTER service)

  IF service.mountNew<>0 THEN
    RETURN(@service.pending)
  FI

  LET registry=DOSCORE.GetRegistry()
  LET specs=FSTYPES.Spec POINTER(registry.config)

RETURN(@specs(service.index))

; Create a fresh mount identity before any caller can discover it.
BYTE FUNC AllocateMount(FSTYPES.Service POINTER service)
  DOSCORE.DosRegistry POINTER registry
  FSTYPES.Mount POINTER mount

  registry=DOSCORE.GetRegistry()
  IF registry.generation=LONGCARD($ffffffff) THEN
    service.error=ERROR_NO_FREE_STORE
    RETURN(0)
  FI

  mount=FSTYPES.Mount POINTER(EXEC.AllocMem(SIZEOF(FSTYPES.Mount),
      EXEC.MEMF_UPPER OR EXEC.MEMF_CLEAR))
  IF mount=FSTYPES.Mount POINTER(0) THEN
    RETURN(0)
  FI

  service.selected=mount
  service.mountOwned=1
  EXEC.Forbid()
  service.mounts(service.index).item=mount
  EXEC.Permit()
  A816MEMORY.Move(BYTE POINTER(@mount.spec),BYTE POINTER(Definition(service)),
      SIZEOF(FSTYPES.Spec))

  FSSYSTEM.Apply(@mount.spec,service.index)
  registry.generation==+1
  mount.generation=registry.generation
  mount.volume=FSBTYPES.Volume POINTER(EXEC.AllocMem(SIZEOF(FSBTYPES.Volume),
      EXEC.MEMF_UPPER OR EXEC.MEMF_CLEAR))
  IF mount.volume=FSBTYPES.Volume POINTER(0) THEN
    RETURN(0)
  FI

  mount.volume.format=mount.spec.format
  mount.volume.owner=BYTE POINTER(mount)

RETURN(FSBACKEND.CreateVolume(mount.volume))

; Attach physical geometry and a request port to the pending mount.
BYTE FUNC AllocateBlock(FSTYPES.Service POINTER service)
  FSTYPES.Mount POINTER mount
  BLOCKTYPES.Volume POINTER block

  mount=service.selected
  IF mount.spec.format=FSFORMATS.RAM THEN
    mount.port=FSPORTS.Create(service.arrival)
    RETURN(mount.port<>NULL)
  FI

  block=BLOCKTYPES.Volume POINTER(EXEC.AllocMem(BLOCKTYPES.VOLUME_SIZE,
      EXEC.MEMF_UPPER OR EXEC.MEMF_CLEAR))
  IF block=BLOCKTYPES.Volume POINTER(0) THEN
    RETURN(0)
  FI

  mount.block=block
  mount.volume.block=block
  block.adapter=BYTE POINTER(service.adapter)
  block.unit=BYTE(mount.spec.unit)
  block.profile=BYTE(mount.spec.profile)
  block.sectors=mount.spec.sectors
  block.dataBytes=mount.spec.dataBytes
  block.boot=mount.spec.boot
  block.backend=mount.spec.backend
  block.access=mount.spec.access
  block.generation=mount.generation
  mount.port=FSPORTS.Create(service.arrival)

RETURN(mount.port<>EXEC.MsgPort POINTER(0))

; Make the complete initial mount set discoverable together.
PROC Publish(FSTYPES.Service POINTER service)
  DOSCORE.DosRegistry POINTER registry
  BYTE index

  registry=DOSCORE.GetRegistry()
  FOR index=0 TO service.count-1 DO
    IF service.mounts(index).item<>NULL THEN
      service.mounts(index).item.published=1
    FI
  OD

  service.error=0
  service.stage=10
  service.index=0
  service.nextStep=service.readyStep
  registry.state=FSTYPES.STATE_READY

RETURN

; Acquire bounded startup resources before beginning the mount sequence.
PUBLIC BYTE FUNC First(BYTE POINTER raw)

  LET service=FSTYPES.Service POINTER(raw)
  service.error=ERROR_NO_FREE_STORE
  service.mountStage=FSTYPES.MOUNT_CONFIG
  IF Config(service)=0 THEN
    RETURN(FSSTATUS.STOP)
  FI

  service.stage=1
  service.mountStage=FSTYPES.MOUNT_RESOURCES
  LET registry=DOSCORE.GetRegistry()
  LET specs=FSTYPES.Spec POINTER(registry.config)
  FOR service.index=0 TO service.count-1 DO
    IF FSREGISTRY.Enabled(service.index)<>0 AND
        specs(service.index).format<>FSFORMATS.RAM THEN
      service.adapter=BLOCKIO.Create()
      IF service.adapter=NULL THEN
        RETURN(FSSTATUS.STOP)
      FI

      EXIT
    FI
  OD

  service.index=0

  IF Workspace(service)=0 THEN
    RETURN(FSSTATUS.STOP)
  FI

  IF Arrival(service)=0 THEN
    RETURN(FSSTATUS.STOP)
  FI

  service.nextStep=@NextMountStep

RETURN(FSSTATUS.MORE)

; Skip disabled and unused definitions without moving their stable slots.
BYTE FUNC NextMountStep(BYTE POINTER raw)

  LET service=FSTYPES.Service POINTER(raw)
  WHILE service.index<service.count DO
    IF FSREGISTRY.Enabled(service.index)<>0 THEN
      RETURN(MountStep(raw))
    FI

    service.index==+1
  OD

  Publish(service)

RETURN(FSSTATUS.MORE)

; Prepare one private mount, then let the worker open its device.
PUBLIC BYTE FUNC MountStep(BYTE POINTER raw)

  LET service=FSTYPES.Service POINTER(raw)
  service.error=ERROR_NO_FREE_STORE
  service.mountStage=BLOCKTYPES.ADMIT_ALLOCATE
  IF MountResources(service,Definition(service))=0 THEN
    RETURN(Failed(service))
  FI

  IF AllocateMount(service)=0 THEN
    RETURN(Failed(service))
  FI

  IF AllocateBlock(service)=0 THEN
    RETURN(Failed(service))
  FI

  service.mountStage=BLOCKTYPES.ADMIT_OPEN
  service.nextStep=@OpenedStep
  IF service.selected.spec.format=FSFORMATS.RAM THEN
    RETURN(FSSTATUS.MORE)
  FI

RETURN(FSSTATUS.OPEN_VOLUME)

; Start filesystem recognition only after the device open succeeds.
BYTE FUNC OpenedStep(BYTE POINTER raw)
  FSTYPES.Service POINTER service

  service=FSTYPES.Service POINTER(raw)
  IF service.resultState=FSSTATUS.ERROR THEN
    service.error=service.adapter.error
    service.mountStage=service.adapter.admission
    RETURN(Failed(service))
  FI

  IF service.selected.spec.format<>FSFORMATS.RAM AND
      service.selected.spec.sectors=0 AND
      service.selected.spec.backend=BLOCKTYPES.BACKEND_SIO THEN
    IF FSDISCOVER.Run(service)=0 THEN
      RETURN(Failed(service))
    FI
  FI

  service.mountStage=FSTYPES.MOUNT_RECOGNIZE
  service.work.volume=service.selected.volume
  LET status=FSBACKEND.BeginMount(service.work)
  IF status=FSSTATUS.ERROR THEN
    service.error=service.work.error
    RETURN(Failed(service))
  FI

  service.nextStep=@MountedStep
  IF service.selected.discovery.source<>FSDISCOVER.CONFIGURED AND
      status=FSSTATUS.NEED_IO AND service.work.neededSector=1 THEN
    RETURN(FSSTATUS.MORE)
  FI

RETURN(status)

; Publish a validated mount or continue the initial mount sequence.
BYTE FUNC MountedStep(BYTE POINTER raw)
  FSTYPES.Service POINTER service

  service=FSTYPES.Service POINTER(raw)
  IF service.resultState=FSSTATUS.ERROR THEN
    service.error=service.work.ioError
    service.mountStage=FSTYPES.MOUNT_READ
    RETURN(Failed(service))
  FI

  IF FSBACKEND.MountBuffered(service.work)=FSSTATUS.ERROR THEN
    service.error=service.work.error
    RETURN(Failed(service))
  FI

  service.selected.writable=service.selected.spec.access
  LET registry=DOSCORE.GetRegistry()
  EXEC.Forbid()
  IF service.packet<>NULL THEN
    IF FSOPERATION.Canceled(FSACTIVE.CurrentScope(service))<>0 THEN
      EXEC.Permit()
      RETURN(CancelMount(service))
    FI

    service.committing=1
    IF service.mountNew<>0 THEN
      BEGIN
        LET specs=FSTYPES.Spec POINTER(registry.config)
        A816MEMORY.Move(BYTE POINTER(@specs(service.index)),
            BYTE POINTER(@service.pending),SIZEOF(FSTYPES.Spec))
        registry.defined=registry.defined OR (CARD(1) LSH service.index)
        ; Successful replacement becomes a user definition; failed replacement
        ; never overwrites the saved boot descriptor.
        registry.bootDefinitions=registry.bootDefinitions &
            ($ffff XOR (CARD(1) LSH service.index))
      END
    FI

    service.selected.published=1
    registry.enabled=registry.enabled OR (CARD(1) LSH service.index)
  FI

  IF registry.mountSlot=service.index THEN
    registry.mountError=0
    registry.mountStage=0
  FI

  service.mountNew=0
  service.newResources=0
  service.mountOwned=0
  EXEC.Permit()
  IF service.packet<>NULL THEN
    service.packet.sp_Pkt.dp_Res1=-1
    FSPACKET.Reply(service)
    RETURN(FSSTATUS.MORE)
  FI

  service.index==+1
  service.nextStep=@NextMountStep

RETURN(FSSTATUS.MORE)

; Startup retirement owns all mounts; a failed remount owns only its slot.
BYTE FUNC Failed(FSTYPES.Service POINTER service)

  RecordFailure(service)
  IF service.packet=NULL THEN
    RETURN(FSSTATUS.STOP)
  FI

  LET error=service.error
  IF service.mountOwned<>0 THEN
    EXEC.Forbid()
    service.mounts(service.index).item=NULL
    EXEC.Permit()
    DestroyMount(service,service.selected)
    service.mountOwned=0
  FI

  service.selected=NULL
  RollbackResources(service)

RETURN(FSPACKET.Error(service,error))

; Cancel only the unpublished candidate owned by this mount operation.
PUBLIC BYTE FUNC CancelMount(FSTYPES.Service POINTER service)

  service.error=ERROR_BREAK

RETURN(Failed(service))

; Capture the causal failure before startup/remount frees its private records.
PUBLIC PROC RecordFailure(FSTYPES.Service POINTER service)
  FSTYPES.Spec POINTER spec
  BYTE index,value

  LET registry=DOSCORE.GetRegistry()
  spec=NULL
  IF service.selected<>NULL THEN
    spec=@service.selected.spec
  ELSEIF service.mountNew<>0 THEN
    spec=@service.pending
  ELSEIF service.index<registry.count AND FSREGISTRY.Defined(service.index)<>0 THEN
    BEGIN
      LET specs=FSTYPES.Spec POINTER(registry.config)
      spec=@specs(service.index)
    END
  FI

  EXEC.Forbid()
  registry.mountSlot=$ff
  registry.failureName(0)=0
  registry.failureSectors=0
  registry.failureBytes=0
  registry.failureBackend=0
  registry.failureUnit=0
  registry.failureSource=0
  registry.failureReason=0
  A816MEMORY.Clear(registry.failureStatus,4)
  A816MEMORY.Clear(registry.failurePercom,12)
  IF spec<>NULL THEN
    registry.mountSlot=service.index
    FOR index=0 TO 31 DO
      value=FSSYSTEM.NameByte(spec,service.index,index)
      registry.failureName(index)=IF value=0 OR (value>=32 AND value<=126)
          THEN value ELSE 46 FI
      IF value=0 THEN
        EXIT
      FI
    OD

    registry.failureName(31)=0
    registry.failureSectors=spec.sectors
    registry.failureBytes=spec.dataBytes
    registry.failureBackend=spec.backend
    registry.failureUnit=BYTE(FSSYSTEM.Unit(spec,service.index))
    IF service.selected<>NULL THEN
      registry.failureSource=service.selected.discovery.source
      registry.failureReason=service.selected.discovery.reason
      A816MEMORY.Move(registry.failureStatus,service.selected.discovery.status,4)
      A816MEMORY.Move(registry.failurePercom,service.selected.discovery.percom,12)
    FI
  FI

  registry.mountStage=service.mountStage
  registry.mountError=service.error
  EXEC.Permit()

RETURN

; Tear down an unreferenced mount; queued packets indicate an ownership bug.
PUBLIC PROC DestroyMount(FSTYPES.Service POINTER service FSTYPES.Mount
    POINTER mount)

  IF mount=NULL THEN
    RETURN
  FI

  FSBACKEND.Invalidate(service.work)
  IF mount.references<>0 THEN
    HEAPCORE.Abort($ff94)
  FI

  IF mount.port<>NULL THEN
    IF EXECLISTS.IsListEmpty(@mount.port.mp_MsgList)=0 THEN
      HEAPCORE.Abort($ff94)
    FI
  FI

  IF BLOCKIO.Detach(service.adapter,mount.block)=0 THEN
    HEAPCORE.Abort($ff94)
  FI

  FSPORTS.Delete(mount.port)
  FSBACKEND.DestroyVolume(mount.volume)
  IF mount.volume<>NULL THEN
    EXEC.FreeMem(BYTE POINTER(mount.volume),SIZEOF(FSBTYPES.Volume))
  FI

  EXEC.FreeMem(BYTE POINTER(mount),SIZEOF(FSTYPES.Mount))

RETURN

; Release service resources, including those left by partial initialization.
PUBLIC PROC Cleanup(FSTYPES.Service POINTER service)
  BYTE index

  LET registry=DOSCORE.GetRegistry()
  IF registry.cancelHead<>NULL THEN
    HEAPCORE.Abort($ff94)
  FI

  IF registry.cancelReady<>0 THEN
    EXEC.FreeSignal(registry.cancelSignal)
    registry.cancelReady=0
  FI

  FOR index=0 TO 8 DO
    DestroyMount(service,service.mounts(index).item)
  OD

  FSPORTS.Delete(service.control)
  IF service.arrival<>255 THEN
    EXEC.FreeSignal(service.arrival)
  FI

  IF service.operation<>NULL THEN
    EXEC.FreeMem(BYTE POINTER(service.operation),SIZEOF(FSBTYPES.Operation))
  FI

  IF service.mutation<>NULL THEN
    EXEC.FreeMem(service.mutation,SIZEOF(FSWTYPES.State))
  FI

  FSBACKEND.DestroyWork(service.work)
  IF service.work<>NULL THEN
    EXEC.FreeMem(BYTE POINTER(service.work),SIZEOF(FSBTYPES.Workspace))
  FI

  IF BLOCKIO.Destroy(service.adapter)=0 THEN
    HEAPCORE.Abort($ff94)
  FI

RETURN

ENDMODULE
