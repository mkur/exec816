; Volatile metadata owned by the existing serialized filesystem worker.
MODULE RAMFS
USE EXEC
USE A816MEMORY
USE RAMTYPES
USE FSBTYPES
USE FSCORE
USE FS83
USE FSSTATUS
INCLUDE "../dos/dos-types.inc"

PUBLIC RAMTYPES.Volume POINTER FUNC State(FSBTYPES.Volume POINTER volume)

RETURN(RAMTYPES.Volume POINTER(volume.state))

; Live node identities are never reused during a mount's lifetime.
PUBLIC RAMTYPES.Node POINTER FUNC Find(FSBTYPES.Volume POINTER volume CARD id)
  RAMTYPES.Node POINTER node

  LET state=State(volume)
  node=state.nodes
  WHILE node<>NULL DO
    IF node.entry.start=id THEN
      RETURN(node)
    FI

    node=node.next
  OD

RETURN(NULL)

; File storage is not cleared: only bytes below entry.length are readable.
PUBLIC PROC ReleaseData(RAMTYPES.Node POINTER node)

  IF node.data<>NULL THEN
    EXEC.FreeMem(node.data,node.capacity)
    node.data=NULL
  FI

  node.capacity=0
  node.entry.length=0
  node.entry.count=0

RETURN

; A RAM volume starts with just its state and an empty root node.
PUBLIC BYTE FUNC CreateVolume(FSBTYPES.Volume POINTER volume)
  BYTE index

  volume.state=EXEC.AllocMem(SIZEOF(RAMTYPES.Volume),
      EXEC.MEMF_UPPER OR EXEC.MEMF_CLEAR)
  IF volume.state=NULL THEN
    RETURN(0)
  FI

  LET state=State(volume)
  state.nodes=RAMTYPES.Node POINTER(EXEC.AllocMem(SIZEOF(RAMTYPES.Node),
      EXEC.MEMF_UPPER OR EXEC.MEMF_CLEAR))
  IF state.nodes=NULL THEN
    RETURN(0)
  FI

  state.serial=1
  state.live=1
  volume.root=1
  state.nodes.entry.key=1
  state.nodes.entry.start=1
  state.nodes.entry.flags=FSBTYPES.DIR
  state.nodes.entry.known=1
  FOR index=0 TO 10 DO
    state.nodes.entry.name(index)=32
  OD

RETURN(1)

; The common mount owner has already drained all files, locks and packets.
PUBLIC PROC DestroyVolume(FSBTYPES.Volume POINTER volume)
  RAMTYPES.Node POINTER node,next

  IF volume.state=NULL THEN
    RETURN
  FI

  LET state=State(volume)
  node=state.nodes
  WHILE node<>NULL DO
    next=node.next
    ReleaseData(node)
    EXEC.FreeMem(BYTE POINTER(node),SIZEOF(RAMTYPES.Node))
    node=next
  OD

  EXEC.FreeMem(volume.state,SIZEOF(RAMTYPES.Volume))
  volume.state=NULL

RETURN

PUBLIC BYTE FUNC BeginMount(FSBTYPES.Workspace POINTER work)

  work.error=0
  work.ioError=0
  work.volume.mounted=1

RETURN(FSSTATUS.DONE)

PUBLIC BYTE FUNC Descend(FSBTYPES.Workspace POINTER work)

  IF (work.entry.flags & FSBTYPES.DIR)=0 THEN
    work.error=ERROR_OBJECT_WRONG_TYPE
    RETURN(FSSTATUS.ERROR)
  FI

  IF work.depth=16 THEN
    work.error=ERROR_TOO_MANY_LEVELS
    RETURN(FSSTATUS.ERROR)
  FI

  work.depth==+1
  work.ancestors(work.depth)=work.entry.start
  work.directory=work.entry.start

RETURN(FSSTATUS.DONE)

PUBLIC BYTE FUNC StartResolve(FSBTYPES.Workspace POINTER work BYTE POINTER path)

  IF FS83.StartResolve(work,path)=0 THEN
    RETURN(FSSTATUS.ERROR)
  FI

  IF work.pathLength=0 THEN
    BEGIN
      LET node=Find(work.volume,work.volume.root)
      FSCORE.CopyEntry(@work.entry,@node.entry)
      RETURN(FSSTATUS.DONE)
    END
  FI

RETURN(FSSTATUS.NEXT_COMPONENT)

; Name lookup examines at most sixteen nodes per worker checkpoint.
PUBLIC BYTE FUNC ResolveComponent(FSBTYPES.Workspace POINTER work)

  IF FS83.Component(work)=0 THEN
    RETURN(FSSTATUS.ERROR)
  FI

  LET state=State(work.volume)
  state.scan=state.nodes

RETURN(FSSTATUS.MORE)

PUBLIC BYTE FUNC ResolveStep(FSBTYPES.Workspace POINTER work)
  BYTE count
  RAMTYPES.Node POINTER node

  LET state=State(work.volume)
  FOR count=0 TO 15 DO
    node=state.scan
    IF node=NULL THEN
      work.error=ERROR_OBJECT_NOT_FOUND
      RETURN(FSSTATUS.ERROR)
    FI

    state.scan=node.next
    IF node.entry.parent=work.directory AND
        FS83.Match(node.entry.name,work.wanted)<>0 THEN
      FSCORE.CopyEntry(@work.entry,@node.entry)
      IF work.pathOffset=work.pathLength THEN
        IF (work.entry.flags & FSBTYPES.DIR)<>0 THEN
          RETURN(Descend(work))
        FI

        RETURN(FSSTATUS.DONE)
      FI

      IF Descend(work)=0 THEN
        RETURN(FSSTATUS.ERROR)
      FI

      RETURN(FSSTATUS.NEXT_COMPONENT)
    FI
  OD

RETURN(FSSTATUS.MORE)

PUBLIC BYTE FUNC BeginEntry(FSBTYPES.Workspace POINTER work CARD directory
    LONGCARD ordinal)

  work.directory=directory
  work.index=ordinal
  LET state=State(work.volume)
  state.scan=state.nodes
  state.ordinal=0

RETURN(FSSTATUS.MORE)

; Enumeration returns live children newest first, without empty slots.
PUBLIC BYTE FUNC BufferedEntry(FSBTYPES.Workspace POINTER work)
  BYTE count
  RAMTYPES.Node POINTER node

  LET state=State(work.volume)
  FOR count=0 TO 15 DO
    node=state.scan
    IF node=NULL THEN
      RETURN(FSSTATUS.END_DIR)
    FI

    state.scan=node.next
    IF node.entry.parent=work.directory THEN
      IF state.ordinal=work.index THEN
        FSCORE.CopyEntry(@work.entry,@node.entry)
        RETURN(FSSTATUS.DONE)
      FI

      state.ordinal==+1
    FI
  OD

RETURN(FSSTATUS.MORE)

; Leases prevent deletion/rename of the retained node or any ancestor.
PUBLIC LONGINT FUNC ValidateBase(FSBTYPES.Workspace POINTER work
    FSBTYPES.LockState POINTER lock)

  LET node=Find(work.volume,lock.entry.start)
  IF node=NULL THEN
    RETURN(ERROR_INVALID_LOCK)
  FI

RETURN(0)

PUBLIC BYTE FUNC Measure(FSBTYPES.Workspace POINTER work FSBTYPES.Cursor
    POINTER file)

  LET node=Find(work.volume,work.entry.start)
  FSCORE.CopyEntry(@file.entry,@node.entry)

RETURN(FSSTATUS.DONE)

ENDMODULE
