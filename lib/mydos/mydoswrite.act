; MyDOS VTOC/chain mutation. Existing ten-bit links retain their slot identity;
; new files use the native sixteen-bit form and one empty payload sector.
MODULE MYDOSWRITE
USE FSTYPES
USE FSBTYPES
USE FSWTYPES
USE FSWRITEIO
USE FSALLOC
USE MYDOS
USE MYDOSFILE
USE FSCORE
USE SDFS
USE A816MEMORY
INCLUDE "../dos/dos-types.inc"

BYTE FUNC Bad(FSTYPES.Service POINTER service)

RETURN(FSWRITEIO.Error(service,ERROR_DISK_NOT_VALIDATED))

CARD FUNC Limit(FSBTYPES.Entry POINTER entry)

  IF (entry.key & $400)=0 THEN
    RETURN(1023)
  FI

RETURN($ffff)

; Validate each touched payload and its next link against geometry, ancestry,
; native file ordinal and allocation state before using its bytes.
BYTE FUNC ReadPayload(FSTYPES.Service POINTER service FSBTYPES.Entry POINTER entry
    CARD sector BYTE cached)
  BYTE index,high
  CARD sectorBytes,next,ancestor

  LET state=FSWRITEIO.State(service)
  sectorBytes=service.selected.spec.dataBytes
  IF MYDOS.DataSector(service.work.volume,LONGCARD(sector))=0
      OR sector>Limit(entry) THEN
    RETURN(Bad(service))
  FI

  FOR index=0 TO service.work.depth DO
    ancestor=service.work.ancestors(index)
    IF LONGCARD(sector)>=LONGCARD(ancestor)
        AND LONGCARD(sector)<LONGCARD(ancestor)+8 THEN
      RETURN(Bad(service))
    FI
  OD

  IF FSALLOC.AllocatedCached(service,sector,cached)=0 OR
      FSWRITEIO.Read(service,sector,state.data)=0 THEN
    RETURN(0)
  FI

  high=state.data(sectorBytes-3)
  IF Limit(entry)=1023 THEN
    IF (high RSH 2)<>BYTE(entry.key) THEN
      RETURN(Bad(service))
    FI

    high=high & 3
  FI

  next=(CARD(high) LSH 8)+CARD(state.data(sectorBytes-2))
  IF state.data(sectorBytes-1)>BYTE(sectorBytes-3) OR next=sector THEN
    RETURN(Bad(service))
  FI

  IF next<>0 THEN
    IF MYDOS.DataSector(service.work.volume,LONGCARD(next))=0 OR
        next>Limit(entry) OR
        state.data(sectorBytes-1)<>BYTE(sectorBytes-3) THEN
      RETURN(Bad(service))
    FI
  FI

  state.next=next

RETURN(1)

PROC Trailer(FSTYPES.Service POINTER service FSBTYPES.Entry POINTER entry
    CARD next BYTE used)

  LET state=FSWRITEIO.State(service)
  LET sectorBytes=service.selected.spec.dataBytes
  state.data(sectorBytes-3)=BYTE(next RSH 8)
  IF Limit(entry)=1023 THEN
    state.data(sectorBytes-3)=state.data(sectorBytes-3) OR (BYTE(entry.key) LSH 2)
  FI

  state.data(sectorBytes-2)=BYTE(next)
  state.data(sectorBytes-1)=used

RETURN

; Load the entire physical sector, preserving neighbouring directory records.
BYTE FUNC LoadEntry(FSTYPES.Service POINTER service FSBTYPES.Entry POINTER entry)

  LET state=FSWRITEIO.State(service)
  LET sector=entry.parent+CARD((entry.key & 255) RSH 3)
  LET offset=CARD(entry.key & 7) LSH 4
  IF FSWRITEIO.Read(service,sector,state.map)=0 THEN
    RETURN(0)
  FI

  A816MEMORY.Move(state.row,@state.map(offset),16)

RETURN(1)

; Store a modified record while its loaded map remains owned by this helper.
BYTE FUNC StoreEntry(FSTYPES.Service POINTER service FSBTYPES.Entry POINTER entry)

  LET state=FSWRITEIO.State(service)
  LET sector=entry.parent+CARD((entry.key & 255) RSH 3)
  LET offset=CARD(entry.key & 7) LSH 4
  A816MEMORY.Move(@state.map(offset),state.row,16)

RETURN(FSWRITEIO.Write(service,sector,state.map))

PUBLIC BYTE FUNC Validate(FSTYPES.Service POINTER service FSBTYPES.Entry POINTER
    entry)
  BYTE cached
  CARD sector
  LONGINT count,length

  LET state=FSWRITEIO.State(service)
  cached=0
  sector=entry.start
  count=0
  length=0
  WHILE sector<>0 DO
    IF count>=entry.count OR LONGCARD(count)>=service.selected.spec.sectors THEN
      RETURN(Bad(service))
    FI

    IF ReadPayload(service,entry,sector,cached)=0 THEN
      RETURN(0)
    FI

    cached=1
    length==+LONGINT(state.data(service.selected.spec.dataBytes-1))
    count==+1
    sector=state.next
  OD

  IF count<>entry.count THEN
    RETURN(Bad(service))
  FI

  entry.length=length
  entry.known=1

RETURN(1)

PUBLIC BYTE FUNC Mark(FSTYPES.Service POINTER service FSBTYPES.Entry POINTER
    entry BYTE opened)

  LET state=FSWRITEIO.State(service)
  IF LoadEntry(service,entry)=0 THEN
    RETURN(0)
  FI

  state.row(0)=BYTE(entry.key RSH 8) & $fe
  IF opened<>0 THEN
    state.row(0)=state.row(0) OR 1
  FI

  FSWRITEIO.Word(state.row,1,CARD(entry.count))
  FSWRITEIO.Word(state.row,3,entry.start)

RETURN(StoreEntry(service,entry))

BYTE FUNC Slot(FSTYPES.Service POINTER service)
  CARD ordinal,offset

  LET state=FSWRITEIO.State(service)
  ordinal=0
  WHILE ordinal<64 DO
    IF FSWRITEIO.Read(service,service.work.directory+(ordinal RSH 3),
        state.map)=0 THEN
      RETURN(0)
    FI

    FOR offset=0 TO 112 STEP 16 DO
      IF state.map(offset)=0 OR (state.map(offset) & $80)<>0 THEN
        state.ordinal=LONGCARD(ordinal)
        RETURN(1)
      FI

      ordinal==+1
    OD
  OD

RETURN(FSWRITEIO.Error(service,ERROR_DISK_FULL))

PUBLIC BYTE FUNC Create(FSTYPES.Service POINTER service BYTE directory)
  BYTE count,index
  CARD first,sector

  LET state=FSWRITEIO.State(service)
  IF Slot(service)=0 THEN
    RETURN(0)
  FI

  count=1
  IF directory<>0 THEN
    count=8
  FI

  IF FSALLOC.Find(service,count,directory,$ffff)=0 THEN
    RETURN(0)
  FI

  first=state.reserved(0)
  FOR index=0 TO count-1 DO
    sector=FSALLOC.Take(service)
    IF sector=0 THEN
      RETURN(0)
    FI

    FSWRITEIO.Zero(state.data,service.selected.spec.dataBytes)
    IF FSWRITEIO.Write(service,sector,state.data)=0 THEN
      RETURN(0)
    FI
  OD

  LET entry=@service.work.entry
  entry.parent=service.work.directory
  entry.start=first
  entry.count=LONGINT(count)
  entry.length=0
  entry.known=1
  entry.flags=0
  entry.key=$4600 OR state.ordinal
  entry.days=0
  entry.minutes=0
  entry.ticks=0
  A816MEMORY.Clear(state.row,23)

  state.row(0)=$47
  IF directory<>0 THEN
    entry.key=$1000 OR state.ordinal
    entry.flags=FSBTYPES.DIR
    state.row(0)=$10
  FI

  FSWRITEIO.Word(state.row,1,CARD(count))
  FSWRITEIO.Word(state.row,3,first)
  A816MEMORY.Move(entry.name,service.work.wanted,11)
  A816MEMORY.Move(@state.row(5),service.work.wanted,11)

RETURN(StoreEntry(service,entry))

; Reserve and initialize a bounded extension before linking it to the tail.
LONGINT FUNC Extend(FSTYPES.Service POINTER service FSBTYPES.Cursor POINTER file
    BYTE POINTER source LONGINT length CARD previous)
  CARD count,index,part,next
  LONGINT completed

  LET state=FSWRITEIO.State(service)
  LET payload=service.selected.spec.dataBytes-3
  LET chain=MYDOSFILE.Chain(file)
  count=FSWTYPES.EXTENSION_SECTORS
  IF length<LONGINT(payload)*LONGINT(count) THEN
    count=CARD((length+LONGINT(payload)-1)/LONGINT(payload))
  FI

  IF FSALLOC.FindGroup(service,BYTE(count),Limit(@file.entry))=0 OR
      FSALLOC.TakeGroup(service)=0 THEN
    RETURN(0)
  FI

  count=CARD(state.reservations)
  completed=0
  FOR index=0 TO count-1 DO
    part=payload
    IF LONGINT(part)>length-completed THEN
      part=CARD(length-completed)
    FI

    A816MEMORY.Move(state.data,source+SIZE(completed),SIZE(part))
    A816MEMORY.Clear(@state.data(part),SIZE(payload-part))

    next=0
    IF index+1<count THEN
      next=state.reserved(index+1)
    FI

    Trailer(service,@file.entry,next,BYTE(part))
    IF FSWRITEIO.WritePayload(service,state.reserved(index),state.data)=0 THEN
      RETURN(0)
    FI

    completed==+LONGINT(part)
  OD

  IF ReadPayload(service,@file.entry,previous,0)=0 THEN
    RETURN(0)
  FI

  IF state.next<>0 THEN
    Bad(service)
    RETURN(0)
  FI

  Trailer(service,@file.entry,state.reserved(0),BYTE(payload))
  IF FSWRITEIO.Write(service,previous,state.data)=0 THEN
    RETURN(0)
  FI

  FSCORE.CopyEntry(@state.target,@file.entry)
  state.target.count==+LONGINT(count)
  IF Mark(service,@state.target,1)=0 THEN
    RETURN(0)
  FI

  file.entry.count=state.target.count
  FOR index=0 TO count-1 DO
    chain.sector=state.reserved(index)
    IF MYDOSFILE.Visit(file)=0 THEN
      Bad(service)
      RETURN(0)
    FI
  OD

  file.position==+completed
  file.entry.length=file.position
  chain.base=file.position-LONGINT(part)
  chain.offset=part
  chain.used=part
  chain.next=0
  chain.valid=1

RETURN(completed)

PUBLIC LONGINT FUNC Write(FSTYPES.Service POINTER service FSBTYPES.Cursor
    POINTER file BYTE POINTER source LONGINT length)
  CARD sector,payload,within,part
  BYTE used

  LET state=FSWRITEIO.State(service)
  payload=service.selected.spec.dataBytes-3
  LET chain=MYDOSFILE.Chain(file)
  IF chain.valid=0 OR chain.base>file.position THEN
    MYDOSFILE.Restart(file)
  FI

  sector=chain.sector
  WHILE sector<>0 DO
    IF ReadPayload(service,@file.entry,sector,0)=0 THEN
      chain.valid=0
      RETURN(0)
    FI

    IF chain.valid=0 THEN
      IF MYDOSFILE.Visit(file)=0 THEN
        Bad(service)
        RETURN(0)
      FI
    FI

    chain.used=CARD(state.data(payload+2))
    chain.next=state.next
    IF (chain.next=0 AND chain.hops<>LONGCARD(file.entry.count)) OR
        (chain.next<>0 AND chain.hops>=LONGCARD(file.entry.count)) THEN
      chain.valid=0
      Bad(service)
      RETURN(0)
    FI

    chain.valid=1
    IF file.position<chain.base+LONGINT(chain.used) OR
        (chain.next=0 AND file.position=chain.base+LONGINT(chain.used)) THEN
      within=CARD(file.position-chain.base)
      IF within=payload THEN
        RETURN(Extend(service,file,source,length,sector))
      FI

      EXIT
    FI

    IF chain.next=0 THEN
      Bad(service)
      RETURN(0)
    FI

    MYDOSFILE.Advance(file)
    sector=chain.sector
  OD

  IF sector=0 THEN
    Bad(service)
    RETURN(0)
  FI

  part=payload-within
  IF LONGINT(part)>length THEN
    part=CARD(length)
  FI

  used=state.data(payload+2)
  A816MEMORY.Move(@state.data(within),source,SIZE(part))
  IF within+part>CARD(used) THEN
    used=BYTE(within+part)
    A816MEMORY.Clear(@state.data(CARD(used)),SIZE(payload-CARD(used)))
  FI

  Trailer(service,@file.entry,state.next,used)
  IF FSWRITEIO.WritePayload(service,sector,state.data)=0 THEN
    RETURN(0)
  FI

  file.position==+LONGINT(part)
  IF file.position>file.entry.length THEN
    file.entry.length=file.position
  FI

  chain.sector=sector
  chain.offset=within+part
  chain.used=CARD(used)
  chain.next=state.next
  chain.valid=1

RETURN(LONGINT(part))

BYTE FUNC Reclaim(FSTYPES.Service POINTER service FSBTYPES.Entry POINTER entry
    CARD sector)
  LONGCARD hops
  CARD next

  LET state=FSWRITEIO.State(service)
  hops=0
  WHILE sector<>0 DO
    IF ReadPayload(service,entry,sector,0)=0 THEN
      RETURN(0)
    FI

    next=state.next
    IF FSALLOC.Free(service,sector)=0 THEN
      RETURN(0)
    FI

    sector=next
    hops==+1
    IF hops>service.selected.spec.sectors THEN
      RETURN(Bad(service))
    FI
  OD

RETURN(1)

PUBLIC BYTE FUNC Truncate(FSTYPES.Service POINTER service FSBTYPES.Entry POINTER
    entry)
  CARD next

  LET state=FSWRITEIO.State(service)
  IF ReadPayload(service,entry,entry.start,0)=0 THEN
    RETURN(0)
  FI

  next=state.next
  FSWRITEIO.Zero(state.data,service.selected.spec.dataBytes)
  Trailer(service,entry,0,0)
  IF FSWRITEIO.Write(service,entry.start,state.data)=0 THEN
    RETURN(0)
  FI

  entry.count=1
  entry.length=0
  IF Mark(service,entry,1)=0 THEN
    RETURN(0)
  FI

RETURN(Reclaim(service,entry,next))

PUBLIC BYTE FUNC Empty(FSTYPES.Service POINTER service CARD directory)
  CARD sector,offset

  LET state=FSWRITEIO.State(service)
  FOR sector=directory TO directory+7 DO
    IF FSWRITEIO.Read(service,sector,state.data)=0 THEN
      RETURN(0)
    FI

    FOR offset=0 TO 112 STEP 16 DO
      IF state.data(offset)=0 THEN
        RETURN(1)
      FI

      IF (state.data(offset) & $80)=0 THEN
        RETURN(FSWRITEIO.Error(service,ERROR_DIR_NOT_EMPTY))
      FI
    OD
  OD

RETURN(1)

PUBLIC BYTE FUNC Delete(FSTYPES.Service POINTER service FSBTYPES.Entry POINTER entry)
  CARD sector

  LET state=FSWRITEIO.State(service)
  IF LoadEntry(service,entry)=0 THEN
    RETURN(0)
  FI

  state.row(0)=$80
  IF StoreEntry(service,entry)=0 THEN
    RETURN(0)
  FI

  IF (entry.flags & FSBTYPES.DIR)<>0 THEN
    FOR sector=entry.start TO entry.start+7 DO
      IF FSALLOC.Free(service,sector)=0 THEN
        RETURN(0)
      FI
    OD

    RETURN(1)
  FI

RETURN(Reclaim(service,entry,entry.start))

PUBLIC BYTE FUNC Rename(FSTYPES.Service POINTER service FSBTYPES.Entry POINTER
    entry BYTE POINTER name)

  LET state=FSWRITEIO.State(service)
  IF LoadEntry(service,entry)=0 THEN
    RETURN(0)
  FI

  A816MEMORY.Move(@state.row(5),name,11)

RETURN(StoreEntry(service,entry))

ENDMODULE
