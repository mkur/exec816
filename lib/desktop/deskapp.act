; Optional control panel. The presenter owns widget interaction and retained
; pixels; this ordinary Task consumes semantic actions and patches its status.
MODULE DESKAPP
USE EXEC
USE DESKTOP
USE DESKTYPES
USE DESKSTATE
USE REGIONS
USE A816MEMORY
USE HEAPCORE
USE WIDGETTYPES

CONST BUFFER_SIZE=WIDGETTYPES.TREE_SIZE+WIDGETTYPES.UPDATE_SIZE
    +WIDGETTYPES.SNAPSHOT_SIZE
CONST REFRESH_EVENT=1,REFRESH_SNAPSHOT=2
CONST OBJ_STATUS=1,OBJ_TOGGLE=2,OBJ_LOCKED=3,OBJ_SMALL=4,OBJ_LARGE=5,OBJ_APPLY=6,OBJ_CANCEL=7

DESKTYPES.Client client
DESKTYPES.Request control,eventWait,cancel
BYTE POINTER buffer
WIDGETTYPES.Tree POINTER tree
WIDGETTYPES.Update POINTER patch
WIDGETTYPES.Snapshot POINTER snapshot
EXEC.Task POINTER parent,worker
LONGCARD parentMask,stopMask,windowId
CARD updates
INT lastObject
BYTE refresh
BYTE parentBit,stopBit,started,finished,waiting,closing

CARD FUNC Call(BYTE operation)
  LONGCARD bits
  DESKTYPES.Request POINTER reply

  control.operation=operation
  IF DESKTOP.Submit(@client,@control)<>DESKTYPES.OK THEN
    RETURN(DESKTYPES.BUSY)
  FI

  reply=DESKTOP.Collect(@client)
  WHILE reply=NULL DO
    bits=EXEC.Wait(LONGCARD(1) LSH client.replies.mp_SigBit)
    reply=DESKTOP.Collect(@client)
  OD

  IF reply<>@control THEN
    HEAPCORE.Abort($faf0)
  FI

RETURN(control.status)

PROC Label(CARD index CSTRING value CARD bytes)

  tree.objects(index).spec=LONGCARD(tree.textBytes)
  A816MEMORY.Move(@tree.text(tree.textBytes),BYTE POINTER(value),SIZE(bytes+1))
  tree.textBytes==+bytes+1

RETURN

; This flat, compiled-in form fits the existing 176 by 120 client rectangle.
PROC BuildTree()
  CARD index

  tree.version=WIDGETTYPES.VERSION
  tree.count=8
  tree.background=8
  FOR index=0 TO 7 DO
    tree.objects(index).head=-1
    tree.objects(index).tail=-1
    tree.objects(index).next=INT(index+1)
    tree.objects(index).kind=WIDGETTYPES.G_BUTTON
    tree.objects(index).flags=WIDGETTYPES.FLAG_SELECTABLE
    tree.objects(index).x=8+INT(index & 1)*88
    tree.objects(index).y=24+INT((index-2) RSH 1)*32
    tree.objects(index).width=72
    tree.objects(index).height=16
  OD

  tree.objects(0).next=-1
  tree.objects(0).head=1
  tree.objects(0).tail=7
  tree.objects(0).kind=WIDGETTYPES.G_BOX
  tree.objects(0).flags=0
  tree.objects(0).x=0
  tree.objects(0).y=0
  tree.objects(0).width=176
  tree.objects(0).height=120
  tree.objects(0).spec=$78
  tree.objects(OBJ_STATUS).kind=WIDGETTYPES.G_STRING
  tree.objects(OBJ_STATUS).flags=0
  tree.objects(OBJ_STATUS).x=8
  tree.objects(OBJ_STATUS).y=8
  tree.objects(OBJ_STATUS).width=160
  tree.objects(OBJ_STATUS).height=8
  tree.objects(OBJ_LOCKED).state=WIDGETTYPES.STATE_DISABLED
  tree.objects(OBJ_SMALL).flags=WIDGETTYPES.FLAG_SELECTABLE OR WIDGETTYPES.FLAG_RADIO
  tree.objects(OBJ_SMALL).state=WIDGETTYPES.STATE_SELECTED
  tree.objects(OBJ_LARGE).flags=WIDGETTYPES.FLAG_SELECTABLE OR WIDGETTYPES.FLAG_RADIO
  tree.objects(OBJ_APPLY).flags=WIDGETTYPES.FLAG_SELECTABLE
      OR WIDGETTYPES.FLAG_DEFAULT OR WIDGETTYPES.FLAG_EXIT
  tree.objects(OBJ_CANCEL).next=0
  tree.objects(OBJ_CANCEL).flags=WIDGETTYPES.FLAG_SELECTABLE
      OR WIDGETTYPES.FLAG_EXIT OR WIDGETTYPES.FLAG_LAST
  Label(OBJ_STATUS,c"Ready",5)
  Label(OBJ_TOGGLE,c"Toggle",6)
  Label(OBJ_LOCKED,c"Locked",6)
  Label(OBJ_SMALL,c"Small",5)
  Label(OBJ_LARGE,c"Large",5)
  Label(OBJ_APPLY,c"Apply",5)
  Label(OBJ_CANCEL,c"Cancel",6)

RETURN

CARD FUNC ReadState()

  DESKTOP.Prepare(@control,DESKTYPES.READ_WIDGET_STATE)
  control.window=windowId
  control.payload=BYTE POINTER(snapshot)
  control.bytes=WIDGETTYPES.SNAPSHOT_SIZE

RETURN(Call(DESKTYPES.READ_WIDGET_STATE))

PROC Status(CSTRING value CARD bytes)

  patch.textBytes=bytes+1
  patch.changes(0).length=bytes
  A816MEMORY.Move(@patch.text(0),BYTE POINTER(value),SIZE(bytes+1))

RETURN

; The copied action already carries the committed epoch, revision and state.
; Try that revision first; only LOSS or a stale patch needs a fresh snapshot.
; Check Stop between retries. An old tree's action cannot patch a new one.
PROC RefreshStatus()
  CARD state

  IF refresh=REFRESH_SNAPSHOT THEN
    IF ReadState()<>DESKTYPES.OK THEN
      HEAPCORE.Abort($faf8)
    FI

    IF eventWait.event.kind<>DESKTYPES.EVENT_LOSS
        AND eventWait.event.epoch<>snapshot.epoch THEN
      refresh=0
      RETURN
    FI

    patch.epoch=snapshot.epoch
    patch.revision=snapshot.revision
    state=snapshot.objects(OBJ_TOGGLE).state
  ELSE
    patch.epoch=eventWait.event.epoch
    patch.revision=eventWait.event.revision
    state=eventWait.event.state
  FI

  patch.count=1
  patch.changes(0).object=OBJ_STATUS
  patch.changes(0).mask=WIDGETTYPES.PATCH_LABEL
  IF eventWait.event.kind=DESKTYPES.EVENT_LOSS THEN
    Status(c"Input resynced",14)
  ELSEIF eventWait.event.kind=DESKTYPES.EVENT_WIDGET_CANCEL THEN
    Status(c"Cancelled (Esc)",15)
  ELSEIF lastObject=OBJ_TOGGLE THEN
    IF (state & WIDGETTYPES.STATE_SELECTED)<>0 THEN
      Status(c"Toggle on [2]",13)
    ELSE
      Status(c"Toggle off [2]",14)
    FI
  ELSEIF lastObject=OBJ_SMALL THEN
    Status(c"Small [4]",9)
  ELSEIF lastObject=OBJ_LARGE THEN
    Status(c"Large [5]",9)
  ELSEIF lastObject=OBJ_APPLY THEN
    Status(c"Applied [6]",11)
  ELSE
    Status(c"Cancelled [7]",13)
  FI

  DESKTOP.Prepare(@control,DESKTYPES.UPDATE_WIDGETS)
  control.window=windowId
  control.payload=BYTE POINTER(patch)
  control.bytes=WIDGETTYPES.UPDATE_SIZE
  LET result=Call(DESKTYPES.UPDATE_WIDGETS)
  IF result=DESKTYPES.OK THEN
    refresh=0
  ELSEIF result=DESKTYPES.STALE THEN
    refresh=REFRESH_SNAPSHOT
  ELSE
    HEAPCORE.Abort($faf8)
  FI

RETURN

PROC CancelWait(BYTE unused)
  BYTE count
  EXEC.Message POINTER message
  DESKTYPES.Request POINTER reply

  IF waiting=0 THEN
    RETURN
  FI

  DESKTOP.Prepare(@cancel,DESKTYPES.CANCEL_EVENT)
  cancel.target=eventWait.sequence
  IF DESKTOP.Submit(@client,@cancel)<>DESKTYPES.OK THEN
    HEAPCORE.Abort($faf1)
  FI

  count=0
  WHILE count<2 DO
    message=EXEC.WaitPort(client.replies)
    reply=DESKTOP.Collect(@client)
    IF reply=NULL OR (reply<>@cancel AND reply<>@eventWait) THEN
      HEAPCORE.Abort($faf2)
    FI

    count==+1
  OD

  waiting=0

RETURN

PROC Retire(BYTE unused)

  IF client.replies<>NULL THEN
    CancelWait(0)
    IF windowId<>0 THEN
      DESKTOP.Prepare(@control,DESKTYPES.CLOSE)
      control.window=windowId
      IF Call(DESKTYPES.CLOSE)<>DESKTYPES.OK THEN
        HEAPCORE.Abort($faf3)
      FI

      windowId=0
    FI

    IF client.id<>0 THEN
      DESKTOP.Prepare(@control,DESKTYPES.UNREGISTER)
      IF Call(DESKTYPES.UNREGISTER)<>DESKTYPES.OK THEN
        HEAPCORE.Abort($faf4)
      FI
    FI

    IF DESKTOP.Dispose(@client)=0 THEN
      HEAPCORE.Abort($faf5)
    FI
  FI

  IF buffer<>NULL THEN
    EXEC.FreeMem(buffer,BUFFER_SIZE)
    buffer=NULL
    tree=NULL
    patch=NULL
    snapshot=NULL
  FI

  IF stopMask<>0 THEN
    EXEC.FreeSignal(stopBit)
    stopMask=0
  FI

  ; The parent checks finished under Forbid before signalling a borrowed Task
  ; pointer. No publisher can still reach the client or reply port at this point.
  EXEC.Forbid()
  finished=1
  EXEC.Signal(parent,parentMask)

RETURN

BYTE FUNC Admit()

  stopBit=EXEC.AllocSignal(-1)
  IF stopBit=$ff THEN
    RETURN(0)
  FI

  stopMask=LONGCARD(1) LSH stopBit
  buffer=EXEC.AllocMem(BUFFER_SIZE,
      EXEC.MEMF_PUBLIC OR EXEC.MEMF_UPPER OR EXEC.MEMF_CLEAR)
  IF buffer=NULL OR DESKTOP.Init(@client,DESKSTATE.Get())=0 THEN
    RETURN(0)
  FI

  tree=WIDGETTYPES.Tree POINTER(buffer)
  patch=WIDGETTYPES.Update POINTER(buffer+WIDGETTYPES.TREE_SIZE)
  snapshot=WIDGETTYPES.Snapshot POINTER(buffer
      +WIDGETTYPES.TREE_SIZE+WIDGETTYPES.UPDATE_SIZE)
  BuildTree()

  DESKTOP.Prepare(@control,DESKTYPES.REGISTER)
  IF Call(DESKTYPES.REGISTER)<>DESKTYPES.OK THEN
    RETURN(0)
  FI

  DESKTOP.Prepare(@control,DESKTYPES.OPEN)
  control.value=DESKTYPES.CONTENT_WIDGETS
  control.payload=BYTE POINTER(c"Control Panel")
  control.bytes=13
  REGIONS.Assign(@control.bounds,432,80,624,224)
  IF Call(DESKTYPES.OPEN)<>DESKTYPES.OK THEN
    RETURN(0)
  FI

  windowId=control.window
  DESKTOP.Prepare(@control,DESKTYPES.SET_TREE)
  control.window=windowId
  control.payload=BYTE POINTER(tree)
  control.bytes=WIDGETTYPES.TREE_SIZE
  IF Call(DESKTYPES.SET_TREE)<>DESKTYPES.OK THEN
    RETURN(0)
  FI

  DESKTOP.Prepare(@control,DESKTYPES.SHOW)
  control.window=windowId
  IF Call(DESKTYPES.SHOW)<>DESKTYPES.OK
      OR Call(DESKTYPES.RAISE)<>DESKTYPES.OK THEN
    RETURN(0)
  FI

RETURN(1)

PUBLIC PROC Run()
  LONGCARD bits
  DESKTYPES.Request POINTER reply

  IF Admit()=0 THEN
    Retire(0)
    RETURN
  FI

  started=1
  EXEC.Signal(parent,parentMask)
  WHILE closing=0 DO
    IF (EXEC.SetSignal(0,stopMask) & stopMask)<>0 THEN
      EXIT
    FI

    IF refresh<>0 THEN
      RefreshStatus()
      IF refresh<>0 THEN
        EXEC.Yield()
      FI
    ELSE
      DESKTOP.Prepare(@eventWait,DESKTYPES.NEXT_EVENT)
      IF DESKTOP.Submit(@client,@eventWait)<>DESKTYPES.OK THEN
        HEAPCORE.Abort($faf6)
      FI

      waiting=1
      reply=NULL
      WHILE reply=NULL AND closing=0 DO
        bits=EXEC.Wait((LONGCARD(1) LSH client.replies.mp_SigBit) OR stopMask)
        IF (bits & stopMask)<>0 THEN
          closing=1
        ELSE
          reply=DESKTOP.Collect(@client)
        FI
      OD

      IF closing=0 THEN
        IF reply<>NULL THEN
          IF reply<>@eventWait OR reply.status<>DESKTYPES.OK THEN
            HEAPCORE.Abort($faf7)
          FI

          waiting=0
          IF reply.event.kind=DESKTYPES.EVENT_CLOSE THEN
            closing=1
          ELSEIF reply.event.kind=DESKTYPES.EVENT_WIDGET_ACTION
              OR reply.event.kind=DESKTYPES.EVENT_WIDGET_CANCEL THEN
            lastObject=reply.event.object
            updates==+1
            refresh=REFRESH_EVENT
          ELSEIF reply.event.kind=DESKTYPES.EVENT_LOSS THEN
            refresh=REFRESH_SNAPSHOT
          FI
        FI
      FI
    FI
  OD

  Retire(0)

RETURN

PUBLIC BYTE FUNC Start()
  LONGCARD bits

  IF worker<>NULL THEN
    RETURN(0)
  FI

  parent=EXEC.FindTask(NULL)
  parentBit=EXEC.AllocSignal(-1)
  IF parentBit=$ff THEN
    RETURN(0)
  FI

  parentMask=LONGCARD(1) LSH parentBit
  started=0
  finished=0
  closing=0
  waiting=0
  updates=0
  refresh=0
  lastObject=-1
  worker=EXEC.CreateTask(c"desktop-app",0,@Run,1024)
  IF worker=NULL THEN
    EXEC.FreeSignal(parentBit)
    parentMask=0
    RETURN(0)
  FI

  WHILE started=0 AND finished=0 DO
    bits=EXEC.Wait(parentMask)
  OD

  IF finished<>0 THEN
    worker=NULL
    EXEC.FreeSignal(parentBit)
    parentMask=0
    RETURN(0)
  FI

RETURN(1)

PUBLIC PROC Stop()
  LONGCARD bits

  IF worker=NULL THEN
    RETURN
  FI

  EXEC.Forbid()
  IF finished=0 THEN
    EXEC.Signal(worker,stopMask)
  FI

  EXEC.Permit()
  WHILE finished=0 DO
    bits=EXEC.Wait(parentMask)
  OD

  worker=NULL
  EXEC.FreeSignal(parentBit)
  parentMask=0

RETURN

ENDMODULE
