; input.device delivers copied input; the frontend interprets manager work.
MODULE DESKINPUT
USE DISPLAY
USE EXEC
USE AESSNAPSHOT
USE AESLOCKS
USE AESTYPES
USE AESWINDOWSTATE
USE AESINPUT
USE AESKEYS
USE AESMOUSE
USE AESSTATE
USE AESCURSOR
USE INPUT
USE INPUTDEVICE
USE INPUTCLIENT
USE DESKMOUSE
USE DESKMOUSECONFIG
USE A816MEMORY
USE DESKTYPES
USE DESKSTATE
USE DESKCORE
USE DESKFINISH
USE DESKDRAG
USE DESKMENU
USE LAYERS
USE CONSOLEBITMAP
USE HEAPCORE
USE CONSOLETYPES

BYTE POINTER pointerClient
INPUTDEVICE.Consumer receiver
LONGCARD wakeMask,route
INT cursorX,cursorY
CARD buttons
BYTE dirty,acquired,signalBit,released
INPUT.Event ARRAY deferredKeys(CONSOLETYPES.RAW_SLOTS)
BYTE keyHead,keyCount,keyLost

; Menu and gesture interpretation may wait for a caller-owned scene. Retain
; captured route identities while GEM inbox delivery remains live.
PROC DeferKey(INPUT.Event POINTER captured)
  BYTE slot

  EXEC.Forbid()
  IF keyCount=CONSOLETYPES.RAW_SLOTS THEN
    keyLost=1
    EXEC.Permit()
    RETURN
  FI
  slot=(keyHead+keyCount) MOD CONSOLETYPES.RAW_SLOTS
  A816MEMORY.Move(BYTE POINTER(@deferredKeys(slot)),BYTE POINTER(captured),
      INPUT.EVENT_BYTES)
  keyCount==+1
  EXEC.Permit()

RETURN

BYTE FUNC SnapshotKey(INPUT.Event POINTER captured)
  AESSNAPSHOT.WindowRoute target
  AESTYPES.InputRecord keySample

  LET service=AESSTATE.Get()
  IF service<>NULL AND captured.kind<>INPUT.EVENT_LOSS THEN
    EXEC.Forbid()
    service.directory.mouse.qualifiers=INT(AESKEYS.Qualifiers(captured.qualifiers))
    EXEC.Permit()
  FI

  ; Reserve global shortcuts and menu keys for the independent manager queue.
  ; This is classification of copied input, never menu interpretation/drawing.
  IF AESSNAPSHOT.MenuActive()<>0
      OR (captured.kind=INPUT.EVENT_KEY
        AND (captured.qualifiers & INPUT.CONTROL)<>0 AND buttons=0
        AND ((captured.code & 63)=44 OR (captured.code & 63)=28)
        AND AESMOUSE.NativeGesture()=0) THEN
    DeferKey(captured)
    RETURN(1)
  FI
  target.endpoint=NULL
  IF AESSNAPSHOT.Select(AESSNAPSHOT.KEY_ROUTE,captured.route,0,0,@target)=0 THEN
    RETURN(0)
  FI
  IF target.endpoint<>NULL THEN
    keySample.window=target.handle
    keySample.windowEpoch=target.epoch
    EXEC.Forbid()
    keySample.x=cursorX
    keySample.y=cursorY
    keySample.buttons=buttons
    EXEC.Permit()
    AESKEYS.KeyEndpoint(target.endpoint,captured,@keySample)
    AESSNAPSHOT.Drop(target.endpoint)
  ELSE
    DeferKey(captured)
  FI

RETURN(1)

; Device delivery always follows copied routing. SystemOwned may describe a
; different Task's scene scope and never authorizes this input callback.
PUBLIC BYTE FUNC CaptureKey(INPUT.Event POINTER captured)
  BYTE handled

  handled=SnapshotKey(captured)
  IF keyCount<>0 OR keyLost<>0 THEN
    BEGIN
      LET desktop=DESKSTATE.Get()
      IF desktop<>NULL AND wakeMask<>0 THEN
        EXEC.Signal(desktop.owner,wakeMask)
      FI
    END
  FI

RETURN(handled)

PUBLIC LONGCARD FUNC Mask()

RETURN(wakeMask)

PUBLIC BYTE FUNC Start()
  CARD status

  signalBit=EXEC.AllocSignal(-1)
  IF signalBit=$ff THEN
    RETURN(0)
  FI

  wakeMask=LONGCARD(1) LSH signalBit
  pointerClient=INPUTCLIENT.Open()
  IF pointerClient<>NULL THEN
    A816MEMORY.Clear(BYTE POINTER(@receiver),INPUTDEVICE.CONSUMER_BYTES)
    receiver.version=INPUTDEVICE.VERSION
    receiver.sources=INPUTDEVICE.POINTER_SET
    receiver.entry=LONGCARD(ADDRESS(@CapturePointer))
    receiver.pointerConfig.pointerProtocol=INPUT.POINTER_ST
    receiver.pointerConfig.pointerPort=INPUT.POINTER_PORT
    receiver.pointerConfig.flags=INPUT.POINTER_RELATIVE
    ; Initialize all callback state before source acquisition can deliver.
    DESKDRAG.Reset()
    AESMOUSE.Reset()
    cursorX=320
    cursorY=120
    DESKMOUSE.Start(cursorX,cursorY,DESKMOUSECONFIG.DEFAULT)
    buttons=0
    released=0
    keyHead=0
    keyCount=0
    keyLost=0
    dirty=1
    status=INPUTCLIENT.Attach(pointerClient,@receiver)
    IF status=INPUT.OK THEN
      status=INPUTCLIENT.CreateRoute(pointerClient,INPUT.SOURCE_POINTER,0,@route)
      IF status=INPUT.OK THEN
        status=INPUTCLIENT.PublishRoute(pointerClient,INPUT.SOURCE_POINTER,route)
      FI
      IF status=INPUT.OK THEN
        acquired=1
        RETURN(1)
      FI
      status=INPUTCLIENT.Detach(pointerClient)
      IF status<>INPUT.OK THEN
        HEAPCORE.Abort($faea)
      FI
    FI
    INPUTCLIENT.Close(pointerClient)
    pointerClient=NULL
  FI
  EXEC.FreeSignal(signalBit)
  wakeMask=0

RETURN(0)

PUBLIC PROC Stop()
  CARD status
  BYTE drawn

  IF acquired<>0 THEN
    ; Acknowledgment retires callbacks before manager/cursor state or signals.
    status=INPUTCLIENT.Detach(pointerClient)
    IF status<>INPUT.OK THEN
      HEAPCORE.Abort($faea)
    FI
    INPUTCLIENT.Close(pointerClient)
    pointerClient=NULL
    AESINPUT.Clear()
    DESKDRAG.Cancel()
    DESKDRAG.Present()
    drawn=CONSOLEBITMAP.Cursor(CARD(cursorX),CARD(cursorY),0)
    EXEC.FreeSignal(signalBit)
    acquired=0
    wakeMask=0
    route=0
    dirty=0


  FI

RETURN


; Return handled for graphical routes, including events captured before focus
; moved. Console routes continue through the existing CON translation path.
BYTE FUNC RouteKey(INPUT.Event POINTER captured)
  AESTYPES.InputRecord keySample
  BYTE slot,handled

  LET service=DESKSTATE.Get()
  IF service=NULL OR acquired=0 THEN
    RETURN(0)
  FI

  handled=DESKMENU.Key(captured,buttons)
  IF handled=DESKMENU.KEY_DEFERRED THEN
    RETURN(handled)
  FI
  IF handled<>0 THEN
    RETURN(1)
  FI

  IF DESKDRAG.Escape(captured)<>0 THEN
    RETURN(1)
  FI

  FOR slot=0 TO DESKTYPES.WINDOWS-1 DO
    BEGIN
      LET window=@service.windows(slot)
      IF window.id<>0 AND window.keyRoute<>0 AND window.keyRoute=captured.route THEN
        BEGIN
          LET client=AESWINDOWSTATE.Find(window.id)
          keySample.window=window.gui.window
          keySample.windowEpoch=window.view.epoch
          keySample.x=cursorX
          keySample.y=cursorY
          keySample.buttons=buttons
          AESKEYS.Key(client,captured,@keySample)
        END
        RETURN(1)
      FI
    END
  OD

RETURN(0)

PROC Replay()
  INPUT.Event captured
  BYTE handled

  IF keyLost<>0 THEN
    ; Consume the old loss before callbacks can capture a new stream.
    EXEC.Forbid()
    keyHead=0
    keyCount=0
    keyLost=0
    EXEC.Permit()
    DESKMENU.Cancel()

    DESKDRAG.Cancel()


  FI
  WHILE keyCount<>0 AND keyLost=0 AND DESKMENU.InputBlocked()=0 DO
    EXEC.Forbid()
    A816MEMORY.Move(BYTE POINTER(@captured),
        BYTE POINTER(@deferredKeys(keyHead)),INPUT.EVENT_BYTES)
    EXEC.Permit()
    handled=RouteKey(@captured)
    IF handled=DESKMENU.KEY_DEFERRED THEN
      EXIT
    FI
    EXEC.Forbid()
    IF keyLost=0 THEN
      keyHead=(keyHead+1) MOD CONSOLETYPES.RAW_SLOTS
      keyCount==-1
    FI
    EXEC.Permit()
  OD

RETURN

PUBLIC PROC ReplayKeys()

  IF keyCount=0 AND keyLost=0 THEN
    RETURN
  FI
  IF AESLOCKS.SystemBegin()<>0 THEN
    Replay()
    DESKFINISH.Finish()
    AESLOCKS.SystemEnd()
  FI

RETURN

PROC Consume(INPUT.Event POINTER sample)
  BYTE slot

  LET service=DESKSTATE.Get()
  IF sample.kind=INPUT.EVENT_LOSS THEN
    DESKMENU.Cancel()
    released=0
    DESKDRAG.Cancel()
    RETURN
  FI
  IF sample.buttons=0 THEN
    released=1
  FI
  IF DESKMENU.Active()<>0 AND DESKMENU.Mouse(sample)<>0 THEN
    RETURN
  FI
  IF DESKDRAG.Capture(sample,released)<>0 THEN
    RETURN
  FI
  IF DESKMENU.Mouse(sample)<>0 THEN
    RETURN
  FI

  LET layerId=LAYERS.Hit(@service.scene,sample.x,sample.y)
  FOR slot=0 TO DESKTYPES.WINDOWS-1 DO
    BEGIN
      LET window=@service.windows(slot)
      IF window.id<>0 AND window.layer=layerId THEN
        IF sample.kind=INPUT.EVENT_BUTTON AND (sample.buttons & INPUT.LEFT)<>0
            AND released<>0 AND service.focus<>window.id THEN
          AESWINDOWSTATE.Control(window,AESTYPES.GUI_TOPPED,0,0,0,0)
        FI
        RETURN
      FI
    END
  OD

RETURN

; Only an existing native capture can proceed ahead of queued acquisitions.
; Fresh gestures and focus changes keep their normal gates.
BYTE FUNC MouseReady()

RETURN(AESLOCKS.MouseBlocked()=0 OR DESKSTATE.managerCapture<>0)

; Existing captures may finish under their retained gesture authority. Fresh
; native interpretation needs UPDATE; routing into a GEM inbox does not.
BYTE FUNC MouseEnter()

  IF AESLOCKS.SystemBegin()<>0 THEN
    RETURN(2)
  FI

RETURN(0)

; Classify fresh absolute capture once, before any deferred native replay.
PROC Fresh(INPUT.Event POINTER sample)
  AESSTATE.PointerTarget target

  ; Observe the latest cursor separately from retained gesture events.
  IF sample.kind<>INPUT.EVENT_LOSS THEN
    EXEC.Forbid()
    buttons=sample.buttons
    cursorX=sample.x
    cursorY=sample.y
    EXEC.Permit()
    BEGIN
      LET service=AESSTATE.Get()
      IF service<>NULL THEN
        EXEC.Forbid()
        service.directory.mouse.x=cursorX
        service.directory.mouse.y=cursorY
        service.directory.mouse.buttons=INT(buttons & INPUT.LEFT)
        IF sample.kind=INPUT.EVENT_BUTTON THEN
          service.directory.mouse.qualifiers=INT(AESKEYS.Qualifiers(sample.qualifiers))
        FI
        EXEC.Permit()
      FI
    END
    dirty=1
  FI

  EXEC.Forbid()
  IF AESMOUSE.Route(sample)=0 THEN
    AESMOUSE.Target(@target)
    AESMOUSE.Retained()
    AESINPUT.Push(sample,@target)
  FI
  EXEC.Permit()

RETURN

; Physical device callback: normalize once, publish ordinary events and queue
; manager interaction. It never claims a scene, UPDATE or a drawing grant.
PUBLIC PROC CapturePointer(LONGCARD context INPUT.Event POINTER captured)
  INPUT.Event sample

  A816MEMORY.Move(BYTE POINTER(@sample),BYTE POINTER(captured),INPUT.EVENT_BYTES)
  DESKMOUSE.Apply(@sample)
  Fresh(@sample)
  AESMOUSE.RefreshSnapshot()
  LET desktop=DESKSTATE.Get()
  IF desktop<>NULL AND wakeMask<>0 THEN
    EXEC.Signal(desktop.owner,wakeMask)
  FI

RETURN

; UPDATE protects live interpretation. A retained press must still name the
; same window epoch and hit its own layer; movement follows the active gesture.
BYTE FUNC TargetLive(INPUT.Event POINTER sample AESSTATE.PointerTarget POINTER target)

  IF sample.kind<>INPUT.EVENT_BUTTON OR (sample.buttons & INPUT.LEFT)=0
      OR target.window=0 THEN
    RETURN(1)
  FI
  LET service=DESKSTATE.Get()
  LET window=DESKCORE.Find(service,target.window)
  IF window=NULL THEN
    RETURN(0)
  FI
  IF target.epoch<>0 THEN
    IF window.view=NULL OR window.view.epoch<>target.epoch THEN
      RETURN(0)
    FI
  FI

RETURN(LAYERS.Hit(@service.scene,sample.x,sample.y)=window.layer)

; Only retained manager interactions run here. Physical capture and ordinary
; application inbox delivery continue independently in input.device.
PUBLIC PROC Service()
  INPUT.Event sample
  AESSTATE.PointerTarget target
  CARD count
  BYTE scope

  IF acquired=0 THEN
    RETURN
  FI
  IF AESLOCKS.SystemBegin()<>0 THEN
    AESSNAPSHOT.Publish()
    AESLOCKS.SystemEnd()
  FI
  count=0
  WHILE count<16 AND AESINPUT.Pending()<>0 DO
    scope=MouseEnter()
    IF scope=0 THEN
      EXIT
    FI
    IF DESKMENU.InputBlocked()<>0 THEN
      AESLOCKS.SystemEnd()
      EXIT
    FI
    IF AESINPUT.Pop(@sample,@target)<>0 THEN
      IF TargetLive(@sample,@target)<>0 THEN
        Consume(@sample)
      ELSE
        DESKMENU.Cancel()
        DESKDRAG.Cancel()
      FI
      AESSNAPSHOT.Drop(target.endpoint)
      DESKFINISH.Finish()
    FI
    IF scope=2 THEN
      DESKSTATE.managerCapture=DESKDRAG.Continuing()
      AESLOCKS.SystemEnd()
    FI
    count==+1
  OD
  IF AESLOCKS.SystemBegin()<>0 THEN
    AESMOUSE.Refresh()
    AESLOCKS.SystemEnd()
  FI

RETURN

; Active-service boundary: the signal field is only a read-only arrival hint.
; Acknowledge through Exec, never by writing Task state. An interrupt arriving
; after the hint or after an empty read retains its bit for the next boundary
; or Wait. Service also drains retained input and eligible AES replay.
PUBLIC PROC Boundary()
  LONGCARD bits

  IF acquired=0 THEN
    RETURN
  FI

  LET desktop=DESKSTATE.Get()
  LET owner=desktop.owner
  bits=0
  IF (owner.tc_SigRecvd & wakeMask)<>0 THEN
    bits=EXEC.SetSignal(0,wakeMask)
  FI
  Service()

RETURN

; Commit retained gestures after AES admission, preserving input ordering.
PUBLIC PROC Advance()

  IF acquired=0 THEN
    RETURN
  FI


  DESKDRAG.Advance()
  IF AESLOCKS.SystemBegin()<>0 THEN
    DESKFINISH.Finish()
    AESLOCKS.SystemEnd()
  FI

RETURN

; The C overlay restores its saved pixels before intersecting draws. Redraw it
; last, after each quiescent rendering quantum; never touch an active DMA list.
PUBLIC PROC Present()
  BYTE drawn

  BEGIN
    LET service=AESSTATE.Get()
    IF service<>NULL THEN
      AESCURSOR.Select(service)
    FI
  END
  IF acquired<>0 AND CONSOLEBITMAP.Pending()=0 AND DISPLAY.Blocked()=0 THEN
    IF MouseReady()=0 AND DESKDRAG.Application()=0 THEN
      DESKDRAG.Suspend()
    ELSE
      DESKDRAG.Present()
    FI

    IF dirty<>0 OR CONSOLEBITMAP.Changed()<>0 OR AESCURSOR.Pending()<>0 THEN
      ; Input.device can publish capture during the physical call. Consume
      ; only the old hint; retain/rearm an arrival after these coordinates.
      dirty=0
      BEGIN
        LET service=AESSTATE.Get()
        IF service<>NULL THEN
          drawn=CONSOLEBITMAP.Mouse(BYTE POINTER(@service.directory.mouse))
          IF drawn=0 AND CONSOLEBITMAP.Failed()<>0 THEN
            service.directory.mouse.status=DISPLAY.DEVICE_FAULT
          FI
        ELSE
          drawn=CONSOLEBITMAP.Cursor(CARD(cursorX),CARD(cursorY),1)
        FI
      END
      IF dirty<>0 THEN
        EXEC.Signal(EXEC.FindTask(NULL),wakeMask)
      FI
      IF drawn=0 AND CONSOLEBITMAP.Failed()=0 THEN
        dirty=1
      FI
    FI
  FI
  AESCURSOR.Wake()

RETURN

PUBLIC BYTE FUNC Runnable()

  IF acquired=0 THEN
    RETURN(0)
  FI

  IF keyLost<>0
      OR (keyCount<>0 AND DESKMENU.InputBlocked()=0
        AND AESLOCKS.SystemBlocked()=0) OR DESKMENU.Runnable()<>0
      OR DESKDRAG.Runnable()<>0 THEN
    RETURN(1)
  FI

  LET service=DESKSTATE.Get()
  IF MouseReady()<>0 AND DESKMENU.InputBlocked()=0 THEN
    IF AESINPUT.Pending()<>0 THEN
      RETURN(1)
    FI
  FI

  IF dirty=0 OR CONSOLEBITMAP.Pending()<>0 THEN
    RETURN(0)
  FI

RETURN(DISPLAY.Blocked()=0)

ENDMODULE
