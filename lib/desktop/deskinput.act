; One presenter consumes captured input. IRQ code follows no window pointers.
MODULE DESKINPUT
USE DISPLAY
USE EXEC
USE AESGATE
USE AESSNAPSHOT
USE AESLOCKS
USE AESTYPES
USE AESWINDOWSTATE
USE AESINPUT
USE AESKEYS
USE AESMOUSE
USE INPUT
USE DESKMOUSE
USE DESKMOUSECONFIG
USE A816MEMORY
USE DESKTYPES
USE DESKSTATE
USE DESKCORE
USE DESKDRAG
USE DESKTABS
USE DESKMENU
USE DESKWIDGETINPUT
USE DESKEVENTS
USE LAYERS
USE CONSOLEBITMAP
USE HEAPCORE
USE CONSOLETYPES

INPUT.Lease lease
INPUT.Config config
LONGCARD wakeMask,route,focusPending
INT cursorX,cursorY
CARD buttons
BYTE pending,dirty,acquired,signalBit,released,focusWanted,tabFocus
INPUT.Event ARRAY deferredKeys(CONSOLETYPES.RAW_SLOTS)
BYTE keyHead,keyCount,keyLost

; Native key interpretation can touch widgets/gestures. Retain captured route
; identities while a caller owns the scene; GEM inbox delivery remains live.
PROC DeferKey(INPUT.Event POINTER captured)
  BYTE slot

  IF keyCount=CONSOLETYPES.RAW_SLOTS THEN
    keyLost=1
    RETURN
  FI
  slot=(keyHead+keyCount) MOD CONSOLETYPES.RAW_SLOTS
  A816MEMORY.Move(BYTE POINTER(@deferredKeys(slot)),BYTE POINTER(captured),
      INPUT.EVENT_BYTES)
  keyCount==+1

RETURN

BYTE FUNC SnapshotKey(INPUT.Event POINTER captured)
  AESSNAPSHOT.WindowRoute target
  AESTYPES.InputRecord keySample

  target.endpoint=NULL
  IF AESSNAPSHOT.Select(AESSNAPSHOT.KEY_ROUTE,captured.route,0,0,@target)=0 THEN
    RETURN(0)
  FI
  IF target.endpoint<>NULL THEN
    keySample.window=target.handle
    keySample.windowEpoch=target.epoch
    keySample.x=cursorX
    keySample.y=cursorY
    keySample.buttons=buttons
    AESKEYS.KeyEndpoint(target.endpoint,captured,@keySample)
    AESSNAPSHOT.Drop(target.endpoint)
  ELSE
    DeferKey(captured)
  FI

RETURN(1)

PUBLIC LONGCARD FUNC Mask()

RETURN(wakeMask)

PUBLIC BYTE FUNC FreshPending()

RETURN(pending)

PUBLIC BYTE FUNC Start()
  CARD status

  signalBit=EXEC.AllocSignal(-1)
  IF signalBit=$ff THEN
    RETURN(0)
  FI

  wakeMask=LONGCARD(1) LSH signalBit
  A816MEMORY.Clear(BYTE POINTER(@config),INPUT.CONFIG_BYTES)
  config.version=INPUT.VERSION
  config.source=INPUT.SOURCE_POINTER
  config.wakeMask=wakeMask
  config.pointerProtocol=INPUT.POINTER_ST
  config.pointerPort=INPUT.POINTER_PORT
  config.flags=INPUT.POINTER_RELATIVE
  status=INPUT.Acquire(@lease,@config)
  IF status=INPUT.OK THEN
    status=INPUT.CreateRoute(@lease,0,@route)
    IF status=INPUT.OK THEN
      status=INPUT.PublishRoute(@lease,route)
    FI

    IF status<>INPUT.OK THEN
      status=INPUT.Release(@lease)
    ELSE
      acquired=1
      DESKDRAG.Reset()
      AESMOUSE.Reset()
      cursorX=320
      cursorY=120
      DESKMOUSE.Start(cursorX,cursorY,DESKMOUSECONFIG.DEFAULT)
      buttons=0
      released=0
      pending=1
      dirty=1
      focusWanted=0
      tabFocus=0
      RETURN(1)
    FI
  FI

  EXEC.FreeSignal(signalBit)
  wakeMask=0

RETURN(0)

PUBLIC PROC Stop()
  CARD status
  BYTE drawn

  IF acquired<>0 THEN
    DESKWIDGETINPUT.Lost()
    DESKWIDGETINPUT.Advance()
    DESKTABS.Cancel()
    DESKDRAG.Cancel()
    DESKDRAG.Present()
    drawn=CONSOLEBITMAP.Cursor(CARD(cursorX),CARD(cursorY),0)
    status=INPUT.Release(@lease)
    IF status<>INPUT.OK THEN
      HEAPCORE.Abort($faea)
    FI

    EXEC.FreeSignal(signalBit)
    acquired=0
    wakeMask=0
    route=0
    pending=0
    dirty=0
    focusWanted=0
    tabFocus=0
  FI

RETURN

PROC Copy(INPUT.Event POINTER captured DESKTYPES.Event POINTER event)

  A816MEMORY.Clear(BYTE POINTER(event),DESKTYPES.EVENT_SIZE)
  event.route=captured.route
  event.tick=captured.tick
  event.flags=CARD(captured.flags)
  event.x=captured.x
  event.y=captured.y
  event.code=captured.code
  event.buttons=captured.buttons
  event.qualifiers=captured.qualifiers

RETURN

; Leave captured keys queued until the menu snapshot has been committed.
PUBLIC BYTE FUNC KeyReady()

RETURN(AESGATE.SystemOwned()=0 OR DESKMENU.InputBlocked()=0)

; Return handled for graphical routes, including events captured before focus
; moved. Console routes continue through the existing CON translation path.
PUBLIC BYTE FUNC Key(INPUT.Event POINTER captured)
  DESKTYPES.Event event
  AESTYPES.InputRecord keySample
  BYTE slot

  IF AESGATE.SystemOwned()=0 THEN
    RETURN(SnapshotKey(captured))
  FI
  LET service=DESKSTATE.Get()
  IF service=NULL OR acquired=0 THEN
    RETURN(0)
  FI

  IF DESKMENU.Key(captured,buttons)<>0 THEN
    RETURN(1)
  FI

  IF DESKTABS.Active()<>0 AND ((captured.kind=INPUT.EVENT_KEY
      AND (captured.code & 63)=28) OR captured.kind=INPUT.EVENT_CANCEL
      OR captured.kind=INPUT.EVENT_LOSS) THEN
    DESKTABS.Cancel()
    RETURN(1)
  FI

  IF DESKDRAG.Escape(captured)<>0 THEN
    RETURN(1)
  FI

  FOR slot=0 TO DESKTYPES.WINDOWS-1 DO
    BEGIN
      LET window=@service.windows(slot)
      IF window.id<>0 AND window.keyRoute<>0 AND window.keyRoute=captured.route THEN
        IF window.kind=DESKTYPES.CONTENT_AES THEN
          BEGIN
            LET client=AESWINDOWSTATE.Find(window.id)
            LET item=AESWINDOWSTATE.FindRecord(window.id)
            keySample.window=item.gui.window
            keySample.windowEpoch=item.view.epoch
            keySample.x=cursorX
            keySample.y=cursorY
            keySample.buttons=buttons
            AESKEYS.Key(client,captured,@keySample)
          END
          RETURN(1)
        FI

        Copy(captured,@event)
        event.window=window.id
        event.kind=DESKTYPES.EVENT_KEY
        IF captured.kind=INPUT.EVENT_LOSS THEN
          event.kind=DESKTYPES.EVENT_LOSS
        ELSEIF captured.kind=INPUT.EVENT_CANCEL THEN
          event.kind=DESKTYPES.EVENT_CANCEL
        FI

        IF DESKWIDGETINPUT.Key(window,@event)=0 THEN
          DESKEVENTS.Post(service,window.client,@event)
        FI
        RETURN(1)
      FI
    END
  OD

RETURN(0)

PUBLIC PROC ReplayKeys()
  INPUT.Event captured
  DESKTYPES.Event loss
  BYTE handled,slot

  IF AESGATE.SystemOwned()=0 THEN
    RETURN
  FI
  IF keyLost<>0 THEN
    ; Consume the old loss before callbacks can capture a new stream.
    keyHead=0
    keyCount=0
    keyLost=0
    DESKMENU.Cancel()
    DESKTABS.Cancel()
    DESKDRAG.Cancel()
    DESKWIDGETINPUT.Lost()
    A816MEMORY.Clear(BYTE POINTER(@loss),DESKTYPES.EVENT_SIZE)
    loss.kind=DESKTYPES.EVENT_LOSS
    BEGIN
      LET service=DESKSTATE.Get()
      FOR slot=0 TO DESKTYPES.CLIENTS-1 DO
        IF service.clients(slot).id<>0 THEN
          DESKEVENTS.Post(service,service.clients(slot).id,@loss)
        FI
      OD
    END
  FI
  WHILE keyCount<>0 AND keyLost=0 AND DESKMENU.InputBlocked()=0 DO
    A816MEMORY.Move(BYTE POINTER(@captured),
        BYTE POINTER(@deferredKeys(keyHead)),INPUT.EVENT_BYTES)
    keyHead=(keyHead+1) MOD CONSOLETYPES.RAW_SLOTS
    keyCount==-1
    handled=Key(@captured)
  OD

RETURN

PROC Consume(INPUT.Event POINTER sample)
  DESKTYPES.Event event
  BYTE slot,handled
  LONGCARD layerId

  LET service=DESKSTATE.Get()
  Copy(sample,@event)
  IF sample.kind=INPUT.EVENT_LOSS THEN
    AESMOUSE.Lost()
    DESKMENU.Cancel()
    released=0
    DESKWIDGETINPUT.Lost()
    focusWanted=0
    tabFocus=0
    DESKTABS.Cancel()
    DESKDRAG.Cancel()
    event.kind=DESKTYPES.EVENT_LOSS
    FOR slot=0 TO DESKTYPES.CLIENTS-1 DO
      IF service.clients(slot).id<>0 THEN
        DESKEVENTS.Post(service,service.clients(slot).id,@event)
      FI
    OD

    RETURN
  FI

  IF sample.buttons=0 THEN
    released=1
  FI

  IF DESKMENU.Active()<>0 AND DESKMENU.Mouse(sample)<>0 THEN
    focusWanted=0
    tabFocus=0
    RETURN
  FI

  event.kind=DESKTYPES.EVENT_MOTION
  IF sample.kind=INPUT.EVENT_BUTTON THEN
    event.kind=DESKTYPES.EVENT_BUTTON
  FI

  handled=DESKTABS.Captured(sample)
  IF handled<>0 THEN
    IF handled=2 THEN
      focusPending=service.consoleWindow
      focusWanted=1
      tabFocus=1
    FI
    RETURN
  FI

  IF DESKWIDGETINPUT.Captured(@event)<>0 THEN
    RETURN
  FI

  IF DESKDRAG.Capture(sample,released)<>0 THEN
    focusWanted=0
    tabFocus=0
    RETURN
  FI

  IF DESKMENU.Mouse(sample)<>0 THEN
    focusWanted=0
    tabFocus=0
    RETURN
  FI

  layerId=LAYERS.Hit(@service.scene,sample.x,sample.y)
  FOR slot=0 TO DESKTYPES.WINDOWS-1 DO
    BEGIN
      LET window=@service.windows(slot)
      IF window.id<>0 AND window.layer=layerId THEN
        IF window.kind=DESKTYPES.CONTENT_AES THEN
          IF sample.kind=INPUT.EVENT_BUTTON AND (sample.buttons & INPUT.LEFT)<>0
              AND released<>0 AND service.focus<>window.id THEN
            AESWINDOWSTATE.Control(window,AESTYPES.GUI_TOPPED,0,0,0,0)
          FI

          RETURN
        FI

        IF DESKTABS.Mouse(window,sample,released)<>0 THEN
          RETURN
        FI

        event.window=window.id
        event.kind=DESKTYPES.EVENT_MOTION
        IF sample.kind=INPUT.EVENT_BUTTON THEN
          event.kind=DESKTYPES.EVENT_BUTTON
          IF (sample.buttons & INPUT.LEFT)<>0 AND released<>0 THEN
            focusPending=window.id
            focusWanted=1
            tabFocus=0
          FI
        FI

        IF DESKWIDGETINPUT.Mouse(window,@event)<>0 THEN
          focusWanted=0
          tabFocus=0
        ELSE
          DESKEVENTS.Post(service,window.client,@event)
        FI
        EXIT
      FI
    END
  OD

RETURN

; Only an existing native capture can proceed ahead of queued acquisitions.
; Fresh gestures, focus changes and widget actions keep their normal gates.
BYTE FUNC MouseReady()

RETURN(AESLOCKS.MouseBlocked()=0 OR DESKDRAG.Continuing()<>0
    OR DESKTABS.Active()<>0)

; Classify fresh absolute capture once, before any deferred native replay.
PROC Fresh(INPUT.Event POINTER sample)

  ; Observe the latest cursor separately from retained gesture events.
  IF sample.kind<>INPUT.EVENT_LOSS THEN
    buttons=sample.buttons
    cursorX=sample.x
    cursorY=sample.y
    dirty=1
  FI

  IF AESMOUSE.Route(sample)=0 THEN
    IF AESGATE.SystemOwned()=0 OR MouseReady()=0
        OR DESKMENU.InputBlocked()<>0 THEN
      AESMOUSE.Retained()
      AESINPUT.Push(sample)
    ELSE
      Consume(sample)
    FI
  FI

RETURN

; Retain a hint only until an actual empty observation. Never poll while idle.
PUBLIC PROC Service(LONGCARD bits)
  INPUT.Event sample
  CARD count,status

  IF acquired=0 THEN
    RETURN
  FI

  IF AESGATE.SystemOwned()<>0 THEN
    AESSNAPSHOT.Publish()
  FI
  IF (bits & wakeMask)<>0 THEN
    pending=1
  FI

  count=0
  WHILE count<16 DO
    IF AESGATE.SystemOwned()<>0 AND MouseReady()<>0
        AND DESKMENU.InputBlocked()=0
        AND AESINPUT.Pop(@sample)<>0 THEN
      Consume(@sample)
    ELSE
      IF pending=0 THEN
        EXIT
      FI

      status=INPUT.Take(@lease,@sample)
      IF status=INPUT.EMPTY THEN
        pending=0
        EXIT
      FI

      IF status<>INPUT.OK THEN
        HEAPCORE.Abort($faeb)
      FI

      ; Transform fresh capture once; replayed AES input is already absolute.
      DESKMOUSE.Apply(@sample)
      Fresh(@sample)
    FI

    count==+1
  OD

  IF AESGATE.SystemOwned()<>0 THEN
    DESKTABS.Observe()
    AESMOUSE.Refresh()
  ELSE
    AESMOUSE.RefreshSnapshot()
  FI

RETURN

; Active-service boundary: the signal field is only a read-only arrival hint.
; Acknowledge through Exec, never by writing Task state. An interrupt arriving
; after the hint or after an empty read retains its bit for the next boundary
; or Wait. Service also drains retained input and eligible AES replay.
PUBLIC PROC Boundary()
  LONGCARD bits

  IF acquired=0 THEN
    RETURN
  FI

  LET desktop=DESKSTATE.Get()
  LET owner=desktop.owner
  bits=0
  IF (owner.tc_SigRecvd & wakeMask)<>0 THEN
    bits=EXEC.SetSignal(0,wakeMask)
  FI
  Service(bits)

RETURN

; Commit retained gestures after native control admission, preserving the
; established ordering between application patches and widget state changes.
PUBLIC PROC Advance()

  IF acquired=0 THEN
    RETURN
  FI

  DESKTABS.Observe()
  DESKWIDGETINPUT.Advance()
  DESKDRAG.Advance()
  DESKMENU.Advance()
  LET service=DESKSTATE.Get()
  IF focusWanted<>0 AND service.scene.busy=0 AND AESLOCKS.MouseBlocked()=0 THEN
    BEGIN
      LET window=DESKCORE.Find(service,focusPending)
      IF window<>NULL THEN
        BEGIN
          LET layer=DESKCORE.Layer(service,window)
          IF layer<>NULL AND layer.shown<>0 THEN
            IF tabFocus<>0 THEN
              BEGIN
                LET ignored=DESKCORE.Top(service,window)
              END
            ELSE
              DESKCORE.Focus(service,window.id)
            FI
          FI
        END
      FI
    END
    focusWanted=0
    tabFocus=0
  FI

RETURN

; The C overlay restores its saved pixels before intersecting draws. Redraw it
; last, after each quiescent rendering quantum; never touch an active DMA list.
PUBLIC PROC Present()
  BYTE drawn

  IF acquired<>0 AND CONSOLEBITMAP.Pending()=0 AND DISPLAY.Blocked()=0 THEN
    IF MouseReady()=0 AND DESKDRAG.Application()=0 THEN
      DESKDRAG.Suspend()
    ELSE
      DESKDRAG.Present()
    FI

    IF dirty<>0 OR CONSOLEBITMAP.Changed()<>0 THEN
      ; Deferred capture can run inside the physical call's Resume. Consume
      ; only the old hint; retain/rearm an arrival after these coordinates.
      dirty=0
      drawn=CONSOLEBITMAP.Cursor(CARD(cursorX),CARD(cursorY),1)
      IF dirty<>0 THEN
        EXEC.Signal(EXEC.FindTask(NULL),wakeMask)
      FI
      IF drawn=0 AND CONSOLEBITMAP.Failed()=0 THEN
        dirty=1
      FI
    FI
  FI

RETURN

PUBLIC BYTE FUNC Runnable()

  IF acquired=0 THEN
    RETURN(0)
  FI

  IF pending<>0 OR keyLost<>0
      OR (keyCount<>0 AND DESKMENU.InputBlocked()=0) OR DESKMENU.Runnable()<>0
      OR DESKWIDGETINPUT.Runnable()<>0 OR DESKDRAG.Runnable()<>0 THEN
    RETURN(1)
  FI

  LET service=DESKSTATE.Get()
  IF MouseReady()<>0 AND DESKMENU.InputBlocked()=0 THEN
    IF AESINPUT.Pending()<>0 OR (focusWanted<>0 AND service.scene.busy=0
        AND AESLOCKS.MouseBlocked()=0) THEN
      RETURN(1)
    FI
  FI

  IF dirty=0 OR CONSOLEBITMAP.Pending()<>0 THEN
    RETURN(0)
  FI

RETURN(DISPLAY.Blocked()=0)

ENDMODULE
