; One optional desktop service binding. All scene storage belongs to its owner.
MODULE DESKSTATE
USE EXEC
USE DESKTYPES
USE LAYERTYPES
USE LAYERS
USE REGIONS

DESKTYPES.Service POINTER service
LONGCARD selectedLayer,scrollToken,lossGeneration
EXEC.Task POINTER launcher
PUBLIC BYTE outlineVisible
PUBLIC LONGCARD barLayer,popupLayer,desktopWindow,desktopLayer
PUBLIC BYTE menuActive,menuReplacing
PUBLIC BYTE menuTurns

; Copies and paints share the existing two-transaction menu preference.
PUBLIC PROC MenuTurn(BYTE ordinary)

  IF ordinary<>0 THEN
    menuTurns=0
  ELSEIF menuTurns<2 THEN
    menuTurns==+1
  FI

RETURN

PUBLIC BYTE FUNC MenuTurnReady()
  BYTE slot

  IF menuTurns<2 THEN
    RETURN(1)
  FI
  FOR slot=0 TO LAYERTYPES.SLOT_COUNT-1 DO
    BEGIN
      LET layer=@service.scene.items(slot)
      IF (service.scene.visibleDamage & (CARD(1) LSH slot))<>0
          AND layer.id<>barLayer AND layer.id<>popupLayer THEN
        RETURN(0)
      FI
    END
  OD

RETURN(1)

; Keep desktop chrome above application layers within the same scene mutation.
PUBLIC PROC TopChrome()
  BYTE status

  IF service<>NULL AND desktopLayer<>0 THEN
    IF service.scene.items(service.scene.order(service.scene.count-1)).id<>desktopLayer THEN
      status=LAYERS.Order(@service.scene,desktopLayer,0)
    FI
  FI
  IF service<>NULL AND barLayer<>0 THEN
    IF service.scene.count>=2
        AND service.scene.items(service.scene.order(0)).id=popupLayer
        AND service.scene.items(service.scene.order(1)).id=barLayer THEN
      RETURN
    FI
    status=LAYERS.Order(@service.scene,barLayer,1)
    status=LAYERS.Order(@service.scene,popupLayer,1)
  FI

RETURN

PUBLIC DESKTYPES.Service POINTER FUNC Get()

RETURN(service)

; Presenter-only preparation while an opening layer is still hidden.
PUBLIC BYTE FUNC PrepareOpen(LONGCARD id)

  IF id=desktopLayer THEN
    RETURN(LAYERS.Order(@service.scene,id,0))
  FI
  IF barLayer<>0 THEN
    RETURN(LAYERS.OrderBelow(@service.scene,id,barLayer))
  FI

RETURN(LAYERS.Order(@service.scene,id,1))

; Chrome occupies the first two ranks. Raising the front application past it
; and restoring chrome would damage an unchanged window on every title click.
PUBLIC BYTE FUNC Raise(LONGCARD id)
  BYTE rank,status

  IF id<>desktopLayer THEN
    FOR rank=0 TO service.scene.count-1 DO
      BEGIN
        LET layer=@service.scene.items(service.scene.order(rank))
        IF layer.id<>barLayer AND layer.id<>popupLayer THEN
          IF layer.id=id THEN
            RETURN(LAYERTYPES.OK)
          FI
          EXIT
        FI
      END
    OD
  FI

  status=LAYERS.Order(@service.scene,id,id<>desktopLayer)
  TopChrome()

RETURN(status)

; Startup/retirement only, before publishing clients or after their final reply.
PUBLIC PROC Bind(DESKTYPES.Service POINTER value)

  service=value

RETURN

PUBLIC BYTE FUNC Enabled()

RETURN(service<>NULL)

PUBLIC PROC Select(LONGCARD id)

  selectedLayer=id

RETURN

PUBLIC LONGCARD FUNC Selected()

RETURN(selectedLayer)

PUBLIC PROC SetLauncher(EXEC.Task POINTER task)

  launcher=task

RETURN

PUBLIC EXEC.Task POINTER FUNC Owner()

RETURN(launcher)

; Only complete, clean visible pixels can be reused for a console scroll.
PUBLIC BYTE FUNC CopyReady()

  IF service=NULL THEN
    RETURN(1)
  FI

  IF service.scene.busy<>0 OR selectedLayer=0 THEN
    RETURN(0)
  FI

  LET layer=LAYERS.Find(@service.scene,selectedLayer)
  IF layer=NULL THEN
    RETURN(0)
  FI

RETURN(layer.dirty=0 AND layer.shown<>0 AND layer.visible.count=1
    AND REGIONS.Equal(@layer.bounds,@layer.visible.rects(0))<>0)

PUBLIC PROC SetScrollToken(LONGCARD token)

  scrollToken=token

RETURN

PUBLIC LONGCARD FUNC PendingToken()

RETURN(scrollToken)

PUBLIC PROC Lost()

  lossGeneration==+1

RETURN

PUBLIC LONGCARD FUNC LossEpoch()

RETURN(lossGeneration)

ENDMODULE
