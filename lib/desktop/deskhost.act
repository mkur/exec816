; SCRENMGR lifecycle and controller-side shutdown admission.
MODULE DESKHOST
USE EXEC
USE DESKSTATE
USE DESKTYPES
USE DESKCORE
USE HEAPCORE
USE DESKINPUT
USE CONSOLECAPTURE
USE CONSOLEWINDOWS
USE AESHOST
USE AESSTATE
USE AESLOCKS
USE DESKMENU


PUBLIC BYTE FUNC Start()
  BYTE bit,stopped

  LET service=DESKSTATE.Get()
  IF service=NULL THEN
    RETURN(1)
  FI

  bit=EXEC.AllocSignal(-1)
  IF bit=$ff THEN
    RETURN(0)
  FI

  IF DESKCORE.Init(service,bit)=0 THEN
    EXEC.FreeSignal(bit)
    RETURN(0)
  FI

  IF DESKMENU.Start()=0 THEN
    stopped=DESKCORE.Stop(service)
    EXEC.FreeSignal(bit)
    RETURN(0)
  FI

  LET windows=CONSOLEWINDOWS.Registry()
  service.keyboard=CONSOLECAPTURE.Binding()
  service.consoleFocus=@windows.focusSlot
  IF DESKINPUT.Start()=0 THEN
    DESKMENU.Stop()
    stopped=DESKCORE.Stop(service)
    EXEC.FreeSignal(bit)
    RETURN(0)
  FI

  AESHOST.Start()

RETURN(1)

PUBLIC LONGCARD FUNC Mask()

  LET service=DESKSTATE.Get()
  IF service=NULL THEN
    RETURN(0)
  FI

RETURN(service.mask OR DESKINPUT.Mask() OR AESHOST.Mask())

BYTE FUNC InspectIdle()

  IF AESHOST.Idle()=0 THEN
    RETURN(0)
  FI

  LET service=DESKSTATE.Get()
  IF service=NULL THEN
    RETURN(1)
  FI

  IF service.scene.busy<>0 OR AESHOST.Runnable()<>0 THEN
    RETURN(0)
  FI


RETURN(1)

PUBLIC PROC Stop()

  LET service=DESKSTATE.Get()
  IF service<>NULL AND service.live<>0 THEN
    DESKINPUT.Stop()
    DESKMENU.Stop()
    IF DESKCORE.Stop(service)=0 THEN
      HEAPCORE.Abort($fae2)
    FI

    EXEC.FreeSignal(service.signalBit)
  FI

  ; Input/scene teardown above may still consult AES gates. Retire AES
  ; last, before publishing that the controller can reclaim its allocation.
  AESHOST.Stop()

RETURN

; Shutdown readiness is also called by the console controller. Its short
; resource borrow must not inherit the frontend's retained operation state.
PUBLIC BYTE FUNC Idle()
  BYTE result

  LET aes=AESSTATE.Get()
  IF aes=NULL THEN
    RETURN(InspectIdle())
  FI
  IF AESLOCKS.AttemptUI()=0 THEN
    RETURN(0)
  FI
  result=InspectIdle()
  AESLOCKS.ReleaseUI()

RETURN(result)

ENDMODULE
