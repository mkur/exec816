; Lifecycle and scheduling hooks in the existing console presenter Task.
MODULE DESKHOST
USE DISPLAY
USE EXEC
USE DESKSTATE
USE DESKTYPES
USE DESKCORE
USE DESKMOVE
USE DESKCACHE
USE DESKMENUCACHE
USE CONSOLEBITMAP
USE LAYERS
USE LAYERTYPES
USE REGIONS
USE DESKPAINT
USE HEAPCORE
USE DESKINPUT
USE CONSOLECAPTURE
USE CONSOLEWINDOWS
USE AESHOST
USE AESLOCKS
USE DESKMENU

BYTE lateAES

PUBLIC BYTE FUNC Start()
  BYTE bit,stopped

  LET service=DESKSTATE.Get()
  IF service=NULL THEN
    RETURN(1)
  FI

  bit=EXEC.AllocSignal(-1)
  IF bit=$ff THEN
    RETURN(0)
  FI

  IF DESKCORE.Init(service,bit)=0 THEN
    EXEC.FreeSignal(bit)
    RETURN(0)
  FI

  IF DESKMENU.Start()=0 THEN
    stopped=DESKCORE.Stop(service)
    EXEC.FreeSignal(bit)
    RETURN(0)
  FI

  LET windows=CONSOLEWINDOWS.Registry()
  service.keyboard=BYTE POINTER(CONSOLECAPTURE.GetLease())
  service.consoleFocus=@windows.focusSlot
  IF DESKINPUT.Start()=0 THEN
    DESKMENU.Stop()
    stopped=DESKCORE.Stop(service)
    EXEC.FreeSignal(bit)
    RETURN(0)
  FI

  AESHOST.Start()

RETURN(1)

PUBLIC LONGCARD FUNC Mask()

  LET service=DESKSTATE.Get()
  IF service=NULL THEN
    RETURN(0)
  FI

RETURN(service.mask OR DESKINPUT.Mask() OR AESHOST.Mask())

PUBLIC BYTE FUNC Ready()

  LET service=DESKSTATE.Get()

RETURN((service=NULL OR service.scene.busy=0) AND AESLOCKS.MouseBlocked()=0)

PUBLIC BYTE FUNC PaintReady()

  LET service=DESKSTATE.Get()

RETURN(DISPLAY.Blocked()=0 AND (service=NULL OR service.scene.busy=0)
    AND AESLOCKS.PaintBlocked()=0)

; Eligible controls that waited for the paint snapshot must get an admission
; opportunity before a fresh console write acquires that same scene again.
PUBLIC BYTE FUNC ControlPending()

  LET service=DESKSTATE.Get()

RETURN(service<>NULL AND service.live<>0 AND service.scene.busy=0
    AND AESLOCKS.MouseBlocked()=0 AND AESHOST.Runnable()<>0)

PUBLIC BYTE FUNC Idle()

  IF AESHOST.Idle()=0 THEN
    RETURN(0)
  FI

  LET service=DESKSTATE.Get()
  IF service=NULL THEN
    RETURN(1)
  FI

  IF service.scene.busy<>0 OR AESHOST.Runnable()<>0 THEN
    RETURN(0)
  FI


RETURN(1)

; A bounded active-service boundary, never an idle poll or periodic wake.
; Capture/cursor can advance between bounded AES admissions.
PUBLIC PROC InputBoundary()

  DESKINPUT.Boundary()
  DESKINPUT.Present()

RETURN

BYTE FUNC AESAdmission(BYTE POINTER remaining)

  IF remaining^=0 THEN
    RETURN(0)
  FI

  LET admitted=AESHOST.Pump(1)
  remaining^==-admitted
  IF admitted<>0 THEN
    InputBoundary()
  FI

RETURN(admitted)

; Match already admitted waits at bounded service boundaries. An alarm can
; complete during a paint/output quantum, after Controls took its clock sample.
; Collect it before yielding, without admitting another request or polling time.
PUBLIC PROC Events()

  IF AESHOST.Wake()<>0 THEN
    InputBoundary()
  FI

RETURN

; Retire a notified foreground save/restore before unrelated control work.
; This neither polls hardware nor admits requests or renews a worker budget.
PUBLIC PROC MenuContinuation()

  IF DESKMENUCACHE.Foreground()<>0 AND CONSOLEBITMAP.Pending()=0
      AND DISPLAY.Blocked()=0 THEN
    DESKMENUCACHE.Pump()
    DESKMENU.Advance()
  FI

RETURN

PUBLIC PROC Controls()
  BYTE count,admitted,aesRemaining,limit
  LONGCARD priorToken

  LET service=DESKSTATE.Get()
  IF service<>NULL AND service.live<>0 THEN
    priorToken=service.scene.busy
    DESKMENUCACHE.Pump()
    IF DESKMENUCACHE.Replacing()<>0 THEN
      DESKMENU.Advance()
    FI
    DESKCACHE.Pump(service)
    DESKMOVE.Pump()
    IF priorToken<>0 AND service.scene.busy=0 THEN
      ; Only one scene continuation can own the token. Service input after
      ; its retirement, before a control can acquire the newly free scene.
      InputBoundary()
    FI

    lateAES=0
    limit=4
    aesRemaining=4
    IF AESHOST.Runnable()<>0 AND DESKPAINT.Ready()<>0 THEN
      ; Reserve one of the shared admissions after this paint quantum. Input
      ; and visible feedback get the first opportunity; AES still advances in
      ; every drawing turn, including a long full-window repaint.
      lateAES=1
      aesRemaining=0
      limit=3
    FI
    ; The sole AES queue shares four admissions with the post-paint slot.
    count=0
    WHILE count<limit DO
      admitted=AESAdmission(@aesRemaining)
      IF admitted=0 THEN
        EXIT
      FI

      count==+admitted
    OD

    IF lateAES=0 THEN
      Events()
    FI
  FI

RETURN

PUBLIC PROC AfterPaint()
  BYTE remaining,admitted

  IF lateAES<>0 THEN
    lateAES=0
    remaining=1
    admitted=AESAdmission(@remaining)
    Events()
  FI

RETURN

PUBLIC BYTE FUNC Runnable()

  LET service=DESKSTATE.Get()
  IF service<>NULL AND service.live<>0 THEN
    IF AESHOST.Runnable()<>0 THEN
      RETURN(1)
    FI
  FI

  IF AESHOST.Runnable()<>0 OR DESKPAINT.Runnable()<>0 THEN
    RETURN(1)
  FI

RETURN(DESKINPUT.Runnable())

; Candidate bits schedule inspection; existing attempt/repair records and
; Layers remain the authority for capture and pixel validity.
BYTE FUNC CachePending(DESKTYPES.Service POINTER service)

  LET candidates=DESKCACHE.Candidates(service)
  IF service.repairs(0).state=LAYERTYPES.CACHE_CHANGE_READY
      OR service.repairs(1).state=LAYERTYPES.CACHE_CHANGE_READY
      OR DESKMENUCACHE.CapturePending()<>0 THEN
    RETURN(1)
  FI
RETURN(candidates<>0)

; Caller has just settled input, controls, model writes and painting. This
; hint never keeps the presenter awake: an occluded candidate can wait until
; the next real wake. Return whether one new transfer changed scheduling.
PUBLIC BYTE FUNC Cache()
  BYTE index,visible,started
  CARD rect
  LAYERTYPES.Rect client

  LET service=DESKSTATE.Get()
  IF service=NULL OR service.live<>1 OR CachePending(service)=0 THEN
    RETURN(0)
  FI
  IF service.scene.busy<>0
      OR AESLOCKS.PaintBlocked()<>0
      OR DISPLAY.Blocked()<>0 OR CONSOLEBITMAP.Pending()<>0
      OR CONSOLEBITMAP.Failed()<>0 THEN
    RETURN(0)
  FI

  IF DESKMENUCACHE.CapturePopup()<>0 THEN
    RETURN(1)
  FI

  ; Search for a window only when one of the two slots actually needs repair.
  FOR index=0 TO 1 DO
    IF service.repairs(index).state=LAYERTYPES.CACHE_CHANGE_READY THEN
      BEGIN
        LET window=DESKCORE.Find(service,service.cache.slots(index).identity)
        IF window<>NULL AND DESKCACHE.Patch(service,window)<>0 THEN
          RETURN(1)
        FI
      END
    FI
  OD

  FOR index=0 TO DESKTYPES.WINDOWS-1 DO
    BEGIN
      LET window=@service.windows(index)
      IF DESKCACHE.TakeCandidate(index)<>0
          AND window.id<>0
          AND window.iconified=0
          AND window.visualRevision<>0
          AND window.captureAttempt<>window.visualRevision THEN
        BEGIN
          LET layer=LAYERS.Find(@service.scene,window.layer)
          visible=0
          IF layer.dirty=0 AND layer.shown<>0 AND layer.visible.count<>0 THEN
            REGIONS.Copy(@layer.bounds,@client)
            rect=0
            WHILE rect<layer.visible.count DO
              IF REGIONS.Contains(@layer.visible.rects(rect),@client)<>0 THEN
                visible=1
                EXIT
              FI
              rect==+1
            OD

            IF visible<>0 AND LAYERS.PixelsReady(layer,@client)<>0
                AND (client.left & 1)=0
                AND DESKCACHE.Fits(CARD(client.right-client.left),
                    CARD(client.bottom-client.top))<>0 THEN
              window.captureAttempt=window.visualRevision
              started=DESKCACHE.Capture(service,window)
              RETURN(started)
            FI
          FI
        END
      FI
    END
  OD

RETURN(0)

PUBLIC PROC Stop()

  LET service=DESKSTATE.Get()
  IF service<>NULL AND service.live<>0 THEN
    DESKINPUT.Stop()
    DESKMENU.Stop()
    IF DESKCORE.Stop(service)=0 THEN
      HEAPCORE.Abort($fae2)
    FI

    EXEC.FreeSignal(service.signalBit)
  FI

  ; Input/scene teardown above may still consult AES gates. Retire AES
  ; last, before publishing that the controller can reclaim its allocation.
  AESHOST.Stop()

RETURN

ENDMODULE
