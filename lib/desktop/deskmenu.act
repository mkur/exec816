; Desktop-owned menus. Only stable window identities and copied labels survive
; a presenter turn; application code receives the existing top/close notices.
MODULE DESKMENU
USE INPUT
USE ASCII
USE AESKEYS
USE DESKAPPMENU
USE DESKMENUCACHE
USE AESLOCKS
USE AESMOUSE
USE AESTYPES
USE AESSTATE
USE AESWINDOWSTATE
USE DESKTYPES
USE DESKSTATE
USE DESKCORE
USE DESKEVENTS
USE LAYERTYPES
USE LAYERS
USE REGIONS
USE A816MEMORY
USE HEAPCORE

PUBLIC CONST BAR_HEIGHT=DESKTYPES.MENU_BAR_HEIGHT
PUBLIC CONST ROW_HEIGHT=DESKTYPES.MENU_ROW_HEIGHT, ROWS=9, LABEL_BYTES=25
PUBLIC CONST APP_MENU=1, WINDOWS_MENU=2, GEM_MENU=3, WINDOWS_LEFT=560, WINDOWS_POPUP_LEFT=432
PUBLIC TYPE Item=[
  LONGCARD window
  BYTE enabled,action
  BYTE ARRAY label(LABEL_BYTES)
]
PUBLIC LONGCARD activeWindow
PUBLIC LONGCARD contentRevision
PUBLIC BYTE ARRAY title(33)
PUBLIC BYTE paintMenu
PUBLIC Item ARRAY items(ROWS)
PUBLIC BYTE menu,count
PUBLIC INT selected
PUBLIC INT paintSelection
LONGCARD revision,focusSeen,pendingWindow,menuOwner
; Dirty bits: 1 replaces bar contents, 2 replaces popup contents. Selection
; transitions are compared with the last published paint state separately.
BYTE pendingMenu,pendingAction,dirty,down,opening,blocked
BYTE showPending
INT armed,pendingHeading
CONST ACT_TOP=1, ACT_CLOSE=2, ACT_ICONIFY=3, NO_ROW=-1

PROC PublishActive(BYTE active)

  IF DESKSTATE.menuActive<>active THEN
    DESKSTATE.menuActive=active
    AESSTATE.mouseDirty=1
  FI

RETURN

PUBLIC BYTE FUNC Active()

RETURN(menu<>0 OR pendingMenu<>0 OR down<>0 OR blocked<>0)

; Preserve input order from the first queued heading through snapshot adoption.
PUBLIC BYTE FUNC InputBlocked()

RETURN(DESKMENUCACHE.Replacing()<>0 OR (menu=GEM_MENU AND pendingMenu=GEM_MENU))

PROC Check(BYTE status)

  IF status<>LAYERTYPES.OK THEN
    HEAPCORE.Abort($faee)
  FI

RETURN

PUBLIC BYTE FUNC Start()
  LAYERTYPES.Rect bounds

  LET service=DESKSTATE.Get()
  DESKSTATE.barLayer=0
  DESKMENUCACHE.Reset()
  DESKSTATE.popupLayer=0
  menu=0
  count=0
  paintMenu=0
  paintSelection=NO_ROW
  pendingMenu=0
  pendingAction=0
  down=0
  opening=0
  dirty=1
  blocked=0
  showPending=0
  selected=NO_ROW
  armed=NO_ROW
  revision=$ffffffff
  focusSeen=$ffffffff
  activeWindow=0
  contentRevision=1
  title(0)=0
  PublishActive(0)
  REGIONS.Assign(@bounds,0,0,640,BAR_HEIGHT)
  IF LAYERS.Create(@service.scene,@bounds,@DESKSTATE.barLayer)<>LAYERTYPES.OK THEN
    RETURN(0)
  FI

  REGIONS.Assign(@bounds,0,BAR_HEIGHT,208,BAR_HEIGHT+4*ROW_HEIGHT)
  IF LAYERS.Create(@service.scene,@bounds,@DESKSTATE.popupLayer)<>LAYERTYPES.OK THEN
    Check(LAYERS.Delete(@service.scene,DESKSTATE.barLayer))
    DESKSTATE.barLayer=0
    RETURN(0)
  FI

  Check(LAYERS.Show(@service.scene,DESKSTATE.barLayer,1))

RETURN(1)

PUBLIC PROC Stop()

  LET service=DESKSTATE.Get()
  IF DESKSTATE.popupLayer<>0 THEN
    Check(LAYERS.Delete(@service.scene,DESKSTATE.popupLayer))
    Check(LAYERS.Delete(@service.scene,DESKSTATE.barLayer))
  FI
  DESKSTATE.barLayer=0
  DESKSTATE.popupLayer=0
  menu=0
  pendingMenu=0
  showPending=0
  pendingAction=0
  PublishActive(0)

RETURN

PROC Label(BYTE POINTER target,source BYTE limit)
  BYTE index

  index=0
  WHILE index<limit AND source(index)<>0 DO
    target(index)=source(index)
    index==+1
  OD
  target(index)=0

RETURN

BYTE FUNC Shown(DESKTYPES.Window POINTER window)

  IF window.id=0 OR window.id=DESKSTATE.desktopWindow THEN
    RETURN(0)
  FI

  LET service=DESKSTATE.Get()
  LET layer=DESKCORE.Layer(service,window)
  IF layer=NULL OR layer.shown=0 THEN
    RETURN(0)
  FI

  IF window.kind=DESKTYPES.CONTENT_AES THEN
    BEGIN
      LET client=AESWINDOWSTATE.Find(window.id)
      RETURN(client<>NULL AND client.endpoint.input.windowEpoch<>0)
    END
  FI

RETURN(1)

; Stable slot order makes repeated cycling visit every window, rather than
; bouncing between the two most recently raised windows.
PROC Cycle(BYTE reverse)
  BYTE slot,attempt
  LONGCARD current

  LET service=DESKSTATE.Get()
  current=IF pendingAction=ACT_TOP THEN pendingWindow ELSE service.focus FI
  slot=0
  WHILE slot<DESKTYPES.WINDOWS AND service.windows(slot).id<>current DO
    slot==+1
  OD
  IF slot=DESKTYPES.WINDOWS THEN
    slot=IF reverse<>0 THEN 0 ELSE DESKTYPES.WINDOWS-1 FI
  FI

  FOR attempt=0 TO DESKTYPES.WINDOWS-1 DO
    IF reverse<>0 THEN
      slot=IF slot=0 THEN DESKTYPES.WINDOWS-1 ELSE slot-1 FI
    ELSE
      slot=IF slot=DESKTYPES.WINDOWS-1 THEN 0 ELSE slot+1 FI
    FI

    IF Shown(@service.windows(slot))<>0
        AND service.windows(slot).iconified=0 THEN
      pendingWindow=service.windows(slot).id
      pendingAction=ACT_TOP
      RETURN
    FI
  OD

RETURN

PUBLIC PROC Cancel()

  pendingMenu=0
  pendingAction=0
  menu=0
  selected=NO_ROW
  armed=NO_ROW
  blocked=down
  down=0
  PublishActive(blocked)

RETURN

PROC Choose(INT row)

  IF menu=GEM_MENU THEN
    DESKAPPMENU.Queue(row)
    Cancel()
    RETURN
  FI
  IF row<0 OR row>=INT(count) OR items(row).enabled=0 THEN
    RETURN
  FI

  IF menu=WINDOWS_MENU AND items(row).action=0 THEN
    pendingWindow=items(row).window
    pendingAction=ACT_TOP
  ELSEIF menu=WINDOWS_MENU AND items(row).action=1 THEN
    Cycle(0)
  ELSEIF menu=WINDOWS_MENU THEN
    pendingWindow=menuOwner
    pendingAction=IF items(row).action=3 THEN ACT_ICONIFY ELSE ACT_CLOSE FI
  ELSEIF row=0 THEN
    Cycle(0)
  ELSE
    pendingWindow=menuOwner
    pendingAction=IF row=2 THEN ACT_ICONIFY ELSE ACT_CLOSE FI
  FI

  menu=0
  selected=NO_ROW
  PublishActive(Active())

RETURN

PROC Highlight(INT row)

  IF menu=GEM_MENU THEN
    DESKAPPMENU.selected=row
    selected=row
    RETURN
  FI
  IF row>=0 AND items(row).enabled=0 THEN
    row=NO_ROW
  FI
  IF selected<>row THEN
    selected=row
  FI

RETURN

; At most nine native rows; pointer motion needs no general division.
PUBLIC BYTE FUNC RowAt(INT offset)
  BYTE row

  row=0
  WHILE offset>=ROW_HEIGHT DO
    offset==-ROW_HEIGHT
    row==+1
  OD

RETURN(row)

INT FUNC Hit(INT x,y)
  INT left,row

  IF menu=GEM_MENU THEN
    RETURN(DESKAPPMENU.EntryAt(x,y))
  FI
  left=IF menu=WINDOWS_MENU THEN INT(WINDOWS_POPUP_LEFT) ELSE INT(0) FI
  IF x<=left OR x>=left+207 OR y<=BAR_HEIGHT
      OR y>=BAR_HEIGHT+INT(count)*ROW_HEIGHT
      OR (count>=4 AND y=BAR_HEIGHT+INT(count)*ROW_HEIGHT-1) THEN
    RETURN(NO_ROW)
  FI
  row=RowAt(y-BAR_HEIGHT)

RETURN(row)

PROC Heading(INT x)
  INT hit

  IF x>=WINDOWS_LEFT THEN
    IF menu<>WINDOWS_MENU THEN
      pendingMenu=WINDOWS_MENU
    FI
  ELSEIF x<DESKAPPMENU.BAR_LEFT THEN
    IF menu<>APP_MENU THEN
      pendingMenu=APP_MENU
    FI
  ELSEIF DESKAPPMENU.Current()<>0 THEN
    hit=DESKAPPMENU.TitleAt(x)
    IF hit>=0 AND (menu<>GEM_MENU OR hit<>DESKAPPMENU.heading) THEN
      pendingHeading=hit
      pendingMenu=GEM_MENU
    FI
  ELSEIF menu<>APP_MENU THEN
    pendingMenu=APP_MENU
  FI

RETURN

; Fresh or deferred native events only. AESMOUSE keeps the physical baseline
; and never transfers a held application gesture into this path.
PUBLIC BYTE FUNC Mouse(INPUT.Event POINTER sample)
  INT row

  IF DESKSTATE.barLayer=0 THEN
    RETURN(0)
  FI

  IF menu=GEM_MENU AND DESKAPPMENU.Current()=0 THEN
    Cancel()
  FI
  IF blocked<>0 THEN
    IF sample.buttons=0 THEN
      blocked=0
      PublishActive(Active())
    FI
    RETURN(1)
  FI

  IF menu=0 AND pendingMenu=0 AND down=0 THEN
    IF sample.y>=BAR_HEIGHT THEN
      RETURN(0)
    FI
    IF sample.kind=INPUT.EVENT_BUTTON AND (sample.buttons & INPUT.LEFT)<>0 THEN
      Heading(sample.x)
      down=1
      PublishActive(1)
      opening=1
      armed=NO_ROW
    FI
    RETURN(1)
  FI

  IF sample.kind=INPUT.EVENT_BUTTON AND (sample.buttons & INPUT.LEFT)<>0
      AND sample.y<BAR_HEIGHT THEN
    Heading(sample.x)
    down=1
    opening=1
    armed=NO_ROW
    RETURN(1)
  FI

  IF sample.y<BAR_HEIGHT THEN
    Heading(sample.x)
  FI

  row=IF menu<>0 THEN Hit(sample.x,sample.y) ELSE NO_ROW FI
  Highlight(row)
  IF sample.kind=INPUT.EVENT_BUTTON THEN
    IF (sample.buttons & INPUT.LEFT)<>0 THEN
      down=1
      opening=0
      armed=row
      IF row=NO_ROW THEN
        Cancel()
      FI
    ELSEIF down<>0 THEN
      down=0
      IF opening<>0 THEN
        ; Click opens; dragging straight into an entry also selects it.
        IF row<>NO_ROW THEN
          Choose(row)
        ELSEIF sample.y>=BAR_HEIGHT THEN
          Cancel()
        FI
      ELSEIF row=armed THEN
        Choose(row)
      ELSE
        Cancel()
      FI
      opening=0
      armed=NO_ROW
    FI
  FI

  PublishActive(Active())

RETURN(1)

; Recognize global shortcuts before console/AES translation. Translate ordinary
; menu keys once, only while this presenter-owned menu has keyboard ownership.
PUBLIC BYTE FUNC Key(INPUT.Event POINTER sample CARD buttons)
  CARD key
  INT row
  BYTE attempts

  IF DESKSTATE.barLayer=0 THEN
    RETURN(0)
  FI
  IF sample.kind=INPUT.EVENT_LOSS OR sample.kind=INPUT.EVENT_CANCEL THEN
    IF Active()<>0 THEN
      Cancel()
      RETURN(1)
    FI
    RETURN(0)
  FI
  IF sample.kind<>INPUT.EVENT_KEY THEN
    RETURN(Active())
  FI

  IF (sample.qualifiers & INPUT.CONTROL)<>0 AND buttons=0
      AND AESMOUSE.NativeGesture()=0 THEN
    IF (sample.code & 63)=44 THEN
      Cancel()
      Cycle((sample.qualifiers & INPUT.SHIFT)<>0)
      RETURN(1)
    ELSEIF (sample.code & 63)=28 THEN
      Cancel()
      IF (sample.qualifiers & INPUT.SHIFT)<>0 THEN
        row=DESKAPPMENU.NextTitle(-1,0)
        IF row>=0 THEN
          pendingHeading=row
          pendingMenu=GEM_MENU
        FI
      ELSE
        pendingMenu=WINDOWS_MENU
      FI
      PublishActive(Active())
      RETURN(1)
    FI
  FI

  IF menu=0 AND pendingMenu=0 THEN
    RETURN(0)
  FI
  IF menu=0 THEN
    RETURN(1)
  FI
  key=AESKEYS.Translate(BYTE(sample.code))
  IF key=$011b THEN
    Cancel()
  ELSEIF key=$1c0d AND buttons=0 THEN
    Choose(selected)
  ELSEIF menu=GEM_MENU AND (key=$4b00 OR key=$4d00) THEN
    row=DESKAPPMENU.NextTitle(DESKAPPMENU.heading,key=$4b00)
    IF row>=0 THEN
      pendingHeading=row
      pendingMenu=GEM_MENU
    FI
  ELSEIF menu=GEM_MENU AND (key=$4800 OR key=$5000 OR key=$0f09) THEN
    Highlight(DESKAPPMENU.NextEntry(selected,
        key=$4800 OR (key=$0f09 AND (sample.qualifiers & INPUT.SHIFT)<>0)))
  ELSEIF key=$4800 OR key=$5000 OR key=$0f09 THEN
    row=selected
    FOR attempts=0 TO ROWS-1 DO
      IF key=$4800 OR (key=$0f09 AND (sample.qualifiers & INPUT.SHIFT)<>0) THEN
        row=IF row<=0 THEN INT(count)-1 ELSE row-1 FI
      ELSE
        row=IF row>=INT(count)-1 THEN INT(0) ELSE row+1 FI
      FI
      IF row>=0 AND items(row).enabled<>0 THEN
        Highlight(row)
        EXIT
      FI
    OD
  FI

RETURN(1)

; Internal presenter entry; public callers install through AES, never this hook.
PUBLIC PROC Application(INT heading)

  pendingHeading=heading
  pendingMenu=GEM_MENU
  PublishActive(1)

RETURN

PROC Popup(LAYERTYPES.Rect POINTER bounds)
  LAYERTYPES.Rect background

  LET service=DESKSTATE.Get()
  Check(LAYERS.Bounds(@service.scene,DESKSTATE.popupLayer,bounds.left,bounds.top,
      CARD(bounds.right-bounds.left),CARD(bounds.bottom-bounds.top)))
  showPending=1
  IF DESKMENUCACHE.Reusable(bounds)<>0 THEN
    RETURN
  FI
  REGIONS.Copy(bounds,@background)
  IF menu=GEM_MENU THEN
    DESKAPPMENU.BackgroundBounds(@background)
  FI
  IF DESKMENUCACHE.Capture(@background)=0 THEN
    showPending=0
    Check(LAYERS.Show(@service.scene,DESKSTATE.popupLayer,1))
    DESKSTATE.TopChrome()
  FI

RETURN

PROC Open(BYTE kind)
  BYTE slot
  LAYERTYPES.Rect bounds

  LET service=DESKSTATE.Get()
  menu=kind
  PublishActive(1)
  menuOwner=service.focus
  count=0
  A816MEMORY.Clear(BYTE POINTER(@items(0)),SIZEOF(items))
  IF menu=GEM_MENU THEN
    IF DESKAPPMENU.Available()=0 THEN
      Cancel()
      RETURN
    FI
    selected=NO_ROW
    DESKAPPMENU.heading=pendingHeading
    DESKAPPMENU.selected=-1
    DESKAPPMENU.PopupBounds(@bounds)
    Popup(@bounds)
    dirty=dirty OR 2
    RETURN
  FI
  IF menu=WINDOWS_MENU THEN
    FOR slot=0 TO DESKTYPES.WINDOWS-1 DO
      BEGIN
        LET window=@service.windows(slot)
        IF Shown(window)<>0 THEN
          items(count).window=window.id
          items(count).enabled=1
          IF window.iconified<>0 THEN
            items(count).label(0)='*
            items(count).label(1)=ASCII.SPACE
            Label(@items(count).label(2),@window.title(0),LABEL_BYTES-3)
          ELSE
            Label(@items(count).label(0),@window.title(0),LABEL_BYTES-1)
          FI
          count==+1
        FI
      END
    OD
    BEGIN
      items(count).enabled=1
      items(count).action=1
      Label(@items(count).label(0),BYTE POINTER(c"Next window"),LABEL_BYTES-1)
      count==+1
      items(count).enabled=menuOwner<>0 AND menuOwner<>service.consoleWindow
          AND menuOwner<>DESKSTATE.desktopWindow
      items(count).action=2
      Label(@items(count).label(0),BYTE POINTER(c"Close"),LABEL_BYTES-1)
      count==+1
      items(count).enabled=menuOwner<>0 AND menuOwner<>DESKSTATE.desktopWindow
      items(count).action=3
      Label(@items(count).label(0),BYTE POINTER(c"Iconify"),LABEL_BYTES-1)
      count==+1
    END
  ELSE
    count=3
    items(0).enabled=1
    Label(@items(0).label(0),BYTE POINTER(c"Next window"),LABEL_BYTES-1)
    items(1).window=menuOwner
    items(1).enabled=menuOwner<>0 AND menuOwner<>service.consoleWindow
        AND menuOwner<>DESKSTATE.desktopWindow
    Label(@items(1).label(0),BYTE POINTER(c"Close"),LABEL_BYTES-1)
    items(2).window=menuOwner
    items(2).enabled=menuOwner<>0 AND menuOwner<>DESKSTATE.desktopWindow
    Label(@items(2).label(0),BYTE POINTER(c"Iconify"),LABEL_BYTES-1)
  FI

  selected=IF count<>0 THEN INT(0) ELSE NO_ROW FI
  REGIONS.Assign(@bounds,
      IF menu=WINDOWS_MENU THEN INT(WINDOWS_POPUP_LEFT) ELSE INT(0) FI,BAR_HEIGHT,0,0)
  bounds.right=bounds.left+208
  bounds.bottom=BAR_HEIGHT+INT(IF count>4 THEN count ELSE 4 FI)*ROW_HEIGHT
  Popup(@bounds)
  dirty=dirty OR 2

RETURN

PROC Execute()
  BYTE slot,action

  LET service=DESKSTATE.Get()
  LET window=DESKCORE.Find(service,pendingWindow)
  action=pendingAction
  pendingAction=0
  IF window=NULL OR Shown(window)=0 THEN
    RETURN
  FI

  IF action=ACT_ICONIFY THEN
    DESKCORE.Iconify(service,window)
  ELSEIF action=ACT_TOP THEN
    IF window.iconified<>0 THEN
      DESKCORE.RestoreIcon(service,window)
      RETURN
    FI
    IF service.focus=window.id THEN
      RETURN
    FI
    IF window.kind=DESKTYPES.CONTENT_AES THEN
      AESWINDOWSTATE.Control(window,AESTYPES.GUI_TOPPED,0,0,0,0)
    ELSE
      Check(DESKSTATE.Raise(window.layer))
      DESKCORE.Focus(service,window.id)
      DESKSTATE.TopChrome()
    FI
  ELSEIF action=ACT_CLOSE AND window.id<>service.consoleWindow THEN
    IF window.kind=DESKTYPES.CONTENT_AES THEN
      AESWINDOWSTATE.Control(window,AESTYPES.GUI_CLOSED,0,0,0,0)
    ELSE
      FOR slot=0 TO DESKTYPES.WINDOWS-1 DO
        IF @service.windows(slot)=window THEN
          BEGIN
            LET client=DESKEVENTS.Find(service,window.client)
            client.closeBits=client.closeBits OR BYTE(1 LSH slot)
            DESKEVENTS.Wake(service,client)
          END
        FI
      OD
    FI
  FI

RETURN

PUBLIC PROC Renamed(LONGCARD window)

  IF window=activeWindow THEN
    revision=$ffffffff
  FI

RETURN

PROC DamageTitle(BYTE kind)
  LAYERTYPES.Rect bounds

  LET service=DESKSTATE.Get()
  IF kind=APP_MENU THEN
    REGIONS.Assign(@bounds,0,0,DESKAPPMENU.BAR_LEFT,BAR_HEIGHT)
  ELSEIF kind=WINDOWS_MENU THEN
    REGIONS.Assign(@bounds,WINDOWS_LEFT,0,640,BAR_HEIGHT)
  ELSE
    RETURN
  FI
  Check(LAYERS.Invalidate(@service.scene,DESKSTATE.barLayer,@bounds))

RETURN

PROC DamageRow(INT row)
  LAYERTYPES.Rect bounds

  IF row<0 THEN
    RETURN
  FI
  LET service=DESKSTATE.Get()
  LET popup=LAYERS.Find(@service.scene,DESKSTATE.popupLayer)
  REGIONS.Assign(@bounds,popup.bounds.left,BAR_HEIGHT+row*ROW_HEIGHT,
      popup.bounds.right,BAR_HEIGHT+(row+1)*ROW_HEIGHT)
  Check(LAYERS.Invalidate(@service.scene,DESKSTATE.popupLayer,@bounds))

RETURN

; Paint and scene changes obey the same gates as existing native gestures.
PUBLIC PROC Advance()
  BYTE changed,chromeChanged,completed
  LAYERTYPES.Rect nextBounds

  LET service=DESKSTATE.Get()
  IF DESKSTATE.barLayer=0 THEN
    RETURN
  FI
  ; Completion is adopted before NativeReady can reopen client admission.
  IF DESKMENUCACHE.Replacing()<>0 THEN
    completed=DESKMENUCACHE.Replacement()
    IF completed=0 THEN
      RETURN
    FI
    IF completed<>LAYERTYPES.REPLACE_REPAIR THEN
      DESKAPPMENU.AdoptReplacement(pendingHeading)
      pendingMenu=0
      selected=NO_ROW
      paintMenu=GEM_MENU
      paintSelection=NO_ROW
      revision=service.scene.rebuilds
    FI
  FI
  IF pendingAction=0 AND pendingMenu=0 AND dirty=0 AND showPending=0
      AND paintMenu=menu AND paintSelection=selected
      AND focusSeen=service.focus AND revision=service.scene.rebuilds
      AND DESKAPPMENU.Changed()=0 AND DESKAPPMENU.Pending()=0
      AND DESKAPPMENU.VisualChanged()=0 AND DESKMENUCACHE.Pending()=0 THEN
    RETURN
  FI
  IF AESLOCKS.NativeReady()=0 OR AESLOCKS.MouseBlocked()<>0
      OR AESLOCKS.PaintBlocked()<>0 THEN
    RETURN
  FI

  ; Retire the old popup before applying a command or preparing a new save.
  ; Own hide/show rebuilds are published here so they cannot cancel the gesture.
  BEGIN
    LET popup=LAYERS.Find(@service.scene,DESKSTATE.popupLayer)
    IF popup.shown<>0 AND (menu=0 OR pendingMenu<>0 OR pendingAction<>0) THEN
      IF menu=GEM_MENU AND pendingMenu=GEM_MENU AND pendingAction=0
          AND DESKAPPMENU.Changed()=0 AND DESKAPPMENU.Available()<>0
          AND focusSeen=service.focus AND revision=service.scene.rebuilds THEN
        IF DESKSTATE.MenuTurnReady()=0 THEN
          RETURN
        FI
        DESKAPPMENU.HeadingBounds(pendingHeading,@nextBounds)
        BEGIN
          LET owner=DESKAPPMENU.owner
          LET aes=AESSTATE.Get()
          DESKMENUCACHE.SelectPopup(GEM_MENU,owner.id,owner.menu.generation,
              aes.menuRevision,pendingHeading,-1,1)
        END
        IF ((popup.bounds.left OR popup.bounds.right) & 1)=0
            AND DESKMENUCACHE.Replace(@nextBounds)<>0 THEN
          DESKSTATE.MenuTurn(0)
          RETURN
        FI
      FI
      IF DESKMENUCACHE.Restore(menu=GEM_MENU AND pendingMenu=GEM_MENU
          AND DESKAPPMENU.Changed()=0 AND DESKAPPMENU.Current()<>0)<>0 THEN
        revision=service.scene.rebuilds
        RETURN
      FI
      Check(LAYERS.Show(@service.scene,DESKSTATE.popupLayer,0))
      revision=service.scene.rebuilds
    FI
  END

  DESKAPPMENU.Finish()
  ; A native focus command must select its bar before focusSeen is published.
  ; Otherwise the next fresh click is mistaken for an old owner's gesture.
  IF pendingAction<>0 THEN
    Execute()
  FI
  changed=DESKAPPMENU.Refresh()
  IF changed=1 THEN
    Cancel()
    dirty=1
  FI
  chromeChanged=focusSeen<>service.focus OR revision<>service.scene.rebuilds
  IF menu<>0 AND chromeChanged<>0 THEN
    ; Do not select a stale label after its window closes, moves or is reused.
    Cancel()
  FI
  IF pendingMenu<>0 THEN
    Open(pendingMenu)
    pendingMenu=0
    IF service.scene.busy<>0 THEN
      revision=service.scene.rebuilds
      RETURN
    FI
  FI
  IF showPending<>0 THEN
    showPending=0
    IF menu<>0 THEN
      Check(LAYERS.Show(@service.scene,DESKSTATE.popupLayer,1))
      DESKSTATE.TopChrome()
    FI
  FI
  IF menu=0 THEN
    Check(LAYERS.Show(@service.scene,DESKSTATE.popupLayer,0))
    DESKMENUCACHE.End()
  FI
  IF chromeChanged<>0 THEN
    IF contentRevision<>0 THEN
      contentRevision==+1
    FI
    DESKSTATE.TopChrome()
    activeWindow=service.focus
    BEGIN
      LET window=DESKCORE.Find(service,activeWindow)
      IF window=NULL THEN
        Label(@title(0),BYTE POINTER(c"Exec816"),32)
      ELSEIF window.title(0)=0 THEN
        Label(@title(0),BYTE POINTER(c"Exec816"),32)
      ELSE
        Label(@title(0),@window.title(0),32)
      FI
    END
    dirty=1
  FI

  DESKAPPMENU.Snapshot(menu=GEM_MENU)
  IF dirty<>0 OR paintMenu<>menu OR paintSelection<>selected THEN
    ; Input may arrive between paint steps. Publish visual state only after
    ; the current scene token retires, alongside its matching damage.
    BEGIN
      LET bar=LAYERS.Find(@service.scene,DESKSTATE.barLayer)
      LET popup=LAYERS.Find(@service.scene,DESKSTATE.popupLayer)
      IF (dirty & 1)<>0 THEN
        Check(LAYERS.Invalidate(@service.scene,DESKSTATE.barLayer,@bar.bounds))
      ELSEIF paintMenu<>menu THEN
        DamageTitle(paintMenu)
        DamageTitle(menu)
      FI
      IF menu<>0 THEN
        IF dirty<>0 THEN
          Check(LAYERS.Invalidate(@service.scene,DESKSTATE.popupLayer,@popup.bounds))
        ELSEIF menu<>GEM_MENU AND paintSelection<>selected THEN
          DamageRow(paintSelection)
          DamageRow(selected)
        FI
      FI
    END
    paintMenu=menu
    paintSelection=selected
    dirty=0
  FI
  focusSeen=service.focus
  revision=service.scene.rebuilds
  AESWINDOWSTATE.Sync()
  PublishActive(Active())
  AESMOUSE.Refresh()
  IF menu=GEM_MENU THEN
    BEGIN
      LET owner=DESKAPPMENU.owner
      LET aes=AESSTATE.Get()
      DESKMENUCACHE.SelectPopup(menu,owner.id,owner.menu.generation,
          aes.menuRevision,DESKAPPMENU.paintHeading,DESKAPPMENU.paintSelected,
          DESKAPPMENU.paintSelected=-1)
    END
  ELSE
    DESKMENUCACHE.SelectPopup(menu,activeWindow,1,contentRevision,0,
        paintSelection,paintSelection=0)
  FI
  DESKMENUCACHE.Notify()

RETURN

PUBLIC BYTE FUNC Runnable()

  IF DESKSTATE.barLayer=0 THEN
    RETURN(0)
  FI

  LET service=DESKSTATE.Get()
  IF pendingAction=0 AND pendingMenu=0 AND dirty=0 AND showPending=0
      AND paintMenu=menu AND paintSelection=selected
      AND focusSeen=service.focus AND revision=service.scene.rebuilds
      AND DESKAPPMENU.Changed()=0 AND DESKAPPMENU.Pending()=0
      AND DESKAPPMENU.VisualChanged()=0 AND DESKMENUCACHE.Pending()=0 THEN
    RETURN(0)
  FI

  IF AESLOCKS.NativeReady()=0 OR AESLOCKS.MouseBlocked()<>0
      OR AESLOCKS.PaintBlocked()<>0 THEN
    RETURN(0)
  FI

RETURN(1)

ENDMODULE
