; Desktop-owned menus. Only stable window identities and copied labels survive
; a presenter turn; application code receives the existing top/close notices.
MODULE DESKMENU
USE INPUT
USE AESKEYS
USE DESKAPPMENU
USE AESLOCKS
USE AESMOUSE
USE AESTYPES
USE AESWINDOWSTATE
USE DESKTYPES
USE DESKSTATE
USE DESKCORE
USE DESKEVENTS
USE LAYERTYPES
USE LAYERS
USE REGIONS
USE A816MEMORY
USE HEAPCORE

PUBLIC CONST BAR_HEIGHT=16, ROW_HEIGHT=16, ROWS=6, LABEL_BYTES=25
PUBLIC CONST APP_MENU=1, WINDOWS_MENU=2, GEM_MENU=3, WINDOWS_LEFT=432
PUBLIC TYPE Item=[
  LONGCARD window
  BYTE enabled,action
  BYTE ARRAY label(LABEL_BYTES)
]
PUBLIC LONGCARD activeWindow
PUBLIC BYTE ARRAY title(33)
PUBLIC BYTE paintMenu
PUBLIC Item ARRAY items(ROWS)
PUBLIC BYTE menu,count
PUBLIC INT selected
PUBLIC INT paintSelection
LONGCARD revision,focusSeen,pendingWindow,menuOwner
BYTE pendingMenu,pendingAction,dirty,down,opening,blocked
INT armed,pendingHeading
CONST ACT_TOP=1, ACT_CLOSE=2, NO_ROW=-1

PUBLIC BYTE FUNC Active()

RETURN(menu<>0 OR pendingMenu<>0 OR down<>0 OR blocked<>0)

PROC Check(BYTE status)

  IF status<>LAYERTYPES.OK THEN
    HEAPCORE.Abort($faee)
  FI

RETURN

PUBLIC BYTE FUNC Start()
  LAYERTYPES.Rect bounds

  LET service=DESKSTATE.Get()
  DESKSTATE.barLayer=0
  DESKSTATE.popupLayer=0
  menu=0
  count=0
  paintMenu=0
  paintSelection=NO_ROW
  pendingMenu=0
  pendingAction=0
  down=0
  opening=0
  dirty=1
  blocked=0
  selected=NO_ROW
  armed=NO_ROW
  revision=$ffffffff
  focusSeen=$ffffffff
  activeWindow=0
  title(0)=0
  DESKSTATE.menuActive=0
  REGIONS.Assign(@bounds,0,0,640,BAR_HEIGHT)
  IF LAYERS.Create(@service.scene,@bounds,@DESKSTATE.barLayer)<>LAYERTYPES.OK THEN
    RETURN(0)
  FI

  REGIONS.Assign(@bounds,0,BAR_HEIGHT,208,BAR_HEIGHT+4*ROW_HEIGHT)
  IF LAYERS.Create(@service.scene,@bounds,@DESKSTATE.popupLayer)<>LAYERTYPES.OK THEN
    Check(LAYERS.Delete(@service.scene,DESKSTATE.barLayer))
    DESKSTATE.barLayer=0
    RETURN(0)
  FI

  Check(LAYERS.Show(@service.scene,DESKSTATE.barLayer,1))

RETURN(1)

PUBLIC PROC Stop()

  LET service=DESKSTATE.Get()
  IF DESKSTATE.popupLayer<>0 THEN
    Check(LAYERS.Delete(@service.scene,DESKSTATE.popupLayer))
    Check(LAYERS.Delete(@service.scene,DESKSTATE.barLayer))
  FI
  DESKSTATE.barLayer=0
  DESKSTATE.popupLayer=0
  menu=0
  pendingMenu=0
  pendingAction=0
  DESKSTATE.menuActive=0

RETURN

PROC Label(BYTE POINTER target,source BYTE limit)
  BYTE index

  index=0
  WHILE index<limit AND source(index)<>0 DO
    target(index)=source(index)
    index==+1
  OD
  target(index)=0

RETURN

BYTE FUNC Shown(DESKTYPES.Window POINTER window)

  IF window.id=0 THEN
    RETURN(0)
  FI

  LET service=DESKSTATE.Get()
  LET layer=DESKCORE.Layer(service,window)
  IF layer=NULL OR layer.shown=0 THEN
    RETURN(0)
  FI

  IF window.kind=DESKTYPES.CONTENT_AES THEN
    BEGIN
      LET client=AESWINDOWSTATE.Find(window.id)
      RETURN(client<>NULL AND client.endpoint.input.windowEpoch<>0)
    END
  FI

RETURN(1)

; Stable slot order makes repeated cycling visit every window, rather than
; bouncing between the two most recently raised windows.
PROC Cycle(BYTE reverse)
  BYTE slot,attempt
  LONGCARD current

  LET service=DESKSTATE.Get()
  current=IF pendingAction=ACT_TOP THEN pendingWindow ELSE service.focus FI
  slot=0
  WHILE slot<DESKTYPES.WINDOWS AND service.windows(slot).id<>current DO
    slot==+1
  OD
  IF slot=DESKTYPES.WINDOWS THEN
    slot=IF reverse<>0 THEN 0 ELSE DESKTYPES.WINDOWS-1 FI
  FI

  FOR attempt=0 TO DESKTYPES.WINDOWS-1 DO
    IF reverse<>0 THEN
      slot=IF slot=0 THEN DESKTYPES.WINDOWS-1 ELSE slot-1 FI
    ELSE
      slot=IF slot=DESKTYPES.WINDOWS-1 THEN 0 ELSE slot+1 FI
    FI

    IF Shown(@service.windows(slot))<>0 THEN
      pendingWindow=service.windows(slot).id
      pendingAction=ACT_TOP
      RETURN
    FI
  OD

RETURN

PUBLIC PROC Cancel()

  pendingMenu=0
  pendingAction=0
  IF menu<>0 THEN
    dirty=1
  FI
  menu=0
  selected=NO_ROW
  armed=NO_ROW
  blocked=down
  down=0
  DESKSTATE.menuActive=blocked

RETURN

PROC Choose(INT row)

  IF menu=GEM_MENU THEN
    DESKAPPMENU.Queue(row)
    Cancel()
    RETURN
  FI
  IF row<0 OR row>=INT(count) OR items(row).enabled=0 THEN
    RETURN
  FI

  IF menu=WINDOWS_MENU AND items(row).action=0 THEN
    pendingWindow=items(row).window
    pendingAction=ACT_TOP
  ELSEIF menu=WINDOWS_MENU AND items(row).action=1 THEN
    Cycle(0)
  ELSEIF menu=WINDOWS_MENU THEN
    pendingWindow=menuOwner
    pendingAction=ACT_CLOSE
  ELSEIF row=0 THEN
    Cycle(0)
  ELSE
    pendingWindow=menuOwner
    pendingAction=ACT_CLOSE
  FI

  menu=0
  selected=NO_ROW
  dirty=1
  DESKSTATE.menuActive=Active()

RETURN

PROC Highlight(INT row)

  IF menu=GEM_MENU THEN
    DESKAPPMENU.selected=row
    selected=row
    RETURN
  FI
  IF row>=0 AND items(row).enabled=0 THEN
    row=NO_ROW
  FI
  IF selected<>row THEN
    selected=row
    dirty=1
  FI

RETURN

INT FUNC Hit(INT x,y)
  INT left,row

  IF menu=GEM_MENU THEN
    RETURN(DESKAPPMENU.EntryAt(x,y))
  FI
  left=IF menu=WINDOWS_MENU THEN INT(WINDOWS_LEFT) ELSE INT(0) FI
  IF x<left OR x>=left+208 OR y<BAR_HEIGHT
      OR y>=BAR_HEIGHT+INT(count)*ROW_HEIGHT THEN
    RETURN(NO_ROW)
  FI
  row=(y-BAR_HEIGHT) RSH 4

RETURN(row)

PROC Heading(INT x)
  INT hit

  IF x>=WINDOWS_LEFT THEN
    IF menu<>WINDOWS_MENU THEN
      pendingMenu=WINDOWS_MENU
    FI
  ELSEIF DESKAPPMENU.Current()<>0 THEN
    hit=DESKAPPMENU.TitleAt(x)
    IF hit>=0 AND (menu<>GEM_MENU OR hit<>DESKAPPMENU.heading) THEN
      pendingHeading=hit
      pendingMenu=GEM_MENU
    FI
  ELSEIF menu<>APP_MENU THEN
    pendingMenu=APP_MENU
  FI

RETURN

; Fresh or deferred native events only. AESMOUSE keeps the physical baseline
; and never transfers a held application gesture into this path.
PUBLIC BYTE FUNC Mouse(INPUT.Event POINTER sample)
  INT row

  IF DESKSTATE.barLayer=0 THEN
    RETURN(0)
  FI

  IF menu=GEM_MENU AND DESKAPPMENU.Current()=0 THEN
    Cancel()
  FI
  IF blocked<>0 THEN
    IF sample.buttons=0 THEN
      blocked=0
      DESKSTATE.menuActive=Active()
    FI
    RETURN(1)
  FI

  IF menu=0 AND pendingMenu=0 AND down=0 THEN
    IF sample.y>=BAR_HEIGHT THEN
      RETURN(0)
    FI
    IF sample.kind=INPUT.EVENT_BUTTON AND (sample.buttons & INPUT.LEFT)<>0 THEN
      Heading(sample.x)
      down=1
      DESKSTATE.menuActive=1
      opening=1
      armed=NO_ROW
    FI
    RETURN(1)
  FI

  IF sample.kind=INPUT.EVENT_BUTTON AND (sample.buttons & INPUT.LEFT)<>0
      AND sample.y<BAR_HEIGHT THEN
    Heading(sample.x)
    down=1
    opening=1
    armed=NO_ROW
    RETURN(1)
  FI

  IF sample.y<BAR_HEIGHT THEN
    Heading(sample.x)
  FI

  row=IF menu<>0 THEN Hit(sample.x,sample.y) ELSE NO_ROW FI
  Highlight(row)
  IF sample.kind=INPUT.EVENT_BUTTON THEN
    IF (sample.buttons & INPUT.LEFT)<>0 THEN
      down=1
      opening=0
      armed=row
      IF row=NO_ROW THEN
        Cancel()
      FI
    ELSEIF down<>0 THEN
      down=0
      IF opening<>0 THEN
        ; Click opens; dragging straight into an entry also selects it.
        IF row<>NO_ROW THEN
          Choose(row)
        ELSEIF sample.y>=BAR_HEIGHT THEN
          Cancel()
        FI
      ELSEIF row=armed THEN
        Choose(row)
      ELSE
        Cancel()
      FI
      opening=0
      armed=NO_ROW
    FI
  FI

  DESKSTATE.menuActive=Active()

RETURN(1)

; Recognize global shortcuts before console/AES translation. Translate ordinary
; menu keys once, only while this presenter-owned menu has keyboard ownership.
PUBLIC BYTE FUNC Key(INPUT.Event POINTER sample CARD buttons)
  CARD key
  INT row
  BYTE attempts

  IF DESKSTATE.barLayer=0 THEN
    RETURN(0)
  FI
  IF sample.kind=INPUT.EVENT_LOSS OR sample.kind=INPUT.EVENT_CANCEL THEN
    IF Active()<>0 THEN
      Cancel()
      RETURN(1)
    FI
    RETURN(0)
  FI
  IF sample.kind<>INPUT.EVENT_KEY THEN
    RETURN(Active())
  FI

  IF (sample.qualifiers & INPUT.CONTROL)<>0 AND buttons=0
      AND AESMOUSE.NativeGesture()=0 THEN
    IF (sample.code & 63)=44 THEN
      Cancel()
      Cycle((sample.qualifiers & INPUT.SHIFT)<>0)
      RETURN(1)
    ELSEIF (sample.code & 63)=28 THEN
      Cancel()
      IF (sample.qualifiers & INPUT.SHIFT)<>0 THEN
        row=DESKAPPMENU.NextTitle(-1,0)
        IF row>=0 THEN
          pendingHeading=row
          pendingMenu=GEM_MENU
        FI
      ELSE
        pendingMenu=WINDOWS_MENU
      FI
      DESKSTATE.menuActive=Active()
      RETURN(1)
    FI
  FI

  IF menu=0 AND pendingMenu=0 THEN
    RETURN(0)
  FI
  IF menu=0 THEN
    RETURN(1)
  FI
  key=AESKEYS.Translate(BYTE(sample.code))
  IF key=$011b THEN
    Cancel()
  ELSEIF key=$1c0d AND buttons=0 THEN
    Choose(selected)
  ELSEIF menu=GEM_MENU AND (key=$4b00 OR key=$4d00) THEN
    row=DESKAPPMENU.NextTitle(DESKAPPMENU.heading,key=$4b00)
    IF row>=0 THEN
      pendingHeading=row
      pendingMenu=GEM_MENU
    FI
  ELSEIF menu=GEM_MENU AND (key=$4800 OR key=$5000 OR key=$0f09) THEN
    Highlight(DESKAPPMENU.NextEntry(selected,
        key=$4800 OR (key=$0f09 AND (sample.qualifiers & INPUT.SHIFT)<>0)))
  ELSEIF key=$4800 OR key=$5000 OR key=$0f09 THEN
    row=selected
    FOR attempts=0 TO ROWS-1 DO
      IF key=$4800 OR (key=$0f09 AND (sample.qualifiers & INPUT.SHIFT)<>0) THEN
        row=IF row<=0 THEN INT(count)-1 ELSE row-1 FI
      ELSE
        row=IF row>=INT(count)-1 THEN INT(0) ELSE row+1 FI
      FI
      IF row>=0 AND items(row).enabled<>0 THEN
        Highlight(row)
        EXIT
      FI
    OD
  FI

RETURN(1)

; Internal presenter entry; public callers install through AES, never this hook.
PUBLIC PROC Application(INT heading)

  pendingHeading=heading
  pendingMenu=GEM_MENU
  DESKSTATE.menuActive=1

RETURN

PROC Popup(LAYERTYPES.Rect POINTER bounds)

  LET service=DESKSTATE.Get()
  LET layer=LAYERS.Find(@service.scene,DESKSTATE.popupLayer)
  IF layer.bounds.right-layer.bounds.left<>bounds.right-bounds.left
      OR layer.bounds.bottom-layer.bounds.top<>bounds.bottom-bounds.top THEN
    Check(LAYERS.Show(@service.scene,DESKSTATE.popupLayer,0))
    Check(LAYERS.Delete(@service.scene,DESKSTATE.popupLayer))
    Check(LAYERS.Create(@service.scene,bounds,@DESKSTATE.popupLayer))
  ELSE
    Check(LAYERS.Move(@service.scene,DESKSTATE.popupLayer,bounds.left,bounds.top))
  FI
  Check(LAYERS.Show(@service.scene,DESKSTATE.popupLayer,1))
  DESKSTATE.TopChrome()

RETURN

PROC Open(BYTE kind)
  BYTE slot
  LAYERTYPES.Rect bounds

  LET service=DESKSTATE.Get()
  menu=kind
  DESKSTATE.menuActive=1
  menuOwner=service.focus
  count=0
  A816MEMORY.Clear(BYTE POINTER(@items(0)),SIZEOF(items))
  IF menu=GEM_MENU THEN
    IF DESKAPPMENU.Available()=0 THEN
      Cancel()
      RETURN
    FI
    selected=NO_ROW
    DESKAPPMENU.heading=pendingHeading
    DESKAPPMENU.selected=-1
    DESKAPPMENU.PopupBounds(@bounds)
    Popup(@bounds)
    dirty=1
    RETURN
  FI
  IF menu=WINDOWS_MENU THEN
    FOR slot=0 TO DESKTYPES.WINDOWS-1 DO
      BEGIN
        LET window=@service.windows(slot)
        IF Shown(window)<>0 THEN
          items(count).window=window.id
          items(count).enabled=1
          Label(@items(count).label(0),@window.title(0),LABEL_BYTES-1)
          count==+1
        FI
      END
    OD
    IF DESKAPPMENU.Current()<>0 THEN
      items(count).enabled=1
      items(count).action=1
      Label(@items(count).label(0),BYTE POINTER(c"Next window"),LABEL_BYTES-1)
      count==+1
      items(count).enabled=menuOwner<>0 AND menuOwner<>service.consoleWindow
      items(count).action=2
      Label(@items(count).label(0),BYTE POINTER(c"Close"),LABEL_BYTES-1)
      count==+1
    FI
  ELSE
    count=2
    items(0).enabled=1
    Label(@items(0).label(0),BYTE POINTER(c"Next window"),LABEL_BYTES-1)
    items(1).window=menuOwner
    items(1).enabled=menuOwner<>0 AND menuOwner<>service.consoleWindow
    Label(@items(1).label(0),BYTE POINTER(c"Close"),LABEL_BYTES-1)
  FI

  selected=IF count<>0 THEN INT(0) ELSE NO_ROW FI
  REGIONS.Assign(@bounds,
      IF menu=WINDOWS_MENU THEN INT(WINDOWS_LEFT) ELSE INT(0) FI,BAR_HEIGHT,0,0)
  bounds.right=bounds.left+208
  bounds.bottom=BAR_HEIGHT+INT(IF count>4 THEN count ELSE 4 FI)*ROW_HEIGHT
  Popup(@bounds)
  dirty=1

RETURN

PROC Execute()
  BYTE slot,action

  LET service=DESKSTATE.Get()
  LET window=DESKCORE.Find(service,pendingWindow)
  action=pendingAction
  pendingAction=0
  IF window=NULL OR Shown(window)=0 THEN
    RETURN
  FI

  IF action=ACT_TOP THEN
    IF service.focus=window.id THEN
      RETURN
    FI
    IF window.kind=DESKTYPES.CONTENT_AES THEN
      AESWINDOWSTATE.Control(window,AESTYPES.GUI_TOPPED,0,0,0,0)
    ELSE
      Check(LAYERS.Order(@service.scene,window.layer,1))
      DESKCORE.Focus(service,window.id)
      DESKSTATE.TopChrome()
    FI
  ELSEIF action=ACT_CLOSE AND window.id<>service.consoleWindow THEN
    IF window.kind=DESKTYPES.CONTENT_AES THEN
      AESWINDOWSTATE.Control(window,AESTYPES.GUI_CLOSED,0,0,0,0)
    ELSE
      FOR slot=0 TO DESKTYPES.WINDOWS-1 DO
        IF @service.windows(slot)=window THEN
          BEGIN
            LET client=DESKEVENTS.Find(service,window.client)
            client.closeBits=client.closeBits OR BYTE(1 LSH slot)
            DESKEVENTS.Wake(service,client)
          END
        FI
      OD
    FI
  FI

RETURN

PUBLIC PROC Renamed(LONGCARD window)

  IF window=activeWindow THEN
    revision=$ffffffff
  FI

RETURN

; Paint and scene changes obey the same gates as existing native gestures.
PUBLIC PROC Advance()
  BYTE changed

  LET service=DESKSTATE.Get()
  IF DESKSTATE.barLayer=0 THEN
    RETURN
  FI
  IF pendingAction=0 AND pendingMenu=0 AND dirty=0
      AND focusSeen=service.focus AND revision=service.scene.rebuilds
      AND DESKAPPMENU.Changed()=0 AND DESKAPPMENU.Pending()=0
      AND DESKAPPMENU.VisualChanged()=0 THEN
    RETURN
  FI
  IF AESLOCKS.NativeReady()=0 OR AESLOCKS.MouseBlocked()<>0
      OR AESLOCKS.PaintBlocked()<>0 THEN
    RETURN
  FI

  DESKAPPMENU.Finish()
  changed=DESKAPPMENU.Refresh()
  IF changed=1 THEN
    Cancel()
    dirty=1
  FI
  IF menu<>0 AND (focusSeen<>service.focus OR revision<>service.scene.rebuilds) THEN
    ; Do not select a stale label after its window closes, moves or is reused.
    Cancel()
  FI
  IF pendingMenu<>0 THEN
    Open(pendingMenu)
    pendingMenu=0
  FI
  IF menu=0 THEN
    Check(LAYERS.Show(@service.scene,DESKSTATE.popupLayer,0))
  FI
  IF pendingAction<>0 THEN
    Execute()
  FI
  IF focusSeen<>service.focus OR revision<>service.scene.rebuilds THEN
    DESKSTATE.TopChrome()
    activeWindow=service.focus
    BEGIN
      LET window=DESKCORE.Find(service,activeWindow)
      IF window=NULL THEN
        Label(@title(0),BYTE POINTER(c"Desktop"),32)
      ELSE
        Label(@title(0),@window.title(0),32)
      FI
    END
    dirty=1
  FI

  DESKAPPMENU.Snapshot(menu=GEM_MENU)
  IF dirty<>0 THEN
    ; Input may arrive between paint steps. Publish visual state only after
    ; the current scene token retires, alongside its matching damage.
    paintMenu=menu
    paintSelection=selected
    BEGIN
      LET bar=LAYERS.Find(@service.scene,DESKSTATE.barLayer)
      LET popup=LAYERS.Find(@service.scene,DESKSTATE.popupLayer)
      Check(LAYERS.Invalidate(@service.scene,DESKSTATE.barLayer,@bar.bounds))
      IF menu<>0 THEN
        Check(LAYERS.Invalidate(@service.scene,DESKSTATE.popupLayer,@popup.bounds))
      FI
    END
    dirty=0
  FI
  focusSeen=service.focus
  revision=service.scene.rebuilds
  AESWINDOWSTATE.Sync()
  DESKSTATE.menuActive=Active()
  AESMOUSE.Refresh()

RETURN

PUBLIC BYTE FUNC Runnable()

  LET service=DESKSTATE.Get()

RETURN(DESKSTATE.barLayer<>0 AND (pendingAction<>0 OR pendingMenu<>0 OR dirty<>0
    OR focusSeen<>service.focus OR revision<>service.scene.rebuilds
    OR DESKAPPMENU.Changed()<>0 OR DESKAPPMENU.Pending()<>0
    OR DESKAPPMENU.VisualChanged()<>0)
    AND AESLOCKS.NativeReady()<>0 AND AESLOCKS.MouseBlocked()=0
    AND AESLOCKS.PaintBlocked()=0)

ENDMODULE
