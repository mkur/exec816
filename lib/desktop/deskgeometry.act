; Fixed desktop geometry shared by drawing, input and work-area publication.
MODULE DESKGEOMETRY
USE DESKTYPES
USE GEMOBJECTS
USE GEMFRAME
USE LAYERTYPES
USE REGIONS

PUBLIC INT FUNC Top(CARD kind)
  GEMOBJECTS.Rect inset

  GEMFRAME.Margins(kind,@inset)

RETURN(inset.y)

PUBLIC INT FUNC Bottom(CARD kind)
  GEMOBJECTS.Rect inset

  GEMFRAME.Margins(kind,@inset)

RETURN(inset.height)

; Rectangles in Layers and copied query views are projections of GEM GRECTs.
PUBLIC PROC Project(GEMOBJECTS.Rect POINTER input LAYERTYPES.Rect POINTER out)

  REGIONS.Assign(out,input.x,input.y,input.x+input.width,input.y+input.height)

RETURN

PUBLIC PROC Work(DESKTYPES.Window POINTER window LAYERTYPES.Rect POINTER work)

  Project(@window.frame.work,work)

RETURN

; A physical layer includes the shadow; signed canonical geometry stays intact.
PUBLIC PROC Overall(DESKTYPES.Window POINTER window LAYERTYPES.Rect POINTER out)

  Project(@window.frame.overall,out)
  IF out.right>640 THEN
    out.right=640
  FI
  IF out.bottom>240 THEN
    out.bottom=240
  FI

RETURN

; Stored relative object geometry, translated once at its consumer boundary.
PUBLIC PROC ObjectRect(DESKTYPES.Window POINTER window INT object
    LAYERTYPES.Rect POINTER out)
  INT x,y

  LET frame=@window.frame
  LET item=@frame.tree(object)
  x=frame.current.x+item.x
  y=frame.current.y+item.y
  IF object=GEMOBJECTS.O_VSLIDE THEN
    x==+frame.tree(GEMOBJECTS.O_VSCROLL).x
    y==+frame.tree(GEMOBJECTS.O_VSCROLL).y
  ELSEIF object=GEMOBJECTS.O_HSLIDE THEN
    x==+frame.tree(GEMOBJECTS.O_HSCROLL).x
    y==+frame.tree(GEMOBJECTS.O_HSCROLL).y
  FI
  REGIONS.Assign(out,x,y,x+item.width,y+item.height)

RETURN

PUBLIC PROC ScrollTrack(DESKTYPES.Window POINTER window
    LAYERTYPES.Rect POINTER bounds,track)

  ObjectRect(window,GEMOBJECTS.O_VSCROLL,track)

RETURN

PUBLIC PROC HScrollTrack(DESKTYPES.Window POINTER window
    LAYERTYPES.Rect POINTER bounds,track)

  ObjectRect(window,GEMOBJECTS.O_HSCROLL,track)

RETURN

; Temporary projection for renderer/input consumers awaiting WG4/WG5.
PUBLIC PROC ProjectSliders(DESKTYPES.Window POINTER window)

  LET tree=@window.frame
  window.sliderTop=tree.tree(GEMOBJECTS.O_VSCROLL).y
      +tree.tree(GEMOBJECTS.O_VSLIDE).y
  window.sliderHeight=tree.tree(GEMOBJECTS.O_VSLIDE).height
  window.sliderLeft=tree.tree(GEMOBJECTS.O_HSCROLL).x
      +tree.tree(GEMOBJECTS.O_HSLIDE).x
  window.sliderWidth=tree.tree(GEMOBJECTS.O_HSLIDE).width

RETURN

; Reserve one text cell between the actual title controls.
BYTE FUNC IconSpace(CARD frameKind
    LAYERTYPES.Rect POINTER bounds)
  INT available

  available=bounds.right-bounds.left
      -DESKTYPES.FRAME_GADGET_WIDTH
  IF (frameKind & DESKTYPES.FRAME_FULLER)<>0 THEN
    available==-DESKTYPES.FRAME_GADGET_WIDTH
  FI

RETURN(frameKind<>DESKTYPES.FRAME_BORDERLESS
    AND available>=DESKTYPES.FRAME_GADGET_WIDTH+8+2*DESKTYPES.TITLE_PAD)

PUBLIC BYTE FUNC HasIcon(DESKTYPES.Window POINTER window
    LAYERTYPES.Rect POINTER bounds)

RETURN(IconSpace(window.frameKind,bounds))

; Hit codes are private presenter facts: size, up, down, page up/down, thumb.
PUBLIC BYTE FUNC Gadget(CARD frameKind BYTE iconified
    INT sliderTop,sliderHeight,sliderLeft,sliderWidth
    LAYERTYPES.Rect POINTER bounds INT x,y)
  LAYERTYPES.Rect rail

  IF iconified<>0 THEN
    RETURN(IF x>=bounds.left AND x<bounds.right
        AND y>=bounds.top AND y<bounds.bottom THEN 9 ELSE 0 FI)
  FI

  IF IconSpace(frameKind,bounds)<>0
      AND y>=bounds.top AND y<bounds.top+DESKTYPES.TITLE_HEIGHT THEN
    BEGIN
      LET right=bounds.right-IF (frameKind & DESKTYPES.FRAME_FULLER)<>0
          THEN INT(DESKTYPES.FRAME_GADGET_WIDTH) ELSE INT(0) FI
      IF x>=right-DESKTYPES.FRAME_GADGET_WIDTH AND x<right THEN
        RETURN(8)
      FI
    END
  FI

  IF (frameKind & DESKTYPES.FRAME_FULLER)<>0
      AND x>=bounds.right-DESKTYPES.FRAME_GADGET_WIDTH AND x<bounds.right
      AND y>=bounds.top AND y<bounds.top+DESKTYPES.TITLE_HEIGHT THEN
    RETURN(7)
  FI

  IF (frameKind & DESKTYPES.FRAME_HORIZONTAL)<>0
      AND y>=bounds.bottom-DESKTYPES.FRAME_GADGET_HEIGHT
      AND y<bounds.bottom AND x>=bounds.left THEN
    BEGIN
      INT right

      right=bounds.right-IF (frameKind & (DESKTYPES.FRAME_VERTICAL
          OR DESKTYPES.FRAME_SIZER))<>0
          THEN INT(DESKTYPES.FRAME_GADGET_WIDTH) ELSE INT(0) FI
      LET left=bounds.left+IF (frameKind & DESKTYPES.FRAME_LFARROW)<>0
          THEN INT(DESKTYPES.FRAME_GADGET_WIDTH) ELSE INT(0) FI
      IF x<right THEN
        IF x<left THEN
          RETURN(10)
        FI
        IF (frameKind & DESKTYPES.FRAME_RTARROW)<>0 THEN
          right==-DESKTYPES.FRAME_GADGET_WIDTH
          IF x>=right THEN
            RETURN(11)
          FI
        FI
        IF (frameKind & DESKTYPES.FRAME_HSLIDE)=0 THEN
          RETURN(0)
        FI
        IF x<bounds.left+sliderLeft THEN
          RETURN(12)
        FI
        IF x>=bounds.left+sliderLeft+sliderWidth THEN
          RETURN(13)
        FI
        RETURN(14)
      FI
    END
  FI

  IF x<bounds.right-DESKTYPES.FRAME_GADGET_WIDTH OR x>=bounds.right
      OR y<bounds.top+Top(frameKind) OR y>=bounds.bottom THEN
    RETURN(0)
  FI
  IF (frameKind & DESKTYPES.FRAME_SIZER)<>0
      AND y>=bounds.bottom-DESKTYPES.FRAME_GADGET_HEIGHT THEN
    RETURN(1)
  FI
  IF (frameKind & DESKTYPES.FRAME_VERTICAL)=0
      OR y>=bounds.bottom-Bottom(frameKind) THEN
    RETURN(0)
  FI
  REGIONS.Assign(@rail,bounds.right-DESKTYPES.FRAME_GADGET_WIDTH,
      bounds.top+Top(frameKind),bounds.right-1,
      bounds.bottom-Bottom(frameKind))
  IF (frameKind & DESKTYPES.FRAME_UPARROW)<>0 THEN
    rail.top==+DESKTYPES.FRAME_GADGET_HEIGHT-1
  FI
  IF (frameKind & DESKTYPES.FRAME_DNARROW)<>0 THEN
    rail.bottom==-DESKTYPES.FRAME_GADGET_HEIGHT-1
  FI
  IF y<rail.top THEN
    RETURN(2)
  FI
  IF y>=rail.bottom THEN
    RETURN(3)
  FI
  IF (frameKind & DESKTYPES.FRAME_VSLIDE)=0 THEN
    RETURN(0)
  FI
  IF y<bounds.top+sliderTop THEN
    RETURN(4)
  FI
  IF y>=bounds.top+sliderTop+sliderHeight THEN
    RETURN(5)
  FI

RETURN(6)

PUBLIC BYTE FUNC GadgetHit(DESKTYPES.Window POINTER window
    LAYERTYPES.Rect POINTER bounds INT x,y)

RETURN(Gadget(window.frameKind,window.iconified,
    window.sliderTop,window.sliderHeight,window.sliderLeft,window.sliderWidth,
    bounds,x,y))

PUBLIC BYTE FUNC TitleHit(LAYERTYPES.Rect POINTER bounds INT x,y)

RETURN(x>=bounds.left+DESKTYPES.FRAME_EDGE
    AND x<bounds.right-DESKTYPES.FRAME_EDGE
    AND y>=bounds.top+DESKTYPES.FRAME_EDGE
    AND y<bounds.top+DESKTYPES.TITLE_HEIGHT-DESKTYPES.FRAME_EDGE)

PUBLIC BYTE FUNC CloseHit(LAYERTYPES.Rect POINTER bounds INT x,y)

RETURN(x>=bounds.left+DESKTYPES.CLOSE_LEFT
    AND x<bounds.left+DESKTYPES.CLOSE_RIGHT
    AND y>=bounds.top+DESKTYPES.CLOSE_TOP
    AND y<bounds.top+DESKTYPES.CLOSE_BOTTOM)

ENDMODULE
