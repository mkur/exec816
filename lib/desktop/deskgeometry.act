; Fixed desktop geometry shared by drawing, input and work-area publication.
MODULE DESKGEOMETRY
USE DESKTYPES
USE LAYERTYPES
USE REGIONS

PUBLIC INT FUNC Top(CARD kind)

  IF (kind & DESKTYPES.FRAME_BORDERLESS)<>0 THEN
    RETURN(0)
  FI
RETURN(DESKTYPES.WORK_TOP+IF (kind & DESKTYPES.FRAME_INFO)<>0 THEN
    DESKTYPES.FRAME_INFO_HEIGHT ELSE 0 FI)

PUBLIC INT FUNC Right(CARD kind)

  IF (kind & DESKTYPES.FRAME_BORDERLESS)<>0 THEN
    RETURN(0)
  FI
RETURN(IF (kind & DESKTYPES.FRAME_VERTICAL)<>0 THEN
    DESKTYPES.FRAME_GADGET_WIDTH ELSE DESKTYPES.WORK_RIGHT FI)

PUBLIC INT FUNC Bottom(CARD kind)

  IF (kind & DESKTYPES.FRAME_BORDERLESS)<>0 THEN
    RETURN(0)
  FI
RETURN(IF (kind & DESKTYPES.FRAME_SIZER)<>0 THEN
    DESKTYPES.FRAME_GADGET_HEIGHT ELSE DESKTYPES.WORK_BOTTOM FI)

PUBLIC PROC Work(CARD kind
    LAYERTYPES.Rect POINTER bounds,work)

  IF (kind & DESKTYPES.FRAME_BORDERLESS)<>0 THEN
    REGIONS.Copy(bounds,work)
    RETURN
  FI
  REGIONS.Assign(work,bounds.left+DESKTYPES.WORK_LEFT,
      bounds.top+Top(kind),bounds.right-Right(kind),
      bounds.bottom-Bottom(kind))

RETURN

; Relative track coordinates are shared by cached thumb geometry and capture.
PROC BuildTrack(CARD kind
    LAYERTYPES.Rect POINTER bounds,track)

  REGIONS.Assign(track,bounds.right-DESKTYPES.FRAME_GADGET_WIDTH,
      bounds.top+Top(kind),bounds.right-1,
      bounds.bottom-Bottom(kind))
  IF (kind & DESKTYPES.FRAME_UPARROW)<>0 THEN
    track.top==+DESKTYPES.FRAME_GADGET_HEIGHT
  FI
  IF (kind & DESKTYPES.FRAME_DNARROW)<>0 THEN
    track.bottom==-DESKTYPES.FRAME_GADGET_HEIGHT
  FI

RETURN

PUBLIC PROC ScrollTrack(DESKTYPES.Window POINTER window
    LAYERTYPES.Rect POINTER bounds,track)

  BuildTrack(window.frameKind,bounds,track)

RETURN

; Slider arithmetic runs only on mutations, never in each frame fragment.
PUBLIC PROC Slider(DESKTYPES.Window POINTER window
    LAYERTYPES.Rect POINTER bounds INT position,size)
  LAYERTYPES.Rect track
  INT height,thumb

  IF (window.frameKind & DESKTYPES.FRAME_VERTICAL)=0 THEN
    window.sliderTop=0
    window.sliderHeight=0
    RETURN
  FI

  ScrollTrack(window,bounds,@track)
  height=track.bottom-track.top
  thumb=INT((LONGCARD(CARD(height))*LONGCARD(CARD(size)))/1000)
  IF thumb<DESKTYPES.FRAME_THUMB_MIN THEN
    thumb=DESKTYPES.FRAME_THUMB_MIN
  FI
  IF thumb>height THEN
    thumb=height
  FI
  window.sliderHeight=thumb
  window.sliderTop=track.top-bounds.top
      +INT((LONGCARD(CARD(height-thumb))*LONGCARD(CARD(position)))/1000)

RETURN

; Reserve one text cell between the actual title controls.
BYTE FUNC IconSpace(CARD frameKind
    LAYERTYPES.Rect POINTER bounds)
  INT available

  available=bounds.right-bounds.left
      -DESKTYPES.FRAME_GADGET_WIDTH
  IF (frameKind & DESKTYPES.FRAME_FULLER)<>0 THEN
    available==-DESKTYPES.FRAME_GADGET_WIDTH
  FI

RETURN(frameKind<>DESKTYPES.FRAME_BORDERLESS
    AND available>=DESKTYPES.FRAME_GADGET_WIDTH+8+2*DESKTYPES.TITLE_PAD)

PUBLIC BYTE FUNC HasIcon(DESKTYPES.Window POINTER window
    LAYERTYPES.Rect POINTER bounds)

RETURN(IconSpace(window.frameKind,bounds))

; Hit codes are private presenter facts: size, up, down, page up/down, thumb.
PUBLIC BYTE FUNC Gadget(CARD frameKind BYTE iconified
    INT sliderTop,sliderHeight
    LAYERTYPES.Rect POINTER bounds INT x,y)
  LAYERTYPES.Rect rail

  IF iconified<>0 THEN
    RETURN(IF x>=bounds.left AND x<bounds.right
        AND y>=bounds.top AND y<bounds.bottom THEN 9 ELSE 0 FI)
  FI

  IF IconSpace(frameKind,bounds)<>0
      AND y>=bounds.top AND y<bounds.top+DESKTYPES.TITLE_HEIGHT THEN
    BEGIN
      LET right=bounds.right-IF (frameKind & DESKTYPES.FRAME_FULLER)<>0
          THEN INT(DESKTYPES.FRAME_GADGET_WIDTH) ELSE INT(0) FI
      IF x>=right-DESKTYPES.FRAME_GADGET_WIDTH AND x<right THEN
        RETURN(8)
      FI
    END
  FI

  IF (frameKind & DESKTYPES.FRAME_FULLER)<>0
      AND x>=bounds.right-DESKTYPES.FRAME_GADGET_WIDTH AND x<bounds.right
      AND y>=bounds.top AND y<bounds.top+DESKTYPES.TITLE_HEIGHT THEN
    RETURN(7)
  FI

  IF x<bounds.right-DESKTYPES.FRAME_GADGET_WIDTH OR x>=bounds.right
      OR y<bounds.top+Top(frameKind) OR y>=bounds.bottom THEN
    RETURN(0)
  FI
  IF (frameKind & DESKTYPES.FRAME_SIZER)<>0
      AND y>=bounds.bottom-DESKTYPES.FRAME_GADGET_HEIGHT THEN
    RETURN(1)
  FI
  IF (frameKind & DESKTYPES.FRAME_VERTICAL)=0
      OR y>=bounds.bottom-Bottom(frameKind) THEN
    RETURN(0)
  FI
  BuildTrack(frameKind,bounds,@rail)
  IF y<rail.top THEN
    RETURN(2)
  FI
  IF y>=rail.bottom THEN
    RETURN(3)
  FI
  IF (frameKind & DESKTYPES.FRAME_VSLIDE)=0 THEN
    RETURN(0)
  FI
  IF y<bounds.top+sliderTop THEN
    RETURN(4)
  FI
  IF y>=bounds.top+sliderTop+sliderHeight THEN
    RETURN(5)
  FI

RETURN(6)

PUBLIC BYTE FUNC GadgetHit(DESKTYPES.Window POINTER window
    LAYERTYPES.Rect POINTER bounds INT x,y)

RETURN(Gadget(window.frameKind,window.iconified,
    window.sliderTop,window.sliderHeight,bounds,x,y))

PUBLIC BYTE FUNC TitleHit(LAYERTYPES.Rect POINTER bounds INT x,y)

RETURN(x>=bounds.left+DESKTYPES.FRAME_EDGE
    AND x<bounds.right-DESKTYPES.FRAME_EDGE
    AND y>=bounds.top+DESKTYPES.FRAME_EDGE
    AND y<bounds.top+DESKTYPES.TITLE_HEIGHT-DESKTYPES.FRAME_EDGE)

PUBLIC BYTE FUNC CloseHit(LAYERTYPES.Rect POINTER bounds INT x,y)

RETURN(x>=bounds.left+DESKTYPES.CLOSE_LEFT
    AND x<bounds.left+DESKTYPES.CLOSE_RIGHT
    AND y>=bounds.top+DESKTYPES.CLOSE_TOP
    AND y<bounds.top+DESKTYPES.CLOSE_BOTTOM)

ENDMODULE
