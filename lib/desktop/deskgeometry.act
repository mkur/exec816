; Fixed desktop geometry shared by drawing, input and work-area publication.
MODULE DESKGEOMETRY
USE DESKTYPES
USE LAYERTYPES
USE REGIONS

PUBLIC INT FUNC Right(CARD kind)

RETURN(IF (kind & DESKTYPES.FRAME_VERTICAL)<>0 THEN
    DESKTYPES.FRAME_GADGET ELSE DESKTYPES.WORK_RIGHT FI)

PUBLIC INT FUNC Bottom(CARD kind)

RETURN(IF (kind & DESKTYPES.FRAME_SIZER)<>0 THEN
    DESKTYPES.FRAME_GADGET ELSE DESKTYPES.WORK_BOTTOM FI)

PUBLIC PROC Work(CARD kind
    LAYERTYPES.Rect POINTER bounds,work)

  REGIONS.Assign(work,bounds.left+DESKTYPES.WORK_LEFT,
      bounds.top+DESKTYPES.WORK_TOP,bounds.right-Right(kind),
      bounds.bottom-Bottom(kind))

RETURN

; Relative track coordinates are shared by cached thumb geometry and capture.
PUBLIC PROC ScrollTrack(DESKTYPES.Window POINTER window
    LAYERTYPES.Rect POINTER bounds,track)

  REGIONS.Assign(track,bounds.right-DESKTYPES.FRAME_GADGET,
      bounds.top+DESKTYPES.TITLE_HEIGHT,bounds.right-1,
      bounds.bottom-Bottom(window.frameKind))
  IF (window.frameKind & DESKTYPES.FRAME_UPARROW)<>0 THEN
    track.top==+DESKTYPES.FRAME_GADGET
  FI
  IF (window.frameKind & DESKTYPES.FRAME_DNARROW)<>0 THEN
    track.bottom==-DESKTYPES.FRAME_GADGET
  FI

RETURN

; Slider arithmetic runs only on mutations, never in each frame fragment.
PUBLIC PROC Slider(DESKTYPES.Window POINTER window
    LAYERTYPES.Rect POINTER bounds INT position,size)
  LAYERTYPES.Rect track
  INT height,thumb

  IF (window.frameKind & DESKTYPES.FRAME_VERTICAL)=0 THEN
    window.sliderTop=0
    window.sliderHeight=0
    RETURN
  FI

  ScrollTrack(window,bounds,@track)
  height=track.bottom-track.top
  thumb=INT((LONGCARD(CARD(height))*LONGCARD(CARD(size)))/1000)
  IF thumb<DESKTYPES.FRAME_THUMB_MIN THEN
    thumb=DESKTYPES.FRAME_THUMB_MIN
  FI
  IF thumb>height THEN
    thumb=height
  FI
  window.sliderHeight=thumb
  window.sliderTop=track.top-bounds.top
      +INT((LONGCARD(CARD(height-thumb))*LONGCARD(CARD(position)))/1000)

RETURN

; Hit codes are private presenter facts: size, up, down, page up/down, thumb.
PUBLIC BYTE FUNC GadgetHit(DESKTYPES.Window POINTER window
    LAYERTYPES.Rect POINTER bounds INT x,y)
  LAYERTYPES.Rect rail

  IF x<bounds.right-DESKTYPES.FRAME_GADGET OR x>=bounds.right
      OR y<bounds.top+DESKTYPES.TITLE_HEIGHT OR y>=bounds.bottom THEN
    RETURN(0)
  FI
  IF (window.frameKind & DESKTYPES.FRAME_SIZER)<>0
      AND y>=bounds.bottom-DESKTYPES.FRAME_GADGET THEN
    RETURN(1)
  FI
  IF (window.frameKind & DESKTYPES.FRAME_VERTICAL)=0
      OR y>=bounds.bottom-Bottom(window.frameKind) THEN
    RETURN(0)
  FI
  ScrollTrack(window,bounds,@rail)
  IF y<rail.top THEN
    RETURN(2)
  FI
  IF y>=rail.bottom THEN
    RETURN(3)
  FI
  IF (window.frameKind & DESKTYPES.FRAME_VSLIDE)=0 THEN
    RETURN(0)
  FI
  IF y<bounds.top+window.sliderTop THEN
    RETURN(4)
  FI
  IF y>=bounds.top+window.sliderTop+window.sliderHeight THEN
    RETURN(5)
  FI

RETURN(6)

PUBLIC BYTE FUNC TitleHit(LAYERTYPES.Rect POINTER bounds INT x,y)

RETURN(x>=bounds.left+DESKTYPES.FRAME_EDGE
    AND x<bounds.right-DESKTYPES.FRAME_EDGE
    AND y>=bounds.top+DESKTYPES.FRAME_EDGE
    AND y<bounds.top+DESKTYPES.TITLE_HEIGHT-DESKTYPES.FRAME_EDGE)

PUBLIC BYTE FUNC CloseHit(LAYERTYPES.Rect POINTER bounds INT x,y)

RETURN(x>=bounds.left+DESKTYPES.CLOSE_LEFT
    AND x<bounds.left+DESKTYPES.CLOSE_RIGHT
    AND y>=bounds.top+DESKTYPES.CLOSE_TOP
    AND y<bounds.top+DESKTYPES.CLOSE_BOTTOM)

ENDMODULE
