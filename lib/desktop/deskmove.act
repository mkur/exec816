; Synchronous caller-owned copied moves under UPDATE.
MODULE DESKMOVE
USE AESTYPES
USE AESWINDOWSTATE
USE AESFRAME
USE DISPLAY
USE DESKTYPES
USE DESKSTATE
USE LAYERTYPES
USE LAYERS
USE CONSOLEBITMAP
USE HEAPCORE

; Both admission and the presenter use the same copy eligibility. A
; caller declines this effect before BeginMove reserves or changes anything.
PUBLIC BYTE FUNC CopyEligible(DESKTYPES.Window POINTER window
    LAYERTYPES.Layer POINTER layer INT left)
  BYTE eligible

  eligible=(DISPLAY.Blocked()=0
      AND CONSOLEBITMAP.Enabled()<>0 AND layer.dirty=0 AND layer.shown<>0
      AND ((layer.bounds.left OR left OR
          (layer.bounds.right-layer.bounds.left)) & 1)=0)

RETURN(eligible)

; The Layers token and native packet stay on the owning caller's stack.
; No shared bitmap packet or manager reply continuation survives this call.
PUBLIC CARD FUNC Application(DESKTYPES.Service POINTER service
    DESKTYPES.Window POINTER window INT left,top
    AESTYPES.Request POINTER request)
  BYTE status,completed
  LONGCARD token
  CONSOLEBITMAP.Packet packet

  LET layer=LAYERS.Find(@service.scene,window.layer)
  IF layer.bounds.left=left AND layer.bounds.top=top THEN
    RETURN(DESKTYPES.OK)
  FI
  IF CopyEligible(window,layer,left)<>0 THEN
    IF request.displayGrant=NULL THEN
      RETURN(DESKTYPES.DRAW_FAILED)
    FI
    status=LAYERS.BeginMove(@service.scene,window.layer,left,top,@token)
    IF status=LAYERTYPES.OK THEN
      packet.operation=CONSOLEBITMAP.OP_COPY_START
      packet.copy.source.offset=0
      packet.copy.source.pitch=320
      packet.copy.source.width=640
      packet.copy.source.height=240
      packet.copy.destination.offset=0
      packet.copy.destination.pitch=320
      packet.copy.destination.width=640
      packet.copy.destination.height=240
      packet.copy.sourceX=CARD(service.scene.copySource.left)
      packet.copy.sourceY=CARD(service.scene.copySource.top)
      packet.copy.destinationX=CARD(service.scene.copyTarget.left)
      packet.copy.destinationY=CARD(service.scene.copyTarget.top)
      packet.copy.width=CARD(service.scene.copySource.right
          -service.scene.copySource.left)
      packet.copy.height=CARD(service.scene.copySource.bottom
          -service.scene.copySource.top)
      AESFRAME.Apply(@packet)
      completed=(packet.status=DISPLAY.OK)
      IF LAYERS.Finish(@service.scene,token,completed)<>LAYERTYPES.OK THEN
        HEAPCORE.Abort($faed)
      FI
      AESWINDOWSTATE.Geometry(window,completed)
      AESWINDOWSTATE.Sync()
      RETURN(IF completed<>0 THEN DESKTYPES.OK ELSE DESKTYPES.DRAW_FAILED FI)
    ELSEIF status=LAYERTYPES.EMPTY THEN
      RETURN(DESKTYPES.OK)
    FI
  FI
  status=LAYERS.Move(@service.scene,window.layer,left,top)
  IF status=LAYERTYPES.OK THEN
    AESWINDOWSTATE.Geometry(window,0)
    AESWINDOWSTATE.Sync()
  FI

RETURN(IF status=LAYERTYPES.OK THEN DESKTYPES.OK ELSE DESKTYPES.BAD_ARGUMENT FI)

ENDMODULE
