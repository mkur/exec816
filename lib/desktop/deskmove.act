; One presenter continuation owns copied geometry until the shared DMA retires.
MODULE DESKMOVE
USE AESTYPES
USE AESWINDOWSTATE
USE DISPLAY
USE DESKTYPES
USE DESKEVENTS
USE DESKSTATE
USE DESKGEOMETRY
USE LAYERTYPES
USE LAYERS
USE CONSOLEBITMAP
USE CONSOLEDISPLAY
USE CONSOLEWINDOWS
USE CONSOLETYPES
USE CONSOLEBATCH
USE CONSOLECORE
USE HEAPCORE

LONGCARD moveToken
DESKTYPES.Window POINTER moving
DESKTYPES.Request POINTER reply
AESTYPES.Request POINTER aesReply
CARD aesStatus

; Restoring a caret also schedules its next presentation. A command-window
; move may expose no console pixels, so damage alone cannot wake that work.
PUBLIC PROC HideCaret()
  BYTE index

  LET previous=DESKSTATE.ConsoleUnit()
  LET windows=CONSOLEWINDOWS.Registry()
  FOR index=0 TO CONSOLETYPES.WINDOW_SLOTS-1 DO
    BEGIN
      LET entry=@windows.items(index)
      IF CONSOLEWINDOWS.Live(entry)<>0
          AND DESKSTATE.FindConsoleWindow(entry.unit)<>NULL THEN
        BEGIN
          LET view=CONSOLETYPES.Presentation POINTER(entry.view)
          IF view.cursorOn<>0 THEN
            DESKSTATE.SelectConsoleUnit(entry.unit)
            CONSOLEDISPLAY.RemoveCursor(view)
            view.index=$ffff
          FI
        END
      FI
    END
  OD
  DESKSTATE.SelectConsoleUnit(previous)

RETURN

; Commit the console origin with geometry, before the next output quantum.
; Copied pixels preserve the model; redraw moves discard any gathered batch.
PROC Rebase(DESKTYPES.Window POINTER window
    LAYERTYPES.Layer POINTER layer BYTE copied)

  LET entry=CONSOLEWINDOWS.Find(window.console)
  IF entry=NULL THEN
    RETURN
  FI

  LET view=CONSOLETYPES.Presentation POINTER(entry.view)
  IF copied=0 THEN
    BEGIN
      LET instance=CONSOLETYPES.Instance POINTER(entry.instance)
      LET batch=CONSOLEBATCH.Get()
      IF CONSOLEDISPLAY.BackingEnabled(view)=0 OR view.scrollState<>0
          OR batch.phase<>CONSOLETYPES.BATCH_IDLE THEN
        view.presentedGeneration=0
        CONSOLECORE.Dirty(instance,0,instance.count)
      FI
      CONSOLEBATCH.Reset()
      view.scrollState=0
    END
  FI

  view.left=CARD(layer.bounds.left+DESKTYPES.WORK_LEFT) RSH 3
  view.top=CARD(layer.bounds.top+DESKGEOMETRY.Top(window.frameKind)) RSH 3
  view.cursorOn=0
  view.index=$ffff
  view.generation==+1

RETURN

PUBLIC PROC Pump()
  BYTE status,completed

  IF moveToken=0 OR CONSOLEBITMAP.Pending()<>0 THEN
    RETURN
  FI

  LET service=DESKSTATE.Get()
  completed=(CONSOLEBITMAP.Failed()=0)
  status=LAYERS.Finish(@service.scene,moveToken,completed)
  IF status<>LAYERTYPES.OK THEN
    HEAPCORE.Abort($faed)
  FI

  IF completed<>0 AND DESKSTATE.IsConsole(moving)<>0 THEN
    Rebase(moving,LAYERS.Find(@service.scene,moving.layer),1)
  FI

  IF completed<>0 AND moving.kind=DESKTYPES.CONTENT_AES THEN
    AESWINDOWSTATE.Moved(AESWINDOWSTATE.FindRecord(moving.id))
    AESWINDOWSTATE.Sync()
  FI

  aesStatus=IF completed<>0 THEN DESKTYPES.OK ELSE DESKTYPES.DRAW_FAILED FI
  moveToken=0
  moving=NULL
  IF reply<>NULL THEN
    DESKEVENTS.Reply(reply,
        IF completed<>0 THEN DESKTYPES.OK ELSE DESKTYPES.DRAW_FAILED FI)
    reply=NULL
  FI

RETURN

; Unsupported placement and nonclean sources retain the ordinary redraw path.
PUBLIC CARD FUNC Start(DESKTYPES.Service POINTER service
    DESKTYPES.Window POINTER window INT left,top
    DESKTYPES.Request POINTER request)
  BYTE status,drawn,eligible,changed
  LONGCARD token

  IF window.iconified<>0 THEN
    BEGIN
      LET bounds=@window.normalBounds
      bounds.right=left+bounds.right-bounds.left
      bounds.bottom=top+bounds.bottom-bounds.top
      bounds.left=left
      bounds.top=top
    END
    RETURN(DESKTYPES.OK)
  FI

  LET layer=LAYERS.Find(@service.scene,window.layer)
  IF layer.bounds.left=left AND layer.bounds.top=top THEN
    RETURN(DESKTYPES.OK)
  FI

  eligible=(DISPLAY.Blocked()=0
      AND CONSOLEBITMAP.Enabled()<>0 AND layer.dirty=0 AND layer.shown<>0
      AND ((layer.bounds.left OR left OR
          (layer.bounds.right-layer.bounds.left)) & 1)=0)
  IF eligible<>0 AND DESKSTATE.IsConsole(window)<>0 THEN
    BEGIN
      LET entry=CONSOLEWINDOWS.Find(window.console)
      LET instance=CONSOLETYPES.Instance POINTER(entry.instance)
      LET batch=CONSOLEBATCH.Get()
      eligible=(instance.dirtyRows=0 AND batch.phase=CONSOLETYPES.BATCH_IDLE)
    END
  FI

  IF eligible<>0 THEN
    ; Removing the caret uses an ordinary paint transaction, before move admission.
    HideCaret()

    drawn=CONSOLEBITMAP.Outline(0,0,0,0,0)
    status=LAYERS.BeginMove(@service.scene,window.layer,left,top,@token)
    IF status=LAYERTYPES.EMPTY THEN
      RETURN(DESKTYPES.OK)
    FI

    IF status=LAYERTYPES.OK THEN
      BEGIN
        LET packet=CONSOLEBITMAP.GetPacket()
        packet.copy.source.offset=0
        packet.copy.source.pitch=320
        packet.copy.source.width=640
        packet.copy.source.height=240
        packet.copy.destination.offset=0
        packet.copy.destination.pitch=320
        packet.copy.destination.width=640
        packet.copy.destination.height=240
        packet.copy.sourceX=CARD(layer.bounds.left)
        packet.copy.sourceY=CARD(layer.bounds.top)
        packet.copy.destinationX=CARD(left)
        packet.copy.destinationY=CARD(top)
        packet.copy.width=CARD(layer.bounds.right-layer.bounds.left)
        packet.copy.height=CARD(layer.bounds.bottom-layer.bounds.top)
        IF CONSOLEBITMAP.CopyStart()=0 THEN
          status=LAYERS.Finish(@service.scene,token,0)
          RETURN(DESKTYPES.DRAW_FAILED)
        FI
      END

      moveToken=token
      moving=window
      reply=request
      RETURN(DESKTYPES.PENDING)
    FI
  FI

  changed=layer.bounds.left<>left OR layer.bounds.top<>top
  status=LAYERS.Move(@service.scene,window.layer,left,top)
  IF status=LAYERTYPES.OK AND changed<>0
      AND DESKSTATE.IsConsole(window)<>0 THEN
    Rebase(window,layer,0)
  FI

RETURN(IF status=LAYERTYPES.OK THEN DESKTYPES.OK ELSE DESKTYPES.BAD_ARGUMENT FI)

; AESCORE owns the reply and retries this same retained request. Only Pump
; publishes a completed copied move; an ordinary fallback still damages work.
PUBLIC CARD FUNC Application(DESKTYPES.Service POINTER service
    DESKTYPES.Window POINTER window INT left,top
    AESTYPES.Request POINTER request)
  CARD status

  IF aesReply<>NULL THEN
    IF aesReply<>request OR moveToken<>0 THEN
      RETURN(DESKTYPES.PENDING)
    FI

    aesReply=NULL
    RETURN(aesStatus)
  FI

  status=Start(service,window,left,top,NULL)
  IF status=DESKTYPES.PENDING THEN
    aesReply=request
  ELSEIF status=DESKTYPES.OK THEN
    BEGIN
      LET item=AESWINDOWSTATE.FindRecord(window.id)
      AESWINDOWSTATE.Snapshot(item)
      AESWINDOWSTATE.Moved(item)
      AESWINDOWSTATE.Sync()
    END
  FI

RETURN(status)

; Retirement already waits for scene/DMA quiescence before releasing a client.
PUBLIC PROC Forget(AESTYPES.Request POINTER request)

  IF aesReply=request THEN
    aesReply=NULL
  FI

RETURN

ENDMODULE
