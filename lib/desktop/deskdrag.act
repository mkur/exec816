; Presenter-owned gesture state. No nested input loop and no borrowed client
; pointer survives a turn; identities resolve against the current scene.
MODULE DESKDRAG
USE DISPLAY
USE EXEC
USE AESLOCKS
USE AESMOUSE
USE AESSTATE
USE AESTYPES
USE AESWINDOWSTATE
USE INPUT
USE DESKTYPES
USE DESKSTATE
USE DESKCORE
USE DESKFINISH
USE DESKGEOMETRY
USE GEMOBJECTS
USE GEMHIT
USE DESKMENU
USE LAYERTYPES
USE LAYERS
USE REGIONS
USE CONSOLEBITMAP
USE HEAPCORE

LONGCARD windowId,lossEpoch
LONGCARD appOwner,appEpoch
BYTE appVisual
LAYERTYPES.Rect origin,target
INT pressX,pressY,sliderMin,sliderTravel,sliderValue
INT gadget
BYTE restoreIcon
INT arrowCode
BYTE phase,blocked,dirty,escapePending
CONST DRAGGING=1
CONST MOVE_PENDING=2
CONST CLOSING=3
CONST CLOSE_PENDING=4
CONST SIZING=5, SIZE_PENDING=6, SLIDING=7, SLIDE_PENDING=8
CONST ARROWING=9, ARROW_PENDING=10
CONST APP_DRAG=11
CONST ESC_SCAN=28

; A waiter cannot take a held native capture. Finish its input and outline
; before the queued handoff; actual mouse ownership still excludes this path.
PUBLIC BYTE FUNC Continuing()

  LET service=AESSTATE.Get()

RETURN(appVisual=0 AND (phase=DRAGGING OR phase=CLOSING OR phase=SIZING
    OR phase=SLIDING OR phase=ARROWING)
    AND (service=NULL OR service.live=0 OR service.mouseOwner=0))

PROC ResetCapture()

  escapePending=0
  appOwner=0
  appVisual=0
  windowId=0
  phase=0
  DESKSTATE.managerCapture=0
  blocked=0
  DESKSTATE.outlineVisible=0
  dirty=0

  lossEpoch=DESKSTATE.LossEpoch()

RETURN

PROC CancelCapture()

  escapePending=0
  appOwner=0
  windowId=0
  phase=0
  DESKSTATE.managerCapture=0
  blocked=1
  IF appVisual<>0 THEN
    BEGIN
      AESTYPES.InputRecord sampleCopy
    AESMOUSE.CopySample(@sampleCopy)
      blocked=sampleCopy.buttons<>0
    END
  FI
  dirty=1

  lossEpoch=DESKSTATE.LossEpoch()

RETURN

PUBLIC BYTE FUNC Escape(INPUT.Event POINTER sample)

  ; The AES application consumes Escape and its eventual button release.
  IF appVisual<>0 THEN
    RETURN(0)
  FI

  IF (phase<>0 OR AESMOUSE.NativeGesture()<>0)
      AND ((sample.kind=INPUT.EVENT_KEY
      AND (sample.code & 63)=ESC_SCAN) OR (sample.kind=INPUT.EVENT_CANCEL
      AND sample.code=INPUT.CANCEL_BREAK)) THEN
  IF Continuing()=0 AND AESLOCKS.SystemBlocked()<>0 THEN
      escapePending=1
    ELSE
      Cancel()
    FI

    RETURN(1)
  FI

RETURN(0)

INT FUNC FindObject(DESKTYPES.Window POINTER window INT x,y)

RETURN(GEMHIT.Find(@window.frame.tree(0),0,8,x,y))

BYTE FUNC CloseHit(DESKTYPES.Window POINTER window INT x,y)

RETURN(FindObject(window,x,y)=GEMOBJECTS.O_CLOSER)

; Track background clicks use the selected thumb from the same live tree.
INT FUNC Arrow(DESKTYPES.Window POINTER window INT object,x,y)
  LAYERTYPES.Rect thumb

  CASE object OF
  WHEN GEMOBJECTS.O_UP THEN
    RETURN(AESTYPES.WA_UPLINE)
  WHEN GEMOBJECTS.O_DOWN THEN
    RETURN(AESTYPES.WA_DNLINE)
  WHEN GEMOBJECTS.O_LEFT THEN
    RETURN(AESTYPES.WA_LFLINE)
  WHEN GEMOBJECTS.O_RIGHT THEN
    RETURN(AESTYPES.WA_RTLINE)
  WHEN GEMOBJECTS.O_VSCROLL THEN
    DESKGEOMETRY.ObjectRect(window,GEMOBJECTS.O_VSLIDE,@thumb)
    RETURN(IF y<thumb.top THEN INT(AESTYPES.WA_UPPAGE)
        ELSE INT(AESTYPES.WA_DNPAGE) FI)
  WHEN GEMOBJECTS.O_HSCROLL THEN
    DESKGEOMETRY.ObjectRect(window,GEMOBJECTS.O_HSLIDE,@thumb)
    RETURN(IF x<thumb.left THEN INT(AESTYPES.WA_LFPAGE)
        ELSE INT(AESTYPES.WA_RTPAGE) FI)
  ELSE
    RETURN(-1)
  ESAC

RETURN(-1)

PROC Position(INT x,y)
  INT left,top,width,height,limit

  width=origin.right-origin.left
  height=origin.bottom-origin.top
  left=origin.left+x-pressX
  top=origin.top+y-pressY
  IF left<0 THEN
    left=0
  FI

  IF top<DESKMENU.BAR_HEIGHT THEN
    top=DESKMENU.BAR_HEIGHT
  FI


  limit=640-width
  IF left>limit THEN
    left=limit
  FI

  limit=240-height
  IF top>limit THEN
    top=limit
  FI

  IF target.left<>left OR target.top<>top THEN
    dirty=1
  FI

  REGIONS.Assign(@target,left,top,left+width,top+height)

RETURN

BYTE FUNC Outlined()

RETURN(phase=DRAGGING OR phase=MOVE_PENDING OR phase=SIZING
    OR phase=SIZE_PENDING OR phase=SLIDING OR phase=SLIDE_PENDING
    OR phase=APP_DRAG)

PUBLIC BYTE FUNC Application()

RETURN(appVisual)

; A retained application outline must be physically erased before painting.
PUBLIC BYTE FUNC DrawReady()

RETURN(appVisual=0 OR DESKSTATE.outlineVisible=0)

; Admit geometry once; tracking below follows capture without application RPC.
CARD FUNC AdmitOutline(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client AESTYPES.Request POINTER request)

  IF request.intin(0)=0 THEN
    IF appOwner=client.id THEN
      Cancel()
    FI
    request.intout(0)=1
    RETURN(AESTYPES.OK)
  FI

  LET item=AESWINDOWSTATE.Handle(client,request.intin(0))
  IF item=NULL OR service.mouseOwner<>client.id OR service.mouseHolds=0 THEN
    RETURN(AESTYPES.IDENTITY)
  FI

  IF phase<>0 OR AESMOUSE.DragReady(client.id,item.view.epoch)=0 THEN
    RETURN(AESTYPES.BUSY)
  FI

  IF request.intin(3)<8 OR request.intin(3)>80
      OR request.intin(4)<8 OR request.intin(4)>32 THEN
    RETURN(AESTYPES.MALFORMED)
  FI

  appOwner=client.id
  appEpoch=item.view.epoch
  appVisual=1
  windowId=item.id
  lossEpoch=DESKSTATE.LossEpoch()
  phase=APP_DRAG
  blocked=0


  pressX=-request.intin(1)
  pressY=-request.intin(2)
  REGIONS.Assign(@origin,0,0,request.intin(3),request.intin(4))
  dirty=1
  BEGIN
    AESTYPES.InputRecord sampleCopy
    AESMOUSE.CopySample(@sampleCopy)
    Position(sampleCopy.x,sampleCopy.y)
  END
  request.intout(0)=1

RETURN(AESTYPES.OK)

PUBLIC CARD FUNC Outline(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client AESTYPES.Request POINTER request)
  CARD status

  EXEC.Forbid()
  status=AdmitOutline(service,client,request)
  EXEC.Permit()

RETURN(status)

; Capture and MCTRL own the lifetime. This remains cheap on each presenter turn.
PROC TrackCapture()
  AESTYPES.InputRecord sampleCopy

  IF appOwner=0 THEN
    RETURN
  FI

  LET service=AESSTATE.Get()
  IF service.mouseOwner<>appOwner OR service.mouseHolds=0
      OR AESMOUSE.DragReady(appOwner,appEpoch)=0 THEN
    Cancel()
    RETURN
  FI

  AESMOUSE.CopySample(@sampleCopy)
  Position(sampleCopy.x,sampleCopy.y)

RETURN

PUBLIC PROC Track()

  EXEC.Forbid()
  TrackCapture()
  EXEC.Permit()

RETURN

; An ineligible peer UPDATE must not erase or spin the owner's visual. The
; existing mouse owner may upgrade; suspend as soon as its request is pending.
BYTE FUNC InspectApplicationReady()

  LET service=AESSTATE.Get()
  IF service=NULL OR appOwner=0 OR service.updateHolds<>0
      OR service.updateOwner<>appOwner
      OR service.windowPending<>0 THEN
    RETURN(0)
  FI

  LET client=AESSTATE.Find(service,appOwner)

RETURN(client<>NULL AND client.pending=NULL AND service.mouseOwner=appOwner
    AND service.mouseHolds<>0)

BYTE FUNC ApplicationReady()
  BYTE ready

  EXEC.Forbid()
  ready=InspectApplicationReady()
  EXEC.Permit()

RETURN(ready)

; Resizing keeps its upper-left anchor. Applications may request larger minima.
PROC SizePosition(INT x,y DESKTYPES.Window POINTER window)
  INT width,height

  width=origin.right-origin.left+x-pressX
  height=origin.bottom-origin.top+y-pressY
  IF width<window.frame.minWidth THEN
    width=window.frame.minWidth
  FI
  IF height<window.frame.minHeight THEN
    height=window.frame.minHeight
  FI
  IF width>640-origin.left THEN
    width=640-origin.left
  FI
  IF height>240-origin.top THEN
    height=240-origin.top
  FI
  IF target.right<>origin.left+width OR target.bottom<>origin.top+height THEN
    target.right=origin.left+width
    target.bottom=origin.top+height
    dirty=1
  FI

RETURN

PROC SlidePosition(INT x,y)
  INT top,height

  top=IF gadget=GEMOBJECTS.O_HSLIDE THEN x-pressX ELSE y-pressY FI
  IF top<sliderMin THEN
    top=sliderMin
  FI
  IF top>sliderMin+sliderTravel THEN
    top=sliderMin+sliderTravel
  FI
  sliderValue=0
  IF sliderTravel<>0 THEN
    sliderValue=INT((LONGCARD(CARD(top-sliderMin))*1000
        +LONGCARD(CARD(sliderTravel) RSH 1))/LONGCARD(CARD(sliderTravel)))
  FI
  IF gadget=GEMOBJECTS.O_HSLIDE THEN
    IF top<>target.left THEN
      height=target.right-target.left
      target.left=top
      target.right=top+height
      dirty=1
    FI
  ELSEIF top<>target.top THEN
    height=target.bottom-target.top
    target.top=top
    target.bottom=top+height
    dirty=1
  FI

RETURN

; A title/close press captures subsequent edges and motion even outside the
; original window. A release remains pending until geometry can safely commit.
PUBLIC BYTE FUNC Capture(INPUT.Event POINTER sample BYTE released)
  BYTE slot
  INT hit
  LONGCARD layerId
  LAYERTYPES.Rect rail

  LET service=DESKSTATE.Get()
  IF lossEpoch<>DESKSTATE.LossEpoch() THEN
    Cancel()
  FI

  IF blocked<>0 THEN
    IF sample.buttons=0 THEN
      blocked=0
    FI

    RETURN(1)
  FI

  IF phase=DRAGGING THEN
    Position(sample.x,sample.y)
    IF (sample.buttons & INPUT.LEFT)=0 THEN
      phase=MOVE_PENDING
    FI

    RETURN(1)
  FI

  IF phase=SIZING OR phase=SLIDING OR phase=ARROWING THEN
    BEGIN
      LET window=DESKCORE.Find(service,windowId)
      IF window=NULL THEN
        Cancel()
        RETURN(1)
      FI
      LET layer=DESKCORE.Layer(service,window)
      IF phase=SIZING THEN
        SizePosition(sample.x,sample.y,window)
        IF (sample.buttons & INPUT.LEFT)=0 THEN
          phase=SIZE_PENDING
        FI
      ELSEIF phase=SLIDING THEN
        SlidePosition(sample.x,sample.y)
        IF (sample.buttons & INPUT.LEFT)=0 THEN
          phase=SLIDE_PENDING
        FI
      ELSEIF (sample.buttons & INPUT.LEFT)=0 THEN
        IF FindObject(window,sample.x,sample.y)=gadget
            AND (arrowCode=-1 OR Arrow(window,gadget,sample.x,sample.y)=arrowCode) THEN
          phase=ARROW_PENDING
        ELSE
          phase=0
          windowId=0
        FI
      FI
    END
    RETURN(1)
  FI

  IF phase=CLOSING THEN
    IF (sample.buttons & INPUT.LEFT)=0 THEN
      BEGIN
        LET window=DESKCORE.Find(service,windowId)
        IF window<>NULL THEN
          BEGIN
            LET layer=DESKCORE.Layer(service,window)
            IF layer<>NULL AND CloseHit(window,sample.x,sample.y)<>0 THEN
              phase=CLOSE_PENDING
              RETURN(1)
            FI
          END
        FI
      END
      phase=0
      windowId=0
    FI

    RETURN(1)
  FI

  IF phase<>0 THEN
    RETURN(1)
  FI

  IF sample.kind<>INPUT.EVENT_BUTTON OR (sample.buttons & INPUT.LEFT)=0
      OR released=0 THEN
    RETURN(0)
  FI

  layerId=LAYERS.Hit(@service.scene,sample.x,sample.y)
  FOR slot=0 TO DESKTYPES.WINDOWS-1 DO
    BEGIN
      LET window=service.windows(slot)
      IF window<>NULL AND window.id<>0 AND window.layer=layerId THEN
        BEGIN
          LET layer=DESKCORE.Layer(service,window)
          hit=FindObject(window,sample.x,sample.y)
          IF hit<=0 OR hit=GEMOBJECTS.O_INFO THEN
            RETURN(0)
          FI

          IF window.iconified=0
              AND service.focus<>window.id THEN
            AESWINDOWSTATE.Control(window,AESTYPES.GUI_TOPPED,0,0,0,0)
            blocked=1
            RETURN(1)
          FI

          windowId=window.id
          gadget=hit
          restoreIcon=window.iconified
          DESKGEOMETRY.Project(@window.frame.current,@origin)
          arrowCode=Arrow(window,hit,sample.x,sample.y)
          IF restoreIcon<>0 THEN
            phase=ARROWING
            RETURN(1)
          FI
          REGIONS.Copy(@origin,@target)
          pressX=sample.x
          pressY=sample.y
          CASE hit OF
          WHEN GEMOBJECTS.O_SIZER THEN
            IF (window.frameKind & AESTYPES.SIZER)=0 THEN
              RETURN(1)
            FI
            phase=SIZING
            dirty=1
            RETURN(1)
          WHEN GEMOBJECTS.O_VSLIDE,GEMOBJECTS.O_HSLIDE THEN
            IF hit=GEMOBJECTS.O_HSLIDE THEN
              DESKGEOMETRY.ObjectRect(window,GEMOBJECTS.O_HSCROLL,@rail)
              DESKGEOMETRY.ObjectRect(window,hit,@target)
              sliderMin=rail.left
              sliderTravel=rail.right-rail.left-(target.right-target.left)
              pressX=sample.x-target.left
            ELSE
              DESKGEOMETRY.ObjectRect(window,GEMOBJECTS.O_VSCROLL,@rail)
              DESKGEOMETRY.ObjectRect(window,hit,@target)
              sliderMin=rail.top
              sliderTravel=rail.bottom-rail.top-(target.bottom-target.top)
              pressY=sample.y-target.top
            FI
            phase=SLIDING
            dirty=1
            SlidePosition(sample.x,sample.y)
            RETURN(1)
          WHEN GEMOBJECTS.O_CLOSER THEN
            phase=CLOSING
            RETURN(1)
          WHEN GEMOBJECTS.O_NAME THEN
            IF (window.frameKind & AESTYPES.MOVER)=0 THEN
              RETURN(1)
            FI
          ELSE
            IF arrowCode<>-1 OR hit=GEMOBJECTS.O_FULLER
                OR hit=GEMOBJECTS.O_ICONIFIER THEN
              phase=ARROWING
            FI
            RETURN(1)
          ESAC

          pressX=sample.x
          pressY=sample.y
          phase=DRAGGING
          dirty=1
          Position(sample.x,sample.y)
          RETURN(1)
        END
      FI
    END
  OD

RETURN(0)

PROC AdvanceGesture()
  BYTE drawn
  LAYERTYPES.Rect current

  IF appVisual<>0 THEN
    Track()
    RETURN
  FI

  IF AESLOCKS.MouseBlocked()<>0 THEN
    RETURN
  FI

  IF escapePending<>0 THEN
    Cancel()
  FI

  LET service=DESKSTATE.Get()
  IF lossEpoch<>DESKSTATE.LossEpoch() THEN
    Cancel()
  FI

  IF phase=0 THEN
    RETURN
  FI

  LET window=DESKCORE.Find(service,windowId)
  IF window=NULL THEN
    Cancel()
    RETURN
  FI

  LET layer=DESKCORE.Layer(service,window)
  IF layer=NULL OR layer.shown=0 THEN
    Cancel()
    RETURN
  FI

  DESKGEOMETRY.Project(@window.frame.current,@current)
  IF (phase=DRAGGING OR phase=MOVE_PENDING OR phase>=SIZING)
      AND REGIONS.Equal(@current,@origin)=0 THEN
    Cancel()
    RETURN
  FI

  IF service.scene.busy<>0 OR CONSOLEBITMAP.Pending()<>0 THEN
    RETURN
  FI
  IF phase=ARROW_PENDING AND (gadget=GEMOBJECTS.O_ICONIFIER OR restoreIcon<>0)
      AND (AESLOCKS.NativeReady()=0 OR AESLOCKS.PaintBlocked()<>0) THEN
    RETURN
  FI

  IF phase=SIZE_PENDING OR phase=SLIDE_PENDING OR phase=ARROW_PENDING THEN
    IF phase<>ARROW_PENDING THEN
      drawn=CONSOLEBITMAP.Outline(0,0,0,0,0)
      DESKSTATE.outlineVisible=0
    FI
    IF phase=SIZE_PENDING THEN
      AESWINDOWSTATE.Control(window,AESTYPES.GUI_SIZED,target.left,target.top,
          target.right-target.left,target.bottom-target.top)
    ELSEIF phase=SLIDE_PENDING THEN
      AESWINDOWSTATE.Control(window,
          IF gadget=GEMOBJECTS.O_HSLIDE THEN BYTE(AESTYPES.GUI_HSLID)
          ELSE BYTE(AESTYPES.GUI_VSLID) FI,sliderValue,0,0,0)
    ELSEIF gadget=GEMOBJECTS.O_ICONIFIER THEN
      DESKCORE.Iconify(service,window)
    ELSEIF restoreIcon<>0 THEN
      IF DESKCORE.Top(service,window)<>LAYERTYPES.OK THEN
        HEAPCORE.Abort($faec)
      FI
    ELSEIF gadget=GEMOBJECTS.O_FULLER THEN
      AESWINDOWSTATE.Control(window,AESTYPES.GUI_FULLED,0,0,0,0)
    ELSE
      AESWINDOWSTATE.Control(window,AESTYPES.GUI_ARROWED,
          arrowCode,0,0,0)
    FI
    phase=0
    windowId=0
    dirty=0
    RETURN
  FI

  IF phase=MOVE_PENDING THEN
    drawn=CONSOLEBITMAP.Outline(0,0,0,0,0)
    DESKSTATE.outlineVisible=0
    AESWINDOWSTATE.Control(window,AESTYPES.GUI_MOVED,target.left,target.top,
        target.right-target.left,target.bottom-target.top)
    phase=0
    windowId=0
    dirty=0
  ELSEIF phase=CLOSE_PENDING THEN
    AESWINDOWSTATE.Control(window,AESTYPES.GUI_CLOSED,0,0,0,0)
    phase=0
    windowId=0
  FI

RETURN

; Tracking an application-owned outline uses that application's established
; capture. Native scene actions obtain UPDATE only when a gesture needs work.
PUBLIC PROC Advance()

  IF appVisual<>0 THEN
    Track()
    RETURN
  FI
  IF phase=0 AND escapePending=0
      AND lossEpoch=DESKSTATE.LossEpoch() THEN
    RETURN
  FI
  IF AESLOCKS.SystemBegin()=0 THEN
    RETURN
  FI
  AdvanceGesture()
  DESKSTATE.managerCapture=Continuing()
  DESKFINISH.Finish()
  AESLOCKS.SystemEnd()

RETURN

; Queued drawing uses the same erase without withdrawing capture or routing.
PUBLIC PROC Suspend()
  BYTE drawn

  IF Continuing()<>0 THEN
    RETURN
  FI

  IF phase=APP_DRAG AND ApplicationReady()<>0 THEN
    RETURN
  FI

  IF DESKSTATE.outlineVisible<>0 AND CONSOLEBITMAP.Pending()=0 THEN
    drawn=CONSOLEBITMAP.Outline(0,0,0,0,0)
    IF drawn<>0 OR CONSOLEBITMAP.Failed()<>0 THEN
      DESKSTATE.outlineVisible=0
      dirty=1
    FI
  FI

RETURN

PROC PresentOutline()
  BYTE drawn,visible
  LAYERTYPES.Rect bounds

  IF appVisual<>0 THEN
    Track()
    IF phase<>0 AND ApplicationReady()=0 THEN
      Suspend()
      RETURN
    FI
  FI

  IF lossEpoch<>DESKSTATE.LossEpoch() THEN
    Cancel()
  FI

  IF dirty<>0 OR (Outlined()<>0 AND CONSOLEBITMAP.Changed()<>0) THEN
    IF CONSOLEBITMAP.Pending()=0 THEN
      EXEC.Forbid()
      REGIONS.Copy(@target,@bounds)
      visible=Outlined()
      dirty=2
      EXEC.Permit()
      drawn=CONSOLEBITMAP.Outline(CARD(bounds.left),CARD(bounds.top),
          CARD(bounds.right-bounds.left),CARD(bounds.bottom-bounds.top),visible)
      EXEC.Forbid()
      IF drawn<>0 THEN
        DESKSTATE.outlineVisible=visible
        ; A caller may cancel or replace its retained visual during the draw.
        IF dirty=2 THEN
          dirty=0
          IF phase=0 AND visible=0 THEN
            appVisual=0
          FI
        FI
      ELSEIF dirty=2 THEN
        dirty=1
      FI
      EXEC.Permit()
    FI
  FI

RETURN

; A cursor-only refresh has no native outline work and needs no UPDATE.
PUBLIC PROC Present()

  IF appVisual<>0 THEN
    PresentOutline()
    RETURN
  FI
  IF dirty=0 AND lossEpoch=DESKSTATE.LossEpoch()
      AND (Outlined()=0 OR CONSOLEBITMAP.Changed()=0) THEN
    RETURN
  FI
  IF CONSOLEBITMAP.Pending()<>0 OR AESLOCKS.SystemBegin()=0 THEN
    RETURN
  FI
  PresentOutline()
  AESLOCKS.SystemEnd()

RETURN

PUBLIC PROC Reset()

  EXEC.Forbid()
  ResetCapture()
  EXEC.Permit()

RETURN

PUBLIC PROC Cancel()

  EXEC.Forbid()
  CancelCapture()
  EXEC.Permit()

RETURN

ENDMODULE
