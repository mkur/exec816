; Presenter-owned gesture state. No nested input loop and no borrowed client
; pointer survives a turn; identities resolve against the current scene.
MODULE DESKDRAG
USE DISPLAY
USE EXEC
USE AESLOCKS
USE AESMOUSE
USE AESTYPES
USE AESWINDOWSTATE
USE INPUT
USE DESKTYPES
USE DESKSTATE
USE DESKCORE
USE DESKGEOMETRY
USE DESKMOVE
USE DESKMENU
USE DESKEVENTS
USE LAYERTYPES
USE LAYERS
USE REGIONS
USE CONSOLEBITMAP
USE HEAPCORE

LONGCARD windowId,lossEpoch
LAYERTYPES.Rect origin,target
INT pressX,pressY,sliderMin,sliderTravel,sliderValue
BYTE gadget
BYTE phase,blocked,dirty,focusWanted,escapePending,pixelMotion
CONST DRAGGING=1
CONST MOVE_PENDING=2
CONST CLOSING=3
CONST CLOSE_PENDING=4
CONST SIZING=5, SIZE_PENDING=6, SLIDING=7, SLIDE_PENDING=8
CONST ARROWING=9, ARROW_PENDING=10
CONST ESC_SCAN=28

PUBLIC PROC Reset()

  escapePending=0
  windowId=0
  phase=0
  blocked=0
  DESKSTATE.outlineVisible=0
  dirty=0
  focusWanted=0
  lossEpoch=DESKSTATE.LossEpoch()

RETURN

PUBLIC PROC Cancel()

  escapePending=0
  windowId=0
  phase=0
  blocked=1
  dirty=1
  focusWanted=0
  lossEpoch=DESKSTATE.LossEpoch()

RETURN

PUBLIC BYTE FUNC Escape(INPUT.Event POINTER sample)

  IF (phase<>0 OR AESMOUSE.NativeGesture()<>0)
      AND ((sample.kind=INPUT.EVENT_KEY
      AND (sample.code & 63)=ESC_SCAN) OR (sample.kind=INPUT.EVENT_CANCEL
      AND sample.code=INPUT.CANCEL_BREAK)) THEN
    IF AESLOCKS.MouseBlocked()<>0 THEN
      escapePending=1
    ELSE
      Cancel()
    FI

    RETURN(1)
  FI

RETURN(0)

BYTE FUNC CloseHit(DESKTYPES.Window POINTER window
    LAYERTYPES.Layer POINTER layer INT x,y)

RETURN(window.kind<>DESKTYPES.CONTENT_CONSOLE
    AND DESKGEOMETRY.CloseHit(@layer.bounds,x,y)<>0)

PROC Position(INT x,y)
  INT left,top,width,height,limit

  width=origin.right-origin.left
  height=origin.bottom-origin.top
  left=origin.left+x-pressX
  top=origin.top+y-pressY
  IF left<0 THEN
    left=0
  FI

  IF top<DESKMENU.BAR_HEIGHT THEN
    top=DESKMENU.BAR_HEIGHT
  FI

  IF pixelMotion=0 THEN
    left=(left+4) & $fff8
    top=(top+4) & $fff8
  FI

  limit=640-width
  IF pixelMotion=0 THEN
    limit=limit & $fff8
  FI
  IF left>limit THEN
    left=limit
  FI

  limit=240-height
  IF pixelMotion=0 THEN
    limit=limit & $fff8
  FI
  IF top>limit THEN
    top=limit
  FI

  IF target.left<>left OR target.top<>top THEN
    dirty=1
  FI

  REGIONS.Assign(@target,left,top,left+width,top+height)

RETURN

BYTE FUNC Outlined()

RETURN(phase=DRAGGING OR phase=MOVE_PENDING OR phase=SIZING
    OR phase=SIZE_PENDING OR phase=SLIDING OR phase=SLIDE_PENDING)

; Resizing keeps its upper-left anchor. Applications may request larger minima.
PROC SizePosition(INT x,y CARD kind)
  INT width,height,minimum

  width=origin.right-origin.left+x-pressX
  height=origin.bottom-origin.top+y-pressY
  minimum=IF (kind & DESKTYPES.FRAME_VERTICAL)<>0 THEN
      DESKTYPES.FRAME_MIN_SCROLL_HEIGHT ELSE DESKTYPES.FRAME_MIN_SIZE_HEIGHT FI
  IF width<DESKTYPES.FRAME_MIN_WIDTH THEN
    width=DESKTYPES.FRAME_MIN_WIDTH
  FI
  IF height<minimum THEN
    height=minimum
  FI
  IF width>640-origin.left THEN
    width=640-origin.left
  FI
  IF height>240-origin.top THEN
    height=240-origin.top
  FI
  IF target.right<>origin.left+width OR target.bottom<>origin.top+height THEN
    target.right=origin.left+width
    target.bottom=origin.top+height
    dirty=1
  FI

RETURN

PROC SlidePosition(INT y)
  INT top,height

  top=y-pressY
  IF top<sliderMin THEN
    top=sliderMin
  FI
  IF top>sliderMin+sliderTravel THEN
    top=sliderMin+sliderTravel
  FI
  sliderValue=0
  IF sliderTravel<>0 THEN
    sliderValue=INT((LONGCARD(CARD(top-sliderMin))*1000
        +LONGCARD(CARD(sliderTravel) RSH 1))/LONGCARD(CARD(sliderTravel)))
  FI
  IF top<>target.top THEN
    height=target.bottom-target.top
    target.top=top
    target.bottom=top+height
    dirty=1
  FI

RETURN

; A title/close press captures subsequent edges and motion even outside the
; original window. A release remains pending until geometry can safely commit.
PUBLIC BYTE FUNC Capture(INPUT.Event POINTER sample BYTE released)
  BYTE slot,hit
  LONGCARD layerId
  LAYERTYPES.Rect rail

  LET service=DESKSTATE.Get()
  IF lossEpoch<>DESKSTATE.LossEpoch() THEN
    Cancel()
  FI

  IF blocked<>0 THEN
    IF sample.buttons=0 THEN
      blocked=0
    FI

    RETURN(1)
  FI

  IF phase=DRAGGING THEN
    Position(sample.x,sample.y)
    IF (sample.buttons & INPUT.LEFT)=0 THEN
      phase=MOVE_PENDING
    FI

    RETURN(1)
  FI

  IF phase=SIZING OR phase=SLIDING OR phase=ARROWING THEN
    BEGIN
      LET window=DESKCORE.Find(service,windowId)
      IF window=NULL THEN
        Cancel()
        RETURN(1)
      FI
      LET layer=DESKCORE.Layer(service,window)
      IF phase=SIZING THEN
        SizePosition(sample.x,sample.y,window.frameKind)
        IF (sample.buttons & INPUT.LEFT)=0 THEN
          phase=SIZE_PENDING
        FI
      ELSEIF phase=SLIDING THEN
        SlidePosition(sample.y)
        IF (sample.buttons & INPUT.LEFT)=0 THEN
          phase=SLIDE_PENDING
        FI
      ELSEIF (sample.buttons & INPUT.LEFT)=0 THEN
        IF DESKGEOMETRY.GadgetHit(window,@layer.bounds,sample.x,sample.y)=gadget THEN
          phase=ARROW_PENDING
        ELSE
          phase=0
          windowId=0
        FI
      FI
    END
    RETURN(1)
  FI

  IF phase=CLOSING THEN
    IF (sample.buttons & INPUT.LEFT)=0 THEN
      BEGIN
        LET window=DESKCORE.Find(service,windowId)
        IF window<>NULL THEN
          BEGIN
            LET layer=DESKCORE.Layer(service,window)
            IF layer<>NULL AND CloseHit(window,layer,sample.x,sample.y)<>0 THEN
              phase=CLOSE_PENDING
              RETURN(1)
            FI
          END
        FI
      END
      phase=0
      windowId=0
    FI

    RETURN(1)
  FI

  IF phase<>0 THEN
    RETURN(1)
  FI

  IF sample.kind<>INPUT.EVENT_BUTTON OR (sample.buttons & INPUT.LEFT)=0
      OR released=0 THEN
    RETURN(0)
  FI

  layerId=LAYERS.Hit(@service.scene,sample.x,sample.y)
  FOR slot=0 TO DESKTYPES.WINDOWS-1 DO
    BEGIN
      LET window=@service.windows(slot)
      IF window.id<>0 AND window.layer=layerId THEN
        BEGIN
          LET layer=DESKCORE.Layer(service,window)
          hit=DESKGEOMETRY.GadgetHit(window,@layer.bounds,sample.x,sample.y)
          IF hit=0 AND DESKGEOMETRY.TitleHit(@layer.bounds,sample.x,sample.y)=0 THEN
            RETURN(0)
          FI

          IF window.kind=DESKTYPES.CONTENT_AES AND service.focus<>window.id THEN
            AESWINDOWSTATE.Control(window,AESTYPES.GUI_TOPPED,0,0,0,0)
            blocked=1
            RETURN(1)
          FI

          windowId=window.id
          pixelMotion=window.kind=DESKTYPES.CONTENT_AES
          focusWanted=window.kind<>DESKTYPES.CONTENT_AES
          IF hit<>0 THEN
            gadget=hit
            REGIONS.Copy(@layer.bounds,@origin)
            REGIONS.Copy(@origin,@target)
            pressX=sample.x
            pressY=sample.y
            IF hit=1 THEN
              phase=SIZING
              dirty=1
            ELSEIF hit=6 THEN
              DESKGEOMETRY.ScrollTrack(window,@layer.bounds,@rail)
              sliderMin=rail.top
              sliderTravel=rail.bottom-rail.top-window.sliderHeight
              REGIONS.Assign(@target,rail.left,origin.top+window.sliderTop,
                  rail.right,origin.top+window.sliderTop+window.sliderHeight)
              pressY=sample.y-target.top
              phase=SLIDING
              dirty=1
              SlidePosition(sample.y)
            ELSE
              phase=ARROWING
            FI
            RETURN(1)
          FI

          IF CloseHit(window,layer,sample.x,sample.y)<>0 THEN
            phase=CLOSING
            RETURN(1)
          FI

          IF window.kind<>DESKTYPES.CONTENT_CONSOLE
              AND sample.x<layer.bounds.left+DESKTYPES.TITLE_HEIGHT THEN
            phase=0
            windowId=0
            RETURN(1)
          FI

          REGIONS.Copy(@layer.bounds,@origin)
          REGIONS.Copy(@origin,@target)
          pressX=sample.x
          pressY=sample.y
          phase=DRAGGING
          dirty=1
          Position(sample.x,sample.y)
          RETURN(1)
        END
      FI
    END
  OD

RETURN(0)

PUBLIC PROC Advance()
  BYTE status,slot,drawn

  IF DISPLAY.Blocked()<>0 THEN
    RETURN
  FI

  IF AESLOCKS.MouseBlocked()<>0 THEN
    RETURN
  FI

  IF escapePending<>0 THEN
    Cancel()
  FI

  LET service=DESKSTATE.Get()
  IF lossEpoch<>DESKSTATE.LossEpoch() THEN
    Cancel()
  FI

  IF phase=0 THEN
    RETURN
  FI

  LET window=DESKCORE.Find(service,windowId)
  IF window=NULL THEN
    Cancel()
    RETURN
  FI

  LET layer=DESKCORE.Layer(service,window)
  IF layer=NULL OR layer.shown=0 THEN
    Cancel()
    RETURN
  FI

  IF (phase=DRAGGING OR phase=MOVE_PENDING OR phase>=SIZING)
      AND REGIONS.Equal(@layer.bounds,@origin)=0 THEN
    Cancel()
    RETURN
  FI

  IF service.scene.busy<>0 OR CONSOLEBITMAP.Pending()<>0 THEN
    RETURN
  FI

  IF focusWanted<>0 THEN
    status=LAYERS.Order(@service.scene,layer.id,1)
    IF status<>LAYERTYPES.OK THEN
      HEAPCORE.Abort($faec)
    FI

    DESKCORE.Focus(service,window.id)
    focusWanted=0
  FI

  IF phase=SIZE_PENDING OR phase=SLIDE_PENDING OR phase=ARROW_PENDING THEN
    IF phase<>ARROW_PENDING THEN
      drawn=CONSOLEBITMAP.Outline(0,0,0,0,0)
      DESKSTATE.outlineVisible=0
    FI
    IF phase=SIZE_PENDING THEN
      AESWINDOWSTATE.Control(window,AESTYPES.GUI_SIZED,target.left,target.top,
          target.right-target.left,target.bottom-target.top)
    ELSEIF phase=SLIDE_PENDING THEN
      AESWINDOWSTATE.Control(window,AESTYPES.GUI_VSLID,sliderValue,0,0,0)
    ELSE
      AESWINDOWSTATE.Control(window,AESTYPES.GUI_ARROWED,
          IF gadget<4 THEN INT(gadget) ELSE INT(gadget)-4 FI,0,0,0)
    FI
    phase=0
    windowId=0
    dirty=0
    RETURN
  FI

  IF phase=MOVE_PENDING THEN
    drawn=CONSOLEBITMAP.Outline(0,0,0,0,0)
    DESKSTATE.outlineVisible=0
    IF window.kind=DESKTYPES.CONTENT_AES THEN
      AESWINDOWSTATE.Control(window,AESTYPES.GUI_MOVED,target.left,target.top,
          target.right-target.left,target.bottom-target.top)
      status=DESKTYPES.OK
    ELSE
      status=BYTE(DESKMOVE.Start(service,window,target.left,target.top,NULL))
    FI
    IF status<>DESKTYPES.OK AND status<>DESKTYPES.PENDING THEN
      HEAPCORE.Abort($faed)
    FI

    phase=0
    windowId=0
    dirty=0
  ELSEIF phase=CLOSE_PENDING THEN
    IF window.kind=DESKTYPES.CONTENT_AES THEN
      AESWINDOWSTATE.Control(window,AESTYPES.GUI_CLOSED,0,0,0,0)
      phase=0
      windowId=0
      RETURN
    FI

    FOR slot=0 TO DESKTYPES.WINDOWS-1 DO
      IF @service.windows(slot)=window THEN
        BEGIN
          LET client=DESKEVENTS.Find(service,window.client)
          client.closeBits=client.closeBits OR BYTE(1 LSH slot)
          DESKEVENTS.Wake(service,client)
        END
      FI
    OD

    phase=0
    windowId=0
  FI

RETURN

; Erase only the native outline; retain the gesture for ownership release.
PUBLIC PROC Suspend()
  BYTE drawn

  IF DISPLAY.Blocked()<>0 THEN
    RETURN
  FI

  IF DESKSTATE.outlineVisible<>0 AND CONSOLEBITMAP.Pending()=0 THEN
    drawn=CONSOLEBITMAP.Outline(0,0,0,0,0)
    IF drawn<>0 OR CONSOLEBITMAP.Failed()<>0 THEN
      DESKSTATE.outlineVisible=0
      dirty=1
    FI
  FI

RETURN

PUBLIC PROC Present()
  BYTE drawn

  IF DISPLAY.Blocked()<>0 THEN
    RETURN
  FI

  IF lossEpoch<>DESKSTATE.LossEpoch() THEN
    Cancel()
  FI

  IF dirty<>0 OR (Outlined()<>0 AND CONSOLEBITMAP.Changed()<>0) THEN
    IF CONSOLEBITMAP.Pending()=0 THEN
      drawn=CONSOLEBITMAP.Outline(CARD(target.left),CARD(target.top),
          CARD(target.right-target.left),CARD(target.bottom-target.top),
          Outlined())
      IF drawn<>0 THEN
        DESKSTATE.outlineVisible=Outlined()
        dirty=0
      FI
    FI
  FI

RETURN

PUBLIC BYTE FUNC Runnable()

  IF DISPLAY.Blocked()<>0 THEN
    RETURN(0)
  FI

  IF AESLOCKS.MouseBlocked()<>0 THEN
    RETURN(0)
  FI

  LET service=DESKSTATE.Get()

RETURN((dirty<>0 AND CONSOLEBITMAP.Pending()=0)
    OR (phase<>0 AND phase<>DRAGGING AND phase<>CLOSING
    AND phase<>SIZING AND phase<>SLIDING AND phase<>ARROWING
    AND service.scene.busy=0 AND CONSOLEBITMAP.Pending()=0))

ENDMODULE
