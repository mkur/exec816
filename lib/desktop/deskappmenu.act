; The active AES owner's borrowed menu, read only between mutation boundaries.
MODULE DESKAPPMENU
USE AESSTATE
USE AESTYPES
USE AESMENU
USE AESGUI
USE AESWINDOWSTATE
USE DESKSTATE
USE DESKWIDGETS
USE WIDGETTYPES
USE CONSOLEBITMAP
USE LAYERTYPES
USE LAYERS
USE REGIONS
USE HEAPCORE

PUBLIC AESSTATE.Client POINTER owner
PUBLIC INT heading,selected,paintHeading,paintSelected
LONGCARD generation,revision
CARD paintIndex
TYPE PendingSelection=[
  AESSTATE.Client POINTER client
  LONGCARD menuEpoch,windowEpoch
  INT title,item,box
]
PendingSelection choice

PUBLIC BYTE FUNC Changed()

  LET service=AESSTATE.Get()

RETURN(service<>NULL AND revision<>service.menuRevision)

PUBLIC BYTE FUNC Current()

RETURN(owner<>NULL AND owner.menu<>NULL AND owner.menu.generation=generation)

; Return one for a new lifetime, two for source-state changes in the same menu.
PUBLIC BYTE FUNC Refresh()
  AESSTATE.Client POINTER candidate
  LONGCARD nextGeneration
  BYTE change

  LET service=AESSTATE.Get()
  IF service=NULL THEN
    RETURN(0)
  FI
  LET desktop=DESKSTATE.Get()
  candidate=AESWINDOWSTATE.Find(desktop.focus)
  IF candidate<>NULL AND (candidate.menu=NULL OR candidate.view.shown=0) THEN
    candidate=NULL
  FI
  nextGeneration=IF candidate=NULL THEN LONGCARD(0) ELSE candidate.menu.generation FI
  change=0
  IF candidate<>owner OR generation<>nextGeneration THEN
    owner=candidate
    generation=nextGeneration
    heading=0
    selected=-1
    paintHeading=0
    paintSelected=-1
    change=1
  ELSEIF revision<>service.menuRevision THEN
    change=2
  FI
  revision=service.menuRevision

RETURN(change)

PUBLIC BYTE FUNC Enabled(INT index)
  INT parent

  IF Current()=0 THEN
    RETURN(0)
  FI
  LET menu=owner.menu
  LET object=AESMENU.Object(menu,index)
  IF (object.state & 8)<>0 THEN
    RETURN(0)
  FI
  parent=index
  WHILE parent>=0 DO
    BEGIN
      LET ancestor=AESMENU.Object(menu,parent)
      IF (ancestor.flags & 128)<>0 THEN
        RETURN(0)
      FI
      parent=menu.parent(parent)
    END
  OD

RETURN(1)

PUBLIC BYTE FUNC Pending()

RETURN(choice.client<>NULL)

PUBLIC BYTE FUNC VisualChanged()

RETURN(Current()<>0 AND (paintHeading<>heading OR paintSelected<>selected))

PUBLIC BYTE FUNC Available()

RETURN(Current()<>0 AND owner.endpoint.menuConsumed<>0
    AND owner.endpoint.menuNormal<>0 AND choice.client=NULL)

PUBLIC INT FUNC NextTitle(INT cursorIndex BYTE reverse)
  BYTE attempt

  IF Available()=0 THEN
    RETURN(-1)
  FI
  LET menu=owner.menu
  FOR attempt=0 TO menu.titles-1 DO
    IF reverse<>0 THEN
      cursorIndex=IF cursorIndex<=0 THEN INT(menu.titles)-1 ELSE cursorIndex-1 FI
    ELSE
      cursorIndex=IF cursorIndex>=INT(menu.titles)-1 THEN INT(0) ELSE cursorIndex+1 FI
    FI
    IF Enabled(menu.title(cursorIndex))<>0 THEN
      RETURN(cursorIndex)
    FI
  OD

RETURN(-1)

PUBLIC INT FUNC TitleAt(INT x)
  BYTE index

  IF Available()=0 THEN
    RETURN(-1)
  FI
  LET menu=owner.menu
  FOR index=0 TO menu.titles-1 DO
    BEGIN
      LET title=menu.title(index)
      LET object=AESMENU.Object(menu,title)
      IF x>=menu.x(title) AND x<menu.x(title)+object.width
          AND Enabled(title)<>0 THEN
        RETURN(INT(index))
      FI
    END
  OD

RETURN(-1)

; Input retains identity only. Source state changes after the paint token retires.
PUBLIC PROC Queue(INT item)

  IF item<0 OR Available()=0 THEN
    RETURN
  FI
  LET menu=owner.menu
  IF Enabled(item)=0 OR Enabled(menu.title(heading))=0 THEN
    RETURN
  FI
  choice.client=owner
  choice.menuEpoch=generation
  choice.windowEpoch=owner.endpoint.guiEpoch
  choice.title=menu.title(heading)
  choice.box=menu.box(heading)
  choice.item=item

RETURN

PUBLIC PROC Finish()
  BYTE accepted

  LET client=choice.client
  IF client=NULL THEN
    RETURN
  FI
  IF client.menu<>NULL AND client.menu.generation=choice.menuEpoch
      AND client.endpoint.guiEpoch=choice.windowEpoch THEN
    accepted=AESGUI.Select(AESSTATE.Get(),client,
        choice.title,choice.item,choice.box)
  FI
  choice.client=NULL

RETURN

PUBLIC PROC PopupBounds(LAYERTYPES.Rect POINTER bounds)
  INT left,top,box

  LET menu=owner.menu
  box=menu.box(heading)
  LET object=AESMENU.Object(menu,box)
  left=menu.x(box)
  top=menu.y(box)
  IF left<0 THEN left=0 FI
  IF left+object.width>640 THEN left=640-object.width FI
  IF top<16 THEN top=16 FI
  IF top+object.height>240 THEN top=240-object.height FI
  REGIONS.Assign(bounds,left,top,left+object.width,top+object.height)

RETURN

PUBLIC INT FUNC EntryAt(INT x,y)
  INT index
  LAYERTYPES.Rect drop

  IF Current()=0 THEN
    RETURN(-1)
  FI
  LET menu=owner.menu
  LET box=menu.box(heading)
  LET object=AESMENU.Object(menu,box)
  PopupBounds(@drop)
  x=x-drop.left+menu.x(box)
  y=y-drop.top+menu.y(box)
  index=object.head
  WHILE index>=0 AND index<>box DO
    BEGIN
      LET entry=AESMENU.Object(menu,index)
      IF x>=menu.x(index) AND x<menu.x(index)+entry.width
          AND y>=menu.y(index) AND y<menu.y(index)+entry.height
          AND Enabled(index)<>0 THEN
        RETURN(index)
      FI
      index=entry.next
    END
  OD

RETURN(-1)

PUBLIC INT FUNC NextEntry(INT cursorIndex BYTE reverse)
  INT index,first,last,previous,next

  IF Current()=0 THEN
    RETURN(-1)
  FI
  LET menu=owner.menu
  LET box=menu.box(heading)
  LET object=AESMENU.Object(menu,box)
  first=-1
  last=-1
  previous=-1
  next=-1
  index=object.head
  WHILE index>=0 AND index<>box DO
    IF Enabled(index)<>0 THEN
      IF first<0 THEN
        first=index
      FI
      IF index=cursorIndex THEN
        previous=last
      ELSEIF last=cursorIndex THEN
        next=index
      FI
      last=index
    FI
    BEGIN
      LET entry=AESMENU.Object(menu,index)
      index=entry.next
    END
  OD
  IF reverse<>0 THEN
    RETURN(IF previous>=0 THEN previous ELSE last FI)
  FI

RETURN(IF next>=0 THEN next ELSE first FI)

PROC DamageObject(INT index BYTE popup)
  INT box,active
  LAYERTYPES.Rect bounds,drop
  BYTE status

  LET desktop=DESKSTATE.Get()
  LET menu=owner.menu
  LET object=AESMENU.Object(menu,index)
  active=menu.parent(menu.title(0))
  IF menu.parent(index)=active THEN
    REGIONS.Assign(@bounds,menu.x(index),0,menu.x(index)+object.width,16)
    status=LAYERS.Invalidate(@desktop.scene,DESKSTATE.barLayer,@bounds)
  ELSEIF popup<>0 THEN
    box=menu.box(heading)
    PopupBounds(@drop)
    REGIONS.Assign(@bounds,drop.left+menu.x(index)-menu.x(box),
        drop.top+menu.y(index)-menu.y(box),0,0)
    bounds.right=bounds.left+object.width
    bounds.bottom=bounds.top+object.height
    status=LAYERS.Invalidate(@desktop.scene,DESKSTATE.popupLayer,@bounds)
  ELSE
    RETURN
  FI
  IF status<>LAYERTYPES.OK THEN
    HEAPCORE.Abort($faee)
  FI

RETURN

; Keep source changes and pointer highlights off the screen until paint retires.
PUBLIC PROC Snapshot(BYTE popup)
  BYTE index
  LONGCARD mask

  IF Current()=0 THEN
    RETURN
  FI
  LET menu=owner.menu
  IF paintHeading<>heading THEN
    DamageObject(menu.title(paintHeading),0)
    DamageObject(menu.title(heading),0)
  FI
  IF paintSelected<>selected THEN
    IF paintSelected>=0 THEN DamageObject(paintSelected,popup) FI
    IF selected>=0 THEN DamageObject(selected,popup) FI
  FI
  mask=1
  FOR index=0 TO menu.count-1 DO
    IF (menu.damage & mask)<>0 THEN
      DamageObject(INT(index),popup)
    FI
    mask=mask LSH 1
  OD
  menu.damage=0
  paintHeading=heading
  paintSelected=selected

RETURN

; The source tree and geometry are frozen by the scene token. Native and
; application renderers have distinct GSX scratch; the former also draws menus.
PUBLIC BYTE FUNC Paint(LAYERTYPES.Layer POINTER layer LAYERTYPES.Rect POINTER clip
    BYTE first,opened)
  INT scope

  IF Current()=0 THEN
    RETURN(1)
  FI
  LET menu=owner.menu
  LET packet=DESKWIDGETS.GetPacket()
  IF first<>0 THEN paintIndex=0 FI
  packet.context=LONGCARD(ADDRESS(menu.tree))
  packet.payload=LONGCARD(ADDRESS(@menu.parent(0)))
  packet.originX=0
  packet.originY=0
  packet.left=clip.left
  packet.right=clip.right
  packet.top=clip.top
  packet.bottom=clip.bottom
  packet.state=$ffff
  packet.qualifiers=$ffff
  IF layer.id=DESKSTATE.barLayer THEN
    BEGIN
      LET root=AESMENU.Object(menu,0)
      scope=root.head
      packet.originY=-menu.y(scope)
      IF packet.right>432 THEN packet.right=432 FI
      IF opened<>0 THEN packet.qualifiers=CARD(menu.title(paintHeading)) FI
    END
  ELSE
    scope=menu.box(paintHeading)
    packet.originX=layer.bounds.left-menu.x(scope)
    packet.originY=layer.bounds.top-menu.y(scope)
    packet.state=CARD(paintSelected)
  FI
  IF packet.left>=packet.right THEN RETURN(1) FI
  packet.object=scope
  packet.index=paintIndex
  DESKWIDGETS.Run(WIDGETTYPES.OP_MENU_DRAW)
  paintIndex=packet.index
  IF packet.status<>WIDGETTYPES.OK THEN RETURN(0) FI
  IF packet.changed<>0 THEN RETURN(2) FI

RETURN(CONSOLEBITMAP.Drawn(packet.status))

ENDMODULE
