; Retained scene painter, called only by the existing console worker.
MODULE DESKPAINT
USE DISPLAY
USE EXEC
USE DESKSTATE
USE DESKTYPES
USE DESKCORE
USE DESKGEOMETRY
USE DESKCACHE
USE DESKWIDGETS
USE DESKMENU
USE DESKMENUCACHE
USE DESKMENUPAINT
USE LAYERTYPES
USE LAYERS
USE LAYERCACHE
USE REGIONS
USE CONSOLETYPES
USE CONSOLEWINDOWS
USE CONSOLECORE
USE CONSOLEBATCH
USE CONSOLEDISPLAY
USE CONSOLEBITMAP
USE HEAPCORE
USE AESLOCKS
USE AESWINDOWSTATE

LONGCARD paintToken,paintLayer
CARD regionIndex,commandIndex,glyphOffset
INT nextY
BYTE nextSlot,started,menuTurns,partIndex
CONST STRIP_HEIGHT=16
CONST TEXT_GLYPHS=32
CONST CLIPPED_GLYPHS=16
CONST PAINT_FRAME=1, PAINT_CACHE=2, PAINT_CLIENT=4, PAINT_CONTENT=5
; Native popup continuations use row+1 (up to ten), including partial rows.
; Keep transfer states outside that range.
CONST PAINT_POPUP_CACHE=$80, PAINT_BACKING=$81
LAYERTYPES.Rect strip

PUBLIC DESKTYPES.Window POINTER FUNC ByLayer(LONGCARD id)
  BYTE index

  LET service=DESKSTATE.Get()
  FOR index=0 TO DESKTYPES.WINDOWS-1 DO
    IF service.windows(index).id<>0 AND service.windows(index).layer=id THEN
      RETURN(@service.windows(index))
    FI
  OD

RETURN(NULL)

; Placement changes invalidate the old caret and any gather-only scroll batch.
PUBLIC PROC Sync()
  CARD left,top
  BYTE shown,focused

  LET service=DESKSTATE.Get()
  IF service=NULL OR service.scene.busy<>0 THEN
    RETURN
  FI

  LET entry=CONSOLEWINDOWS.Find(0)
  IF entry=NULL THEN
    RETURN
  FI

  LET view=CONSOLETYPES.Presentation POINTER(entry.view)
  LET instance=CONSOLETYPES.Instance POINTER(entry.instance)
  LET window=DESKCORE.Find(service,service.consoleWindow)
  IF window=NULL THEN
    view.visible=0
    DESKSTATE.Select(0)
    RETURN
  FI

  LET batch=CONSOLEBATCH.Get()
  LET layer=DESKCORE.Layer(service,window)
  left=CARD(layer.bounds.left+DESKTYPES.WORK_LEFT) RSH 3
  top=CARD(layer.bounds.top+DESKTYPES.WORK_TOP) RSH 3
  IF window.iconified<>0 THEN
    left=CARD(window.normalBounds.left+DESKTYPES.WORK_LEFT) RSH 3
    top=CARD(window.normalBounds.top+DESKTYPES.WORK_TOP) RSH 3
  FI
  shown=layer.shown<>0 AND window.iconified=0
  focused=service.focus=window.id
  IF view.left<>left OR view.top<>top OR view.visible<>shown THEN
    IF view.scrollState<>0 OR batch.phase<>CONSOLETYPES.BATCH_IDLE THEN
      view.presentedGeneration=0
      CONSOLECORE.Dirty(instance,0,instance.count)
    FI
    CONSOLEBATCH.Reset()
    view.scrollState=0
    view.left=left
    view.top=top
    view.visible=shown
    view.cursorOn=0
    view.index=$ffff
    view.generation==+1
    IF CONSOLEDISPLAY.BackingEnabled(view)=0 THEN
      view.presentedGeneration=0
      CONSOLECORE.Dirty(instance,0,instance.count)
    FI
  FI

  ; DESKCORE.Focus removes the outgoing caret before changing its route.
  ; Focus alone preserves retained text and any gathered output batch.
  IF view.focused<>focused THEN
    view.focused=focused
    view.index=$ffff
  FI

  DESKSTATE.Select(layer.id)

RETURN

BYTE FUNC Fill(LAYERTYPES.Rect POINTER bounds,clip CARD pen)
  LAYERTYPES.Rect area

  REGIONS.Intersect(bounds,clip,@area)
  IF REGIONS.Empty(@area)<>0 THEN
    RETURN(1)
  FI

RETURN(CONSOLEBITMAP.RawFill(CARD(area.left),CARD(area.top),
    CARD(area.right-area.left),CARD(area.bottom-area.top),pen))

; Each fragment is disjoint from the client. Its complete frame pixels are
; composed in shared scratch before publication. The two narrow side fragments
; share a step; title and bottom fragments retain their own input boundary.
BYTE FUNC FrameStep(DESKTYPES.Window POINTER window
    LAYERTYPES.Layer POINTER layer LAYERTYPES.Rect POINTER client)
  LAYERTYPES.Rect area
  BYTE result

  LET service=DESKSTATE.Get()
  WHILE commandIndex<5 DO
    CASE commandIndex OF
    WHEN 0 THEN
      REGIONS.Assign(@area,layer.bounds.left,layer.bounds.top,
          layer.bounds.right,layer.bounds.top+DESKTYPES.TITLE_HEIGHT)

    WHEN 1 THEN
      REGIONS.Assign(@area,layer.bounds.left,layer.bounds.top+DESKTYPES.TITLE_HEIGHT,
          layer.bounds.right,client.top)

    WHEN 2 THEN
      REGIONS.Assign(@area,layer.bounds.left,client.bottom,
          layer.bounds.right,layer.bounds.bottom)

    WHEN 3 THEN
      REGIONS.Assign(@area,layer.bounds.left,client.top,
          client.left,client.bottom)

    ELSE
      REGIONS.Assign(@area,client.right,client.top,
          layer.bounds.right,client.bottom)
    ESAC

    REGIONS.Intersect(@area,@strip,@area)
    IF REGIONS.Empty(@area)=0 THEN
      result=CONSOLEBITMAP.Frame(@layer.bounds,@area,@window.title(0),
          window.id=service.focus,window.kind<>DESKTYPES.CONTENT_CONSOLE,
          window.frameKind,window.sliderTop,window.sliderHeight,@glyphOffset)
      IF result<>1 THEN
        RETURN(result)
      FI

      commandIndex==+1
      IF commandIndex<>4 THEN
        RETURN(2)
      FI
    ELSE
      commandIndex==+1
    FI
  OD

  commandIndex=0

RETURN(1)

; The scene token freezes the source while only this scalar offset survives a
; step. Count visible whole/edge glyphs, including a repeated clipped fragment.
; Return the same done/more/fault convention as PaintStrip.
BYTE FUNC TextStep(CARD x,y BYTE POINTER source CARD length,foreground,background
    LAYERTYPES.Rect POINTER clip)
  CARD first,last,stop

  IF INT(y)>=clip.bottom OR INT(y+8)<=clip.top OR INT(x)>=clip.right THEN
    glyphOffset=0
    RETURN(1)
  FI

  first=0
  IF clip.left>INT(x) THEN
    first=CARD(clip.left-INT(x)) RSH 3
  FI

  last=(CARD(clip.right-INT(x))+7) RSH 3
  IF last>length THEN
    last=length
  FI

  IF glyphOffset<first THEN
    glyphOffset=first
  FI

  IF glyphOffset>=last THEN
    glyphOffset=0
    RETURN(1)
  FI

  stop=glyphOffset+TEXT_GLYPHS
  ; Partial-height glyphs use the donor raster path, with a higher per-cell
  ; cost than a complete atlas run. Keep that path within the same CPU target.
  IF INT(y)<clip.top OR INT(y+8)>clip.bottom THEN
    stop=glyphOffset+CLIPPED_GLYPHS
  FI
  IF stop>last THEN
    stop=last
  FI

  IF CONSOLEBITMAP.ClippedText(x+(glyphOffset LSH 3),y,
      source+SIZE(glyphOffset),stop-glyphOffset,foreground,background,clip)=0 THEN
    RETURN(0)
  FI

  glyphOffset=stop
  IF glyphOffset=last THEN
    glyphOffset=0
    RETURN(1)
  FI

RETURN(2)

; Frame, client and glyph coordinates are independently clipped in pixels.
BYTE FUNC PaintStrip(DESKTYPES.Window POINTER window LAYERTYPES.Layer POINTER layer)
  LAYERTYPES.Rect client,area,bounds
  CARD row,last,first,count,index
  BYTE okay,cached

  LET service=DESKSTATE.Get()
  IF window=NULL THEN
    IF started=PAINT_POPUP_CACHE THEN
      RETURN(DESKMENUCACHE.PopupRestored())
    FI
    IF layer.id<>0 AND (layer.id=DESKSTATE.barLayer OR layer.id=DESKSTATE.popupLayer) THEN
      RETURN(DESKMENUPAINT.Paint(layer,@strip,@started))
    FI
    RETURN(CONSOLEBITMAP.Background(@strip))
  FI

  IF window.iconified<>0 THEN
    RETURN(CONSOLEBITMAP.Frame(@layer.bounds,@strip,@window.title(0),
        0,0,DESKTYPES.FRAME_ICONIFIED,0,0,@glyphOffset))
  FI

  DESKGEOMETRY.Work(window.frameKind,@layer.bounds,@client)
  IF started=PAINT_CACHE THEN
    okay=DESKCACHE.Restored(service)
    IF okay=0 AND window.kind=DESKTYPES.CONTENT_AES THEN
      REGIONS.Intersect(@client,@strip,@area)
      AESWINDOWSTATE.Damage(window,@area)
    FI
    RETURN(okay)
  FI
  IF started=PAINT_BACKING THEN
    RETURN(CONSOLEBITMAP.Failed()=0)
  FI

  IF started=0 THEN
    ; Restore frame and client together, but never replay a stored title.
    IF window.kind<>DESKTYPES.CONTENT_CONSOLE
        AND (window.frameKind=DESKTYPES.FRAME_BORDERLESS
          OR strip.top>=layer.bounds.top+DESKTYPES.TITLE_HEIGHT) THEN
      cached=DESKCACHE.Restore(service,window,@layer.bounds,@strip)
      IF cached=DESKTYPES.CACHE_PENDING THEN
        IF window.kind=DESKTYPES.CONTENT_AES AND AESWINDOWSTATE.Preserves(window)=0 THEN
          REGIONS.Intersect(@client,@strip,@area)
          AESWINDOWSTATE.Damage(window,@area)
        FI
        started=PAINT_CACHE
        RETURN(2)
      ELSEIF cached=DESKTYPES.CACHE_FAILED THEN
        RETURN(0)
      FI
    FI
    commandIndex=0
    glyphOffset=0
    started=PAINT_CLIENT
    IF strip.left<client.left OR strip.top<client.top
        OR strip.right>client.right OR strip.bottom>client.bottom THEN
      started=PAINT_FRAME
    FI
  FI

  IF started=PAINT_FRAME THEN
    okay=FrameStep(window,layer,@client)
    IF okay<>1 THEN
      RETURN(okay)
    FI

    started=PAINT_CLIENT
  FI

  IF started=PAINT_CLIENT THEN
    IF window.kind<>DESKTYPES.CONTENT_CONSOLE THEN
      REGIONS.Intersect(@client,@strip,@area)
      IF window.kind=DESKTYPES.CONTENT_AES THEN
        AESWINDOWSTATE.Damage(window,@area)
      FI

      IF window.kind=DESKTYPES.CONTENT_AES THEN
        RETURN(1)
      FI

      IF window.kind<>DESKTYPES.CONTENT_WIDGETS OR window.widgets=NULL THEN
        IF Fill(@client,@strip,window.content.background)=0 THEN
          RETURN(0)
        FI
      FI
    FI

    started=PAINT_CONTENT
  FI

  REGIONS.Intersect(@client,@strip,@area)
  IF REGIONS.Empty(@area)<>0 THEN
    RETURN(1)
  FI

  IF window.kind=DESKTYPES.CONTENT_CONSOLE THEN
    BEGIN
      LET entry=CONSOLEWINDOWS.Find(window.console)
      IF entry=NULL THEN
        RETURN(0)
      FI

      LET instance=CONSOLETYPES.Instance POINTER(entry.instance)
      LET view=CONSOLETYPES.Presentation POINTER(entry.view)
      IF CONSOLEDISPLAY.BackingReady(view,instance)<>0
          AND ((area.left OR area.right) & 1)=0 THEN
        BEGIN
          LET packet=CONSOLEBITMAP.GetPacket()
          packet.copy.source.offset=DESKTYPES.SHELL_BACKING_BASE
          packet.copy.source.pitch=256
          packet.copy.source.width=512
          packet.copy.source.height=160
          packet.copy.destination.offset=0
          packet.copy.destination.pitch=320
          packet.copy.destination.width=640
          packet.copy.destination.height=240
          packet.copy.sourceX=CARD(area.left-client.left)
          packet.copy.sourceY=CARD(area.top-client.top)
          packet.copy.destinationX=CARD(area.left)
          packet.copy.destinationY=CARD(area.top)
          packet.copy.width=CARD(area.right-area.left)
          packet.copy.height=CARD(area.bottom-area.top)
          IF CONSOLEBITMAP.CopyStart()=0 THEN
            RETURN(0)
          FI
          started=PAINT_BACKING
          RETURN(2)
        END
      FI

      row=(CARD(area.top-client.top) RSH 3)+commandIndex
      last=(CARD(area.bottom-client.top)+7) RSH 3
      first=CARD(area.left-client.left) RSH 3
      count=((CARD(area.right-client.left)+7) RSH 3)-first
      index=CONSOLECORE.CellOffset(instance,row*instance.width+first)
      entry.busy=1
      okay=TextStep(CARD(client.left)+(first LSH 3),
          CARD(client.top)+(row LSH 3),instance.cells+SIZE(index),count,1,0,@area)
      entry.busy=0
      IF okay<>1 THEN
        RETURN(okay)
      FI

      commandIndex==+1
      RETURN(IF row+1=last THEN 1 ELSE 2 FI)
    END
  FI

  IF window.kind=DESKTYPES.CONTENT_WIDGETS THEN
    RETURN(DESKWIDGETS.Paint(service,window,@client,@area,@commandIndex))
  FI

  ; A step scans at most four commands and paints at most one text segment.
  count=0
  WHILE commandIndex<window.content.count AND count<4 DO
    BEGIN
      LET command=@window.content.commands(commandIndex)
      REGIONS.Assign(@bounds,client.left+command.bounds.left,client.top+command.bounds.top,
          client.left+command.bounds.right,client.top+command.bounds.bottom)
      REGIONS.Intersect(@bounds,@area,@bounds)
      okay=1
      IF REGIONS.Empty(@bounds)=0 THEN
        IF command.kind=DESKTYPES.DRAW_FILL THEN
          okay=Fill(@bounds,@bounds,CARD(command.pen))
        ELSE
          okay=TextStep(CARD(client.left+command.bounds.left),
              CARD(client.top+command.bounds.top),@window.content.text(command.offset),
              command.count,CARD(command.pen),window.content.background,@bounds)
          IF okay<>1 THEN
            RETURN(okay)
          FI

          commandIndex==+1
          RETURN(IF commandIndex=window.content.count THEN 1 ELSE 2 FI)
        FI
      FI

      IF okay=0 THEN
        RETURN(0)
      FI
    END

    commandIndex==+1
    count==+1
  OD

RETURN(IF commandIndex=window.content.count THEN 1 ELSE 2 FI)

BYTE FUNC Damaged(LAYERTYPES.Layer POINTER layer)
  CARD index
  BYTE damage

  IF layer.dirty=0 THEN
    RETURN(0)
  FI

  FOR damage=0 TO layer.damage.count-1 DO
    index=0
    WHILE index<layer.visible.count DO
      BEGIN
        LET rect=@layer.visible.rects(index)
        LET changed=@layer.damage.rects(damage)
        IF rect.left<changed.right AND rect.right>changed.left
            AND rect.top<changed.bottom AND rect.bottom>changed.top THEN
          RETURN(1)
        FI
      END

      index==+1
    OD
  OD

RETURN(0)

; Menu precedence applies only between transactions. Two menu transactions
; are followed by an ordinary round-robin turn when one is ready.
LAYERTYPES.Layer POINTER FUNC MenuLayer()
  LAYERTYPES.Layer POINTER layer

  LET service=DESKSTATE.Get()
  layer=LAYERS.Find(@service.scene,DESKSTATE.popupLayer)
  IF DESKSTATE.popupLayer<>0 AND layer<>NULL AND Damaged(layer)<>0 THEN
    RETURN(layer)
  FI
  layer=LAYERS.Find(@service.scene,DESKSTATE.barLayer)
  IF DESKSTATE.barLayer<>0 AND layer<>NULL AND Damaged(layer)<>0 THEN
    RETURN(layer)
  FI

RETURN(NULL)

; The caller has checked service lifetime and physical display availability.
BYTE FUNC DamagePending(DESKTYPES.Service POINTER service)
  BYTE slot

  IF paintToken<>0 THEN
    RETURN(1)
  FI

  IF AESLOCKS.PaintBlocked()<>0 THEN
    RETURN(0)
  FI

  FOR slot=0 TO LAYERTYPES.SLOT_COUNT-1 DO
    BEGIN
      LET layer=@service.scene.items(slot)
      IF Damaged(layer)<>0 THEN
        RETURN(1)
      FI
    END
  OD

RETURN(0)

; Painting work only, independent of pending control messages.
PUBLIC BYTE FUNC PaintPending()

  LET service=DESKSTATE.Get()
  IF service=NULL OR service.live=0 OR CONSOLEBITMAP.Failed()<>0
      OR DISPLAY.Blocked()<>0 THEN
    RETURN(0)
  FI

RETURN(DamagePending(service))

PUBLIC BYTE FUNC Runnable()

  LET service=DESKSTATE.Get()
  IF service=NULL OR service.live=0 OR CONSOLEBITMAP.Failed()<>0 OR DISPLAY.Blocked()<>0 THEN
    RETURN(0)
  FI

  IF DESKCORE.Runnable(service)<>0 THEN
    RETURN(1)
  FI

  IF CONSOLEBITMAP.Pending()<>0 THEN
    RETURN(0)
  FI

RETURN(DamagePending(service))

; True only when the next paint quantum can run without waiting for another
; scene owner or hardware completion. A retained dirty rectangle alone is not
; sufficient reason to continue executing the presenter.
PUBLIC BYTE FUNC Ready()

  LET service=DESKSTATE.Get()
  IF service=NULL OR service.live=0 OR CONSOLEBITMAP.Failed()<>0
      OR DISPLAY.Blocked()<>0 OR CONSOLEBITMAP.Pending()<>0
      OR (paintToken=0 AND service.scene.busy<>0) THEN
    RETURN(0)
  FI

RETURN(DamagePending(service))

; Continue completed menu strips within the same existing four-step allowance.
; Ordinary windows retain their usual boundary and menu transaction fairness.
PUBLIC BYTE FUNC MenuReady()

  IF Ready()=0 THEN
    RETURN(0)
  FI
  IF paintToken<>0 THEN
    RETURN(paintLayer=DESKSTATE.popupLayer OR paintLayer=DESKSTATE.barLayer)
  FI

  IF menuTurns>=2 THEN
    RETURN(0)
  FI

RETURN(MenuLayer()<>NULL)

; Visit the title band, client, then remaining frame pieces. Partition before
; limiting frame height: a full client copy never enters the frame scratch.
BYTE FUNC SelectStrip(DESKTYPES.Window POINTER window
    LAYERTYPES.Layer POINTER layer LAYERTYPES.Rect POINTER damage)
  LAYERTYPES.Rect client,part
  BYTE whole,saved

  LET service=DESKSTATE.Get()
  saved=0
  IF window<>NULL AND window.iconified=0
      AND window.kind<>DESKTYPES.CONTENT_CONSOLE
      AND ((damage.left OR damage.right OR layer.bounds.left) & 1)=0 THEN
    ; A pinned restore is still the selected body partition until retirement.
    saved=(started=PAINT_CACHE OR DESKCACHE.Lookup(service,window,
        CARD(layer.bounds.right-layer.bounds.left),
        CARD(layer.bounds.bottom-layer.bounds.top))<>LAYERCACHE.NO_SLOT)
  FI
  WHILE partIndex<5 DO
    whole=0
    IF window=NULL OR window.iconified<>0 THEN
      IF partIndex<>0 THEN
        RETURN(0)
      FI
      REGIONS.Copy(damage,@strip)
      whole=(started=PAINT_POPUP_CACHE)
    ELSE
      DESKGEOMETRY.Work(window.frameKind,@layer.bounds,@client)
      REGIONS.Copy(@layer.bounds,@part)
      IF saved<>0 THEN
        IF partIndex>=2 THEN
          RETURN(0)
        FI
        IF partIndex=0 THEN
          part.bottom=part.top
          IF window.frameKind<>DESKTYPES.FRAME_BORDERLESS THEN
            part.bottom==+DESKTYPES.TITLE_HEIGHT
          FI
        ELSEIF window.frameKind<>DESKTYPES.FRAME_BORDERLESS THEN
          part.top==+DESKTYPES.TITLE_HEIGHT
        FI
      ELSE
        CASE partIndex OF
        WHEN 0 THEN
          part.bottom=client.top
        WHEN 1 THEN
          REGIONS.Copy(@client,@part)
        WHEN 2 THEN
          part.top=client.bottom
        WHEN 3 THEN
          REGIONS.Assign(@part,layer.bounds.left,client.top,
              client.left,client.bottom)
        ELSE
          REGIONS.Assign(@part,client.right,client.top,
              layer.bounds.right,client.bottom)
        ESAC
      FI
      REGIONS.Intersect(damage,@part,@strip)
      IF partIndex=1 THEN
        IF window.kind=DESKTYPES.CONTENT_CONSOLE THEN
          BEGIN
            LET entry=CONSOLEWINDOWS.Find(window.console)
            whole=CONSOLEDISPLAY.BackingReady(
                CONSOLETYPES.Presentation POINTER(entry.view),
                CONSOLETYPES.Instance POINTER(entry.instance))
          END
        ELSE
          whole=(started=PAINT_CACHE OR window.kind=DESKTYPES.CONTENT_AES
              OR saved<>0)
        FI
        whole=(whole<>0 AND ((strip.left OR strip.right) & 1)=0)
      ELSEIF partIndex>=3 THEN
        ; Solid/atlas sides fit in the existing scratch at a compact pitch.
        whole=(strip.right-strip.left<=DESKTYPES.FRAME_GADGET_WIDTH)
      FI
    FI
    IF REGIONS.Empty(@strip)=0 THEN
      IF nextY<0 THEN
        nextY=strip.top
      FI
      IF nextY<strip.bottom THEN
        strip.top=nextY
        IF whole=0 AND strip.bottom>nextY+STRIP_HEIGHT THEN
          strip.bottom=nextY+STRIP_HEIGHT
        FI
        RETURN(1)
      FI
    FI
    partIndex==+1
    nextY=-1
  OD

RETURN(0)

; One strip step. Return 2 for an unfinished strip, 1 for completed-strip
; progress, or 0 for no work. The worker services input between ready steps.
; The update token and model gate survive worker turns.
PUBLIC BYTE FUNC Pump()
  BYTE count,slot,status,done,fullConsole
  DESKTYPES.Window POINTER window
  LAYERTYPES.Layer POINTER candidate

  LET service=DESKSTATE.Get()
  IF service=NULL OR service.live=0 OR CONSOLEBITMAP.Pending()<>0 OR DISPLAY.Blocked()<>0 THEN
    RETURN(0)
  FI

  IF paintToken=0 THEN
    IF CONSOLEBITMAP.Failed()<>0 OR AESLOCKS.PaintBlocked()<>0 THEN
      RETURN(0)
    FI

    candidate=NULL
    IF menuTurns<2 THEN
      candidate=MenuLayer()
    FI
    IF candidate=NULL THEN
      window=DESKCORE.Find(service,service.focus)
      IF window<>NULL THEN
        candidate=LAYERS.Find(@service.scene,window.layer)
        IF Damaged(candidate)=0 THEN
          candidate=NULL
        FI
      FI
    FI
    IF candidate=NULL THEN
      FOR count=0 TO LAYERTYPES.SLOT_COUNT-1 DO
        slot=nextSlot
        nextSlot=(nextSlot+1) MOD LAYERTYPES.SLOT_COUNT
        BEGIN
          LET layer=@service.scene.items(slot)
          IF (layer.id<>DESKSTATE.barLayer OR layer.id=0)
              AND (layer.id<>DESKSTATE.popupLayer OR layer.id=0)
              AND Damaged(layer)<>0 THEN
            candidate=layer
            EXIT
          FI
        END
      OD
    FI
    IF candidate=NULL THEN
      candidate=MenuLayer()
    FI
    IF candidate<>NULL THEN
      window=ByLayer(candidate.id)
      IF window<>NULL AND window.kind=DESKTYPES.CONTENT_CONSOLE
          AND window.iconified=0 THEN
        BEGIN
          LET entry=CONSOLEWINDOWS.Find(window.console)
          LET view=CONSOLETYPES.Presentation POINTER(entry.view)
          LET instance=CONSOLETYPES.Instance POINTER(entry.instance)
          IF CONSOLEDISPLAY.BackingEnabled(view)<>0
              AND CONSOLEDISPLAY.BackingReady(view,instance)=0 THEN
            entry.busy=1
            CONSOLEDISPLAY.BackingStep(view,instance,entry.unit)
            entry.busy=0
            RETURN(1)
          FI
        END
      FI
      status=LAYERS.BeginPaint(@service.scene,candidate.id,@paintToken)
      IF status=LAYERTYPES.OK THEN
        IF candidate.id<>0 AND (candidate.id=DESKSTATE.popupLayer
            OR candidate.id=DESKSTATE.barLayer) THEN
          IF menuTurns<2 THEN menuTurns==+1 FI
        ELSE
          menuTurns=0
        FI
        paintLayer=candidate.id
        regionIndex=0
        partIndex=0
        nextY=-1
        started=0
        IF candidate.id=DESKSTATE.popupLayer AND service.scene.work.count=1
            AND REGIONS.Equal(@service.scene.work.rects(0),@candidate.bounds)<>0 THEN
          status=DESKMENUCACHE.RestorePopup(candidate)
          IF status=DESKTYPES.CACHE_PENDING THEN
            started=PAINT_POPUP_CACHE
            RETURN(2)
          FI
        FI
      FI
    FI
  FI

  IF paintToken=0 THEN
    RETURN(0)
  FI

  LET region=LAYERS.PaintRegion(@service.scene,paintToken)
  LET layer=LAYERS.Find(@service.scene,paintLayer)
  window=ByLayer(paintLayer)
  done=1
  IF SelectStrip(window,layer,@region.rects(regionIndex))<>0 THEN
    done=PaintStrip(window,layer)
  FI
  IF done=2 THEN
    RETURN(2)
  FI

  IF done<>0 THEN
    IF partIndex<5 THEN
      nextY=strip.bottom
    FI
    started=0
    IF SelectStrip(window,layer,@region.rects(regionIndex))=0 THEN
      regionIndex==+1
      partIndex=0
      nextY=-1
    FI

    IF regionIndex<region.count THEN
      RETURN(1)
    FI
  FI

  IF done<>0 THEN
    status=LAYERS.AdvancePaint(@service.scene,paintToken)
    IF status=LAYERTYPES.OK THEN
      regionIndex=0
      partIndex=0
      nextY=-1
      RETURN(1)
    FI

    done=(status=LAYERTYPES.EMPTY)
  FI

  fullConsole=0
  IF done<>0 AND window<>NULL AND window.kind=DESKTYPES.CONTENT_CONSOLE
      AND window.iconified=0 THEN
    ; An exposure can cover only part of a console whose model still has
    ; dirty rows elsewhere. Only a full-window repaint acknowledges them all.
    fullConsole=layer.damage.count=1
        AND REGIONS.Equal(@layer.damage.rects(0),@layer.bounds)<>0
  FI

  IF done<>0 AND window<>NULL AND window.kind=DESKTYPES.CONTENT_AES THEN
    IF window.iconified=0 THEN
      AESWINDOWSTATE.Handoff(window)
    FI
    status=LAYERS.FinishHandoff(@service.scene,paintToken)
  ELSE
    status=LAYERS.Finish(@service.scene,paintToken,done<>0)
  FI
  paintToken=0
  IF done<>0 AND window<>NULL THEN
    DESKCACHE.Consider(service,window)
  FI
  DESKMENUCACHE.Notify()
  IF window<>NULL AND window.kind=DESKTYPES.CONTENT_CONSOLE
      AND window.iconified=0 THEN
    BEGIN
      LET entry=CONSOLEWINDOWS.Find(window.console)
      LET instance=CONSOLETYPES.Instance POINTER(entry.instance)
      LET view=CONSOLETYPES.Presentation POINTER(entry.view)
      IF fullConsole<>0 AND CONSOLEDISPLAY.BackingEnabled(view)=0 THEN
        CONSOLECORE.Clean(instance)
        view.presentedGeneration=instance.generation
      FI
      view.cursorOn=0
      view.index=$ffff
    END
  FI

RETURN(1)

ENDMODULE
