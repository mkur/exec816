; Presenter-owned pending GUI facts; transport uses the caller's receive port.
MODULE AESGUI
USE EXEC
USE AESTYPES
USE AESSTATE
USE AESINBOX

; Only the closing window retires. The shared input session and menu live
; until the last open sibling closes; immutable queued records use view epochs.
PUBLIC PROC Close(AESSTATE.Window POINTER item)
  BYTE slot,shown

  LET service=AESSTATE.Get()
  LET client=AESSTATE.Find(service,item.owner)
  EXEC.Forbid()
  item.view.epoch=0
  item.gui.count=0
  shown=0
  FOR slot=0 TO AESTYPES.WINDOWS-1 DO
    IF service.windows(slot).owner=client.id THEN
      IF service.windows(slot).view.epoch<>0 THEN
        shown=1
      FI
    FI
  OD
  IF shown=0 THEN
    AESINBOX.Close(client)
    client.endpoint.guiEpoch=0
    client.gui.count=0
  FI
  EXEC.Permit()

RETURN

PUBLIC BYTE FUNC Open(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client AESSTATE.Window POINTER item)

  IF service.nextGuiEpoch=0 THEN
    RETURN(0)
  FI
  EXEC.Forbid()
  item.gui.count=0
  item.view.epoch=service.nextGuiEpoch
  IF client.endpoint.guiEpoch=0 THEN
    client.endpoint.guiEpoch=service.nextGuiEpoch
    AESINBOX.Open(client,service.nextGuiEpoch)
  FI
  service.nextGuiEpoch==+1
  EXEC.Permit()

RETURN(1)

; A round-robin cursor prevents a busy sibling's redraws starving this one.
AESSTATE.GuiPending POINTER FUNC NextPending(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client)
  BYTE attempt,slot

  IF client.gui.count<>0 THEN
    RETURN(@client.gui)
  FI
  FOR attempt=0 TO AESTYPES.WINDOWS-1 DO
    slot=client.guiNext
    client.guiNext==+1
    IF client.guiNext=AESTYPES.WINDOWS THEN
      client.guiNext=0
    FI
    IF service.windows(slot).owner=client.id
        AND service.windows(slot).gui.count<>0 THEN
      RETURN(@service.windows(slot).gui)
    FI
  OD

RETURN(NULL)

; At most one new record per call. Once PutMsg starts the producer owns only
; its independent endpoint hold, never the record's fields or linkage.
PUBLIC PROC Publish(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client)
  BYTE kind,index

  LET endpoint=client.endpoint
  EXEC.Forbid()
  IF endpoint.guiFree=0 THEN
    EXEC.Permit()
    RETURN
  FI
  LET pending=NextPending(service,client)
  IF pending=NULL OR endpoint.guiEpoch=0 THEN
    endpoint.guiWaiting=0
    EXEC.Permit()
    RETURN
  FI

  endpoint.guiFree=0
  endpoint.holds==+1

  kind=pending.order(0)
  pending.count==-1
  index=0
  WHILE index<pending.count DO
    pending.order(index)=pending.order(index+1)
    index==+1
  OD

  LET delivery=endpoint.gui
  LET notice=@pending.notices(kind)
  delivery.epoch=endpoint.guiEpoch
  IF kind<>AESTYPES.GUI_MENU THEN
    FOR index=0 TO AESTYPES.WINDOWS-1 DO
      IF @service.windows(index).gui=pending THEN
        delivery.epoch=service.windows(index).view.epoch
        EXIT
      FI
    OD
  FI
  delivery.menuEpoch=0
  delivery.delivery.message.mn_ReplyPort=NULL
  delivery.delivery.message.mn_Length=AESTYPES.GUIDELIVERY_SIZE
  delivery.delivery.words(0)=AESTYPES.WM_REDRAW
  IF kind=AESTYPES.GUI_TOPPED THEN
    delivery.delivery.words(0)=AESTYPES.WM_TOPPED
  ELSEIF kind=AESTYPES.GUI_FULLED THEN
    delivery.delivery.words(0)=AESTYPES.WM_FULLED
  ELSEIF kind=AESTYPES.GUI_MOVED THEN
    delivery.delivery.words(0)=AESTYPES.WM_MOVED
  ELSEIF kind=AESTYPES.GUI_SIZED THEN
    delivery.delivery.words(0)=AESTYPES.WM_SIZED
  ELSEIF kind=AESTYPES.GUI_VSLID THEN
    delivery.delivery.words(0)=AESTYPES.WM_VSLID
  ELSEIF kind=AESTYPES.GUI_ARROWED THEN
    delivery.delivery.words(0)=AESTYPES.WM_ARROWED
  ELSEIF kind=AESTYPES.GUI_CLOSED THEN
    delivery.delivery.words(0)=AESTYPES.WM_CLOSED
  ELSEIF kind=AESTYPES.GUI_FOCUS THEN
    delivery.delivery.words(0)=AESTYPES.WM_UNTOPPED
    IF notice.x<>0 THEN
      delivery.delivery.words(0)=AESTYPES.WM_ONTOP
    FI
  FI

  delivery.delivery.words(1)=0
  delivery.delivery.words(2)=0
  delivery.delivery.words(3)=pending.window
  delivery.delivery.words(4)=notice.x
  delivery.delivery.words(5)=notice.y
  delivery.delivery.words(6)=notice.width
  delivery.delivery.words(7)=notice.height
  IF kind=AESTYPES.GUI_MENU THEN
    delivery.menuEpoch=endpoint.menuEpoch
    delivery.delivery.words(0)=AESTYPES.MN_SELECTED
    delivery.delivery.words(3)=client.menu.selectedTitle
    delivery.delivery.words(4)=client.menu.selectedItem
    delivery.delivery.words(5)=INT(LONGCARD(ADDRESS(client.menu.tree)) RSH 16)
    delivery.delivery.words(6)=INT(ADDRESS(client.menu.tree))
    delivery.delivery.words(7)=client.menu.selectedBox
  FI
  endpoint.guiWaiting=client.gui.count<>0
  FOR index=0 TO AESTYPES.WINDOWS-1 DO
    IF service.windows(index).owner=client.id AND service.windows(index).gui.count<>0 THEN
      endpoint.guiWaiting=1
    FI
  OD
  EXEC.Permit()
  EXEC.PutMsg(endpoint.port,@delivery.delivery.message)
  EXEC.Forbid()
  endpoint.holds==-1
  IF endpoint.state=AESTYPES.ENDPOINT_CLOSING AND endpoint.holds=0 THEN
    service.directory.changed=1
    EXEC.Signal(service.owner,service.mask)
  FI

  EXEC.Permit()

RETURN

; Geometry is trusted on-screen work from the window manager. Bound unions can
; overestimate damage; the application still clips against current visibility.
PROC Queue(AESSTATE.Service POINTER service AESSTATE.Client POINTER client
    AESSTATE.GuiPending POINTER pending BYTE kind INT x,y,width,height)
  BYTE index
  INT right,bottom

  EXEC.Forbid()
  IF client.endpoint.guiEpoch=0 THEN
    EXEC.Permit()
    RETURN
  FI

  index=0
  WHILE index<pending.count AND pending.order(index)<>kind DO
    index==+1
  OD

  LET notice=@pending.notices(kind)
  IF index<pending.count AND kind=AESTYPES.GUI_REDRAW THEN
    right=notice.x+notice.width
    bottom=notice.y+notice.height
    IF x+width>right THEN
      right=x+width
    FI

    IF y+height>bottom THEN
      bottom=y+height
    FI

    IF x<notice.x THEN
      notice.x=x
    FI

    IF y<notice.y THEN
      notice.y=y
    FI

    notice.width=right-notice.x
    notice.height=bottom-notice.y
  ELSE
    notice.x=x
    notice.y=y
    notice.width=width
    notice.height=height
    IF index=pending.count THEN
      pending.order(index)=kind
      pending.count==+1
    FI
  FI

  client.endpoint.guiWaiting=1
  EXEC.Permit()
  Publish(service,client)

RETURN

PUBLIC PROC Post(AESSTATE.Service POINTER service AESSTATE.Window POINTER item
    BYTE kind INT x,y,width,height)

  IF item.view.epoch<>0 THEN
    Queue(service,AESSTATE.Find(service,item.owner),@item.gui,kind,x,y,width,height)
  FI

RETURN

; Called only by the presenter after paint retirement. Reserve before accepting
; a click; delayed clients cannot lose a command to a newer selection.
PUBLIC BYTE FUNC Select(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client INT title,item,box)

  LET menu=client.menu
  IF menu=NULL THEN
    RETURN(0)
  FI
  LET heading=AESTYPES.MenuObject POINTER(ADDRESS(menu.tree)
      +SIZE(CARD(title))*SIZE(AESTYPES.MENUOBJECT_SIZE))
  LET entry=AESTYPES.MenuObject POINTER(ADDRESS(menu.tree)
      +SIZE(CARD(item))*SIZE(AESTYPES.MENUOBJECT_SIZE))
  IF (heading.state & 8)<>0 OR (entry.state & 8)<>0
      OR (heading.flags & 128)<>0 OR (entry.flags & 128)<>0 THEN
    RETURN(0)
  FI
  EXEC.Forbid()
  IF client.endpoint.guiEpoch=0 OR client.endpoint.menuConsumed=0
      OR client.endpoint.menuNormal=0 THEN
    EXEC.Permit()
    RETURN(0)
  FI
  client.endpoint.menuConsumed=0
  client.endpoint.menuNormal=0
  menu.selectedTitle=title
  menu.selectedItem=item
  menu.selectedBox=box
  heading.state=heading.state OR 1
  menu.damage(title)=1
  EXEC.Permit()
  service.menuRevision==+1
  Queue(service,client,@client.gui,AESTYPES.GUI_MENU,0,0,0,0)

RETURN(1)

ENDMODULE
