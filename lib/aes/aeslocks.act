; Application locks are presenter policy, never kernel Forbid or Layers tokens.
MODULE AESLOCKS
USE DISPLAY
USE AESTYPES
USE AESSTATE
USE AESMOUSE
USE AESWINDOWSTATE
USE DESKSTATE
USE CONSOLEBITMAP
USE CONSOLEBATCH
USE CONSOLETYPES

; The RPC owner may evaluate hardware readiness; local callers use the
; readiness established when the presenter published its handoff.
PUBLIC CONST OWNER_READY=2

PUBLIC BYTE FUNC PaintBlocked()

  LET service=AESSTATE.Get()

RETURN(service<>NULL AND service.live<>0
    AND (service.updateOwner<>0 OR service.lockCount<>0 OR service.windowPending<>0))

PUBLIC BYTE FUNC MouseBlocked()

  LET service=AESSTATE.Get()

RETURN(service<>NULL AND service.live<>0
    AND (service.mouseOwner<>0 OR service.lockCount<>0 OR service.windowPending<>0))

PUBLIC BYTE FUNC NativeReady()

  LET desktop=DESKSTATE.Get()
  LET batch=CONSOLEBATCH.Get()

RETURN(DISPLAY.Blocked()=0 AND desktop<>NULL AND desktop.scene.busy=0
    AND CONSOLEBITMAP.Pending()=0
    AND batch.phase=CONSOLETYPES.BATCH_IDLE
    AND DESKSTATE.outlineVisible=0)

BYTE FUNC Eligible(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client CARD code BYTE ready)

  IF AESMOUSE.LockReady(client.id)=0 THEN
    RETURN(0)
  FI

  IF service.mouseOwner<>0 AND service.mouseOwner<>client.id THEN
    RETURN(0)
  FI

  IF code=AESTYPES.BEG_UPDATE AND service.updateOwner<>0
      AND service.updateOwner<>client.id THEN
    RETURN(0)
  FI

  ; Existing owners may recurse while native work awaits their release.
  IF (code=AESTYPES.BEG_UPDATE AND service.updateOwner=client.id)
      OR (code=AESTYPES.BEG_MCTRL AND service.mouseOwner=client.id) THEN
    RETURN(1)
  FI

  IF service.windowPending<>0 THEN
    RETURN(0)
  FI

  IF ready=OWNER_READY THEN
    RETURN(NativeReady())
  FI

RETURN(ready)

CARD FUNC Acquire(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client CARD code INT window)

  IF code=AESTYPES.BEG_UPDATE THEN
    IF service.updates=$ffff THEN
      RETURN(AESTYPES.OVERFLOW)
    FI

    service.updateOwner=client.id
    IF service.updates=0 THEN
      AESSTATE.mouseDirty=1
      service.updateWindow=window
      AESWINDOWSTATE.BeginUpdate(client)
    FI

    service.updates==+1
    AESWINDOWSTATE.Updates(client,service.updates)
  ELSE
    IF service.mouseHolds=$ffff THEN
      RETURN(AESTYPES.OVERFLOW)
    FI

    IF service.mouseHolds=0 THEN
      AESSTATE.mouseDirty=1
    FI
    service.mouseHolds==+1
  FI

  service.mouseOwner=client.id
  AESMOUSE.Refresh()

RETURN(AESTYPES.OK)

PROC Remove(AESSTATE.Service POINTER service BYTE position)

  service.lockCount==-1
  WHILE position<service.lockCount DO
    service.lockOrder(position)=service.lockOrder(position+1)
    position==+1
  OD

RETURN

; Complete a release synchronously, including the final paint journal.
CARD FUNC Release(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client CARD code)

  IF code=AESTYPES.END_UPDATE THEN
    IF service.updateOwner<>client.id OR service.updates=0 THEN
      RETURN(AESTYPES.IDENTITY)
    FI

    service.updates==-1
    AESWINDOWSTATE.Updates(client,service.updates)
    IF service.updates=0 THEN
      AESSTATE.mouseDirty=1
      AESWINDOWSTATE.EndUpdate(client)
      service.updateOwner=0
      service.updateWindow=0
    FI
  ELSE
    IF service.mouseOwner<>client.id OR service.mouseHolds=0 THEN
      RETURN(AESTYPES.IDENTITY)
    FI

    service.mouseHolds==-1
    IF service.mouseHolds=0 THEN
      AESSTATE.mouseDirty=1
    FI
  FI

  IF service.updates=0 AND service.mouseHolds=0 THEN
    service.mouseOwner=0
  FI

  AESMOUSE.Refresh()

RETURN(AESTYPES.OK)

; Runs under exclusive presenter policy ownership. A pending result changes no
; ownership and does not enqueue a request or wait.
PUBLIC CARD FUNC Attempt(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client AESTYPES.Request POINTER request
    BYTE ready,queued)
  CARD code,status

  request.intout(0)=0
  code=CARD(request.intin(0))
  IF (code & $fcfc)<>0
      OR ((code & AESTYPES.TRY)<>0 AND (code & 1)=0) THEN
    RETURN(AESTYPES.UNSUPPORTED)
  FI

  IF (code & AESTYPES.UPDATE_WINDOW)<>0
      AND (code & $ff)<>AESTYPES.BEG_UPDATE THEN
    RETURN(AESTYPES.UNSUPPORTED)
  FI

  IF (code & 1)<>0 THEN
    code=code & $ff
    IF Eligible(service,client,code,ready)<>0 AND (queued=0
        OR service.mouseOwner=client.id) THEN
      status=Acquire(service,client,code,
          IF (CARD(request.intin(0)) & AESTYPES.UPDATE_WINDOW)<>0 THEN
            request.intin(1) ELSE INT(0) FI)
      IF status=AESTYPES.OK THEN
        request.intout(0)=1
      FI

      RETURN(status)
    FI

    IF (CARD(request.intin(0)) & AESTYPES.TRY)<>0 THEN
      RETURN(AESTYPES.OK)
    FI

    RETURN(AESTYPES.PENDING)
  FI

  status=Release(service,client,code)
  IF status=AESTYPES.OK THEN
    request.intout(0)=1
  FI

RETURN(status)

; Only RPC admission manages pending requests and eligible-waiter order.
PUBLIC CARD FUNC Request(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client AESTYPES.Request POINTER request)
  BYTE index

  LET status=Attempt(service,client,request,OWNER_READY,service.lockCount<>0)
  IF status<>AESTYPES.PENDING THEN
    RETURN(status)
  FI

  IF service.lockCount=AESTYPES.CLIENTS THEN
    RETURN(AESTYPES.RESOURCE)
  FI

  FOR index=0 TO AESTYPES.CLIENTS-1 DO
    IF @service.clients(index)=client THEN
      service.lockOrder(service.lockCount)=index
      service.lockCount==+1
      client.pending=request
      RETURN(AESTYPES.PENDING)
    FI
  OD

RETURN(AESTYPES.IDENTITY)

PUBLIC PROC Wake(AESSTATE.Service POINTER service)
  BYTE position
  CARD code,status

  position=0
  WHILE position<service.lockCount DO
    BEGIN
      LET client=@service.clients(service.lockOrder(position))
      LET request=client.pending
      code=CARD(request.intin(0)) & $ff
      IF Eligible(service,client,code,OWNER_READY)<>0 THEN
        status=Acquire(service,client,code,
          IF (CARD(request.intin(0)) & AESTYPES.UPDATE_WINDOW)<>0 THEN
            request.intin(1) ELSE INT(0) FI)
        Remove(service,position)
        client.pending=NULL
        IF status=AESTYPES.OK THEN
          request.intout(0)=1
        FI

        AESSTATE.Reply(request,status)
      ELSE
        position==+1
      FI
    END
  OD

RETURN

; Called before the exit reply. Pending peers become eligible in this turn.
PUBLIC PROC Retire(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client)

  IF service.updateOwner=client.id THEN
    AESSTATE.mouseDirty=1
    service.updateOwner=0
    service.updates=0
    service.updateWindow=0
  FI

  IF service.mouseOwner=client.id THEN
    AESSTATE.mouseDirty=1
    service.mouseOwner=0
    service.mouseHolds=0
  FI

RETURN

ENDMODULE
