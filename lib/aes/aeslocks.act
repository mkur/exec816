; MagiC's common UPDATE resource, backed by the public native semaphore.
MODULE AESLOCKS
USE EXEC
USE AESTYPES
USE AESSTATE
USE AESMOUSE
USE AESWINDOWSTATE
USE AESSNAPSHOT
USE AESWAIT
USE DESKSTATE
USE CONSOLEBITMAP
BYTE systemHeld
CARD systemDepth
; Temporary native facade levels have no application nesting or retained
; manager marker. Count them only to identify the final scheduling boundary.
CARD uiDepth

PUBLIC PROC Init(AESSTATE.Service POINTER service)

  EXEC.InitSemaphore(@service.updateResource)
  systemHeld=0
  systemDepth=0
  uiDepth=0

RETURN

; Called under the final-release guard. The hint cannot grant ownership.
PROC Notify(AESSTATE.Service POINTER service)

  IF (service.updateHint & AESSTATE.UPDATE_WAITING)<>0 THEN
    service.updateHint=service.updateHint & ($ff-AESSTATE.UPDATE_WAITING)
    EXEC.Signal(service.owner,service.mask)
  FI

RETURN

; Publication precedes Release, which may make a recipient ready immediately.
; Only the short final notification/release pair needs an outer Task guard.
PROC ReturnResource(AESSTATE.Service POINTER service BYTE final)

  final=final<>0 AND uiDepth=0 AND systemHeld=0
  IF final<>0 THEN
    EXEC.Forbid()
    Notify(service)
    EXEC.ReleaseSemaphore(@service.updateResource)
    EXEC.Permit()
    EXEC.Yield()
  ELSE
    EXEC.ReleaseSemaphore(@service.updateResource)
  FI

RETURN

; Native facade scopes use the same UPDATE resource and release notification.
; They do not open an application paint journal or alter explicit nesting.
PUBLIC PROC ObtainUI()

  LET service=AESSTATE.Get()
  EXEC.ObtainSemaphore(@service.updateResource)
  uiDepth==+1

RETURN

PUBLIC BYTE FUNC AttemptUI()

  LET service=AESSTATE.Get()
  IF EXEC.AttemptSemaphore(@service.updateResource)=0 THEN
    RETURN(0)
  FI
  uiDepth==+1

RETURN(1)

PUBLIC PROC ReleaseUI()

  LET service=AESSTATE.Get()
  uiDepth==-1
  ReturnResource(service,service.updates=0)

RETURN

; SCRENMGR enters only for actual interaction. Native FIFO Obtain can sleep;
; input, caller operations and device completion retain independent owners.
BYTE FUNC SystemReady()

  LET service=AESSTATE.Get()
  IF service=NULL OR service.live=0 OR systemHeld<>0 THEN
    RETURN(1)
  FI
  EXEC.ObtainSemaphore(@service.updateResource)
  systemHeld=1

RETURN(1)

PUBLIC BYTE FUNC PaintBlocked()

  LET service=AESSTATE.Get()

; A scheduling hint only. Protected entries must still acquire the native
; resource: a peer may acquire or receive FIFO ownership after this read.
RETURN(service<>NULL AND service.live<>0 AND systemHeld=0
    AND service.updates<>0)

PUBLIC BYTE FUNC MouseBlocked()

RETURN(PaintBlocked())

; Pending work can become blocked after its operation-entry attempt. Arm the
; existing release wake before deciding to sleep; recheck under the same guard
; as final release. This hint neither acquires nor grants the native resource.
PUBLIC BYTE FUNC SystemBlocked()
  BYTE blocked

  IF PaintBlocked()=0 THEN
    RETURN(0)
  FI
  LET service=AESSTATE.Get()
  EXEC.Forbid()
  blocked=(systemHeld=0 AND service.updates<>0)
  IF blocked<>0 THEN
    service.updateHint=service.updateHint OR AESSTATE.UPDATE_WAITING
  FI
  EXEC.Permit()

RETURN(blocked)

PUBLIC BYTE FUNC NativeReady()

  LET desktop=DESKSTATE.Get()

RETURN(desktop<>NULL AND desktop.scene.busy=0
    AND CONSOLEBITMAP.Pending()=0 AND DESKSTATE.menuReplacing=0
    AND DESKSTATE.outlineVisible=0)

; Retain ownership across an actual physical continuation, never across idle
; cache gathering. A control callback uses this same balanced Release/Try path.
PUBLIC PROC SystemRelease()

  LET service=AESSTATE.Get()
  IF systemDepth=0 AND systemHeld<>0 AND NativeReady()<>0
      AND DESKSTATE.managerCapture=0 AND DESKSTATE.menuActive=0 THEN
    service.updateHint=service.updateHint &
        ($ff-AESSTATE.CONTROLLER_LOAN-AESSTATE.UPDATE_REQUESTED)
    systemHeld=0
    ReturnResource(service,1)
  FI

RETURN

; Nested manager operations share one native level. A retained gesture can
; keep that level between scopes; independent input never enters a scope.
PUBLIC BYTE FUNC SystemBegin()

  IF SystemReady()=0 THEN
    RETURN(0)
  FI
  systemDepth==+1

RETURN(1)

PUBLIC PROC SystemEnd()

  systemDepth==-1
  SystemRelease()

RETURN

; Shutdown has closed admission and drained all clients and physical effects.
PUBLIC PROC SystemStop()

  IF systemHeld<>0 THEN
    systemHeld=0
    ReturnResource(AESSTATE.Get(),1)
  FI

RETURN

; UPDATE is the common recursive resource; MCTRL adds a routing overlay.
CARD FUNC Acquire(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client CARD code BYTE painting)

  IF service.updates=$ffff THEN
    RETURN(AESTYPES.OVERFLOW)
  FI
  IF code=AESTYPES.BEG_MCTRL AND service.mouseHolds=$ffff THEN
    RETURN(AESTYPES.OVERFLOW)
  FI
  EXEC.Forbid()
  service.updateOwner=client.id
  service.updates==+1
  IF code=AESTYPES.BEG_MCTRL THEN
    IF service.mouseHolds=0 THEN
      AESSTATE.mouseDirty=AESSTATE.MOUSE_DIRTY
    FI
    service.mouseOwner=client.id
    service.mouseHolds==+1
  ELSEIF painting<>0 THEN
    service.updateHolds==+1
  FI
  EXEC.Permit()
  IF painting<>0 THEN
    AESWINDOWSTATE.Updates(client,service.updateHolds+service.mouseHolds)
  FI
  IF code=AESTYPES.BEG_MCTRL AND service.mouseHolds=1 THEN
    AESMOUSE.Refresh()
  FI

RETURN(AESTYPES.OK)

; Publish nesting and routing before making the common resource available.
CARD FUNC Release(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client CARD code BYTE painting)
  CARD updates,mouse

  IF service.updateOwner<>client.id OR service.updates=0 THEN
    RETURN(AESTYPES.IDENTITY)
  FI
  updates=service.updateHolds
  mouse=service.mouseHolds
  IF code=AESTYPES.END_MCTRL THEN
    IF service.mouseOwner<>client.id OR mouse=0 THEN
      RETURN(AESTYPES.IDENTITY)
    FI
    mouse==-1
  ELSEIF painting<>0 THEN
    IF updates=0 THEN
      RETURN(AESTYPES.IDENTITY)
    FI
    updates==-1
  FI
  IF painting<>0 THEN
    AESWINDOWSTATE.Updates(client,updates+mouse)
  FI
  EXEC.Forbid()
  service.updateHolds=updates
  service.mouseHolds=mouse
  IF code=AESTYPES.END_MCTRL AND mouse=0 THEN
    AESSTATE.mouseDirty=AESSTATE.MOUSE_DIRTY
    service.mouseOwner=0
  FI
  service.updates==-1
  IF service.updates=0 THEN
    service.updateOwner=0
  FI
  EXEC.Permit()
  IF code=AESTYPES.END_MCTRL AND mouse=0 THEN
    AESMOUSE.Refresh()
  FI

RETURN(AESTYPES.OK)

PUBLIC CARD FUNC Decode(CARD code)

  IF (code & $fefc)<>0
      OR ((code & AESTYPES.TRY)<>0 AND (code & 1)=0) THEN
    RETURN(AESTYPES.UNSUPPORTED)
  FI

RETURN(AESTYPES.OK)

; One acquisition path for public UPDATE/MCTRL and temporary handler scopes.
; Native Attempt handles the common uncontended/recursive case. Only a real
; miss needs a presenter quiescence hint followed by native blocking Obtain.
; Never obtain while owning a physical backend grant.
PUBLIC CARD FUNC Call(AESTYPES.Request POINTER request BYTE painting)
  CARD code,status
  BYTE guarded

  LET service=AESSTATE.Get()
  LET client=AESSTATE.Find(service,request.client)
  LET mask=LONGCARD(1) LSH request.message.mn_ReplyPort.mp_SigBit
  code=CARD(request.intin(0))
  status=Decode(code)
  request.intout(0)=0
  IF status<>AESTYPES.OK THEN
    RETURN(status)
  FI
  IF (code & 1)<>0 THEN
    IF service.updateOwner=client.id AND (service.updates=$ffff
        OR ((code & $ff)=AESTYPES.BEG_MCTRL AND service.mouseHolds=$ffff)) THEN
      RETURN(AESTYPES.OVERFLOW)
    FI
    IF EXEC.AttemptSemaphore(@service.updateResource)=0 THEN
      IF (code & AESTYPES.TRY)<>0 THEN
        RETURN(AESTYPES.OK)
      FI
      EXEC.Forbid()
      service.updateHint=service.updateHint OR AESSTATE.UPDATE_REQUESTED
      EXEC.Signal(service.owner,service.mask)
      EXEC.ObtainSemaphore(@service.updateResource)
      EXEC.Permit()
    FI
    code=code & $ff
    guarded=(code=AESTYPES.BEG_MCTRL)
    IF guarded<>0 THEN
      IF (CARD(request.intin(0)) & AESTYPES.TRY)<>0
          AND AESMOUSE.LockReady(client.id)=0 THEN
        ReturnResource(service,service.updates=0)
        RETURN(AESTYPES.OK)
      FI
      ; UPDATE is already owned. This continuation waits only for an older
      ; physical capture before installing the MCTRL routing overlay.
      WHILE AESMOUSE.LockReady(client.id)=0 DO
        AESWAIT.Window(service,client,request)
        client.waitMode=AESWAIT.CALLER
        AESSNAPSHOT.Publish()
        EXEC.Signal(service.owner,service.mask)
        EXEC.Wait(mask)
      OD
      client.pending=NULL
      AESWAIT.RemoveWindow(service,client)
      client.waitMode=AESWAIT.IDLE
    FI
    status=Acquire(service,client,code,painting)
    IF guarded<>0 THEN
      AESSNAPSHOT.Publish()
    FI
    IF status<>AESTYPES.OK THEN
      ReturnResource(service,service.updates=0)
    FI
  ELSE
    IF service.updateOwner<>client.id OR service.updates=0
        OR (code=AESTYPES.END_MCTRL AND service.mouseHolds=0)
        OR (code=AESTYPES.END_UPDATE AND painting<>0 AND service.updateHolds=0) THEN
      RETURN(AESTYPES.IDENTITY)
    FI
    guarded=(code=AESTYPES.END_MCTRL)
    status=Release(service,client,code,painting)
    IF guarded<>0 THEN
      AESSNAPSHOT.Publish()
    FI
    IF status=AESTYPES.OK THEN
      ReturnResource(service,service.updates=0)
    FI
  FI
  request.intout(0)=INT(status=AESTYPES.OK)

RETURN(status)

ENDMODULE
