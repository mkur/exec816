; Application locks are presenter policy, never kernel Forbid or Layers tokens.
MODULE AESLOCKS
USE DISPLAY
USE AESTYPES
USE AESSTATE
USE AESWAIT
USE AESMOUSE
USE AESWINDOWSTATE
USE DESKSTATE
USE CONSOLEBITMAP
USE CONSOLEBATCH
USE CONSOLETYPES
USE EXEC

; Both transports evaluate logical/physical eligibility while owning the scene.
PUBLIC CONST OWNER_READY=2

; Presenter resource-dependent work never blocks the independent dispatcher.
; The hint requests a later turn; it neither queues a client nor grants UPDATE.
PUBLIC BYTE FUNC SystemReady()

  LET service=AESSTATE.Get()
  EXEC.Forbid()
  LET ready=(service=NULL OR service.updateOwner=0)
  IF ready=0 THEN
    service.updateHint=service.updateHint OR AESSTATE.UPDATE_WAITING
  FI
  EXEC.Permit()

RETURN(ready)

PROC Notify(AESSTATE.Service POINTER service)

  EXEC.Forbid()
  IF (service.updateHint & AESSTATE.UPDATE_WAITING)<>0 THEN
    service.updateHint=service.updateHint & ($ff-AESSTATE.UPDATE_WAITING)
    EXEC.Signal(service.owner,service.mask)
  FI
  EXEC.Permit()

RETURN

PUBLIC BYTE FUNC ControllerLoan()

  LET service=AESSTATE.Get()

RETURN(service<>NULL AND (service.updateHint & AESSTATE.CONTROLLER_LOAN)<>0)

PUBLIC BYTE FUNC PaintBlocked()

  LET service=AESSTATE.Get()

RETURN(service<>NULL AND service.live<>0
    AND (service.updateOwner<>0 OR service.lockCount<>0 OR service.windowPending<>0))

PUBLIC BYTE FUNC MouseBlocked()

  LET service=AESSTATE.Get()

RETURN(service<>NULL AND service.live<>0
    AND (service.updateOwner<>0 OR service.lockCount<>0 OR service.windowPending<>0))

PUBLIC BYTE FUNC NativeReady()

  LET desktop=DESKSTATE.Get()
  LET batch=CONSOLEBATCH.Get()
  LET service=AESSTATE.Get()

RETURN(DISPLAY.Blocked()=0 AND desktop<>NULL AND desktop.scene.busy=0
    AND (service=NULL OR service.policyEffects=0)
    AND CONSOLEBITMAP.Pending()=0 AND DESKSTATE.menuReplacing=0
    AND batch.phase=CONSOLETYPES.BATCH_IDLE
    AND DESKSTATE.outlineVisible=0)

; The current engine publishes scene availability after this boundary. Native
; cutover replaces it with the matching public semaphore release.
PUBLIC PROC SystemRelease()

  LET service=AESSTATE.Get()
  IF service<>NULL AND NativeReady()<>0 THEN
    service.updateHint=service.updateHint & ($ff-AESSTATE.CONTROLLER_LOAN)
  FI

RETURN

BYTE FUNC Eligible(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client CARD code BYTE ready,beforeWindows)

  IF service.updateOwner=client.id THEN
    RETURN(1)
  FI
  IF service.updateOwner<>0 THEN
    RETURN(0)
  FI

  ; Work capture routes input until release. Another client may paint while
  ; that recipient waits; explicit MCTRL must still respect the capture.
  IF (code=AESTYPES.BEG_MCTRL AND AESMOUSE.LockReady(client.id)=0)
      OR (code=AESTYPES.BEG_UPDATE AND AESMOUSE.UpdateReady(client.id)=0) THEN
    RETURN(0)
  FI

  IF service.mouseOwner<>0 AND service.mouseOwner<>client.id THEN
    RETURN(0)
  FI

  ; A window/exit waiter can itself depend on this mouse owner. Its UPDATE
  ; upgrade must remain eligible; otherwise both sides wait for one another.
  IF service.windowPending<>0 AND service.mouseOwner<>client.id
      AND beforeWindows=0 THEN
    RETURN(0)
  FI

  IF ready=OWNER_READY THEN
    RETURN(NativeReady())
  FI

RETURN(ready)

; UPDATE is the common recursive resource; MCTRL adds a routing overlay.
CARD FUNC Acquire(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client CARD code INT window BYTE painting)

  IF service.updates=$ffff THEN
    RETURN(AESTYPES.OVERFLOW)
  FI
  IF code=AESTYPES.BEG_MCTRL AND service.mouseHolds=$ffff THEN
    RETURN(AESTYPES.OVERFLOW)
  FI
  IF painting<>0 AND service.updateHolds+service.mouseHolds=0 THEN
    service.updateWindow=window
    AESWINDOWSTATE.BeginUpdate(client)
  FI
  service.updateOwner=client.id
  service.updates==+1
  IF code=AESTYPES.BEG_MCTRL THEN
    IF service.mouseHolds=0 THEN
      AESSTATE.mouseDirty=1
    FI
    service.mouseOwner=client.id
    service.mouseHolds==+1
  ELSEIF painting<>0 THEN
    service.updateHolds==+1
  FI
  IF painting<>0 THEN
    AESWINDOWSTATE.Updates(client,service.updateHolds+service.mouseHolds)
  FI
  IF code=AESTYPES.BEG_MCTRL AND service.mouseHolds=1 THEN
    AESMOUSE.Refresh()
  FI

RETURN(AESTYPES.OK)

; Publication and the journal finish before the resource is made available.
CARD FUNC Release(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client CARD code BYTE painting)

  IF service.updateOwner<>client.id OR service.updates=0 THEN
    RETURN(AESTYPES.IDENTITY)
  FI
  IF code=AESTYPES.END_MCTRL THEN
    IF service.mouseOwner<>client.id OR service.mouseHolds=0 THEN
      RETURN(AESTYPES.IDENTITY)
    FI
    service.mouseHolds==-1
    IF service.mouseHolds=0 THEN
      AESSTATE.mouseDirty=1
      service.mouseOwner=0
    FI
  ELSEIF painting<>0 THEN
    IF service.updateHolds=0 THEN
      RETURN(AESTYPES.IDENTITY)
    FI
    service.updateHolds==-1
  FI
  IF painting<>0 THEN
    AESWINDOWSTATE.Updates(client,service.updateHolds+service.mouseHolds)
    IF service.updateHolds+service.mouseHolds=0 THEN
      AESWINDOWSTATE.EndUpdate(client)
      service.updateWindow=0
    FI
  FI
  service.updates==-1
  IF service.updates=0 THEN
    service.updateOwner=0
    Notify(service)
  FI
  IF code=AESTYPES.END_MCTRL AND service.mouseHolds=0 THEN
    AESMOUSE.Refresh()
  FI

RETURN(AESTYPES.OK)

PUBLIC CARD FUNC Decode(CARD code)
  IF (code & $fcfc)<>0
      OR ((code & AESTYPES.TRY)<>0 AND (code & 1)=0) THEN
    RETURN(AESTYPES.UNSUPPORTED)
  FI

  IF (code & AESTYPES.UPDATE_WINDOW)<>0
      AND (code & $ff)<>AESTYPES.BEG_UPDATE THEN
    RETURN(AESTYPES.UNSUPPORTED)
  FI

RETURN(AESTYPES.OK)

; Recursion uses the common transitions without scene admission. Only outer
; painting/routing transitions need the guarded policy path.
PUBLIC BYTE FUNC Nested(AESSTATE.Service POINTER service
    AESTYPES.Request POINTER request BYTE painting)
  CARD code,status

  IF service.updateOwner<>request.client OR service.updates=0 THEN
    RETURN(0)
  FI
  code=CARD(request.intin(0)) & $ff
  LET depth=service.updateHolds+service.mouseHolds
  IF code=AESTYPES.BEG_UPDATE AND (painting=0 OR depth<>0) THEN
    status=Acquire(service,AESSTATE.Find(service,request.client),code,0,painting)
  ELSEIF code=AESTYPES.END_UPDATE AND service.updates>1
      AND ((painting=0 AND service.updates>depth)
        OR (painting<>0 AND service.updateHolds<>0 AND depth>1)) THEN
    status=Release(service,AESSTATE.Find(service,request.client),code,painting)
  ELSE
    RETURN(0)
  FI
  request.status=status
  request.intout(0)=INT(status=AESTYPES.OK)

RETURN(1)

; Runs under exclusive presenter policy ownership. A pending result changes no
; ownership and does not enqueue a request or wait. The caller decodes once.
PUBLIC CARD FUNC Attempt(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client AESTYPES.Request POINTER request
    BYTE ready,queued,painting)
  CARD code,status

  request.intout(0)=0
  code=CARD(request.intin(0))

  IF (code & 1)<>0 THEN
    code=code & $ff
    IF Eligible(service,client,code,ready,0)<>0 AND (queued=0
        OR service.updateOwner=client.id) THEN
      status=Acquire(service,client,code,
          IF (CARD(request.intin(0)) & AESTYPES.UPDATE_WINDOW)<>0 THEN
            request.intin(1) ELSE INT(0) FI,painting)
      IF status=AESTYPES.OK THEN
        request.intout(0)=1
      FI

      RETURN(status)
    FI

    IF (CARD(request.intin(0)) & AESTYPES.TRY)<>0 THEN
      RETURN(AESTYPES.OK)
    FI

    RETURN(AESTYPES.PENDING)
  FI

  status=Release(service,client,code,painting)
  IF status=AESTYPES.OK THEN
    request.intout(0)=1
  FI

RETURN(status)

; Acquire only in the oldest currently eligible caller. The system Task wakes
; that caller without taking ownership or changing the BEGIN snapshot.
PUBLIC CARD FUNC Continue(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER waiting BYTE painting)
  BYTE position
  CARD code,status

  position=0
  WHILE position<service.lockCount DO
    BEGIN
      LET client=@service.clients(service.lockOrder(position))
      LET request=client.pending
      code=CARD(request.intin(0)) & $ff
      IF Eligible(service,client,code,OWNER_READY,
          AESWAIT.BeforeWindows(service,position))<>0 THEN
        IF client<>waiting THEN
          RETURN(AESTYPES.PENDING)
        FI
        status=Acquire(service,client,code,
            IF (CARD(request.intin(0)) & AESTYPES.UPDATE_WINDOW)<>0 THEN
              request.intin(1) ELSE INT(0) FI,painting)
        AESWAIT.RemoveLock(service,position)
        client.pending=NULL
        request.intout(0)=INT(status=AESTYPES.OK)
        RETURN(status)
      FI
      position==+1
    END
  OD

RETURN(AESTYPES.PENDING)

PUBLIC PROC Wake(AESSTATE.Service POINTER service)
  BYTE position

  position=0
  WHILE position<service.lockCount DO
    BEGIN
      LET client=@service.clients(service.lockOrder(position))
      LET code=CARD(client.pending.intin(0)) & $ff
      IF Eligible(service,client,code,OWNER_READY,
          AESWAIT.BeforeWindows(service,position))<>0 THEN
        AESWAIT.Signal(client)
        RETURN
      FI
      position==+1
    END
  OD

RETURN

ENDMODULE
