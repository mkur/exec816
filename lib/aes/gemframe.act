; MagiC AESWIN: _wbm_create, _minimal_size and _wbm_skind.
; Geometry is relative to O_FRAME. Hidden gadgets keep their standard IDs.
MODULE GEMFRAME
USE GEMOBJECTS

CONST NAME=1,CLOSER=2,FULLER=4,INFO=16,SIZER=32
CONST UP=64,DOWN=128,VSLIDE=256,LEFT=512,RIGHT=1024,HSLIDE=2048
CONST VERTICAL=448,HORIZONTAL=3584,ICONIFIER=16384,BORDERLESS=4096
CONST TOP=16391

BYTE ARRAY objectTypes=[25 27 22 27 27 22 27 27 27 20 20 27 27 20 20 27]
LONGCARD ARRAY objectSpecs=[$00011100 $05021100 0 $1f021100
    $07021100 0 $06021100 $01021100 $02021100 $00011111
    $00021100 $04021100 $03021100 $00011111 $00021100 $7f021100]

; objc_add's sibling/parent links, with -1 for an empty list.
PROC Add(GEMOBJECTS.Frame POINTER frame INT parent,child)

  LET root=@frame.tree(parent)
  IF root.tail=-1 THEN
    root.head=child
  ELSE
    frame.tree(root.tail).next=child
  FI
  root.tail=child
  frame.tree(child).next=parent

RETURN

; _minimal_size counts controls, including their shared one-pixel borders.
PROC Minimum(GEMOBJECTS.Frame POINTER frame CARD kind)
  INT width,height,title

  height=GEMOBJECTS.BOX_HEIGHT
  IF (kind & TOP)<>0 THEN
    height==+GEMOBJECTS.BOX_HEIGHT
  FI
  IF (kind & INFO)<>0 THEN
    height==+GEMOBJECTS.INFO_HEIGHT-1
  FI
  IF (kind & UP)<>0 THEN
    height==+GEMOBJECTS.BOX_HEIGHT
  FI
  IF (kind & DOWN)<>0 THEN
    height==+GEMOBJECTS.BOX_HEIGHT
  FI
  width=GEMOBJECTS.BOX_WIDTH
  IF (kind & LEFT)<>0 THEN
    width==+GEMOBJECTS.BOX_WIDTH
  FI
  IF (kind & RIGHT)<>0 THEN
    width==+GEMOBJECTS.BOX_WIDTH
  FI
  title=GEMOBJECTS.BOX_WIDTH+1
  IF (kind & CLOSER)<>0 THEN
    title==+GEMOBJECTS.BOX_WIDTH
  FI
  IF (kind & ICONIFIER)<>0 THEN
    title==+GEMOBJECTS.BOX_WIDTH
  FI
  IF (kind & 7)<>0 THEN
    title==+GEMOBJECTS.BOX_WIDTH
  FI
  frame.minWidth=IF title>width THEN title ELSE width FI
  frame.minHeight=height

RETURN

; Relink only at creation/kind changes, following _wbm_skind's control order.
PUBLIC PROC SetKind(GEMOBJECTS.Frame POINTER frame CARD kind)
  BYTE index

  Minimum(frame,kind)
  frame.tree(0).width=-1
  FOR index=0 TO GEMOBJECTS.OBJECTS-1 DO
    frame.tree(index).next=-1
    frame.tree(index).head=-1
    frame.tree(index).tail=-1
  OD
  frame.tree(GEMOBJECTS.O_NAME).x=0
  frame.tree(GEMOBJECTS.O_INFO).y=0
  frame.tree(GEMOBJECTS.O_UP).y=0
  IF (kind & BORDERLESS)<>0 THEN
    frame.minWidth=1
    frame.minHeight=1
    RETURN
  FI
  IF (kind & TOP)<>0 THEN
    IF (kind & CLOSER)<>0 THEN
      frame.tree(GEMOBJECTS.O_NAME).x=GEMOBJECTS.BOX_WIDTH-1
      Add(frame,0,GEMOBJECTS.O_CLOSER)
    FI
    IF (kind & FULLER)<>0 THEN
      Add(frame,0,GEMOBJECTS.O_FULLER)
    FI
    IF (kind & ICONIFIER)<>0 THEN
      Add(frame,0,GEMOBJECTS.O_ICONIFIER)
    FI
    ; MagiC's configured explicit backdrop control is disabled in this port.
    Add(frame,0,GEMOBJECTS.O_NAME)
    frame.tree(GEMOBJECTS.O_INFO).y=GEMOBJECTS.BOX_HEIGHT-1
    frame.tree(GEMOBJECTS.O_UP).y=GEMOBJECTS.BOX_HEIGHT-1
  FI
  IF (kind & INFO)<>0 THEN
    Add(frame,0,GEMOBJECTS.O_INFO)
    frame.tree(GEMOBJECTS.O_UP).y==+GEMOBJECTS.INFO_HEIGHT
  FI
  IF (kind & VERTICAL)<>0 OR ((kind & SIZER)<>0
      AND (kind & HORIZONTAL)=0) THEN
    IF (kind & UP)<>0 THEN
      Add(frame,0,GEMOBJECTS.O_UP)
    FI
    IF (kind & DOWN)<>0 THEN
      Add(frame,0,GEMOBJECTS.O_DOWN)
    FI
    Add(frame,0,GEMOBJECTS.O_VSCROLL)
    IF (kind & VSLIDE)<>0 THEN
      Add(frame,GEMOBJECTS.O_VSCROLL,GEMOBJECTS.O_VSLIDE)
    FI
  FI
  IF (kind & HORIZONTAL)<>0 THEN
    IF (kind & LEFT)<>0 THEN
      Add(frame,0,GEMOBJECTS.O_LEFT)
    FI
    IF (kind & RIGHT)<>0 THEN
      Add(frame,0,GEMOBJECTS.O_RIGHT)
    FI
    Add(frame,0,GEMOBJECTS.O_HSCROLL)
    IF (kind & HSLIDE)<>0 THEN
      Add(frame,GEMOBJECTS.O_HSCROLL,GEMOBJECTS.O_HSLIDE)
    FI
  FI
  IF (kind & SIZER)<>0 OR ((kind & VERTICAL)<>0
      AND (kind & HORIZONTAL)<>0) THEN
    Add(frame,0,GEMOBJECTS.O_SIZER)
    frame.tree(GEMOBJECTS.O_SIZER).spec=IF (kind & SIZER)<>0
        THEN LONGCARD($06021100) ELSE LONGCARD($00021100) FI
  FI

RETURN

; _wbm_calc: the four values are inset amounts, not a rectangle.
PUBLIC PROC Margins(CARD kind GEMOBJECTS.Rect POINTER out)

  out.x=1
  out.y=1
  out.width=1
  out.height=1
  IF (kind & BORDERLESS)<>0 THEN
    out.x=0
    out.y=0
    out.width=0
    out.height=0
    RETURN
  FI
  IF (kind & TOP)<>0 THEN
    out.y==+GEMOBJECTS.BOX_HEIGHT-1
  FI
  IF (kind & INFO)<>0 THEN
    out.y==+GEMOBJECTS.INFO_HEIGHT-1
  FI
  IF (kind & VERTICAL)<>0 OR ((kind & SIZER)<>0
      AND (kind & HORIZONTAL)=0) THEN
    out.width==+GEMOBJECTS.BOX_WIDTH-1
  FI
  IF (kind & HORIZONTAL)<>0 THEN
    out.height==+GEMOBJECTS.BOX_HEIGHT-1
  FI

RETURN

; _wind_calc accepts signed pure geometry, independent of screen admission.
PUBLIC PROC Calc(BYTE work CARD kind GEMOBJECTS.Rect POINTER input,out)
  GEMOBJECTS.Rect inset

  Margins(kind,@inset)
  IF work<>0 THEN
    out.x=input.x+inset.x
    out.y=input.y+inset.y
    out.width=input.width-inset.x-inset.width
    out.height=input.height-inset.y-inset.height
  ELSE
    out.x=input.x-inset.x
    out.y=input.y-inset.y
    out.width=input.width+inset.x+inset.width
    out.height=input.height+inset.y+inset.height
  FI

RETURN

; __sslid: signed DIVS truncation followed by MagiC's signed rounding.
PUBLIC INT FUNC Scale(INT length,value)
  LONGINT doubled

  doubled=(LONGINT(length)*2*LONGINT(value))/1000
  IF doubled<0 THEN
    RETURN(INT(-((-doubled+2)/2)))
  FI

RETURN(INT((doubled+1)/2))

PUBLIC INT FUNC Normalize(INT value)

  IF value<0 THEN
    RETURN(-1)
  FI
  IF value>1000 THEN
    RETURN(1000)
  FI

RETURN(value)

; _wbm_sslid changes only the chosen stored track/thumb pair.
PUBLIC PROC Slide(GEMOBJECTS.Frame POINTER frame BYTE vertical)
  INT length,minimum,size,position,thumb,offset

  IF vertical<>0 THEN
    length=frame.tree(GEMOBJECTS.O_VSCROLL).height
    minimum=GEMOBJECTS.BOX_HEIGHT
    size=frame.vsize
    position=frame.vslide
  ELSE
    length=frame.tree(GEMOBJECTS.O_HSCROLL).width
    minimum=GEMOBJECTS.BOX_WIDTH
    size=frame.hsize
    position=frame.hslide
  FI
  IF length<minimum THEN
    minimum=IF length<0 THEN INT(0) ELSE length FI
  FI
  thumb=minimum
  IF size<>-1 THEN
    BEGIN
      LET scaled=Scale(length,size)
      IF scaled>thumb THEN
        thumb=scaled
      FI
    END
  FI
  offset=Scale(position,length-thumb)
  IF vertical<>0 THEN
    frame.tree(GEMOBJECTS.O_VSLIDE).height=thumb
    frame.tree(GEMOBJECTS.O_VSLIDE).y=offset
  ELSE
    frame.tree(GEMOBJECTS.O_HSLIDE).width=thumb
    frame.tree(GEMOBJECTS.O_HSLIDE).x=offset
  FI

RETURN

; _wbm_ssize: only a dimension/kind change visits the relative gadgets.
PUBLIC PROC SetSize(GEMOBJECTS.Frame POINTER frame CARD kind
    INT x,y,width,height)
  INT length,origin,right,bottom

  frame.previous.x=frame.current.x
  frame.previous.y=frame.current.y
  frame.previous.width=frame.current.width
  frame.previous.height=frame.current.height
  frame.current.x=x
  frame.current.y=y
  frame.current.width=width
  frame.current.height=height
  frame.overall.x=x
  frame.overall.y=y
  frame.overall.width=width
  frame.overall.height=height
  IF (kind & BORDERLESS)=0 THEN
    frame.overall.width==+GEMOBJECTS.SHADOW
    frame.overall.height==+GEMOBJECTS.SHADOW
  FI
  Calc(1,kind,@frame.current,@frame.work)
  frame.tree(0).x=x
  frame.tree(0).y=y
  IF frame.tree(0).width=width AND frame.tree(0).height=height THEN
    RETURN
  FI
  frame.tree(0).width=width
  frame.tree(0).height=height
  right=width-GEMOBJECTS.BOX_WIDTH
  frame.tree(GEMOBJECTS.O_BDROP).x=right
  frame.tree(GEMOBJECTS.O_FULLER).x=right
  frame.tree(GEMOBJECTS.O_ICONIFIER).x=right
  frame.tree(GEMOBJECTS.O_SIZER).x=right
  frame.tree(GEMOBJECTS.O_UP).x=right
  frame.tree(GEMOBJECTS.O_DOWN).x=right
  frame.tree(GEMOBJECTS.O_VSCROLL).x=right
  bottom=height-GEMOBJECTS.BOX_HEIGHT
  frame.tree(GEMOBJECTS.O_SIZER).y=bottom
  frame.tree(GEMOBJECTS.O_LEFT).y=bottom
  frame.tree(GEMOBJECTS.O_RIGHT).y=bottom
  frame.tree(GEMOBJECTS.O_HSCROLL).y=bottom
  frame.tree(GEMOBJECTS.O_NAME).width=width
  frame.tree(GEMOBJECTS.O_INFO).width=width
  IF (kind & CLOSER)<>0 THEN
    frame.tree(GEMOBJECTS.O_NAME).width==-(GEMOBJECTS.BOX_WIDTH-1)
  FI
  IF (kind & FULLER)<>0 THEN
    frame.tree(GEMOBJECTS.O_BDROP).x==-(GEMOBJECTS.BOX_WIDTH-1)
    frame.tree(GEMOBJECTS.O_ICONIFIER).x==-(GEMOBJECTS.BOX_WIDTH-1)
    frame.tree(GEMOBJECTS.O_NAME).width==-(GEMOBJECTS.BOX_WIDTH-1)
  FI
  IF (kind & ICONIFIER)<>0 THEN
    frame.tree(GEMOBJECTS.O_BDROP).x==-(GEMOBJECTS.BOX_WIDTH-1)
    frame.tree(GEMOBJECTS.O_NAME).width==-(GEMOBJECTS.BOX_WIDTH-1)
  FI
  IF (kind & VERTICAL)<>0 OR ((kind & SIZER)<>0
      AND (kind & HORIZONTAL)=0) THEN
    origin=frame.work.y-y-1
    length=frame.work.height+2
    IF (kind & UP)<>0 THEN
      frame.tree(GEMOBJECTS.O_UP).y=origin
      origin==+GEMOBJECTS.BOX_HEIGHT-1
      length==-(GEMOBJECTS.BOX_HEIGHT-1)
    FI
    IF (kind & DOWN)<>0 THEN
      length==-(GEMOBJECTS.BOX_HEIGHT-1)
    FI
    IF (kind & HORIZONTAL)=0 AND (kind & SIZER)<>0 THEN
      length==-(GEMOBJECTS.BOX_HEIGHT-1)
    FI
    frame.tree(GEMOBJECTS.O_VSCROLL).y=origin
    frame.tree(GEMOBJECTS.O_VSCROLL).height=length
    frame.tree(GEMOBJECTS.O_DOWN).y=origin+length-1
    Slide(frame,1)
  FI
  IF (kind & HORIZONTAL)<>0 THEN
    origin=0
    length=frame.work.width+2
    IF (kind & LEFT)<>0 THEN
      frame.tree(GEMOBJECTS.O_LEFT).x=0
      origin==+GEMOBJECTS.BOX_WIDTH-1
      length==-(GEMOBJECTS.BOX_WIDTH-1)
    FI
    IF (kind & RIGHT)<>0 THEN
      length==-(GEMOBJECTS.BOX_WIDTH-1)
    FI
    frame.tree(GEMOBJECTS.O_HSCROLL).x=origin
    frame.tree(GEMOBJECTS.O_HSCROLL).width=length
    frame.tree(GEMOBJECTS.O_RIGHT).x=origin+length-1
    Slide(frame,0)
  FI

RETURN

; The containing Window owns the text bytes and both inline TEDINFOs.
PUBLIC PROC Create(GEMOBJECTS.Frame POINTER frame CARD kind
    BYTE POINTER title,info)
  BYTE index

  FOR index=0 TO GEMOBJECTS.OBJECTS-1 DO
    frame.tree(index).kind=objectTypes(index)
    frame.tree(index).spec=objectSpecs(index)
    frame.tree(index).width=GEMOBJECTS.BOX_WIDTH
    frame.tree(index).height=GEMOBJECTS.BOX_HEIGHT
  OD
  frame.tree(0).state=32
  frame.tree(GEMOBJECTS.O_INFO).height=GEMOBJECTS.INFO_HEIGHT
  FOR index=0 TO 1 DO
    frame.texts(index).font=3
    frame.texts(index).color=$1100
    frame.texts(index).thickness=1
  OD
  frame.texts(0).justify=2
  frame.texts(0).text=LONGCARD(ADDRESS(title))
  frame.texts(1).text=LONGCARD(ADDRESS(info))
  frame.tree(GEMOBJECTS.O_NAME).spec=LONGCARD(ADDRESS(@frame.texts(0)))
  frame.tree(GEMOBJECTS.O_INFO).spec=LONGCARD(ADDRESS(@frame.texts(1)))
  frame.hsize=-1
  frame.vsize=-1
  SetKind(frame,kind)

RETURN
ENDMODULE
