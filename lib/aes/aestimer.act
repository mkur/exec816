; Presenter-owned timer transport. Device records are reused only after GetMsg.
MODULE AESTIMER
USE EXEC
USE TIMER
USE AESSTATE
USE AESTYPES
USE EXECLISTS
USE HEAPCORE

PUBLIC BYTE FUNC Idle(AESSTATE.Service POINTER service)

  LET state=@service.timer

RETURN(state.state=AESSTATE.ALARM_IDLE AND (state.port=NULL
    OR EXECLISTS.IsListEmpty(@state.port.mp_MsgList)<>0))

PUBLIC BYTE FUNC Close(AESSTATE.Service POINTER service)

  LET state=@service.timer
  IF Idle(service)=0 THEN
    RETURN(0)
  FI

  IF state.alarm<>NULL THEN
    state.alarm.tc_Request.io_Device=NULL
    state.alarm.tc_Request.io_Unit=NULL
    EXEC.DeleteIORequest(@state.alarm.tc_Request)
    state.alarm=NULL
  FI

  IF state.query<>NULL THEN
    IF state.opened<>0 THEN
      EXEC.CloseDevice(@state.query.tc_Request)
      state.opened=0
    FI

    EXEC.DeleteIORequest(@state.query.tc_Request)
    state.query=NULL
  FI

  IF state.port<>NULL THEN
    EXEC.DeleteMsgPort(state.port)
    state.port=NULL
  FI

  state.mask=0

RETURN(1)

PUBLIC BYTE FUNC Read(AESSTATE.Service POINTER service)

  LET state=@service.timer
  IF state.opened=0 OR state.error<>0 THEN
    RETURN(0)
  FI

  state.query.tc_Request.io_Command=TIMER.TD_READCLOCK
  IF EXEC.DoIO(@state.query.tc_Request)<>0 THEN
    state.error=AESTYPES.TIMER_ERROR
    RETURN(0)
  FI

  IF state.query.ticks_per_second<>50 AND state.query.ticks_per_second<>60 THEN
    state.error=AESTYPES.TIMER_ERROR
    RETURN(0)
  FI

  state.nowHigh=state.query.ticks_hi
  state.nowLow=state.query.ticks_lo
  state.rate=state.query.ticks_per_second

RETURN(1)

PUBLIC BYTE FUNC Start(AESSTATE.Service POINTER service)

  LET state=@service.timer
  state.port=EXEC.CreateMsgPort()
  IF state.port<>NULL THEN
    state.query=TIMER.TimerClockRequest POINTER(EXEC.CreateIORequest(
        state.port,SIZEOF(TIMER.TimerClockRequest)))
    IF state.query<>NULL THEN
      state.alarm=TIMER.TimerClockRequest POINTER(EXEC.CreateIORequest(
          state.port,SIZEOF(TIMER.TimerClockRequest)))
      IF state.alarm<>NULL THEN
        IF EXEC.OpenDevice(BYTE POINTER(c"timer.device"),TIMER.UNIT_VBLANK,
            @state.query.tc_Request,0)=0 THEN
          state.opened=1
          state.alarm.tc_Request.io_Device=state.query.tc_Request.io_Device
          state.alarm.tc_Request.io_Unit=state.query.tc_Request.io_Unit
          IF Read(service)<>0 THEN
            state.mask=LONGCARD(1) LSH state.port.mp_SigBit
            RETURN(1)
          FI
        FI
      FI
    FI
  FI

  state.error=AESTYPES.TIMER_ERROR
  IF Close(service)=0 THEN
    HEAPCORE.Abort($fca3)
  FI

RETURN(0)

; Queue removal is the ownership transfer. CheckIO alone cannot reuse a record.
PUBLIC PROC Collect(AESSTATE.Service POINTER service)

  LET state=@service.timer
  IF state.port=NULL THEN
    RETURN
  FI

  LET message=EXEC.GetMsg(state.port)
  IF message=NULL THEN
    RETURN
  FI

  IF state.alarm=NULL OR message<>@state.alarm.tc_Request.io_Message
      OR state.state=AESSTATE.ALARM_IDLE THEN
    ; A dedicated private I/O port cannot legitimately contain other traffic.
    HEAPCORE.Abort($fca4)
  FI

  LET error=state.alarm.tc_Request.io_Error
  IF error<>0 AND (error<>BYTE(EXEC.IOERR_ABORTED)
      OR state.state<>AESSTATE.ALARM_RETIRING) THEN
    state.error=AESTYPES.TIMER_ERROR
  FI

  state.state=AESSTATE.ALARM_IDLE

RETURN

PUBLIC BYTE FUNC Runnable(AESSTATE.Service POINTER service)

  LET state=@service.timer

RETURN(state.port<>NULL AND EXECLISTS.IsListEmpty(@state.port.mp_MsgList)=0)

; One target for all clients. Recompute the earliest live deadline before each
; call; a retiring submission never stores a replacement relative duration.
PUBLIC PROC Target(AESSTATE.Service POINTER service BYTE wanted
    LONGCARD high,low)

  LET state=@service.timer
  Collect(service)
  IF state.error<>0 THEN
    wanted=0
  FI

  IF state.state=AESSTATE.ALARM_OUTSTANDING THEN
    IF wanted<>0 AND high=state.targetHigh AND low=state.targetLow THEN
      RETURN
    FI

    ; Mark retiring before CheckIO/AbortIO: expiry can win either boundary.
    state.state=AESSTATE.ALARM_RETIRING
    IF EXEC.CheckIO(@state.alarm.tc_Request)=NULL THEN
      EXEC.AbortIO(@state.alarm.tc_Request)
    FI
  FI

  Collect(service)
  IF state.state<>AESSTATE.ALARM_IDLE OR wanted=0 OR state.error<>0 THEN
    RETURN
  FI

  IF state.opened=0 THEN
    state.error=AESTYPES.TIMER_ERROR
    RETURN
  FI

  state.alarm.tc_Request.io_Command=TIMER.TD_WAITUNTIL
  state.alarm.ticks_hi=high
  state.alarm.ticks_lo=low
  state.targetHigh=high
  state.targetLow=low
  state.state=AESSTATE.ALARM_OUTSTANDING
  EXEC.SendIO(@state.alarm.tc_Request)

RETURN

ENDMODULE
