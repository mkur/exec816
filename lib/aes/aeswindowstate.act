; Presenter-owned window publication and GUI facts, without window mutation.
MODULE AESWINDOWSTATE
USE EXEC
USE AESTYPES
USE AESSTATE
USE AESGUI
USE DESKTYPES
USE DESKSTATE
USE LAYERTYPES
USE LAYERS
USE REGIONS
USE DESKGEOMETRY
USE DESKCACHE
USE A816MEMORY
USE HEAPCORE

PUBLIC AESSTATE.Window POINTER FUNC FindRecord(LONGCARD id)
  BYTE index

  LET service=AESSTATE.Get()
  IF service=NULL OR id=0 THEN
    RETURN(NULL)
  FI
  FOR index=0 TO AESTYPES.WINDOWS-1 DO
    IF service.windows(index).owner<>0 THEN
      IF service.windows(index).window.id=id THEN
        RETURN(@service.windows(index))
      FI
    FI
  OD

RETURN(NULL)

PUBLIC AESSTATE.Window POINTER FUNC Handle(AESSTATE.Client POINTER client INT handle)
  BYTE index

  LET service=AESSTATE.Get()
  FOR index=0 TO AESTYPES.WINDOWS-1 DO
    IF service.windows(index).owner=client.id
        AND service.windows(index).gui.window=handle THEN
      RETURN(@service.windows(index))
    FI
  OD

RETURN(NULL)

PUBLIC AESSTATE.Client POINTER FUNC Find(LONGCARD id)

  LET item=FindRecord(id)
  IF item=NULL THEN
    RETURN(NULL)
  FI

RETURN(AESSTATE.Find(AESSTATE.Get(),item.owner))

; Called at lock grant and after an owner mutation. The caller cannot execute
; a query until its RPC reply; no Forbid spans construction of this region.
PUBLIC PROC Snapshot(AESSTATE.Window POINTER client)
  LAYERTYPES.Rect work
  BYTE status

  IF client.window=NULL THEN
    RETURN
  FI

  LET desktop=DESKSTATE.Get()
  LET layer=LAYERS.Find(@desktop.scene,client.window.layer)
  LET view=client.view
  DESKGEOMETRY.Work(client.window.frameKind,@layer.bounds,@work)
  IF REGIONS.Equal(@layer.bounds,
      LAYERTYPES.Rect POINTER(@view.bounds))=0 THEN
    IF layer.bounds.right-layer.bounds.left<>view.bounds.right-view.bounds.left
        OR layer.bounds.bottom-layer.bounds.top<>view.bounds.bottom-view.bounds.top THEN
      DESKCACHE.Changed(desktop,client.window)
    FI
    LAYERS.ExternalArea(@desktop.scene,layer.id,@work)
  FI
  status=REGIONS.Clip(@layer.visible,@work,
      LAYERTYPES.Region POINTER(@view.visibleCount))
  IF status<>LAYERTYPES.OK THEN
    HEAPCORE.Abort($fcb3)
  FI

  EXEC.Forbid()
  A816MEMORY.Move(BYTE POINTER(@view.bounds),BYTE POINTER(@layer.bounds),8)
  A816MEMORY.Move(BYTE POINTER(@view.work),BYTE POINTER(@work),8)
  view.shown=layer.shown
  view.paintEpoch=layer.paintEpoch
  view.revision==+1
  EXEC.Permit()

RETURN

PUBLIC PROC SnapshotAll(AESSTATE.Client POINTER client)
  BYTE index

  LET service=AESSTATE.Get()
  FOR index=0 TO AESTYPES.WINDOWS-1 DO
    IF service.windows(index).owner=client.id THEN
      Snapshot(@service.windows(index))
    FI
  OD

RETURN

; Invalidate cached images even when an update has no visible drawing calls.
PUBLIC PROC BeginUpdate(AESSTATE.Client POINTER client)
  BYTE index

  LET service=AESSTATE.Get()
  LET desktop=DESKSTATE.Get()
  client.binding.paintCount=0
  client.binding.paintFailed=0
  FOR index=0 TO AESTYPES.WINDOWS-1 DO
    IF service.windows(index).owner=client.id THEN
      BEGIN
        LET window=service.windows(index).window
        service.windows(index).view.changed=0
        LAYERS.Touch(@desktop.scene,window.layer)
        DESKCACHE.Changed(desktop,window)
      END
    FI
  OD
  SnapshotAll(client)

RETURN

; Caller reports are frozen by the outstanding END reply. No scene token is
; held while the client draws; only this owner consumes and applies its journal.
PUBLIC PROC EndUpdate(AESSTATE.Client POINTER client)
  BYTE index,report,same,accepted

  LET service=AESSTATE.Get()
  LET desktop=DESKSTATE.Get()
  LET request=client.binding
  FOR index=0 TO AESTYPES.WINDOWS-1 DO
    IF service.windows(index).owner=client.id THEN
      BEGIN
        LET item=@service.windows(index)
        LET view=item.view
        LET layer=LAYERS.Find(@desktop.scene,item.window.layer)
        same=(view.paintEpoch=layer.paintEpoch)
        IF view.changed<>0 THEN
          LAYERS.RequirePaint(@desktop.scene,layer.id,
              LAYERTYPES.Rect POINTER(@view.change))
        ELSE
          ; An unreported model change must not become a new idle capture of
          ; the old pixels. Explicit completion reports may still retire it.
          LAYERS.RequirePaint(@desktop.scene,layer.id,
              LAYERTYPES.Rect POINTER(@view.work))
        FI
        report=0
        WHILE same<>0 AND request.paintFailed=0
            AND report<request.paintCount DO
          BEGIN
            LET paint=@request.paints(report)
            IF paint.handle=view.handle AND paint.epoch=view.paintEpoch THEN
              accepted=LAYERS.Painted(@desktop.scene,layer.id,layer.paintEpoch,
                  LAYERTYPES.Rect POINTER(@paint.rect))
            FI
          END
          report==+1
        OD
        view.changed=0
      END
    FI
  OD
  request.paintCount=0

RETURN

PUBLIC PROC Updates(AESSTATE.Client POINTER client CARD count)
  BYTE index

  LET service=AESSTATE.Get()
  FOR index=0 TO AESTYPES.WINDOWS-1 DO
    IF service.windows(index).owner=client.id THEN
      service.windows(index).view.updates=count
    FI
  OD

RETURN

PUBLIC LONGCARD FUNC FindWindow(LONGCARD layerId)
  BYTE slot

  LET desktop=DESKSTATE.Get()
  FOR slot=0 TO DESKTYPES.WINDOWS-1 DO
    IF desktop.windows(slot).id<>0 AND desktop.windows(slot).layer=layerId THEN
      RETURN(desktop.windows(slot).id)
    FI
  OD

RETURN(0)

; Basic top identity is a coherent single word, shared by all caller bindings.
PUBLIC PROC Sync()
  BYTE slot
  INT top

  LET service=AESSTATE.Get()
  LET desktop=DESKSTATE.Get()
  IF service=NULL OR desktop=NULL OR desktop.scene.busy<>0 THEN
    RETURN
  FI

  IF service.windowRevision=desktop.scene.rebuilds
      AND service.windowFocus=desktop.focus THEN
    RETURN
  FI

  top=0
  slot=0
  WHILE slot<desktop.scene.count DO
    BEGIN
      LET layer=@desktop.scene.items(desktop.scene.order(slot))
      IF layer.shown<>0 AND FindWindow(layer.id)<>0 THEN
        BEGIN
          LET client=FindRecord(IF layer.externalPaint<>0 THEN
              FindWindow(layer.id) ELSE LONGCARD(0) FI)
          IF client<>NULL THEN
            top=client.gui.window
          FI
        END
        EXIT
      FI
    END
    slot==+1
  OD

  service.directory.topWindow=top
  service.windowRevision=desktop.scene.rebuilds
  service.windowFocus=desktop.focus

RETURN

PUBLIC PROC Control(DESKTYPES.Window POINTER window BYTE kind
    INT x,y,width,height)

  LET client=FindRecord(window.id)
  IF client<>NULL THEN
    AESGUI.Post(AESSTATE.Get(),client,kind,x,y,width,height)
  FI

RETURN

; Accumulate work while the frame transaction is active. Publication happens
; once its last strip finishes, so an initial draw is not one message per strip.
PUBLIC PROC Damage(DESKTYPES.Window POINTER window LAYERTYPES.Rect POINTER area)

  IF REGIONS.Empty(area)<>0 THEN
    RETURN
  FI

  LET desktop=DESKSTATE.Get()
  LAYERS.RequirePaint(@desktop.scene,window.layer,area)

  LET client=FindRecord(window.id)
  IF client.paintDirty=0 THEN
    REGIONS.Copy(area,@client.paintDamage)
    client.paintDirty=1
    RETURN
  FI

  LET dirty=@client.paintDamage
  IF area.left<dirty.left THEN
    dirty.left=area.left
  FI

  IF area.top<dirty.top THEN
    dirty.top=area.top
  FI

  IF area.right>dirty.right THEN
    dirty.right=area.right
  FI

  IF area.bottom>dirty.bottom THEN
    dirty.bottom=area.bottom
  FI

RETURN

PUBLIC PROC Handoff(DESKTYPES.Window POINTER window)

  LET client=FindRecord(window.id)
  IF client.paintDirty<>0 THEN
    BEGIN
      LET area=@client.paintDamage
      AESGUI.Post(AESSTATE.Get(),client,AESTYPES.GUI_REDRAW,
          area.left,area.top,area.right-area.left,area.bottom-area.top)
    END
    client.paintDirty=0
  FI

RETURN

ENDMODULE
