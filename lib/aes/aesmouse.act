; Presenter input routing; callers may cancel a withdrawn window's capture.
MODULE AESMOUSE
USE EXEC
USE INPUT
USE A816MEMORY
USE AESTYPES
USE AESSTATE
USE AESSNAPSHOT
USE AESINBOX
USE AESKEYS
USE DESKTYPES
USE DESKGEOMETRY

CONST NATIVE=1, TITLE=2
LONGCARD owner,openEpoch,ownerWindow
AESTYPES.InputRecord latest
BYTE manager,needRelease,nativePending
LONGCARD clickOwner,clickEpoch
CARD clickTick
INT clickX,clickY
BYTE clickCount
AESSNAPSHOT.WindowRoute capturedRoute

PUBLIC PROC Reset()

  AESSTATE.mouseDirty=1
  owner=0
  openEpoch=0
  clickCount=0
  manager=0
  nativePending=0
  needRelease=1
  latest.x=320
  latest.y=120
  latest.buttons=0
  latest.qualifiers=0

RETURN

; A lock cannot transfer a physical sequence. Released deferred native work
; is not ownership: an update owner must still be able to upgrade or unlock.
PUBLIC BYTE FUNC LockReady(LONGCARD client)
  BYTE ready

  EXEC.Forbid()
  ready=(latest.buttons=0 OR (owner=client AND owner<>0))
  EXEC.Permit()

RETURN(ready)

; Work capture routes input independently of another client's short painting
; scope. Unreleased native gestures and release-rearm still exclude admission.
PUBLIC BYTE FUNC UpdateReady(LONGCARD client)
  BYTE ready

  EXEC.Forbid()
  ready=(LockReady(client)<>0 OR (owner<>0 AND needRelease=0 AND manager=0))
  EXEC.Permit()

RETURN(ready)

; Presenter-only access for a visual attached to the existing physical capture.
PUBLIC BYTE FUNC DragReady(LONGCARD client,epoch)

RETURN(owner=client AND owner<>0 AND openEpoch=epoch
    AND latest.buttons<>0 AND needRelease=0)

PUBLIC AESTYPES.InputRecord POINTER FUNC PointerSample()

RETURN(@latest)

PUBLIC PROC Cancel(LONGCARD client)

  AESSTATE.mouseDirty=1

  IF clickOwner=client THEN
    clickCount=0
  FI

  IF owner=client AND owner<>0 THEN
    owner=0
    openEpoch=0
    needRelease=1
  FI

RETURN

PUBLIC PROC CancelWindow(LONGCARD epoch)

  EXEC.Forbid()
  AESSTATE.mouseDirty=1

  IF epoch<>0 AND clickEpoch=epoch THEN
    clickCount=0
  FI
  IF epoch<>0 AND openEpoch=epoch THEN
    owner=0
    ownerWindow=0
    openEpoch=0
    needRelease=1
  FI
  EXEC.Permit()

RETURN

PUBLIC BYTE FUNC NativeGesture()

RETURN(manager=TITLE OR nativePending=TITLE)

PUBLIC PROC Retained()

  IF manager<>0 THEN
    IF manager=TITLE OR nativePending=0 THEN
      IF nativePending<>manager THEN
        AESSTATE.mouseDirty=1
        nativePending=manager
      FI
    FI
  FI

RETURN

PUBLIC PROC RefreshSnapshot()
  BYTE index,selected
  CARD eligible
  AESSNAPSHOT.WindowRoute route
  AESTYPES.InputRecord snapshot

  FOR index=0 TO AESTYPES.CLIENTS-1 DO
    ; Selection, latest sample and inbox publication form one bounded read.
    ; A caller can refresh lock eligibility without overwriting newer capture.
    EXEC.Forbid()
    IF AESSNAPSHOT.Default(index,@route)<>0 THEN
      BEGIN
        IF owner=route.client AND owner<>0 THEN
          AESSNAPSHOT.Drop(route.endpoint)
          route.endpoint=NULL
          selected=AESSNAPSHOT.Select(AESSNAPSHOT.WINDOW_ID,ownerWindow,0,0,@route)
        FI
        IF route.endpoint<>NULL THEN
          A816MEMORY.Move(BYTE POINTER(@snapshot),BYTE POINTER(@latest),
              AESTYPES.INPUTRECORD_SIZE)
          snapshot.window=route.handle
          snapshot.windowEpoch=route.epoch
          eligible=(route.epoch<>0 AND needRelease=0 AND manager=0
              AND nativePending=0)
          IF owner<>0 THEN
            eligible=eligible AND owner=route.client
          ELSE
            eligible=eligible AND AESSNAPSHOT.Eligible(route.client,latest.buttons)
          FI
          AESINBOX.SnapshotEndpoint(route.endpoint,@snapshot,eligible)
          AESSNAPSHOT.Drop(route.endpoint)
        FI
      END
    FI
    EXEC.Permit()
  OD

RETURN

; Scene changes publish routing before refreshing caller-owned inboxes. Input
; capture uses RefreshSnapshot alone and never reads the mutable window table.
PUBLIC PROC Refresh()

  LET service=AESSTATE.Get()
  IF service=NULL OR service.live=0 THEN
    RETURN
  FI
  EXEC.Forbid()
  IF service.pointerCount=0 AND nativePending<>0 THEN
    nativePending=0
    AESSTATE.mouseDirty=1
  FI
  EXEC.Permit()
  LET changed=AESSNAPSHOT.Publish()
  IF changed=0 AND AESSTATE.mouseDirty=0 THEN
    RETURN
  FI
  AESSTATE.mouseDirty=0
  RefreshSnapshot()

RETURN

PUBLIC PROC Lost()
  BYTE index
  AESSNAPSHOT.WindowRoute route

  AESSTATE.mouseDirty=1
  owner=0
  openEpoch=0
  clickCount=0
  manager=0
  needRelease=1
  FOR index=0 TO AESTYPES.CLIENTS-1 DO
    IF AESSNAPSHOT.Default(index,@route)<>0 THEN
      AESINBOX.LostEndpoint(route.endpoint,AESTYPES.INPUT_BUTTON)
      AESSNAPSHOT.Drop(route.endpoint)
    FI
  OD

RETURN

BYTE FUNC Publish(AESTYPES.Endpoint POINTER endpoint INPUT.Event POINTER sample)

  RefreshSnapshot()
  IF sample.kind=INPUT.EVENT_BUTTON THEN
    IF AESINBOX.PublishEndpoint(endpoint,AESTYPES.INPUT_BUTTON,@latest)=0 THEN
      Cancel(owner)
      RETURN(0)
    FI
  FI

RETURN(1)

; Fresh normalized capture only. Return one for application/excluded sequences,
; zero for the native path, which may retain the sample under a GUI lock.
BYTE FUNC RouteSample(INPUT.Event POINTER sample)
  CARD previous
  BYTE accepted

  IF sample.kind=INPUT.EVENT_LOSS THEN
    Lost()
    RETURN(0)
  FI

  AESSTATE.mouseDirty=1
  EXEC.Forbid()
  previous=latest.buttons
  latest.x=sample.x
  latest.y=sample.y
  latest.buttons=sample.buttons & INPUT.LEFT
  IF sample.kind=INPUT.EVENT_BUTTON THEN
    latest.qualifiers=AESKEYS.Qualifiers(sample.qualifiers)
  FI
  EXEC.Permit()

  IF needRelease<>0 THEN
    IF latest.buttons=0 THEN
      needRelease=0
      manager=0
      RETURN(0)
    FI

    RETURN(1)
  FI

  IF owner<>0 THEN
    IF AESSNAPSHOT.Select(AESSNAPSHOT.WINDOW_ID,ownerWindow,0,0,@capturedRoute)=0
        OR capturedRoute.client<>owner OR capturedRoute.epoch<>openEpoch THEN
      owner=0
      openEpoch=0
      needRelease=latest.buttons<>0
      RETURN(1)
    FI

    accepted=Publish(capturedRoute.endpoint,sample)
    IF latest.buttons=0 THEN
      EXEC.Forbid()
      AESSTATE.mouseDirty=1
      owner=0
      openEpoch=0
      needRelease=0
      EXEC.Permit()
    FI
    RETURN(1)
  FI

  IF manager<>0 THEN
    IF latest.buttons=0 THEN
      manager=0
    FI

    RETURN(0)
  FI

  IF latest.buttons=0 THEN
    RETURN(0)
  FI

  ; An unpaired held baseline cannot start a new application gesture.
  IF previous<>0 OR sample.kind<>INPUT.EVENT_BUTTON THEN
    needRelease=1
    RETURN(1)
  FI

  accepted=0
  IF nativePending=0 THEN
    accepted=AESSNAPSHOT.Select(AESSNAPSHOT.POINTER_HIT,0,sample.x,sample.y,
        @capturedRoute)
    ; Windowless explicit MCTRL excludes input without creating native work.
    ; Its copied default has a client identity and no open window epoch.
    IF accepted<>0 AND capturedRoute.client<>0 AND capturedRoute.epoch=0 THEN
      needRelease=1
      RETURN(1)
    FI
  FI

  IF accepted<>0 AND capturedRoute.endpoint<>NULL
      AND capturedRoute.client<>0
      AND capturedRoute.epoch<>0 AND capturedRoute.iconified=0
      AND sample.x>=capturedRoute.work.left
      AND sample.x<capturedRoute.work.right
      AND sample.y>=capturedRoute.work.top
      AND sample.y<capturedRoute.work.bottom THEN
    EXEC.Forbid()
    owner=capturedRoute.client
    openEpoch=capturedRoute.epoch
    ownerWindow=capturedRoute.window
    latest.window=capturedRoute.handle
    latest.windowEpoch=openEpoch
    EXEC.Permit()
    ; Count at capture time, not after queue or repaint latency. First clicks
    ; remain immediate. The fixed 25-VBI interval is 500ms PAL / 417ms NTSC.
    IF clickCount=1 AND clickOwner=owner AND clickEpoch=openEpoch
        AND (sample.flags & INPUT.TICK_VALID)<>0
        AND CARD(sample.tick-clickTick)<=25
        AND sample.x>=clickX-4 AND sample.x<=clickX+4
        AND sample.y>=clickY-4 AND sample.y<=clickY+4 THEN
      latest.key=2
      clickCount=0
    ELSE
      latest.key=1
      clickCount=(sample.flags & INPUT.TICK_VALID)<>0
    FI
    clickOwner=owner
    clickEpoch=openEpoch
    clickTick=sample.tick
    clickX=sample.x
    clickY=sample.y
    accepted=Publish(capturedRoute.endpoint,sample)
    RETURN(1)
  FI

  clickCount=0
  manager=NATIVE
  IF capturedRoute.endpoint<>NULL AND capturedRoute.frameKind<>
      DESKTYPES.FRAME_BORDERLESS AND
      (DESKGEOMETRY.TitleHit(@capturedRoute.bounds,sample.x,sample.y)<>0
      OR DESKGEOMETRY.Gadget(capturedRoute.frameKind,
        capturedRoute.iconified,capturedRoute.sliderTop,
        capturedRoute.sliderHeight,@capturedRoute.bounds,sample.x,sample.y)<>0) THEN
    manager=TITLE
  FI

RETURN(0)

PUBLIC BYTE FUNC Route(INPUT.Event POINTER sample)

  ; One bounded sample cannot straddle caller cancellation. IRQ/NMI capture
  ; uses separate resident state; none of these helpers waits or draws.
  EXEC.Forbid()
  A816MEMORY.Clear(BYTE POINTER(@capturedRoute),SIZEOF(AESSNAPSHOT.WindowRoute))
  LET handled=RouteSample(sample)
  AESSNAPSHOT.Drop(capturedRoute.endpoint)
  EXEC.Permit()

RETURN(handled)
ENDMODULE
