; Presenter-only physical gesture ownership, independent of display borrowing.
MODULE AESMOUSE
USE INPUT
USE A816MEMORY
USE AESTYPES
USE AESSTATE
USE AESINBOX
USE AESKEYS
USE AESWINDOWSTATE
USE DESKSTATE
USE DESKTYPES
USE DESKGEOMETRY
USE LAYERS

CONST NATIVE=1, TITLE=2
LONGCARD owner,openEpoch,ownerWindow
AESTYPES.InputRecord latest
BYTE manager,needRelease,nativePending
LONGCARD clickOwner,clickEpoch
CARD clickTick
INT clickX,clickY
BYTE clickCount

PUBLIC PROC Reset()

  owner=0
  openEpoch=0
  clickCount=0
  manager=0
  nativePending=0
  needRelease=1
  latest.x=320
  latest.y=120
  latest.buttons=0
  latest.qualifiers=0

RETURN

; A lock cannot transfer a physical sequence. Released deferred native work
; is not ownership: an update owner must still be able to upgrade or unlock.
PUBLIC BYTE FUNC LockReady(LONGCARD client)

RETURN(latest.buttons=0 OR (owner=client AND owner<>0))

PUBLIC PROC Cancel(LONGCARD client)

  IF clickOwner=client THEN
    clickCount=0
  FI

  IF owner=client AND owner<>0 THEN
    owner=0
    openEpoch=0
    needRelease=1
  FI

RETURN

PUBLIC PROC CancelWindow(LONGCARD epoch)

  IF epoch<>0 AND clickEpoch=epoch THEN
    clickCount=0
  FI
  IF epoch<>0 AND openEpoch=epoch THEN
    owner=0
    ownerWindow=0
    openEpoch=0
    needRelease=1
  FI
RETURN

PUBLIC BYTE FUNC NativeGesture()

RETURN(manager=TITLE OR nativePending=TITLE)

PUBLIC PROC Retained()

  IF manager<>0 THEN
    IF manager=TITLE OR nativePending=0 THEN
      nativePending=manager
    FI
  FI

RETURN

PUBLIC PROC Refresh()
  BYTE index
  CARD eligible
  AESSTATE.Window POINTER item
  AESTYPES.InputRecord snapshot

  LET service=AESSTATE.Get()
  LET desktop=DESKSTATE.Get()
  IF service=NULL OR service.live=0 OR desktop=NULL THEN
    RETURN
  FI
  IF service.pointerCount=0 THEN
    nativePending=0
  FI
  FOR index=0 TO AESTYPES.CLIENTS-1 DO
    BEGIN
      LET client=@service.clients(index)
      IF client.id<>0 AND client.endpoint<>NULL THEN
        eligible=0
        item=NULL
        IF owner=client.id THEN
          item=AESWINDOWSTATE.FindRecord(ownerWindow)
        ELSEIF service.mouseHolds<>0 AND service.mouseOwner=client.id THEN
          IF client.binding.view<>NULL THEN
            item=AESWINDOWSTATE.Handle(client,client.binding.view.handle)
          FI
        ELSE
          item=AESWINDOWSTATE.FindRecord(desktop.focus)
          IF item<>NULL AND item.owner<>client.id THEN
            item=NULL
          FI
        FI
        A816MEMORY.Move(BYTE POINTER(@snapshot),BYTE POINTER(@latest),AESTYPES.INPUTRECORD_SIZE)
        snapshot.window=0
        snapshot.windowEpoch=0
        IF item<>NULL THEN
          snapshot.window=item.gui.window
          snapshot.windowEpoch=item.view.epoch
          IF item.view.epoch<>0 AND (client.endpoint.input.loss & AESTYPES.INPUT_BUTTON)=0
              AND needRelease=0 AND manager=0 AND nativePending=0
              AND DESKSTATE.menuActive=0 THEN
            IF owner<>0 THEN
              eligible=owner=client.id
            ELSEIF service.mouseHolds<>0 THEN
              eligible=service.mouseOwner=client.id
            ELSE
              eligible=latest.buttons=0
            FI
          FI
        FI
        AESINBOX.Snapshot(client,@snapshot,eligible)
      FI
    END
  OD
RETURN

PUBLIC PROC Lost()
  BYTE index

  LET service=AESSTATE.Get()
  owner=0
  openEpoch=0
  clickCount=0
  manager=0
  needRelease=1
  IF service<>NULL AND service.live<>0 THEN
    FOR index=0 TO AESTYPES.CLIENTS-1 DO
      IF service.clients(index).id<>0 THEN
        AESINBOX.Lost(@service.clients(index),AESTYPES.INPUT_BUTTON)
      FI
    OD
  FI

RETURN

BYTE FUNC Publish(AESSTATE.Client POINTER client INPUT.Event POINTER sample)

  Refresh()
  IF sample.kind=INPUT.EVENT_BUTTON THEN
    IF AESINBOX.Publish(client,AESTYPES.INPUT_BUTTON,@latest)=0 THEN
      Cancel(client.id)
      RETURN(0)
    FI
  FI

RETURN(1)

; Fresh normalized capture only. Return one for application/excluded sequences,
; zero for the native path, which may retain the sample under a GUI lock.
PUBLIC BYTE FUNC Route(INPUT.Event POINTER sample)
  CARD previous
  BYTE accepted
  AESSTATE.Client POINTER client
  AESSTATE.Window POINTER item

  IF sample.kind=INPUT.EVENT_LOSS THEN
    Lost()
    RETURN(0)
  FI

  previous=latest.buttons
  latest.x=sample.x
  latest.y=sample.y
  latest.buttons=sample.buttons & INPUT.LEFT
  IF sample.kind=INPUT.EVENT_BUTTON THEN
    latest.qualifiers=AESKEYS.Qualifiers(sample.qualifiers)
  FI

  IF needRelease<>0 THEN
    IF latest.buttons=0 THEN
      needRelease=0
      manager=0
      RETURN(0)
    FI

    RETURN(1)
  FI

  LET service=AESSTATE.Get()
  IF service=NULL OR service.live=0 THEN
    RETURN(0)
  FI

  IF owner<>0 THEN
    client=AESSTATE.Find(service,owner)
    item=AESWINDOWSTATE.FindRecord(ownerWindow)
    IF client=NULL OR item=NULL OR item.view.epoch<>openEpoch THEN
      owner=0
      openEpoch=0
      needRelease=latest.buttons<>0
      RETURN(1)
    FI

    accepted=Publish(client,sample)
    IF latest.buttons=0 THEN
      owner=0
      openEpoch=0
      needRelease=0
    FI

    RETURN(1)
  FI

  IF manager<>0 THEN
    IF latest.buttons=0 THEN
      manager=0
    FI

    RETURN(0)
  FI

  IF latest.buttons=0 THEN
    RETURN(0)
  FI

  ; An unpaired held baseline cannot start a new application gesture.
  IF previous<>0 OR sample.kind<>INPUT.EVENT_BUTTON THEN
    needRelease=1
    RETURN(1)
  FI

  client=NULL
  item=NULL
  LET desktop=DESKSTATE.Get()
  IF nativePending=0 AND DESKSTATE.menuActive=0 THEN
    IF service.mouseHolds<>0 THEN
      client=AESSTATE.Find(service,service.mouseOwner)
      IF client.binding.view<>NULL THEN
        item=AESWINDOWSTATE.Handle(client,client.binding.view.handle)
      FI
      IF item=NULL OR item.view.epoch=0 THEN
        needRelease=1
        RETURN(1)
      FI
    ELSE
      BEGIN
        LET layer=LAYERS.Hit(@desktop.scene,sample.x,sample.y)
        LET window=AESWINDOWSTATE.FindWindow(layer)
        IF desktop.focus=window AND window<>0 THEN
          item=AESWINDOWSTATE.FindRecord(window)
          client=AESWINDOWSTATE.Find(window)
          IF client<>NULL THEN
            BEGIN
              LET work=@item.view.work
              IF sample.x<work.left OR sample.x>=work.right
                  OR sample.y<work.top OR sample.y>=work.bottom THEN
                client=NULL
              FI
            END
          FI
        FI
      END
    FI
  FI

  IF client<>NULL AND client.endpoint.input.windowEpoch<>0 THEN
    owner=client.id
    openEpoch=item.view.epoch
    ownerWindow=item.window.id
    latest.window=item.gui.window
    latest.windowEpoch=openEpoch
    ; Count at capture time, not after queue or repaint latency. First clicks
    ; remain immediate. The fixed 25-VBI interval is 500ms PAL / 417ms NTSC.
    IF clickCount=1 AND clickOwner=owner AND clickEpoch=openEpoch
        AND (sample.flags & INPUT.TICK_VALID)<>0
        AND CARD(sample.tick-clickTick)<=25
        AND sample.x>=clickX-4 AND sample.x<=clickX+4
        AND sample.y>=clickY-4 AND sample.y<=clickY+4 THEN
      latest.key=2
      clickCount=0
    ELSE
      latest.key=1
      clickCount=(sample.flags & INPUT.TICK_VALID)<>0
    FI
    clickOwner=owner
    clickEpoch=openEpoch
    clickTick=sample.tick
    clickX=sample.x
    clickY=sample.y
    accepted=Publish(client,sample)
    RETURN(1)
  FI

  clickCount=0
  manager=NATIVE
  BEGIN
    LET layer=LAYERS.Find(@desktop.scene,
        LAYERS.Hit(@desktop.scene,sample.x,sample.y))
    IF layer<>NULL AND AESWINDOWSTATE.FindWindow(layer.id)<>0 THEN
      item=AESWINDOWSTATE.FindRecord(AESWINDOWSTATE.FindWindow(layer.id))
      IF item<>NULL AND item.window.frameKind<>DESKTYPES.FRAME_BORDERLESS
          AND (DESKGEOMETRY.TitleHit(@layer.bounds,sample.x,sample.y)<>0
          OR DESKGEOMETRY.GadgetHit(item.window,@layer.bounds,sample.x,sample.y)<>0) THEN
        manager=TITLE
      FI
    FI
  END

RETURN(0)
ENDMODULE
