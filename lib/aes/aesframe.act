; Caller-context frame painting using the shared GEM4XE renderer.
MODULE AESFRAME
USE AESTYPES
USE AESSTATE
USE AESWINDOWSTATE
USE DESKTYPES
USE DESKSTATE
USE LAYERTYPES
USE LAYERS
USE REGIONS
USE DISPLAY
USE CONSOLEBITMAP

; Bind resident renderer code before application admission.
PUBLIC PROC Configure(ADDRESS entry)

  CONSOLEBITMAP.ConfigureCaller(entry)

RETURN

; A caller-owned packet survives physical admission and its synchronous fence.
; UPDATE stays with the operation throughout physical access.
PUBLIC PROC Apply(CONSOLEBITMAP.Packet POINTER packet)

  CONSOLEBITMAP.Apply(packet)

RETURN

; UPDATE pins the native window, title and visible geometry across physical
; access. No presenter packet is borrowed.
PUBLIC CARD FUNC Paint(AESSTATE.Client POINTER client
    AESTYPES.Request POINTER request)
  CONSOLEBITMAP.Packet packet
  LAYERTYPES.Rect rail,clip
  CARD index

  LET window=AESWINDOWSTATE.Handle(client,request.intin(0))
  LET desktop=DESKSTATE.Get()
  LET layer=LAYERS.Find(@desktop.scene,window.layer)
  IF layer.shown=0 OR (window.iconified<>0
      AND request.intin(1)<>AESTYPES.WF_NAME) THEN
    RETURN(AESTYPES.OK)
  FI

  packet.operation=CONSOLEBITMAP.OP_FRAME
  packet.x=CARD(layer.bounds.left)
  packet.y=CARD(layer.bounds.top)
  packet.width=CARD(layer.bounds.right-layer.bounds.left)
  packet.height=CARD(layer.bounds.bottom-layer.bounds.top)
  packet.text=LONGCARD(ADDRESS(@window.title(0)))
  packet.foreground=CARD(window.id=desktop.focus)
  packet.background=1
  packet.fillY=window.frameKind
  IF window.iconified<>0 THEN
    packet.fillY=DESKTYPES.FRAME_ICONIFIED
    packet.foreground=0
    packet.background=0
  FI
  packet.fillWidth=CARD(window.sliderTop)
  packet.fillHeight=CARD(window.sliderHeight)
  packet.frameHorizontalLeft=CARD(window.sliderLeft)
  packet.frameHorizontalWidth=CARD(window.sliderWidth)
  CASE request.intin(1) OF
  WHEN AESTYPES.WF_NAME THEN
    REGIONS.Assign(@rail,layer.bounds.left,layer.bounds.top,
        layer.bounds.right,layer.bounds.top+DESKTYPES.TITLE_HEIGHT)

  WHEN AESTYPES.WF_INFO THEN
    REGIONS.Assign(@rail,layer.bounds.left,
        layer.bounds.top+DESKTYPES.TITLE_HEIGHT,layer.bounds.right,
        layer.bounds.top+DESKTYPES.TITLE_HEIGHT+DESKTYPES.FRAME_INFO_HEIGHT)

  WHEN AESTYPES.WF_HSLIDE,AESTYPES.WF_HSLSIZE THEN
    REGIONS.Assign(@rail,layer.bounds.left,
        layer.bounds.bottom-DESKTYPES.FRAME_GADGET_HEIGHT,
        layer.bounds.right,layer.bounds.bottom)

  ELSE
    REGIONS.Assign(@rail,layer.bounds.right-DESKTYPES.FRAME_GADGET_WIDTH,
        layer.bounds.top+DESKTYPES.TITLE_HEIGHT,layer.bounds.right,
        layer.bounds.bottom)
  ESAC

  index=0
  WHILE index<layer.visible.count DO
    REGIONS.Intersect(@rail,@layer.visible.rects(index),@clip)
    IF REGIONS.Empty(@clip)=0 THEN
      BEGIN
        packet.clipLeft=CARD(clip.left)
        packet.clipTop=CARD(clip.top)
        packet.clipRight=CARD(clip.right)
        packet.clipBottom=CARD(clip.bottom)
        packet.fillX=0
        Apply(@packet)
        IF packet.status<>DISPLAY.OK OR packet.fillX<>0 THEN
          request.intout(0)=0
          RETURN(AESTYPES.DISPLAY_ERROR)
        FI

        ; This is manager frame completion, never client-work completion.
        LET repaired=LAYERS.Repaired(@desktop.scene,window.layer,@clip)
      END
    FI
    index==+1
  OD

RETURN(AESTYPES.OK)

ENDMODULE
