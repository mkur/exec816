; Caller-context frame painting using the shared GEM4XE renderer.
MODULE AESFRAME
USE AESTYPES
USE GEMOBJECTS
USE AESSTATE
USE AESWINDOWSTATE
USE DESKGEOMETRY
USE DESKTYPES
USE DESKSTATE
USE LAYERTYPES
USE LAYERS
USE REGIONS
USE DISPLAY
USE CONSOLEBITMAP
USE AESDRAWSTATE

; Bind resident renderer code before application admission.
PUBLIC PROC Configure(ADDRESS entry)

  CONSOLEBITMAP.ConfigureCaller(entry)

RETURN

; The UPDATE owner borrows the GUI packet through physical admission/fencing.
PUBLIC PROC Apply(CONSOLEBITMAP.Packet POINTER packet)

  CONSOLEBITMAP.Apply(packet)

RETURN

; The request and tree live in upper storage, pinned by the current UPDATE.
; Native exposure and caller setters share this producer and C traversal.
PUBLIC BYTE FUNC Draw(CONSOLEBITMAP.Packet POINTER output
    DESKTYPES.Window POINTER window INT start LAYERTYPES.Rect POINTER clip)

  LET frame=AESDRAWSTATE.FrameRequest()
  LET desktop=DESKSTATE.Get()
  frame.tree=LONGCARD(ADDRESS(@window.frame.tree(0)))
  frame.start=start
  frame.depth=8
  frame.clip.x=clip.left
  frame.clip.y=clip.top
  frame.clip.width=clip.right-clip.left
  frame.clip.height=clip.bottom-clip.top
  frame.flags=CARD(window.id=desktop.focus)

RETURN(CONSOLEBITMAP.Frame(output,frame))

; Selected tree objects are drawn through full frame visibility, without an
; application workstation or its work-only clip. No generic frame traversal.
PUBLIC CARD FUNC Paint(AESSTATE.Client POINTER client
    AESTYPES.Request POINTER request)
  LAYERTYPES.Rect rail,clip
  CARD index
  INT object

  LET packet=AESDRAWSTATE.Packet()
  LET window=AESWINDOWSTATE.Handle(client,request.intin(0))
  LET desktop=DESKSTATE.Get()
  LET layer=LAYERS.Find(@desktop.scene,window.layer)
  IF layer.shown=0 OR (window.iconified<>0
      AND request.intin(1)<>AESTYPES.WF_NAME) THEN
    RETURN(AESTYPES.OK)
  FI
  CASE request.intin(1) OF
  WHEN AESTYPES.WF_NAME THEN
    object=GEMOBJECTS.O_NAME
  WHEN AESTYPES.WF_INFO THEN
    object=GEMOBJECTS.O_INFO
  WHEN AESTYPES.WF_HSLIDE,AESTYPES.WF_HSLSIZE THEN
    object=GEMOBJECTS.O_HSCROLL
  ELSE
    object=GEMOBJECTS.O_VSCROLL
  ESAC
  DESKGEOMETRY.ObjectRect(window,object,@rail)
  index=0
  WHILE index<layer.visible.count DO
    REGIONS.Intersect(@rail,@layer.visible.rects(index),@clip)
    IF REGIONS.Empty(@clip)=0 THEN
      BEGIN
        IF Draw(packet,window,object,@clip)=0 THEN
          request.intout(0)=0
          RETURN(AESTYPES.DISPLAY_ERROR)
        FI
        LET repaired=LAYERS.Repaired(@desktop.scene,window.layer,@clip)
      END
    FI
    index==+1
  OD

RETURN(AESTYPES.OK)

ENDMODULE
