; Bounded AES event matching. Deadlines belong to clients, never to the alarm.
MODULE AESEVENTS
USE EXEC
USE TIMER
USE AESTYPES
USE AESSTATE
USE AESMESSAGES
USE AESTIMER

PUBLIC CARD FUNC Wait(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client AESTYPES.Request POINTER request)
  CARD mask
  LONGCARD milliseconds
  TIMER.TimerClockRequest stamp

  IF request.operation=AESTYPES.OP_MESAG THEN
    mask=AESTYPES.MU_MESAG
  ELSEIF request.operation=AESTYPES.OP_TIMER THEN
    mask=AESTYPES.MU_TIMER
  ELSE
    mask=CARD(request.intin(0))
    IF mask=0 OR (mask & $ffcf)<>0 THEN
      RETURN(AESTYPES.UNSUPPORTED)
    FI
  FI

  IF (mask & AESTYPES.MU_TIMER)<>0 THEN
    IF AESTIMER.Read(service)=0 THEN
      RETURN(AESTYPES.TIMER_ERROR)
    FI

    IF request.operation=AESTYPES.OP_TIMER THEN
      milliseconds=LONGCARD(CARD(request.intin(0)))
          OR (LONGCARD(CARD(request.intin(1))) LSH 16)
    ELSE
      milliseconds=LONGCARD(CARD(request.intin(14)))
          OR (LONGCARD(CARD(request.intin(15))) LSH 16)
    FI

    stamp.ticks_hi=service.timer.nowHigh
    stamp.ticks_lo=service.timer.nowLow
    stamp.ticks_per_second=service.timer.rate
    IF request.operation<>AESTYPES.OP_MULTI OR milliseconds<>0 THEN
      IF TIMER.Deadline(@stamp,milliseconds)=0 THEN
        RETURN(AESTYPES.OVERFLOW)
      FI
    FI

    client.deadlineHigh=stamp.ticks_hi
    client.deadlineLow=stamp.ticks_lo
  FI

  client.eventMask=mask
  client.waiting=request

RETURN(AESTYPES.PENDING)

PROC Complete(AESSTATE.Client POINTER client CARD status,ready)

  LET request=client.waiting
  IF status=AESTYPES.OK AND (ready & AESTYPES.MU_MESAG)<>0 THEN
    AESMESSAGES.Take(client,request)
  FI

  client.waiting=NULL
  client.eventMask=0
  IF status=AESTYPES.OK THEN
    request.intout(0)=IF request.operation=AESTYPES.OP_MULTI
        THEN INT(ready) ELSE INT(1) FI
  FI

  AESSTATE.Reply(request,status)

RETURN

PUBLIC PROC Poll(AESSTATE.Service POINTER service)
  BYTE index,timed,wanted
  CARD ready
  LONGCARD high,low

  ; Only admissions and terminal alarm replies can change readiness. Native
  ; GUI turns must not repeatedly read the clock for an unchanged future wait.
  IF service.eventDirty=0 AND AESTIMER.Runnable(service)=0 THEN
    RETURN
  FI

  service.eventDirty=0
  AESTIMER.Collect(service)
  timed=0
  wanted=0
  high=0
  low=0
  FOR index=0 TO AESTYPES.CLIENTS-1 DO
    BEGIN
      LET client=@service.clients(index)
      IF client.waiting<>NULL AND client.eventMask<>0 THEN
        ; One fresh clock for this decision, acquired only if a timed wait
        ; needs it. Message-only waits need neither a clock nor a prescan.
        IF timed=0 AND (client.eventMask & AESTYPES.MU_TIMER)<>0 THEN
          BEGIN
            LET valid=AESTIMER.Read(service)
          END

          timed=1
        FI

        IF (client.eventMask & AESTYPES.MU_TIMER)<>0
            AND service.timer.error<>0 THEN
          Complete(client,AESTYPES.TIMER_ERROR,0)
        ELSE
          ready=0
          IF (client.eventMask & AESTYPES.MU_MESAG)<>0 AND client.queued<>0 THEN
            ready=AESTYPES.MU_MESAG
          FI

          IF (client.eventMask & AESTYPES.MU_TIMER)<>0
              AND (client.deadlineHigh<service.timer.nowHigh
                  OR (client.deadlineHigh=service.timer.nowHigh
                      AND client.deadlineLow<=service.timer.nowLow)) THEN
            ready=ready OR AESTYPES.MU_TIMER
          FI

          IF ready<>0 THEN
            Complete(client,AESTYPES.OK,ready)
          ELSEIF (client.eventMask & AESTYPES.MU_TIMER)<>0 THEN
            IF wanted=0 OR client.deadlineHigh<high
                OR (client.deadlineHigh=high AND client.deadlineLow<low) THEN
              high=client.deadlineHigh
              low=client.deadlineLow
              wanted=1
            FI
          FI
        FI
      FI
    END
  OD

  AESTIMER.Target(service,wanted,high,low)
  ; A reply to the newly submitted alarm remains queued for the next decision.
  ; Runnable sees it, so immediate expiry/error cannot strand the caller or
  ; consume the only wake before a fresh clock sample.
  IF service.timer.error<>0 THEN
    FOR index=0 TO AESTYPES.CLIENTS-1 DO
      BEGIN
        LET client=@service.clients(index)
        IF client.waiting<>NULL
            AND (client.eventMask & AESTYPES.MU_TIMER)<>0 THEN
          Complete(client,AESTYPES.TIMER_ERROR,0)
        FI
      END
    OD
  FI

RETURN
ENDMODULE
