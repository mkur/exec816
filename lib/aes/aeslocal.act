; Caller entry to the same native policy used by RPC admission.
MODULE AESLOCAL
USE EXEC
USE EXECLISTS
USE AESTYPES
USE AESSTATE
USE AESGATE
USE AESLOCKS
USE AESWINDOW

; The admitted binding and registration remain live until this Task detaches.
; Return zero for the original RPC path; handled TRY failure returns one.
PUBLIC CARD FUNC Call(LONGCARD value)
  BYTE queued,wake
  CARD status

  LET service=AESSTATE.Get()
  IF service=NULL THEN
    RETURN(0)
  FI
  LET request=AESTYPES.Request POINTER(ADDRESS(value))
  IF request.operation<>AESTYPES.OP_UPDATE
      AND request.operation<>AESTYPES.OP_CREATE
      AND request.operation<>AESTYPES.OP_DELETE
      AND request.operation<>AESTYPES.OP_SET THEN
    RETURN(0)
  FI
  IF request.operation=AESTYPES.OP_SET AND request.intin(1)<>AESTYPES.WF_NAME
      AND request.intin(1)<>AESTYPES.WF_INFO THEN
    RETURN(0)
  FI
  AESGATE.EnterTask(request.owner,
      LONGCARD(1) LSH request.message.mn_ReplyPort.mp_SigBit)
  LET client=AESSTATE.Find(service,request.client)
  ; Include older messages that have not reached the native waiter queue yet.
  EXEC.Forbid()
  queued=service.lockCount<>0 OR service.windowPending<>0
      OR EXECLISTS.IsListEmpty(@service.port.mp_MsgList)=0
  EXEC.Permit()
  wake=request.operation<>AESTYPES.OP_UPDATE
      OR (request.intin(0)=AESTYPES.END_UPDATE AND service.updates=1)
  request.intout(0)=IF request.operation=AESTYPES.OP_CREATE THEN INT(-1)
      ELSE INT(0) FI
  IF request.operation=AESTYPES.OP_UPDATE THEN
    status=AESLOCKS.Attempt(service,client,request,AESLOCKS.OWNER_READY,queued)
  ELSEIF request.operation=AESTYPES.OP_SET THEN
    status=AESWINDOW.Frame(service,client,request,queued,@wake)
  ELSE
    status=AESWINDOW.Lifecycle(service,client,request,queued)
  FI
  IF status=AESTYPES.PENDING THEN
    AESGATE.Release(0)
    RETURN(0)
  FI

  request.status=status
  ; A local TRY can observe newly eligible older work without sending a
  ; message. Preserve that admission opportunity when the presenter sleeps.
  AESGATE.Release((wake OR queued) AND status=AESTYPES.OK)

RETURN(1)

ENDMODULE
