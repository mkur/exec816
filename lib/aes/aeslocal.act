; Caller entry to native AES policy and registration services.
MODULE AESLOCAL
USE EXEC
USE AESTYPES
USE AESSTATE
USE AESWAIT
USE AESSNAPSHOT
USE AESLOCKS
USE AESCORE
USE AESMENU
USE DESKDRAG
USE AESWINDOW
USE AESFRAME
USE AESWINDOWSTATE
USE AESCURSOR
USE CALYPSICALL
USE DESKMOUSE
USE DESKPAINT
USE DESKMENU
USE DESKCACHEWORK
USE CONSOLEBITMAP
USE AESDRAWSTATE

ADDRESS mouseApply

; Startup binds the resident ordinary C device helper before client admission.
PUBLIC PROC ConfigureMouse(ADDRESS entry)

  mouseApply=entry

RETURN

; Commit copied input/window reads before notifying the independent manager.
PROC Publish(AESSTATE.Service POINTER service BYTE wake)

  AESSNAPSHOT.Publish()
  IF wake<>0 THEN
    EXEC.Signal(service.owner,service.mask)
  FI

RETURN

; One busy C context pins its descriptor, registration and native stack until
; return. UPDATE stays owned while waiting for an older retained effect;
; signals are only hints.
CARD FUNC Policy(LONGCARD value)
  BYTE wake,waiting
  CARD status

  LET service=AESSTATE.Get()
  IF service=NULL THEN
    RETURN(0)
  FI
  LET request=AESTYPES.Request POINTER(ADDRESS(value))
  IF request.operation<>AESTYPES.OP_CREATE
      AND request.operation<>AESTYPES.OP_DELETE
      AND request.operation<>AESTYPES.OP_OPEN
      AND request.operation<>AESTYPES.OP_CLOSE
      AND request.operation<>AESTYPES.OP_SET THEN
    IF request.operation<>AESTYPES.OP_MENU
        AND request.operation<>AESTYPES.OP_DRAG_OUTLINE THEN
      RETURN(0)
    FI
  FI
  LET mask=LONGCARD(1) LSH request.message.mn_ReplyPort.mp_SigBit
  waiting=0
  DO
    IF request.operation=AESTYPES.OP_DRAG_OUTLINE THEN
      request.status=DESKDRAG.Outline(service,
          AESSTATE.Find(service,request.client),request)
      ; Outline admission/cancel changes guarded copied capture state only.
      ; Even a rejected call can arrive without owning UPDATE.
      EXEC.Signal(service.owner,service.mask)
      RETURN(1)
    FI
    BEGIN
      LET client=AESSTATE.Find(service,request.client)
      wake=1
      request.intout(0)=IF request.operation=AESTYPES.OP_CREATE THEN INT(-1)
          ELSE INT(0) FI
      IF request.operation=AESTYPES.OP_MENU THEN
        status=AESMENU.Request(service,client,request)
      ELSEIF request.operation=AESTYPES.OP_OPEN
          OR request.operation=AESTYPES.OP_CLOSE THEN
        AESWINDOWSTATE.PrepareUpdate(client)
        status=AESWINDOW.Visibility(service,client,request)
      ELSEIF request.operation=AESTYPES.OP_SET THEN
        IF AESWINDOW.FrameField(request.intin(1))<>0 THEN
          status=AESWINDOW.Frame(service,client,request,@wake)
          IF status=AESTYPES.OK AND wake<>0 THEN
            status=AESFRAME.Paint(client,request)
          FI
          IF AESWINDOW.SliderField(request.intin(1))<>0 THEN
            wake=0
          FI
        ELSEIF AESWINDOW.GeometryField(request.intin(1))<>0 THEN
          AESWINDOWSTATE.PrepareUpdate(client)
          status=AESWINDOW.Geometry(service,client,request)
        ELSE
          status=AESWINDOW.Request(service,client,request)
        FI
      ELSE
        AESWINDOWSTATE.PrepareUpdate(client)
        status=AESWINDOW.Lifecycle(service,client,request)
      FI
      IF status=AESTYPES.PENDING AND waiting=0 THEN
        AESWAIT.Window(service,client,request)
        client.waitMode=AESWAIT.CALLER
        request.status=AESTYPES.PENDING
      FI
      IF status<>AESTYPES.PENDING THEN
        client.pending=NULL
        AESWAIT.RemoveWindow(service,client)
        client.waitMode=AESWAIT.IDLE
        request.status=status
        ; Removing a failed waiter also unblocks deferred paint and peers.
        Publish(service,waiting<>0 OR (wake AND status=AESTYPES.OK))
        RETURN(1)
      FI
      Publish(service,waiting=0)
      waiting=1
      EXEC.Wait(mask)
    END
  OD

RETURN(1)

; The request and UPDATE-borrowed packet belong to the current caller until its
; exposure finishes. Ordinary client work remains a WM_REDRAW responsibility.
CARD FUNC Exposure(AESTYPES.Request POINTER request)

  IF request.displayGrant=NULL THEN
    RETURN(AESTYPES.OK)
  FI
  LET packet=AESDRAWSTATE.Packet()
  ; Quiescent device failure still permits logical withdrawal and cleanup.
  ; Unsafe hardware parks in the driver before this boundary can return.
  IF CONSOLEBITMAP.Failed()<>0 THEN
    IF request.operation=AESTYPES.OP_CLOSE OR request.operation=AESTYPES.OP_DELETE
        OR request.operation=AESTYPES.OP_EXIT THEN
      RETURN(AESTYPES.OK)
    FI
    RETURN(AESTYPES.DISPLAY_ERROR)
  FI
  DESKMENU.Reconcile()
  IF DESKPAINT.Complete(packet)=0 THEN
    IF CONSOLEBITMAP.Failed()<>0 AND (request.operation=AESTYPES.OP_CLOSE
        OR request.operation=AESTYPES.OP_DELETE OR request.operation=AESTYPES.OP_EXIT) THEN
      RETURN(AESTYPES.OK)
    FI
    RETURN(AESTYPES.DISPLAY_ERROR)
  FI
  LET service=AESSTATE.Get()
  IF service.updateHolds=0 AND service.mouseHolds=0 THEN
    BEGIN
      LET maintained=DESKCACHEWORK.Maintain(packet)
    END
  FI

RETURN(AESTYPES.OK)

; Private handler scopes use the same resource path without opening a user
; painting scope or changing the public C context's explicit nesting counts.
CARD FUNC Scope(AESTYPES.Request POINTER request CARD code BYTE painting)
  CARD operation,status
  INT first,second

  operation=request.operation
  first=request.intin(0)
  second=request.intin(1)
  request.operation=AESTYPES.OP_UPDATE
  request.intin(0)=INT(code)
  request.intin(1)=0
  status=AESLOCKS.Call(request,painting)
  request.operation=operation
  request.intin(0)=first
  request.intin(1)=second

RETURN(status)

; This wait is for a retained physical effect after native acquisition. It is
; never resource arbitration: the caller already owns UPDATE throughout.
PROC DrawingReady(AESTYPES.Request POINTER request)

  IF DESKDRAG.DrawReady()<>0 THEN
    RETURN
  FI
  LET service=AESSTATE.Get()
  LET client=AESSTATE.Find(service,request.client)
  LET mask=LONGCARD(1) LSH request.message.mn_ReplyPort.mp_SigBit
  DO
    IF DESKDRAG.DrawReady()<>0 THEN
      client.pending=NULL
      AESWAIT.RemoveWindow(service,client)
      client.waitMode=AESWAIT.IDLE
      Publish(service,0)
      RETURN
    FI
    AESWAIT.Window(service,client,request)
    client.waitMode=AESWAIT.CALLER
    Publish(service,1)
    EXEC.Wait(mask)
  OD

RETURN

; Cooperative owner cleanup retains its context through every actual wait.
; UI withdrawal precedes final resource release; cursor repair follows it.
CARD FUNC Depart(AESTYPES.Request POINTER request)
  CARD status
  BYTE ready

  LET service=AESSTATE.Get()
  LET client=AESSTATE.Find(service,request.client)
  LET mask=LONGCARD(1) LSH request.message.mn_ReplyPort.mp_SigBit
  status=Scope(request,AESTYPES.BEG_UPDATE,0)
  IF status<>AESTYPES.OK THEN
    RETURN(status)
  FI
  WHILE service.mouseHolds<>0 DO
    status=Scope(request,AESTYPES.END_MCTRL,1)
  OD
  DO
    ready=AESCORE.PrepareExit(service,client,request)
    IF ready<>0 THEN
      client.pending=NULL
      AESWAIT.RemoveWindow(service,client)
      client.waitMode=AESWAIT.IDLE
      Publish(service,0)
      EXIT
    FI
    AESWAIT.Window(service,client,request)
    client.waitMode=AESWAIT.CALLER
    Publish(service,1)
    EXEC.Wait(mask)
  OD
  status=Exposure(request)
  IF status<>AESTYPES.OK THEN
    RETURN(status)
  FI
  WHILE service.updateHolds<>0 DO
    status=Scope(request,AESTYPES.END_UPDATE,1)
  OD
  status=Scope(request,AESTYPES.END_UPDATE,0)
  EXEC.Forbid()
  ready=AESCURSOR.Retire(service,client,request)
  request.status=AESTYPES.OK
  EXEC.Permit()
  IF ready=0 THEN
    BEGIN
      LET ignored=CALYPSICALL.Invoke(mouseApply,LONGCARD(ADDRESS(request)))
    END
  FI
  AESCURSOR.Wake()
  IF request.status=AESTYPES.OK THEN
    client.waitMode=AESWAIT.DEPARTED
  FI

RETURN(request.status)

PUBLIC CARD FUNC Call(LONGCARD value)
  CARD status,result,handled

  LET request=AESTYPES.Request POINTER(ADDRESS(value))
  IF request.operation=AESTYPES.OP_INIT
      OR request.operation=AESTYPES.OP_DETACH
      OR request.operation=AESTYPES.OP_MOUSE_PROFILE THEN
    BEGIN
      LET service=AESSTATE.Get()
      request.intout(0)=IF request.operation=AESTYPES.OP_INIT THEN INT(-1)
          ELSE INT(0) FI
      IF service=NULL THEN
        request.status=AESTYPES.IDENTITY
      ELSEIF request.operation=AESTYPES.OP_INIT THEN
        request.status=AESCORE.Register(service,request)
      ELSE
        BEGIN
          LET client=AESSTATE.Find(service,request.client)
          IF client=NULL THEN
            request.status=AESTYPES.IDENTITY
          ELSEIF request.operation=AESTYPES.OP_DETACH THEN
            request.status=AESCORE.Retire(service,client,request)
          ELSE
            request.intout(0)=DESKMOUSE.Profile(request.intin(0))
            request.status=AESTYPES.OK
          FI
        END
      FI
    END
    RETURN(1)
  FI
  IF request.operation=AESTYPES.OP_FIND THEN
    request.status=AESWINDOW.Query(request)
    RETURN(1)
  FI
  IF request.operation=AESTYPES.OP_GRAF_MOUSE THEN
    BEGIN
      LET service=AESSTATE.Get()
      IF service=NULL THEN
        RETURN(0)
      FI

      ; Registration pins the caller. Cursor policy reads published routing,
      ; not the live scene; only its bounded state transition excludes Tasks.
      EXEC.Forbid()
      request.status=AESCURSOR.Call(service,
          AESSTATE.Find(service,request.client),request)
      EXEC.Permit()
      IF request.status=AESTYPES.OK THEN
        BEGIN
          LET ignored=CALYPSICALL.Invoke(mouseApply,value)
        END
      FI
      AESCURSOR.Wake()
      IF AESCURSOR.Pending()<>0 THEN
        EXEC.Signal(service.owner,service.mask)
      FI
      RETURN(1)
    END
  FI

  IF request.operation=AESTYPES.OP_EXIT THEN
    request.status=Depart(request)
    request.intout(0)=INT(request.status=AESTYPES.OK)
    RETURN(1)
  FI
  IF request.operation=AESTYPES.OP_UPDATE THEN
    request.status=AESLOCKS.Call(request,1)
    IF request.status=AESTYPES.OK AND request.intout(0)<>0 THEN
      IF (CARD(request.intin(0)) & $ff)=AESTYPES.BEG_UPDATE THEN
        DrawingReady(request)
      ELSEIF DESKDRAG.Application()<>0 THEN
        BEGIN
          LET service=AESSTATE.Get()
          EXEC.Signal(service.owner,service.mask)
        END
      FI
    FI
    RETURN(1)
  FI
  IF request.operation=AESTYPES.OP_CREATE
      OR request.operation=AESTYPES.OP_DELETE
      OR request.operation=AESTYPES.OP_OPEN
      OR request.operation=AESTYPES.OP_CLOSE
      OR request.operation=AESTYPES.OP_SET
      OR request.operation=AESTYPES.OP_MENU THEN
    status=Scope(request,AESTYPES.BEG_UPDATE,0)
    IF status<>AESTYPES.OK THEN
      request.status=status
      request.intout(0)=IF request.operation=AESTYPES.OP_CREATE THEN INT(-1) ELSE INT(0) FI
      RETURN(1)
    FI
    handled=Policy(value)
    status=request.status
    result=CARD(request.intout(0))
    IF status=AESTYPES.OK THEN
      status=Exposure(request)
      IF status<>AESTYPES.OK THEN
        result=0
      FI
    FI
    BEGIN
      LET released=Scope(request,AESTYPES.END_UPDATE,0)
      IF released<>AESTYPES.OK THEN
        status=released
        result=0
      FI
    END
    request.status=status
    request.intout(0)=INT(result)
    RETURN(handled)
  FI

RETURN(Policy(value))

ENDMODULE
