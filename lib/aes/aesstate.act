; One optional AES endpoint; its controller retains storage through shutdown.
MODULE AESSTATE
USE EXEC
USE AESTYPES
USE TIMER
USE INPUT

PUBLIC CONST POINTER_EVENTS=16

PUBLIC CONST ALARM_IDLE=0
PUBLIC CONST ALARM_OUTSTANDING=1
PUBLIC CONST ALARM_RETIRING=2

PUBLIC TYPE TimerState=[
  EXEC.MsgPort POINTER port
  TIMER.TimerClockRequest POINTER query,alarm
  BYTE state,opened,error
  LONGCARD mask,targetHigh,targetLow,nowHigh,nowLow,rate
]

PUBLIC TYPE Client=[
  LONGCARD id
  LONGCARD sequence
  INT gemId
  EXEC.TaskLease lease
  AESTYPES.Request POINTER binding
  EXEC.MsgPort POINTER replies
  AESTYPES.Endpoint POINTER endpoint
  AESTYPES.Request POINTER waiting
  CARD eventMask
  LONGCARD deadlineHigh,deadlineLow
  INT ARRAY words(AESTYPES.QUEUE_DEPTH*AESTYPES.MESSAGE_WORDS)
  BYTE head,queued
]

PUBLIC TYPE Service=[
  EXEC.MsgPort port
  EXEC.Task POINTER controller
  EXEC.Task POINTER owner
  LONGCARD mask
  CARD error
  BYTE live
  BYTE started
  LONGCARD nextClient
  CARD nextGem
  AESTYPES.Directory directory
  Client ARRAY clients(AESTYPES.CLIENTS)
  BYTE count,eventDirty
  TimerState timer
  LONGCARD updateOwner,mouseOwner
  CARD updates,mouseHolds
  BYTE ARRAY lockOrder(AESTYPES.CLIENTS)
  BYTE lockCount
  INPUT.Event ARRAY pointerEvents(POINTER_EVENTS)
  BYTE pointerHead,pointerCount,pointerLost
]

Service POINTER boundService

PUBLIC Service POINTER FUNC Get()

RETURN(boundService)

; Startup before presenter admission, or retirement after its last use.
PUBLIC PROC Bind(Service POINTER value)

  boundService=value

RETURN

; Callers detach every service reference before this ownership transfer.
PUBLIC PROC Reply(AESTYPES.Request POINTER request CARD status)

  request.status=status
  EXEC.ReplyMsg(@request.message)

RETURN

PUBLIC Client POINTER FUNC Find(Service POINTER value LONGCARD id)
  BYTE index

  IF id=0 THEN
    RETURN(NULL)
  FI

  FOR index=0 TO AESTYPES.CLIENTS-1 DO
    IF value.clients(index).id=id THEN
      RETURN(@value.clients(index))
    FI
  OD

RETURN(NULL)

ENDMODULE
