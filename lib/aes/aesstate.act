; One optional AES endpoint; its controller retains storage through shutdown.
MODULE AESSTATE
USE EXEC
USE AESTYPES
USE INPUT
USE DESKTYPES
USE LAYERTYPES

PUBLIC CONST POINTER_EVENTS=16

; Policy-gate snapshot invalidation; no caller ABI or per-client storage.
PUBLIC BYTE mouseDirty

; Owned association storage; only the caller's tree and strings are borrowed.
PUBLIC TYPE Menu=[
  AESTYPES.MenuObject POINTER tree
  LONGCARD generation
  BYTE count,titles
  INT selectedTitle,selectedItem,selectedBox
  INT ARRAY parent(AESTYPES.MENU_OBJECTS)
  INT ARRAY x(AESTYPES.MENU_OBJECTS)
  INT ARRAY y(AESTYPES.MENU_OBJECTS)
  INT ARRAY title(AESTYPES.MENU_OBJECTS)
  INT ARRAY box(AESTYPES.MENU_OBJECTS)
  BYTE ARRAY damage(AESTYPES.MENU_OBJECTS)
]

PUBLIC TYPE Client=[
  LONGCARD id
  LONGCARD sequence
  INT gemId
  EXEC.TaskLease lease
  AESTYPES.Request POINTER binding
  EXEC.MsgPort POINTER replies
  AESTYPES.Endpoint POINTER endpoint
  AESTYPES.Request POINTER pending
  Menu POINTER menu
  DESKTYPES.GuiPending gui
  BYTE guiNext,windowWaiting,closeRequested,windowLocks,waitMode
]

PUBLIC TYPE Service=[
  EXEC.MsgPort port
  EXEC.Task POINTER controller
  EXEC.Task POINTER owner
  LONGCARD mask
  CARD error
  BYTE live
  BYTE started
  LONGCARD nextClient
  CARD nextGem
  LONGCARD nextMenuEpoch,menuRevision
  LONGCARD nextGuiEpoch
  CARD nextWindow
  BYTE windowPending
  LONGCARD windowRevision,windowFocus
  AESTYPES.Directory directory
  Client ARRAY clients(AESTYPES.CLIENTS)
  DESKTYPES.Window POINTER ARRAY windows(AESTYPES.WINDOWS)
  BYTE count
  LONGCARD updateOwner,mouseOwner
  CARD updates,mouseHolds
  INT updateWindow
  BYTE ARRAY lockOrder(AESTYPES.CLIENTS)
  BYTE lockCount
  BYTE policyGate,policyWaiting,policyEffects
  EXEC.Task POINTER sceneOwner
  BYTE POINTER sceneWaiters
  INPUT.Event ARRAY pointerEvents(POINTER_EVENTS)
  BYTE pointerHead,pointerCount,pointerLost
]

Service POINTER boundService

PUBLIC Service POINTER FUNC Get()

RETURN(boundService)

; Startup before presenter admission, or retirement after its last use.
PUBLIC PROC Bind(Service POINTER value)
  BYTE index

  boundService=value
  IF value<>NULL THEN
    FOR index=0 TO AESTYPES.WINDOWS-1 DO
      value.windows(index).geometryEpoch=0
    OD
  FI

RETURN

; Callers detach every service reference before this ownership transfer.
PUBLIC PROC Reply(AESTYPES.Request POINTER request CARD status)

  request.status=status
  EXEC.ReplyMsg(@request.message)

RETURN

PUBLIC Client POINTER FUNC Find(Service POINTER value LONGCARD id)
  BYTE index

  IF id=0 THEN
    RETURN(NULL)
  FI

  FOR index=0 TO AESTYPES.CLIENTS-1 DO
    IF value.clients(index).id=id THEN
      RETURN(@value.clients(index))
    FI
  OD

RETURN(NULL)

ENDMODULE
