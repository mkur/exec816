; Shared GEM window policy. No application draws in this code.
MODULE AESWINDOW
USE EXEC
USE AESWAIT
USE A816MEMORY
USE AESSTATE
USE AESSNAPSHOT
USE AESTYPES
USE AESGUI
USE AESMENU
USE AESMOUSE
USE AESLOCKS
USE AESROUTES
USE AESWINDOWSTATE
USE DESKTYPES
USE DESKWINDOW
USE GEMFRAME
USE GEMOBJECTS
USE DESKSTATE
USE DESKCORE
USE DESKGEOMETRY
USE DESKMENU
USE DESKCACHE
USE DESKMOVE
USE LAYERTYPES
USE LAYERS
USE REGIONS
USE HEAPCORE

BYTE FUNC OnScreenBounds(INT x,y,width,height
    LAYERTYPES.Rect POINTER rect)

  ; Screen admission remains bounded; pure GEMFRAME.Calc has no such policy.
  IF x<0 OR y<0 OR width<1 OR height<1 OR width>640 OR height>240
      OR x>640-width OR y>240-height THEN
    RETURN(0)
  FI

  REGIONS.Assign(rect,x,y,x+width,y+height)

RETURN(1)


BYTE FUNC SameSize(LAYERTYPES.Rect POINTER first,second)

RETURN(first.right-first.left=second.right-second.left
    AND first.bottom-first.top=second.bottom-second.top)

BYTE FUNC FitBounds(DESKTYPES.Window POINTER window
    LAYERTYPES.Rect POINTER bounds INT x,y,width,height)

RETURN(OnScreenBounds(x,y,width,height,bounds)<>0
    AND width>=window.frame.minWidth AND height>=window.frame.minHeight)

; The caller owns the scene and supplies the registered binding's window view.
PUBLIC CARD FUNC CreateHidden(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client AESTYPES.WindowView POINTER view
    INT kind,x,y,width,height)
  BYTE slot,status

  IF (CARD(kind) & AESTYPES.WINDOW_SUPPORTED)<>CARD(kind) THEN
    RETURN(AESTYPES.UNSUPPORTED)
  FI

  ; wind_create supplies FULLXYWH, not a displayed rectangle. MGVIEW's full
  ; border can start at -1; only wind_open admits physical screen bounds.
  IF view=NULL OR width<1 OR height<1 THEN
    RETURN(AESTYPES.MALFORMED)
  FI

  LET desktop=DESKSTATE.Get()
  IF service.nextWindow=0 OR desktop.nextWindow=0 THEN
    RETURN(AESTYPES.OVERFLOW)
  FI

  FOR slot=0 TO DESKTYPES.WINDOWS-1 DO
    IF desktop.windows(slot)=NULL THEN
      BEGIN
        LET window=DESKWINDOW.Create(IF kind=0 THEN
            CARD(DESKTYPES.FRAME_BORDERLESS) ELSE CARD(kind) FI)
        IF window=NULL THEN
          RETURN(AESTYPES.RESOURCE)
        FI
        LET item=window
        status=LAYERS.Create(@desktop.scene,@desktop.scene.screen,@window.layer)
        IF status<>LAYERTYPES.OK THEN
          DESKWINDOW.Free(window)
          RETURN(AESTYPES.RESOURCE)
        FI

        status=LAYERS.SetExternal(@desktop.scene,window.layer)
        IF status<>LAYERTYPES.OK THEN
          HEAPCORE.Abort($fcb4)
        FI

        item.owner=client.id
        item.inputBound=0
        item.inputUnit=0
        item.visibilityEpoch=0
        item.focusNotices=0
        window.id=desktop.nextWindow
        desktop.nextWindow==+1
        window.frameKind=IF kind=0 THEN CARD(DESKTYPES.FRAME_BORDERLESS)
            ELSE CARD(kind) FI
        window.visualRevision=1
        item.view=view
        item.gui.window=INT(service.nextWindow)
        IF service.nextWindow=$7fff THEN
          service.nextWindow=0
        ELSE
          service.nextWindow==+1
        FI

        view.handle=item.gui.window
        view.kind=kind
        view.vslide=0
        view.vsize=-1
        view.hslide=0
        view.hsize=-1
        window.frame.full.x=x
        window.frame.full.y=y
        window.frame.full.width=width
        window.frame.full.height=height
        desktop.windows(slot)=window
        service.windows(slot)=window
        AESWINDOWSTATE.Snapshot(item)
        RETURN(AESTYPES.OK)
      END
    FI
  OD

RETURN(AESTYPES.RESOURCE)

; Route preparation has succeeded. Publish the window and its fresh open epoch
; together under scene ownership; no route creation or draining occurs here.
PROC CommitOpen(AESSTATE.Service POINTER service AESSTATE.Client POINTER client
    DESKTYPES.Window POINTER item LAYERTYPES.Rect POINTER bounds LONGCARD route)
  LAYERTYPES.Rect physical

  LET desktop=DESKSTATE.Get()
  LET window=item
  window.keyRoute=route
  AESGUI.Open(service,client,item)
  REGIONS.Copy(bounds,@physical)
  IF window.frameKind<>DESKTYPES.FRAME_BORDERLESS THEN
    physical.right=IF bounds.right<638 THEN bounds.right+2 ELSE INT(640) FI
    physical.bottom=IF bounds.bottom<238 THEN bounds.bottom+2 ELSE INT(240) FI
  FI
  IF LAYERS.Bounds(@desktop.scene,window.layer,physical.left,physical.top,
      physical.right-physical.left,physical.bottom-physical.top)<>LAYERTYPES.OK
      OR DESKSTATE.PrepareOpen(window.layer)<>LAYERTYPES.OK
      OR LAYERS.Show(@desktop.scene,window.layer,1)<>LAYERTYPES.OK THEN
    HEAPCORE.Abort($fcb5)
  FI
  GEMFRAME.SetSize(@window.frame,window.frameKind,bounds.left,bounds.top,
      bounds.right-bounds.left,bounds.bottom-bounds.top)
  ; MagiC wind_open initializes PREVXYWH to the accepted open rectangle.
  GEMFRAME.Remember(@window.frame)
  DESKCORE.CommitFocus(desktop,window.id)
  IF client.closeRequested<>0 THEN
    AESGUI.Post(service,item,AESTYPES.GUI_CLOSED,0,0,0,0)
  FI
  AESWINDOWSTATE.LayoutChanged(item,0)
  AESWINDOWSTATE.Sync()

RETURN

PROC DiscardRoute(LONGCARD route)

  IF route<>0 THEN
    AESROUTES.Discard(route)
  FI

RETURN

CARD FUNC Open(AESSTATE.Service POINTER service AESSTATE.Client POINTER client
    DESKTYPES.Window POINTER item AESTYPES.Request POINTER request)
  LAYERTYPES.Rect bounds
  LONGCARD route

  LET desktop=DESKSTATE.Get()
  LET window=item
  LET layer=LAYERS.Find(@desktop.scene,window.layer)
  ; A retained close keeps its hidden window until the old input tag retires.
  IF layer.shown<>0 OR window.keyRoute<>0 THEN
    RETURN(AESTYPES.BUSY)
  FI

  IF FitBounds(window,@bounds,request.intin(1),request.intin(2),
      request.intin(3),request.intin(4))=0 THEN
    RETURN(AESTYPES.MALFORMED)
  FI

  LET status=AESROUTES.Prepare(window,@route)
  IF status<>AESTYPES.OK THEN
    RETURN(status)
  FI
  IF service.nextGuiEpoch=0 THEN
    DiscardRoute(route)
    RETURN(AESTYPES.OVERFLOW)
  FI
  CommitOpen(service,client,item,@bounds,route)

RETURN(AESTYPES.OK)

; Close withdraws the window and capture route before draining the old tag.
; The hidden record retains that tag until the input service retires it.
PROC CommitClose(DESKTYPES.Service POINTER desktop
    DESKTYPES.Window POINTER item LONGCARD focus)

  LET window=item
  AESMOUSE.CancelWindow(item.view.epoch)
  AESGUI.Close(item)
  BEGIN
    LET client=AESSTATE.Find(AESSTATE.Get(),item.owner)
    IF client.endpoint.guiEpoch=0 THEN
      AESMENU.Close(AESSTATE.Get(),client)
    FI
  END
  item.paintDirty=0
  IF LAYERS.Show(@desktop.scene,window.layer,0)<>LAYERTYPES.OK THEN
    HEAPCORE.Abort($fcb5)
  FI
  DESKCORE.ForgetIcon(desktop,window)
  GEMFRAME.Close(@window.frame)
  DESKCORE.CommitFocus(desktop,focus)
  AESWINDOWSTATE.Snapshot(item)
  AESWINDOWSTATE.Sync()

RETURN

CARD FUNC Close(DESKTYPES.Window POINTER item AESTYPES.Request POINTER request)

  LET desktop=DESKSTATE.Get()
  LET window=item
  LET layer=LAYERS.Find(@desktop.scene,window.layer)
  IF layer.shown<>0 OR window.keyRoute=0 THEN
    BEGIN
      LET focus=DESKCORE.NextFocus(desktop,window.id)
      CommitClose(desktop,item,focus)
      AESSNAPSHOT.Publish()
    END
  FI

  IF AESROUTES.Retire(window)=0 THEN
    RETURN(AESTYPES.PENDING)
  FI

RETURN(AESTYPES.OK)

; Both transports use the same admission and scene publication policy.
PUBLIC CARD FUNC Visibility(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client AESTYPES.Request POINTER request)
  CARD status

  LET item=AESWINDOWSTATE.Handle(client,request.intin(0))
  IF item=NULL THEN
    RETURN(AESTYPES.IDENTITY)
  FI
  IF request.operation=AESTYPES.OP_OPEN THEN
    status=Open(service,client,item,request)
  ELSE
    status=Close(item,request)
  FI
  IF status=AESTYPES.OK THEN
    request.intout(0)=1
  FI

RETURN(status)

; Called after hiding and route retirement, with the presenter settled.
PROC Destroy(DESKTYPES.Window POINTER item)
  BYTE status,slot

  LET desktop=DESKSTATE.Get()
  AESMOUSE.CancelWindow(item.view.epoch)
  AESGUI.Close(item)
  status=LAYERS.Delete(@desktop.scene,item.layer)
  IF status<>LAYERTYPES.OK THEN
    HEAPCORE.Abort($fcb6)
  FI

  IF DESKSTATE.desktopWindow=item.id THEN
    DESKSTATE.desktopWindow=0
    DESKSTATE.desktopLayer=0
  FI
  DESKCACHE.ForgetCandidate(desktop,item)
  LET view=item.view
  view.handle=0
  view.visibleCount=0
  view.shown=0
  LET service=AESSTATE.Get()
  FOR slot=0 TO DESKTYPES.WINDOWS-1 DO
    IF desktop.windows(slot)=item THEN
      desktop.windows(slot)=NULL
      service.windows(slot)=NULL
      EXIT
    FI
  OD
  DESKWINDOW.Free(item)

RETURN

PUBLIC CARD FUNC DeleteHidden(DESKTYPES.Window POINTER item)

  LET desktop=DESKSTATE.Get()
  LET layer=LAYERS.Find(@desktop.scene,item.layer)
  ; Hidden alone does not authorize freeing a retained close continuation.
  IF layer.shown<>0 OR item.keyRoute<>0 THEN
    RETURN(AESTYPES.BUSY)
  FI

  Destroy(item)
  AESWINDOWSTATE.Sync()

RETURN(AESTYPES.OK)

PUBLIC BYTE FUNC Retire(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client AESTYPES.Request POINTER request)
  BYTE slot

  FOR slot=0 TO AESTYPES.WINDOWS-1 DO
    IF service.windows(slot)<>NULL AND service.windows(slot).owner=client.id THEN
      BEGIN
        LET item=service.windows(slot)
        IF Close(item,request)<>AESTYPES.OK THEN
          RETURN(0)
        FI
        Destroy(item)
      END
    FI
  OD
  AESWINDOWSTATE.Sync()

RETURN(1)

; A short copied-publication guard keeps queries independent of scene/UPDATE.
PUBLIC CARD FUNC Query(AESTYPES.Request POINTER request)

  request.intout(0)=AESSNAPSHOT.Find(request.intin(0),request.intin(1))

RETURN(AESTYPES.OK)

CARD FUNC SetBounds(AESSTATE.Service POINTER service
    DESKTYPES.Service POINTER desktop DESKTYPES.Window POINTER item
    LAYERTYPES.Layer POINTER layer AESTYPES.Request POINTER request)
  LAYERTYPES.Rect bounds,current,physical

  LET window=item
  DESKGEOMETRY.Project(@window.frame.current,@current)
  IF window.iconified<>0 THEN
    REGIONS.Copy(@window.normalBounds,@current)
  FI
  IF FitBounds(window,@bounds,request.intin(2),request.intin(3),
      request.intin(4),request.intin(5))=0 THEN
    RETURN(AESTYPES.MALFORMED)
  FI

  LET same=SameSize(@current,@bounds)
  IF window.iconified<>0 THEN
    IF same=0 THEN
      DESKCACHE.Changed(desktop,window)
    FI
    REGIONS.Copy(@bounds,@window.normalBounds)
    AESWINDOWSTATE.Snapshot(item)
    RETURN(AESTYPES.OK)
  FI

  IF REGIONS.Equal(@current,@bounds)<>0 THEN
    ; MagiC ws_curr remembers CURRXYWH even when the requested size is equal.
    GEMFRAME.Remember(@window.frame)
    AESWINDOWSTATE.Snapshot(item)
    RETURN(AESTYPES.OK)
  FI

  IF same<>0 AND service.updateHolds+service.mouseHolds=0
      AND window.frame.overall.width=layer.bounds.right-layer.bounds.left
      AND window.frame.overall.height=layer.bounds.bottom-layer.bounds.top
      AND (window.frameKind=DESKTYPES.FRAME_BORDERLESS
          OR (bounds.right<=638 AND bounds.bottom<=238)) THEN
    BEGIN
      LET status=DESKMOVE.Application(desktop,window,
          bounds.left,bounds.top,request)
      RETURN(IF status=DESKTYPES.OK THEN CARD(AESTYPES.OK)
          ELSE CARD(AESTYPES.DISPLAY_ERROR) FI)
    END
  FI

  REGIONS.Copy(@bounds,@physical)
  IF window.frameKind<>DESKTYPES.FRAME_BORDERLESS THEN
    physical.right=IF bounds.right<638 THEN bounds.right+2 ELSE INT(640) FI
    physical.bottom=IF bounds.bottom<238 THEN bounds.bottom+2 ELSE INT(240) FI
  FI
  IF LAYERS.Bounds(@desktop.scene,window.layer,physical.left,physical.top,
      physical.right-physical.left,physical.bottom-physical.top)<>LAYERTYPES.OK THEN
    RETURN(AESTYPES.MALFORMED)
  FI
  GEMFRAME.SetSize(@window.frame,window.frameKind,bounds.left,bounds.top,
      bounds.right-bounds.left,bounds.bottom-bounds.top)
  AESWINDOWSTATE.LayoutChanged(item,0)
  AESWINDOWSTATE.Sync()

RETURN(AESTYPES.OK)

; Bounds and focus publication use one policy behind both transports.
PUBLIC BYTE FUNC GeometryField(INT field)

RETURN(field=AESTYPES.WF_CXYWH OR field=AESTYPES.WF_TOP)

PUBLIC CARD FUNC Geometry(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client AESTYPES.Request POINTER request)
  CARD result
  BYTE status

  LET item=AESWINDOWSTATE.Handle(client,request.intin(0))
  IF item=NULL THEN
    RETURN(AESTYPES.IDENTITY)
  FI

  LET desktop=DESKSTATE.Get()
  LET window=item
  LET layer=LAYERS.Find(@desktop.scene,window.layer)
  IF request.intin(1)=AESTYPES.WF_CXYWH THEN
    result=SetBounds(service,desktop,item,layer,request)
  ELSE
    IF layer.shown=0 THEN
      RETURN(AESTYPES.MALFORMED)
    FI
    status=DESKCORE.Top(desktop,window)
    IF status<>LAYERTYPES.OK THEN
      RETURN(AESTYPES.MALFORMED)
    FI
    AESWINDOWSTATE.Snapshot(item)
    AESWINDOWSTATE.Sync()
    result=AESTYPES.OK
  FI
  IF result=AESTYPES.OK THEN
    request.intout(0)=1
  FI

RETURN(result)

; Both transports decode hidden lifetime operations here. Caller stacks avoid
; the frame/string/effect scratch of the remaining window dispatcher.
PUBLIC CARD FUNC Lifecycle(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client AESTYPES.Request POINTER request)
  CARD result

  IF request.operation=AESTYPES.OP_CREATE THEN
    result=CreateHidden(service,client,request.view,request.intin(0),
        request.intin(1),request.intin(2),request.intin(3),request.intin(4))
    IF result=AESTYPES.OK THEN
      request.intout(0)=request.view.handle
    FI
    RETURN(result)
  FI

  LET item=AESWINDOWSTATE.Handle(client,request.intin(0))
  IF item=NULL THEN
    RETURN(AESTYPES.IDENTITY)
  FI
  result=DeleteHidden(item)
  IF result=AESTYPES.OK THEN
    request.intout(0)=1
  FI

RETURN(result)

; Both transports share metadata-only frame policy. Changed reports whether
; deferred frame work needs a wake; unchanged values retain their publication.
PUBLIC BYTE FUNC FrameField(INT field)

RETURN(field=AESTYPES.WF_NAME OR field=AESTYPES.WF_INFO
    OR field=AESTYPES.WF_VSLIDE OR field=AESTYPES.WF_VSLSIZE
    OR field=AESTYPES.WF_HSLIDE OR field=AESTYPES.WF_HSLSIZE)

PUBLIC BYTE FUNC SliderField(INT field)

RETURN(field=AESTYPES.WF_VSLIDE OR field=AESTYPES.WF_VSLSIZE
    OR field=AESTYPES.WF_HSLIDE OR field=AESTYPES.WF_HSLSIZE)

PUBLIC CARD FUNC Frame(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client AESTYPES.Request POINTER request
    BYTE POINTER changed)
  BYTE status
  BYTE POINTER title,current
  CARD length,index,component
  LONGCARD titleAddress
  LAYERTYPES.Rect bounds

  changed^=0
  LET item=AESWINDOWSTATE.Handle(client,request.intin(0))
  IF item=NULL THEN
    RETURN(AESTYPES.IDENTITY)
  FI

  LET desktop=DESKSTATE.Get()
  LET window=item
  LET layer=LAYERS.Find(@desktop.scene,window.layer)
  CASE request.intin(1) OF
  WHEN AESTYPES.WF_NAME,AESTYPES.WF_INFO THEN
    component=IF request.intin(1)=AESTYPES.WF_NAME THEN CARD(AESTYPES.NAME)
        ELSE CARD(AESTYPES.INFO) FI
    IF (window.frameKind & component)=0 THEN
      RETURN(AESTYPES.UNSUPPORTED)
    FI
    titleAddress=(LONGCARD(CARD(request.intin(2))) LSH 16)
        OR LONGCARD(CARD(request.intin(3)))
    IF titleAddress=0 OR titleAddress>$ffffff THEN
      RETURN(AESTYPES.MALFORMED)
    FI

    title=BYTE POINTER(ADDRESS(titleAddress))
    length=0
    WHILE length<DESKTYPES.TITLE_BYTES AND title(SIZE(length))<>0 DO
      length==+1
    OD

    IF length=DESKTYPES.TITLE_BYTES THEN
      RETURN(AESTYPES.MALFORMED)
    FI

    current=@window.title(0)
    IF request.intin(1)=AESTYPES.WF_INFO THEN
      current=@window.info(0)
    FI
    index=0
    WHILE index<=length AND current(SIZE(index))=title(SIZE(index)) DO
      index==+1
    OD
    IF index>length THEN
      request.intout(0)=1
      RETURN(AESTYPES.OK)
    FI
    ; Text has the same pre-mutation admission as the slider operation.
    IF request.displayGrant=NULL AND layer.shown<>0
        AND (window.iconified=0 OR request.intin(1)=AESTYPES.WF_NAME)
        AND layer.visible.count<>0 THEN
      RETURN(AESTYPES.DISPLAY_ERROR)
    FI
    REGIONS.Copy(@layer.bounds,@bounds)
    IF request.intin(1)=AESTYPES.WF_NAME THEN
      A816MEMORY.Move(@window.title(0),title,length+1)
      DESKMENU.Renamed(window.id)
      DESKGEOMETRY.ObjectRect(window,GEMOBJECTS.O_NAME,@bounds)
    ELSE
      DESKCACHE.Changed(desktop,window)
      A816MEMORY.Move(@window.info(0),title,length+1)
      DESKGEOMETRY.ObjectRect(window,GEMOBJECTS.O_INFO,@bounds)
    FI
    ; The iconified frame has no linked info object. Store the value for
    ; restoration without scheduling a physical frame repaint.
    status=LAYERTYPES.OK
    IF window.iconified=0 OR request.intin(1)=AESTYPES.WF_NAME THEN
      status=LAYERS.Invalidate(@desktop.scene,window.layer,@bounds)
    FI
  WHEN AESTYPES.WF_VSLIDE,AESTYPES.WF_VSLSIZE,AESTYPES.WF_HSLIDE,AESTYPES.WF_HSLSIZE THEN
    BEGIN
      INT POINTER position,size,target

      LET horizontal=(request.intin(1)=AESTYPES.WF_HSLIDE
          OR request.intin(1)=AESTYPES.WF_HSLSIZE)
      LET component=IF horizontal<>0 THEN CARD(AESTYPES.HSLIDE)
          ELSE CARD(AESTYPES.VSLIDE) FI
      IF (window.frameKind & component)=0 THEN
        RETURN(AESTYPES.UNSUPPORTED)
      FI
      LET value=GEMFRAME.Normalize(request.intin(2))

      IF horizontal<>0 THEN
        position=@window.frame.hslide
        size=@window.frame.hsize
      ELSE
        position=@window.frame.vslide
        size=@window.frame.vsize
      FI
      IF request.intin(1)=AESTYPES.WF_HSLIDE
          OR request.intin(1)=AESTYPES.WF_VSLIDE THEN
        target=position
      ELSE
        target=size
      FI
      IF target^=value THEN
        request.intout(0)=1
        RETURN(AESTYPES.OK)
      FI
      ; The caller must establish physical access before a visible mutation.
      ; Check authoritative state under UPDATE; C prepares a missing grant
      ; outside this handler and retries without an intermediate state change.
      IF request.displayGrant=NULL
          AND layer.shown<>0 AND window.iconified=0
          AND layer.visible.count<>0 THEN
        RETURN(AESTYPES.DISPLAY_ERROR)
      FI
      DESKCACHE.Changed(desktop,window)
      target^=value
      GEMFRAME.Slide(@window.frame,BYTE(horizontal=0))
      AESWINDOWSTATE.Sliders(window)
      ; MagiC draws O_HSCROLL/O_VSCROLL, excluding arrows and the corner.
      ; Include the object's outside frame edge, unlike its hit/drag range.
      ; An icon has no linked track: retain its value for normal restoration.
      status=LAYERTYPES.OK
      IF window.iconified=0 THEN
        IF horizontal<>0 THEN
          DESKGEOMETRY.ObjectRect(window,GEMOBJECTS.O_HSCROLL,@bounds)
        ELSE
          DESKGEOMETRY.ObjectRect(window,GEMOBJECTS.O_VSCROLL,@bounds)
        FI
        status=LAYERS.Invalidate(@desktop.scene,window.layer,@bounds)
      FI
    END
  ELSE
    RETURN(AESTYPES.UNSUPPORTED)
  ESAC

  IF status<>LAYERTYPES.OK THEN
    RETURN(AESTYPES.MALFORMED)
  FI

  IF SliderField(request.intin(1))=0 THEN
    AESWINDOWSTATE.Snapshot(item)
    AESWINDOWSTATE.Sync()
  FI
  request.intout(0)=1
  changed^=1

RETURN(AESTYPES.OK)

PUBLIC CARD FUNC Request(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client AESTYPES.Request POINTER request)
  BYTE status
  CARD result

  ; A presenter query observes one coherent stack without waiting for drawing
  ; or mouse ownership.
  IF request.operation=AESTYPES.OP_FIND THEN
    RETURN(Query(request))
  FI

  IF request.operation=AESTYPES.OP_CREATE OR request.operation=AESTYPES.OP_DELETE THEN
    RETURN(Lifecycle(service,client,request))
  FI

  IF request.operation=AESTYPES.OP_SET AND FrameField(request.intin(1))<>0 THEN
    RETURN(Frame(service,client,request,@status))
  FI

  IF request.operation=AESTYPES.OP_SET AND GeometryField(request.intin(1))<>0 THEN
    RETURN(Geometry(service,client,request))
  FI

  IF request.operation=AESTYPES.OP_OPEN OR request.operation=AESTYPES.OP_CLOSE THEN
    RETURN(Visibility(service,client,request))
  FI

  ; The common handler scope already owns UPDATE.
  LET item=AESWINDOWSTATE.Handle(client,request.intin(0))
  IF item=NULL THEN
    RETURN(AESTYPES.IDENTITY)
  FI

  IF request.operation<>AESTYPES.OP_SET THEN
    RETURN(AESTYPES.UNSUPPORTED)
  FI

  LET desktop=DESKSTATE.Get()
  LET window=item
  LET layer=LAYERS.Find(@desktop.scene,window.layer)
  status=LAYERTYPES.OK
  CASE request.intin(1) OF
  WHEN AESTYPES.WF_EXEC_FOCUS THEN
    item.focusNotices=(request.intin(2)<>0)
    IF item.focusNotices<>0 THEN
      AESGUI.Post(service,item,AESTYPES.GUI_FOCUS,
          INT(window.id=desktop.focus),0,0,0)
    FI
  WHEN AESTYPES.WF_EXEC_DESKTOP THEN
    IF window.frameKind<>DESKTYPES.FRAME_BORDERLESS
        OR (DESKSTATE.desktopWindow<>0 AND DESKSTATE.desktopWindow<>window.id) THEN
      RETURN(AESTYPES.RESOURCE)
    FI
    DESKSTATE.desktopWindow=window.id
    DESKSTATE.desktopLayer=window.layer
    status=LAYERS.Order(@desktop.scene,window.layer,0)
  ELSE
    RETURN(AESTYPES.UNSUPPORTED)
  ESAC

  IF status<>LAYERTYPES.OK THEN
    RETURN(AESTYPES.MALFORMED)
  FI

  AESWINDOWSTATE.Snapshot(item)
  AESWINDOWSTATE.Sync()
  request.intout(0)=1

RETURN(AESTYPES.OK)

ENDMODULE
