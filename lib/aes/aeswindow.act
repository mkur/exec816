; Shared GEM window policy. No application draws in this code.
MODULE AESWINDOW
USE EXEC
USE AESWAIT
USE DESKCONSOLE
USE A816MEMORY
USE AESSTATE
USE AESGATE
USE AESSNAPSHOT
USE AESTYPES
USE AESGUI
USE AESMENU
USE AESMOUSE
USE AESLOCKS
USE AESROUTES
USE AESWINDOWSTATE
USE DESKTYPES
USE DESKSTATE
USE DESKCORE
USE DESKGEOMETRY
USE DESKMENU
USE DESKCACHE
USE DESKMOVE
USE LAYERTYPES
USE LAYERS
USE REGIONS
USE HEAPCORE

PUBLIC BYTE FUNC Ready(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client)

RETURN((service.mouseOwner=0 OR service.mouseOwner=client.id)
    AND AESLOCKS.NativeReady()<>0)

BYTE FUNC Eligible(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client BYTE queued)

RETURN((queued=0 OR service.mouseOwner=client.id) AND Ready(service,client)<>0)

BYTE FUNC ValidBounds(CARD kind INT x,y,width,height
    LAYERTYPES.Rect POINTER rect)

  IF x<0 OR y<0 OR width<32 OR height<32 OR width>640 OR height>240
      OR x>640-width OR y>240-height
      OR height<=DESKGEOMETRY.Top(kind)+DESKGEOMETRY.Bottom(kind) THEN
    RETURN(0)
  FI

  IF (kind & DESKTYPES.FRAME_FULLER)<>0
      AND width<2*DESKTYPES.FRAME_GADGET_WIDTH THEN
    RETURN(0)
  FI

  IF ((kind & AESTYPES.SIZER)<>0 AND (width<DESKTYPES.FRAME_MIN_WIDTH
      OR height<DESKTYPES.FRAME_MIN_SIZE_HEIGHT))
      OR ((kind & DESKTYPES.FRAME_VERTICAL)<>0
      AND height<DESKTYPES.FRAME_MIN_SCROLL_HEIGHT
          +DESKGEOMETRY.Top(kind)-DESKTYPES.WORK_TOP) THEN
    RETURN(0)
  FI

  ; Packed pixels share bytes. Normalize once at geometry admission; work
  ; rectangles and fixed-size comparisons use the accepted dimensions.
  x=x & $fffe
  width=(width+1) & $fffe
  REGIONS.Assign(rect,x,y,x+width,y+height)

RETURN(1)

BYTE FUNC ConsoleBounds(DESKTYPES.Window POINTER window
    LAYERTYPES.Rect POINTER bounds)
  LAYERTYPES.Rect work

  IF window.console=0 THEN
    RETURN(1)
  FI
  DESKGEOMETRY.Work(window.frameKind,bounds,@work)

RETURN(work.right-work.left=512 AND work.bottom-work.top=160
    AND ((work.left OR work.top) & 7)=0)

BYTE FUNC SameSize(LAYERTYPES.Rect POINTER first,second)

RETURN(first.right-first.left=second.right-second.left
    AND first.bottom-first.top=second.bottom-second.top)

BYTE FUNC FitBounds(DESKTYPES.Window POINTER window
    LAYERTYPES.Rect POINTER current,bounds INT x,y,width,height)

RETURN(ValidBounds(window.frameKind,x,y,width,height,bounds)<>0
    AND ConsoleBounds(window,bounds)<>0
    AND ((window.frameKind & AESTYPES.SIZER)<>0 OR SameSize(current,bounds)<>0))

; The caller owns the scene and supplies the registered binding's window view.
PUBLIC CARD FUNC CreateHidden(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client AESTYPES.WindowView POINTER view
    INT kind,x,y,width,height)
  BYTE slot,status
  LAYERTYPES.Rect bounds

  IF (kind<>0 AND (CARD(kind) & AESTYPES.WINDOW_KIND)<>AESTYPES.WINDOW_KIND)
      OR (CARD(kind) & AESTYPES.WINDOW_SUPPORTED)<>CARD(kind) THEN
    RETURN(AESTYPES.UNSUPPORTED)
  FI

  IF view=NULL OR ValidBounds(CARD(kind),x,y,width,height,@bounds)=0 THEN
    RETURN(AESTYPES.MALFORMED)
  FI

  LET desktop=DESKSTATE.Get()
  IF service.nextWindow=0 OR desktop.nextWindow=0 THEN
    RETURN(AESTYPES.OVERFLOW)
  FI

  FOR slot=0 TO DESKTYPES.WINDOWS-1 DO
    IF desktop.windows(slot).id=0 THEN
      BEGIN
        LET window=@desktop.windows(slot)
        LET item=@service.windows(slot)
        status=LAYERS.Create(@desktop.scene,@bounds,@window.layer)
        IF status<>LAYERTYPES.OK THEN
          RETURN(AESTYPES.RESOURCE)
        FI

        status=LAYERS.SetExternal(@desktop.scene,window.layer)
        IF status<>LAYERTYPES.OK THEN
          HEAPCORE.Abort($fcb4)
        FI

        item.owner=client.id
        item.inputBound=0
        item.inputUnit=0
        item.geometryEpoch=0
        item.preserve=0
        item.focusNotices=0
        window.id=desktop.nextWindow
        desktop.nextWindow==+1
        window.kind=DESKTYPES.CONTENT_AES
        window.frameKind=IF kind=0 THEN CARD(DESKTYPES.FRAME_BORDERLESS)
            ELSE CARD(kind) FI
        window.visualRevision=1
        item.window=window
        item.view=view
        item.gui.window=INT(service.nextWindow)
        IF service.nextWindow=$7fff THEN
          service.nextWindow=0
        ELSE
          service.nextWindow==+1
        FI

        view.handle=item.gui.window
        view.kind=kind
        view.vslide=0
        view.vsize=1000
        DESKGEOMETRY.Slider(window,@bounds,0,1000)
        view.updates=IF service.updateOwner=client.id THEN service.updates
            ELSE CARD(0) FI
        AESWINDOWSTATE.Snapshot(item)
        RETURN(AESTYPES.OK)
      END
    FI
  OD

RETURN(AESTYPES.RESOURCE)

; Route preparation has succeeded. Publish the window and its fresh open epoch
; together under scene ownership; no route creation or draining occurs here.
PROC CommitOpen(AESSTATE.Service POINTER service AESSTATE.Client POINTER client
    AESSTATE.Window POINTER item LAYERTYPES.Rect POINTER bounds LONGCARD route)

  LET desktop=DESKSTATE.Get()
  LET window=item.window
  DESKCORE.PrepareFocus(desktop,window.id)
  window.keyRoute=route
  AESGUI.Open(service,client,item)
  IF LAYERS.Bounds(@desktop.scene,window.layer,bounds.left,bounds.top,
      bounds.right-bounds.left,bounds.bottom-bounds.top)<>LAYERTYPES.OK
      OR DESKSTATE.PrepareOpen(window.layer)<>LAYERTYPES.OK
      OR LAYERS.Show(@desktop.scene,window.layer,1)<>LAYERTYPES.OK THEN
    HEAPCORE.Abort($fcb5)
  FI
  DESKCORE.CommitFocus(desktop,window.id)
  IF client.closeRequested<>0 THEN
    AESGUI.Post(service,item,AESTYPES.GUI_CLOSED,0,0,0,0)
  FI
  AESWINDOWSTATE.Geometry(item,0)
  AESWINDOWSTATE.Sync()

RETURN

PROC DiscardRoute(AESTYPES.Request POINTER request LONGCARD route)

  IF route<>0 THEN
    BEGIN
      LET held=AESGATE.Leave()
      AESROUTES.Discard(route)
      AESGATE.Reenter(held,request)
    END
  FI

RETURN

CARD FUNC Open(AESSTATE.Service POINTER service AESSTATE.Client POINTER client
    AESSTATE.Window POINTER item AESTYPES.Request POINTER request)
  LAYERTYPES.Rect bounds
  LONGCARD route

  LET desktop=DESKSTATE.Get()
  LET window=item.window
  LET layer=LAYERS.Find(@desktop.scene,window.layer)
  ; A retained close keeps its hidden window until the old input tag retires.
  IF layer.shown<>0 OR window.keyRoute<>0 THEN
    RETURN(AESTYPES.BUSY)
  FI

  IF FitBounds(window,@layer.bounds,@bounds,request.intin(1),request.intin(2),
      request.intin(3),request.intin(4))=0 THEN
    RETURN(AESTYPES.MALFORMED)
  FI

  LET caller=AESGATE.SystemOwned()=0
  IF caller<>0 AND (window.console<>0
      OR DESKCORE.FocusMetadataReady(desktop,window.id)=0) THEN
    RETURN(AESWAIT.SYSTEM_WORK)
  FI

  LET held=AESGATE.Leave()
  LET status=AESROUTES.Prepare(window,@route)
  AESGATE.Reenter(held,request)
  IF caller<>0 THEN
    BEGIN
      LET eligible=Eligible(service,client,AESWAIT.Older(service,client))
      IF eligible=0 OR DESKCORE.FocusMetadataReady(desktop,window.id)=0 THEN
        DiscardRoute(request,route)
        RETURN(IF eligible=0 THEN CARD(AESTYPES.PENDING) ELSE CARD(AESWAIT.SYSTEM_WORK) FI)
      FI
    END
  FI
  IF status<>AESTYPES.OK THEN
    RETURN(status)
  FI
  IF service.nextGuiEpoch=0 THEN
    DiscardRoute(request,route)
    RETURN(AESTYPES.OVERFLOW)
  FI
  CommitOpen(service,client,item,@bounds,route)

RETURN(AESTYPES.OK)

; Close withdraws the window and capture route before draining the old tag.
; The hidden record retains that tag until the input service retires it.
PROC CommitClose(DESKTYPES.Service POINTER desktop
    AESSTATE.Window POINTER item LONGCARD focus)

  LET window=item.window
  AESMOUSE.CancelWindow(item.view.epoch)
  AESGUI.Close(item)
  BEGIN
    LET client=AESSTATE.Find(AESSTATE.Get(),item.owner)
    IF client.endpoint.guiEpoch=0 THEN
      AESMENU.Close(AESSTATE.Get(),client)
    FI
  END
  item.paintDirty=0
  IF LAYERS.Show(@desktop.scene,window.layer,0)<>LAYERTYPES.OK THEN
    HEAPCORE.Abort($fcb5)
  FI
  DESKCORE.ForgetIcon(desktop,window)
  DESKCORE.CommitFocus(desktop,focus)
  AESWINDOWSTATE.Snapshot(item)
  AESWINDOWSTATE.Sync()

RETURN

CARD FUNC Close(AESSTATE.Window POINTER item AESTYPES.Request POINTER request)

  LET desktop=DESKSTATE.Get()
  LET window=item.window
  IF window.console<>0 AND AESGATE.SystemOwned()=0 THEN
    RETURN(AESWAIT.SYSTEM_WORK)
  FI
  LET layer=LAYERS.Find(@desktop.scene,window.layer)
  IF layer.shown<>0 OR window.keyRoute=0 THEN
    BEGIN
      LET focus=DESKCORE.NextFocus(desktop,window.id)
      IF AESGATE.SystemOwned()=0
          AND DESKCORE.FocusMetadataReady(desktop,focus)=0 THEN
        RETURN(AESWAIT.SYSTEM_WORK)
      FI
      DESKCORE.PrepareFocus(desktop,focus)
      CommitClose(desktop,item,focus)
      AESSNAPSHOT.Publish()
    END
  FI

  IF AESROUTES.Retire(window,request)=0 THEN
    RETURN(IF AESGATE.SystemOwned()<>0 THEN CARD(AESTYPES.PENDING)
        ELSE CARD(AESWAIT.SYSTEM_WORK) FI)
  FI

RETURN(AESTYPES.OK)

; Both transports use the same admission and scene publication policy.
PUBLIC CARD FUNC Visibility(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client AESTYPES.Request POINTER request BYTE queued)
  CARD status

  IF Eligible(service,client,queued)=0 THEN
    RETURN(AESTYPES.PENDING)
  FI
  LET item=AESWINDOWSTATE.Handle(client,request.intin(0))
  IF item=NULL THEN
    RETURN(AESTYPES.IDENTITY)
  FI
  IF request.operation=AESTYPES.OP_OPEN THEN
    status=Open(service,client,item,request)
  ELSE
    status=Close(item,request)
  FI
  IF status=AESTYPES.OK THEN
    request.intout(0)=1
  FI

RETURN(status)

; Called after hiding and route retirement, with the presenter settled.
PROC Destroy(AESSTATE.Window POINTER item)
  BYTE status

  LET desktop=DESKSTATE.Get()
  IF item.window.console<>0 THEN
    BEGIN
      LET view=DESKCONSOLE.PrepareRelease(item.window.console)
      DESKCONSOLE.Release(item.window,view)
    END
  FI
  AESMOUSE.CancelWindow(item.view.epoch)
  AESGUI.Close(item)
  status=LAYERS.Delete(@desktop.scene,item.window.layer)
  IF status<>LAYERTYPES.OK THEN
    HEAPCORE.Abort($fcb6)
  FI

  IF DESKSTATE.desktopWindow=item.window.id THEN
    DESKSTATE.desktopWindow=0
    DESKSTATE.desktopLayer=0
  FI
  DESKCACHE.ForgetCandidate(desktop,item.window)
  A816MEMORY.Clear(BYTE POINTER(item.window),DESKTYPES.WINDOW_SIZE)
  item.view.handle=0
  item.view.visibleCount=0
  item.view.shown=0
  item.owner=0
  item.inputBound=0
  item.inputUnit=0
  item.geometryEpoch=0
  item.preserve=0
  item.focusNotices=0
  item.window=NULL
  item.view=NULL
  item.gui.window=0

RETURN

PUBLIC CARD FUNC DeleteHidden(AESSTATE.Window POINTER item)

  LET desktop=DESKSTATE.Get()
  LET layer=LAYERS.Find(@desktop.scene,item.window.layer)
  ; Hidden alone does not authorize freeing a retained close continuation.
  IF layer.shown<>0 OR item.window.keyRoute<>0 THEN
    RETURN(AESTYPES.BUSY)
  FI

  Destroy(item)
  AESWINDOWSTATE.Sync()

RETURN(AESTYPES.OK)

PUBLIC BYTE FUNC Retire(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client AESTYPES.Request POINTER request)
  BYTE slot

  IF Ready(service,client)=0 THEN
    RETURN(0)
  FI
  DESKMOVE.Forget(client.binding)
  FOR slot=0 TO AESTYPES.WINDOWS-1 DO
    IF service.windows(slot).owner=client.id THEN
      BEGIN
        LET item=@service.windows(slot)
        IF Close(item,request)<>AESTYPES.OK THEN
          RETURN(0)
        FI
        Destroy(item)
      END
    FI
  OD
  AESWINDOWSTATE.Sync()

RETURN(1)

; A topmost native window, desktop, tile or chrome hit yields no GEM handle.
INT FUNC FindAt(INT x,y)

  LET desktop=DESKSTATE.Get()
  LET layer=LAYERS.Hit(@desktop.scene,x,y)
  LET hit=AESWINDOWSTATE.FindWindow(layer)
  LET found=AESWINDOWSTATE.FindRecord(hit)
  IF found<>NULL AND hit<>DESKSTATE.desktopWindow
      AND found.window.iconified=0 THEN
    RETURN(found.gui.window)
  FI

RETURN(0)

; Queries share the committed stack; drawing and logical waiters do not bar it.
PUBLIC CARD FUNC Query(AESTYPES.Request POINTER request)

  request.intout(0)=FindAt(request.intin(0),request.intin(1))

RETURN(AESTYPES.OK)

CARD FUNC SetBounds(AESSTATE.Service POINTER service
    DESKTYPES.Service POINTER desktop AESSTATE.Window POINTER item
    LAYERTYPES.Layer POINTER layer AESTYPES.Request POINTER request)
  LAYERTYPES.Rect bounds
  LAYERTYPES.Rect POINTER current

  LET window=item.window
  current=@layer.bounds
  IF window.iconified<>0 THEN
    current=@window.normalBounds
  FI
  IF FitBounds(window,current,@bounds,request.intin(2),request.intin(3),
      request.intin(4),request.intin(5))=0 THEN
    RETURN(AESTYPES.MALFORMED)
  FI

  LET same=SameSize(current,@bounds)
  IF window.iconified<>0 THEN
    IF same=0 THEN
      DESKCACHE.Changed(desktop,window)
    FI
    REGIONS.Copy(@bounds,current)
    AESWINDOWSTATE.Snapshot(item)
    RETURN(AESTYPES.OK)
  FI

  IF same<>0 AND service.updateOwner=0 THEN
    IF AESGATE.SystemOwned()<>0 THEN
      BEGIN
        LET status=DESKMOVE.Application(desktop,window,
            bounds.left,bounds.top,request)
        IF status=DESKTYPES.PENDING THEN
          RETURN(AESTYPES.PENDING)
        FI
        IF status<>DESKTYPES.OK THEN
          RETURN(AESTYPES.DISPLAY_ERROR)
        FI
        RETURN(AESTYPES.OK)
      END
    ELSEIF layer.shown<>0 AND
        (bounds.left<>current.left OR bounds.top<>current.top)
        AND DESKMOVE.CopyEligible(window,layer,bounds.left)<>0 THEN
      ; The presenter retains copy identity, frozen pixels and its continuation.
      ; Retain an explicit system continuation before physical preparation.
      RETURN(AESWAIT.SYSTEM_WORK)
    FI
  FI

  IF LAYERS.Bounds(@desktop.scene,window.layer,bounds.left,bounds.top,
      bounds.right-bounds.left,bounds.bottom-bounds.top)<>LAYERTYPES.OK THEN
    RETURN(AESTYPES.MALFORMED)
  FI
  AESWINDOWSTATE.Geometry(item,0)
  AESWINDOWSTATE.Sync()

RETURN(AESTYPES.OK)

; The system only wakes metadata waiters. The caller rechecks and commits.
PUBLIC BYTE FUNC WaitReady(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client)

RETURN(Eligible(service,client,client.windowLocks<>0))

; Bounds and focus publication use one policy behind both transports.
PUBLIC BYTE FUNC GeometryField(INT field)

RETURN(field=AESTYPES.WF_CXYWH OR field=AESTYPES.WF_TOP)

PUBLIC CARD FUNC Geometry(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client AESTYPES.Request POINTER request BYTE queued)
  CARD result
  BYTE status

  IF Eligible(service,client,queued)=0 THEN
    RETURN(AESTYPES.PENDING)
  FI
  LET item=AESWINDOWSTATE.Handle(client,request.intin(0))
  IF item=NULL THEN
    RETURN(AESTYPES.IDENTITY)
  FI
  IF item.window.console<>0 AND AESGATE.SystemOwned()=0 THEN
    RETURN(AESWAIT.SYSTEM_WORK)
  FI

  LET desktop=DESKSTATE.Get()
  LET window=item.window
  LET layer=LAYERS.Find(@desktop.scene,window.layer)
  IF request.intin(1)=AESTYPES.WF_CXYWH THEN
    result=SetBounds(service,desktop,item,layer,request)
  ELSE
    IF layer.shown=0 THEN
      RETURN(AESTYPES.MALFORMED)
    FI
    IF AESGATE.SystemOwned()=0
        AND DESKCORE.FocusMetadataReady(desktop,window.id)=0 THEN
      RETURN(AESWAIT.SYSTEM_WORK)
    FI
    status=DESKCORE.Top(desktop,window)
    IF status<>LAYERTYPES.OK THEN
      RETURN(AESTYPES.MALFORMED)
    FI
    AESWINDOWSTATE.Snapshot(item)
    AESWINDOWSTATE.Sync()
    result=AESTYPES.OK
  FI
  IF result=AESTYPES.OK THEN
    request.intout(0)=1
  FI

RETURN(result)

; Both transports decode hidden lifetime operations here. Caller stacks avoid
; the frame/string/effect scratch of the remaining window dispatcher.
PUBLIC CARD FUNC Lifecycle(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client AESTYPES.Request POINTER request BYTE queued)
  CARD result

  IF Eligible(service,client,queued)=0 THEN
    RETURN(AESTYPES.PENDING)
  FI

  IF request.operation=AESTYPES.OP_CREATE THEN
    result=CreateHidden(service,client,request.view,request.intin(0),
        request.intin(1),request.intin(2),request.intin(3),request.intin(4))
    IF result=AESTYPES.OK THEN
      request.intout(0)=request.view.handle
    FI
    RETURN(result)
  FI

  LET item=AESWINDOWSTATE.Handle(client,request.intin(0))
  IF item=NULL THEN
    RETURN(AESTYPES.IDENTITY)
  FI
  ; Console attachments still retire through the presenter: PrepareRelease
  ; can erase a physical caret and is outside the caller metadata subset.
  IF item.window.console<>0 AND AESGATE.SystemOwned()=0 THEN
    RETURN(AESWAIT.SYSTEM_WORK)
  FI
  result=DeleteHidden(item)
  IF result=AESTYPES.OK THEN
    request.intout(0)=1
  FI

RETURN(result)

; Both transports share metadata-only frame policy. Changed reports whether
; deferred frame work needs a wake; unchanged values retain their publication.
PUBLIC BYTE FUNC FrameField(INT field)

RETURN(field=AESTYPES.WF_NAME OR field=AESTYPES.WF_INFO
    OR field=AESTYPES.WF_VSLIDE OR field=AESTYPES.WF_VSLSIZE)

PUBLIC CARD FUNC Frame(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client AESTYPES.Request POINTER request
    BYTE queued BYTE POINTER changed)
  BYTE status
  BYTE POINTER title,current
  CARD length,index
  LONGCARD titleAddress
  LAYERTYPES.Rect bounds

  changed^=0
  IF Eligible(service,client,queued)=0 THEN
    RETURN(AESTYPES.PENDING)
  FI

  LET item=AESWINDOWSTATE.Handle(client,request.intin(0))
  IF item=NULL THEN
    RETURN(AESTYPES.IDENTITY)
  FI

  LET desktop=DESKSTATE.Get()
  LET window=item.window
  LET layer=LAYERS.Find(@desktop.scene,window.layer)
  CASE request.intin(1) OF
  WHEN AESTYPES.WF_NAME,AESTYPES.WF_INFO THEN
    titleAddress=(LONGCARD(CARD(request.intin(2))) LSH 16)
        OR LONGCARD(CARD(request.intin(3)))
    IF titleAddress=0 OR titleAddress>$ffffff THEN
      RETURN(AESTYPES.MALFORMED)
    FI

    title=BYTE POINTER(ADDRESS(titleAddress))
    length=0
    WHILE length<DESKTYPES.TITLE_BYTES AND title(SIZE(length))<>0 DO
      length==+1
    OD

    IF length=DESKTYPES.TITLE_BYTES THEN
      RETURN(AESTYPES.MALFORMED)
    FI

    current=@window.title(0)
    IF request.intin(1)=AESTYPES.WF_INFO THEN
      current=@window.info(0)
    FI
    index=0
    WHILE index<=length AND current(SIZE(index))=title(SIZE(index)) DO
      index==+1
    OD
    IF index>length THEN
      request.intout(0)=1
      RETURN(AESTYPES.OK)
    FI
    REGIONS.Copy(@layer.bounds,@bounds)
    IF request.intin(1)=AESTYPES.WF_NAME THEN
      A816MEMORY.Move(@window.title(0),title,length+1)
      DESKMENU.Renamed(window.id)
      bounds.bottom=bounds.top+DESKTYPES.TITLE_HEIGHT
    ELSE
      DESKCACHE.Changed(desktop,window)
      A816MEMORY.Move(@window.info(0),title,length+1)
      bounds.top==+DESKTYPES.TITLE_HEIGHT
      bounds.bottom=bounds.top+DESKTYPES.FRAME_INFO_HEIGHT
    FI
    status=LAYERS.Invalidate(@desktop.scene,window.layer,@bounds)
  WHEN AESTYPES.WF_VSLIDE,AESTYPES.WF_VSLSIZE THEN
    IF (window.frameKind & AESTYPES.VSLIDE)=0 THEN
      RETURN(AESTYPES.UNSUPPORTED)
    FI
    IF request.intin(2)<0 OR request.intin(2)>1000 THEN
      RETURN(AESTYPES.MALFORMED)
    FI
    IF (request.intin(1)=AESTYPES.WF_VSLIDE AND item.view.vslide=request.intin(2))
        OR (request.intin(1)=AESTYPES.WF_VSLSIZE AND item.view.vsize=request.intin(2)) THEN
      request.intout(0)=1
      RETURN(AESTYPES.OK)
    FI
    DESKCACHE.Changed(desktop,window)
    IF request.intin(1)=AESTYPES.WF_VSLIDE THEN
      item.view.vslide=request.intin(2)
    ELSE
      item.view.vsize=request.intin(2)
    FI
    REGIONS.Assign(@bounds,layer.bounds.right-DESKTYPES.FRAME_GADGET_WIDTH,
        layer.bounds.top+DESKTYPES.TITLE_HEIGHT,layer.bounds.right,
        layer.bounds.bottom)
    status=LAYERS.Invalidate(@desktop.scene,window.layer,@bounds)
  ELSE
    RETURN(AESTYPES.UNSUPPORTED)
  ESAC

  IF status<>LAYERTYPES.OK THEN
    RETURN(AESTYPES.MALFORMED)
  FI

  IF window.iconified=0 AND (request.intin(1)=AESTYPES.WF_VSLIDE
      OR request.intin(1)=AESTYPES.WF_VSLSIZE) THEN
    AESWINDOWSTATE.Geometry(item,0)
  ELSE
    AESWINDOWSTATE.Snapshot(item)
  FI
  AESWINDOWSTATE.Sync()
  request.intout(0)=1
  changed^=1

RETURN(AESTYPES.OK)

PUBLIC CARD FUNC Request(AESSTATE.Service POINTER service
    AESSTATE.Client POINTER client AESTYPES.Request POINTER request BYTE queued)
  BYTE status
  CARD result

  ; A presenter query observes one coherent stack without waiting for drawing
  ; or mouse ownership.
  IF request.operation=AESTYPES.OP_FIND THEN
    RETURN(Query(request))
  FI

  IF request.operation=AESTYPES.OP_CREATE OR request.operation=AESTYPES.OP_DELETE THEN
    RETURN(Lifecycle(service,client,request,queued))
  FI

  IF request.operation=AESTYPES.OP_SET AND FrameField(request.intin(1))<>0 THEN
    RETURN(Frame(service,client,request,queued,@status))
  FI

  IF request.operation=AESTYPES.OP_SET AND GeometryField(request.intin(1))<>0 THEN
    RETURN(Geometry(service,client,request,queued))
  FI

  IF request.operation=AESTYPES.OP_OPEN OR request.operation=AESTYPES.OP_CLOSE THEN
    RETURN(Visibility(service,client,request,queued))
  FI

  ; An existing owner may finish mutations before dependent older waiters.
  IF Eligible(service,client,queued)=0 THEN
    RETURN(AESTYPES.PENDING)
  FI

  LET item=AESWINDOWSTATE.Handle(client,request.intin(0))
  IF item=NULL THEN
    RETURN(AESTYPES.IDENTITY)
  FI

  IF request.operation<>AESTYPES.OP_SET THEN
    RETURN(AESTYPES.UNSUPPORTED)
  FI

  LET desktop=DESKSTATE.Get()
  LET window=item.window
  LET layer=LAYERS.Find(@desktop.scene,window.layer)
  status=LAYERTYPES.OK
  CASE request.intin(1) OF
  WHEN AESTYPES.WF_EXEC_CONSOLE THEN
    BEGIN
      LET unit=(LONGCARD(CARD(request.intin(2))) LSH 16)
          OR LONGCARD(CARD(request.intin(3)))
      LET bound=DESKCONSOLE.Attach(window,unit,client.binding.owner)
      IF bound=DESKTYPES.BUSY THEN
        RETURN(AESTYPES.PENDING)
      ELSEIF bound<>DESKTYPES.OK THEN
        RETURN(AESTYPES.MALFORMED)
      FI
    END
  WHEN AESTYPES.WF_EXEC_FOCUS THEN
    item.focusNotices=(request.intin(2)<>0)
    IF item.focusNotices<>0 THEN
      AESGUI.Post(service,item,AESTYPES.GUI_FOCUS,
          INT(window.id=desktop.focus),0,0,0)
    FI
  WHEN AESTYPES.WF_EXEC_PRESERVE THEN
    ; Set before opening. Reporting every content change is the caller's
    ; promise; this changes exposure policy, not snapshot eligibility.
    item.preserve=(request.intin(2)<>0)
  WHEN AESTYPES.WF_EXEC_DESKTOP THEN
    IF window.frameKind<>DESKTYPES.FRAME_BORDERLESS
        OR (DESKSTATE.desktopWindow<>0 AND DESKSTATE.desktopWindow<>window.id) THEN
      RETURN(AESTYPES.RESOURCE)
    FI
    DESKSTATE.desktopWindow=window.id
    DESKSTATE.desktopLayer=window.layer
    status=LAYERS.Order(@desktop.scene,window.layer,0)
  ELSE
    RETURN(AESTYPES.UNSUPPORTED)
  ESAC

  IF status<>LAYERTYPES.OK THEN
    RETURN(AESTYPES.MALFORMED)
  FI

  AESWINDOWSTATE.Snapshot(item)
  AESWINDOWSTATE.Sync()
  request.intout(0)=1

RETURN(AESTYPES.OK)

ENDMODULE
