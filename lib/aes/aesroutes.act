; Window route resources stay separate from scene and GUI publication.
; UPDATE pins window records; the independent input Task drains capture.
MODULE AESROUTES
USE INPUT
USE INPUTCLIENT
USE AESSTATE
USE AESTYPES
USE DESKTYPES
USE DESKSTATE
USE HEAPCORE

; The operation keeps this unpublished tag until its UPDATE-owned commit.
PUBLIC CARD FUNC Prepare(DESKTYPES.Window POINTER window LONGCARD POINTER route)
  CARD status

  LET desktop=DESKSTATE.Get()
  LET keyboard=desktop.keyboard
  route^=0
  status=INPUTCLIENT.CreateRoute(keyboard,INPUT.SOURCE_KEYBOARD,INPUT.ROUTE_UNFILTERED,route)
  IF status<>INPUT.OK THEN
    RETURN(AESTYPES.RESOURCE)
  FI

RETURN(AESTYPES.OK)

; Unpublished tags have no capture references. The caller owns this rollback.
PUBLIC PROC Discard(LONGCARD route)

  IF route<>0 THEN
    BEGIN
      LET desktop=DESKSTATE.Get()
      IF INPUTCLIENT.RetireRoute(desktop.keyboard,INPUT.SOURCE_KEYBOARD,route)<>INPUT.OK THEN
        HEAPCORE.Abort($fcc2)
      FI
    END
  FI

RETURN

; The scene has withdrawn the window and published its replacement focus.
; Retain the hidden window and tag across a busy input retirement retry.
; Callers use the shared device control handle; BUSY keeps its existing
; RPC drain continuation, including the retained window/view lifetime.
PUBLIC BYTE FUNC Retire(DESKTYPES.Window POINTER window)

  IF window.keyRoute=0 THEN
    RETURN(1)
  FI

  LET desktop=DESKSTATE.Get()
  LET result=INPUTCLIENT.RetireRoute(desktop.keyboard,INPUT.SOURCE_KEYBOARD,
      window.keyRoute)
  IF result=INPUT.BUSY THEN
    RETURN(0)
  FI
  IF result<>INPUT.OK THEN
    HEAPCORE.Abort($fcc2)
  FI
  window.keyRoute=0

RETURN(1)

ENDMODULE
