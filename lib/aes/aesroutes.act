; Window route resources stay separate from scene and GUI publication.
; Preparation/rollback run outside the scene; only the presenter drains input.
MODULE AESROUTES
USE INPUT
USE CONSOLEINPUT
USE AESSTATE
USE AESTYPES
USE AESGATE
USE DESKTYPES
USE DESKSTATE
USE DESKROUTES
USE HEAPCORE

; The operation keeps this unpublished tag across scene re-admission.
PUBLIC CARD FUNC Prepare(DESKTYPES.Window POINTER window LONGCARD POINTER route)
  CARD status

  LET desktop=DESKSTATE.Get()
  LET keyboard=INPUT.Lease POINTER(desktop.keyboard)
  route^=0
  IF window.console=0 THEN
    status=INPUT.CreateRoute(keyboard,INPUT.ROUTE_UNFILTERED,route)
    IF status<>INPUT.OK THEN
      RETURN(AESTYPES.RESOURCE)
    FI
  FI

RETURN(AESTYPES.OK)

; Unpublished tags have no capture references. The caller owns this rollback.
PUBLIC PROC Discard(LONGCARD route)

  IF route<>0 THEN
    BEGIN
      LET desktop=DESKSTATE.Get()
      IF INPUT.RetireRoute(INPUT.Lease POINTER(desktop.keyboard),route)<>INPUT.OK THEN
        HEAPCORE.Abort($fcc2)
      FI
    END
  FI

RETURN

; The scene has withdrawn the window and published its replacement focus.
; Retain the hidden window and tag across a busy input retirement retry.
PUBLIC BYTE FUNC Retire(DESKTYPES.Window POINTER window)
  CARD captured

  IF window.keyRoute=0 THEN
    RETURN(1)
  FI

  LET desktop=DESKSTATE.Get()
  LET held=AESGATE.Suspend()
  captured=CONSOLEINPUT.Pump(NULL)
  LET result=DESKROUTES.Retire(INPUT.Lease POINTER(desktop.keyboard),
      window.keyRoute)
  AESGATE.Resume(held)
  IF result=INPUT.BUSY THEN
    RETURN(0)
  FI
  IF result<>INPUT.OK THEN
    HEAPCORE.Abort($fcc2)
  FI
  window.keyRoute=0

RETURN(1)

ENDMODULE
