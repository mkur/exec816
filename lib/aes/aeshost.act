; Presenter-owned hooks. Failed optional AES setup leaves native GUI available.
MODULE AESHOST
USE EXEC
USE DISPLAY
USE EXECLISTS
USE AESSTATE
USE AESTYPES
USE AESCORE
USE HEAPCORE
USE AESLOCKS
USE AESMOUSE
USE AESCURSOR
USE AESWINDOWSTATE
USE AESSNAPSHOT
USE DESKSTATE
USE DESKDRAG
USE CONSOLEBITMAP
USE CONSOLEDISPLAY

PUBLIC PROC Start()
  BYTE bit

  LET service=AESSTATE.Get()
  IF service=NULL THEN
    RETURN
  FI

  bit=EXEC.AllocSignal(-1)
  IF bit=$ff THEN
    service.error=AESTYPES.RESOURCE
    RETURN
  FI

  IF AESCORE.Init(service,bit)=0 THEN
    EXEC.FreeSignal(bit)
    service.error=AESTYPES.RESOURCE
  ELSE
    service.live=1
  FI

RETURN

PUBLIC LONGCARD FUNC Mask()

  LET service=AESSTATE.Get()
  IF service=NULL THEN
    RETURN(0)
  FI

RETURN(service.mask)

PUBLIC BYTE FUNC Runnable()

  LET service=AESSTATE.Get()
  IF service=NULL OR service.live=0 THEN
    RETURN(0)
  FI

RETURN(AESCORE.Runnable(service))

PUBLIC BYTE FUNC Wake()
  BYTE changed

  LET service=AESSTATE.Get()
  IF service=NULL OR service.live=0 THEN
    RETURN(0)
  FI

  changed=service.directory.changed<>0
  IF changed=0 THEN
    RETURN(0)
  FI

  ; Caller-side loss recovery uses this existing publication wake too.
  AESSTATE.mouseDirty=1
  AESCORE.Wake(service)

RETURN(changed)

PUBLIC BYTE FUNC Idle()

  LET service=AESSTATE.Get()
  IF service=NULL OR service.live=0 THEN
    RETURN(1)
  FI

RETURN(AESCORE.Idle(service))

; No live scene read or UPDATE acquisition: wake caller-owned continuations
; and retire an application-owned outline before its drawing can resume.
PUBLIC PROC Service()

  LET service=AESSTATE.Get()
  IF service=NULL OR service.live=0 THEN
    RETURN
  FI
  BEGIN
    LET changed=Wake()
  END
  IF DESKDRAG.Application()<>0 THEN
    DESKDRAG.Suspend()
  FI
  AESCORE.Settle(service)
  AESMOUSE.RefreshSnapshot()

RETURN

; The manager calls this only inside its actual interaction's UPDATE scope.
PUBLIC PROC Commit()

  AESWINDOWSTATE.Sync()
  AESMOUSE.Refresh()
  AESSNAPSHOT.Publish()

RETURN

PUBLIC PROC Stop()

  LET service=AESSTATE.Get()
  IF service=NULL OR service.live=0 THEN
    RETURN
  FI

  IF Idle()=0 OR AESCORE.Stop(service)=0 THEN
    HEAPCORE.Abort($fca0)
  FI

  EXEC.FreeSignal(service.port.mp_SigBit)
  service.mask=0
  service.port.mp_SigTask=NULL
  ; Last access: the controller may free storage after observing retirement.
  service.owner=NULL

RETURN

ENDMODULE
