; Presenter-owned hooks. Failed optional AES setup leaves native GUI available.
MODULE AESHOST
USE EXEC
USE EXECLISTS
USE AESSTATE
USE AESTYPES
USE AESCORE
USE HEAPCORE
USE AESLOCKS
USE AESWINDOWSTATE
USE DESKSTATE
USE DESKDRAG
USE CONSOLEBITMAP
USE CONSOLEDISPLAY

PUBLIC PROC Start()
  BYTE bit

  LET service=AESSTATE.Get()
  IF service=NULL THEN
    RETURN
  FI

  bit=EXEC.AllocSignal(-1)
  IF bit=$ff THEN
    service.error=AESTYPES.RESOURCE
    RETURN
  FI

  IF AESCORE.Init(service,bit)=0 THEN
    EXEC.FreeSignal(bit)
    service.error=AESTYPES.RESOURCE
  ELSE
    service.live=1
  FI

RETURN

PUBLIC LONGCARD FUNC Mask()

  LET service=AESSTATE.Get()
  IF service=NULL THEN
    RETURN(0)
  FI

RETURN(service.mask)

PUBLIC BYTE FUNC Pump(BYTE budget)

  LET service=AESSTATE.Get()
  IF service=NULL OR service.live=0
      OR EXECLISTS.IsListEmpty(@service.port.mp_MsgList)<>0 THEN
    RETURN(0)
  FI

RETURN(AESCORE.Pump(service,budget))

PUBLIC BYTE FUNC Runnable()

  LET service=AESSTATE.Get()
  IF service=NULL OR service.live=0 THEN
    RETURN(0)
  FI

RETURN(AESCORE.Runnable(service))

PUBLIC BYTE FUNC Wake()
  BYTE changed

  LET service=AESSTATE.Get()
  IF service=NULL OR service.live=0 THEN
    RETURN(0)
  FI

  changed=service.directory.changed<>0
  IF changed=0 THEN
    RETURN(0)
  FI

  AESCORE.Wake(service)

RETURN(changed)

PUBLIC BYTE FUNC Idle()

  LET service=AESSTATE.Get()
  IF service=NULL OR service.live=0 THEN
    RETURN(1)
  FI

RETURN(AESCORE.Idle(service))

; After this turn's native continuation/cursor work, prepare and grant pending
; locks before deciding to sleep. No additional message admissions occur here.
PUBLIC PROC Settle()

  LET service=AESSTATE.Get()
  IF service=NULL OR service.live=0 THEN
    RETURN
  FI

  AESWINDOWSTATE.Sync()
  IF service.lockCount=0 AND service.windowPending=0 THEN
    RETURN
  FI

  LET desktop=DESKSTATE.Get()
  IF desktop.scene.busy=0 AND CONSOLEBITMAP.Pending()=0 THEN
    ; Abandon gathered pixel reuse while retaining the model and I/O request.
    CONSOLEDISPLAY.DiscardBatch()
    DESKDRAG.Suspend()
  FI

  AESCORE.Settle(service)
  AESLOCKS.Wake(service)

RETURN

PUBLIC PROC Stop()

  LET service=AESSTATE.Get()
  IF service=NULL OR service.live=0 THEN
    RETURN
  FI

  IF Idle()=0 OR AESCORE.Stop(service)=0 THEN
    HEAPCORE.Abort($fca0)
  FI

  EXEC.FreeSignal(service.port.mp_SigBit)
  service.mask=0
  service.port.mp_SigTask=NULL
  ; Last access: the controller may free storage after observing retirement.
  service.owner=NULL

RETURN

ENDMODULE
