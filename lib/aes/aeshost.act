; Presenter-owned hooks. Failed optional AES setup leaves native GUI available.
MODULE AESHOST
USE EXEC
USE DISPLAY
USE EXECLISTS
USE AESSTATE
USE AESTYPES
USE AESCORE
USE HEAPCORE
USE AESLOCKS
USE AESMOUSE
USE AESCURSOR
USE AESWINDOWSTATE
USE AESSNAPSHOT
USE DESKSTATE
USE DESKDRAG
USE CONSOLEBITMAP
USE CONSOLEDISPLAY

PUBLIC PROC Start()
  BYTE bit

  LET service=AESSTATE.Get()
  IF service=NULL THEN
    RETURN
  FI

  bit=EXEC.AllocSignal(-1)
  IF bit=$ff THEN
    service.error=AESTYPES.RESOURCE
    RETURN
  FI

  IF AESCORE.Init(service,bit)=0 THEN
    EXEC.FreeSignal(bit)
    service.error=AESTYPES.RESOURCE
  ELSE
    service.live=1
  FI

RETURN

PUBLIC LONGCARD FUNC Mask()

  LET service=AESSTATE.Get()
  IF service=NULL THEN
    RETURN(0)
  FI

RETURN(service.mask)

PUBLIC BYTE FUNC Pump(BYTE budget)

  LET service=AESSTATE.Get()
  IF service=NULL OR service.live=0
      OR EXECLISTS.IsListEmpty(@service.port.mp_MsgList)<>0 THEN
    RETURN(0)
  FI

RETURN(AESCORE.Pump(service,budget))

PUBLIC BYTE FUNC Runnable()

  LET service=AESSTATE.Get()
  IF service=NULL OR service.live=0 THEN
    RETURN(0)
  FI

RETURN(AESCORE.Runnable(service))

; A notification-only turn may sleep again once cache maintenance finishes.
; Called with the policy gate closed; all omitted settlement must be a no-op.
BYTE FUNC InspectSettled()

  LET service=AESSTATE.Get()
  LET desktop=DESKSTATE.Get()

RETURN(service<>NULL AND service.live=1
    AND service.windowPending=0 AND AESSTATE.mouseDirty=0
    AND AESCURSOR.Pending()=0
    AND AESCORE.Runnable(service)=0 AND desktop<>NULL
    AND service.windowRevision=desktop.scene.rebuilds
    AND service.windowFocus=desktop.focus)

PUBLIC BYTE FUNC Wake()
  BYTE changed

  LET service=AESSTATE.Get()
  IF service=NULL OR service.live=0 THEN
    RETURN(0)
  FI

  changed=service.directory.changed<>0
  IF changed=0 THEN
    RETURN(0)
  FI

  ; Caller-side loss recovery uses this existing publication wake too.
  AESSTATE.mouseDirty=1
  AESCORE.Wake(service)

RETURN(changed)

PUBLIC BYTE FUNC Idle()

  LET service=AESSTATE.Get()
  IF service=NULL OR service.live=0 THEN
    RETURN(1)
  FI

RETURN(AESCORE.Idle(service))

; After this turn's native continuation/cursor work, prepare and grant pending
; locks before deciding to sleep. No additional message admissions occur here.
PUBLIC PROC Settle()

  LET service=AESSTATE.Get()
  IF service=NULL OR service.live=0 THEN
    RETURN
  FI

  ; An application outline is a retained physical visual under its owner's
  ; MCTRL. Retire it before that same owner paints; do not obtain its semaphore.
  IF DESKDRAG.Application()<>0 THEN
    DESKDRAG.Suspend()
  FI
  IF AESLOCKS.SystemBegin()<>0 THEN
    BEGIN
      LET desktop=DESKSTATE.Get()
      IF (service.windowPending<>0
          OR (service.updateHint & AESSTATE.UPDATE_REQUESTED)<>0)
          AND desktop.scene.busy=0 AND CONSOLEBITMAP.Pending()=0
          AND DISPLAY.Blocked()=0 THEN
        ; Abandon idle reuse before a waiting caller takes UPDATE. A real DMA
        ; retains its existing owner and is excluded by the quiescence checks.
        CONSOLEDISPLAY.DiscardBatch()
      FI
    END
    AESWINDOWSTATE.Sync()
    AESMOUSE.Refresh()
    AESLOCKS.SystemEnd()
  FI
  AESCORE.Settle(service)
  AESMOUSE.RefreshSnapshot()

RETURN

PUBLIC PROC Stop()

  LET service=AESSTATE.Get()
  IF service=NULL OR service.live=0 THEN
    RETURN
  FI

  IF Idle()=0 OR AESCORE.Stop(service)=0 THEN
    HEAPCORE.Abort($fca0)
  FI

  EXEC.FreeSignal(service.port.mp_SigBit)
  service.mask=0
  service.port.mp_SigTask=NULL
  ; Last access: the controller may free storage after observing retirement.
  service.owner=NULL

RETURN

PUBLIC BYTE FUNC Settled()
  BYTE result

  IF AESLOCKS.SystemBegin()=0 THEN
    RETURN(0)
  FI
  result=InspectSettled()
  AESLOCKS.SystemEnd()

RETURN(result)

; Only UPDATE owners construct the shared prepared routing publication.
PUBLIC PROC Publish()

  IF AESLOCKS.SystemBegin()<>0 THEN
    AESSNAPSHOT.Publish()
    AESLOCKS.SystemEnd()
  FI

RETURN

ENDMODULE
