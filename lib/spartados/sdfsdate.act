; DOS DateStamp conversion; invalid or pre-1978 dates remain all zero.
MODULE SDFSDATE
USE FSBTYPES
INCLUDE "../dos/dos-types.inc"

BYTE FUNC Leap(CARD year)
; Only 1978..2049 reaches this helper; 2000 is a leap year.
RETURN((year & 3)=0)

; Provide calendar bounds for validating an on-disk timestamp.
CARD FUNC MonthDays(CARD year BYTE month)

  IF month=2 THEN
    RETURN(28+CARD(Leap(year)))
  FI

  IF month=4 OR month=6 OR month=9 OR month=11 THEN
    RETURN(30)
  FI

RETURN(31)

; Translate a valid SpartaDOS timestamp into the DOS date representation.
PUBLIC PROC Decode(FSBTYPES.Entry POINTER entry BYTE POINTER bytes)
  CARD year
  BYTE month,day,index
  LONGINT days

  entry.days=0
  entry.minutes=0
  entry.ticks=0
  day=bytes(17)
  month=bytes(18)
  year=CARD(bytes(19))
  IF year>99 THEN
    RETURN
  FI

  IF year>=50 THEN
    year==+1900
  ELSE
    year==+2000
  FI

  IF year<1978 OR month=0 OR month>12 OR day=0 OR day>MonthDays(year,month)
      OR bytes(20)>23 OR bytes(21)>59 OR bytes(22)>59 THEN
    RETURN
  FI

  days=LONGINT(year-1978)*365+LONGINT((year-1) RSH 2)-494
  IF month>1 THEN
    FOR index=1 TO month-1 DO
      days==+LONGINT(MonthDays(year,index))
    OD
  FI

  entry.days=days+LONGINT(day)-1
  entry.minutes=LONGINT(bytes(20))*60+LONGINT(bytes(21))
  entry.ticks=LONGINT(bytes(22))*50

RETURN

; SpartaDOS stores seconds and a two-digit 1950..2049 year. Reject dates
; outside the representable DOS epoch; round fractional seconds downward.
PUBLIC BYTE FUNC Encode(LONGINT days,minutes,ticks BYTE POINTER bytes)
  CARD year,length
  BYTE month

  IF days<0 OR minutes<0 OR minutes>=1440 OR
      ticks<0 OR ticks>=3000 THEN
    RETURN(0)
  FI

  year=1978
  WHILE year<2050 DO
    length=365+CARD(Leap(year))
    IF days<LONGINT(length) THEN
      EXIT
    FI
    days==-LONGINT(length)
    year==+1
  OD
  IF year=2050 THEN
    RETURN(0)
  FI

  month=1
  WHILE days>=LONGINT(MonthDays(year,month)) DO
    days==-LONGINT(MonthDays(year,month))
    month==+1
  OD
  bytes(17)=BYTE(days+1)
  bytes(18)=month
  bytes(19)=BYTE(year MOD 100)
  bytes(20)=BYTE(minutes/60)
  bytes(21)=BYTE(minutes MOD 60)
  bytes(22)=BYTE(ticks/50)

RETURN(1)

ENDMODULE
