; Private SDFS structures; no bank-zero or per-handle sector reservations.
MODULE SDFSTYPES
USE FSBTYPES

PUBLIC TYPE Volume=[
  CARD bitmap,bitmapEnd,capacity
  BYTE revision
]

PUBLIC TYPE MapCursor=[
  CARD page,previous,next
  LONGCARD base,hops
  BYTE valid
]

PUBLIC CONST EXTENT_SLOTS=32

; Exact request identity, including every active protected ancestor.
PUBLIC TYPE ExtentKey=[
  LONGCARD key
  LONGINT length
  CARD start,parent
  BYTE flags,known,depth
  CARD ARRAY ancestors(17)
]

; Completed measurements have known extents; names and other dates stay current.
PUBLIC TYPE ExtentRecord=[
  ExtentKey input
  LONGINT length,count,days,minutes,ticks
]

PUBLIC TYPE ExtentCache=[
  FSBTYPES.Volume POINTER volume
  LONGCARD generation
  BYTE filled,next,pending
  ExtentKey input
  ExtentRecord ARRAY rows(EXTENT_SLOTS)
]

PUBLIC TYPE BackendState=[
  FSBTYPES.Volume POINTER cached
  LONGCARD generation
  CARD sector
  CARD allocated,firstEmpty
  BYTE valid
  BYTE ARRAY map(256)
  BYTE ARRAY row(23)
  FSBTYPES.Cursor directory
  FSBTYPES.Operation operation
  LONGINT ordinal,recordOffset
  CARD parent
  BYTE filled,phase,resolvePhase,measurePhase
  FSBTYPES.Volume POINTER directoryVolume
  LONGCARD directoryGeneration
  ExtentCache POINTER extents
]

ENDMODULE
