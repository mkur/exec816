; Explicit filesystem transport dispatch. Device policy stays in its driver.
MODULE BLOCKTRANSPORT
USE EXEC
USE BLOCKTYPES
; IF SIO
USE SIODRIVER
; ENDIF SIO
USE IDEPLUSDRIVER
USE IDEPLUS
USE IDEMETA
USE A816MEMORY

; Common filesystem bounds precede transport-specific immutable geometry.
PUBLIC BYTE FUNC Geometry(BYTE backend CARD unit,profile LONGCARD sectors
    CARD dataBytes BYTE boot LONGCARD generation)

  IF sectors=0 OR sectors>LONGCARD($ffff) OR generation=0 THEN
    RETURN(0)
  FI

  IF backend=BLOCKTYPES.BACKEND_IDEPLUS THEN
    RETURN(unit>=1 AND unit<=15 AND profile=0 AND dataBytes=512 AND boot=0)
  FI

; IF SIO
  IF backend<>BLOCKTYPES.BACKEND_SIO OR unit<49 OR unit>56 OR boot<>1
      OR (dataBytes<>128 AND dataBytes<>256) THEN
    RETURN(0)
  FI

RETURN((profile=EXEC.SIO_PROFILE_FASTEST125 OR profile=EXEC.SIO_PROFILE_GENERIC57600)
    OR (profile=EXEC.SIO_PROFILE_STOCK810 AND dataBytes=128))
; ELSE SIO
; RETURN(0)
; ENDIF SIO

; Names use the idle upper scratch buffer, never near string initializers.
PUBLIC PROC DeviceName(BYTE backend BYTE POINTER name)

  IF backend=BLOCKTYPES.BACKEND_IDEPLUS THEN
    A816MEMORY.Move(name,BYTE POINTER(ADDRESS(IDEMETA.NAME)),15)
    RETURN
  FI

; IF SIO
  name(0)=115
  name(1)=105
  name(2)=111
  name(3)=46
  name(4)=100
  name(5)=101
  name(6)=118
  name(7)=105
  name(8)=99
  name(9)=101
  name(10)=0
; ELSE SIO
;   name(0)=0
; ENDIF SIO

RETURN

; Prepare the common prefix and the selected device's sector command.
PUBLIC PROC Prepare(EXEC.IOStdReq POINTER request BLOCKTYPES.Volume POINTER volume
    LONGCARD sector CARD expected BYTE POINTER buffer BYTE writing)
; IF SIO
  EXEC.IOSIOReq POINTER sio
; ENDIF SIO

  request.io_Flags=0
  request.io_Offset=0
  request.io_Data=buffer
  request.io_Length=LONGCARD(expected)
  request.io_Actual=0
  IF volume.backend=BLOCKTYPES.BACKEND_IDEPLUS THEN
    request.io_Offset=sector-1
    request.io_Command=IDEPLUS.READ_SECTOR
    IF writing<>0 THEN request.io_Command=IDEPLUS.WRITE_SECTOR FI
    RETURN
  FI
; IF SIO
  request.io_Command=EXEC.SIOCMD_TRANSACTION
  sio=EXEC.IOSIOReq POINTER(request)
  sio.sio_Command=$52
  sio.sio_Direction=EXEC.SIODIR_READ
  IF writing<>0 THEN
    sio.sio_Command=$57
    sio.sio_Direction=EXEC.SIODIR_WRITE
  FI

  sio.sio_Profile=volume.profile
  sio.sio_Aux1=BYTE(sector)
  sio.sio_Aux2=BYTE(sector RSH 8)
  sio.sio_TimeoutUS=0
; ENDIF SIO

RETURN

; Conditional cancellation belongs to the established transport.
PUBLIC BYTE FUNC TryCancel(EXEC.IORequest POINTER request)

  IF request.io_Device=BYTE POINTER(ADDRESS(IDEMETA.BUS)) THEN
    RETURN(IDEPLUSDRIVER.TryCancel(request))
  FI

; IF SIO
RETURN(SIODRIVER.TryCancel(request))
; ELSE SIO
; RETURN(0)
; ENDIF SIO

; Cached blocks remain subject to the owning controller's availability.
PUBLIC BYTE FUNC Unavailable(BLOCKTYPES.Volume POINTER volume)

  IF volume.backend=BLOCKTYPES.BACKEND_IDEPLUS THEN
    RETURN(IDEPLUSDRIVER.Unavailable())
  FI

; IF SIO
RETURN(SIODRIVER.Unavailable())
; ELSE SIO
; RETURN(1)
; ENDIF SIO

; Compare configured logical geometry once, while the open request is idle.
PUBLIC INT FUNC CheckGeometry(BLOCKTYPES.Volume POINTER volume BYTE POINTER buffer)
  INT error
  IF volume.backend=BLOCKTYPES.BACKEND_SIO THEN RETURN(0) FI
  LET request=volume.request
  request.io_Command=IDEPLUS.GET_GEOMETRY
  request.io_Data=buffer
  request.io_Length=SIZEOF(IDEPLUS.Geometry)
  error=EXEC.DoIO(EXEC.IORequest POINTER(request))
  IF error=0 THEN
    BEGIN
      LET geometry=IDEPLUS.Geometry POINTER(buffer)
      LET adapter=BLOCKTYPES.Adapter POINTER(volume.adapter)
      IF request.io_Actual<>SIZEOF(IDEPLUS.Geometry) THEN
        error=EXEC.IOERR_BADLENGTH
      ELSEIF geometry.bytes<>volume.dataBytes THEN
        adapter.admission=BLOCKTYPES.ADMIT_BYTES
        error=EXEC.IOERR_BADLENGTH
      ELSEIF geometry.sectors<>volume.sectors THEN
        adapter.admission=BLOCKTYPES.ADMIT_COUNT
        error=EXEC.IOERR_BADLENGTH
      ELSEIF volume.access<>0 THEN
        IF (geometry.flags & IDEPLUS.FLAG_DURABLE)=0 THEN
          adapter.admission=BLOCKTYPES.ADMIT_DURABLE
          error=IDEPLUS.ERROR_PROTECTED
        ELSEIF (geometry.flags & IDEPLUS.FLAG_READONLY)<>0 THEN
          adapter.admission=BLOCKTYPES.ADMIT_PROTECTED
          error=IDEPLUS.ERROR_PROTECTED
        FI
      FI
    END
  FI
  request.io_Data=NULL
  request.io_Length=0
  request.io_Actual=0
RETURN(error)

ENDMODULE
