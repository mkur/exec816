; Private filesystem block boundary. All records live in upper RAM.
MODULE BLOCKTYPES
USE EXEC
INCLUDE "block-backends.inc"
PUBLIC CONST SECTOR_BUFFER_BYTES=512
PUBLIC CONST TRANSFER_BUFFER_BYTES=2048
; One-time volume admission stages; retained by the filesystem on failure.
PUBLIC CONST ADMIT_ALLOCATE=3, ADMIT_OPEN=4, ADMIT_GEOMETRY=5
PUBLIC CONST ADMIT_BYTES=6, ADMIT_COUNT=7, ADMIT_PROTECTED=8, ADMIT_DURABLE=9

; Geometry is validated before attachment and fixed for this volume lifetime.
PUBLIC TYPE Volume=[
  EXEC.IOStdReq POINTER request
  BYTE POINTER adapter
  LONGCARD sectors,generation
  CARD dataBytes
  BYTE unit,profile,boot,busy,backend,access
  CARD references
]

PUBLIC TYPE CacheTag=[
  Volume POINTER volume
  LONGCARD generation
  CARD sector
  BYTE part
]

PUBLIC TYPE Cache=[
  CacheTag POINTER tags
  BYTE POINTER payload,victims
  CARD requested,blocks,mask
  LONGCARD hits,misses,evictions
]

PUBLIC TYPE Adapter=[
  EXEC.MsgPort POINTER port
  EXEC.IOStdReq POINTER request
  BYTE POINTER buffer
  Volume POINTER cached
  LONGCARD cachedGeneration,cachedSector
  CARD valid,owners
  BYTE busy,admission
  LONGINT error
  Cache cache
]

PUBLIC CONST VOLUME_SIZE=SIZEOF(Volume), ADAPTER_SIZE=SIZEOF(Adapter)
ENDMODULE
