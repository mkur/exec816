; One resident Task serializes native ATA PIO and owns controller lifetime.
MODULE IDEPLUSDRIVER
USE EXEC
USE EXECLISTS
USE TASKSTACKS
USE HEAPCORE
USE IDEPLUS
USE IDEMETA
USE IDEPLUSNATIVE
USE TIMER
USE TIMERNATIVE
USE A816MEMORY

TYPE LifetimeWaiter=[
  LifetimeWaiter POINTER next
  EXEC.Task POINTER task
  LONGCARD mask
  EXEC.TaskLease lease
  BYTE bit
]
TYPE DriverBus=[
  CARD opens
  BYTE state,stop
  EXEC.Task POINTER worker
  EXEC.IORequest POINTER active
  BYTE phase,cancelled
  EXEC.MsgPort port
  LONGCARD generation
  EXEC.TaskLease lease
  LifetimeWaiter POINTER waiters
]
TYPE Partition=[
  CARD opens
  BYTE number,mode
  CARD bytes
  LONGCARD start,physical,sectors
  BYTE flags,enabled
  CARD offset,reserved
]
TYPE Controller=[
  BYTE POINTER buffer
  EXEC.MsgPort POINTER timerPort
  TIMER.TimerClockRequest POINTER timer
  LONGCARD physical
  BYTE irq,status,error,owned,signals,resident,apt,durable,offline
]
INCLUDE "ideplus-lifetime.inc"

; Fixed metadata has no independent heap ownership or bank-zero reservation.
Controller POINTER FUNC Control()
RETURN(Controller POINTER(ADDRESS(IDEMETA.CONTROL)))

PUBLIC Partition POINTER FUNC UnitAt(BYTE number)
RETURN(Partition POINTER(ADDRESS(IDEMETA.UNITS+CARD(number)*24)))

; Match the bootstrap's immutable name, without creating near literals.
PUBLIC BYTE FUNC Matches(BYTE POINTER name)
  BYTE index
  IF name=NULL THEN RETURN(0) FI
  LET expected=BYTE POINTER(ADDRESS(IDEMETA.NAME))
  FOR index=0 TO 14 DO
    IF name(index)<>expected(index) THEN RETURN(0) FI
  OD
RETURN(1)

; Binding establishes unit lifetime; callbacks trust that handle afterwards.
PUBLIC INT FUNC Open(BYTE POINTER name LONGCARD number EXEC.IORequest
    POINTER request LONGCARD flags)
  INT error
  LET bus=DriverBus POINTER(ADDRESS(IDEMETA.BUS))
  error=EXEC.IOERR_OPENFAIL
  IF bus.state=5 THEN
    error=IDEPLUS.ERROR_OFFLINE
  ELSEIF bus.state=2 AND bus.stop=0 AND number<=15 AND flags=0 THEN
    BEGIN
      LET unit=UnitAt(BYTE(number))
      IF request.io_Message.mn_Length<EXEC.IOSTDREQ_SIZE THEN
        error=EXEC.IOERR_BADLENGTH
      ELSEIF unit.enabled<>0 AND bus.opens<>$ffff THEN
        unit.opens==+1
        bus.opens==+1
        request.io_Device=BYTE POINTER(bus)
        request.io_Unit=BYTE POINTER(unit)
        error=0
      FI
    END
  FI
  request.io_Error=BYTE(error)
RETURN(error)

; Close consumes one settled binding and wakes an outstanding stop.
PUBLIC PROC Close(EXEC.IORequest POINTER request)
  LET bus=DriverBus POINTER(request.io_Device)
  LET unit=Partition POINTER(request.io_Unit)
  unit.opens==-1
  bus.opens==-1
  request.io_Device=NULL
  request.io_Unit=NULL
  IF bus.opens=0 AND bus.stop<>0 THEN EXEC.Signal(bus.worker,LONGCARD(STOP_MASK)) FI
RETURN

; All accepted requests use normal asynchronous reply ownership.
PUBLIC PROC BeginIO(EXEC.IORequest POINTER request)
  LET bus=DriverBus POINTER(ADDRESS(IDEMETA.BUS))
  request.io_Flags=request.io_Flags & $fe
  IF request.io_Message.mn_Length>=EXEC.IOSTDREQ_SIZE THEN
    EXEC.IOStdReq POINTER(request).io_Actual=0
  FI
  IF request.io_Message.mn_Length<EXEC.IOSTDREQ_SIZE THEN
    request.io_Error=BYTE(EXEC.IOERR_BADLENGTH)
  ELSEIF bus.state=5 THEN
    request.io_Error=IDEPLUS.ERROR_OFFLINE
  ELSEIF bus.state<>2 OR bus.stop<>0 THEN
    request.io_Error=BYTE(EXEC.IOERR_UNITBUSY)
  ELSE
    EXEC.PutMsg(@bus.port,@request.io_Message)
    RETURN
  FI
  EXEC.ReplyMsg(@request.io_Message)
RETURN

; Queued cancellation removes and replies; an active transfer drains safely.
PUBLIC PROC AbortIO(EXEC.IORequest POINTER request)
  IF request.io_Message.mn_Node.ln_Type<>EXEC.NT_MESSAGE THEN RETURN FI
  LET bus=DriverBus POINTER(ADDRESS(IDEMETA.BUS))
  IF bus.active=request THEN
    IF bus.phase<>3 THEN bus.cancelled=1 FI
    RETURN
  FI
  EXECLISTS.Remove(@request.io_Message.mn_Node)
  request.io_Error=BYTE(EXEC.IOERR_ABORTED)
  EXEC.ReplyMsg(@request.io_Message)
RETURN

; The filesystem may retire a queued/preparing request, never active ATA work.
PUBLIC BYTE FUNC TryCancel(EXEC.IORequest POINTER request)
  BYTE accepted
  EXEC.Forbid()
  LET bus=DriverBus POINTER(ADDRESS(IDEMETA.BUS))
  accepted=0
  IF request.io_Message.mn_Node.ln_Type=EXEC.NT_MESSAGE THEN
    IF bus.active<>request OR bus.phase<2 THEN
      AbortIO(request)
      accepted=1
    FI
  FI
  EXEC.Permit()
RETURN(accepted)

; Publish a complete clock before sleeping; timer.device retains the worker.
BYTE FUNC Clock()
  LET c=Control()
RETURN(TIMERNATIVE.Snapshot(BYTE POINTER(@c.timer.ticks_hi))=0)

; Sleep one VBI tick through the ordinary timer device with bounded admission.
BYTE FUNC Delay()
  INT error
  LET c=Control()
  IF Clock()=0 THEN RETURN(0) FI
  c.timer.ticks_lo==+1
  IF c.timer.ticks_lo=0 THEN c.timer.ticks_hi==+1 FI
  c.timer.tc_Request.io_Command=TIMER.TD_WAITUNTIL
  error=EXEC.DoIO(@c.timer.tc_Request)
RETURN(error=0)

; Ready polls remain preemptible and use monotonic VBI deadlines after a burst.
BYTE FUNC Ready(BYTE drq,ignoreError)
  LONGCARD started
  BYTE attempts,status
  LET c=Control()
  IF Clock()=0 THEN RETURN(IDEPLUS.ERROR_TIMEOUT) FI
  started=c.timer.ticks_lo
  DO
    FOR attempts=0 TO 31 DO
      status=IDEPLUSNATIVE.ReadRegister(IDEPLUS.REG_ALTSTATUS)
      c.status=status
      IF status=0 OR status=$ff THEN RETURN(IDEPLUS.ERROR_ABSENT) FI
      IF (status & $80)=0 THEN
        IF (status & $21)<>0 AND ignoreError=0 THEN
          c.error=IDEPLUSNATIVE.ReadRegister(IDEPLUS.REG_ERROR)
          RETURN(IDEPLUS.ERROR_ATA)
        FI
        IF (status & $08)=drq THEN RETURN(0) FI
      FI
    OD
    IF Clock()=0 THEN RETURN(IDEPLUS.ERROR_TIMEOUT) FI
    IF c.timer.ticks_lo-started>=IDEPLUS.TIMEOUT_TICKS THEN
      RETURN(IDEPLUS.ERROR_TIMEOUT)
    FI
    IF Delay()=0 THEN RETURN(IDEPLUS.ERROR_TIMEOUT) FI
  OD
RETURN(IDEPLUS.ERROR_TIMEOUT)

; Program one LBA28 transfer, without retaining a selected PBI window.
PROC AddressSector(LONGCARD sector)
  IDEPLUSNATIVE.WriteRegister(IDEPLUS.REG_HEAD,$e0 OR BYTE(sector RSH 24))
  IDEPLUSNATIVE.WriteRegister(IDEPLUS.REG_COUNT,1)
  IDEPLUSNATIVE.WriteRegister(IDEPLUS.REG_LBA0,BYTE(sector))
  IDEPLUSNATIVE.WriteRegister(IDEPLUS.REG_LBA1,BYTE(sector RSH 8))
  IDEPLUSNATIVE.WriteRegister(IDEPLUS.REG_LBA2,BYTE(sector RSH 16))
RETURN

; Read one physical sector into the controller's reusable upper-RAM buffer.
PUBLIC BYTE FUNC ReadPhysical(LONGCARD sector)
  BYTE error
  error=Ready(0,1)
  IF error<>0 THEN RETURN(error) FI
  AddressSector(sector)
  IDEPLUSNATIVE.WriteRegister(IDEPLUS.REG_COMMAND,IDEPLUS.ATA_READ)
  error=Ready($08,0)
  IF error<>0 THEN RETURN(error) FI
  LET c=Control()
  IDEPLUSNATIVE.ReadWords(c.buffer)
RETURN(Ready(0,0))

; IDENTIFY admits only LBA28 ATA disks with supported physical sector size.
BYTE FUNC Identify()
  BYTE error
  CARD POINTER words
  LET c=Control()
  IDEPLUSNATIVE.WriteRegister(IDEPLUS.REG_HEAD,$e0)
  error=Ready(0,1)
  IF error<>0 THEN RETURN(error) FI
  IDEPLUSNATIVE.WriteRegister(IDEPLUS.REG_COMMAND,IDEPLUS.ATA_IDENTIFY)
  error=Ready($08,0)
  IF error<>0 THEN RETURN(error) FI
  IDEPLUSNATIVE.ReadWords(c.buffer)
  error=Ready(0,0)
  IF error<>0 THEN RETURN(error) FI
  words=CARD POINTER(c.buffer)
  IF ((words(0) & $8000)<>0 AND words(0)<>$848a) OR (words(49) & $0200)=0 THEN
    RETURN(IDEPLUS.ERROR_UNSUPPORTED)
  FI
  IF (words(106) & $d000)=$5000 THEN RETURN(IDEPLUS.ERROR_UNSUPPORTED) FI
  c.physical=LONGCARD(words(60)) OR (LONGCARD(words(61)) LSH 16)
  IF c.physical=0 OR c.physical>LONGCARD($10000000) THEN
    RETURN(IDEPLUS.ERROR_UNSUPPORTED)
  FI
  LET unit=UnitAt(0)
  unit.number=0
  unit.bytes=512
  unit.start=0
  unit.physical=c.physical
  unit.sectors=c.physical
  unit.enabled=1
  c.durable=Durability(words)
RETURN(0)

INCLUDE "ideplus-apt.inc"
INCLUDE "ideplus-write.inc"

; Acquire timer, buffer and board ownership before publishing readiness.
BYTE FUNC HardwareInit()
  BYTE okay
  INT error
  LET c=Control()
  IF SIZEOF(DriverBus)>64 OR SIZEOF(Partition)<>24 THEN RETURN(0) FI
  IF EXEC.AllocSignal(31)<>31 THEN RETURN(0) FI
  c.signals=1
  IF EXEC.AllocSignal(29)<>29 THEN RETURN(0) FI
  c.signals=3
  okay=EXEC.RegisterResident(LONGCARD(STOP_MASK))
  IF okay=0 THEN RETURN(0) FI
  c.resident=1
  c.buffer=EXEC.AllocMem(512,EXEC.MEMF_UPPER)
  c.timerPort=EXEC.CreateMsgPort()
  IF c.buffer=NULL OR c.timerPort=NULL THEN RETURN(0) FI
  c.timer=TIMER.TimerClockRequest POINTER(EXEC.CreateIORequest(c.timerPort,
      SIZEOF(TIMER.TimerClockRequest)))
  IF c.timer=NULL THEN RETURN(0) FI
  error=EXEC.OpenDevice(BYTE POINTER(c"timer.device"),TIMER.UNIT_VBLANK,
      @c.timer.tc_Request,0)
  IF error<>0 THEN RETURN(0) FI
  ; Rev E card-present and IRQ bits distinguish an absent selected board.
  IF (IDEPLUSNATIVE.ReadRegister(IDEPLUS.REG_CARD) & $20)<>0 THEN RETURN(0) FI
  c.irq=IDEPLUSNATIVE.ReadRegister(IDEPLUS.REG_IRQ) & 1
  IDEPLUSNATIVE.WriteRegister(IDEPLUS.REG_IRQ,0)
  c.owned=1
  A816MEMORY.Clear(BYTE POINTER(ADDRESS(IDEMETA.UNITS)),384)
  error=Identify()
  c.error=error
  IF error=0 THEN
    c.apt=DiscoverPartitions()
    IF c.apt=0 THEN
      A816MEMORY.Clear(BYTE POINTER(ADDRESS(IDEMETA.UNITS+24)),360)
    FI
    IF c.error=IDEPLUS.ERROR_TIMEOUT OR c.error=IDEPLUS.ERROR_ABSENT THEN error=c.error FI
  FI
  IF error=IDEPLUS.ERROR_TIMEOUT OR error=IDEPLUS.ERROR_ABSENT THEN c.offline=1 FI
RETURN(error=0)

; Retire every borrowed resource before releasing the resident Task lease.
PROC HardwareStop()
  BYTE okay
  LET c=Control()
  IF c.owned<>0 THEN
    IF c.offline=0 THEN IDEPLUSNATIVE.WriteRegister(IDEPLUS.REG_IRQ,c.irq) FI
    c.owned=0
  FI
  IF c.timer<>NULL THEN
    IF c.timer.tc_Request.io_Device<>NULL THEN EXEC.CloseDevice(@c.timer.tc_Request) FI
    EXEC.DeleteIORequest(@c.timer.tc_Request)
    c.timer=NULL
  FI
  IF c.timerPort<>NULL THEN EXEC.DeleteMsgPort(c.timerPort) c.timerPort=NULL FI
  IF c.buffer<>NULL THEN EXEC.FreeMem(c.buffer,512) c.buffer=NULL FI
  IF c.resident<>0 THEN
    okay=EXEC.UnregisterResident()
    c.resident=0
  FI
  IF (c.signals & 2)<>0 THEN EXEC.FreeSignal(29) FI
  IF (c.signals & 1)<>0 THEN EXEC.FreeSignal(31) FI
  c.signals=0
RETURN

; Take ownership atomically with dequeue; interrupts never inspect this queue.
EXEC.IOStdReq POINTER FUNC Claim()
  EXEC.IOStdReq POINTER request
  EXEC.Forbid()
  LET bus=DriverBus POINTER(ADDRESS(IDEMETA.BUS))
  request=EXEC.IOStdReq POINTER(EXEC.GetMsg(@bus.port))
  bus.active=EXEC.IORequest POINTER(request)
  bus.phase=1
  bus.cancelled=0
  EXEC.Permit()
RETURN(request)

; Complete full raw reads or copy geometry, retaining buffers until reply.
PROC RunRequest(EXEC.IOStdReq POINTER request)
  BYTE error
  LET bus=DriverBus POINTER(ADDRESS(IDEMETA.BUS))
  LET unit=Partition POINTER(request.io_Unit)
  LET c=Control()
  request.io_Actual=0
  error=0
  IF bus.state=5 THEN
    error=IDEPLUS.ERROR_OFFLINE
  ELSEIF bus.cancelled<>0 THEN
    error=BYTE(EXEC.IOERR_ABORTED)
  ELSEIF request.io_Command=IDEPLUS.GET_GEOMETRY THEN
    IF request.io_Length<>SIZEOF(IDEPLUS.Geometry) THEN
      error=BYTE(EXEC.IOERR_BADLENGTH)
    ELSE
      BEGIN
        LET result=IDEPLUS.Geometry POINTER(request.io_Data)
        result.bytes=unit.bytes
        result.flags=AccessFlags(unit)
        result.sectors=unit.sectors
        result.generation=bus.generation
        request.io_Actual=SIZEOF(IDEPLUS.Geometry)
      END
    FI
  ELSEIF request.io_Command=EXEC.CMD_UPDATE THEN
    IF request.io_Length<>0 THEN
      error=BYTE(EXEC.IOERR_BADLENGTH)
    ELSE
      EXEC.Forbid()
      IF c.durable=2 THEN bus.phase=3 FI
      EXEC.Permit()
      error=FlushPhysical()
    FI
  ELSEIF request.io_Command<>IDEPLUS.READ_SECTOR AND request.io_Command<>IDEPLUS.WRITE_SECTOR THEN
    error=BYTE(EXEC.IOERR_NOCMD)
  ELSEIF (request.io_Length<>LONGCARD(unit.bytes) AND (unit.number=0 OR unit.bytes<>256
      OR request.io_Offset>=3 OR request.io_Length<>128)) OR request.io_Offset>=unit.sectors THEN
    error=BYTE(EXEC.IOERR_BADLENGTH)
  ELSEIF request.io_Command=IDEPLUS.WRITE_SECTOR THEN
    error=WriteLogical(unit,request)
    IF error=0 THEN request.io_Actual=request.io_Length FI
  ELSE
    EXEC.Forbid()
    bus.phase=2
    IF bus.cancelled<>0 THEN error=BYTE(EXEC.IOERR_ABORTED) FI
    EXEC.Permit()
    IF error=0 THEN
      error=ReadPhysical(PhysicalSector(unit,request.io_Offset))
      IF error=0 AND bus.cancelled<>0 THEN error=BYTE(EXEC.IOERR_ABORTED) FI
      IF error=0 THEN
        IF unit.number=0 THEN
          A816MEMORY.Move(request.io_Data,c.buffer,512)
        ELSE
          CopyLogical(unit,request)
        FI
        request.io_Actual=request.io_Length
      FI
    FI
  FI
  EXEC.Forbid()
  IF error=IDEPLUS.ERROR_TIMEOUT OR error=IDEPLUS.ERROR_ABSENT
      OR (bus.phase=3 AND error<>0) THEN
    bus.state=5
    c.offline=1
  FI
  request.io_Error=error
  bus.active=NULL
  bus.phase=0
  bus.cancelled=0
  EXEC.ReplyMsg(@request.io_Message)
  EXEC.Permit()
RETURN

; Hardware waits run outside Forbid; lifecycle publication remains atomic.
PUBLIC PROC Worker()
  LONGCARD bits
  BYTE okay
  EXEC.IOStdReq POINTER request
  EXEC.Forbid()
  LET bus=DriverBus POINTER(ADDRESS(IDEMETA.BUS))
  LET self=EXEC.FindTask(NULL)
  IF bus.worker<>self OR bus.state<>1 OR bus.lease.task<>self THEN
    EXEC.Permit()
    RETURN
  FI
  EXEC.Permit()
  okay=HardwareInit()
  EXEC.Forbid()
  IF okay=0 THEN
    HardwareStop()
    RetireWorker(bus)
    RETURN
  FI
  bus.state=2
  Notify(bus)
  EXEC.Permit()
  bits=0
  WHILE Stopping(bus,self,bits)=0 DO
    bits=0
    request=Claim()
    IF request=NULL THEN
      bits=EXEC.Wait(LONGCARD(STOP_MASK) OR LONGCARD($80000000))
    ELSE
      RunRequest(request)
    FI
  OD
  HardwareStop()
  EXEC.Forbid()
  RetireWorker(bus)
RETURN
ENDMODULE
