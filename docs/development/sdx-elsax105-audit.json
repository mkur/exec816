  "integration_findings": [
    {
      "id": "native-context",
      "priority": "required",
      "finding": "The existing SDX runtime enters E=1 and snapshots page one. ELSA uses E=0, its private D and a relocated native stack, including stack-relative operands.",
      "action": "Define reusable native foreign-context classification, Task/stack ownership and NMI/IRQ-safe entry, services and retirement; preserve all native context and existing Task guards."
    },
    {
      "id": "native-records",
      "priority": "required",
      "finding": "One $FFF9/$43 compact upper block plus one $FFFE/$C0 low BSS block, with both two- and three-byte fixups.",
      "action": "Extend the file decoder and symbol address model through emitted-code probes and independent placed-image comparisons before native application admission."
    },
    {
      "id": "workspace",
      "priority": "required",
      "finding": "H_MALLOC(-2) queries the largest free contiguous block and ELSA immediately requests that full size. It does not limit its workspace to a small allocation.",
      "action": "Provide a measured Process-owned allocation budget and consistent largest-free query semantics; document the departure from whole-machine SDX allocation."
    },
    {
      "id": "private-globals",
      "priority": "required",
      "finding": "COMTAB, FILE_P, ERRNO, legacy I/O parameters, physical FR0 accesses and a self-modified MVN bank pair remain even though the service calls are native.",
      "action": "Audit and map all such operands and state per Image/Process. Preserve exact checked binary patches and do not alias native compiler DP metadata. Each live instance must own mutable core/BSS state; the reviewed MVN bank patch rules out assuming the core is immutable shared text."
    },
    {
      "id": "console",
      "priority": "required",
      "finding": "36 native inline formatting records include stack/DP addressing and keyword tables, and listing uses a separate output channel.",
      "action": "Implement the required native formatter ABI and ordinary DOS streams for text and graphical shells; preserve redirected ATASCII and write failures."
    },
    {
      "id": "completion",
      "priority": "open",
      "finding": "Repeated launches, includes/listings, allocation failures, source errors, native write errors, computed dispatch, SMC and bounded BREAK remain unqualified.",
      "action": "Use separate focused acceptance cases with exact output, resource recovery, guards and concurrent native/GEM peers before demo packaging."
    }
  ],
