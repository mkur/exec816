  "abi_requirements": {
    "entry": "E=0, A/X/Y 8-bit, DBR=PBR=the loaded code bank; DP/SP initially supplied by the caller, then changed by ELSA.",
    "calls": "JSL/JML to native H_* services, with full D/DBR and width preservation according to each service. This is separate from Action native ABI v2 and the current emulation-mode SDX frame.",
    "memory_calls": "H_MEMCPY/H_MEMSET take stack-passed 32-bit arguments with high bytes zero, overlap semantics and callee cleanup; H_MALLOC/H_MFREE use 32-bit AX and Y/scan attributes.",
    "io_calls": "H_FREAD/H_FWRITE take 32-bit count and far buffer on the stack, remove the buffer argument and leave actual count on the stack. FILE_P plus H_FILE_P select a far filename; file_id/mode/scan and other legacy variables still require private mapping.",
    "traps": "Native H_SFAIL/H_XFAIL/H_FAIL require 24-bit continuations and full native S restoration, with Process-owned handles and settled I/O before error delivery.",
    "exit": "ERRNO must become an explicit Process result policy. Original controls verify bytes and DOS return, not command error codes.",
    "formatting": {
      "inline_records": 36,
      "console_calls": 28,
      "listing_calls": 8,
      "conversion_types": [
        "b",
        "c",
        "d",
        "l",
        "p",
        "s",
        "t",
        "x"
      ],
      "modifiers": [
        "direct page <",
        "caller stack !",
        "variable width/index *"
      ],
      "additional_gap": "%t keyword-table output is unsupported by the present SDXPRINT subset; H_PRINTF also returns a character count in A.",
      "reachability": "Inventory at named import operand sites with JSL context checked; no whole-program reachability claim."
    },
    "case_conversion": "H_LOWERC/H_UPPERC operate on bytes without losing native register widths.",
    "floating_point": "H_IFP32 is imported. The reviewed caller accesses physical $0000D4..$0000D7 and FR0; a native adapter must supply private FP state instead of sharing host ROM workspace."
  },
