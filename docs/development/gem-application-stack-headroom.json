        "bytes": 4098,
        "scope": "Two-chunk diagnostic copy: exact bytes, CPU/borrowed RAM restoration, Task guards and OS return.",
        "harness": "import sys,json,hashlib\nfrom pathlib import Path\nsys.path.insert(0,str(Path.cwd()/'tools'))\nfrom native_program import read_build,execute,ROOT,require\nfrom test_large_stacks import PIN\nfrom test_gem_render import read_capture\nfrom os_boundary import emulator,run_to\np=read_build(ROOT/'build/gem-stack-headroom/coexistence/program')\nout=ROOT/'build/gem-stack-headroom/capture-buffer';out.mkdir(exist_ok=True)\nwith emulator(ROOT/'build/shell-paced-bridge',ROOT/'build/firmware/altirraos-816.rom',out,pin=PIN) as b:\n def before(b):\n  marker=p['labels']['native_nmi'];b.bp_set(marker);run_to(b,marker);b.bp_clear_all()\n  memory=p['build']['memory'];buffer=memory['constants']['MANIFEST']\n  source=p['image']['routines'][0]['address'];expected=b.memdump(source,4098)\n  oldbuffer=b.memdump(buffer,4096);oldregs=b.regs()\n  actual=read_capture(b,source,4098,p)\n  require(actual==expected,'Copied bytes differ')\n  require(oldbuffer==b.memdump(buffer,4096),'Borrowed buffer was not restored')\n  after=b.regs()\n  require(all(oldregs[k]==after[k] for k in ('PC','A','X','Y','S','P')),'Copy changed CPU context')\n runtime,_=execute(b,{**p,'output':out},before_run=before,frame_limit=12000,timeout=180)\n (out/'results.json').write_text(json.dumps(dict(status='pass',tier='development',bytes=4098,source_build=str(p['output']),harness_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),runtime=runtime),indent=2)+'\\n')\nprint('Capture buffer: bytes, CPU, borrowed RAM, guards and OS return passed')\n"
