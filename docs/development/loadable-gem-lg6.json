    "historical_observer_sha256": "08ec6655d80ee918f4819b2e7f2197357827d83d03349323cb13cf5ccbc8094c",
    "script_source": "import importlib.util,json,sys,zipfile\nfrom pathlib import Path\nsys.path.insert(0,str(Path('tools').resolve()))\nfrom native_program import sha256\nfrom desktop_mouse import schedule\nfrom loadable_gem_feedback import measure\nobserver=Path('build/loadable-gem/lg4_demo_observer.py').resolve()\nspec=importlib.util.spec_from_file_location('lg4_demo_observer',observer)\nmodule=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)\nclass Baseline:\n def exercise(self,s):\n  symbols=json.loads((s.p['output']/'bitmap-console/c-image.json').read_text())['symbols']\n  panel=symbols['GEMPanel'];position=[320,120]\n  def move(x,y):\n   nonlocal position\n   position=schedule(s.b,s.p,position,(x,y));s.saved['pointer']=position\n   at=lambda n:next(d['address'] for d in s.p['image']['data'] if '_DESKINPUT_'+n.upper()+'_' in d['name'])\n   s.rendezvous('(dw($%x)=%d)&(dw($%x)=%d)'%(at('cursorX'),position[0],at('cursorY'),position[1]));s.frames(3)\n  def click(x,y):\n   move(x,y);s.b._cmd_ok('MOUSE AT 2000 0 0 1');s.frames(35)\n   s.b._cmd_ok('MOUSE AT 2000 0 0 0');s.frames(60)\n  s.rendezvous('dw($%x)=1'%(panel+8));s.frames(270)\n  click(458,56);click(456,104);measure(s,panel,move,'resident-lg4')\n  self.feedback=s.saved['loaded_panel_feedback']\n  click(96,32);s.save_screen(s.p['output']/'boot-smoke.png')\n  for char in 'EXIT':s.press(char)\n  s.b._cmd_ok('KEY RETURN down');s.b.bp_clear_all()\nout=Path('build/loadable-gem/lg4-demo').resolve()\nwith zipfile.ZipFile(out/'exec816-demo.zip') as z:z.extractall(out/'extracted')\nbaseline=Baseline()\nr=module.run(out,boot_smoke=True,distribution_root=out/'extracted/exec816-demo',integration=baseline,profile_commands=False)\nr.update(feedback=baseline.feedback,scope='Six physical presses on the frozen LG4 resident panel with Files/counter and shell idle; matching scanout and clean EXIT.',historical_observer_sha256=sha256(observer),feedback_observer_sha256=sha256(Path('tools/loadable_gem_feedback.py')))\nPath('build/loadable-gem/lg6-feedback-baseline.json').write_text(json.dumps(r,indent=2)+'\\n')\n",
    "script_sha256": "a431982f7410b52dce767d0efae7866e589295cfb7eda59cc6aa578f37a20f8d"
