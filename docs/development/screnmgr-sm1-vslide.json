  "changes": [
    "Pass explicit packet context into grant-protected frame callbacks; share the existing raster and compact strip.",
    "Compile native frame-visible intersections under UPDATE, release only the scene gate around synchronous physical access.",
    "Complete manager clips through Layers.Repaired without claiming client-work completion.",
    "Check cold access in the native handler before mutation; delegate outside the handler scope and retry with the live grant.",
    "Reuse an open workstation grant or retain a standalone upper-heap grant using the existing reply signal.",
    "Close standalone access before opening a public workstation or retiring the application; retain live storage on close failure."
  ],
  "commands": [
