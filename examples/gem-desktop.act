MODULE SHELLAPP
USE AESBOOT
USE DESKBOOT
USE DESKTOP
USE DESKTYPES

INCLUDE "shell/shell-session.inc"
INCLUDE "shell/shell-boot.inc"

LONGINT exitStatus
DESKTYPES.Request placement

; Keep the desktop's volume column visible. The shell moves its own window
; through the ordinary desktop API before starting application children.
PROC PlaceShell()
  EXEC.Message POINTER message
  DESKTYPES.Request POINTER reply

  LET binding=DESKBOOT.Binding()
  DESKTOP.Prepare(@placement,DESKTYPES.MOVE)
  placement.window=DESKBOOT.WindowId()
  placement.bounds.left=112
  ; The console work origin must remain on its eight-pixel character grid.
  placement.bounds.top=40-DESKTYPES.WORK_TOP
  IF DESKTOP.Submit(binding,@placement)<>DESKTYPES.OK THEN
    RETURN
  FI
  reply=DESKTOP.Collect(binding)
  WHILE reply=NULL DO
    message=EXEC.WaitPort(binding.replies)
    reply=DESKTOP.Collect(binding)
  OD
RETURN

; DesktopStart/Stop are linked by the resident C application builder.
PROC Main()

  IF ShellBootStart(shellCon)<>0 THEN
    PlaceShell()
    IF DesktopStart()=0 THEN
      ShellText(shell.console,c"GEM desktop unavailable")
      ShellByte(shell.console,ASCII.LF)
    FI

    WHILE shell.done=0 DO
      ShellReadStep()
    OD
  FI

  IF DesktopStop()=0 THEN
    HEAPCORE.Abort($fcb8)
  FI

  IF DESKBOOT.StopAdmission()=0 THEN
    HEAPCORE.Abort($faea)
  FI

  exitStatus=ShellFinish()

RETURN
ENDMODULE
