MODULE SHELLAPP
USE AESBOOT
USE DESKBOOT
USE DESKTOP
USE DESKTYPES

INCLUDE "shell/shell-session.inc"
INCLUDE "shell/shell-boot.inc"
INCLUDE "shell/shell-controller.inc"
INCLUDE "shell/shell-desktop.inc"

LONGINT exitStatus

; A lost terminal must end the supervised session rather than strand a reader.
LONGCARD FUNC DesktopWatch()

  LET mask=DesktopService()
  IF DesktopAlive()=0 THEN
    controllerStatus=PROCESS.RETURN_FAIL
    ShellControllerCloseAll()
  FI

RETURN(mask)

; DesktopStart/Stop are linked by the resident C application builder.
PROC Main()

  IF ShellControllerStart(0)<>0 THEN
    IF ShellControllerFirst()<>0 THEN
      IF DesktopStart()=0 THEN
        ShellDesktopNotice(c"GEM desktop unavailable\n")
        controllerStatus=PROCESS.RETURN_FAIL
        ShellControllerCloseAll()
      FI
      BEGIN
        LET client=DOSCLIENT.Ensure()
        client.waitService=@DesktopWatch
      END
    FI

    exitStatus=ShellControllerRun()
  ELSE
    exitStatus=controllerStatus
  FI

  IF DesktopStop()=0 THEN
    HEAPCORE.Abort($fcb8)
  FI

  IF DESKBOOT.StopAdmission()=0 THEN
    HEAPCORE.Abort($faea)
  FI

  ShellControllerStop()

RETURN
ENDMODULE
