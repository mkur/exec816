MODULE COPY

INCLUDE "command-transfer.inc"

CONST TRANSFER_BYTES=16384
BYTE ARRAY transferBuffer(TRANSFER_BYTES)
BYTE ARRAY arguments(COMMAND.ARGS_STORAGE_BYTES)
ADDRESS ARRAY values(3)

; Keep the source open before destructive output admission. Filesystem sharing
; rejects a target referring to that source, including through another alias.
LONGINT FUNC Main()
  LONGINT status

  LET parsed=COMMAND.ReadArgsOrHelp(c"FROM/A,TO/A,APPEND/S",
      values,3,arguments,SIZEOF(arguments))
  IF parsed<>COMMAND.ARGS_PARSED THEN
    RETURN(IF parsed=COMMAND.ARGS_HELP THEN COMMAND.RETURN_OK
        ELSE COMMAND.RETURN_ERROR FI)
  FI

  IF CommandName(values(0))=0 OR CommandName(values(1))=0 THEN
    RETURN(COMMAND.RETURN_ERROR)
  FI

  LET input=CommandInput(values(0))
  IF input=NULL THEN
    RETURN(COMMAND.RETURN_ERROR)
  FI

  LET output=CommandOutput(values(1),BYTE(values(2)<>0))
  status=COMMAND.RETURN_ERROR
  IF output<>NULL THEN
    status=CommandTransfer(input,output,NULL,transferBuffer,TRANSFER_BYTES)
    status=CommandFinish(output,1,status)
  FI

RETURN(CommandFinish(input,1,status))

ENDMODULE
