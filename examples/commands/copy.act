MODULE COPY

USE CSTRING AS STR
INCLUDE "command-transfer.inc"
INCLUDE "command-pattern.inc"
INCLUDE "command-selection.inc"

CONST TRANSFER_BYTES=16384
BYTE ARRAY transferBuffer(TRANSFER_BYTES)
BYTE ARRAY arguments(COMMAND.ARGS_STORAGE_BYTES)
BYTE ARRAY targetPath(256)
ADDRESS ARRAY values(3)
COMMAND.FileInfoBlock destinationInfo

; Inspect only a required directory, never an ordinary exact output filename.
BYTE FUNC CopyDirectory(CSTRING target)
  LONGINT cause

  LET lock=COMMAND.Lock(BYTE POINTER(target),COMMAND.SHARED_LOCK)
  IF lock=NULL THEN
    RETURN(0)
  FI

  LET examined=COMMAND.Examine(lock,BYTE POINTER(@destinationInfo))
  cause=COMMAND.IoErr()
  IF examined=0 AND cause=0 THEN
    cause=COMMAND.ERROR_BAD_STREAM_NAME
  FI

  COMMAND.SetIoErr(0)
  COMMAND.UnLock(lock)
  IF cause=0 THEN
    cause=COMMAND.IoErr()
  FI

  COMMAND.SetIoErr(cause)
  IF cause<>0 THEN
    RETURN(0)
  FI

  IF destinationInfo.fib_DirEntryType<=0 THEN
    COMMAND.SetIoErr(COMMAND.ERROR_OBJECT_WRONG_TYPE)
    RETURN(0)
  FI

RETURN(1)

; Preserve the source's final filename beneath an already checked directory.
CSTRING FUNC CopyDestination(CSTRING source,target)
  CARD index,first,used

  index=0
  first=0
  WHILE source(index)<>ASCII.NUL DO
    IF source(index)=': OR source(index)='/ THEN
      first=index+1
    FI

    index==+1
  OD

  IF source(first)=ASCII.NUL THEN
    COMMAND.SetIoErr(COMMAND.ERROR_INVALID_COMPONENT_NAME)
    RETURN(NULL)
  FI

  LET length=STR.strlcpy(targetPath,target,SIZEOF(targetPath))
  IF length>=SIZEOF(targetPath) THEN
    COMMAND.SetIoErr(COMMAND.ERROR_LINE_TOO_LONG)
    RETURN(NULL)
  FI

  used=CARD(length)
  IF used<>0 THEN
    IF targetPath(used-1)<>': AND targetPath(used-1)<>'/ THEN
      IF STR.strlcat(targetPath,c"/",SIZEOF(targetPath))>=SIZEOF(targetPath) THEN
        COMMAND.SetIoErr(COMMAND.ERROR_LINE_TOO_LONG)
        RETURN(NULL)
      FI
    FI
  FI

  IF STR.strlcat(targetPath,source+SIZE(first),SIZEOF(targetPath))
      >=SIZEOF(targetPath) THEN
    COMMAND.SetIoErr(COMMAND.ERROR_LINE_TOO_LONG)
    RETURN(NULL)
  FI

RETURN(CSTRING(targetPath))

; Keep the source open before destructive output admission. Filesystem sharing
; rejects a target referring to that source, including through another alias.
LONGINT FUNC CopyOne(CSTRING source,target BYTE append,allowDirectory)
  LONGINT status
  BYTE POINTER output

  LET input=CommandInput(ADDRESS(source))
  IF input=NULL THEN
    RETURN(COMMAND.RETURN_ERROR)
  FI

  output=CommandOutput(ADDRESS(target),append)
  IF allowDirectory<>0 AND output=NULL
      AND COMMAND.IoErr()=COMMAND.ERROR_OBJECT_WRONG_TYPE THEN
    IF CopyDirectory(target)<>0 THEN
      target=CopyDestination(source,target)
      IF target<>NULL THEN
        output=CommandOutput(ADDRESS(target),append)
      FI
    FI
  FI

  status=COMMAND.RETURN_ERROR
  IF output<>NULL THEN
    status=CommandTransfer(input,output,NULL,transferBuffer,TRANSFER_BYTES)
    status=CommandFinish(output,1,status)
  FI

RETURN(CommandFinish(input,1,status))

; Snapshot every pattern match before opening output; a pattern always needs
; a directory target, even when it selects only one regular file.
LONGINT FUNC Main()
  CSTRING target
  CARD index

  LET parsed=COMMAND.ReadArgsOrHelp(c"FROM/A,TO/A,APPEND/S",
      values,3,arguments,SIZEOF(arguments))
  IF parsed<>COMMAND.ARGS_PARSED THEN
    RETURN(IF parsed=COMMAND.ARGS_HELP THEN COMMAND.RETURN_OK
        ELSE COMMAND.RETURN_ERROR FI)
  FI

  IF CommandName(values(0))=0 OR CommandName(values(1))=0 THEN
    RETURN(COMMAND.RETURN_ERROR)
  FI

  LET source=CSTRING(BYTE POINTER(values(0)))
  target=CSTRING(BYTE POINTER(values(1)))
  LET prefix=CommandPattern(source)
  IF prefix=SELECTION_INVALID THEN
    RETURN(COMMAND.RETURN_ERROR)
  FI

  IF CommandPattern(target)<>SELECTION_EXACT THEN
    COMMAND.SetIoErr(COMMAND.ERROR_BAD_ARGUMENTS)
    RETURN(COMMAND.RETURN_ERROR)
  FI

  IF target(0)='. AND target(1)=ASCII.NUL THEN
    target=c""
  FI

  LET append=BYTE(values(2)<>0)
  IF prefix=SELECTION_EXACT THEN
    RETURN(CopyOne(source,target,append,1))
  FI

  selectionCount=0
  IF CommandSelect(source,prefix,1,@destinationInfo)=0 THEN
    RETURN(COMMAND.RETURN_ERROR)
  FI

  IF CopyDirectory(target)=0 THEN
    RETURN(COMMAND.RETURN_ERROR)
  FI

  ; Check destination capacity for every name before creating any output.
  FOR index=0 TO selectionCount-1 DO
    IF CopyDestination(CommandSelected(index),target)=NULL THEN
      RETURN(COMMAND.RETURN_ERROR)
    FI
  OD

  FOR index=0 TO selectionCount-1 DO
    BEGIN
      LET path=CommandSelected(index)
      IF path=NULL THEN
        RETURN(COMMAND.RETURN_ERROR)
      FI

      LET destination=CopyDestination(path,target)
      IF destination=NULL THEN
        RETURN(COMMAND.RETURN_ERROR)
      FI

      IF CopyOne(path,destination,append,0)<>COMMAND.RETURN_OK THEN
        RETURN(COMMAND.RETURN_ERROR)
      FI
    END
  OD

RETURN(COMMAND.RETURN_OK)

ENDMODULE
