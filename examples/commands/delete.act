MODULE DELETE

USE CSTRING AS STR
INCLUDE "command-write.inc"
INCLUDE "command-pattern.inc"
INCLUDE "command-selection.inc"

BYTE ARRAY arguments(COMMAND.ARGS_STORAGE_BYTES)
ADDRESS ARRAY values(1)
COMMAND.FileInfoBlock info

; Validate and collect the whole bounded name list before the first deletion.
LONGINT FUNC Main()
  ADDRESS POINTER files
  CARD index

  LET parsed=COMMAND.ReadArgsOrHelp(c"FILE/M/A",
      values,1,arguments,SIZEOF(arguments))
  IF parsed<>COMMAND.ARGS_PARSED THEN
    RETURN(IF parsed=COMMAND.ARGS_HELP THEN COMMAND.RETURN_OK
        ELSE COMMAND.RETURN_ERROR FI)
  FI

  files=ADDRESS POINTER(values(0))
  selectionCount=0
  index=0
  WHILE files(index)<>0 DO
    IF CommandName(files(index))=0 THEN
      RETURN(COMMAND.RETURN_ERROR)
    FI

    BEGIN
      LET path=CSTRING(BYTE POINTER(files(index)))
      LET prefix=CommandPattern(path)
      IF CommandSelect(path,prefix,0,@info)=0 THEN
        RETURN(COMMAND.RETURN_ERROR)
      FI
    END

    index==+1
  OD

  index=0
  WHILE index<selectionCount DO
    IF CommandReady()=0 THEN
      RETURN(COMMAND.RETURN_ERROR)
    FI

    BEGIN
      LET path=CommandSelected(index)
      IF path=NULL THEN
        RETURN(COMMAND.RETURN_ERROR)
      FI

      IF COMMAND.DeleteFile(BYTE POINTER(path))=0 THEN
        RETURN(COMMAND.RETURN_ERROR)
      FI
    END

    index==+1
  OD

  COMMAND.SetIoErr(0)

RETURN(COMMAND.RETURN_OK)

ENDMODULE
