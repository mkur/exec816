MODULE SHELLAPP
USE DESKAPP
USE DESKBOOT

INCLUDE "shell/shell-session.inc"
INCLUDE "shell/shell-boot.inc"
INCLUDE "shell/shell-controller.inc"
INCLUDE "shell/shell-desktop.inc"

LONGINT exitStatus

; The shell and demonstration client share only the desktop message service.
PROC Main()

  IF ShellControllerStart(0)<>0 THEN
    IF DESKAPP.Start()=0 THEN
      ShellDesktopNotice(c"desktop app unavailable\n")
    FI

    exitStatus=ShellControllerRun()
  ELSE
    exitStatus=controllerStatus
  FI

  IF DESKBOOT.StopAdmission()=0 THEN
    HEAPCORE.Abort($faea)
  FI

  DESKAPP.Stop()
  ShellControllerStop()

RETURN

ENDMODULE
