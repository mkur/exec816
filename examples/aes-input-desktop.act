MODULE SHELLAPP
USE AESBOOT
USE DESKBOOT

INCLUDE "shell/shell-session.inc"
INCLUDE "shell/shell-boot.inc"
INCLUDE "shell/shell-controller.inc"
INCLUDE "shell/shell-desktop.inc"

LONGINT exitStatus

; InputsStart/Stop are linked by the resident C application builder.
PROC Main()

  IF ShellControllerStart(0)<>0 THEN
    IF InputsStart()=0 THEN
      ShellDesktopNotice(c"GEM input apps unavailable\n")
    FI

    exitStatus=ShellControllerRun()
  ELSE
    exitStatus=controllerStatus
  FI

  IF InputsStop()=0 THEN
    HEAPCORE.Abort($fcb8)
  FI

  IF DESKBOOT.StopAdmission()=0 THEN
    HEAPCORE.Abort($faea)
  FI

  ShellControllerStop()

RETURN
ENDMODULE
