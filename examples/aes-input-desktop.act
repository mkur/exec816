MODULE SHELLAPP
USE AESBOOT
USE DESKBOOT

INCLUDE "shell/shell-session.inc"
INCLUDE "shell/shell-boot.inc"

ShellContext context

LONGINT exitStatus

; InputsStart/Stop are linked by the resident C application builder.
PROC Main()

  IF ShellBootStart(@context,shellCon)<>0 THEN
    IF InputsStart()=0 THEN
      ShellText(@context,context.shell.console,c"GEM input apps unavailable")
      ShellByte(@context,context.shell.console,ASCII.LF)
    FI

    WHILE context.shell.done=0 DO
      ShellReadStep(@context)
    OD
  FI

  IF InputsStop()=0 THEN
    HEAPCORE.Abort($fcb8)
  FI

  IF DESKBOOT.StopAdmission()=0 THEN
    HEAPCORE.Abort($faea)
  FI

  exitStatus=ShellFinish(@context)

RETURN
ENDMODULE
