MODULE DEMO
INCLUDE "demo-session.inc"
LONGINT exitStatus

; Root supervises the shell, whose first startup launches the prime demo.
PROC Main()

  IF ShellControllerStart(1)<>0 THEN
    exitStatus=ShellControllerRun()
  ELSE
    exitStatus=controllerStatus
  FI

  ShellControllerStop()

RETURN

ENDMODULE
