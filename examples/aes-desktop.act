MODULE SHELLAPP
USE AESBOOT
USE DESKBOOT

INCLUDE "shell/shell-session.inc"
INCLUDE "shell/shell-boot.inc"

LONGINT exitStatus

; CountersStart/Stop are linked by the resident C application builder.
PROC Main()

  IF ShellBootStart(shellCon)<>0 THEN
    IF CountersStart()=0 THEN
      ShellText(shell.console,c"GEM counters unavailable")
      ShellByte(shell.console,ASCII.LF)
    FI

    WHILE shell.done=0 DO
      ShellReadStep()
    OD
  FI

  IF CountersStop()=0 THEN
    HEAPCORE.Abort($fcb8)
  FI

  IF DESKBOOT.StopAdmission()=0 THEN
    HEAPCORE.Abort($faea)
  FI

  exitStatus=ShellFinish()

RETURN
ENDMODULE
