MODULE SHELLAPP

INCLUDE "shell-session.inc"
INCLUDE "shell-boot.inc"
INCLUDE "shell-controller.inc"

LONGINT exitStatus

; Root supervises independent shell Processes through owned messages/signals.
PROC Main()

  IF ShellControllerStart(0)<>0 THEN
    exitStatus=ShellControllerRun()
  ELSE
    exitStatus=controllerStatus
  FI

  ShellControllerStop()

RETURN

ENDMODULE
