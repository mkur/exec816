MODULE SHELLAPP

INCLUDE "shell-session.inc"
INCLUDE "shell-boot.inc"

ShellContext context

LONGINT exitStatus

; Keep the resident shell available until exit or an unrecoverable failure,
; then release the session and leave its result for the host.
PROC Main()

  IF ShellBootStart(@context,shellCon)<>0 THEN
    WHILE context.shell.done=0 DO
      ShellReadStep(@context)
    OD
  FI

  exitStatus=ShellFinish(@context)

RETURN

ENDMODULE
