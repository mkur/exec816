* text=auto
*.md text eol=lf
*.json text eol=lf
*.act text eol=lf
*.s text eol=lf
*.py text eol=lf
*.sh text eol=lf
# Unified diff context includes a leading space before blank lines and tabs.
*.patch -whitespace
*.rom binary
*.bin binary
*.xex binary
*.atr binary
# Immutable donor bytes; normalization happens only in prepared build copies.
ports/magic/mgview/upstream/* binary
ports/magic/mgedit/upstream/** binary
ports/magic/mgview/sample.txt binary
