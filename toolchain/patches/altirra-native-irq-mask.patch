 }
+
+// An IRQ recognized immediately after SEI may still enter once. The delayed
+// mask flag must be consumed by interrupt entry, before fetching the handler.
+// Otherwise an asserted IRQ repeatedly pushes frames at the vector despite I=1.
+int ATRunCPUInterruptTests() {
+	int failures = 0;
+	for (int mode = 0; mode < 5; ++mode) {
+		for (int nmi = 0; nmi < 2; ++nmi) {
+			ATCPUTestMemory mem;
+			mem.Init();
+			ATCPUTestCallbacks callbacks;
+			ATCPUTestHarness cpu;
+			cpu.Init(&mem, nullptr, &callbacks);
+			cpu.SetHistoryEnabled(false);
+			cpu.SetStopOnBRK(false);
+			cpu.SetCPUMode(kATCPUMode_65C816, 1);
+			cpu.ColdReset();
+			const bool emulation = mode == 4;
+			const uint8 flags = emulation ? 0x30 : (uint8)(mode << 4);
+			const uint16 stack = emulation ? 0x01F0 : 0x4000;
+			const uint8 bank = emulation ? 0 : 3;
+			uint8 *ram = mem.Ram();
+			const uint8 entry[] = { 0x78, 0xEA, 0x80, 0xFE }; // SEI; NOP; BRA self
+			const uint8 irq[] = { 0xEE, 0x00, 0x02, 0x80, 0xFE }; // INC $0200; BRA self
+			const uint8 nmiCode[] = { 0xEE, 0x02, 0x02, 0x80, 0xFE };
+			memcpy(ram + ((uint32)bank << 16) + 0x8000, entry, sizeof entry);
+			memcpy(ram + 0x9000, irq, sizeof irq);
+			memcpy(ram + 0xA000, nmiCode, sizeof nmiCode);
+			const uint16 irqVector = emulation ? 0xFFFE : 0xFFEE;
+			const uint16 nmiVector = emulation ? 0xFFFA : 0xFFEA;
+			ram[irqVector] = 0; ram[irqVector + 1] = 0x90;
+			ram[nmiVector] = 0; ram[nmiVector + 1] = 0xA0;
+			cpu.LoadTestState(0x8000, 0, 0, 0, stack, 0, 0, bank, flags, emulation);
+			callbacks.mCycle = 100;
+			cpu.AssertIRQ(-2); // recognized at the boundary after the real SEI
+			if (nmi)
+				cpu.AssertNMI(); // NMI wins that boundary with IRQ still asserted
+			for (int cycle = 0; cycle < 64; ++cycle) {
+				cpu.Advance65816();
+				++callbacks.mCycle;
+			}
+			const uint16 expectedS = stack - (emulation ? 3 : 4);
+			const bool pass = ram[0x200] == (nmi ? 0 : 1)
+				&& ram[0x202] == (nmi ? 1 : 0) && cpu.GetS16() == expectedS
+				&& (cpu.GetP() & 4) && cpu.GetK() == 0;
+			printf("interrupt-mask mode=%d nmi=%d: %s (IRQ=%u NMI=%u S=%04X P=%02X)\n",
+				mode, nmi, pass ? "PASS" : "FAIL", ram[0x200], ram[0x202],
+				cpu.GetS16(), cpu.GetP());
+			if (!pass)
+				++failures;
+		}
+	}
+	return failures ? 1 : 0;
+}
