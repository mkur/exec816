+// Exec816 fault responder: only explicitly addressed D8, never the boot disk.
+// Changes peripheral bytes/stop bits, without calling into the guest kernel.
+static bool Exec816SIOFault(const char *name) {
+	const char *path = std::getenv("EXEC816_SIO_FAULT_FILE");
+	char value[32] {};
+	if (!path) return false;
+	FILE *file = std::fopen(path, "r");
+	if (!file) return false;
+	std::fscanf(file, "%31s", value);
+	std::fclose(file);
+	return !std::strcmp(value, name);
