 #include <stdafx.h>
+#include <cstdio>
+#include <cstdlib>
+
+// Selected instruction observations on the existing history path, no guest cycles.
+static bool Exec816LatencyPC(unsigned pc) {
+    struct Selection {
+        bool selected[1 << 24] = {};
+        Selection() {
+            const char *p = std::getenv("EXEC816_LATENCY_PCS");
+            while (p && *p) {
+                char *end;
+                const unsigned long address = std::strtoul(p, &end, 16);
+                if (end == p || address > 0xffffff) break;
+                selected[address] = true;
+                p = *end == ","[0] ? end + 1 : end;
+            }
+        }
+    };
+    static const Selection selection;
+    return selection.selected[pc & 0xffffff];
+}
+
+// Passive observer state, shared across native/emulation CPU dispatch paths.
+static bool Exec816MaskChanged(unsigned p) {
+    static const bool enabled = std::getenv("EXEC816_MASK_TRACE") != nullptr;
+    if (!enabled) return false;
+    static int previousI = -1;
+    const int masked = (p & 4) != 0;
+    if (masked == previousI) return false;
+    previousI = masked;
+    return true;
+}
+
