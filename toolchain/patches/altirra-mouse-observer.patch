+// MOUSE ST | CLEAR | AT delay_cycles dx dy left(-1 unchanged,0 up,1 down)
+std::string CmdMouse(ATSimulator& sim, const std::vector<std::string>& tokens) {
+	if (tokens.size() == 2 && tokens[1] == "ST") {
+		g_mouse.Clear();
+		g_mouse.sim = &sim;
+		if (getenv("EXEC816_MOUSE_TRACE"))
+			g_ATMousePhaseObserver = [](uint32 bits, uint32 x, uint32 y) {
+				fprintf(stderr, "MOUSE_PHASE %llu %u %u %u\n",
+					(unsigned long long)g_mouse.sim->GetScheduler()->GetTick64(), bits, x, y);
+			};
+		auto *input = sim.GetInputManager();
+		input->RemoveAllInputMaps();
+		for (uint32 i = 0; i < input->GetPresetInputMapCount(); ++i) {
+			vdrefptr<ATInputMap> map;
+			if (input->GetPresetInputMapByIndex(i, ~map) &&
+				!wcscmp(map->GetName(), L"Mouse -> ST Mouse (port 1)")) {
+				input->AddInputMap(map);
+				input->ActivateInputMap(map, true);
+				g_mouse.enabled = true;
+				return JsonOk("\"map\":\"Mouse -> ST Mouse (port 1)\"");
+			}
+		}
+		g_mouse.enabled = false;
+		return JsonError("MOUSE: ST preset unavailable");
+	}
+	if (tokens.size() == 2 && tokens[1] == "CLEAR") {
+		g_mouse.Clear();
+		return JsonOk();
+	}
+	if (tokens.size() != 6 || tokens[1] != "AT" || !g_mouse.enabled)
+		return JsonError("MOUSE: configure ST, then AT delay dx dy left or CLEAR");
+	long values[4];
+	for (int i = 0; i < 4; ++i) {
+		char *end;
+		values[i] = strtol(tokens[i+2].c_str(), &end, 10);
+		if (*end) return JsonError("MOUSE: invalid integer");
+	}
+	if (values[0] < 1 || values[0] > 100000000 ||
+		values[1] < -4096 || values[1] > 4096 ||
+		values[2] < -4096 || values[2] > 4096 ||
+		values[3] < -1 || values[3] > 1)
+		return JsonError("MOUSE: out of range");
+	for (uint32 i = 0; i < 512; ++i) {
+		auto& item = g_mouse.items[i];
+		if (item.event) continue;
+		item.dx = (int)values[1]; item.dy = (int)values[2];
+		item.left = (int)values[3];
+		item.event = sim.GetScheduler()->AddEvent((uint32)values[0], &g_mouse, i);
+		return JsonOk("\"cycle\":" + std::to_string(
+			sim.GetScheduler()->GetTick64() + values[0]));
+	}
+	return JsonError("MOUSE: queue full");
 }
 
