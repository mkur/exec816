+// Diagnostic commands drive the existing map, on the simulator thread.
+struct MouseStimulus final : IATSchedulerCallback {
+	struct Item { ATEvent *event = nullptr; int dx = 0, dy = 0, left = -1; };
+	Item items[512];
+	ATSimulator *sim = nullptr;
+	bool enabled = false;
+	void Clear() {
+		if (!sim) return;
+		for (auto& item : items) sim->GetScheduler()->UnsetEvent(item.event);
+		sim->GetInputManager()->OnButtonUp(0, kATInputCode_MouseLMB);
+	}
+	void OnScheduledEvent(uint32 id) override {
+		auto& item = items[id];
+		item.event = nullptr;
+		auto *input = sim->GetInputManager();
+		input->OnMouseMove(0, item.dx, item.dy);
+		if (item.left >= 0)
+			input->OnButtonChanged(0, kATInputCode_MouseLMB, item.left != 0);
+		if (getenv("EXEC816_MOUSE_TRACE"))
+			fprintf(stderr, "MOUSE_HOST %llu %d %d %d\n",
+				(unsigned long long)sim->GetScheduler()->GetTick64(),
+				item.dx, item.dy, item.left);
+	}
+} g_mouse;
 
