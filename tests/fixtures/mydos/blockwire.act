; Explicit host-served sector provider. The host supplies bytes only; all
; geometry, metadata, path and chain decisions execute in the guest library.
MODULE BLOCKWIRE
USE EXEC
USE DOSCORE
USE DOSBREAKTYPES
; Reuse the existing test far-write and register-extension scratch. Host
; updates stay in bank zero; no injected guest code runs at an upper-bank PC.
VOLATILE BYTE ready=$7d00
CARD sector=$7d02
CARD length=$7d04
CARD actual=$7d06
BYTE error=$7d08
BYTE ARRAY staging(256)=$7c00

; Supply host-controlled sector bytes while keeping all filesystem
; interpretation in guest code.
PUBLIC INT FUNC Transfer(EXEC.IOStdReq POINTER request DOSCORE.DosRegistry
    POINTER registry DOSBREAKTYPES.Scope POINTER scope)
  CARD index

  LET sio=EXEC.IOSIOReq POINTER(request)
  sector=CARD(sio.sio_Aux1)+(CARD(sio.sio_Aux2) LSH 8)
  length=CARD(request.io_Length)
  actual=length
  error=0
  ready=1
  WHILE ready<>2 DO
  OD

  request.io_Actual=0
  request.io_Error=error
  IF error=0 THEN
    FOR index=0 TO length-1 DO
      request.io_Data(index)=staging(index)
    OD

    request.io_Actual=LONGCARD(actual)
  FI

  ready=0

RETURN(INT(error))

ENDMODULE
