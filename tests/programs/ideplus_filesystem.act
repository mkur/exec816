MODULE IDEPLUSFILESYSTEM
USE EXEC
USE DOS
USE FSBOOT
USE HEAPCORE
CARD checks,count
LONGINT lastError
BYTE ARRAY buffer(257)
DOS.FileInfoBlock info

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($f900+(checks & 255))
  FI

  checks==+1

RETURN

PROC Main()
  CARD index,offset,part,position
  LONGINT got
  BYTE POINTER row,expected
  CARD POINTER fields
  DOS.FileHandle POINTER file

  FOR index=0 TO count-1 DO
    row=BYTE POINTER($2d1000)+SIZE(index)*72
    fields=CARD POINTER(row+64)
    expected=BYTE POINTER($2e0000)+SIZE(fields(1))
    file=DOS.Open(row,DOS.MODE_OLDFILE)
    Require(file<>NULL)
    position=0
    WHILE position<fields(0) DO
      part=fields(0)-position
      IF part>257 THEN
        part=257
      FI

      got=DOS.Read(file,buffer,LONGINT(part))
      Require(got=LONGINT(part))
      FOR offset=0 TO part-1 DO
        IF buffer(offset)<>expected(position+offset) THEN
          Require(0)
        FI
      OD

      position==+part
    OD

    Require(DOS.Read(file,buffer,1)=0)
    Require(DOS.Close(file)<>0)
  OD

  BEGIN
    LET lock=DOS.Lock(BYTE POINTER(c"IDE:"),DOS.SHARED_LOCK)
    lastError=DOS.IoErr()
    Require(lock<>NULL)
    Require(DOS.Examine(lock,@info)<>0)
    Require(DOS.ExNext(lock,@info)<>0)
    DOS.UnLock(lock)
    LET denied=DOS.Open(BYTE POINTER(c"IDE:FORBID.TXT"),DOS.MODE_NEWFILE)
    Require(denied=NULL)
    LET ram=DOS.Open(BYTE POINTER(c"RAM:LIVE.TXT"),DOS.MODE_NEWFILE)
    Require(ram<>NULL)
    Require(DOS.Write(ram,BYTE POINTER(c"RAM is alive"),12)=12)
    Require(DOS.Close(ram)<>0)
  END

  Require(DOS.ReleaseContext()<>0 AND FSBOOT.Stop()<>0)

RETURN

ENDMODULE
