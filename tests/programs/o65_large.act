MODULE O65LARGE
USE EXEC
USE DOSCLIENT
USE PROGRAM
USE PROGRAMIMAGE
USE PROCESS
USE HEAPCORE
INCLUDE "o65-large.inc"
BYTE fault,finished
CARD checks
LONGCARD identity
PROGRAMIMAGE.Image POINTER image
LONGCARD ARRAY bases(2)

; Fail immediately when an observed result violates the fixture contract.
PROC Check(BYTE good)

  IF good=0 THEN
    HEAPCORE.Abort($ea00+checks)
  FI

  checks==+1

RETURN

; Exercise loading a command whose image crosses bank boundaries.
PROC Main()
  DOSCLIENT.ClientContext POINTER client
  PROCESS.Result outcome
  BYTE POINTER gap,source
  LONGCARD before,length
  BYTE iteration

  client=DOSCLIENT.Ensure()
  Check(client<>DOSCLIENT.ClientContext POINTER(0))
  before=EXEC.AvailMem(0)
  gap=BYTE POINTER(0)
  FOR iteration=0 TO 1 DO
    IF iteration<>0 THEN
      gap=EXEC.AllocMem(65536,EXEC.MEMF_UPPER OR EXEC.MEMF_LINEAR)
      Check(gap<>BYTE POINTER(0))
    FI

    source=BYTE POINTER(ADDRESS($d0000))
    length=BIG_BYTES
    IF fault<>0 THEN
      source==+SIZE(BIG_BYTES)
      length=FAULT_BYTES
    FI

    image=PROGRAM.Load(source,length)
    Check(image<>PROGRAMIMAGE.Image POINTER(0))
    bases(iteration)=LONGCARD(image.text)
    identity=PROCESS.StartLoaded(BYTE POINTER(image),BYTE POINTER(0),0,0)
    Check(identity<>0)
    PROGRAM.Unload(image)
    Check(PROCESS.Wait(identity,@outcome)<>0)
    Check(outcome.primary=0 AND outcome.secondary=EXPECTED)
    IF gap<>BYTE POINTER(0) THEN
      EXEC.FreeMem(gap,65536)
    FI

    Check(EXEC.AvailMem(0)=before)
  OD

  Check(bases(0)<>bases(1))
  Check(DOSCLIENT.ReleaseContext()<>0)
  finished=1

RETURN

ENDMODULE
