MODULE DOSNOMOUNTS
USE EXEC
USE DOS
USE HEAPCORE
BYTE ARRAY path=[68 49 58 0]
CARD checks

; Stop at the first failed fixture invariant and retain its check index for
; diagnosis.
PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($fa00+checks)
  FI

  checks==+1

RETURN

; Exercise DOS errors when no filesystem mounts are configured.
PROC Main()
  LONGCARD baseline
  DOS.FileHandle POINTER file

  baseline=EXEC.AvailMem(0)
  Require(DOS.IoErr()=0)
  Require(DOS.ReleaseContext()<>0 AND EXEC.AvailMem(0)=baseline)
  file=DOS.Open(path,DOS.MODE_OLDFILE)
  Require(file=DOS.FileHandle POINTER(0)
      AND DOS.IoErr()=DOS.ERROR_DEVICE_NOT_MOUNTED)
  Require(DOS.ReleaseContext()<>0 AND EXEC.AvailMem(0)=baseline)

RETURN

ENDMODULE
