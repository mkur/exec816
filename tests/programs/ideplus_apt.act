MODULE IDEPLUSAPTTEST
USE EXEC
USE IDEPLUS
USE IDEMETA
USE IDEPLUSDRIVER
USE HEAPCORE

CARD checks
BYTE expectedFailure,unsupported
PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($f900+(checks & 255))
  FI

  checks==+1

RETURN

PROC Main()
  BYTE unit,sector
  CARD index
  IDEPLUS.Geometry geometry

  LET before=EXEC.AvailMem(0)
  LET port=EXEC.CreateMsgPort()
  LET request=EXEC.IOStdReq POINTER(EXEC.CreateIORequest(port,EXEC.IOSTDREQ_SIZE))
  Require(port<>NULL AND request<>NULL)
  LET name=BYTE POINTER(ADDRESS(IDEMETA.NAME))
  Require(EXEC.OpenDevice(name,1,EXEC.IORequest POINTER(request),0)<>0)
  FOR unit=2 TO 9 DO
    BEGIN
      LET error=EXEC.OpenDevice(name,LONGCARD(unit),EXEC.IORequest POINTER(request),0)
      IF expectedFailure<>0 OR (unit=2 AND unsupported<>0) THEN
        Require(error<>0)
      ELSE
        Require(error=0)
        request.io_Command=IDEPLUS.GET_GEOMETRY
        request.io_Data=BYTE POINTER(@geometry)
        request.io_Length=SIZEOF(IDEPLUS.Geometry)
        Require(EXEC.DoIO(EXEC.IORequest POINTER(request))=0)
        Require(geometry.bytes=512)
        Require(geometry.sectors=4 AND (geometry.flags & IDEPLUS.FLAG_READONLY)<>0)
        request.io_Data=BYTE POINTER($2dfff0)
        FOR sector=0 TO 3 DO
          request.io_Command=IDEPLUS.READ_SECTOR
          request.io_Length=LONGCARD(geometry.bytes)
          request.io_Offset=LONGCARD(sector)
          Require(EXEC.DoIO(EXEC.IORequest POINTER(request))=0)
          Require(request.io_Actual=request.io_Length)
          FOR index=0 TO geometry.bytes-1 DO
            Require(request.io_Data(index)=(BYTE(index) XOR BYTE(index RSH 8) XOR sector XOR unit))
          OD
        OD

        request.io_Offset=1
        request.io_Length=128
        Require(EXEC.DoIO(EXEC.IORequest POINTER(request))=EXEC.IOERR_BADLENGTH)
        Require(request.io_Actual=0)
        request.io_Length=256
        Require(EXEC.DoIO(EXEC.IORequest POINTER(request))=EXEC.IOERR_BADLENGTH)
        request.io_Length=512
        request.io_Offset=4
        Require(EXEC.DoIO(EXEC.IORequest POINTER(request))=EXEC.IOERR_BADLENGTH)
        EXEC.CloseDevice(EXEC.IORequest POINTER(request))
      FI
    END
  OD

  Require(EXEC.OpenDevice(name,0,EXEC.IORequest POINTER(request),0)=0)
  EXEC.CloseDevice(EXEC.IORequest POINTER(request))
  IDEPLUSDRIVER.Stop()
  Require(IDEPLUSDRIVER.State()=0)
  EXEC.DeleteIORequest(EXEC.IORequest POINTER(request))
  EXEC.DeleteMsgPort(port)
  Require(EXEC.AvailMem(0)=before)

RETURN
ENDMODULE
