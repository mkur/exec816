; Bounded writes use a live far span; no partial prefix is promised on failure.
MODULE IDEPLUSRANGES
USE EXEC
USE IDEPLUS
USE IDEMETA
USE IDEPLUSDRIVER
USE IDEWRITEPROBE
USE HEAPCORE

CARD checks
BYTE protected,expectedError

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($f900+(checks & 255))
  FI
  checks==+1

RETURN

PROC Change(EXEC.IOStdReq POINTER request BYTE count,seed)
  CARD index,sector
  INT error

  LET source=BYTE POINTER($2dfff0)
  request.io_Data=source
  request.io_Length=LONGCARD(count)*512
  request.io_Offset=0
  request.io_Command=IDEPLUS.WRITE_SECTORS
  FOR index=0 TO CARD(count)*512-1 DO
    source(index)=BYTE(index) XOR BYTE(index RSH 8) XOR seed
  OD

  error=EXEC.DoIO(EXEC.IORequest POINTER(request))
  Require(IDEWRITEPROBE.readbacks=0)
  IF expectedError<>0 THEN
    Require(error=INT(expectedError) AND request.io_Actual=0)
    Require(IDEPLUSDRIVER.Unavailable()<>0)
  ELSEIF protected<>0 THEN
    Require(error=IDEPLUS.ERROR_PROTECTED AND request.io_Actual=0)
  ELSE
    Require(error=0 AND request.io_Actual=LONGCARD(count)*512)
    FOR sector=0 TO count-1 DO
      request.io_Data=source+SIZE(sector)*512
      request.io_Length=512
      request.io_Offset=LONGCARD(sector)
      request.io_Command=IDEPLUS.READ_SECTOR
      Require(EXEC.DoIO(EXEC.IORequest POINTER(request))=0)
    OD
    FOR index=0 TO CARD(count)*512-1 DO
      Require(source(index)=(BYTE(index) XOR BYTE(index RSH 8) XOR seed))
    OD
  FI

RETURN

PROC Invalid(EXEC.IOStdReq POINTER request LONGCARD length,offset)

  request.io_Command=IDEPLUS.WRITE_SECTORS
  request.io_Length=length
  request.io_Offset=offset
  Require(EXEC.DoIO(EXEC.IORequest POINTER(request))=EXEC.IOERR_BADLENGTH)
  Require(request.io_Actual=0)

RETURN

PROC Main()

  LET before=EXEC.AvailMem(0)
  LET port=EXEC.CreateMsgPort()
  LET request=EXEC.IOStdReq POINTER(EXEC.CreateIORequest(port,EXEC.IOSTDREQ_SIZE))
  LET left=BYTE POINTER($2dffef)
  LET right=BYTE POINTER($2e07f0)
  Require(port<>NULL AND request<>NULL)
  left^=$a5
  right^=$5a
  Require(EXEC.OpenDevice(BYTE POINTER(ADDRESS(IDEMETA.NAME)),2,
      EXEC.IORequest POINTER(request),0)=0)

  Invalid(request,0,0)
  Invalid(request,513,0)
  Invalid(request,2560,0)
  Invalid(request,2048,1)
  Invalid(request,512,LONGCARD($ffffffff))
  ; Abort before the worker claims a range: one reply and no media mutation.
  request.io_Command=IDEPLUS.WRITE_SECTORS
  request.io_Data=BYTE POINTER($2dfff0)
  request.io_Length=2048
  request.io_Offset=0
  EXEC.Forbid()
  EXEC.SendIO(EXEC.IORequest POINTER(request))
  EXEC.AbortIO(EXEC.IORequest POINTER(request))
  EXEC.AbortIO(EXEC.IORequest POINTER(request))
  EXEC.Permit()
  Require(EXEC.WaitIO(EXEC.IORequest POINTER(request))=EXEC.IOERR_ABORTED)
  Require(request.io_Actual=0 AND EXEC.GetMsg(port)=NULL)

  IF expectedError<>0 THEN
    Change(request,4,$93)
  ELSE
    Change(request,1,$6c)
    Change(request,2,$a7)
    Change(request,4,$93)
  FI
  Require(left^=$a5 AND right^=$5a)
  EXEC.CloseDevice(EXEC.IORequest POINTER(request))
  IDEPLUSDRIVER.Stop()
  Require(IDEPLUSDRIVER.State()=(IF expectedError<>0 THEN 5 ELSE 0 FI))
  EXEC.DeleteIORequest(EXEC.IORequest POINTER(request))
  EXEC.DeleteMsgPort(port)
  Require(EXEC.AvailMem(0)=before)

RETURN

ENDMODULE
