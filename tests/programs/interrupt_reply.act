MODULE INTERRUPTREPLY
USE EXEC
USE EXECLISTS
USE HEAPCORE
USE HEAPAPIPROBE
USE PRODUCERPROBE
INCLUDE "../../lib/exec/exec-abi.inc"

EXEC.MsgPort port
EXEC.Message item
CARD checks
LONGCARD bits
VOLATILE BYTE mask=$10,irqen=$d20e,skctl=$d20f,skshadow=$232
VOLATILE BYTE nmien=$d40e
VOLATILE CARD irqs=E816_IRQ_COUNT
VOLATILE BYTE freq3=$d204,vol3=$d205,freq4=$d206,vol4=$d207,audctl=$d208,
    stimer=$d209,skreset=$d20a,serout=$d20d

; Exercise publication through a real owned serial IRQ, independently of SIO.
PROC Pulse()
  CARD before

  nmien=0
  skctl=0
  freq3=6
  vol3=0
  freq4=0
  vol4=0
  audctl=$28
  skshadow=$23
  skctl=$23
  skreset=$23
  stimer=$23
  before=irqs
  mask=mask % $10
  irqen=mask
  serout=$5a
  WHILE irqs=before DO
  OD

  mask=mask & $ef
  irqen=mask
  nmien=$40

RETURN

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($fe00+checks)
  FI

  checks==+1

RETURN

PROC Main()
  BYTE mode,bit

  LET self=EXEC.FindTask(NULL)
  bit=EXEC.AllocSignal(31)
  Require(bit=31)
  Require(PRODUCERPROBE.Bind(self,1)=1)
  port.mp_Node.ln_Type=EXEC.NT_MSGPORT
  port.mp_SigTask=self
  port.mp_SigBit=31
  EXECLISTS.NewList(@port.mp_MsgList)
  FOR mode=0 TO 2 DO
    port.mp_Flags=IF mode=1 THEN EXEC.PA_IGNORE ELSE EXEC.PA_SIGNAL FI
    item.mn_ReplyPort=@port
    IF mode=2 THEN
      item.mn_ReplyPort=NULL
    FI
    item.mn_Length=SIZEOF(EXEC.Message)
    item.mn_Node.ln_Type=EXEC.NT_MESSAGE
    bits=EXEC.SetSignal(0,LONGCARD($80000001))
    HEAPAPIPROBE.Fill(BYTE POINTER(@item),0,mode)
    Pulse()
    bits=EXEC.Wait(IF mode=0 THEN LONGCARD($80000000) ELSE LONGCARD(1) FI)
    IF mode=2 THEN
      Require(item.mn_Node.ln_Type=EXEC.NT_FREEMSG)
      Require(EXEC.GetMsg(@port)=NULL)
    ELSE
      Require(EXEC.GetMsg(@port)=@item)
      Require(item.mn_Node.ln_Type=EXEC.NT_REPLYMSG)
    FI

    Require(EXEC.GetMsg(@port)=NULL)
  OD

  PRODUCERPROBE.Release()
  EXEC.FreeSignal(31)

RETURN

ENDMODULE
