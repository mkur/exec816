MODULE IDEPLUSLAYOUT
USE IDEPLUS
USE HEAPCORE
IDEPLUS.Geometry result
IDEPLUS.Diagnostics diagnostic
IDEPLUS.PartitionInfo partition
PROC Main()
  IF SIZEOF(IDEPLUS.Geometry)<>12
      OR ADDRESS(@result.flags)-ADDRESS(@result)<>2
      OR ADDRESS(@result.sectors)-ADDRESS(@result)<>4
      OR ADDRESS(@result.generation)-ADDRESS(@result)<>8 THEN
    HEAPCORE.Abort($f901)
  FI
  IF SIZEOF(IDEPLUS.Diagnostics)<>24
      OR ADDRESS(@diagnostic.attempted)-ADDRESS(@diagnostic)<>12
      OR ADDRESS(@diagnostic.ataError)-ADDRESS(@diagnostic)<>20
      OR SIZEOF(IDEPLUS.PartitionInfo)<>16
      OR ADDRESS(@partition.flags)-ADDRESS(@partition)<>10
      OR ADDRESS(@partition.reason)-ADDRESS(@partition)<>15 THEN
    HEAPCORE.Abort($f902)
  FI
RETURN
ENDMODULE
