; Admission failure after registration must release the root's port and hold.
MODULE DESKSTART
USE EXEC
USE DESKTOP
USE DESKTYPES
USE DESKBOOT
USE DESKSTATE
USE REGIONS
USE HEAPCORE

DESKTYPES.Client filler,late
DESKTYPES.Request request
LONGCARD ARRAY windows(4)
EXEC.Task POINTER parent,worker
BYTE ready,finished
LONGCARD parentMask
BYTE parentBit
CARD checks

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($fbc0+(checks & 63))
  FI

  checks==+1

RETURN

PROC Call(BYTE operation)
  EXEC.Message POINTER message
  DESKTYPES.Request POINTER reply

  request.operation=operation
  Require(DESKTOP.Submit(@filler,@request)=DESKTYPES.OK)
  reply=DESKTOP.Collect(@filler)
  WHILE reply=NULL DO
    message=EXEC.WaitPort(filler.replies)
    reply=DESKTOP.Collect(@filler)
  OD

  Require(reply=@request AND reply.status=DESKTYPES.OK)

RETURN

PROC FillSlots()
  BYTE index
  LONGCARD bits

  Require(EXEC.AllocSignal(16)=16)
  Require(DESKTOP.Init(@filler,DESKSTATE.Get())<>0)
  DESKTOP.Prepare(@request,DESKTYPES.REGISTER)
  Call(DESKTYPES.REGISTER)
  FOR index=0 TO 3 DO
    DESKTOP.Prepare(@request,DESKTYPES.OPEN)
    request.value=DESKTYPES.CONTENT_COMMANDS
    request.payload=BYTE POINTER(c"Capacity")
    request.bytes=8
    REGIONS.Assign(@request.bounds,0,0,160,80)
    Call(DESKTYPES.OPEN)
    windows(index)=request.window
  OD

  ready=1
  EXEC.Signal(parent,parentMask)
  bits=EXEC.Wait($10000)
  FOR index=0 TO 3 DO
    DESKTOP.Prepare(@request,DESKTYPES.CLOSE)
    request.window=windows(index)
    Call(DESKTYPES.CLOSE)
  OD

  DESKTOP.Prepare(@request,DESKTYPES.UNREGISTER)
  Call(DESKTYPES.UNREGISTER)
  Require(DESKTOP.Dispose(@filler)<>0)
  EXEC.FreeSignal(16)
  EXEC.Forbid()
  finished=1
  EXEC.Signal(parent,parentMask)

RETURN

PROC Main()
  LONGCARD bits

  parent=EXEC.FindTask(NULL)
  parentBit=EXEC.AllocSignal(-1)
  Require(parentBit<>$ff)
  parentMask=LONGCARD(1) LSH parentBit
  DESKBOOT.Detach()
  worker=EXEC.CreateTask(c"window-capacity",0,@FillSlots,1024)
  Require(worker<>NULL)
  WHILE ready=0 DO
    bits=EXEC.Wait(parentMask)
  OD

  Require(DESKBOOT.Attach()=0)
  LET binding=DESKBOOT.Binding()
  Require(binding.id=0 AND binding.replies=NULL)
  EXEC.Signal(worker,$10000)
  WHILE finished=0 DO
    bits=EXEC.Wait(parentMask)
  OD

  Require(DESKBOOT.Attach()<>0)
  ; Queue an Open before closing admission. Dispatch must refuse it while
  ; existing Close/Unregister and the launcher's final cleanup still complete.
  EXEC.Forbid()
  DESKTOP.Prepare(@request,DESKTYPES.OPEN)
  request.value=DESKTYPES.CONTENT_COMMANDS
  request.payload=BYTE POINTER(c"Late")
  request.bytes=4
  REGIONS.Assign(@request.bounds,0,0,160,80)
  Require(DESKTOP.Submit(binding,@request)=DESKTYPES.OK)
  Require(DESKBOOT.StopAdmission()<>0)
  EXEC.Permit()
  BEGIN
    LET message=EXEC.WaitPort(binding.replies)
    LET reply=DESKTOP.Collect(binding)
    Require(reply=@request AND reply.status=DESKTYPES.CANCELLED)
  END

  Require(DESKTOP.Init(@late,DESKSTATE.Get())=0)
  EXEC.FreeSignal(parentBit)

RETURN

ENDMODULE
