MODULE DOSLIFETIME
USE EXEC
USE EXECTASKS
USE EXECLISTS
USE TASKSTACKS
USE DOS
USE DOSCLIENT
USE HEAPCORE
EXEC.Task child
PROC POINTER absent()
CARD checks,iteration,done
LONGCARD freeStart

; Stop at the first failed fixture invariant and retain its check index for
; diagnosis.
PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($f700+(checks & 255))
  FI

  checks==+1

RETURN

PROC Entry()
  DOSCLIENT.ClientContext POINTER client

  Require(DOS.IoErr()=0)
  client=DOSCLIENT.Ensure()
  Require(client<>DOSCLIENT.ClientContext POINTER(0))
  Require(LONGCARD(ADDRESS(client))>=65536
      AND LONGCARD(ADDRESS(client.port))>=65536)
  DOSCLIENT.SetError(LONGINT(iteration)+70000)
  Require(DOS.ReleaseContext()=-1)
  Require(DOS.IoErr()=LONGINT(iteration)+70000)
  Require(child.tc_UserData=ADDRESS($abcdef))
  done==+1

RETURN

PROC Prepare()
  BYTE POINTER bytes
  CARD i

  bytes=BYTE POINTER(@child)
  FOR i=0 TO EXEC.TASK_SIZE-1 DO
    bytes(i)=0
  OD

  child.tc_Node.ln_Type=EXEC.NT_TASK
  child.tc_SPLower=ADDRESS(TASKSTACKS.LOWER1)
  child.tc_SPUpper=ADDRESS(TASKSTACKS.UPPER1)
  child.tc_SPReg=child.tc_SPUpper-SIZE(2)
  child.tc_UserData=ADDRESS($abcdef)
  EXECLISTS.NewList(@child.tc_MemEntry)

RETURN

; Exercise DOS ownership preventing premature Task removal.
PROC Main()
  CARD status

  freeStart=EXEC.AvailMem(EXEC.MEMF_UPPER)
  FOR iteration=0 TO 259 DO
    Prepare()
    Require(EXEC.AddTask(@child,@Entry,absent)=@child)
    WHILE child.tc_State<>EXEC.TS_REMOVED DO
      status=EXECTASKS.Sleep(1)
    OD

    Require(EXEC.AvailMem(EXEC.MEMF_UPPER)=freeStart)
  OD

  Require(done=260 AND DOS.IoErr()=0)

RETURN

ENDMODULE
