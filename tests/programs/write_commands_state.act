MODULE WRITECOMMANDSTATE

PUBLIC TYPE TestCase=[
  LONGCARD length,breakAt
  LONGINT readChunk,writeChunk,readFail,prefixError,closeError,openError
  LONGINT seekError,mutationError,unlockError,failTarget,failAt,writeError
  LONGINT writePrefixError,zeroTarget,oversizedRead,same,interactive,patternBytes
  LONGINT destinationKind,lockError,examineError
  LONGINT enumerate,enumCount,enumErrorAt,enumDirMask,enumBreakAt
  BYTE ARRAY arguments(256)
  BYTE ARRAY data(768)
]

PUBLIC TYPE CaptureState=[
  LONGINT error
  LONGCARD position,fileCursor,fileLength,fileHash,outputLength,outputHash
  LONGCARD inputLive,fileLive,consoleLive,lockLive,opens,closes,reads
  LONGCARD fileWrites,outputWrites,seeks,operation,mode,badOwner,consoleUsed
  LONGCARD lockCalls,examines,targetUsed
  LONGCARD enumCalls,enumCursor,enumLock
  BYTE ARRAY file(1024)
  BYTE ARRAY output(1024)
  BYTE ARRAY console(256)
  BYTE ARRAY target(256)
]

PUBLIC TestCase POINTER scenario
PUBLIC CaptureState POINTER state

ENDMODULE
