MODULE INPUTTEST
USE EXEC
USE INPUT
USE INPUTNATIVE
USE HEAPCORE
USE EXECTASKS
INPUT.Lease lease,copied
INPUT.Config config
INPUT.Event event
LONGCARD tag,other,oldGeneration
LONGCARD ARRAY tags(16)
CARD checks,pending
BYTE finished,stage,received
INPUT.Event ARRAY events(16)
EXEC.Task POINTER parent,peer
EXEC.TaskLease peerLease

PROC Require(BYTE good)

  IF good=0 THEN
    HEAPCORE.Abort($f800+checks)
  FI

  checks==+1

RETURN

PROC PeerEntry()
  CARD status

  Require(INPUT.Take(@lease,@event)=INPUT.INVALID_OWNER)
  Require(INPUT.Release(@lease)=INPUT.INVALID_OWNER)
  Require(INPUT.Pending(@lease,@pending)=INPUT.OK)
  Require(INPUT.CreateRoute(@lease,0,@other)=INPUT.OK)
  Require(INPUT.PublishRoute(@lease,other)=INPUT.OK)
  Require(INPUT.Discard(@lease,other)=INPUT.OK)
  Require(INPUT.PublishRoute(@lease,0)=INPUT.OK)
  Require(INPUT.RetireRoute(@lease,other)=INPUT.OK)
  finished=1
  WHILE peerLease.task<>NULL DO
    EXEC.Yield()
  OD

RETURN

PROC Admission()
  BYTE index
  BYTE POINTER src,dst

  Require(SIZEOF(INPUTNATIVE.State)=128)
  Require(SIZEOF(INPUTNATIVE.Capture)=560)
  Require(SIZEOF(INPUTNATIVE.RawEvent)=8)
  Require(EXEC.AllocSignal(16)=16)
  config.version=1
  config.source=INPUT.SOURCE_KEYBOARD
  config.wakeMask=$10000
  config.filter0Value=$1c
  config.filter0Mask=$3f
  config.filterCount=1
  config.flags=INPUT.CAPTURE_BREAK
  Require(INPUT.Acquire(@lease,@config)=INPUT.OK)
  Require(INPUT.Acquire(@copied,@config)=INPUT.BUSY)
  Require(lease.acquisition<>0 AND lease.route=0)
  oldGeneration=lease.acquisition
  src=BYTE POINTER(@lease)
  dst=BYTE POINTER(@copied)
  FOR index=0 TO 31 DO
    dst(index)=src(index)
  OD

  Require(INPUT.Release(@copied)=INPUT.INVALID_OWNER)
  Require(INPUT.PublishRoute(@copied,0)=INPUT.INVALID_OWNER)
  Require(INPUT.Take(@copied,@event)=INPUT.INVALID_OWNER)
  event.code=$a55a
  Require(INPUT.Take(@lease,@event)=INPUT.EMPTY AND event.code=$a55a)
  Require(INPUT.Pending(@lease,@pending)=INPUT.OK AND pending=0)
  FOR index=0 TO 15 DO
    Require(INPUT.CreateRoute(@lease,0,@tags(index))=INPUT.OK)
  OD

  Require(INPUT.CreateRoute(@lease,0,@tag)=INPUT.BUSY)
  tag=tags(0)
  Require(INPUT.PublishRoute(@lease,tag)=INPUT.OK)
  Require(INPUT.RetireRoute(@lease,tag)=INPUT.BUSY)
  Require(INPUT.PublishRoute(@lease,0)=INPUT.OK)
  Require(INPUT.RetireRoute(@lease,tag)=INPUT.OK)
  Require(INPUT.PublishRoute(@lease,tag)=INPUT.BAD_ARGUMENT)
  Require(INPUT.CreateRoute(@lease,0,@tag)=INPUT.OK AND tag<>tags(0))
  tags(0)=tag
  FOR index=0 TO 15 DO
    Require(INPUT.RetireRoute(@lease,tags(index))=INPUT.OK)
  OD

  parent=EXEC.FindTask(NULL)
  peer=EXEC.CreateTask(c"input-peer",0,@PeerEntry,1024)
  Require(peer<>NULL)
  Require(EXEC.RetainTask(peer,@peerLease)=1)
  WHILE finished=0 DO
    EXEC.Yield()
  OD

  Require(EXEC.ReleaseTask(@peerLease)=1)
  WHILE peer.tc_State<>EXEC.TS_REMOVED DO
    EXEC.Yield()
  OD

RETURN

PROC Records()
  BYTE index
  CARD bit
  INPUTNATIVE.Capture POINTER capture
  INPUTNATIVE.State POINTER state

  capture=INPUTNATIVE.Capture POINTER($0f0c00)
  state=INPUTNATIVE.State POINTER($0f0a60)
  Require(INPUT.CreateRoute(@lease,0,@tag)=INPUT.OK)
  Require(INPUT.CreateRoute(@lease,0,@other)=INPUT.OK)
  EXEC.Forbid()
  capture.head=0
  capture.tail=192
  FOR index=0 TO 63 DO
    capture.events(index).key=index
    capture.events(index).kind=0
    capture.events(index).tick=$ffc0+CARD(index)
    capture.events(index).route=tag
  OD

  bit=CARD(1) LSH BYTE(tag & 15)
  capture.breakMask=bit
  capture.lostMask=bit
  capture.breakPending=1
  capture.lost=1
  state.cancelCode(BYTE(tag & 15))=INPUT.CANCEL_BREAK
  state.lossCode(BYTE(tag & 15))=INPUT.LOSS_RAW
  Require(INPUT.Pending(@lease,@pending)=INPUT.OK AND pending=7)
  Require(INPUT.RetireRoute(@lease,tag)=INPUT.BUSY)
  Require(INPUT.Take(@lease,@event)=INPUT.OK)
  Require(event.kind=INPUT.EVENT_CANCEL AND event.flags=0
      AND event.code=INPUT.CANCEL_BREAK AND event.route=tag)
  Require(INPUT.Take(@lease,@event)=INPUT.OK)
  Require(event.kind=INPUT.EVENT_LOSS AND event.flags=0
      AND event.code=INPUT.LOSS_RAW AND event.route=tag)
  FOR index=0 TO 63 DO
    Require(INPUT.Take(@lease,@event)=INPUT.OK)
    Require(event.kind=INPUT.EVENT_KEY AND event.code=CARD(index)
        AND event.route=tag AND event.tick=$ffc0+CARD(index)
        AND event.flags=INPUT.TICK_VALID AND event.acquisition=oldGeneration)
  OD

  Require(INPUT.Take(@lease,@event)=INPUT.EMPTY)
  capture.head=2
  capture.tail=0
  capture.events(0).key=63
  capture.events(0).kind=0
  capture.events(0).route=tag
  capture.events(1).key=18
  capture.events(1).kind=0
  capture.events(1).route=other
  capture.breakMask=bit
  capture.lostMask=bit
  Require(INPUT.Discard(@lease,tag)=INPUT.OK)
  Require(INPUT.Pending(@lease,@pending)=INPUT.OK AND pending=5)
  Require(INPUT.Take(@lease,@event)=INPUT.OK AND event.kind=INPUT.EVENT_CANCEL)
  Require(INPUT.Take(@lease,@event)=INPUT.OK AND event.route=other)
  Require(INPUT.Take(@lease,@event)=INPUT.EMPTY)
  ; Release must purge both raw bytes and durable mailboxes before admission.
  capture.head=1
  capture.tail=0
  capture.events(0).kind=0
  capture.events(0).route=tag
  capture.breakMask=bit
  capture.lostMask=bit
  Require(INPUT.Release(@lease)=INPUT.OK)
  state.generation=$ffffffff
  Require(INPUT.Acquire(@lease,@config)=INPUT.EXHAUSTED)
  Require(lease.state=INPUT.FREE AND capture.active=0)
  state.generation=oldGeneration
  Require(INPUT.Take(@lease,@event)=INPUT.INVALID_OWNER)
  Require(INPUT.Acquire(@lease,@config)=INPUT.OK)
  Require(lease.acquisition>oldGeneration)
  Require(INPUT.PublishRoute(@lease,tag)=INPUT.BAD_ARGUMENT)
  Require(INPUT.Pending(@lease,@pending)=INPUT.OK AND pending=0)
  oldGeneration=state.epoch
  state.epoch=$0fffffff
  Require(INPUT.CreateRoute(@lease,0,@tag)=INPUT.EXHAUSTED)
  state.epoch=oldGeneration
  ; The caller can reuse its configuration immediately after Acquire.
  config.flags=0
  config.filter0Value=0
  EXEC.Permit()
  Require(INPUT.CreateRoute(@lease,0,@tag)=INPUT.OK)
  Require(INPUT.PublishRoute(@lease,tag)=INPUT.OK)

RETURN

PROC Main()
  LONGCARD ignored
  BYTE index

  Admission()
  Records()
  stage=1
  WHILE received<4 DO
    IF INPUT.Take(@lease,@event)=INPUT.OK THEN
      events(received)=event
      received==+1
    ELSE
      ignored=EXEC.Wait($10000)
    FI
  OD

  Require(INPUT.Release(@lease)=INPUT.OK)
  Require(INPUT.Release(@copied)=INPUT.INVALID_OWNER)
  EXEC.FreeSignal(16)
  stage=2

RETURN

ENDMODULE
