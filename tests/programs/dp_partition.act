MODULE DPPARTITION

USE EXEC
USE EXECLISTS
USE EXECTASKS
USE TASKSTACKS
USE HEAPCORE
USE A816ABI
USE CSTRING.IMPL AS STR
INCLUDE "../../lib/exec/exec-abi.inc"
INCLUDE "task-types.inc"
CONST WORKSPACE_BYTES=A816ABI.DP_CALLER_WORKSPACE_SIZE
CONST BUFFER_BYTES=513
CONST GO_SIGNAL=$10000

BYTE ARRAY records(496)
EXEC.MsgPort POINTER reply
VOLATILE BYTE readyCount,finished
VOLATILE CARD ticks=E816_VBI_DISPATCHES
CARD checks
BYTE slot
PROC POINTER noFinalizer()

; Every assertion is also an ordinary Action! call in the owning domain.
PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($ed00+(checks & $ff))
  FI

  checks==+1

RETURN

; Inspect the private context only to locate the test's own domain.
BYTE POINTER FUNC Workspace()

  LET self=EXEC.FindTask(NULL)
  LET context=TaskControl POINTER(self.tc_ExecPrivate)

RETURN(BYTE POINTER(ADDRESS(context.dp)))

PROC Seed(BYTE POINTER page BYTE pattern)
  CARD index

  FOR index=0 TO WORKSPACE_BYTES-1 DO
    page(index)=BYTE(index) XOR pattern
  OD

RETURN

PROC Preserved(BYTE POINTER page BYTE pattern)
  CARD index

  FOR index=0 TO WORKSPACE_BYTES-1 DO
    Require(page(index)=(BYTE(index) XOR pattern))
  OD

RETURN

; Exercise caller-context clearing, resident calls and fast/full COP paths.
PROC Calls(BYTE POINTER page BYTE pattern)
  CARD index
  BYTE ARRAY text(24)

  LET block=EXEC.AllocMem(BUFFER_BYTES,EXEC.MEMF_UPPER OR EXEC.MEMF_CLEAR)
  Require(block<>NULL)
  FOR index=0 TO BUFFER_BYTES-1 DO
    Require(block(index)=0)
  OD

  Require(STR.strlcpy(text,c"partition",SIZEOF(text))=9)
  Require(STR.strlen(CSTRING(text))=9)
  EXEC.Forbid()
  Require(EXEC.GetMsg(reply)=NULL)
  EXEC.Permit()
  EXEC.FreeMem(block,BUFFER_BYTES)
  Preserved(page,pattern)

RETURN

; Locate a public test record independently of its private execution slot.
EXEC.Task POINTER FUNC TaskAt(BYTE id)

RETURN(EXEC.Task POINTER(ADDRESS(records)+SIZE(id)*EXEC.TASK_SIZE))

; Use the actual stack extent in either supported capacity profile.
PROC Prepare(BYTE id)
  CARD index

  LET item=TaskAt(id)
  LET bytes=BYTE POINTER(item)
  FOR index=0 TO EXEC.TASK_SIZE-1 DO
    bytes(index)=0
  OD

  item.tc_Node.ln_Type=EXEC.NT_TASK
  item.tc_UserData=SIZE(id)
  item.tc_SPLower=ADDRESS(TASKSTACKS.StackLower(id))
  item.tc_SPUpper=ADDRESS(TASKSTACKS.StackUpper(id))
  item.tc_SPReg=item.tc_SPUpper-SIZE(2)
  EXECLISTS.NewList(@item.tc_MemEntry)

RETURN

; Keep every worker's distinct caller workspace live across calls and switches.
PROC WorkerEntry()
  CARD index

  LET self=EXEC.FindTask(NULL)
  LET pattern=BYTE(self.tc_UserData)+$80
  LET page=Workspace()
  FOR index=0 TO WORKSPACE_BYTES-1 DO
    Require(page(index)=0)
  OD

  Seed(page,pattern)
  Require(EXEC.AllocSignal(16)=16)
  Calls(page,pattern)
  EXEC.Forbid()
  readyCount==+1
  EXEC.Permit()
  Require(EXEC.Wait(GO_SIGNAL)=GO_SIGNAL)
  Preserved(page,pattern)
  ; Busy computation also exercises asynchronous preemption of each owner.
  LET start=ticks
  WHILE CARD(ticks-start)<3 DO
    Preserved(page,pattern)
  OD

  Calls(page,pattern)
  EXEC.FreeSignal(16)

RETURN

; Wait for complete retirement before reusing a record or its direct page.
PROC AwaitRemoval(EXEC.Task POINTER item)
  CARD status

  WHILE item.tc_State<>EXEC.TS_REMOVED DO
    status=EXECTASKS.Sleep(1)
  OD

RETURN

; Fill every slot, then reuse an interior DP while both neighbours stay live.
PROC Main()
  CARD status

  LET page=Workspace()
  Seed(page,$59)
  reply=EXEC.CreateMsgPort()
  Require(reply<>NULL)
  FOR slot=1 TO TASKSTACKS.CAPACITY-1 DO
    Prepare(slot)
    Require(EXEC.AddTask(TaskAt(slot),@WorkerEntry,noFinalizer)=TaskAt(slot))
  OD

  WHILE readyCount<>TASKSTACKS.CAPACITY-1 DO
    status=EXECTASKS.Sleep(1)
  OD

  Calls(page,$59)
  EXEC.Signal(TaskAt(2),GO_SIGNAL)
  AwaitRemoval(TaskAt(2))
  LET left=TaskAt(1)
  LET right=TaskAt(3)
  Require(left.tc_State=EXEC.TS_WAIT AND right.tc_State=EXEC.TS_WAIT)
  Prepare(2)
  Require(EXEC.AddTask(TaskAt(2),@WorkerEntry,noFinalizer)=TaskAt(2))
  WHILE readyCount<>TASKSTACKS.CAPACITY DO
    status=EXECTASKS.Sleep(1)
  OD

  Preserved(page,$59)
  FOR slot=1 TO TASKSTACKS.CAPACITY-1 DO
    EXEC.Signal(TaskAt(slot),GO_SIGNAL)
  OD

  FOR slot=1 TO TASKSTACKS.CAPACITY-1 DO
    AwaitRemoval(TaskAt(slot))
  OD

  EXEC.DeleteMsgPort(reply)
  Preserved(page,$59)
  finished=1

RETURN

ENDMODULE
