; Copied consumer delivery into existing console ingress; source drain is tested
; through input.device rather than a frontend Take loop.
MODULE INPUTPUMP
USE CONSOLECOOKED
USE EXEC
USE INPUT
USE INPUTDRIVER
USE CONSOLEINPUT
USE CONSOLEINGRESS
USE CONSOLECAPTURE
USE CONSOLEWINDOWS
USE CONSOLEFOREGROUND
USE CONSOLETYPES
USE HEAPCORE

CONSOLETYPES.Instance instance
CONSOLETYPES.Service service
INPUT.Event captured
BYTE ARRAY fifo(128),output(128)
CARD checks
BYTE finished

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($f800+checks)
  FI
  checks==+1

RETURN

PROC Drain()

  EXEC.Forbid()
  WHILE CONSOLEINGRESS.Pending()<>0 DO
    CONSOLEINGRESS.Pump()
  OD
  EXEC.Permit()

RETURN

PROC Batch(BYTE count)
  BYTE index

  captured.kind=INPUT.EVENT_KEY
  FOR index=0 TO count-1 DO
    captured.code=IF (index & 1)=0 THEN 63 ELSE 21 FI
    CONSOLEINPUT.Deliver(LONGCARD(ADDRESS(@service)),@captured)
  OD

RETURN

PROC Main()
  BYTE index

  LET before=EXEC.AvailMem(0)
  Require(INPUTDRIVER.Start()<>0)
  CONSOLECAPTURE.BindReceiver(ADDRESS(@CONSOLEINPUT.Deliver),LONGCARD(ADDRESS(@service)))
  Require(CONSOLECAPTURE.Acquire()<>0)
  LET windows=CONSOLEWINDOWS.Registry()
  LET window=@windows.items(0)
  CONSOLECOOKED.Init(@instance,fifo)
  instance.open=1
  EXEC.Forbid()
  window.instance=BYTE POINTER(@instance)
  window.state=CONSOLETYPES.WIN_CREATING
  Require(CONSOLEFOREGROUND.Register(window)<>0)
  window.state=CONSOLETYPES.WIN_LIVE
  windows.liveCount=1
  captured.route=window.route
  EXEC.Permit()
  Batch(7)
  Require(instance.inputCount=0)
  Drain()
  Require(instance.inputCount=7)
  Require(CONSOLECOOKED.Read(@instance,output,128)=7)
  FOR index=0 TO 6 DO
    Require(output(index)=IF (index & 1)=0 THEN 97 ELSE 98 FI)
  OD
  Batch(63)
  Drain()
  Require(instance.inputLost<>0 AND instance.inputCount=0)
  Require(CONSOLECOOKED.Read(@instance,output,128)=$ffff)
  captured.kind=INPUT.EVENT_LOSS
  captured.code=INPUT.LOSS_RAW
  CONSOLEINPUT.Deliver(LONGCARD(ADDRESS(@service)),@captured)
  Drain()
  Require(CONSOLECOOKED.Read(@instance,output,128)=$ffff)
  captured.route=window.route+$100
  Batch(8)
  Drain()
  Require(instance.inputCount=0)
  captured.route=window.route
  service.stop=1
  Batch(8)
  Drain()
  Require(instance.inputCount=0)
  EXEC.Forbid()
  CONSOLEFOREGROUND.Unregister(window)
  CONSOLEWINDOWS.Retired(window)
  windows.liveCount=0
  EXEC.Permit()
  CONSOLECAPTURE.Release()
  Require(INPUTDRIVER.Stop()<>0)
  Require(EXEC.AvailMem(0)=before)
  finished=1

RETURN
ENDMODULE
