MODULE BITMAPFAULT
USE EXEC
USE CONSOLE
USE CONSOLEDRIVER
USE CONSOLETYPES
USE HEAPCORE
CARD checks,checkpoint,gate
BYTE variant
EXEC.MsgPort POINTER port
EXEC.IOStdReq POINTER owner,read,write
BYTE ARRAY name=[99 111 110 115 111 108 101 46 100 101 118 105 99 101 0]
BYTE ARRAY text(512),input(4)

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($f780+checks)
  FI

  checks==+1

RETURN

PROC Main()
  CARD index,row

  port=EXEC.CreateMsgPort()
  owner=EXEC.IOStdReq POINTER(EXEC.CreateIORequest(port,EXEC.IOSTDREQ_SIZE))
  read=EXEC.IOStdReq POINTER(EXEC.CreateIORequest(port,EXEC.IOSTDREQ_SIZE))
  write=EXEC.IOStdReq POINTER(EXEC.CreateIORequest(port,EXEC.IOSTDREQ_SIZE))
  Require(port<>NULL AND owner<>NULL AND read<>NULL AND write<>NULL)
  Require(EXEC.OpenDevice(name,0,EXEC.IORequest POINTER(owner),0)=0)
  LET instance=CONSOLETYPES.Instance POINTER(owner.io_Unit)
  IF variant>=3 AND variant<=4 THEN
    owner.io_Command=EXEC.CMD_WRITE
    owner.io_Data=text
    FOR row=0 TO 58 DO
      FOR index=0 TO 79 DO
        text(index)=65+BYTE(row MOD 26)
      OD

      owner.io_Length=80
      IF row=58 THEN
        owner.io_Length=79
      FI

      Require(EXEC.DoIO(EXEC.IORequest POINTER(owner))=0)
    OD
  FI

  WHILE instance.dirtyRows<>0 DO
    EXEC.Yield()
  OD

  read.io_Device=owner.io_Device
  read.io_Unit=owner.io_Unit
  read.io_Command=EXEC.CMD_READ
  read.io_Data=input
  read.io_Length=4
  EXEC.SendIO(EXEC.IORequest POINTER(read))
  WHILE instance.readReady<>2 DO
    EXEC.Yield()
  OD

  FOR index=0 TO 511 DO
    text(index)=65+BYTE(index & 15)
  OD

  checkpoint=1
  WHILE gate=0 DO
    EXEC.Yield()
  OD

  write.io_Device=owner.io_Device
  write.io_Unit=owner.io_Unit
  write.io_Command=EXEC.CMD_WRITE
  write.io_Data=text
  write.io_Length=512
  IF variant>=7 THEN
    write.io_Length=1
  FI

  EXEC.SendIO(EXEC.IORequest POINTER(write))
  Require(EXEC.WaitIO(EXEC.IORequest POINTER(read))=EXEC.IOERR_SELFTEST)
  IF variant>=7 THEN
    ; The one-byte write was fully accepted before presentation failed.
    Require(EXEC.WaitIO(EXEC.IORequest POINTER(write))=0)
  ELSE
    Require(EXEC.WaitIO(EXEC.IORequest POINTER(write))=EXEC.IOERR_SELFTEST)
  FI

  Require(read.io_Actual=0)
  IF variant>=3 AND variant<=4 THEN
    Require(write.io_Actual=1 AND instance.cellOrigin=0)
  ELSEIF variant>=7 THEN
    Require(write.io_Actual=1)
  ELSE
    Require(write.io_Actual=64)
  FI
  Require(CONSOLE.ScreenWidth()=0 AND CONSOLEDRIVER.Start()=0)
  Require(CONSOLE.Hide(0)<>0)
  Require(CONSOLEDRIVER.Stop()=0)
  read.io_Device=NULL
  read.io_Unit=NULL
  write.io_Device=NULL
  write.io_Unit=NULL
  EXEC.CloseDevice(EXEC.IORequest POINTER(owner))
  EXEC.DeleteIORequest(EXEC.IORequest POINTER(read))
  EXEC.DeleteIORequest(EXEC.IORequest POINTER(write))
  EXEC.DeleteIORequest(EXEC.IORequest POINTER(owner))
  EXEC.DeleteMsgPort(port)

RETURN

ENDMODULE
