MODULE AESALARM
USE EXEC
USE AESSTATE
USE AESBOOT
USE AESALARMPROBE
USE HEAPCORE

PROC Main()
  BYTE stage
  LONGCARD received

  LET bit=EXEC.AllocSignal(-1)
  IF bit=$ff OR AESBOOT.Port()=NULL THEN
    HEAPCORE.Abort($fcc0)
  FI

  AESALARMPROBE.controller=EXEC.FindTask(NULL)
  AESALARMPROBE.mask=LONGCARD(1) LSH bit
  LET service=AESSTATE.Get()
  FOR stage=1 TO 12 DO
    AESALARMPROBE.stage=stage
    EXEC.Signal(service.owner,service.mask)
    WHILE AESALARMPROBE.done<>stage DO
      received=EXEC.Wait(AESALARMPROBE.mask)
    OD
  OD

  EXEC.FreeSignal(bit)

RETURN
ENDMODULE
