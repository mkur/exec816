MODULE BACKGROUNDDELAY
USE EXEC
USE DOS
USE DOSCLIENT
USE DOSCORE
USE DOSBREAKTYPES
USE DOSDELAY
USE PROCESS
USE PROCESSSTATE
USE CONSOLEDRIVER
USE CONSOLEWINDOWS
USE HEAPCORE
USE BGFAULT

CARD checks
BYTE mode,entered,phase,finished
LONGCARD victim
DOS.FileHandle POINTER ioConsole
DOSBREAKTYPES.Scope POINTER childScope
BYTE ARRAY input(8)

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($ea00+checks)
  FI

  checks==+1

RETURN

LONGINT FUNC Child()

  LET operation=mode
  entered=1
  LET client=DOSCLIENT.Ensure()
  childScope=DOSBREAKTYPES.Scope POINTER(client.foreground)
  Require(childScope<>NULL AND childScope.active<>0)
  IF operation=1 THEN
    Require(DOS.BreakPending()<>0)
    Require(DOSDELAY.Delay(1)=0 AND DOS.IoErr()=DOS.ERROR_BREAK)
    RETURN(10)
  FI

  Require(DOS.BreakPending()=0)
  IF operation=2 THEN
    Require(DOSDELAY.Delay(5000)=0 AND DOS.IoErr()=DOS.ERROR_BREAK)
    RETURN(10)
  FI

  IF operation=4 THEN
    Require(PROCESS.RequestBreak(victim)=0)
    Require(DOS.IoErr()=PROCESS.ERROR_INVALID_PROCESS)
    DOS.SetIoErr(0)
    RETURN(0)
  FI

  IF operation=5 THEN
    Require(DOSDELAY.Delay(1)=0)
    Require(DOS.IoErr()=DOS.ERROR_NO_FREE_STORE OR DOS.IoErr()=EXEC.IOERR_OPENFAIL)
    RETURN(10)
  FI

  Require(DOSDELAY.Delay(1)<>0)
  LET timer=client.timer
  Require(timer<>NULL)
  Require(DOSDELAY.Delay(1)<>0 AND client.timer=timer)
  Require(DOS.BreakPending()=0)

RETURN(7)

PROC Main()
  PROCESS.Result result
  BYTE failure

  Require(SIZEOF(PROCESSSTATE.Entry)=128)
  Require(SIZEOF(DOSCLIENT.ClientContext)=98)
  LET baseline=EXEC.AvailMem(0)
  ioConsole=DOS.Open(BYTE POINTER(c"CON:"),DOS.MODE_READWRITE)
  Require(ioConsole<>NULL AND DOS.BeginForeground(ioConsole)<>0)
  LET ignored=DOS.SelectInput(ioConsole)
  LET host=CONSOLEWINDOWS.Find(0)
  LET route=host.route

  mode=1
  EXEC.Forbid()
  victim=PROCESS.StartBackground(@Child,BYTE POINTER(c"early"),5)
  Require(victim<>0)
  Require(PROCESS.RequestBreak(victim)<>0)
  Require(PROCESS.RequestBreak(victim)<>0)
  EXEC.Permit()
  Require(PROCESS.Wait(victim,@result)<>0)
  Require(result.primary=10 AND result.secondary=DOS.ERROR_BREAK)
  Require(host.route=route AND DOS.BreakPending()=0)
  Require(PROCESS.RequestBreak(victim)=0 AND DOS.IoErr()=PROCESS.ERROR_INVALID_PROCESS)

  FOR failure=1 TO 3 DO
    mode=5
    entered=0
    BGFAULT.failure=failure
    victim=PROCESS.StartBackground(@Child,NULL,0)
    Require(victim<>0 AND PROCESS.Wait(victim,@result)<>0)
    BGFAULT.failure=0
    IF failure=1 THEN
      Require(entered=0 AND result.primary=20 AND result.secondary=DOS.ERROR_NO_FREE_STORE)
    ELSE
      Require(entered=1 AND result.primary=10)
    FI
  OD

  mode=2
  entered=0
  victim=PROCESS.StartBackground(@Child,NULL,0)
  Require(victim<>0)
  WHILE entered=0 DO
    EXEC.Yield()
  OD

  LET timerClient=DOSCLIENT.ClientContext POINTER(childScope.client)
  WHILE timerClient.busy=0 DO
    EXEC.Yield()
  OD

  phase=1
  Require(DOS.Read(ioConsole,input,8)=-1 AND DOS.IoErr()=DOS.ERROR_BREAK)
  Require(childScope.pending=0 AND host.route=route)
  DOS.ClearBreak()
  phase=2
  Require(DOS.Read(ioConsole,input,8)=2 AND input(0)='a AND input(1)=10)
  Require(childScope.pending=0)
  Require(PROCESS.RequestBreak(victim)<>0)
  Require(PROCESS.Wait(victim,@result)<>0)
  Require(result.primary=10 AND result.secondary=DOS.ERROR_BREAK)

  mode=3
  entered=0
  LET old=victim
  victim=PROCESS.StartBackground(@Child,NULL,0)
  Require(victim<>0 AND victim<>old)
  Require(PROCESS.RequestBreak(old)=0 AND DOS.IoErr()=PROCESS.ERROR_INVALID_PROCESS)
  LET childEntry=PROCESSSTATE.Entry POINTER(DOSCORE.Control(
      PROCESSSTATE.OP_FIND,BYTE POINTER(@victim)))
  Require(childEntry<>NULL)
  WHILE childEntry.state<>PROCESSSTATE.STATE_RETIRED DO
    EXEC.Yield()
  OD

  Require(PROCESS.RequestBreak(victim)<>0)
  Require(PROCESS.Wait(victim,@result)<>0 AND result.primary=7 AND result.secondary=0)

  mode=2
  entered=0
  victim=PROCESS.StartBackground(@Child,NULL,0)
  WHILE entered=0 DO
    EXEC.Yield()
  OD

  ; A sibling cannot cancel this parent's child identity.
  mode=4
  LET peer=PROCESS.StartBackground(@Child,NULL,0)
  Require(peer<>0 AND PROCESS.Wait(peer,@result)<>0 AND result.primary=0)
  Require(PROCESS.RequestBreak(victim)<>0)
  Require(PROCESS.Wait(victim,@result)<>0 AND result.secondary=DOS.ERROR_BREAK)

  mode=3
  victim=PROCESS.StartForeground(@Child,NULL,0)
  Require(victim<>0 AND PROCESS.Wait(victim,@result)<>0 AND result.primary=7)
  Require(host.route<>route AND DOS.BreakPending()=0)
  LET previous=DOS.SelectInput(NULL)
  Require(DOS.EndForeground()<>0 AND DOS.Close(ioConsole)<>0)
  Require(DOS.ReleaseContext()<>0 AND EXEC.AvailMem(0)=baseline)
  finished=1

RETURN

ENDMODULE
