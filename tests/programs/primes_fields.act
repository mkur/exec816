MODULE PRIMEFIELDS
USE EXEC
USE HEAPCORE
USE DOS
USE DOSBREAK
USE PROCESS
USE PROGRAMAPI
USE PRIMES
USE CONSOLEWINDOWS
USE CONSOLECORE
USE CONSOLETYPES

CARD checks
BYTE finished

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($ec00+checks)
  FI

  checks==+1

RETURN

PROC Field(CONSOLETYPES.Instance POINTER view CARD row BYTE POINTER expected)
  CARD index

  FOR index=0 TO CARD(expected(0))-1 DO
    Require(view.cells(CONSOLECORE.CellOffset(view,row*view.width+10+index))=expected(index+1))
  OD

RETURN

PROC Main()
  PROCESS.Result outcome
  LONGCARD child

  LET before=EXEC.AvailMem(0)
  LET file=DOS.Open(BYTE POINTER(c"CON:"),DOS.MODE_READWRITE)
  Require(file<>NULL AND DOS.BeginForeground(file)<>0)
  PRIMES.pane=PROGRAMAPI.OpenPane(6)
  Require(PRIMES.pane<>NULL)
  PRIMES.dimensions(0)=40
  LET windows=CONSOLEWINDOWS.Registry()
  LET parentWindow=CONSOLEWINDOWS.Find(0)
  LET parent=CONSOLETYPES.Instance POINTER(parentWindow.instance)
  LET window=CONSOLEWINDOWS.Find(windows.pane)
  LET view=CONSOLETYPES.Instance POINTER(window.instance)
  Require(view<>NULL)
  PRIMES.count=1229
  PRIMES.latest=9973
  PRIMES.pass=$ffffffff
  PRIMES.savedCount=$ffff
  PRIMES.savedLatest=$ffff
  PRIMES.savedPass=0
  Require(PRIMES.Labels()<>0 AND PRIMES.Paint()<>0)
  Require(PROGRAMAPI.numericCalls=3 AND PROGRAMAPI.numericBytes=20)
  Field(view,2," 1229")
  Field(view,3," 9973")
  Field(view,4,"4294967295")
  Require(PRIMES.Paint()<>0 AND PROGRAMAPI.numericCalls=3)
  PRIMES.count=9
  PRIMES.latest=11
  PRIMES.pass=1
  Require(PRIMES.Paint()<>0 AND PROGRAMAPI.numericCalls=6)
  Field(view,2,"    9")
  Field(view,3,"   11")
  Field(view,4,"         1")
  PRIMES.count=10
  Require(PRIMES.Paint()<>0 AND PROGRAMAPI.numericCalls=7)
  Field(view,2,"   10")
  LET scope=DOSBREAK.Current()
  scope.pending=1
  PRIMES.count=999
  PRIMES.latest=997
  Require(PRIMES.Paint()=0 AND DOS.IoErr()=DOS.ERROR_BREAK)
  Require(PRIMES.savedCount=10 AND PRIMES.savedLatest=11)
  Field(view,2,"   10")
  Field(view,3,"   11")
  DOS.ClearBreak()
  Require(PROGRAMAPI.Close(PRIMES.pane)<>0)
  PRIMES.pane=NULL
  child=PROCESS.StartForeground(@PRIMES.Main,BYTE POINTER(c"PASSES 1"),8)
  Require(child<>0 AND PROCESS.Wait(child,@outcome)<>0)
  Require(outcome.primary=0 AND outcome.secondary=0)
  Require(PRIMES.count=1229 AND PRIMES.latest=9973 AND PRIMES.pass=1)
  Require(parent.height=24)
  PRIMES.candidate=0
  child=PROCESS.StartBackground(@PRIMES.Main,NULL,0)
  Require(child<>0)
  WHILE PRIMES.pane=NULL OR PRIMES.candidate<1000 DO
    EXEC.Yield()
  OD

  Require(PROCESS.RequestBreak(child)<>0 AND PROCESS.Wait(child,@outcome)<>0)
  Require(outcome.primary=10 AND outcome.secondary=DOS.ERROR_BREAK)
  Require(PRIMES.pane=NULL AND parent.height=24)
  Require(DOS.EndForeground()<>0 AND DOS.Close(file)<>0)
  Require(DOS.ReleaseContext()<>0 AND EXEC.AvailMem(0)=before)
  finished=1

RETURN

ENDMODULE
