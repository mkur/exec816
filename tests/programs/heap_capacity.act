; Functional allocation at the eight-task baseline; no serial timing claim.
MODULE HEAPCAPACITY
USE EXEC
USE EXECLISTS
USE EXECTASKS
USE TASKSTACKS
USE HEAPCORE
EXEC.Task ARRAY workers(7)
BYTE ARRAY progress(8)
VOLATILE BYTE go
CARD checks
LONGCARD before,after
PROC POINTER absent()

; Stop at the first failed fixture invariant and retain its check index for
; diagnosis.
PROC Require(BYTE condition)

  IF condition=0 THEN
    HEAPCORE.Abort($ff74)
  FI

RETURN

PROC Work(BYTE slot)
  BYTE POINTER p,q
  CARD iteration

  WHILE go=0 DO
    EXEC.Yield()
  OD

  FOR iteration=0 TO 2 DO
    p=EXEC.AllocMem(257,EXEC.MEMF_CLEAR)
    q=EXEC.AllocVec(513,EXEC.MEMF_CLEAR)
    Require(p<>BYTE POINTER(0) AND q<>BYTE POINTER(0))
    Require(p^=0 AND p(256)=0 AND q^=0 AND q(512)=0)
    p^=slot
    p(256)=slot
    q^=slot
    q(512)=slot
    EXEC.Yield()
    Require(p^=slot AND p(256)=slot AND q^=slot AND q(512)=slot)
    EXEC.FreeMem(p,257)
    EXEC.FreeVec(q)
  OD

  progress(slot)=1

RETURN

PROC Worker()
  EXEC.Task POINTER self

  self=EXEC.FindTask(BYTE POINTER(0))
  Work(self.tc_Node.ln_Pri)

RETURN

; Check functional allocation with all configured Task slots in use.
PROC Main()
  CARD index,ignored
  EXEC.Task POINTER item

  before=EXEC.AvailMem(0)
  FOR index=0 TO 6 DO
    item=@workers(index)
    item.tc_Node.ln_Type=EXEC.NT_TASK
    item.tc_Node.ln_Pri=BYTE(index+1)
    item.tc_SPLower=ADDRESS(TASKSTACKS.StackLower(BYTE(index+1)))
    item.tc_SPUpper=ADDRESS(TASKSTACKS.StackUpper(BYTE(index+1)))
    item.tc_SPReg=item.tc_SPUpper-SIZE(2)
    EXECLISTS.NewList(@item.tc_MemEntry)
    Require(EXEC.AddTask(item,@Worker,absent)=item)
  OD

  go=1
  Work(0)
  FOR index=0 TO 6 DO
    WHILE workers(index).tc_State<>EXEC.TS_REMOVED DO
      ignored=EXECTASKS.Sleep(1)
    OD
  OD

  FOR index=0 TO 7 DO
    Require(progress(index)=1)
  OD

  after=EXEC.AvailMem(0)
  Require(before=after)
  checks=1

RETURN

ENDMODULE
