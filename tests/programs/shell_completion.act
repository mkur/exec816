MODULE SHELLCOMPLETIONTEST
USE HEAPCORE
INCLUDE "../../examples/shell/shell-session.inc"

CARD checks
BYTE finished

PROC Check(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($e900+(checks & 255))
  FI

  checks==+1

RETURN

; Keep expected text independent of the production completion accumulator.
PROC Same(CSTRING expected)

  Check(STR.strcmp(CSTRING(ShellLine()),expected)=0)

RETURN

PROC Prepare(CSTRING text CARD cursor)

  LET state=ShellEdit()
  STR.strlcpy(ShellLine(),text,LINE_CAPACITY)
  state.edit.buffer=ShellLine()
  state.edit.capacity=LINE_CAPACITY
  state.edit.length=CARD(STR.strlen(text))
  state.edit.cursor=cursor
  state.edit.replace=0
  state.matches=0

RETURN

PROC Complete(CSTRING text,expected CARD cursor)

  Prepare(text,cursor)
  IF ShellCompletionToken()=1 THEN
    ShellCompletionNames()
    ShellCompletionApply()
  FI
  Same(expected)

RETURN

PROC Contexts()

  LET state=ShellEdit()
  Prepare(c"  ECHO abc",10)
  Check(ShellCompletionToken()=2)
  Prepare(c"TYPE SYS:WO",11)
  Check(ShellCompletionToken()=2)
  Check(state.first=5 AND state.component=9)
  Prepare(c"TYPE SYS:",9)
  Check(ShellCompletionToken()=0)
  Prepare(c"RUN PR",6)
  Check(ShellCompletionToken()=0)
  Prepare(c"RUN TYPE REA",12)
  Check(ShellCompletionToken()=2)
  Prepare(c"CAT X | HE",10)
  Check(ShellCompletionToken()=0)
  Prepare(c"CAT X | CAT RE",14)
  Check(ShellCompletionToken()=2)
  Prepare(c"ECHO x >>REA",12)
  Check(ShellCompletionToken()=2)
  Prepare(c"ECHO x <REA",11)
  Check(ShellCompletionToken()=2)
  Prepare(c"ECHO \"quoted text\" REA",22)
  Check(ShellCompletionToken()=2)
  Prepare(c"TYPE \"REA",9)
  Check(ShellCompletionToken()=0)
  Prepare(c"TYPE RE*",8)
  Check(ShellCompletionToken()=0)
  Prepare(c"TYPE RE?",8)
  Check(ShellCompletionToken()=0)
  Prepare(c"HELP",2)
  Check(ShellCompletionToken()=0)
  Prepare(c"  ",2)
  Check(ShellCompletionToken()=0)

RETURN

PROC Accumulator()
  CARD index

  LET state=ShellEdit()
  LET line=ShellLine()
  Prepare(c"TYPE RE",7)
  Check(ShellCompletionToken()=2)
  ShellCompletionMatch(BYTE POINTER(c"README.TXT"),0)
  ShellCompletionMatch(BYTE POINTER(c"readme.txt"),0)
  Check(state.matches=1)
  ShellCompletionMatch(BYTE POINTER(c"READER.TXT"),0)
  Check(state.matches=2 AND state.common=4)
  ShellCompletionApply()
  Same(c"TYPE READ")
  Check(state.edit.cursor=9 AND state.edit.replace=1)

  Prepare(c"TYPE RE more",7)
  Check(ShellCompletionToken()=2)
  ShellCompletionMatch(BYTE POINTER(c"README.TXT"),0)
  ShellCompletionApply()
  Same(c"TYPE README.TXT more")
  Prepare(c"TYPE SYS:WO",11)
  Check(ShellCompletionToken()=2)
  ShellCompletionMatch(BYTE POINTER(c"WORK"),1)
  ShellCompletionApply()
  Same(c"TYPE SYS:WORK/")
  Prepare(c"TYPE WORK",9)
  Check(ShellCompletionToken()=2)
  ShellCompletionMatch(BYTE POINTER(c"WORK"),0)
  ShellCompletionMatch(BYTE POINTER(c"WORKING"),0)
  ShellCompletionApply()
  Same(c"TYPE WORK")
  Check(state.edit.replace=0)

  Prepare(c"",0)
  FOR index=0 TO 252 DO
    line(index)=ASCII.SPACE
  OD

  line(253)='H
  line(254)='E
  line(255)=ASCII.NUL
  state.edit.length=255
  state.edit.cursor=255
  Check(ShellCompletionToken()=1)
  ShellCompletionNames()
  ShellCompletionApply()
  Check(state.edit.length=255 AND state.edit.replace=0)
  Check(line(253)='H AND line(254)='E)

  ; Required suffixes fit exactly; the optional separating space is omitted.
  line(251)='H
  line(252)='E
  line(253)=ASCII.NUL
  state.edit.length=253
  state.edit.cursor=253
  state.matches=0
  Check(ShellCompletionToken()=1)
  ShellCompletionNames()
  ShellCompletionApply()
  Check(state.edit.length=255 AND state.edit.cursor=255
      AND state.edit.replace=1 AND line(255)=ASCII.NUL)
  Check(line(251)='H AND line(252)='E AND line(253)='L AND line(254)='P)

  STR.strlcpy(line+SIZE(250),c"HELP",6)
  state.edit.length=254
  state.edit.cursor=254
  state.edit.replace=0
  state.matches=0
  Check(ShellCompletionToken()=1)
  ShellCompletionNames()
  ShellCompletionApply()
  Check(state.edit.length=255 AND line(254)=ASCII.SPACE
      AND line(255)=ASCII.NUL)

RETURN

PROC Main()

  LET before=EXEC.AvailMem(0)
  shell=ShellState POINTER(EXEC.AllocMem(SHELL_BYTES,
      EXEC.MEMF_UPPER OR EXEC.MEMF_CLEAR))
  Check(shell<>NULL AND SIZEOF(ShellState)=HEADER_SIZE)
  Check(SIZEOF(ShellEditState)=EDIT_BYTES)
  Check(ShellAliasDefaults()<>0)
  Complete(c"HE",c"HELP ",2)
  Complete(c"he",c"heLP ",2)
  Complete(c"E",c"E",1)
  Complete(c"HEL more",c"HELP more",3)
  Complete(c"HE|WC",c"HELP|WC",2)
  Complete(c"MK",c"MKDIR ",2)
  Complete(c"CP",c"CP ",2)
  Complete(c"UNKNOWN",c"UNKNOWN",7)
  Contexts()
  Accumulator()
  EXEC.FreeMem(BYTE POINTER(aliases),ALIAS_CAPACITY*SIZEOF(ShellAlias))
  EXEC.FreeMem(BYTE POINTER(shell),SHELL_BYTES)
  Check(EXEC.AvailMem(0)=before)
  finished=1

RETURN

ENDMODULE
