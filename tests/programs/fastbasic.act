MODULE FASTBASICTEST
USE EXEC
USE DOS
USE PROCESS
USE PROGRAM
USE PROGRAMFILE
USE PROGRAMIMAGE
USE FBSTATE
USE SDXSTATE
USE HEAPCORE
USE FSBOOT

CARD checks,currentCase,actualBytes,parseBytes,freshBytes,stateBytes
LONGINT reason,primary,secondary
LONGCARD guestBank
BYTE ARRAY actual(1024)
BYTE ARRAY parseOutput(256),fresh(4096)

PROC Require(BYTE okay)

  IF okay=0 THEN
    reason=DOS.IoErr()
    HEAPCORE.Abort($fb00+checks)
  FI
  checks==+1

RETURN

PROC Put(BYTE POINTER path,bytes CARD count)

  LET file=DOS.Open(path,DOS.MODE_NEWFILE)
  Require(file<>NULL)
  Require(DOS.Write(file,bytes,LONGINT(count))=LONGINT(count))
  Require(DOS.Close(file)<>0)

RETURN

PROC Run(BYTE POINTER name,args CARD argumentBytes LONGINT expectedPrimary)
  PROCESS.Result result

  LET image=PROGRAMFILE.Load(name)
  Require(image<>NULL)
  LET state=FBSTATE.Session POINTER(image.extension)
  guestBank=LONGCARD(ADDRESS(state.guest.bank))
  LET identity=PROCESS.StartLoaded(BYTE POINTER(image),args,argumentBytes,0)
  Require(identity<>0)
  Require(PROCESS.Wait(identity,@result)<>0)
  primary=result.primary
  secondary=result.secondary
  Require(primary=expectedPrimary)
  IF expectedPrimary=0 THEN
    Require(secondary=0)
  FI
  SDXSTATE.Guards()
  PROGRAM.Unload(image)

RETURN

PROC Main()

  Require(DOS.ReleaseContext()<>0)
  Require(FSBOOT.Stop()<>0)
  LET baseline=EXEC.AvailMem(0)
  stateBytes=SIZEOF(FBSTATE.Session)
SETUP_FILES
  LET output=DOS.Open(BYTE POINTER(c"RAM:OUT.TXT"),DOS.MODE_NEWFILE)
  Require(output<>NULL)
  LET previous=DOS.SelectOutput(output)
RUN_PROGRAMS
EXTRA_CHECKS
  DOS.SelectOutput(previous)
  Require(DOS.Close(output)<>0)
  LET file=DOS.Open(BYTE POINTER(c"RAM:OUT.TXT"),DOS.MODE_OLDFILE)
  Require(file<>NULL)
  actualBytes=CARD(DOS.Read(file,@actual,1024))
  Require(DOS.Close(file)<>0)
  Require(DOS.ReleaseContext()<>0)
  Require(FSBOOT.Stop()<>0)
  Require(EXEC.AvailMem(0)=baseline)

RETURN

ENDMODULE
