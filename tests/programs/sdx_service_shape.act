MODULE SDXSERVICESHAPE
USE EXEC
USE DOS
USE HEAPCORE
USE SDXSTATE
USE SDXABI
USE SDXTRAPS
USE SDXRUNTIME
USE SDXCONFIG

CARD checks,sessionBytes

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($fc00+checks)
  FI
  checks==+1

RETURN

PROC Main()
  SDXSTATE.Session POINTER state
  BYTE POINTER bytes,frame
  LONGCARD baseline
  CARD index

  baseline=EXEC.AvailMem(0)
  ; Every byte remains covered by the word-at-a-time native boundary check.
  Require(SDXRUNTIME.Guards()=1)
  FOR index=0 TO SDXABI.DP_GUARD_BYTES-1 DO
    bytes=BYTE POINTER(ADDRESS(SDXCONFIG.DP_BASE-SDXABI.DP_GUARD_BYTES))
    bytes(index)=$a4
    Require(SDXRUNTIME.Guards()=0)
    bytes(index)=$a5
    bytes=BYTE POINTER(ADDRESS(SDXCONFIG.DP_BASE+SDXABI.IMAGE_SLOTS*256))
    bytes(index)=$a4
    Require(SDXRUNTIME.Guards()=0)
    bytes(index)=$a5
    Require(SDXRUNTIME.Guards()=1)
  OD
  sessionBytes=SIZEOF(SDXSTATE.Session)
  Require(sessionBytes=2324)
  state=SDXSTATE.Session POINTER(EXEC.AllocMem(sessionBytes,EXEC.MEMF_CLEAR))
  Require(state<>NULL)
  state.context=BYTE POINTER(ADDRESS(SDXABI.CONTEXT_BASE))
  Require(SDXRUNTIME.Acquire(0)=1)
  Require(SDXRUNTIME.Acquire(1)=0)
  Require(SDXRUNTIME.Bind(1)=0)
  Require(SDXRUNTIME.Bind(0)=1)
  bytes=BYTE POINTER(ADDRESS(SDXABI.BINDING_BASE))
  Require(SDXSTATE.ReadWord(bytes,SDXABI.BINDING_OWNER)=1)
  SDXRUNTIME.Unbind(1)
  Require(SDXSTATE.ReadWord(bytes,SDXABI.BINDING_OWNER)=1)
  SDXRUNTIME.Unbind(0)
  Require(SDXSTATE.ReadWord(bytes,SDXABI.BINDING_OWNER)=0)
  Require(SDXRUNTIME.Bind(0)=1)
  SDXSTATE.Enter(state)
  bytes=BYTE POINTER(state)
  state.handles(0)=DOS.FileHandle POINTER(ADDRESS($123456))
  state.handles(1)=DOS.FileHandle POINTER(ADDRESS($789abc))
  Require(bytes(13)=$56 AND bytes(14)=$34 AND bytes(15)=$12)
  Require(bytes(16)=$bc AND bytes(17)=$9a AND bytes(18)=$78)
  SDXRUNTIME.MoveFrame(0,$1d0)
  frame=SDXSTATE.GetFrame(state)
  Require(frame=BYTE POINTER(ADDRESS($1d0)))
  frame(SDXABI.FRAME_A)=$46
  frame(SDXABI.FRAME_X)=$30
  Require(SDXTRAPS.Install(state,frame)=0)
  Require(state.trapCount=1 AND state.traps(0).handler=$3046
      AND state.traps(0).stack=$1dd)
  Require(bytes(26)=$46 AND bytes(27)=$30 AND bytes(28)=$dd AND bytes(29)=1)
  ; Deliver from a deeper guest stack and verify the complete suspended frame.
  SDXRUNTIME.MoveFrame(0,$1b0)
  frame=SDXSTATE.GetFrame(state)
  FOR index=1 TO 13 DO
    frame(index)=BYTE($20+index)
  OD
  frame(SDXABI.FRAME_A+1)=$ab
  Require(SDXTRAPS.Deliver(state,170)<>0)
  Require(SDXSTATE.ReadWord(state.context,SDXABI.FIELDS_GUEST_S)=$1d0)
  frame=SDXSTATE.GetFrame(state)
  Require(frame(SDXABI.FRAME_A)=170 AND frame(SDXABI.FRAME_A+1)=$ab)
  Require(frame(SDXABI.FRAME_P)=$ab
      AND SDXSTATE.ReadWord(frame,SDXABI.FRAME_PC)=$3046)
  FOR index=1 TO 7 DO
    Require(frame(index)=$20+index)
  OD
  Require(frame(SDXABI.FRAME_VENEER_P)=$2a AND state.trapCount=0)
  Require(SDXTRAPS.Remove(state)=156 AND SDXTRAPS.Deliver(state,170)=0)
  frame(SDXABI.FRAME_A)=$46
  frame(SDXABI.FRAME_X)=$30
  FOR index=0 TO SDXABI.TRAP_LIMIT-1 DO
    Require(SDXTRAPS.Install(state,frame)=0)
  OD
  Require(SDXTRAPS.Install(state,frame)=156 AND state.trapCount=10)
  FOR index=0 TO SDXABI.TRAP_LIMIT-1 DO
    Require(SDXTRAPS.Remove(state)=0)
  OD
  Require(state.trapCount=0 AND state.handles(0)=DOS.FileHandle POINTER(ADDRESS($123456))
      AND state.handles(1)=DOS.FileHandle POINTER(ADDRESS($789abc)))
  SDXRUNTIME.Release()
  bytes=BYTE POINTER(ADDRESS(SDXABI.BINDING_BASE))
  Require(SDXSTATE.ReadWord(bytes,SDXABI.BINDING_OWNER)=0)
  EXEC.FreeMem(BYTE POINTER(state),sessionBytes)
  Require(EXEC.AvailMem(0)=baseline)
  SDXSTATE.Guards()

RETURN

ENDMODULE
