MODULE DOSFILETEST
USE EXEC
USE DOS
USE HEAPCORE
USE FSBOOT
CARD checks,otherChecks,computations,ioProgress
BYTE concurrent
LONGINT expected
LONGINT got,lastError
DOS.FileHandle POINTER file
LONGCARD before

; Stop at the first failed fixture invariant and retain its check index for
; diagnosis.
PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($f500+(checks & 255))
  FI

  checks==+1

RETURN

PROC ReadFailure(BYTE unused)

  got=DOS.Read(file,BYTE POINTER($cfff0),777)
  lastError=DOS.IoErr()
  Require(got=-1 AND lastError=expected)

RETURN

; Exercise file-read error propagation.
PROC Main()

  expected=4
  before=EXEC.AvailMem(0)
  file=DOS.Open(BYTE POINTER($d1000),DOS.MODE_OLDFILE)
  Require(file<>DOS.FileHandle POINTER(0))
  ReadFailure(0)
  Require(DOS.Seek(file,0,DOS.OFFSET_CURRENT)=0)
  ReadFailure(0)
  Require(DOS.Close(file)<>0 AND DOS.IoErr()=expected)
  Require(FSBOOT.Stop()<>0)
  Require(DOS.ReleaseContext()<>0)
  Require(EXEC.AvailMem(0)=before)

RETURN

ENDMODULE
