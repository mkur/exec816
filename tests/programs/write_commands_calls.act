MODULE DOSCALLS

USE WRITECOMMANDSTATE AS T
INCLUDE "../../lib/dos/dos-types.inc"

PUBLIC LONGINT FUNC AssignPath(BYTE POINTER name,target)

RETURN(0)

PUBLIC LONGINT FUNC GetAssign(CARD index AssignInfo POINTER info)

RETURN(0)

PUBLIC BYTE POINTER FUNC Selected(BYTE output)

RETURN(BYTE POINTER(IF output<>0 THEN ADDRESS(3) ELSE ADDRESS(1) FI))

; Read admission precedes destructive output admission; a live source blocks
; the simulated same-object output just as the real filesystem lease does.
PUBLIC BYTE POINTER FUNC Open(BYTE POINTER name LONGINT mode)
  CARD index

  T.state.error=0
  IF name(0)='M THEN
    T.state.error=205
    RETURN(NULL)
  FI

  IF mode=1005 THEN
    IF T.scenario.enumerate<>0 THEN
      T.state.position=0
      IF T.state.lockLive<>0 THEN
        T.state.badOwner=1
      FI
    FI

    T.state.inputLive=1
    T.state.opens==+1
    RETURN(BYTE POINTER(1))
  FI

  index=0
  WHILE name(index)<>0 AND index<255 DO
    T.state.target(index)=name(index)
    index==+1
  OD

  T.state.targetUsed=LONGCARD(index)

  IF T.scenario.destinationKind=2 AND T.state.lockCalls=0 THEN
    T.state.error=ERROR_OBJECT_WRONG_TYPE
    RETURN(NULL)
  FI

  IF T.scenario.openError<>0 OR T.scenario.same<>0 THEN
    T.state.error=IF T.scenario.same<>0 THEN LONGINT(202) ELSE T.scenario.openError FI
    RETURN(NULL)
  FI

  T.state.opens==+1
  T.state.fileLive=1
  T.state.mode=LONGCARD(mode)
  T.state.fileCursor=0
  IF T.scenario.enumerate<>0 AND mode=1004 THEN
    T.state.fileLength=3
    T.state.fileHash=124543
    T.state.file(0)='o
    T.state.file(1)='l
    T.state.file(2)='d
  FI

  IF mode=1006 THEN
    T.state.fileLength=0
    T.state.fileHash=0
  FI

RETURN(BYTE POINTER(2))

; Failed Close still consumes the wrapper. Count accidental borrowed/double
; closes independently from the returned error so cleanup cannot hide them.
PUBLIC LONGINT FUNC Close(BYTE POINTER handle)
  LONGCARD owned

  owned=0
  IF handle=BYTE POINTER(1) THEN
    owned=T.state.inputLive
    T.state.inputLive=0
  ELSEIF handle=BYTE POINTER(2) THEN
    owned=T.state.fileLive
    T.state.fileLive=0
  ELSEIF handle=BYTE POINTER(4) THEN
    owned=T.state.consoleLive
    T.state.consoleLive=0
  FI

  IF owned=0 THEN
    T.state.badOwner=1
  FI

  T.state.closes==+1
  T.state.error=T.scenario.closeError

RETURN(IF T.state.error=0 THEN LONGINT(-1) ELSE LONGINT(0) FI)

PUBLIC LONGINT FUNC Seek(BYTE POINTER handle LONGINT offset,mode)

  T.state.seeks==+1
  T.state.error=T.scenario.seekError
  IF handle<>BYTE POINTER(2) OR offset<>0 OR mode<>1 THEN
    T.state.badOwner=1
  FI

  IF T.state.error<>0 THEN
    RETURN(-1)
  FI

  T.state.fileCursor=T.state.fileLength

RETURN(0)

; Supply independent short chunks and errors attached to a committed prefix.
PUBLIC LONGINT FUNC Read(BYTE POINTER handle,buffer LONGINT requested)
  CARD index,count

  T.state.reads==+1
  T.state.error=0
  IF handle<>BYTE POINTER(1) THEN
    T.state.badOwner=1
  FI

  IF T.state.reads=LONGCARD(T.scenario.readFail) THEN
    T.state.error=226
    RETURN(-1)
  FI

  IF T.scenario.oversizedRead<>0 THEN
    RETURN(requested+1)
  FI

  count=CARD(T.scenario.readChunk)
  IF LONGINT(count)>requested THEN
    count=CARD(requested)
  FI

  IF LONGCARD(count)>T.scenario.length-T.state.position THEN
    count=CARD(T.scenario.length-T.state.position)
  FI

  IF count<>0 THEN
    FOR index=0 TO count-1 DO
      buffer(index)=T.scenario.data(CARD((T.state.position+LONGCARD(index))
          MOD LONGCARD(T.scenario.patternBytes)))
    OD

    T.state.error=T.scenario.prefixError
  FI

  T.state.position==+LONGCARD(count)

RETURN(LONGINT(count))

; Capture prefixes and full-length rolling hashes independently for the file
; and Output. This tests transfers past 64 KiB without a whole-file buffer.
PUBLIC LONGINT FUNC Write(BYTE POINTER handle,buffer LONGINT requested)
  CARD count,index
  LONGCARD ordinal
  BYTE value

  T.state.error=0
  count=CARD(T.scenario.writeChunk)
  IF LONGINT(count)>requested THEN
    count=CARD(requested)
  FI

  IF handle=BYTE POINTER(2) THEN
    T.state.fileWrites==+1
    ordinal=T.state.fileWrites
  ELSE
    T.state.outputWrites==+1
    ordinal=T.state.outputWrites
  FI

  IF ADDRESS(buffer)<ADDRESS($10000) THEN
    T.state.badOwner=1
  FI

  IF LONGINT(ADDRESS(handle))=T.scenario.failTarget AND ordinal=LONGCARD(T.scenario.failAt) THEN
    T.state.error=T.scenario.writeError
    RETURN(-1)
  FI

  IF LONGINT(ADDRESS(handle))=T.scenario.zeroTarget THEN
    RETURN(0)
  FI

  IF count<>0 THEN
    FOR index=0 TO count-1 DO
      value=buffer(index)
      IF handle=BYTE POINTER(2) THEN
        IF T.state.fileCursor<1024 THEN
          T.state.file(CARD(T.state.fileCursor))=value
        FI

        T.state.fileCursor==+1
        T.state.fileLength=T.state.fileCursor
        T.state.fileHash=T.state.fileHash*33+LONGCARD(value)
      ELSEIF handle=BYTE POINTER(3) THEN
        IF T.state.outputLength<1024 THEN
          T.state.output(CARD(T.state.outputLength))=value
        FI

        T.state.outputLength==+1
        T.state.outputHash=T.state.outputHash*33+LONGCARD(value)
      ELSEIF handle=BYTE POINTER(4) THEN
        T.state.console(CARD(T.state.consoleUsed))=value
        T.state.consoleUsed==+1
      ELSE
        T.state.badOwner=1
      FI
    OD
  FI

  IF LONGINT(ADDRESS(handle))=T.scenario.failTarget THEN
    T.state.error=T.scenario.writePrefixError
  FI

RETURN(LONGINT(count))

PUBLIC BYTE POINTER FUNC OpenConsole()

  IF T.scenario.interactive=0 THEN
    T.state.error=212
    RETURN(NULL)
  FI

  T.state.opens==+1
  T.state.consoleLive=1
  T.state.error=0

RETURN(BYTE POINTER(4))

PUBLIC LONGINT FUNC DeleteFile(BYTE POINTER name)

  IF T.state.lockLive<>0 THEN
    T.state.badOwner=1
  FI

  T.state.operation==+1
  T.state.position==+1
  T.state.mode=T.state.mode*33+LONGCARD(name(0))
  T.state.error=0
  IF name(0)='M THEN
    T.state.error=205
  ELSEIF T.scenario.mutationError<>0 THEN
    IF T.scenario.failAt=0 OR T.state.operation=T.scenario.failAt THEN
      T.state.error=T.scenario.mutationError
    FI
  FI

RETURN(IF T.state.error=0 THEN LONGINT(-1) ELSE LONGINT(0) FI)

PUBLIC LONGINT FUNC Rename(BYTE POINTER oldName,newName)

  T.state.operation=2
  T.state.error=T.scenario.mutationError

RETURN(IF T.state.error=0 THEN LONGINT(-1) ELSE LONGINT(0) FI)

PUBLIC BYTE POINTER FUNC CreateDir(BYTE POINTER name)

  T.state.operation=3
  T.state.error=T.scenario.mutationError
  IF T.state.error<>0 THEN
    RETURN(NULL)
  FI

  T.state.opens==+1
  T.state.lockLive=1

RETURN(BYTE POINTER(5))

PUBLIC PROC UnLock(BYTE POINTER lock)

  IF lock<>BYTE POINTER(5) OR T.state.lockLive=0 THEN
    T.state.badOwner=1
  FI

  T.state.lockLive=0
  T.state.enumLock=0
  T.state.closes==+1
  T.state.error=T.scenario.unlockError

RETURN

; Exact COPY inspects targets with a live source; pattern enumeration and its
; target inspection happen before sources open and before any mutation.
PUBLIC BYTE POINTER FUNC Lock(BYTE POINTER name LONGINT mode)

  T.state.lockCalls==+1
  IF mode<>SHARED_LOCK OR (T.state.inputLive=0 AND T.scenario.enumerate=0) THEN
    T.state.badOwner=1
  FI

  T.state.error=T.scenario.lockError
  IF T.state.error<>0 THEN
    RETURN(NULL)
  FI

  T.state.enumLock=LONGCARD(T.scenario.enumerate<>0 AND (name(0)='S OR name(0)=0))
  IF T.state.enumLock<>0 THEN
    IF T.state.operation<>0 OR T.state.fileWrites<>0 THEN
      T.state.badOwner=1
    FI
  ELSEIF T.scenario.destinationKind=0 THEN
    T.state.error=ERROR_OBJECT_NOT_FOUND
    RETURN(NULL)
  ELSEIF T.scenario.destinationKind=3 THEN
    T.state.error=ERROR_OBJECT_WRONG_TYPE
    RETURN(NULL)
  FI

  T.state.lockLive=1
  T.state.opens==+1

RETURN(BYTE POINTER(5))

PUBLIC LONGINT FUNC Information(BYTE POINTER lock,buffer LONGINT action)
  CARD index

  IF lock<>BYTE POINTER(5) OR T.state.lockLive=0 THEN
    T.state.badOwner=1
  FI

  LET info=FileInfoBlock POINTER(buffer)
  IF action=24 THEN
    T.state.enumCalls==+1
    T.state.error=0
    IF T.state.enumLock=0 THEN
      T.state.badOwner=1
    FI

    IF T.state.enumCalls=T.scenario.enumErrorAt THEN
      T.state.error=226
      RETURN(0)
    FI

    IF T.state.enumCursor=T.scenario.enumCount THEN
      T.state.error=ERROR_NO_MORE_ENTRIES
      RETURN(0)
    FI

    index=CARD(T.state.enumCursor)
    info.fib_FileName(0)='A
    info.fib_FileName(1)='0+BYTE(index)
    info.fib_FileName(2)='.
    info.fib_FileName(3)='T
    info.fib_FileName(4)='X
    info.fib_FileName(5)='T
    info.fib_FileName(6)=0
    info.fib_DirEntryType=IF (T.scenario.enumDirMask & (1 LSH index))<>0 THEN
        LONGINT(ST_USERDIR) ELSE LONGINT(ST_FILE) FI
    T.state.enumCursor==+1
    RETURN(DOSTRUE)
  FI

  T.state.examines==+1
  IF action<>23 THEN
    T.state.badOwner=1
  FI

  T.state.enumCursor=0
  T.state.error=T.scenario.examineError
  IF T.state.error<>0 THEN
    RETURN(0)
  FI

  info.fib_DirEntryType=IF T.state.enumLock<>0 OR T.scenario.destinationKind=2 THEN
      LONGINT(ST_USERDIR) ELSE LONGINT(ST_FILE) FI

RETURN(DOSTRUE)

; These imports are present in PROGRAMAPI but outside this command batch.
; Treat any accidental call as an observer failure, not a successful stub.
PUBLIC LONGINT FUNC Unsupported()

  T.state.badOwner=1
  T.state.error=209

RETURN(0)

PUBLIC LONGINT FUNC Flush(BYTE POINTER handle)

RETURN(Unsupported())

PUBLIC LONGINT FUNC IsInteractive(BYTE POINTER handle)

RETURN(Unsupported())

PUBLIC LONGINT FUNC ConsoleInfo(BYTE POINTER handle,buffer)

RETURN(Unsupported())

ENDMODULE
