MODULE MOUNTSHELL
USE HEAPCORE
USE FSBOOT
INCLUDE "../../examples/shell/shell-session.inc"

ShellContext context

CARD checks
BYTE finished
BYTE ARRAY scriptText(51)=[77 79 85 78 84 32 83 67 82 73 80 84 58 32 68 82 73 86 69 32 50 32 70 79 82 77 65 84 32 77 89 68 79 83 10 85 78 77 79 85 78 84 32 83 67 82 73 80 84 58 10]
BYTE ARRAY bytes(256)

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($fb00+checks)
  FI

  checks==+1

RETURN

PROC RunLine(CSTRING text LONGINT status,error)

  STR.strlcpy(ShellLine(@context),text,LINE_CAPACITY)
  ShellCommand(@context)
  Require(context.shell.lastStatus=status AND context.shell.lastError=error)
  Require(DOS.Input()=context.shell.console AND DOS.Output()=context.shell.console)

RETURN

PROC Main()

  LET baseline=EXEC.AvailMem(0)
  Require(ShellStart(@context,BYTE POINTER(c"RAM:"))<>0)
  RunLine(c"MOUNT D2: FORMAT MYDOS >RAM:MOUNT.TXT",0,0)
  LET file=DOS.Open(BYTE POINTER(c"RAM:MOUNT.TXT"),DOS.MODE_OLDFILE)
  Require(file<>NULL AND DOS.Read(file,bytes,256)>0)
  Require(bytes(0)='D AND bytes(1)='2 AND bytes(2)=':)
  Require(DOS.Close(file)<>0)
  RunLine(c"CD D2:",0,0)
  RunLine(c"UNMOUNT D2:",10,DOS.ERROR_OBJECT_IN_USE)
  RunLine(c"CD RAM:",0,0)
  RunLine(c"UNMOUNT D2:",0,0)
  RunLine(c"MOUNT D2:",10,DOS.ERROR_DEVICE_NOT_MOUNTED)
  RunLine(c"MOUNT D2: FORMAT MYDOS SECTORS 720",10,DOS.ERROR_BAD_ARGUMENTS)
  RunLine(c"MOUNT D2: FORMAT MYDOS PROFILE GENERIC57600",0,0)
  RunLine(c"MOUNT DIAGNOSTICS >RAM:DIAG.TXT",0,0)
  RunLine(c"UNMOUNT D2:",0,0)
  LET scriptFile=DOS.Open(BYTE POINTER(c"RAM:SETUP"),DOS.MODE_NEWFILE)
  Require(scriptFile<>NULL AND DOS.Write(scriptFile,scriptText,SIZEOF(scriptText))=
      LONGINT(SIZEOF(scriptText)))
  Require(DOS.Close(scriptFile)<>0)
  RunLine(c"EXECUTE RAM:SETUP",0,0)
  Require(ShellFinish(@context)=0)
  Require(FSBOOT.Stop()<>0)
  Require(EXEC.AvailMem(0)=baseline)
  finished=1

RETURN

ENDMODULE
