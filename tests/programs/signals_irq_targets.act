MODULE SIGNALTARGETS
USE EXEC
USE EXECLISTS
USE EXECTASKS
USE EXECSIGNALIRQ
USE PRODUCERPROBE
USE TASKSTACKS
EXEC.Task parked,sleeper
EXEC.Task POINTER parent
VOLATILE BYTE mask=$10,irqen=$d20e,skctl=$d20f,skshadow=$232,nmien=$d40e
VOLATILE BYTE freq3=$d204,vol3=$d205,freq4=$d206,vol4=$d207,audctl=$d208,
    stimer=$d209,skreset=$d20a,serout=$d20d
VOLATILE CARD irqs=$2004,ticks=$2034
VOLATILE BYTE pending=$203a
BYTE oldsk,index
CARD ARRAY checks(32)
LONGCARD value
PROC POINTER missing()
INCLUDE "tasks_exec_helpers.inc"

; Fail immediately when an observed result violates the fixture contract.
PROC Check(BYTE good)

  checks(index)=CARD(good)
  index==+1

RETURN

PROC ParkEntry()
  LONGCARD ignored

  ignored=EXEC.Wait(0)

RETURN

PROC SleepEntry()
  CARD ignored

  ignored=EXECTASKS.Sleep(20)

RETURN

PROC ReusedEntry()

  value=EXEC.Wait(LONGCARD($80000000))

RETURN

; Post an interrupt-produced notification at a controlled scheduling boundary.
PROC Pulse(EXEC.Task POINTER item LONGCARD bits)
  CARD before,deadline

  Check(PRODUCERPROBE.Bind(item,bits))
  ; Rejection must preserve the existing binding and ownership state.
  Check(BYTE(PRODUCERPROBE.Bind(parent,2)=0))
  skctl=0
  freq3=6
  vol3=0
  freq4=0
  vol4=0
  audctl=$28
  skshadow=$23
  skctl=$23
  skreset=$23
  stimer=$23
  before=irqs
  deadline=ticks+8
  mask=mask % $10
  irqen=mask
  serout=$5a
  WHILE irqs=before AND ticks<>deadline DO
  OD

  Check(BYTE(irqs<>before))
  mask=mask & $ef
  irqen=mask
  skctl=0
  PRODUCERPROBE.Release()

RETURN

; Exercise wake delivery to the initial mix of parked and sleeping Tasks.
PROC Initial()
  EXEC.Task POINTER item
  CARD status

  parent=EXEC.FindTask(BYTE POINTER(0))
  PrepareTask(@parked,TASKSTACKS.LOWER1,BYTE POINTER(0))
  PrepareTask(@sleeper,TASKSTACKS.LOWER2,BYTE POINTER(0))
  item=EXEC.AddTask(@parked,@ParkEntry,missing)
  item=EXEC.AddTask(@sleeper,@SleepEntry,missing)
  WHILE parked.tc_State<>EXEC.TS_WAIT OR sleeper.tc_State<>EXEC.TS_WAIT DO
    status=EXECTASKS.Sleep(1)
  OD

  oldsk=skshadow
  EXEC.Forbid()
  Pulse(parent,1)
  Pulse(@parked,1)
  Pulse(@sleeper,1)
  Check(BYTE(pending=0 AND parent.tc_SigRecvd=1))
  Check(BYTE(parked.tc_State=EXEC.TS_WAIT AND parked.tc_SigRecvd=1
      AND parked.tc_SigWait=0))
  Check(BYTE(sleeper.tc_State=EXEC.TS_WAIT AND sleeper.tc_SigRecvd=1
      AND sleeper.tc_SigWait=0))
  EXEC.RemTask(@parked)
  EXEC.RemTask(@sleeper)
  EXEC.Permit()

RETURN

; Ensure a late interrupt cannot target the previous incarnation of a reused
; Task slot.
PROC Reuse()
  EXEC.Task POINTER item
  CARD status

  PrepareTask(@parked,TASKSTACKS.LOWER1,BYTE POINTER(0))
  item=EXEC.AddTask(@parked,@ReusedEntry,missing)
  WHILE parked.tc_State<>EXEC.TS_WAIT DO
    status=EXECTASKS.Sleep(1)
  OD

  EXEC.Forbid()
  Check(BYTE(parked.tc_SigRecvd=0))
  Pulse(item,2)
  Check(BYTE(pending=0 AND parked.tc_State=EXEC.TS_WAIT AND parked.tc_SigRecvd=2))
  Pulse(item,LONGCARD($80000000))
  PRODUCERPROBE.Drain()
  Check(BYTE(parked.tc_State=EXEC.TS_READY
      AND parked.tc_SigRecvd=LONGCARD($80000002)))
  ; IRQ posts to READY must remain pending without adding another wake node.
  Pulse(item,LONGCARD($80000000))
  Check(BYTE(pending=0))
  nmien=0
  EXEC.Permit()
  AwaitRemoval(item)
  nmien=$40
  skshadow=oldsk
  skctl=oldsk
  audctl=0
  Check(BYTE(value=LONGCARD($80000000) AND parked.tc_SigRecvd=2))

RETURN

; Exercise interrupt notification across Task sleep and identity reuse.
PROC Main()

  Initial()
  Reuse()

RETURN

ENDMODULE
