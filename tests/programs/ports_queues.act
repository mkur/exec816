MODULE PORTQUEUES
USE EXEC
USE EXECTASKS
USE EXECLISTS
USE TASKSTACKS
USE HEAPCORE

TYPE Request=[
  EXEC.Message header
  LONGCARD id
  BYTE POINTER payload
  LONGCARD bytes
]

EXEC.MsgPort requests,replies,ignored
Request ARRAY messages(3)
EXEC.Task worker
EXEC.Task POINTER parent
CARD ARRAY checks(16)
CARD ARRAY trace(12)
BYTE ready,done
BYTE POINTER block
PROC POINTER missing()
INCLUDE "tasks_exec_helpers.inc"

PROC InitPort(EXEC.MsgPort POINTER port BYTE action,bit, EXEC.Task POINTER owner)

  port.mp_Node.ln_Type=EXEC.NT_MSGPORT
  port.mp_Flags=action
  port.mp_SigBit=bit
  port.mp_SigTask=owner
  EXECLISTS.NewList(@port.mp_MsgList)

RETURN

PROC MessageFacts(EXEC.Message POINTER msg BYTE i)

  IF msg.mn_Node.ln_Type<>EXEC.NT_MESSAGE THEN
    HEAPCORE.Abort($ff81)
  FI

  IF msg.mn_Node.ln_Pri<>BYTE(i LSH 6) OR msg.mn_Length<>CARD(SIZEOF(Request)) THEN
    HEAPCORE.Abort($ff81)
  FI

RETURN

PROC Ignore()
  EXEC.Message POINTER msg
  Request POINTER req
  BYTE i

  InitPort(@ignored,EXEC.PA_IGNORE,$ff,EXEC.Task POINTER($ffffff))
  FOR i=0 TO 2 DO
    messages(i).id=LONGCARD(i)
    messages(i).header.mn_Node.ln_Pri=BYTE(i LSH 6)
    messages(i).header.mn_Length=SIZEOF(Request)
    EXEC.PutMsg(@ignored,@messages(i).header)
  OD

  FOR i=0 TO 2 DO
    msg=EXEC.GetMsg(@ignored)
    req=Request POINTER(msg)
    trace(i)=CARD(req.id)
    MessageFacts(msg,i)
    EXEC.ReplyMsg(msg)
    IF msg.mn_Node.ln_Type<>EXEC.NT_FREEMSG THEN
      HEAPCORE.Abort($ff82)
    FI
  OD

  checks(0)=CARD(EXEC.GetMsg(@ignored)=EXEC.Message POINTER(0))

RETURN

PROC WorkerEntry()
  EXEC.Message POINTER msg
  Request POINTER req
  LONGCARD bits
  BYTE i

  i=EXEC.AllocSignal(31)
  InitPort(@requests,EXEC.PA_SIGNAL,31,EXEC.FindTask(BYTE POINTER(0)))
  ready=1
  FOR i=0 TO 2 DO
    msg=EXEC.GetMsg(@requests)
    WHILE msg=EXEC.Message POINTER(0) DO
      bits=EXEC.Wait(LONGCARD($80000000))
      msg=EXEC.GetMsg(@requests)
    OD

    req=Request POINTER(msg)
    trace(3+i)=CARD(req.id)
    checks(2+i)=CARD(req.payload(0)=$39 AND req.payload(SIZE($10000))=$a6)
    EXEC.ReplyMsg(msg)
  OD

  done=1
  EXEC.FreeSignal(31)

RETURN

PROC Start()
  BYTE bit
  EXEC.Task POINTER added

  parent=EXEC.FindTask(BYTE POINTER(0))
  bit=EXEC.AllocSignal(31)
  InitPort(@replies,EXEC.PA_SIGNAL,31,parent)
  PrepareTask(@worker,TASKSTACKS.LOWER1,BYTE POINTER(0))
  added=EXEC.AddTask(@worker,@WorkerEntry,missing)
  WHILE ready=0 DO
    EXEC.Yield()
  OD

  block=EXEC.AllocMem(LONGCARD($10001),EXEC.MEMF_LINEAR)
  IF block=BYTE POINTER(0) THEN
    HEAPCORE.Abort($ff83)
  FI

  block(0)=$39
  block(SIZE($10000))=$a6

RETURN

PROC Send()
  BYTE i

  EXEC.Forbid()
  EXEC.Forbid()
  FOR i=0 TO 2 DO
    messages(i).payload=block
    messages(i).bytes=LONGCARD($10001)
    messages(i).header.mn_ReplyPort=@replies
    EXEC.PutMsg(@requests,@messages(i).header)
  OD

  checks(5)=CARD(parent.tc_TDNestCnt=1)
  checks(6)=CARD(worker.tc_State=EXEC.TS_READY)
  EXEC.Permit()
  EXEC.Permit()

RETURN

PROC Collect()
  BYTE i
  EXEC.Message POINTER msg
  Request POINTER req
  LONGCARD bits

  FOR i=0 TO 2 DO
    msg=EXEC.GetMsg(@replies)
    WHILE msg=EXEC.Message POINTER(0) DO
      bits=EXEC.Wait(LONGCARD($80000000))
      msg=EXEC.GetMsg(@replies)
    OD

    req=Request POINTER(msg)
    trace(6+i)=CARD(req.id)
    checks(7+i)=CARD(msg.mn_Node.ln_Type=EXEC.NT_REPLYMSG)
  OD

  WHILE done=0 DO
    EXEC.Yield()
  OD

  checks(10)=CARD(block(0)=$39 AND block(SIZE($10000))=$a6)
  checks(11)=CARD(EXEC.GetMsg(@replies)=EXEC.Message POINTER(0))
  EXEC.FreeMem(block,LONGCARD($10001))
  EXEC.FreeSignal(31)

RETURN

; Exercise message queue order and ignored versus signaled ports.
PROC Main()

  Ignore()
  Start()
  Send()
  Collect()
  checks(1)=1

RETURN

ENDMODULE
