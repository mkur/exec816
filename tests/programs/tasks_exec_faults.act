MODULE TASKFAULTS
USE EXEC
USE EXECLISTS
USE EXECTASKS
USE TASKSTACKS

BYTE variant,reached
CARD ARRAY rawChecks(15)
EXEC.Task child
EXECLISTS.Node memoryNode
PROC POINTER missing()

INCLUDE "tasks_exec_helpers.inc"

PROC Entry()

RETURN

PROC BadFinalizer()

RETURN

; Exercise invalid Task entries and finalizer behavior.
PROC Main()
  EXEC.Task POINTER item
  CARD at,status
  BYTE previous

  IF variant=0 THEN
    EXEC.Permit()
  FI

  IF variant=1 THEN
    FOR at=0 TO 128 DO
      EXEC.Forbid()
    OD
  FI

  IF variant=2 THEN
    EXEC.RemTask(@child)
  FI

  IF variant=3 THEN
    previous=EXEC.SetTaskPri(EXEC.Task POINTER(0),0)
  FI

  IF variant=4 THEN
    item=EXEC.FindTask(BYTE POINTER(0))
    EXECLISTS.AddTail(@item.tc_MemEntry,@memoryNode)
    EXEC.RemTask(item)
  FI

  IF variant=5 THEN
    PrepareTask(@child,TASKSTACKS.LOWER1,BYTE POINTER(0))
    item=EXEC.AddTask(@child,@Entry,@BadFinalizer)
    WHILE child.tc_State<>EXEC.TS_REMOVED DO
      status=EXECTASKS.Sleep(1)
    OD
  FI

  reached=1

RETURN

ENDMODULE
