; Live caller buffers, negative lengths and ownership cleanup through real DOS.
MODULE DOSTRANSFERBUFFERS
USE EXEC
USE DOS
USE HEAPCORE

CARD checks
BYTE finished
BYTE ARRAY buffer(17)

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($fb00+(checks & 255))
  FI

  checks==+1

RETURN

PROC Main()

  LET before=EXEC.AvailMem(0)
  LET handle=DOS.Open(BYTE POINTER(c"NIL:"),DOS.MODE_READWRITE)
  Require(handle<>NULL)
  buffer(0)=$5a
  buffer(16)=$a5
  Require(DOS.Write(handle,buffer,17)=17 AND DOS.IoErr()=0)
  Require(DOS.Read(handle,buffer,17)=0 AND DOS.IoErr()=0)
  Require(buffer(0)=$5a AND buffer(16)=$a5)
  Require(DOS.Write(handle,buffer,-1)=-1 AND DOS.IoErr()=DOS.ERROR_BAD_NUMBER)
  Require(DOS.Read(handle,buffer,-1)=-1 AND DOS.IoErr()=DOS.ERROR_BAD_NUMBER)
  Require(DOS.Write(handle,NULL,0)=0 AND DOS.IoErr()=0)
  Require(DOS.Close(handle)<>0)
  Require(DOS.ReleaseContext()<>0)
  Require(EXEC.AvailMem(0)=before)
  finished=1

RETURN

ENDMODULE
