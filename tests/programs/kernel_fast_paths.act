MODULE KERNELFAST
USE EXEC
USE EXECLISTS
USE EXECTASKS
USE TASKSTACKS
USE HEAPCORE

EXEC.MsgPort port
EXEC.Message first,second
EXEC.Task worker
EXEC.Task POINTER parent
EXEC.Message POINTER active
BYTE scenario,phase
CARD checks,iterations
PROC POINTER absent()
INCLUDE "tasks_exec_helpers.inc"

; Stop at the first failed fixture invariant and retain its check index for
; diagnosis.
PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($ff90)
  FI

  checks==+1

RETURN

PROC WorkerEntry()
  CARD status

  status=EXECTASKS.Sleep(1)
  phase=1
  EXEC.Signal(parent,LONGCARD($10000))

RETURN

PROC Measure()
  CARD index
  EXEC.Message POINTER msg

  FOR index=0 TO 15 DO
    EXEC.PutMsg(@port,@first)
    EXEC.PutMsg(@port,@second)
    EXEC.Forbid()
    EXEC.Forbid()
    active=EXEC.GetMsg(@port)
    Require(active=@first AND active.mn_Node.ln_Type=EXEC.NT_MESSAGE)
    msg=EXEC.GetMsg(@port)
    Require(msg=@second)
    msg=EXEC.GetMsg(@port)
    Require(msg=EXEC.Message POINTER(0))
    EXEC.Permit()
    Require(parent.tc_TDNestCnt=0)
    active=EXEC.Message POINTER(0)
    EXEC.Permit()
    Require(parent.tc_TDNestCnt=$ff)
    iterations==+1
  OD

RETURN

PROC Measured()

  Require(iterations=16)

RETURN

; Check that short gateway paths retain the full dispatcher's scheduling
; semantics.
PROC Coordination()
  EXEC.Task POINTER added
  LONGCARD bits
  BYTE bit

  bit=EXEC.AllocSignal(16)
  Require(bit=16)
  PrepareTask(@worker,TASKSTACKS.LOWER1,BYTE POINTER(0))
  EXEC.Forbid()
  EXEC.Forbid()
  added=EXEC.AddTask(@worker,@WorkerEntry,absent)
  Require(added=@worker)
  EXEC.Yield()
  Require(phase=0 AND parent.tc_TDNestCnt=1)
  bits=EXEC.Wait(LONGCARD($10000))
  Require(bits=LONGCARD($10000) AND phase=1 AND parent.tc_TDNestCnt=1)
  EXEC.Permit()
  Require(parent.tc_TDNestCnt=0)
  EXEC.Permit()
  Require(parent.tc_TDNestCnt=$ff)
  AwaitRemoval(@worker)
  EXEC.FreeSignal(16)

RETURN

; Exercise fast gateway results and scheduling coordination.
PROC Main()

  parent=EXEC.FindTask(BYTE POINTER(0))
  port.mp_Node.ln_Type=EXEC.NT_MSGPORT
  port.mp_Flags=EXEC.PA_IGNORE
  EXECLISTS.NewList(@port.mp_MsgList)
  Measure()
  Measured()
  IF scenario<>0 THEN
    Coordination()
  FI

RETURN

ENDMODULE
