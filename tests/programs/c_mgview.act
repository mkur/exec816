MODULE CMGVIEWTEST
USE EXEC
USE DOS
USE PROGRAMFILE
USE PROGRAM
USE PROGRAMIMAGE
USE PROCESS
USE HEAPCORE

CARD checks,phase,go,completed,argBytes
BYTE ARRAY argument(256)
LONGCARD ARRAY bases(2)

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($fa00+checks)
  FI
  checks==+1

RETURN

PROC Collect(LONGCARD child)
  PROCESS.Result result

  Require(PROCESS.Wait(child,@result)<>0)
  Require(result.primary=0)
  completed==+1

RETURN

PROC Rendezvous(CARD stage)

  phase=stage
  WHILE go<>stage DO
    EXEC.Yield()
  OD

RETURN

PROC Main()
  LONGCARD counter,viewer,baseline
  BYTE round

  LET input=DOS.Open(BYTE POINTER(c"NIL:"),DOS.MODE_OLDFILE)
  LET output=DOS.Open(BYTE POINTER(c"NIL:"),DOS.MODE_NEWFILE)
  Require(input<>NULL AND output<>NULL)
  DOS.SelectInput(input)
  DOS.SelectOutput(output)
  LET peer=PROGRAMFILE.Load(BYTE POINTER(c"SYS:COUNTER.APP"))
  Require(peer<>NULL)
  bases(1)=LONGCARD(peer.text)
  counter=PROCESS.StartBackgroundLoaded(BYTE POINTER(peer),NULL,0)
  Require(counter<>0)
  FOR round=0 TO 2 DO
    BEGIN
      LET image=PROGRAMFILE.Load(BYTE POINTER(c"SYS:MGVIEW.APP"))
      Require(image<>NULL)
      bases(0)=LONGCARD(image.text)
      Rendezvous(CARD(round)*2+1)
      viewer=PROCESS.StartBackgroundLoaded(BYTE POINTER(image),argument,argBytes)
      Require(viewer<>0)
      Rendezvous(CARD(round)*2+2)
      Require(PROCESS.RequestStop(viewer)<>0)
      Collect(viewer)
      PROGRAM.Unload(image)
      IF round=0 THEN
        baseline=EXEC.AvailMem(0)
      ELSE
        Require(EXEC.AvailMem(0)=baseline)
      FI
    END
  OD
  Require(PROCESS.RequestStop(counter)<>0)
  Collect(counter)
  PROGRAM.Unload(peer)
  DOS.SelectInput(NULL)
  DOS.SelectOutput(NULL)
  Require(DOS.Close(input)<>0 AND DOS.Close(output)<>0)
  Require(DOS.ReleaseContext()<>0)

RETURN
ENDMODULE
