MODULE PROCESSWAITTEST
USE EXEC
USE DOS
USE DOSCLIENT
USE DOSCORE
USE DOSDELAY
USE PROCESS
USE HEAPCORE

LONGCARD child,callbacks
EXEC.Task POINTER owner
BYTE collected,pending
CARD checks

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($fc40+checks)
  FI

  checks==+1

RETURN

PUBLIC LONGINT FUNC ChildEntry()

  Require(DOSDELAY.Delay(2)<>0)

RETURN(-55)

LONGCARD FUNC Service()
  PROCESS.Result result

  callbacks==+1
  Require(EXEC.FindTask(NULL)=owner)
  LET slot=DOSCORE.Current()
  LET client=DOSCLIENT.ClientContext POINTER(slot.context)
  Require(client.busy<>0)
  IF EXEC.CheckIO(client.timer)=NULL THEN
    pending=1
  FI

  IF PROCESS.Collect(child,@result)<>0 THEN
    Require(result.primary=-55)
    collected=1
    RETURN(0)
  FI

RETURN(PROCESS.CompletionMask(child))

PROC Main()

  Require(SIZEOF(DOSCLIENT.ClientContext)=DOSCLIENT.CLIENT_SIZE)
  owner=EXEC.FindTask(NULL)
  LET client=DOSCLIENT.Ensure()
  Require(client<>NULL)
  child=PROCESS.StartBackground(@ChildEntry,NULL,0)
  Require(child<>0)
  client.waitService=@Service
  client.waitMask=PROCESS.CompletionMask(child)
  Require(client.waitMask<>0)
  Require(DOSDELAY.Delay(50)<>0)
  Require(collected<>0 AND pending<>0 AND callbacks<>0)
  Require(client.waitMask=0)
  Require(DOS.ReleaseContext()<>0)

RETURN

ENDMODULE
