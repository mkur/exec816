MODULE FUJIPROTOCOLTEST
USE EXEC
USE FUJINET
USE HEAPCORE

CARD checks
BYTE ARRAY payload(128)
INCLUDE "io-names.inc"

; Check byte-protocol arithmetic separately from native record layout.
PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($ff99)
  FI

  checks==+1

RETURN

PROC Main()
  CARD index

  Require(FUJINET.HOST_TABLE_BYTES=8*32)
  Require(FUJINET.DISK_TABLE_BYTES=8*38)
  Require(FUJINET.ADAPTER_VERSION+15=140)
  FOR index=0 TO 7 DO
    Require(((index LSH 4) OR FUJINET.MODE_READ)=index*16+1)
    Require(((index LSH 4) OR FUJINET.MODE_WRITE)=index*16+2)
    Require(index*FUJINET.DISK_BYTES+FUJINET.DISK_FILE+36<=304)
  OD

  LET baseline=EXEC.AvailMem(0)
  LET port=EXEC.CreateMsgPort()
  Require(port<>NULL)
  LET request=EXEC.IOSIOReq POINTER(EXEC.CreateIORequest(port,52))
  Require(request<>NULL)
  Require(EXEC.OpenDevice(sioName,49,EXEC.IORequest POINTER(request),0)=0)
  request.io_Command=EXEC.SIOCMD_TRANSACTION
  request.sio_Command=$52
  request.sio_Profile=EXEC.SIO_PROFILE_STOCK810
  request.sio_Direction=EXEC.SIODIR_READ
  request.io_Data=payload
  request.io_Length=128
  Require(EXEC.DoIO(EXEC.IORequest POINTER(request))=0)
  Require(request.io_Actual=128)
  FOR index=0 TO 127 DO
    Require(payload(index)=BYTE(index*37+11))
  OD

  EXEC.CloseDevice(EXEC.IORequest POINTER(request))
  EXEC.DeleteIORequest(EXEC.IORequest POINTER(request))
  EXEC.DeleteMsgPort(port)
  Require(EXEC.AvailMem(0)=baseline)

RETURN

ENDMODULE
