MODULE DEMOTEST
USE HEAPCORE
USE CONSOLEWINDOWS
USE CONSOLETYPES
USE PROCESSSTATE
USE DOSCORE
USE DOSBREAKTYPES
USE FSBOOT
INCLUDE "../../examples/demo-session.inc"
BYTE stage,gate
CARD checks,steps
LONGCARD baseline
LONGINT exitStatus
PROCESSSTATE.Entry POINTER child
CONSOLETYPES.Instance POINTER topInstance,bottomInstance
CONSOLETYPES.Presentation POINTER topView,bottomView

; Stop at the first failed fixture invariant and retain its check index for
; diagnosis.
PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($ed00+(checks & 255))
  FI

  checks==+1

RETURN

; Let the other Tasks or device work advance before checking the next
; boundary.
PROC Pause(BYTE value)

  gate=0
  stage=value
  WHILE gate=0 DO
    EXEC.Yield()
  OD

RETURN

; Observe the actual shell child after boot scripts and prime startup.
PROC DemoBeforeRead(ShellContext POINTER context)
  CONSOLETYPES.Windows POINTER windows
  CONSOLETYPES.Window POINTER entry
  BYTE row

  windows=CONSOLEWINDOWS.Registry()
  WHILE windows.pane=0 DO
    EXEC.Yield()
  OD

  entry=CONSOLEWINDOWS.Find(0)
  topInstance=CONSOLETYPES.Instance POINTER(entry.instance)
  topView=CONSOLETYPES.Presentation POINTER(entry.view)
  entry=CONSOLEWINDOWS.Find(windows.pane)
  bottomInstance=CONSOLETYPES.Instance POINTER(entry.instance)
  bottomView=CONSOLETYPES.Presentation POINTER(entry.view)
  WHILE bottomInstance.cells(0)<>'- DO
    EXEC.Yield()
  OD

  child=PROCESSSTATE.Entry POINTER(DOSCORE.Control(PROCESSSTATE.OP_FIND,
      BYTE POINTER(@context.job.identity)))
  Require(child<>NULL)

  FOR row=1 TO 20 DO
    ShellText(context,context.shell.console,CSTRING(BYTE POINTER(@bootShellName)))
    ShellByte(context,context.shell.console,10)
  OD

  Pause(1)
RETURN

; Run on the shell owner so the retained prime Process may be inspected.
PROC DemoAfterRead(ShellContext POINTER context)

  steps==+1
  IF steps=1 THEN
    Pause(2)
  FI

  IF steps=2 THEN
    BEGIN
      LET scope=DOSBREAKTYPES.Scope POINTER(child.breakScope)
      Require(child.state=PROCESSSTATE.STATE_RUNNING AND scope.pending=0)
    END
    Pause(3)
  FI

RETURN

PROC DemoBeforeFinish(ShellContext POINTER context)

  Require(steps=3)
  Pause(4)
RETURN

; Only the controller collects the shell, then releases boot assignments.
PROC Main()

  baseline=EXEC.AvailMem(0)
  Require(ShellControllerStart(1)<>0)
  exitStatus=ShellControllerRun()
  ShellControllerStop()
  Require(exitStatus=0 AND contexts(0).job.state=JOB_DONE
      AND contexts(0).shell=NULL)
  LET windows=CONSOLEWINDOWS.Registry()
  Require(windows.liveCount=1)
  Require(DOS.AssignPath(BYTE POINTER(c"C"),NULL)<>0)
  Require(DOS.AssignPath(BYTE POINTER(c"S"),NULL)<>0)
  Require(DOS.ReleaseContext()<>0)
  Require(FSBOOT.Stop()<>0 AND EXEC.AvailMem(0)=baseline)
  stage=5

RETURN

ENDMODULE
