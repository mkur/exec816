MODULE CAPACITYBURST
USE EXEC
USE EXECLISTS
USE EXECTASKS
USE EXECSIGNALIRQ
USE PRODUCERPROBE
USE TASKSTACKS

EXEC.Task POINTER parent
VOLATILE BYTE mask=$10,irqen=$d20e,skctl=$d20f,skshadow=$232,nmien=$d40e
VOLATILE BYTE freq3=$d204,vol3=$d205,freq4=$d206,vol4=$d207,audctl=$d208,
    stimer=$d209,skreset=$d20a,serout=$d20d
VOLATILE BYTE doneCount
BYTE oldsk
CARD ARRAY checks(8)
LONGCARD ARRAY values(16)
PROC POINTER missing()

EXEC.Task POINTER FUNC TaskAt(BYTE slot)

RETURN(EXEC.Task POINTER(ADDRESS($05ffb1)+(SIZE(slot) LSH 6)-(SIZE(slot) LSH 1)))

PROC Worker()
  EXEC.Task POINTER self
  BYTE id

  self=EXEC.FindTask(BYTE POINTER(0))
  id=BYTE(self.tc_UserData)
  values(id)=EXEC.Wait(1)
  EXEC.Forbid()
  doneCount==+1
  EXEC.Permit()

RETURN

PROC Setup()
  EXEC.Task POINTER item,added
  BYTE slot,n
  BYTE POINTER bytes
  CARD status

  parent=EXEC.FindTask(BYTE POINTER(0))
  EXEC.Forbid()
  FOR slot=1 TO TASKSTACKS.CAPACITY-1 DO
    item=TaskAt(slot)
    bytes=BYTE POINTER(item)
    FOR n=0 TO EXEC.TASK_SIZE-1 DO
      bytes(n)=0
    OD

    item.tc_Node.ln_Type=EXEC.NT_TASK
    item.tc_UserData=SIZE(slot)
    item.tc_SPLower=ADDRESS(TASKSTACKS.StackLower(slot))
    item.tc_SPUpper=ADDRESS(TASKSTACKS.StackUpper(slot))
    item.tc_SPReg=item.tc_SPUpper-SIZE(2)
    EXECLISTS.NewList(@item.tc_MemEntry)
    added=EXEC.AddTask(item,@Worker,missing)
    IF added=item THEN
      checks(0)==+1
    FI
  OD

  EXEC.Permit()
  FOR slot=1 TO TASKSTACKS.CAPACITY-1 DO
    item=TaskAt(slot)
    WHILE item.tc_State<>EXEC.TS_WAIT DO
      status=EXECTASKS.Sleep(1)
    OD
  OD

  oldsk=skshadow
  checks(1)=CARD(PRODUCERPROBE.Bind(parent,1))

RETURN

; Exercise signal bursts at the configured Task limit.
PROC Main()
  EXEC.Task POINTER item
  BYTE slot

  Setup()
  nmien=0
  skctl=0
  freq3=$ff
  vol3=0
  freq4=$ff
  vol4=0
  audctl=$28
  skshadow=$23
  skctl=$23
  skreset=$23
  stimer=$23
  EXEC.Forbid()
  mask=mask % $10
  irqen=mask
  serout=$5a
  values(0)=EXEC.Wait(1)
  FOR slot=1 TO TASKSTACKS.CAPACITY-1 DO
    item=TaskAt(slot)
    IF item.tc_State=EXEC.TS_READY THEN
      checks(2)==+1
    FI
  OD

  checks(3)=CARD(parent.tc_TDNestCnt=0 AND doneCount=0)
  ; Quiesce the restored root binding before any descriptor can be reused.
  skctl=0
  PRODUCERPROBE.Release()
  skshadow=oldsk
  skctl=oldsk
  audctl=0
  EXEC.Permit()
  FOR slot=1 TO TASKSTACKS.CAPACITY-1 DO
    item=TaskAt(slot)
    WHILE item.tc_State<>EXEC.TS_REMOVED DO
      EXEC.Yield()
    OD
  OD

  checks(4)=CARD(doneCount)
  nmien=$40

RETURN

ENDMODULE
