MODULE SEMAPHORES
USE EXEC
USE HEAPCORE
USE EXECLISTS
USE TASKSTACKS
USE TIMER
INCLUDE "semaphore-action.inc"

CONST DONE=$10000
CONST ITERATIONS=32

TYPE CompositionWaiter=[
  BYTE POINTER next
  EXEC.Task POINTER task
  LONGCARD mask
  BYTE granted
]
TYPE Composed=[
  EXEC.Task POINTER owner
  CARD depth
  CompositionWaiter POINTER head,tail
]

Composed shared
CompositionWaiter parentWaiter,workerWaiter
EXEC.Task POINTER parent,worker
EXEC.TaskLease parentLease,workerLease
CARD checks
BYTE variant
BYTE reached
PROC POINTER absent()
VOLATILE CARD counter
VOLATILE BYTE phase,queued,stop
EXEC.SignalSemaphore device,second
TYPE Participant=[
  EXEC.Task POINTER task
  EXEC.TaskLease lease
]
Participant ARRAY peers(3)
VOLATILE BYTE completed
BYTE ARRAY order(3)
LONGINT attempted

; Stop on the first failed fixture invariant, outside timing loops.
PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($ff90)
  FI
  checks==+1

RETURN

; Fixture comparator only: cached identity and preallocated wait records.
PROC LibraryObtain(Composed POINTER semaphore EXEC.Task POINTER caller
    CompositionWaiter POINTER waiter)

  EXEC.Forbid()
  IF semaphore.owner=caller THEN
    semaphore.depth==+1
  ELSEIF semaphore.owner=NULL THEN
    semaphore.owner=caller
    semaphore.depth=1
  ELSE
    waiter.next=NULL
    waiter.granted=0
    IF semaphore.tail=NULL THEN
      semaphore.head=waiter
    ELSE
      semaphore.tail.next=BYTE POINTER(waiter)
    FI
    semaphore.tail=waiter
    queued=1
    WHILE waiter.granted=0 DO
      EXEC.Permit()
      BEGIN
        LET ignored=EXEC.Wait(waiter.mask)
      END
      EXEC.Forbid()
    OD
  FI
  EXEC.Permit()

RETURN

; Ownership is published before the waiter's retained notification.
PROC LibraryRelease(Composed POINTER semaphore EXEC.Task POINTER caller)

  EXEC.Forbid()
  semaphore.depth==-1
  IF semaphore.depth=0 THEN
    IF semaphore.head=NULL THEN
      semaphore.owner=NULL
    ELSE
      BEGIN
        LET waiter=semaphore.head
        semaphore.head=CompositionWaiter POINTER(waiter.next)
        IF semaphore.head=NULL THEN
          semaphore.tail=NULL
        FI
        semaphore.owner=waiter.task
        semaphore.depth=1
        waiter.granted=1
        EXEC.Signal(waiter.task,waiter.mask)
      END
    FI
  FI
  EXEC.Permit()

RETURN

; One complete public-composition pair, including its normal call wrappers.
PROC LibraryPair()

  LibraryObtain(@shared,parent,@parentWaiter)
  LibraryRelease(@shared,parent)

RETURN

PROC FreePairs(BYTE unused)
  CARD index

  FOR index=0 TO ITERATIONS-1 DO
    LibraryPair()
  OD

RETURN

PROC RecursivePairs(BYTE unused)
  CARD index

  FOR index=0 TO ITERATIONS-1 DO
    LibraryPair()
  OD

RETURN

; Sparse observation boundary; the parent never yields in its progress check.
PROC CounterTurn()

  counter==+1

RETURN

PROC CounterWorker()
  BYTE bit

  workerWaiter.task=EXEC.FindTask(NULL)
  bit=EXEC.AllocSignal(16)
  IF bit<>16 THEN
    HEAPCORE.Abort($ff90)
  FI
  workerWaiter.mask=LONGCARD(1) LSH bit
  DO
    CounterTurn()
    IF variant=15 AND counter=1 THEN
      EXEC.Signal(parent,DONE)
    FI
    IF phase=1 THEN
      IF variant=1 OR variant=8 THEN
        attempted=EXEC.AttemptSemaphore(@device)
        phase=2
      ELSE
        LibraryObtain(@shared,workerWaiter.task,@workerWaiter)
        phase=2
        LibraryRelease(@shared,workerWaiter.task)
      FI
    FI
    IF stop<>0 THEN
      EXIT
    FI
    EXEC.Yield()
  OD
  EXEC.FreeSignal(16)
  EXEC.Signal(parent,DONE)
  BEGIN
    LET ignored=EXEC.Wait(0)
  END

RETURN

; Pure Task work must remain preemptible while resource ownership persists.
PROC Progress(BYTE unused)
  CARD previous

  LibraryObtain(@shared,parent,@parentWaiter)
  previous=counter
  WHILE counter=previous DO
  OD
  Require(shared.owner=parent AND shared.depth=1)
  LibraryRelease(@shared,parent)

RETURN

PROC Handoff(BYTE unused)

  LibraryObtain(@shared,parent,@parentWaiter)
  phase=1
  WHILE queued=0 DO
  OD
  Require(shared.owner=parent AND shared.head=@workerWaiter)
  LibraryRelease(@shared,parent)
  WHILE phase<>2 DO
  OD
  Require(shared.head=NULL AND shared.tail=NULL)

RETURN

PROC Baseline(BYTE unused)

  parent=EXEC.FindTask(NULL)
  Require(EXEC.AllocSignal(16)=16)
  parentWaiter.task=parent
  parentWaiter.mask=DONE
  Require(EXEC.RetainTask(parent,@parentLease)<>0)
  EXEC.Forbid()
  worker=EXEC.CreateTask(c"semaphore counter",0,@CounterWorker,1)
  Require(worker<>NULL)
  Require(EXEC.RetainTask(worker,@workerLease)<>0)
  EXEC.Permit()
  Progress(0)
  FreePairs(0)
  Require(shared.owner=NULL AND shared.depth=0)
  LibraryObtain(@shared,parent,@parentWaiter)
  RecursivePairs(0)
  Require(shared.owner=parent AND shared.depth=1)
  LibraryRelease(@shared,parent)
  Handoff(0)
  stop=1
  Require(EXEC.Wait(DONE)=DONE)
  Require(shared.owner=NULL AND shared.depth=0)
  Require(counter<>0)
  EXEC.Forbid()
  Require(EXEC.ReleaseTask(@workerLease)<>0)
  EXEC.RemTask(worker)
  EXEC.Permit()
  Require(EXEC.ReleaseTask(@parentLease)<>0)
  EXEC.FreeSignal(16)

RETURN

; Small emitted import/layout/long-result probe, also run without optimization.
PROC NativeABI(BYTE unused)
  CARD index
  EXEC.SignalSemaphore POINTER target

  target=@device
  IF variant=9 THEN
    target=EXEC.SignalSemaphore POINTER(ADDRESS($04fffa))
  FI
  Require(SIZEOF(EXEC.SignalSemaphore)=SEM_SIZE)
  FOR index=0 TO 5 DO
    target.ss_Private(index)=$ffff
  OD
  EXEC.InitSemaphore(target)
  FOR index=0 TO 5 DO
    Require(target.ss_Private(index)=0)
  OD
  parent=EXEC.FindTask(NULL)
  EXEC.Forbid()
  attempted=EXEC.AttemptSemaphore(target)
  Require(attempted=1)
  Require(EXEC.AttemptSemaphore(target)=1)
  Require(target.ss_Private(2)=2)
  EXEC.ReleaseSemaphore(target)
  Require(target.ss_Private(2)=1)
  EXEC.ReleaseSemaphore(target)
  Require(target.ss_Private(0)=0 AND target.ss_Private(1)=0
      AND target.ss_Private(2)=0)
  Require(parent.tc_TDNestCnt=0)
  EXEC.Permit()

RETURN

; A second Task's failed try must not change ownership or consume any signals.
PROC NativeCore(BYTE unused)

  parent=EXEC.FindTask(NULL)
  EXEC.InitSemaphore(@device)
  EXEC.InitSemaphore(@second)
  Require(EXEC.AllocSignal(16)=16)
  Require(EXEC.AttemptSemaphore(@device)=1)
  Require(EXEC.AttemptSemaphore(@second)=1)
  Require(EXEC.AttemptSemaphore(@device)=1)
  EXEC.ReleaseSemaphore(@device)
  Require(device.ss_Private(2)=1)
  EXEC.Forbid()
  worker=EXEC.CreateTask(c"semaphore contender",0,@CounterWorker,1)
  Require(worker<>NULL)
  Require(EXEC.RetainTask(worker,@workerLease)<>0)
  phase=1
  EXEC.Permit()
  WHILE phase<>2 DO
  OD
  Require(attempted=0 AND device.ss_Private(2)=1)
  EXEC.ReleaseSemaphore(@device)
  Require(device.ss_Private(2)=0 AND second.ss_Private(2)=1)
  EXEC.ReleaseSemaphore(@second)
  stop=1
  Require(EXEC.Wait(DONE)=DONE)
  EXEC.Forbid()
  Require(EXEC.ReleaseTask(@workerLease)<>0)
  EXEC.RemTask(worker)
  EXEC.Permit()
  EXEC.FreeSignal(16)
  Require(EXEC.AttemptSemaphore(@device)=1)
  EXEC.ReleaseSemaphore(@device)

RETURN

; Deliberate invariant-limit injection belongs only to the fault fixture.
PROC NativeFault(BYTE operation)

  parent=EXEC.FindTask(NULL)
  EXEC.InitSemaphore(@device)
  IF operation=8 THEN
    BEGIN
      LET bit=EXEC.AllocSignal(16)
      worker=EXEC.CreateTask(c"semaphore owner",0,@CounterWorker,1)
      phase=1
      WHILE phase<>2 DO
      OD
      EXEC.ReleaseSemaphore(@device)
    END
  ELSEIF operation<>3 THEN
    attempted=EXEC.AttemptSemaphore(@device)
  FI
  IF operation=3 THEN
    EXEC.ReleaseSemaphore(@device)
  ELSEIF operation=4 THEN
    EXEC.ReleaseSemaphore(@device)
    EXEC.ReleaseSemaphore(@device)
  ELSEIF operation=5 THEN
    EXEC.RemTask(NULL)
  ELSEIF operation=6 THEN
    device.ss_Private(2)=$ffff
    attempted=EXEC.AttemptSemaphore(@device)
  ELSEIF operation=7 THEN
    BEGIN
      LET count=CARD POINTER(parent.tc_ExecPrivate+SIZE(SEM_OWNED_OFFSET))
      count^=$ffff
      EXEC.InitSemaphore(@second)
      attempted=EXEC.AttemptSemaphore(@second)
    END
  FI
  reached=1
  Require(0)

RETURN

PROC FarWorker()

  Require(EXEC.AttemptSemaphore(@device)=1)
  Require(EXEC.AttemptSemaphore(@device)=1)
  EXEC.ReleaseSemaphore(@device)
  EXEC.ReleaseSemaphore(@device)
  EXEC.Signal(parent,DONE)
  BEGIN
    LET ignored=EXEC.Wait(0)
  END

RETURN

; Caller-prepared public Task crosses a CPU bank; its pool still owns S/D.
PROC FarTask(BYTE unused)
  CARD index
  BYTE POINTER bytes

  parent=EXEC.FindTask(NULL)
  EXEC.InitSemaphore(@device)
  Require(EXEC.AllocSignal(16)=16)
  worker=EXEC.Task POINTER(ADDRESS($06fff0))
  bytes=BYTE POINTER(worker)
  FOR index=0 TO EXEC.TASK_SIZE-1 DO
    bytes(index)=0
  OD
  worker.tc_Node.ln_Type=EXEC.NT_TASK
  worker.tc_SPLower=ADDRESS(TASKSTACKS.StackLower(1))
  worker.tc_SPUpper=ADDRESS(TASKSTACKS.StackUpper(1))
  worker.tc_SPReg=worker.tc_SPUpper-SIZE(2)
  EXECLISTS.NewList(@worker.tc_MemEntry)
  EXEC.Forbid()
  Require(EXEC.AddTask(worker,@FarWorker,absent)=worker)
  Require(EXEC.RetainTask(worker,@workerLease)<>0)
  EXEC.Permit()
  Require(EXEC.Wait(DONE)=DONE)
  EXEC.Forbid()
  Require(EXEC.ReleaseTask(@workerLease)<>0)
  EXEC.RemTask(worker)
  EXEC.Permit()
  EXEC.FreeSignal(16)
  Require(device.ss_Private(2)=0)
  Require(worker.tc_State=EXEC.TS_REMOVED)

RETURN

; Each waiter keeps its own Forbid depth and unrelated pending signals.
PROC BlockingWorker()
  BYTE index

  LET self=EXEC.FindTask(NULL)
  index=0
  WHILE peers(index).task<>self DO
    index==+1
  OD
  Require(EXEC.AllocSignal(16)=16)
  Require(EXEC.AllocSignal(17)=17)
  BEGIN
    LET ignored=EXEC.SetSignal(DONE,DONE)
  END
  EXEC.Signal(parent,DONE)
  EXEC.Forbid()
  EXEC.ObtainSemaphore(@device)
  Require(self.tc_TDNestCnt=0)
  Require(device.ss_Private(2)=1)
  Require(EXEC.SetSignal(0,0)=(DONE OR $20000))
  order(completed)=index
  completed==+1
  EXEC.ObtainSemaphore(@device)
  EXEC.ReleaseSemaphore(@device)
  EXEC.ReleaseSemaphore(@device)
  EXEC.Permit()
  EXEC.FreeSignal(16)
  EXEC.FreeSignal(17)
  EXEC.Signal(parent,DONE)
  BEGIN
    LET ignored=EXEC.Wait(0)
  END

RETURN

; Serial admission makes FIFO order deterministic; the owner also tries to barge.
PROC Blocking(BYTE unused)
  BYTE index

  parent=EXEC.FindTask(NULL)
  Require(EXEC.AllocSignal(16)=16)
  EXEC.InitSemaphore(@device)
  EXEC.ObtainSemaphore(@device)
  FOR index=0 TO 2 DO
    EXEC.Forbid()
    peers(index).task=EXEC.CreateTask(c"semaphore waiter",0,@BlockingWorker,1)
    Require(peers(index).task<>NULL)
    Require(EXEC.RetainTask(peers(index).task,@peers(index).lease)<>0)
    EXEC.Permit()
    ; A normal signal Wait is permitted while resource ownership is held.
    Require(EXEC.Wait(DONE)=DONE)
    WHILE peers(index).task.tc_State<>EXEC.TS_WAIT DO
      EXEC.Yield()
    OD
    EXEC.Signal(peers(index).task,$20000)
    Require(peers(index).task.tc_State=EXEC.TS_WAIT)
  OD
  Require(completed=0)
  Require(device.ss_Private(2)=1)
  EXEC.ObtainSemaphore(@device)
  EXEC.ReleaseSemaphore(@device)
  Require(device.ss_Private(2)=1)
  IF variant=12 THEN
    Require(EXEC.ReleaseTask(@peers(0).lease)<>0)
    EXEC.RemTask(peers(0).task)
  FI
  EXEC.Forbid()
  EXEC.ReleaseSemaphore(@device)
  Require(completed=0)
  Require(EXEC.AttemptSemaphore(@device)=0)
  IF variant=13 THEN
    Require(EXEC.ReleaseTask(@peers(0).lease)<>0)
    EXEC.RemTask(peers(0).task)
  FI
  EXEC.Permit()
  WHILE completed<>3 DO
    BEGIN
      LET ignored=EXEC.Wait(DONE)
    END
  OD
  FOR index=0 TO 2 DO
    Require(order(index)=index)
    EXEC.Forbid()
    Require(EXEC.ReleaseTask(@peers(index).lease)<>0)
    EXEC.RemTask(peers(index).task)
    EXEC.Permit()
  OD
  Require(device.ss_Private(2)=0)
  Require(device.ss_Private(3)=0 AND device.ss_Private(4)=0
      AND device.ss_Private(5)=0)
  EXEC.FreeSignal(16)
  ; Reuse a retired pool and prove its semaphore accounting starts clear.
  EXEC.Forbid()
  worker=EXEC.CreateTask(c"semaphore reused",0,@FarWorker,1)
  Require(worker<>NULL)
  Require(EXEC.RetainTask(worker,@workerLease)<>0)
  Require(EXEC.AllocSignal(16)=16)
  EXEC.Permit()
  Require(EXEC.Wait(DONE)=DONE)
  EXEC.Forbid()
  Require(EXEC.ReleaseTask(@workerLease)<>0)
  EXEC.RemTask(worker)
  EXEC.Permit()
  EXEC.FreeSignal(16)

RETURN

; Matched complete-call timings; the comparator remains fixture-local.
PROC NativePair()

  EXEC.ObtainSemaphore(@device)
  EXEC.ReleaseSemaphore(@device)

RETURN

PROC NativeFreePairs(BYTE unused)
  CARD index

  FOR index=0 TO ITERATIONS-1 DO
    NativePair()
  OD

RETURN

PROC NativeRecursivePairs(BYTE unused)
  CARD index

  FOR index=0 TO ITERATIONS-1 DO
    NativePair()
  OD

RETURN

PROC NativeBench(BYTE unused)

  parent=EXEC.FindTask(NULL)
  EXEC.InitSemaphore(@device)
  NativeFreePairs(0)
  Require(device.ss_Private(2)=0)
  EXEC.ObtainSemaphore(@device)
  NativeRecursivePairs(0)
  Require(device.ss_Private(2)=1)
  EXEC.ReleaseSemaphore(@device)
  Require(device.ss_Private(2)=0)

RETURN

PROC CoexistWaiter()

  EXEC.ObtainSemaphore(@device)
  phase=2
  EXEC.ReleaseSemaphore(@device)
  EXEC.Signal(parent,$20000)
  BEGIN
    LET ignored=EXEC.Wait(0)
  END

RETURN

; Real timer completion and unrelated signals continue while a waiter sleeps.
PROC Coexist(BYTE unused)
  CARD previous
  EXEC.MsgPort POINTER reply
  TIMER.TimerRequest POINTER alarm

  parent=EXEC.FindTask(NULL)
  Require(EXEC.AllocSignal(16)=16)
  Require(EXEC.AllocSignal(17)=17)
  EXEC.InitSemaphore(@device)
  reply=EXEC.CreateMsgPort()
  Require(reply<>NULL)
  alarm=TIMER.TimerRequest POINTER(EXEC.CreateIORequest(reply,
      SIZEOF(TIMER.TimerRequest)))
  Require(alarm<>NULL)
  Require(EXEC.OpenDevice(BYTE POINTER(c"timer.device"),TIMER.UNIT_VBLANK,
      @alarm.tr_Request,0)=0)
  EXEC.ObtainSemaphore(@device)
  EXEC.Forbid()
  worker=EXEC.CreateTask(c"semaphore counter",0,@CounterWorker,1)
  peers(0).task=EXEC.CreateTask(c"semaphore waiter",0,@CoexistWaiter,1)
  Require(worker<>NULL AND peers(0).task<>NULL)
  Require(EXEC.RetainTask(worker,@workerLease)<>0)
  Require(EXEC.RetainTask(peers(0).task,@peers(0).lease)<>0)
  EXEC.Permit()
  previous=counter
  WHILE counter=previous DO
  OD
  WHILE peers(0).task.tc_State<>EXEC.TS_WAIT DO
  OD
  Require(phase=0 AND device.ss_Private(2)=1)
  alarm.tr_Request.io_Command=TIMER.TR_ADDREQUEST
  alarm.seconds=0
  alarm.microseconds=100000
  EXEC.SendIO(@alarm.tr_Request)
  Require(EXEC.WaitIO(@alarm.tr_Request)=0)
  Require(counter>previous AND phase=0 AND device.ss_Private(2)=1)
  Require((EXEC.SetSignal(0,0) & DONE)=DONE)
  Require(EXEC.Wait(DONE)=DONE)
  EXEC.ReleaseSemaphore(@device)
  Require(EXEC.Wait($20000)=$20000)
  stop=1
  Require(EXEC.Wait(DONE)=DONE)
  EXEC.Forbid()
  Require(EXEC.ReleaseTask(@workerLease)<>0)
  EXEC.RemTask(worker)
  Require(EXEC.ReleaseTask(@peers(0).lease)<>0)
  EXEC.RemTask(peers(0).task)
  EXEC.Permit()
  EXEC.CloseDevice(@alarm.tr_Request)
  EXEC.DeleteIORequest(@alarm.tr_Request)
  EXEC.DeleteMsgPort(reply)
  EXEC.FreeSignal(16)
  EXEC.FreeSignal(17)
  Require(device.ss_Private(2)=0 AND phase=2)

RETURN

PROC Main()

  IF variant=0 THEN
    Baseline(0)
  ELSEIF variant=1 THEN
    NativeCore(0)
  ELSEIF variant=2 OR variant=9 THEN
    NativeABI(0)
  ELSEIF variant=14 THEN
    NativeBench(0)
  ELSEIF variant=15 THEN
    Coexist(0)
  ELSEIF variant>=11 THEN
    Blocking(0)
  ELSEIF variant=10 THEN
    FarTask(0)
  ELSE
    NativeFault(variant)
  FI

RETURN

ENDMODULE
