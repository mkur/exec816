MODULE DOSFILEDATE
USE EXEC
USE DOS
USE HEAPCORE
USE FSBOOT

CARD checks
LONGINT reason
DOS.DateStamp stamp
DOS.FileInfoBlock info

PROC Require(BYTE okay)

  IF okay=0 THEN
    reason=DOS.IoErr()
    HEAPCORE.Abort($fa00+checks)
  FI
  checks==+1

RETURN

PROC Check(BYTE POINTER name)
  DOS.FileHandle POINTER file
  DOS.FileLock POINTER lock

  file=DOS.Open(name,DOS.MODE_NEWFILE)
  Require(file<>NULL)
  Require(DOS.Write(file,BYTE POINTER(c"abc"),3)=3)
  Require(DOS.Close(file)<>0)
  stamp.ds_Days=17822
  stamp.ds_Minute=872
  stamp.ds_Tick=700
  Require(DOS.SetFileDate(name,@stamp)<>0)
  lock=DOS.Lock(name,DOS.SHARED_LOCK)
  Require(lock<>NULL)
  Require(DOS.Examine(lock,@info)<>0)
  Require(info.fib_Date.ds_Days=17822 AND info.fib_Date.ds_Minute=872 AND
      info.fib_Date.ds_Tick=700)
  Require(DOS.SetFileDate(name,@stamp)=0 AND DOS.IoErr()=DOS.ERROR_OBJECT_IN_USE)
  DOS.UnLock(lock)
  stamp.ds_Minute=1440
  Require(DOS.SetFileDate(name,@stamp)=0 AND DOS.IoErr()=DOS.ERROR_BAD_NUMBER)
  stamp.ds_Minute=872
  lock=DOS.Lock(name,DOS.SHARED_LOCK)
  Require(DOS.Examine(lock,@info)<>0)
  Require(info.fib_Date.ds_Minute=872 AND info.fib_Size=3)
  DOS.UnLock(lock)

RETURN

PROC Main()
  LONGCARD baseline

  baseline=EXEC.AvailMem(0)
  Check(BYTE POINTER(c"RAM:DATE.BIN"))
DISK_CASES
  Require(DOS.SetFileDate(BYTE POINTER(c"RAM:MISSING"),@stamp)=0 AND
      DOS.IoErr()=DOS.ERROR_OBJECT_NOT_FOUND)
  Require(DOS.ReleaseContext()<>0)
  Require(FSBOOT.Stop()<>0)
  Require(EXEC.AvailMem(0)=baseline)

RETURN

ENDMODULE
