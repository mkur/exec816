; Actual cursor hint routines with a deterministic physical-call boundary.
MODULE CURSORHINTTEST
USE CURSORHINTBITMAP
USE HEAPCORE

CARD checks

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($fc80+checks)
  FI
  checks==+1

RETURN

; A late draw inside synchronous submission must survive its completion.
PROC Check(BYTE fallback,oldHint,okay,lateDraw,expected)
  BYTE result

  CURSORHINTBITMAP.drawingChanged=oldHint
  CURSORHINTBITMAP.returnOkay=okay
  CURSORHINTBITMAP.lateDraw=lateDraw
  IF fallback=0 THEN
    result=CURSORHINTBITMAP.Mouse(NULL)
  ELSE
    result=CURSORHINTBITMAP.Cursor(632,0,1)
  FI

  Require(result=okay)
  Require(CURSORHINTBITMAP.observedChanged=0)
  Require(CURSORHINTBITMAP.Changed()=expected)
  Require(CURSORHINTBITMAP.lastOperation=IF fallback=0 THEN
      CURSORHINTBITMAP.OP_MOUSE ELSE CURSORHINTBITMAP.OP_POINTER FI)

RETURN

PROC Main()
  BYTE fallback

  FOR fallback=0 TO 1 DO
    Check(fallback,1,1,0,0)
    Check(fallback,1,0,0,1)
    Check(fallback,1,1,1,1)
    Check(fallback,0,0,0,1)
    Check(fallback,0,0,1,1)
    Check(fallback,1,1,0,0)
  OD

RETURN
ENDMODULE
