MODULE PORTHANDOFF
USE EXEC
USE EXECLISTS
USE EXECTASKS
USE TASKSTACKS
USE HEAPCORE

TYPE Request=[
  EXEC.Message header
  CARD generation
]

EXEC.MsgPort requests,replies,returned
EXEC.Task worker
Request POINTER item
BYTE published,putReturned
CARD ARRAY checks(6)
PROC POINTER absent()
INCLUDE "tasks_exec_helpers.inc"

PROC WorkerEntry()
  BYTE bit
  LONGCARD bits
  EXEC.Message POINTER msg
  Request POINTER req
  ; Wait suspends this Forbid depth. Resume under it so a VBI cannot let the
  ; original PutMsg caller return before the explicit reply/reuse protocol.
  EXEC.Forbid()
  bit=EXEC.AllocSignal(31)
  requests.mp_Node.ln_Type=EXEC.NT_MSGPORT
  requests.mp_SigTask=EXEC.FindTask(BYTE POINTER(0))
  requests.mp_SigBit=31
  EXECLISTS.NewList(@requests.mp_MsgList)
  published=1
  bits=EXEC.Wait(LONGCARD($80000000))
  msg=EXEC.GetMsg(@requests)
  checks(0)=CARD(putReturned=0 AND msg=@item.header)
  EXEC.ReplyMsg(msg)
  msg=EXEC.GetMsg(@replies)
  checks(1)=CARD(msg=@item.header AND msg.mn_Node.ln_Type=EXEC.NT_REPLYMSG)
  req=Request POINTER(msg)
  req.generation=2
  EXEC.PutMsg(@returned,msg)
  checks(2)=CARD(putReturned=0)
  EXEC.FreeSignal(31)
  EXEC.Permit()

RETURN

; Exercise message ownership across a producer/consumer handoff.
PROC Main()
  EXEC.Task POINTER added
  EXEC.Message POINTER msg

  item=Request POINTER(EXEC.AllocMem(SIZEOF(Request),EXEC.MEMF_CLEAR))
  IF item=Request POINTER(0) THEN
    HEAPCORE.Abort($ff85)
  FI

  replies.mp_Node.ln_Type=EXEC.NT_MSGPORT
  replies.mp_Flags=EXEC.PA_IGNORE
  returned.mp_Node.ln_Type=EXEC.NT_MSGPORT
  returned.mp_Flags=EXEC.PA_IGNORE
  EXECLISTS.NewList(@replies.mp_MsgList)
  EXECLISTS.NewList(@returned.mp_MsgList)
  item.header.mn_ReplyPort=@replies
  item.generation=1
  PrepareTask(@worker,TASKSTACKS.LOWER1,BYTE POINTER(0))
  added=EXEC.AddTask(@worker,@WorkerEntry,absent)
  WHILE published=0 DO
    EXEC.Yield()
  OD

  EXEC.PutMsg(@requests,@item.header)
  putReturned=1
  msg=EXEC.GetMsg(@returned)
  checks(3)=CARD(msg=@item.header AND item.generation=2)
  checks(4)=CARD(msg.mn_Node.ln_Type=EXEC.NT_MESSAGE)
  EXEC.FreeMem(BYTE POINTER(item),SIZEOF(Request))
  AwaitRemoval(@worker)
  checks(5)=1

RETURN

ENDMODULE
