MODULE DISPLAYACCESSPROBE
USE EXEC
USE DISPLAY
USE HEAPCORE

DISPLAY.Lease lease
DISPLAY.Grant ARRAY grant(2)
DISPLAY.Grant ARRAY capacity(9)
EXEC.Task POINTER root,firstTask,secondTask
BYTE ARRAY stage(2)
CARD ARRAY result(2)
CARD checks
BYTE round,quit

PROC Require(BYTE okay)

  EXEC.Forbid()
  IF okay=0 THEN
    HEAPCORE.Abort($fb00+checks)
  FI

  checks==+1
  EXEC.Permit()

RETURN

PROC Worker(BYTE index)
  LONGCARD bits
  CARD cycle

  Require(EXEC.AllocSignal(16)=16)
  grant(index).task=EXEC.FindTask(NULL)
  grant(index).mask=$10000
  stage(index)=1
  EXEC.Signal(root,$10000)
  FOR cycle=1 TO 2 DO
    WHILE round<cycle DO
      bits=EXEC.Wait($10000)
    OD

    result(index)=DISPLAY.Enter(@grant(index))
    IF result(index)=DISPLAY.OK THEN
      stage(index)=2
      EXEC.Signal(root,$10000)
      WHILE quit=0 DO
        bits=EXEC.Wait($10000)
      OD

      Require(DISPLAY.Leave(@grant(index))=DISPLAY.OK)
    FI

    Require(DISPLAY.GrantClose(@grant(index))=DISPLAY.OK)
    stage(index)=BYTE(cycle+2)
    EXEC.Signal(root,$10000)
  OD

  EXEC.FreeSignal(16)
  EXEC.Forbid()
  stage(index)=5
  EXEC.Signal(root,$10000)

RETURN

PROC First()

  Worker(0)

RETURN

PROC Second()

  Worker(1)

RETURN

PROC Await(BYTE index,value)
  LONGCARD bits

  WHILE stage(index)<>value DO
    bits=EXEC.Wait($10000)
  OD

RETURN

PROC Main()
  BYTE index
  LONGCARD bits

  Require(SIZEOF(DISPLAY.Grant)=DISPLAY.GRANT_BYTES)
  root=EXEC.FindTask(NULL)
  Require(EXEC.AllocSignal(16)=16)
  Require(DISPLAY.Acquire(@lease,DISPLAY.VBXE)=DISPLAY.OK)
  Require(DISPLAY.Activate(@lease)=DISPLAY.OK)
  Require(DISPLAY.OwnerWake($10000)=DISPLAY.OK)
  firstTask=EXEC.CreateTask(c"display firstTask",0,@First,1024)
  secondTask=EXEC.CreateTask(c"display secondTask",0,@Second,1024)
  Require(firstTask<>NULL AND secondTask<>NULL)
  Await(0,1)
  Await(1,1)
  Require(DISPLAY.Delegate(@grant(0))=DISPLAY.OK)
  Require(DISPLAY.Delegate(@grant(1))=DISPLAY.OK)
  Require(DISPLAY.Delegated()=2)
  Require(DISPLAY.Enter(@grant(0))=DISPLAY.INVALID_OWNER)
  Require(DISPLAY.OwnerEnter()=DISPLAY.OK)
  round=1
  EXEC.Signal(firstTask,$10000)
  WHILE grant(0).state<>DISPLAY.GRANT_QUEUED DO
    EXEC.Yield()
  OD

  EXEC.Signal(secondTask,$10000)
  WHILE grant(1).state<>DISPLAY.GRANT_QUEUED DO
    EXEC.Yield()
  OD

  Require(DISPLAY.Revoke(@grant(1))=DISPLAY.OK)
  Await(1,3)
  Require(result(1)=DISPLAY.INVALID_OWNER)
  Require(DISPLAY.OwnerEnd(1)=DISPLAY.OK)
  EXEC.Yield()
  Require(grant(0).state=DISPLAY.GRANT_QUEUED)
  Require(DISPLAY.OwnerEnter()=DISPLAY.OK)
  Require(DISPLAY.OwnerEnd(0)=DISPLAY.OK)
  Await(0,2)
  Require(DISPLAY.Blocked()<>0)
  Require(DISPLAY.Revoke(@grant(0))=DISPLAY.BUSY)
  Require(DISPLAY.BeginRelease(@lease)=DISPLAY.BUSY)
  Require(DISPLAY.OwnerEnter()=DISPLAY.BUSY)
  Require(DISPLAY.OwnerEnter()=DISPLAY.BUSY)
  quit=1
  EXEC.Signal(firstTask,$10000)
  Await(0,3)
  Require(DISPLAY.Blocked()=0)
  Require(DISPLAY.OwnerEnter()=DISPLAY.OK)
  Require(DISPLAY.OwnerEnd(0)=DISPLAY.OK)
  Require(DISPLAY.Delegated()=0)

  ; Resource exhaustion is normal; every retained grant must be collected.
  FOR index=0 TO DISPLAY.GRANTS DO
    capacity(index).task=root
    capacity(index).mask=$10000
    IF index<DISPLAY.GRANTS THEN
      Require(DISPLAY.Delegate(@capacity(index))=DISPLAY.OK)
    ELSE
      Require(DISPLAY.Delegate(@capacity(index))=DISPLAY.NO_MEMORY)
    FI
  OD

  Require(DISPLAY.BeginRelease(@lease)=DISPLAY.BUSY)
  bits=EXEC.SetSignal(0,$10000)
  FOR index=0 TO DISPLAY.GRANTS-1 DO
    Require(DISPLAY.GrantClose(@capacity(index))=DISPLAY.OK)
  OD

  Require((EXEC.SetSignal(0,$10000) & $10000)<>0)
  Require(DISPLAY.Delegate(@grant(0))=DISPLAY.OK)
  Require(DISPLAY.Delegate(@grant(1))=DISPLAY.OK)
  Require(DISPLAY.OwnerEnter()=DISPLAY.OK)
  round=2
  EXEC.Signal(firstTask,$10000)
  EXEC.Signal(secondTask,$10000)
  WHILE grant(0).state<>DISPLAY.GRANT_QUEUED
      OR grant(1).state<>DISPLAY.GRANT_QUEUED DO
    EXEC.Yield()
  OD

  Require(DISPLAY.AccessFault(0)=DISPLAY.DEVICE_FAULT)
  Require(DISPLAY.OwnerEnd(0)=DISPLAY.OK)
  Await(0,5)
  Await(1,5)
  Require(result(0)=DISPLAY.DEVICE_FAULT AND result(1)=DISPLAY.DEVICE_FAULT)
  Require(DISPLAY.Delegated()=0)
  Require(DISPLAY.BeginRelease(@lease)=DISPLAY.OK)
  Require(DISPLAY.Release(@lease)=DISPLAY.OK)
  Require(DISPLAY.State()=DISPLAY.FREE)
  Require(DISPLAY.OwnerEnter()=DISPLAY.INVALID_OWNER)
  EXEC.FreeSignal(16)

RETURN
ENDMODULE
