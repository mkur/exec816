MODULE G4BENCHTEST
USE EXEC
USE DOS
USE PROGRAMFILE
USE PROGRAM
USE PROGRAMIMAGE
USE PROCESS
USE AESSTATE
USE AESCORE
USE HEAPCORE

CARD checks,ready,completed
LONGCARD benchmark,baseline

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($fa80+checks)
  FI
  checks==+1

RETURN

LONGCARD FUNC Launch(BYTE POINTER path)

  LET image=PROGRAMFILE.Load(path)
  Require(image<>NULL)
  LET identity=PROCESS.StartLoaded(BYTE POINTER(image),NULL,0,0)
  Require(identity<>0)
  PROGRAM.Unload(image)

RETURN(identity)

PROC Main()
  PROCESS.Result result
  BYTE cycle

  LET input=DOS.Open(BYTE POINTER(c"NIL:"),DOS.MODE_OLDFILE)
  LET output=DOS.Open(BYTE POINTER(c"NIL:"),DOS.MODE_NEWFILE)
  Require(input<>NULL AND output<>NULL)
  LET oldInput=DOS.SelectInput(input)
  LET oldOutput=DOS.SelectOutput(output)
  benchmark=Launch(BYTE POINTER(c"SYS:C/G4CLOCK.APP"))
  Require(PROCESS.Wait(benchmark,@result)<>0)
  Require(result.primary=0)

  FOR cycle=0 TO 1 DO
    benchmark=Launch(BYTE POINTER(c"SYS:C/G4BENCH.APP"))
    ready=cycle+1
    Require(PROCESS.Wait(benchmark,@result)<>0)
    Require(result.primary=0)
    benchmark=0
    completed==+1
    IF cycle=0 THEN
      baseline=EXEC.AvailMem(0)
    ELSE
      Require(EXEC.AvailMem(0)=baseline)
    FI
  OD

  DOS.SelectInput(oldInput)
  DOS.SelectOutput(oldOutput)
  Require(DOS.Close(input)<>0)
  Require(DOS.Close(output)<>0)
  Require(DOS.ReleaseContext()<>0)
  LET service=AESSTATE.Get()
  Require(service.count=0 AND AESCORE.Idle(service)<>0)

RETURN
ENDMODULE
