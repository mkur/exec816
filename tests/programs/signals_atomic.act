; tc_SigRecvd begins at $04:FFFF: exercise a word and full mask across banks.
; Probe 9 posts bit 31 while the bit-0 wake is detached and still claimed.
MODULE SIGNALATOMIC
USE EXEC
USE EXECTASKS
USE EXECLISTS
USE EXECSIGNALIRQ
USE PRODUCERPROBE
USE TASKSTACKS
EXEC.Task POINTER worker,parent
VOLATILE BYTE mask=$10,irqen=$d20e,skctl=$d20f,skshadow=$232
VOLATILE BYTE freq3=$d204,vol3=$d205,freq4=$d206,vol4=$d207,audctl=$d208,
    stimer=$d209,skreset=$d20a,serout=$d20d
VOLATILE BYTE finished
CARD ARRAY checks(4)
LONGCARD ARRAY values(6)
BYTE oldsk
PROC POINTER missing()
INCLUDE "tasks_exec_helpers.inc"

; Keep signal fields spanning a bank boundary observable during concurrent
; updates.
PROC AtomicWorker()

  checks(0)=CARD(EXEC.AllocSignal(31))
  values(0)=EXEC.SetSignal(LONGCARD($80010001),LONGCARD($ffffffff))
  values(1)=EXEC.SetSignal(LONGCARD($40000002),LONGCARD($c0000003))
  values(2)=EXEC.Wait(LONGCARD($40010000))
  values(3)=EXEC.SetSignal(0,0)
  checks(1)=CARD(PRODUCERPROBE.Bind(worker,1))
  values(4)=EXEC.Wait(LONGCARD($80000001))
  values(5)=EXEC.SetSignal(0,0)
  checks(2)=CARD(worker.tc_SigWait=0)
  PRODUCERPROBE.Release()
  skshadow=oldsk
  skctl=oldsk
  audctl=0
  finished=1

RETURN

; Exercise full-width signal updates and wake claims across bank boundaries.
PROC Main()
  EXEC.Task POINTER item
  CARD status

  worker=EXEC.Task POINTER($04ffe7)
  parent=EXEC.FindTask(BYTE POINTER(0))
  oldsk=skshadow
  PrepareTask(worker,TASKSTACKS.LOWER1,BYTE POINTER(0))
  item=EXEC.AddTask(worker,@AtomicWorker,missing)
  WHILE worker.tc_State<>EXEC.TS_WAIT DO
    status=EXECTASKS.Sleep(1)
  OD

  skctl=0
  freq3=0
  vol3=0
  freq4=0
  vol4=0
  audctl=$28
  skshadow=$23
  skctl=$23
  skreset=$23
  stimer=$23
  mask=mask % $10
  irqen=mask
  serout=$5a
  WHILE finished=0 DO
  OD

  AwaitRemoval(worker)
  checks(3)=CARD(worker.tc_ExecPrivate=0)

RETURN

ENDMODULE
