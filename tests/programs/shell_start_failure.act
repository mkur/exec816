MODULE SHELLSTARTFAILURE
USE DOSCORE
USE HEAPCORE
INCLUDE "../../examples/shell/shell-session.inc"

ShellContext context
CARD checks
BYTE finished

; Fail immediately when an observed result violates the fixture contract.
PROC Check(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($e700+checks)
  FI

  checks==+1

RETURN

; Exercise shell startup cleanup after injected failure.
PROC Main()
  LONGCARD before
  DOSCORE.DosSlot POINTER owner

  before=EXEC.AvailMem(0)
  Check(ShellStart(@context,shellRoot)=0)
  Check(context.shell<>ShellState POINTER(0) AND context.shell.status=20
      AND context.shell.error=DOS.ERROR_DEVICE_NOT_MOUNTED)
  Check(ShellFinish(@context)=20 AND context.shell=ShellState POINTER(0))
  owner=DOSCORE.Current()
  Check(owner.context=BYTE POINTER(0) AND owner.objects=BYTE POINTER(0))
  Check(EXEC.AvailMem(0)=before)
  finished=1

RETURN

ENDMODULE
