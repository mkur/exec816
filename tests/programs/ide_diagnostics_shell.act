MODULE IDEDIAGNOSTICSSHELL
USE SHELLDIAGPROBE
USE FSBOOT
USE HEAPCORE
INCLUDE "../../examples/shell/shell-session.inc"
INCLUDE "../../examples/shell/shell-boot.inc"

ShellContext context

CARD checks
LONGINT expectedError
BYTE bootMode

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($f900+checks)
  FI

  checks==+1

RETURN

; Exercise the shared boot/interactive renderer on actual failed ATA mounts.
PROC Main()

  LET before=EXEC.AvailMem(0)
  IF bootMode<>0 THEN
    SHELLDIAGPROBE.watchBoot=1
    Require(ShellBootStart(@context,shellCon)<>0)
    SHELLDIAGPROBE.watchBoot=0
    Require(SHELLDIAGPROBE.seenIde<>0 AND SHELLDIAGPROBE.seenMount<>0)
  ELSE
    Require(ShellStart(@context,NULL)<>0)
  FI

  LET lock=DOS.Lock(BYTE POINTER(c"IDE:"),DOS.SHARED_LOCK)
  LET error=DOS.IoErr()
  IF expectedError=0 THEN
    Require(lock<>NULL)
    DOS.UnLock(lock)
  ELSE
    Require(lock=NULL AND error=expectedError)
    context.shell.status=PROCESS.RETURN_ERROR
    context.shell.error=error
    ShellMountFailure(@context,context.shell.console)
    ShellIdeDiagnostics(@context,context.shell.console,1)
    Require(DOS.IoErr()=error AND context.shell.error=error)
  FI

  LET result=ShellFinish(@context)
  IF bootMode=0 THEN
    Require(result=PROCESS.RETURN_ERROR)
  FI

  Require(FSBOOT.Stop()<>0)
  IDEPLUSDRIVER.Stop()
  Require(EXEC.AvailMem(0)=before)

RETURN
ENDMODULE
