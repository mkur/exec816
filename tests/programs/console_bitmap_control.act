MODULE BITMAPCONTROL
USE EXEC
USE CONSOLE
USE CONSOLECORE
USE CONSOLEDRIVER
USE CONSOLEWINDOWS
USE CONSOLETILING
USE CONSOLEINPUT
USE BITMAPCONTROLPROBE
USE CONSOLETYPES
USE HEAPCORE
CARD checks,checkpoint,gate
BYTE variant
EXEC.MsgPort POINTER port
EXEC.IOStdReq POINTER owner,read,write
BYTE ARRAY name=[99 111 110 115 111 108 101 46 100 101 118 105 99 101 0]
BYTE ARRAY text(512),input(4)

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($f780+checks)
  FI

  checks==+1

RETURN

PROC Main()
  CARD index,row

  port=EXEC.CreateMsgPort()
  owner=EXEC.IOStdReq POINTER(EXEC.CreateIORequest(port,EXEC.IOSTDREQ_SIZE))
  read=EXEC.IOStdReq POINTER(EXEC.CreateIORequest(port,EXEC.IOSTDREQ_SIZE))
  write=EXEC.IOStdReq POINTER(EXEC.CreateIORequest(port,EXEC.IOSTDREQ_SIZE))
  Require(port<>NULL AND owner<>NULL AND read<>NULL AND write<>NULL)
  Require(EXEC.OpenDevice(name,0,EXEC.IORequest POINTER(owner),0)=0)
  LET instance=CONSOLETYPES.Instance POINTER(owner.io_Unit)
  IF 1=1 THEN
    owner.io_Command=EXEC.CMD_WRITE
    owner.io_Data=text
    FOR row=0 TO 29 DO
      FOR index=0 TO 79 DO
        text(index)=65+BYTE(row MOD 26)
      OD

      owner.io_Length=80
      IF row=29 THEN
        owner.io_Length=79
      FI

      Require(EXEC.DoIO(EXEC.IORequest POINTER(owner))=0)
    OD
  FI

  WHILE instance.dirtyRows<>0 DO
    EXEC.Yield()
  OD

  read.io_Device=owner.io_Device
  read.io_Unit=owner.io_Unit
  read.io_Command=EXEC.CMD_READ
  read.io_Data=input
  read.io_Length=4
  EXEC.SendIO(EXEC.IORequest POINTER(read))
  WHILE instance.readReady<>2 DO
    EXEC.Yield()
  OD

  FOR index=0 TO 511 DO
    text(index)=65+BYTE(index & 15)
  OD

  BITMAPCONTROLPROBE.hold=1

  write.io_Device=owner.io_Device
  write.io_Unit=owner.io_Unit
  write.io_Command=EXEC.CMD_WRITE
  write.io_Data=text
  write.io_Length=512
  EXEC.SendIO(EXEC.IORequest POINTER(write))
  LET entry=CONSOLEWINDOWS.Find(0)
  LET view=CONSOLETYPES.Presentation POINTER(entry.view)
  WHILE view.scrollState=0 DO
    EXEC.Yield()
  OD

  Require(write.io_Actual=1 AND view.scrollRow=0)
  ; Read service progresses while later model writes are deferred.
  EXEC.Forbid()
  CONSOLEINPUT.Deliver(instance,$0001003f)
  LET service=CONSOLEDRIVER.GetService()
  EXEC.Signal(@service.task,$40000000)
  EXEC.Permit()
  Require(EXEC.WaitIO(EXEC.IORequest POINTER(read))=0)
  Require(read.io_Actual=1 AND input(0)=97 AND view.scrollState<>0)
  EXEC.AbortIO(EXEC.IORequest POINTER(write))
  IF variant=1 THEN
    Require(CONSOLE.Hide(0)<>0 AND view.scrollState=0)
    Require(CONSOLE.Show(0,0,0)<>0)
  ELSEIF variant>=2 THEN
    Require(CONSOLETILING.Lock()<>0)
    IF variant=2 THEN
      view.generation==+1
    ELSEIF variant=3 THEN
      view.scrollUnit==+4
    ELSE
      CONSOLECORE.Dirty(instance,0,instance.count)
    FI

    CONSOLETILING.Unlock()
  FI

  BITMAPCONTROLPROBE.hold=0
  Require(EXEC.WaitIO(EXEC.IORequest POINTER(write))=EXEC.IOERR_ABORTED)
  Require(write.io_Actual=1 AND instance.row=29 AND instance.column=0)
  WHILE view.scrollState<>0 OR instance.dirtyRows<>0 DO
    EXEC.Yield()
  OD

  checkpoint=1
  WHILE gate=0 DO
    EXEC.Yield()
  OD

  read.io_Device=NULL
  read.io_Unit=NULL
  write.io_Device=NULL
  write.io_Unit=NULL
  EXEC.CloseDevice(EXEC.IORequest POINTER(owner))
  EXEC.DeleteIORequest(EXEC.IORequest POINTER(read))
  EXEC.DeleteIORequest(EXEC.IORequest POINTER(write))
  EXEC.DeleteIORequest(EXEC.IORequest POINTER(owner))
  EXEC.DeleteMsgPort(port)

RETURN

ENDMODULE
