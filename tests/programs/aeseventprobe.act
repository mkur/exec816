; Diagnostic clock boundaries; real timer I/O still performs every read.
MODULE AESEVENTPROBE
USE EXEC
USE AESSTATE
USE AESTYPES

PUBLIC BYTE mode,accepted,frozen,four
PUBLIC CARD sends
PUBLIC LONGCARD ARRAY deadlines(12)
LONGCARD frozenHigh,frozenLow
BYTE reads

PUBLIC PROC Clock(AESSTATE.Service POINTER service)

  IF mode=1 OR mode=2 THEN
    IF reads=0 THEN
      service.timer.nowHigh=IF mode=1 THEN $12345678 ELSE LONGCARD(7) FI
      service.timer.nowLow=IF mode=1 THEN $fffffff0 ELSE $fffffffe FI
      reads=1
    ELSE
      service.timer.nowHigh=IF mode=1 THEN $12345679 ELSE LONGCARD(8) FI
      service.timer.nowLow=$ffffffff
      reads=0
    FI
  ELSEIF mode=3 THEN
    service.timer.nowHigh=$ffffffff
    service.timer.nowLow=$fffffffe
  ELSEIF mode=4 OR (mode=7 AND accepted=4) THEN
    service.timer.error=AESTYPES.TIMER_ERROR
  FI

RETURN

PUBLIC PROC Accept(AESSTATE.Service POINTER service)

  IF mode=6 THEN
    IF frozen=0 THEN
      frozenHigh=service.timer.nowHigh
      frozenLow=service.timer.nowLow
      frozen=1
    FI

    service.timer.nowHigh=frozenHigh
    service.timer.nowLow=frozenLow
  FI

RETURN

PUBLIC PROC Converted(AESSTATE.Client POINTER client
    AESTYPES.Request POINTER request)
  BYTE slot

  IF mode=1 OR mode=2 THEN
    slot=mode-1
  ELSEIF mode=6 THEN
    slot=BYTE(request.intin(1))+2
  ELSEIF mode=7 THEN
    accepted==+1
    RETURN
  ELSE
    RETURN
  FI

  deadlines(CARD(slot)*2)=client.deadlineHigh
  deadlines(CARD(slot)*2+1)=client.deadlineLow

RETURN

PUBLIC PROC Pending(AESSTATE.Service POINTER service)
  BYTE index,count

  count=0
  FOR index=0 TO AESTYPES.CLIENTS-1 DO
    IF service.clients(index).waiting<>NULL
        AND (service.clients(index).eventMask & AESTYPES.MU_TIMER)<>0 THEN
      count==+1
    FI
  OD

  IF count=4 THEN
    four=1
  FI

RETURN
ENDMODULE
