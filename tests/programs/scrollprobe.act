; Fixture-only observation at the ordinary writer's model-consumption boundary.
MODULE SCROLLPROBE
USE CONSOLETYPES
USE CONSOLEBITMAP
USE DESKSTATE
USE LAYERS

PUBLIC BYTE enabled
PUBLIC CARD feeds,overtakes
PUBLIC CARD batches,multirow,maxRows
PUBLIC BYTE armFragment,holdFragment,fragmentHeld
PUBLIC BYTE failFragment

PUBLIC PROC BeforePresent()
  BYTE okay

  IF failFragment<>0 AND CONSOLEBITMAP.Pending()=0 THEN
    failFragment=0
    ; Quiesced drawing error from another primitive between text fragments.
    okay=CONSOLEBITMAP.RawFill(640,0,8,8,0)
  FI

RETURN

PUBLIC PROC Presented()
  BYTE pending

  pending=CONSOLEBITMAP.TextPending()
  LET desktop=DESKSTATE.Get()
  IF desktop<>NULL THEN
    BEGIN
      LET layer=LAYERS.Find(@desktop.scene,DESKSTATE.Selected())
      pending=pending<>0 OR layer.dirty<>0
    END
  FI
  IF armFragment<>0 AND pending<>0 THEN
    armFragment=0
    holdFragment=1
    fragmentHeld=1
  FI

RETURN

PUBLIC PROC Batch(CARD rows)

  IF enabled<>0 AND rows<>0 THEN
    batches==+1
    IF rows>1 THEN
      multirow==+1
    FI

    IF rows>maxRows THEN
      maxRows=rows
    FI
  FI

RETURN

PUBLIC PROC Feed(CONSOLETYPES.Instance POINTER instance)

  IF enabled<>0 THEN
    feeds==+1
    ; A short bottom-row write can leave one fresh span. Multiple dirty rows
    ; here mean a new write is overtaking an unfinished scroll repaint.
    IF instance.dirtyRows>1 THEN
      overtakes==+1
    FI
  FI

RETURN

ENDMODULE
