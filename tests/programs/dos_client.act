MODULE DOSCLIENTTEST
USE EXEC
USE EXECLISTS
USE EXECTASKS
USE TASKSTACKS
USE DOS
USE DOSCLIENT
USE DOSCORE
USE HEAPCORE
INCLUDE "../../lib/dos/dos-packets.inc"
EXEC.Task worker,other
EXEC.Task POINTER root
EXEC.MsgPort POINTER handler,unrelated
EXEC.Message unrelatedMessage
VOLATILE BYTE ready,finished,stop
VOLATILE CARD replies
CARD checks
PROC POINTER absent()
LONGCARD freeStart

; Stop at the first failed fixture invariant and retain its check index for
; diagnosis.
PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($f800+(checks & 255))
  FI

  checks==+1

RETURN

; Establish the fixture Task's stack and list metadata before admission.
PROC InitTask(EXEC.Task POINTER task BYTE slot)

  task.tc_Node.ln_Type=EXEC.NT_TASK
  task.tc_State=0
  task.tc_Flags=0
  task.tc_IDNestCnt=$ff
  task.tc_TDNestCnt=$ff
  task.tc_SigAlloc=0
  task.tc_SigWait=0
  task.tc_SigRecvd=0
  task.tc_SigExcept=0
  task.tc_ExecPrivate=ADDRESS(0)
  task.tc_UserData=ADDRESS($abcdef)
  task.tc_SPLower=ADDRESS(TASKSTACKS.StackLower(slot))
  task.tc_SPUpper=ADDRESS(TASKSTACKS.StackUpper(slot))
  task.tc_SPReg=task.tc_SPUpper-SIZE(2)
  EXECLISTS.NewList(@task.tc_MemEntry)

RETURN

PROC HandlerEntry()
  EXEC.Message POINTER message
  StandardPacket POINTER packet
  CARD status

  handler=EXEC.CreateMsgPort()
  Require(handler<>EXEC.MsgPort POINTER(0))
  ready=1
  DO
    message=EXEC.WaitPort(handler)
    message=EXEC.GetMsg(handler)
    packet=StandardPacket POINTER(message)
    IF packet.sp_Pkt.dp_Type=999 THEN
      packet.sp_Pkt.dp_Res1=-1
      packet.sp_Pkt.dp_Res2=0
      EXEC.ReplyMsg(message)
      EXIT
    FI

    IF packet.sp_Pkt.dp_Arg2<>0 THEN
      status=EXECTASKS.Sleep(1)
    FI

    packet.sp_Pkt.dp_Res1=packet.sp_Pkt.dp_Arg1
    packet.sp_Pkt.dp_Res2=packet.sp_Pkt.dp_Arg3
    replies==+1
    EXEC.ReplyMsg(message)
  ; Never access this packet after replying: client may already reuse it.
  OD

  EXEC.DeleteMsgPort(handler)
  handler=EXEC.MsgPort POINTER(0)

RETURN

PROC Round(DOSCLIENT.ClientContext POINTER client CARD identity BYTE delay)
  LONGINT result
  CARD status

  client.packet.sp_Pkt.dp_Arg1=LONGINT(identity)+70000
  client.packet.sp_Pkt.dp_Arg2=LONGINT(delay)
  client.packet.sp_Pkt.dp_Arg3=LONGINT(identity)
  EXEC.Signal(EXEC.FindTask(BYTE POINTER(0)),LONGCARD(1) LSH client.port.mp_SigBit)
  result=DOSCLIENT.Call(DOSCORE.Current(),client,handler,82)
  Require(result=LONGINT(identity)+70000 AND DOS.IoErr()=LONGINT(identity))
  status=EXECTASKS.Sleep(1)
  Require(DOS.IoErr()=LONGINT(identity))

RETURN

PROC FinishCaller(DOSCLIENT.ClientContext POINTER client CARD identity)
  LONGINT result

  client.objects=1
  Require(DOS.ReleaseContext()=0 AND DOS.IoErr()=DOS.ERROR_OBJECT_IN_USE)
  client.objects=0
  client.busy=1
  Require(DOS.ReleaseContext()=0)
  Require(DOSCLIENT.Ensure()=DOSCLIENT.ClientContext POINTER(0))
  client.busy=0
  DOSCLIENT.SetError(LONGINT(identity))
  client.packet.sp_Pkt.dp_Arg1=-1
  client.packet.sp_Pkt.dp_Arg3=0
  result=DOSCLIENT.Call(DOSCORE.Current(),client,handler,1007)
  Require(result=-1 AND DOS.IoErr()=LONGINT(identity))
  Require(DOS.ReleaseContext()=-1 AND DOS.IoErr()=LONGINT(identity))
  Require(DOS.ReleaseContext()=-1)

RETURN

PROC Caller(CARD identity)
  DOSCLIENT.ClientContext POINTER client
  CARD i

  Require(DOS.IoErr()=0)
  client=DOSCLIENT.Ensure()
  Require(client<>DOSCLIENT.ClientContext POINTER(0))
  FOR i=0 TO 7 DO
    Round(client,identity,BYTE(i & 1))
  OD

  FinishCaller(client,identity)

RETURN

PROC OtherEntry()

  Caller(202)
  Require(other.tc_UserData=ADDRESS($abcdef))
  finished=1

RETURN

; Exercise message-based DOS calls from independent clients.
PROC Main()
  DOSCLIENT.ClientContext POINTER client
  EXEC.Message POINTER message
  CARD status
  LONGINT result

  root=EXEC.FindTask(BYTE POINTER(0))
  freeStart=EXEC.AvailMem(EXEC.MEMF_UPPER)
  InitTask(@worker,1)
  Require(EXEC.AddTask(@worker,@HandlerEntry,absent)=@worker)
  WHILE ready=0 DO
    status=EXECTASKS.Sleep(1)
  OD

  unrelated=EXEC.CreateMsgPort()
  Require(unrelated<>EXEC.MsgPort POINTER(0))
  unrelatedMessage.mn_ReplyPort=unrelated
  unrelatedMessage.mn_Length=16
  EXEC.PutMsg(unrelated,@unrelatedMessage)
  InitTask(@other,2)
  Require(EXEC.AddTask(@other,@OtherEntry,absent)=@other)
  Caller(101)
  WHILE finished=0 OR other.tc_State<>EXEC.TS_REMOVED DO
    status=EXECTASKS.Sleep(1)
  OD

  Require(EXEC.GetMsg(unrelated)=@unrelatedMessage)
  EXEC.DeleteMsgPort(unrelated)
  client=DOSCLIENT.Ensure()
  Require(client<>DOSCLIENT.ClientContext POINTER(0))
  result=DOSCLIENT.Call(DOSCORE.Current(),client,handler,999)
  Require(result=-1)
  Require(DOS.ReleaseContext()=-1)
  WHILE worker.tc_State<>EXEC.TS_REMOVED DO
    status=EXECTASKS.Sleep(1)
  OD

  Require(replies=18 AND EXEC.AvailMem(EXEC.MEMF_UPPER)=freeStart)

RETURN

ENDMODULE
