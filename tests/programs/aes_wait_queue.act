MODULE WAITERTEST
USE EXEC
USE AESSTATE
USE AESWAIT
USE DESKTYPES
USE AESTYPES
USE HEAPCORE
CARD checks
PUBLIC LONGCARD ARRAY offsets(12)
AESTYPES.Request ARRAY requests(4)

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($fc40+checks)
  FI
  checks==+1

RETURN

PROC Main()
  BYTE slot

  LET service=AESSTATE.Service POINTER(EXEC.AllocMem(SIZEOF(AESSTATE.Service),
      EXEC.MEMF_PUBLIC OR EXEC.MEMF_CLEAR))
  Require(service<>NULL)
  LET client=@service.clients(0)
  offsets(0)=LONGCARD(ADDRESS(@service.clients(0))-ADDRESS(service))
  offsets(1)=LONGCARD(ADDRESS(@service.windows(0))-ADDRESS(service))
  offsets(2)=LONGCARD(ADDRESS(@service.updateResource)-ADDRESS(service))
  offsets(3)=LONGCARD(ADDRESS(@service.updateOwner)-ADDRESS(service))
  offsets(4)=LONGCARD(ADDRESS(@service.mouseOwner)-ADDRESS(service))
  offsets(5)=LONGCARD(ADDRESS(@service.pointerEvents)-ADDRESS(service))
  offsets(6)=LONGCARD(ADDRESS(@client.pending)-ADDRESS(client))
  offsets(7)=LONGCARD(ADDRESS(@client.windowWaiting)-ADDRESS(client))
  offsets(8)=LONGCARD(ADDRESS(@client.waitMode)-ADDRESS(client))
  offsets(9)=LONGCARD(SIZEOF(DESKTYPES.Window POINTER))
  offsets(10)=LONGCARD(ADDRESS(@service.windowPending)-ADDRESS(service))
  offsets(11)=LONGCARD(ADDRESS(@service.updateHint)-ADDRESS(service))

  AESWAIT.Window(service,@service.clients(0),@requests(0))
  Require(service.windowPending=1 AND service.clients(0).pending=@requests(0))
  AESWAIT.Window(service,@service.clients(0),@requests(1))
  Require(service.windowPending=1 AND service.clients(0).pending=@requests(1))
  AESWAIT.Window(service,@service.clients(1),@requests(1))
  Require(service.windowPending=2)
  AESWAIT.RemoveWindow(service,@service.clients(0))
  Require(service.windowPending=1 AND service.clients(0).windowWaiting=0)
  AESWAIT.RemoveWindow(service,@service.clients(0))
  Require(service.windowPending=1)
  AESWAIT.RemoveWindow(service,@service.clients(1))
  Require(service.windowPending=0)
  Require(SIZEOF(AESSTATE.Client)=374)
  Require(SIZEOF(AESSTATE.Service)=2510)
  Require(SIZEOF(EXEC.SignalSemaphore)=12 AND offsets(9)=3 AND (offsets(2) & 1)=0)
  EXEC.InitSemaphore(@service.updateResource)
  Require(EXEC.AttemptSemaphore(@service.updateResource)<>0)
  Require(EXEC.AttemptSemaphore(@service.updateResource)<>0)
  EXEC.ReleaseSemaphore(@service.updateResource)
  EXEC.ReleaseSemaphore(@service.updateResource)
  Require(EXEC.AttemptSemaphore(@service.updateResource)<>0)
  EXEC.ReleaseSemaphore(@service.updateResource)
  FOR slot=0 TO AESTYPES.CLIENTS-1 DO
    AESWAIT.Window(service,@service.clients(slot),@requests(slot))
    Require(service.windowPending=slot+1)
  OD
  FOR slot=0 TO AESTYPES.CLIENTS-1 DO
    AESWAIT.RemoveWindow(service,@service.clients(slot))
  OD
  Require(service.windowPending=0)
  Require(service.clients(0).windowWaiting=0 AND service.clients(1).windowWaiting=0
      AND service.clients(2).windowWaiting=0 AND service.clients(3).windowWaiting=0)
  EXEC.FreeMem(BYTE POINTER(service),SIZEOF(AESSTATE.Service))

RETURN
ENDMODULE
