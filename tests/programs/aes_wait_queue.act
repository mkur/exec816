MODULE WAITERTEST
USE EXEC
USE AESSTATE
USE AESWAIT
USE DESKTYPES
USE AESTYPES
USE HEAPCORE
CARD checks
PUBLIC LONGCARD ARRAY offsets(12)
AESTYPES.Request ARRAY requests(4)

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($fc40+checks)
  FI
  checks==+1

RETURN

PROC Main()

  LET service=AESSTATE.Service POINTER(EXEC.AllocMem(SIZEOF(AESSTATE.Service),
      EXEC.MEMF_PUBLIC OR EXEC.MEMF_CLEAR))
  Require(service<>NULL)
  LET client=@service.clients(0)
  offsets(0)=LONGCARD(ADDRESS(@service.clients(0))-ADDRESS(service))
  offsets(1)=LONGCARD(ADDRESS(@service.windows(0))-ADDRESS(service))
  offsets(2)=LONGCARD(ADDRESS(@service.lockCount)-ADDRESS(service))
  offsets(3)=LONGCARD(ADDRESS(@service.updateOwner)-ADDRESS(service))
  offsets(4)=LONGCARD(ADDRESS(@service.mouseOwner)-ADDRESS(service))
  offsets(5)=LONGCARD(ADDRESS(@service.policyGate)-ADDRESS(service))
  offsets(6)=LONGCARD(ADDRESS(@client.pending)-ADDRESS(client))
  offsets(7)=LONGCARD(ADDRESS(@client.windowWaiting)-ADDRESS(client))
  offsets(8)=LONGCARD(ADDRESS(@client.waitMode)-ADDRESS(client))
  offsets(9)=LONGCARD(SIZEOF(DESKTYPES.Window POINTER))
  offsets(10)=LONGCARD(ADDRESS(@service.windowPending)-ADDRESS(service))
  offsets(11)=LONGCARD(ADDRESS(@service.policyEffects)-ADDRESS(service))

  Require(AESWAIT.Lock(service,@service.clients(0),@requests(0))=AESTYPES.PENDING)
  Require(AESWAIT.Lock(service,@service.clients(1),@requests(1))=AESTYPES.PENDING)
  AESWAIT.Window(service,@service.clients(2),@requests(2))
  Require(service.windowPending=1 AND service.clients(2).windowLocks=2)
  Require(AESWAIT.Lock(service,@service.clients(3),@requests(3))=AESTYPES.PENDING)
  Require(AESWAIT.BeforeWindows(service,0)<>0)
  Require(AESWAIT.BeforeWindows(service,1)<>0)
  Require(AESWAIT.BeforeWindows(service,2)=0)
  ; A retry preserves its arrival prefix, including when a younger lock exists.
  AESWAIT.Window(service,@service.clients(2),@requests(2))
  Require(service.windowPending=1 AND service.clients(2).windowLocks=2)
  AESWAIT.RemoveLock(service,0)
  Require(service.lockCount=2 AND service.lockOrder(0)=1)
  Require(service.clients(2).windowLocks=1)
  Require(AESWAIT.BeforeWindows(service,0)<>0)
  Require(AESWAIT.BeforeWindows(service,1)=0)
  AESWAIT.RemoveLock(service,1)
  Require(service.clients(2).windowLocks=1)
  AESWAIT.RemoveLock(service,0)
  Require(service.clients(2).windowLocks=0)
  Require(AESWAIT.Older(service,@service.clients(2))=0)
  AESWAIT.RemoveWindow(service,@service.clients(2))
  Require(service.windowPending=0 AND service.clients(2).windowWaiting=0)
  AESWAIT.RemoveWindow(service,@service.clients(2))
  Require(service.windowPending=0)
  Require(SIZEOF(AESSTATE.Client)=138 AND SIZEOF(AESSTATE.Service)=1264 AND offsets(9)=3)
  EXEC.FreeMem(BYTE POINTER(service),SIZEOF(AESSTATE.Service))

RETURN
ENDMODULE
