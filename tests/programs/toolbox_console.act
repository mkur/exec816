MODULE TOOLBOXCONSOLE

USE EXEC
USE DOS
USE HEAPCORE
USE CONSOLE
USE CONSOLEWINDOWS
USE CONSOLEINPUT
USE CONSOLETYPES

CARD checks
BYTE finished
BYTE ARRAY name=c"CON:00000000"
BYTE ARRAY digits=c"0123456789ABCDEF"
BYTE ARRAY key(1)
CARD ARRAY size(2)

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($e780+checks)
  FI

  checks==+1

RETURN

; The session console survives redirected streams and yields an owned RAW
; wrapper for the actual nondefault instance, with no extra Task or DP.
PROC Main()
  CARD index

  LET baseline=EXEC.AvailMem(0)
  Require(DOS.OpenConsole()=NULL)
  Require(DOS.IoErr()=DOS.ERROR_OBJECT_WRONG_TYPE)
  LET unit=CONSOLE.Create(12,4)
  Require(unit<>0)
  FOR index=0 TO 7 DO
    name(index+4)=digits(BYTE((unit RSH ((7-index)*4)) & 15))
  OD

  LET session=DOS.Open(name,DOS.MODE_READWRITE)
  Require(session<>NULL)
  LET nil=DOS.Open(BYTE POINTER(c"NIL:"),DOS.MODE_READWRITE)
  Require(nil<>NULL)
  DOS.SelectInput(nil)
  DOS.SelectOutput(nil)
  Require(DOS.BeginForeground(session)<>0)
  LET control=DOS.OpenConsole()
  Require(control<>NULL AND control<>session)
  Require(DOS.IsInteractive(control)<>0)
  Require(DOS.ConsoleInfo(control,BYTE POINTER(size))<>0)
  Require(size(0)=12 AND size(1)=4)
  Require(DOS.ConsoleInfo(nil,BYTE POINTER(size))=0)
  Require(DOS.IoErr()=DOS.ERROR_OBJECT_WRONG_TYPE)
  Require(DOS.ConsoleInfo(control,NULL)=0)
  Require(DOS.IoErr()=DOS.ERROR_BAD_NUMBER)
  Require(CONSOLE.Destroy(unit)=0)
  BEGIN
    LET window=CONSOLEWINDOWS.Find(unit)
    LET instance=CONSOLETYPES.Instance POINTER(window.instance)
    EXEC.Forbid()
    CONSOLEINPUT.Deliver(instance,$0064003f)
    EXEC.Permit()
  END

  Require(DOS.Read(control,key,1)=1 AND key(0)='a)
  Require(DOS.Input()=nil AND DOS.Output()=nil)
  Require(DOS.Close(control)<>0)
  Require(DOS.ConsoleInfo(control,BYTE POINTER(size))=0)
  Require(DOS.EndForeground()<>0)
  Require(DOS.OpenConsole()=NULL)
  Require(DOS.Close(session)<>0 AND DOS.Close(nil)<>0)
  Require(DOS.ReleaseContext()<>0)
  Require(CONSOLE.Destroy(unit)<>0)
  Require(EXEC.AvailMem(0)=baseline)
  finished=1

RETURN

ENDMODULE
