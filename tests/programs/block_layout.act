MODULE BLOCKLAYOUT
USE EXEC
USE FSTYPES
USE BLOCKTYPES
USE HEAPCORE
FSTYPES.Spec spec
PUBLIC PROC Main()
  IF SIZEOF(FSTYPES.Spec)<>46 OR ADDRESS(@spec.backend)-ADDRESS(@spec)<>45
      OR BLOCKTYPES.BACKEND_SIO<>0 OR BLOCKTYPES.BACKEND_IDEPLUS<>1 THEN
    HEAPCORE.Abort($f901)
  FI
RETURN
ENDMODULE
