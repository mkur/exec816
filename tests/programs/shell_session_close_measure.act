MODULE SHELLCLOSEMEASURE
USE FSBOOT
INCLUDE "../../examples/shell/shell-session.inc"
INCLUDE "../../examples/shell/shell-boot.inc"
INCLUDE "../../examples/shell/shell-controller.inc"

BYTE variant,go,closeNow,releaseFirst,finish,phase,finished
CARD checks
LONGCARD baseline

PROC Check(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($ee00+checks)
  FI

  checks==+1

RETURN

; Inserted only in this fixture, after the ordinary initial prompt. The first
; shell runs the real dispatcher or intentionally refuses cooperative close.
PROC FixtureWork(ShellContext POINTER context)

  IF context.control.identity<>1 THEN
    RETURN
  FI

  WHILE go=0 DO
    EXEC.Yield()
  OD

  IF variant=1 THEN
    STR.strlcpy(ShellLine(context),c"CAT SYS:LONG.TXT >NIL:",LINE_CAPACITY)
    ShellCommand(context)
  ELSEIF variant=2 THEN
    STR.strlcpy(ShellLine(context),c"CAT SYS:LONG.TXT | WC",LINE_CAPACITY)
    ShellCommand(context)
  ELSEIF variant=3 THEN
    WHILE releaseFirst=0 DO
      EXEC.Yield()
    OD
  FI

RETURN

PROC Pump()
  LONGCARD mask

  mask=ShellControllerStep()
  IF EXEC.GetMsg(sessionReplies)<>NULL THEN
    requestBusy=0
  FI
  EXEC.Yield()

RETURN

; Passive PC markers delimit the ordinary request and observed collection.
ShellSessionMessage request
EXEC.MsgPort POINTER sessionReplies
BYTE requestBusy

PROC SessionRequest(BYTE operation LONGCARD identity)

  WHILE requestBusy<>0 DO
    Pump()
  OD
  A816MEMORY.Clear(BYTE POINTER(@request),SHELLSESSIONMESSAGE_SIZE)
  request.operation=operation
  request.payload=BYTE POINTER(c"SYS:")
  request.capacity=SESSION_PATH_BYTES
  request.message.mn_Node.ln_Type=EXEC.NT_MESSAGE
  request.message.mn_Length=SHELLSESSIONMESSAGE_SIZE
  request.session=identity
  request.message.mn_ReplyPort=sessionReplies
  requestBusy=1
  EXEC.PutMsg(shellRequests,@request.message)

RETURN

PROC CloseRequest()

  SessionRequest(SESSION_CLOSE,1)

RETURN

PROC CloseRetired()

  Check(controllerLive=1 AND sessions(0).process=0)
  Check(contexts(0).shell=NULL AND selectedSession=2)
  phase=3

RETURN

PROC Main()

  baseline=EXEC.AvailMem(0)
  sessionReplies=EXEC.CreateMsgPort()
  Check(sessionReplies<>NULL)
  Check(ShellControllerStart(0)<>0)
  WHILE sessions(0).ready=0 DO
    Pump()
  OD

  SessionRequest(SESSION_CREATE,0)
  WHILE controllerLive<>2 OR sessions(1).ready=0 OR requestBusy<>0 DO
    Pump()
  OD

  SessionRequest(SESSION_SELECT,1)
  WHILE selectedSession<>1 OR requestBusy<>0 DO
    Pump()
  OD

  phase=1
  WHILE closeNow=0 DO
    Pump()
  OD

  CloseRequest()
  phase=2
  WHILE controllerLive<>1 DO
    Pump()
  OD

  CloseRetired()
  WHILE finish=0 DO
    Pump()
  OD

  SessionRequest(SESSION_CLOSE,2)
  WHILE controllerLive<>0 DO
    Pump()
  OD

  Check(DOS.AssignPath(BYTE POINTER(c"C"),NULL)<>0)
  Check(DOS.AssignPath(BYTE POINTER(c"S"),NULL)<>0)
  ShellControllerStop()
  Check(FSBOOT.Stop()<>0)
  WHILE requestBusy<>0 DO
    Pump()
  OD
  EXEC.DeleteMsgPort(sessionReplies)
  Check(EXEC.AvailMem(0)=baseline)
  finished=1

RETURN
ENDMODULE
