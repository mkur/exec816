MODULE BITMAPTEST
USE EXEC
USE EXECTASKS
USE HEAPCORE
USE DOS
USE CONSOLE
USE CONSOLECORE
USE CONSOLEDRIVER
USE CONSOLETYPES
USE CONSOLEINPUT
USE CONSOLEWINDOWS
CARD checks,checkpoint,gate
BYTE ARRAY rawName=[82 65 87 58 0]
BYTE ARRAY cookedName=[67 79 78 58 0]
BYTE ARRAY text(80),input(4)

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($f740+checks)
  FI

  checks==+1

RETURN

PROC Settled(BYTE unused)

  LET instance=CONSOLEDRIVER.GetInstance()
  WHILE instance.dirtyRows<>0 DO
    EXEC.Yield()
  OD

RETURN

; Passive trace boundaries separate drawing from settled idle frames.
PROC Ready(CARD value)

  checkpoint=value

RETURN

PROC Continuing()

RETURN

PROC Pause(CARD value)
  CARD ignored

  Settled(0)
  ignored=EXECTASKS.Sleep(2)
  Ready(value)
  WHILE gate<value DO
    EXEC.Yield()
  OD

  Continuing()

RETURN

; Short echo completion follows one presentation pass on this settled view.
PROC Echo(DOS.FileHandle POINTER file CARD count)

  Require(DOS.Write(file,text,count)=LONGINT(count))
  LET instance=CONSOLEDRIVER.GetInstance()
  LET entry=CONSOLEWINDOWS.Find(0)
  LET view=CONSOLETYPES.Presentation POINTER(entry.view)
  Require(instance.dirtyRows=0 AND view.cursorOn<>0
      AND view.previousCursor=instance.lineStart+instance.column)

RETURN

PROC Main()
  DOS.FileHandle POINTER file
  CARD row,column

  Require(CONSOLE.ScreenWidth()=80 AND CONSOLE.ScreenHeight()=30)
  file=DOS.Open(rawName,DOS.MODE_READWRITE)
  Require(file<>NULL)
  ; Twenty-nine dense rows followed by a partial row avoid final wrap-scroll.
  FOR row=0 TO 29 DO
    FOR column=0 TO 79 DO
      text(column)=BYTE(33+(row*7+column) MOD 90)
    OD

    IF row=29 THEN
      Require(DOS.Write(file,text,79)=79)
    ELSE
      Require(DOS.Write(file,text,80)=80)
    FI
  OD

  Pause(1)
  Require(CONSOLE.Hide(0)<>0)
  Pause(2)
  Require(CONSOLE.Show(0,0,0)<>0)
  Pause(3)
  text(0)=12
  Require(DOS.Write(file,text,1)=1)
  Pause(4)

  ; Opaque text erases the old caret without a separate restore.
  text(0)='A
  text(1)='B
  Echo(file,2)
  Pause(5)

  ; Cursor-only movement still restores the old cell.
  text(0)=8
  Echo(file,1)
  Pause(6)

  ; Dirty text outside the old caret does not erase it.
  text(0)=13
  text(1)='Z
  Echo(file,2)
  Pause(7)

  ; Overwrite a nonblank cell under the old caret.
  text(0)='C
  Echo(file,1)
  Pause(8)

  LET instance=CONSOLEDRIVER.GetInstance()
  EXEC.Forbid()
  CONSOLEINPUT.Deliver(instance,$0001003f)
  EXEC.Permit()
  Require(DOS.Read(file,input,4)=1 AND input(0)=97)
  Require(DOS.Close(file)<>0)

  ; Physical keys exercise cooked append/delete echo through this backend.
  file=DOS.Open(cookedName,DOS.MODE_READWRITE)
  Require(file<>NULL)
  Require(DOS.Read(file,input,4)=4 AND input(0)='a AND input(1)='b
      AND input(2)='d AND input(3)=10)
  Pause(9)
  Require(DOS.Close(file)<>0 AND DOS.ReleaseContext()<>0)

RETURN

ENDMODULE
