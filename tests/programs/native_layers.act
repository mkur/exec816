MODULE NATIVELAYERS
USE EXEC
USE HEAPCORE
USE A816MEMORY
USE LAYERTYPES
USE REGIONS
USE LAYERS

CARD checks,geometryCases
LAYERTYPES.Region POINTER first,second
LAYERTYPES.Scene POINTER scene
LONGCARD ARRAY handles(8)
CARD sceneCases,sceneSize,scenePhase
CARD paints,copies,redraws
CARD maxRects,maxPaintRects
BYTE POINTER model,canvas

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($fa00+(checks & 255))
  FI

  checks==+1

RETURN

BYTE POINTER FUNC Guarded(CARD bytes)
  BYTE POINTER buffer

  buffer=EXEC.AllocMem(LONGCARD(bytes)+32,EXEC.MEMF_PUBLIC)
  Require(buffer<>NULL)
  A816MEMORY.Fill(buffer,$a5,SIZE(bytes)+32)

RETURN(buffer+16)

PROC FreeGuarded(BYTE POINTER buffer CARD bytes)
  CARD index
  BYTE POINTER origin

  origin=buffer-16
  FOR index=0 TO 15 DO
    Require(origin(index)=$a5 AND buffer(index+bytes)=$a5)
  OD

  EXEC.FreeMem(buffer-16,LONGCARD(bytes)+32)

RETURN

; Compact output preserves emitted rectangles for an independent host oracle.
PROC SaveRegion(LAYERTYPES.Region POINTER region BYTE POINTER output)

  Require(region.count<=4)
  A816MEMORY.Fill(output,0,34)
  A816MEMORY.Move(output,BYTE POINTER(region),SIZE(2+region.count*8))

RETURN

PROC Geometry()
  CARD index,count
  BYTE POINTER input,output
  LAYERTYPES.Rect POINTER base,cut,clip

  Require(SIZEOF(LAYERTYPES.Rect)=LAYERTYPES.RECT_SIZE)
  Require(SIZEOF(LAYERTYPES.Region)=LAYERTYPES.REGION_SIZE)
  count=CARD POINTER($d0000)^
  input=BYTE POINTER($d0002)
  output=BYTE POINTER($e0010)
  index=0
  WHILE index<count DO
    base=LAYERTYPES.Rect POINTER(input)
    cut=LAYERTYPES.Rect POINTER(input+8)
    clip=LAYERTYPES.Rect POINTER(input+16)
    Require(REGIONS.Valid(base)<>0 AND REGIONS.Valid(cut)<>0)
    Require(REGIONS.FromRect(first,base)=LAYERTYPES.OK)
    Require(REGIONS.Subtract(first,cut,second)=LAYERTYPES.OK)
    SaveRegion(second,output)
    Require(REGIONS.Clip(second,clip,first)=LAYERTYPES.OK)
    SaveRegion(first,output+34)
    geometryCases==+1
    input==+24
    output==+68
    index==+1
  OD

RETURN

; Overflow/alias failures must leave all destination bytes unchanged.
PROC RegionFailures()
  CARD index
  LAYERTYPES.Rect cut,bad,result
  BYTE POINTER bytes

  first.count=LAYERTYPES.MAX_RECTS
  FOR index=0 TO LAYERTYPES.MAX_RECTS-1 DO
    REGIONS.Assign(@first.rects(index),INT(index*4),0,INT(index*4+4),4)
  OD

  REGIONS.Assign(@cut,1,1,3,3)
  REGIONS.Assign(@bad,3,0,2,4)
  bytes=BYTE POINTER(second)
  A816MEMORY.Fill(bytes,$a5,LAYERTYPES.REGION_SIZE)
  Require(REGIONS.Subtract(first,@cut,second)=LAYERTYPES.FULL)
  Require(REGIONS.FromRect(second,@bad)=LAYERTYPES.BAD_ARGUMENT)
  Require(REGIONS.Clip(first,@bad,second)=LAYERTYPES.BAD_ARGUMENT)
  FOR index=0 TO LAYERTYPES.REGION_SIZE-1 DO
    Require(bytes(index)=$a5)
  OD

  Require(REGIONS.Subtract(first,@cut,first)=LAYERTYPES.BAD_ARGUMENT)
  Require(REGIONS.Clip(first,@cut,
      LAYERTYPES.Region POINTER(BYTE POINTER(first)+2))=LAYERTYPES.BAD_ARGUMENT)
  Require(first.count=LAYERTYPES.MAX_RECTS)
  first.count=LAYERTYPES.MAX_RECTS+1
  Require(REGIONS.Subtract(first,@cut,second)=LAYERTYPES.BAD_ARGUMENT)
  Require(REGIONS.Clip(first,@cut,second)=LAYERTYPES.BAD_ARGUMENT)
  Require(REGIONS.FromRect(NULL,@cut)=LAYERTYPES.BAD_ARGUMENT)
  Require(REGIONS.FromRect(second,NULL)=LAYERTYPES.BAD_ARGUMENT)
  REGIONS.Assign(@result,2,2,4,4)
  REGIONS.Intersect(@cut,@result,@cut)
  Require(cut.left=2 AND cut.top=2 AND cut.right=3 AND cut.bottom=3)

RETURN

PROC ExhaustPaint(LAYERTYPES.Scene POINTER state LONGCARD token)
  BYTE status

  DO
    status=LAYERS.AdvancePaint(state,token)
    IF status<>LAYERTYPES.OK THEN
      EXIT
    FI
  OD

  Require(status=LAYERTYPES.EMPTY)

RETURN

INCLUDE "layers-paint.inc"

; Paint the cached partition into an observer buffer, checking that every
; screen pixel has exactly one owner and that queries leave the cache alone.
PROC Snapshot(BYTE POINTER output)
  BYTE slot
  CARD index,x,y,offset
  LAYERTYPES.Layer POINTER layer
  LAYERTYPES.Rect POINTER rect
  LONGCARD rebuilds

  rebuilds=scene.rebuilds
  LET header=LONGCARD POINTER(output)
  header^=rebuilds
  output==+4
  A816MEMORY.Fill(output,255,768)
  FOR slot=0 TO LAYERTYPES.SLOT_COUNT-1 DO
    layer=@scene.items(slot)
    Require(layer.visible.count<=81)
    IF layer.visible.count>maxRects THEN
      maxRects=layer.visible.count
    FI
    index=0
    WHILE index<layer.visible.count DO
      rect=@layer.visible.rects(index)
      Require(REGIONS.Contains(@scene.screen,rect)<>0)
      FOR y=CARD(rect.top) TO CARD(rect.bottom)-1 DO
        offset=y*32+CARD(rect.left)
        FOR x=CARD(rect.left) TO CARD(rect.right)-1 DO
          Require(output(offset)=255)
          output(offset)=BYTE(layer.id)
          offset==+1
        OD
      OD

      index==+1
    OD
  OD

  FOR index=0 TO 767 DO
    Require(output(index)<>255)
  OD

  y=0
  WHILE y<24 DO
    x=0
    WHILE x<32 DO
      Require(LAYERS.Hit(scene,INT(x),INT(y))=LONGCARD(output(y*32+x)))
      x==+4
    OD

    y==+4
  OD

  Require(LAYERS.Hit(scene,-1,0)=0 AND LAYERS.Hit(scene,32,0)=0)
  Require(scene.rebuilds=rebuilds)
  PaintScene()
  A816MEMORY.Move(output+768,canvas,768)

RETURN

; The host supplies operations and independently recomposes each full scene.
PROC Scenes()
  BYTE POINTER input,output
  BYTE op,which,status
  CARD index,count,expected
  INT a,b
  LAYERTYPES.Rect POINTER bounds

  scenePhase=1
  sceneSize=SIZEOF(LAYERTYPES.Scene)
  Require(sceneSize=LAYERTYPES.SCENE_SIZE)
  Require(LONGCARD(ADDRESS(@scene.busy))-LONGCARD(ADDRESS(scene))
      =LAYERTYPES.SCENE_BUSY)
  Require(LONGCARD(ADDRESS(@scene.items(0)))-LONGCARD(ADDRESS(scene))
      =LAYERTYPES.SCENE_ITEMS)
  Require(LONGCARD(ADDRESS(@scene.work))-LONGCARD(ADDRESS(scene))
      =LAYERTYPES.SCENE_WORK)
  scenePhase=2
  Require(LAYERS.Init(scene,32,24)=LAYERTYPES.OK)
  scenePhase=3
  count=CARD POINTER($d2000)^
  Require(count<=64)
  input=BYTE POINTER($d2002)
  output=BYTE POINTER($f0010)
  index=0
  WHILE index<count DO
    scenePhase=4
    op=input(0)
    which=input(1)
    bounds=LAYERTYPES.Rect POINTER(input+2)
    a=INT POINTER(input+2)^
    b=INT POINTER(input+4)^
    expected=CARD POINTER(input+10)^
    status=LAYERTYPES.OK
    CASE op OF
    WHEN 1 THEN
      status=LAYERS.Create(scene,bounds,@handles(which))
      IF status=LAYERTYPES.OK THEN
        CreateModel(handles(which))
      FI

    WHEN 2 THEN
      status=LAYERS.Show(scene,handles(which),BYTE(a))

    WHEN 3 THEN
      status=LAYERS.Order(scene,handles(which),BYTE(a))

    WHEN 4 THEN
      status=LAYERS.Delete(scene,handles(which))

    WHEN 5 THEN
      status=LAYERS.Move(scene,handles(which),a,b)

    WHEN 6 THEN
      ChangeModel(handles(which),bounds,80+which)

    WHEN 7 THEN
      ScrollModel(handles(which))
    ESAC

    scenePhase=5
    Require(status=expected)
    scenePhase=6
    Snapshot(output)
    sceneCases==+1
    input==+12
    output==+1540
    index==+1
  OD

RETURN

PROC SceneFailures()
  LAYERTYPES.Rect bounds
  LONGCARD id

  scenePhase=30
  ; All published fixture IDs retire before beginning a new scene lifetime.
  Require(LAYERS.Delete(scene,handles(1))=LAYERTYPES.OK)
  Require(LAYERS.Delete(scene,handles(3))=LAYERTYPES.OK)
  Require(LAYERS.Delete(scene,handles(4))=LAYERTYPES.OK)
  Require(LAYERS.Delete(scene,handles(5))=LAYERTYPES.OK)
  Require(scene.count=0)
  REGIONS.Assign(@bounds,0,0,8,8)
  Require(LAYERS.Create(scene,@bounds,NULL)=LAYERTYPES.BAD_ARGUMENT)
  Require(LAYERS.Create(scene,NULL,@id)=LAYERTYPES.BAD_ARGUMENT)
  Require(LAYERS.Show(scene,0,1)=LAYERTYPES.BAD_ID)
  Require(LAYERS.Move(scene,0,0,0)=LAYERTYPES.BAD_ID)
  Require(LAYERS.Order(scene,0,1)=LAYERTYPES.BAD_ID)
  Require(LAYERS.Delete(scene,0)=LAYERTYPES.BAD_ID)
  Require(LAYERS.Show(scene,12345,1)=LAYERTYPES.BAD_ID)
  Require(LAYERS.Find(scene,handles(2))=NULL)
  scene.nextId=$ffffffff
  Require(LAYERS.Create(scene,@bounds,@id)=LAYERTYPES.OK)
  Require(id=$ffffffff AND scene.nextId=0)
  Require(LAYERS.Delete(scene,id)=LAYERTYPES.OK)
  id=12345
  Require(LAYERS.Create(scene,@bounds,@id)=LAYERTYPES.EXHAUSTED)
  Require(id=12345 AND scene.count=0)
  Require(LAYERS.Init(NULL,32,24)=LAYERTYPES.BAD_ARGUMENT)
  Require(LAYERS.Init(scene,0,24)=LAYERTYPES.BAD_ARGUMENT)

RETURN

INCLUDE "layers-update-checks.inc"
INCLUDE "layers-damage-checks.inc"
INCLUDE "layers-bank-checks.inc"

PROC Main()

  first=LAYERTYPES.Region POINTER(Guarded(LAYERTYPES.REGION_SIZE))
  second=LAYERTYPES.Region POINTER(Guarded(LAYERTYPES.REGION_SIZE))
  scene=LAYERTYPES.Scene POINTER(Guarded(LAYERTYPES.SCENE_SIZE))
  model=Guarded(3072)
  canvas=Guarded(768)
  Geometry()
  RegionFailures()
  Scenes()
  SceneFailures()
  UpdateTransactions()
  DamageTransactions()
  BankCrossing()
  scenePhase=50
  FreeGuarded(canvas,768)
  FreeGuarded(model,3072)
  FreeGuarded(BYTE POINTER(scene),LAYERTYPES.SCENE_SIZE)
  FreeGuarded(BYTE POINTER(second),LAYERTYPES.REGION_SIZE)
  FreeGuarded(BYTE POINTER(first),LAYERTYPES.REGION_SIZE)

RETURN

ENDMODULE
