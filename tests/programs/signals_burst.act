MODULE SIGNALBURST
USE EXEC
USE EXECLISTS
USE EXECTASKS
USE EXECSIGNALIRQ
USE PRODUCERPROBE
USE TASKSTACKS
EXEC.Task first,second,third
EXEC.Task POINTER parent
VOLATILE BYTE mask=$10,irqen=$d20e,skctl=$d20f,skshadow=$232,nmien=$d40e
VOLATILE BYTE freq3=$d204,vol3=$d205,freq4=$d206,vol4=$d207,audctl=$d208,
    stimer=$d209,skreset=$d20a,serout=$d20d
VOLATILE BYTE doneCount
BYTE oldsk
CARD ARRAY checks(8)
LONGCARD ARRAY values(4)
PROC POINTER missing()
INCLUDE "tasks_exec_helpers.inc"

PROC WorkerOne()

  values(1)=EXEC.Wait(1)
  doneCount==+1

RETURN

PROC WorkerTwo()

  values(2)=EXEC.Wait(1)
  doneCount==+1

RETURN

PROC WorkerThree()

  values(3)=EXEC.Wait(1)
  doneCount==+1

RETURN

PROC Setup()
  EXEC.Task POINTER item
  CARD status

  parent=EXEC.FindTask(BYTE POINTER(0))
  PrepareTask(@first,TASKSTACKS.LOWER1,BYTE POINTER(0))
  PrepareTask(@second,TASKSTACKS.LOWER2,BYTE POINTER(0))
  PrepareTask(@third,TASKSTACKS.LOWER3,BYTE POINTER(0))
  item=EXEC.AddTask(@first,@WorkerOne,missing)
  item=EXEC.AddTask(@second,@WorkerTwo,missing)
  item=EXEC.AddTask(@third,@WorkerThree,missing)
  WHILE first.tc_State<>EXEC.TS_WAIT OR second.tc_State<>EXEC.TS_WAIT
      OR third.tc_State<>EXEC.TS_WAIT DO
    status=EXECTASKS.Sleep(1)
  OD

  oldsk=skshadow
  checks(0)=CARD(PRODUCERPROBE.Bind(parent,1))

RETURN

; Exercise signal delivery during bursts from several Tasks.
PROC Main()

  Setup()
  nmien=0
  skctl=0
  freq3=$ff
  vol3=0
  freq4=$ff
  vol4=0
  audctl=$28
  skshadow=$23
  skctl=$23
  skreset=$23
  stimer=$23
  EXEC.Forbid()
  mask=mask % $10
  irqen=mask
  serout=$5a
  values(0)=EXEC.Wait(1)
  checks(1)=CARD(first.tc_State=EXEC.TS_READY AND second.tc_State=EXEC.TS_READY
      AND third.tc_State=EXEC.TS_READY)
  checks(2)=CARD(parent.tc_TDNestCnt=0 AND doneCount=0)
  skctl=0
  PRODUCERPROBE.Release()
  skshadow=oldsk
  skctl=oldsk
  audctl=0
  EXEC.Permit()
  WHILE doneCount<>3 DO
    EXEC.Yield()
  OD

  nmien=$40
  AwaitRemoval(@first)
  AwaitRemoval(@second)
  AwaitRemoval(@third)
  checks(3)=CARD(doneCount=3)

RETURN

ENDMODULE
