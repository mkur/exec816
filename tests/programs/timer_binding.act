MODULE TIMERBINDINGPROBE
USE EXEC
USE TIMER
USE HEAPCORE

EXEC.IORequest POINTER ARRAY opens(8)
EXEC.MsgPort POINTER ARRAY ports(8)
CARD checks

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($f600+checks)
  FI

  checks==+1

RETURN

; Exercise every admitted slot with a distinct reply port. Borrowed requests
; keep each binding alive through clock reads, cancellation and collection.
PROC Main()
  BYTE slot

  FOR slot=0 TO 7 DO
    ports(slot)=EXEC.CreateMsgPort()
    Require(ports(slot)<>NULL)
    opens(slot)=EXEC.CreateIORequest(ports(slot),SIZEOF(TIMER.TimerClockRequest))
    Require(opens(slot)<>NULL)
    Require(EXEC.OpenDevice(BYTE POINTER(c"timer.device"),TIMER.UNIT_VBLANK,
        opens(slot),0)=0)
  OD

  LET query=TIMER.TimerClockRequest POINTER(EXEC.CreateIORequest(ports(0),
      SIZEOF(TIMER.TimerClockRequest)))
  Require(query<>NULL)
  FOR slot=0 TO 7 DO
    query.tc_Request.io_Message.mn_ReplyPort=ports(slot)
    query.tc_Request.io_Device=opens(slot).io_Device
    query.tc_Request.io_Unit=opens(slot).io_Unit
    query.tc_Request.io_Command=TIMER.TD_READCLOCK
    Require(EXEC.DoIO(@query.tc_Request)=0)
    query.tc_Request.io_Command=TIMER.TD_WAITUNTIL
    query.ticks_lo=0
    query.ticks_hi=$100
    EXEC.SendIO(@query.tc_Request)
    Require(EXEC.CheckIO(@query.tc_Request)=NULL)
    EXEC.AbortIO(@query.tc_Request)
    Require(EXEC.WaitIO(@query.tc_Request)=EXEC.IOERR_ABORTED)
    Require(EXEC.GetMsg(ports(slot))=NULL)
  OD

  query.tc_Request.io_Device=NULL
  query.tc_Request.io_Unit=NULL
  EXEC.DeleteIORequest(@query.tc_Request)
  FOR slot=0 TO 7 DO
    EXEC.CloseDevice(opens(slot))
    EXEC.DeleteIORequest(opens(slot))
    EXEC.DeleteMsgPort(ports(slot))
  OD


RETURN
ENDMODULE
