MODULE DESKTEST
USE EXEC
USE EXECTASKS
USE DOS
USE HEAPCORE
USE CONSOLE
USE CONSOLEBITMAP
USE CONSOLEDRIVER
USE CONSOLEWINDOWS
USE CONSOLETYPES
USE DESKTOP
USE DESKTYPES
USE DESKBOOT
USE DESKSTATE
USE DESKPAINT
USE REGIONS
USE SCROLLPROBE

CARD checks,checkpoint,gate
CARD cutBytes
BYTE fragmentFault
BYTE ARRAY text(64)
BYTE ARRAY bulk(512)
DESKTYPES.Request request
DESKTYPES.Content content
LONGCARD panel

PROC Require(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($fc00+(checks & 255))
  FI

  checks==+1

RETURN

PROC Settled()

  LET instance=CONSOLEDRIVER.GetInstance()
  LET service=DESKSTATE.Get()
  LET entry=CONSOLEWINDOWS.Find(0)
  LET view=CONSOLETYPES.Presentation POINTER(entry.view)
  WHILE instance.dirtyRows<>0 OR service.scene.busy<>0
      OR DESKPAINT.Runnable()<>0 OR CONSOLEBITMAP.Pending()<>0
      OR view.cursorOn=0 DO
    EXEC.Yield()
  OD

RETURN

PROC Pause(CARD value)
  CARD ignored

  Settled()
  ignored=EXECTASKS.Sleep(2)
  checkpoint=value
  WHILE gate<value DO
    EXEC.Yield()
  OD

RETURN

PROC Send(BYTE operation LONGCARD id)
  EXEC.Message POINTER message
  DESKTYPES.Request POINTER reply

  LET client=DESKBOOT.Binding()
  request.operation=operation
  request.window=id
  Require(DESKTOP.Submit(client,@request)=DESKTYPES.OK)
  reply=DESKTOP.Collect(client)
  WHILE reply=NULL DO
    message=EXEC.WaitPort(client.replies)
    reply=DESKTOP.Collect(client)
  OD

  Require(reply=@request AND request.status=DESKTYPES.OK)

RETURN

; Full-scene comparison after each aligned and overlapping move.
PROC MovePanel(INT left,top CARD stage)

  DESKTOP.Prepare(@request,DESKTYPES.MOVE)
  request.bounds.left=left
  request.bounds.top=top
  Send(DESKTYPES.MOVE,panel)
  Pause(stage)

RETURN

PROC Main()
  CARD row,column,error
  DOS.FileHandle POINTER file
  EXEC.MsgPort POINTER replies
  EXEC.IOStdReq POINTER write
  EXEC.Message POINTER message
  DESKTYPES.Request POINTER reply

  Require(CONSOLE.ScreenWidth()=64 AND CONSOLE.ScreenHeight()=20)
  file=DOS.Open(BYTE POINTER(c"RAW:"),DOS.MODE_READWRITE)
  Require(file<>NULL)
  Require(DOS.Write(file,BYTE POINTER(c"ABC"),3)=3)
  Pause(1)
  FOR row=0 TO 24 DO
    FOR column=0 TO 63 DO
      text(column)=BYTE(33+(row*7+column) MOD 90)
    OD

    Require(DOS.Write(file,text,64)=64)
  OD

  Pause(2)
  DESKTOP.Prepare(@request,DESKTYPES.MOVE)
  request.bounds.left=80
  request.bounds.top=48
  Send(DESKTYPES.MOVE,DESKBOOT.WindowId())
  Pause(3)
  ; An odd-edged opaque panel cuts through console cells during exposure repair.
  DESKTOP.Prepare(@request,DESKTYPES.OPEN)
  request.value=DESKTYPES.CONTENT_COMMANDS
  request.payload=BYTE POINTER(c"Clip")
  request.bytes=4
  REGIONS.Assign(@request.bounds,113,93,273,173)
  Send(DESKTYPES.OPEN,0)
  panel=request.window
  content.background=3
  content.count=1
  content.textBytes=3
  content.text(0)='X
  content.text(1)='Y
  content.text(2)='Z
  content.commands(0).kind=DESKTYPES.DRAW_TEXT
  content.commands(0).pen=1
  content.commands(0).count=3
  REGIONS.Assign(@content.commands(0).bounds,3,3,27,11)
  DESKTOP.Prepare(@request,DESKTYPES.REPLACE)
  request.payload=BYTE POINTER(@content)
  request.bytes=DESKTYPES.CONTENT_SIZE
  Send(DESKTYPES.REPLACE,panel)
  Send(DESKTYPES.SHOW,panel)
  Pause(4)
  Require(DOS.Write(file,BYTE POINTER(c"\fHello"),6)=6)
  Pause(5)
  Send(DESKTYPES.CLOSE,panel)
  Pause(6)
  DESKTOP.Prepare(@request,DESKTYPES.OPEN)
  request.value=DESKTYPES.CONTENT_COMMANDS
  request.payload=BYTE POINTER(c"Clip")
  request.bytes=4
  REGIONS.Assign(@request.bounds,0,0,160,80)
  Send(DESKTYPES.OPEN,0)
  panel=request.window
  DESKTOP.Prepare(@request,DESKTYPES.REPLACE)
  request.payload=BYTE POINTER(@content)
  request.bytes=DESKTYPES.CONTENT_SIZE
  Send(DESKTYPES.REPLACE,panel)
  Send(DESKTYPES.SHOW,panel)
  Pause(7)
  MovePanel(32,24,8)
  MovePanel(16,24,9)
  MovePanel(16,8,10)
  MovePanel(16,32,11)
  MovePanel(480,160,12)
  MovePanel(480,0,13)
  MovePanel(0,160,14)
  Send(DESKTYPES.CLOSE,panel)
  Pause(15)
  ; Continuous output behind a panel must finish each bounded repaint before
  ; another scroll can invalidate its lower rows. No settling between writes.
  DESKTOP.Prepare(@request,DESKTYPES.OPEN)
  request.value=DESKTYPES.CONTENT_COMMANDS
  request.payload=BYTE POINTER(c"Clip")
  request.bytes=4
  REGIONS.Assign(@request.bounds,377,0,537,173)
  Send(DESKTYPES.OPEN,0)
  panel=request.window
  DESKTOP.Prepare(@request,DESKTYPES.REPLACE)
  request.payload=BYTE POINTER(@content)
  request.bytes=DESKTYPES.CONTENT_SIZE
  Send(DESKTYPES.REPLACE,panel)
  Send(DESKTYPES.SHOW,panel)
  Settled()
  SCROLLPROBE.enabled=1
  FOR row=0 TO 24 DO
    FOR column=0 TO 63 DO
      text(column)=BYTE(33+(row*11+column) MOD 90)
    OD

    Require(DOS.Write(file,text,64)=64)
  OD

  Pause(16)
  ; Short lines ensure multirow gathering within one VBI budget, regardless
  ; of the earlier frame repaint phase. Keep the real four-row bound.
  FOR column=0 TO 511 DO
    bulk(column)=BYTE(65+(column MOD 26))
    IF column MOD 7=6 THEN
      bulk(column)=10
    FI
  OD

  Require(DOS.Write(file,bulk,512)=512)
  Pause(17)
  SCROLLPROBE.enabled=0
  Send(DESKTYPES.CLOSE,panel)
  Pause(18)

  ; Cancel while the second half-row owns unfinished clipped fragments. A
  ; queued hide must wait for that token; showing again reconstructs exactly
  ; the accepted prefix after the caller's source has been overwritten.
  Require(DOS.Write(file,BYTE POINTER(c"\f\n\n\n\n\n\n\n\n\n\n\n\n\n"),14)=14)
  Settled()
  Require(DOS.Close(file)<>0)
  DESKTOP.Prepare(@request,DESKTYPES.OPEN)
  request.value=DESKTYPES.CONTENT_COMMANDS
  request.payload=BYTE POINTER(c"Clip")
  request.bytes=4
  REGIONS.Assign(@request.bounds,377,0,537,173)
  Send(DESKTYPES.OPEN,0)
  panel=request.window
  DESKTOP.Prepare(@request,DESKTYPES.REPLACE)
  request.payload=BYTE POINTER(@content)
  request.bytes=DESKTYPES.CONTENT_SIZE
  Send(DESKTYPES.REPLACE,panel)
  Send(DESKTYPES.SHOW,panel)
  Settled()
  replies=EXEC.CreateMsgPort()
  write=EXEC.IOStdReq POINTER(EXEC.CreateIORequest(replies,EXEC.IOSTDREQ_SIZE))
  Require(replies<>NULL AND write<>NULL)
  Require(EXEC.OpenDevice(BYTE POINTER(c"console.device"),0,EXEC.IORequest POINTER(write),0)=0)
  FOR column=0 TO 511 DO
    bulk(column)=BYTE(65+(column MOD 26))
  OD

  write.io_Command=EXEC.CMD_WRITE
  write.io_Data=bulk
  write.io_Length=512
  SCROLLPROBE.armFragment=1
  EXEC.SendIO(EXEC.IORequest POINTER(write))
  WHILE SCROLLPROBE.fragmentHeld=0 DO
    EXEC.Yield()
  OD

  cutBytes=CARD(write.io_Actual)
  Require(cutBytes<>0 AND cutBytes<512 AND CONSOLEBITMAP.TextPending()<>0)
  LET client=DESKBOOT.Binding()
  IF fragmentFault<>0 THEN
    SCROLLPROBE.failFragment=1
  ELSE
    EXEC.AbortIO(EXEC.IORequest POINTER(write))
    DESKTOP.Prepare(@request,DESKTYPES.HIDE)
    request.window=DESKBOOT.WindowId()
    Require(DESKTOP.Submit(client,@request)=DESKTYPES.OK)
  FI

  SCROLLPROBE.holdFragment=0
  LET service=CONSOLEDRIVER.GetService()
  EXEC.Signal(@service.task,$40000000)
  error=EXEC.WaitIO(EXEC.IORequest POINTER(write))
  Require(error=IF fragmentFault<>0 THEN EXEC.IOERR_SELFTEST ELSE EXEC.IOERR_ABORTED FI)
  Require(write.io_Actual=LONGCARD(cutBytes) AND CONSOLEBITMAP.TextPending()=0)
  IF fragmentFault<>0 THEN
    checkpoint=19
    WHILE gate<19 DO
      EXEC.Yield()
    OD

    Send(DESKTYPES.CLOSE,panel)
    EXEC.CloseDevice(EXEC.IORequest POINTER(write))
    EXEC.DeleteIORequest(EXEC.IORequest POINTER(write))
    EXEC.DeleteMsgPort(replies)
    Require(DOS.ReleaseContext()<>0)
    RETURN
  FI

  reply=DESKTOP.Collect(client)
  WHILE reply=NULL DO
    message=EXEC.WaitPort(client.replies)
    reply=DESKTOP.Collect(client)
  OD

  Require(reply=@request AND request.status=DESKTYPES.OK)
  FOR column=0 TO 511 DO
    bulk(column)=90
  OD

  Send(DESKTYPES.SHOW,DESKBOOT.WindowId())
  Send(DESKTYPES.FOCUS,DESKBOOT.WindowId())
  Pause(19)
  Send(DESKTYPES.CLOSE,panel)
  EXEC.CloseDevice(EXEC.IORequest POINTER(write))
  EXEC.DeleteIORequest(EXEC.IORequest POINTER(write))
  EXEC.DeleteMsgPort(replies)
  Require(DOS.ReleaseContext()<>0)

RETURN

ENDMODULE
