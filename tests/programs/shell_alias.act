MODULE SHELLALIASTEST
USE HEAPCORE
INCLUDE "../../examples/shell/shell-session.inc"

ShellContext context

CARD checks
BYTE finished
LONGCARD aliasStorage

PROC Check(BYTE okay)

  IF okay=0 THEN
    HEAPCORE.Abort($e920+checks)
  FI

  checks==+1

RETURN

PROC Same(BYTE POINTER actual,expected)
  CARD index

  index=0
  DO
    Check(actual(index)=expected(index))
    IF expected(index)=ASCII.NUL THEN
      EXIT
    FI

    index==+1
  OD

RETURN

PROC PrepareLine(CSTRING command)

  STR.strlcpy(ShellLine(@context),command,LINE_CAPACITY)
  context.shell.status=PROCESS.RETURN_OK
  context.shell.error=0
  context.shell.done=0
  Check(ShellParse(@context)<>0)

RETURN

PROC SetAlias(CSTRING command)

  PrepareLine(command)
  Check(context.shell.command=CMD_ALIAS)
  ShellAliasCommand(@context)
  Check(context.shell.status=PROCESS.RETURN_OK)

RETURN

PROC DropAlias(CSTRING command)

  PrepareLine(command)
  Check(context.shell.command=CMD_UNALIAS)
  ShellUnaliasCommand(@context)
  Check(context.shell.status=PROCESS.RETURN_OK)

RETURN

PROC Main()
  LONGCARD before
  CARD index
  BYTE slot
  BYTE POINTER line

  before=EXEC.AvailMem(0)
  context.shell=ShellState POINTER(EXEC.AllocMem(SHELL_BYTES,
      EXEC.MEMF_UPPER OR EXEC.MEMF_CLEAR))
  Check(context.shell<>NULL AND SIZEOF(ShellState)=HEADER_SIZE)
  context.aliases=NULL
  context.aliasCount=0

  LET beforeAliases=EXEC.AvailMem(0)
  Check(ShellAliasDefaults(@context)<>0 AND context.aliasCount=3)
  aliasStorage=beforeAliases-EXEC.AvailMem(0)
  PrepareLine(c"mkdir notes")
  Check(ShellAliasExpand(@context)<>0 AND context.shell.command=CMD_EXTERNAL)
  Same(context.shell.words(0).text,BYTE POINTER(c"MAKEDIR"))
  Same(context.shell.words(1).text,BYTE POINTER(c"notes"))
  PrepareLine(c"ls *.txt")
  Check(ShellAliasExpand(@context)<>0 AND context.shell.command=CMD_EXTERNAL)
  Same(context.shell.words(0).text,BYTE POINTER(c"LIST"))
  Same(context.shell.words(1).text,BYTE POINTER(c"*.txt"))
  PrepareLine(c"cp one.txt two.txt")
  Check(ShellAliasExpand(@context)<>0 AND context.shell.command=CMD_EXTERNAL)
  Same(context.shell.words(0).text,BYTE POINTER(c"COPY"))
  Same(context.shell.words(2).text,BYTE POINTER(c"two.txt"))
  SetAlias(c"ALIAS LS DIR")
  Check(context.aliasCount=3)
  PrepareLine(c"ls")
  Check(ShellAliasExpand(@context)<>0 AND context.shell.command=CMD_DIR)
  DropAlias(c"UNALIAS MKDIR")
  DropAlias(c"UNALIAS LS")
  DropAlias(c"UNALIAS CP")
  Check(context.aliasCount=0)
  PrepareLine(c"mkdir notes")
  Check(ShellAliasExpand(@context)<>0)
  Same(context.shell.words(0).text,BYTE POINTER(c"mkdir"))

  SetAlias(c"ALIAS H ECHO")
  SetAlias(c"ALIAS X CAT")
  SetAlias(c"ALIAS Y WC")
  SetAlias(c"ALIAS FIX DIR")
  slot=ShellAliasIndex(@context,BYTE POINTER(c"FIX"))
  Check(slot<ALIAS_CAPACITY)
  STR.strlcpy(@context.aliases(slot).text(0),c"DIR SYS:",ALIAS_TEXT_CAPACITY)

  PrepareLine(c"H one two >NIL:")
  Check(ShellAliasExpand(@context)<>0 AND context.shell.command=CMD_ECHO
      AND context.shell.argc=3 AND context.shell.outputRedirect<>NO_REDIRECT)
  Same(context.shell.words(1).text,BYTE POINTER(c"one"))
  Same(context.shell.words(2).text,BYTE POINTER(c"two"))
  Same(context.shell.words(0).text,BYTE POINTER(c"ECHO"))

  PrepareLine(c"FIX")
  Check(ShellAliasExpand(@context)<>0 AND context.shell.command=CMD_DIR AND context.shell.argc=2)
  Same(context.shell.words(1).text,BYTE POINTER(c"SYS:"))

  PrepareLine(c"X SYS:STORY.TXT | Y")
  Check(ShellAliasExpand(@context)<>0 AND context.shell.pipeline=1
      AND context.shell.command=CMD_EXTERNAL)
  Same(context.shell.words(0).text,BYTE POINTER(c"CAT"))
  Same(context.shell.words(context.shell.pipelineIndex).text,BYTE POINTER(c"WC"))

  SetAlias(c"ALIAS A B")
  SetAlias(c"ALIAS B ECHO")
  PrepareLine(c"A yes")
  Check(ShellAliasExpand(@context)<>0 AND context.shell.command=CMD_EXTERNAL)
  Same(context.shell.words(0).text,BYTE POINTER(c"B"))

  SetAlias(c"ALIAS C ECHO")
  SetAlias(c"ALIAS D ECHO")
  Check(context.aliasCount=ALIAS_CAPACITY)
  PrepareLine(c"ALIAS I ECHO")
  ShellAliasCommand(@context)
  Check(context.shell.status=PROCESS.RETURN_ERROR
      AND context.shell.error=DOS.ERROR_BUFFER_OVERFLOW
      AND context.aliasCount=ALIAS_CAPACITY)
  SetAlias(c"ALIAS A DIR")
  DropAlias(c"UNALIAS B")
  SetAlias(c"ALIAS I ECHO")
  Check(context.aliasCount=ALIAS_CAPACITY)

  DropAlias(c"UNALIAS C")
  SetAlias(c"ALIAS LONG ECHO")
  slot=ShellAliasIndex(@context,BYTE POINTER(c"LONG"))
  Check(slot<ALIAS_CAPACITY)
  STR.strlcpy(@context.aliases(slot).text(0),c"ECHO ",ALIAS_TEXT_CAPACITY)
  FOR index=5 TO 126 DO
    context.aliases(slot).text(index)='A
  OD

  context.aliases(slot).text(127)=ASCII.NUL
  line=ShellLine(@context)
  STR.strlcpy(line,c"LONG ",LINE_CAPACITY)
  FOR index=5 TO 134 DO
    line(index)='B
  OD

  line(135)=ASCII.NUL
  context.shell.status=PROCESS.RETURN_OK
  context.shell.error=0
  Check(ShellParse(@context)<>0)
  Check(ShellAliasExpand(@context)=0 AND context.shell.error=DOS.ERROR_LINE_TOO_LONG
      AND line(0)='L)

  EXEC.FreeMem(BYTE POINTER(context.aliases),ALIAS_CAPACITY*SIZEOF(ShellAlias))
  EXEC.FreeMem(BYTE POINTER(context.shell),SHELL_BYTES)
  Check(EXEC.AvailMem(0)=before)
  finished=1

RETURN

ENDMODULE
